---
interface Props {
  title: string;
  category: string;
  institution: string;
  imageUrl: string;
  collectedAmount: number;
  targetAmount: number;
  daysRemaining: number;
  slug: string;
  donorCount?: number;
  verified?: boolean;
}

const {
  title,
  category,
  institution,
  imageUrl,
  collectedAmount,
  targetAmount,
  daysRemaining,
  slug,
  donorCount,
  verified = true,
} = Astro.props;

const percentage = Math.min(Math.round((collectedAmount / targetAmount) * 100), 100);

const formatRupiah = (val: number) => {
  return 'Rp ' + val.toLocaleString('id-ID');
};
---

<article class="campaign-card">
  <a href={`/program/${slug}`} class="card-media-link" aria-label={`Lihat program ${title}`}>
    <div class="card-media">
      <img src={imageUrl} alt={title} loading="lazy" />
      <span class="category-badge">{category.toUpperCase()}</span>
    </div>
  </a>

  <div class="card-body">
    <!-- Institution / Mitra Terverifikasi -->
    <div class="institution-meta">
      <span class="institution-name">{institution}</span>
      {
        verified && (
          <span class="verified-badge" title="Mitra Terverifikasi">
            <svg
              class="verified-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="20 6 9 17 4 12" />
            </svg>
          </span>
        )
      }
    </div>

    <!-- Title 2-lines clamp -->
    <h3 class="card-title">
      <a href={`/program/${slug}`}>{title}</a>
    </h3>

    <!-- Progress Bar 6px -->
    <div class="progress-container">
      <div
        class="progress-bar-track"
        role="progressbar"
        aria-valuenow={percentage}
        aria-valuemin="0"
        aria-valuemax="100"
      >
        <div class="progress-bar-fill" style={`width: ${percentage}%`}></div>
      </div>
    </div>

    <!-- Card Stats (Terkumpul & Sisa Hari) -->
    <div class="card-stats">
      <div class="stat-col">
        <span class="stat-label">Terkumpul</span>
        <span class="stat-amount">{formatRupiah(collectedAmount)}</span>
      </div>

      <div class="stat-col align-right">
        <span class="stat-label">Sisa Hari</span>
        <div class="stat-days-wrap">
          <svg
            class="clock-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </svg>
          <span class="stat-days">{daysRemaining} hari</span>
        </div>
      </div>
    </div>

    <!-- Secondary Meta if donorCount provided -->
    {
      donorCount !== undefined && (
        <div class="card-footer-meta">
          <span class="donor-label">{donorCount} Donatur bergabung</span>
          <span class="percent-label">{percentage}%</span>
        </div>
      )
    }
  </div>
</article>

<style>
  .campaign-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.2s ease;
  }

  .campaign-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px -6px rgba(15, 23, 42, 0.08);
    border-color: #cbd5e1;
  }

  .card-media-link {
    display: block;
    position: relative;
    text-decoration: none;
    overflow: hidden;
  }

  .card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #f1f5f9;
    overflow: hidden;
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  .campaign-card:hover .card-media img {
    transform: scale(1.03);
  }

  .category-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(9, 105, 218, 0.92);
    color: #ffffff;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 3px 8px;
    border-radius: 5px;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: 0 2px 6px rgba(9, 105, 218, 0.25);
  }

  .card-body {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .institution-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
  }

  .institution-name {
    font-size: 12px;
    font-weight: 500;
    color: #64748b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .verified-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 15px;
    height: 15px;
    border-radius: 9999px;
    background: #e0f2fe;
    color: #0969da;
    flex-shrink: 0;
  }

  .verified-icon {
    width: 9px;
    height: 9px;
  }

  .card-title {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.45;
    color: #0f172a;
    letter-spacing: -0.15px;
    margin-bottom: 16px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: calc(15px * 1.45 * 2);
  }

  .card-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .card-title a:hover {
    color: #0969da;
  }

  .progress-container {
    margin-top: auto;
    margin-bottom: 14px;
  }

  .progress-bar-track {
    width: 100%;
    height: 6px;
    background: #f1f5f9;
    border-radius: 9999px;
    overflow: hidden;
  }

  .progress-bar-fill {
    height: 100%;
    background: #0969da;
    border-radius: 9999px;
    transition: width 0.3s ease;
  }

  .card-stats {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }

  .stat-col {
    display: flex;
    flex-direction: column;
  }

  .stat-col.align-right {
    align-items: flex-end;
  }

  .stat-label {
    font-size: 11px;
    font-weight: 500;
    color: #94a3b8;
    margin-bottom: 3px;
  }

  .stat-amount {
    font-size: 14px;
    font-weight: 800;
    color: #0969da;
    letter-spacing: -0.2px;
  }

  .stat-days-wrap {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .clock-icon {
    width: 13px;
    height: 13px;
    color: #94a3b8;
  }

  .stat-days {
    font-size: 12.5px;
    font-weight: 600;
    color: #334155;
  }

  .card-footer-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px dashed #f1f5f9;
    font-size: 11px;
    color: #94a3b8;
  }

  .percent-label {
    font-weight: 700;
    color: #0969da;
  }
</style>
