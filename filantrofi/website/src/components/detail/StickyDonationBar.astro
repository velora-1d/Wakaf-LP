---
interface Props {
  slug: string;
  collectedAmount: number;
  percentage: number;
  ctaText?: string;
}

const {
  slug,
  collectedAmount,
  percentage,
  ctaText = 'Wakaf Sekarang',
} = Astro.props;

const formatRupiah = (val: number) => {
  return 'Rp ' + val.toLocaleString('id-ID');
};
---

<aside id="stickyDonationBar" class="sticky-bar" aria-label="Aksi donasi cepat">
  <div class="sticky-container">
    <div class="sticky-info">
      <span class="info-label">Terkumpul ({percentage}%)</span>
      <span class="info-amount">{formatRupiah(collectedAmount)}</span>
    </div>

    <div class="sticky-action">
      <a href={`/checkout/${slug}`} class="sticky-btn">
        <span>{ctaText}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</aside>

<style>
  .sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 99;
    background: #ffffff;
    border-top: 1px solid #e2e8f0;
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
    padding: 12px 16px;
    padding-bottom: max(12px, env(safe-area-inset-bottom));
    display: block;
  }

  @media (min-width: 768px) {
    .sticky-bar {
      display: none;
    }
  }

  .sticky-container {
    max-width: 480px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .sticky-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .info-label {
    font-size: 11px;
    color: #64748b;
    font-weight: 500;
  }

  .info-amount {
    font-size: 16px;
    font-weight: 800;
    color: #0969da;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sticky-action {
    flex-shrink: 0;
  }

  .sticky-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: #0969da;
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
    padding: 10px 18px;
    border-radius: 8px;
    transition: background 0.15s ease;
    white-space: nowrap;
  }

  .sticky-btn:hover {
    background: #0752a8;
  }
</style>
