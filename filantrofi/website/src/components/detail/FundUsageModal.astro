---
import type { FundAllocation } from '../../data/campaigns';

interface Props {
  allocations: FundAllocation[];
  totalTarget: number;
}

const { allocations, totalTarget } = Astro.props;

const formatRupiah = (val: number) => {
  return 'Rp ' + val.toLocaleString('id-ID');
};
---

<div class="fund-usage-wrapper">
  <!-- Trigger Button / Summary Card -->
  <div class="fund-summary-card">
    <div class="summary-header">
      <div class="icon-bubble">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"></path>
          <path d="M12 18V6"></path>
        </svg>
      </div>
      <div>
        <h3 class="summary-title">Rencana Alokasi & Transparansi Dana</h3>
        <p class="summary-desc">Setiap rupiah yang terkumpul disalurkan sesuai mandat syariah dan diaudit secara berkala.</p>
      </div>
    </div>

    <!-- Segmented Visual Bar -->
    <div class="segmented-bar" aria-label="Visualisasi persentase alokasi">
      {allocations.map((item, index) => {
        const bgColors = ['#0969da', '#0284c7', '#0369a1', '#64748b'];
        const color = bgColors[index % bgColors.length];
        return (
          <div
            class="segment"
            style={`width: ${item.percentage}%; background-color: ${color};`}
            title={`${item.category}: ${item.percentage}%`}
          ></div>
        );
      })}
    </div>

    <div class="quick-breakdown">
      {allocations.map((item, index) => {
        const dotColors = ['#0969da', '#0284c7', '#0369a1', '#64748b'];
        const dotColor = dotColors[index % dotColors.length];
        return (
          <div class="breakdown-item">
            <span class="color-dot" style={`background-color: ${dotColor};`}></span>
            <span class="item-cat">{item.category}</span>
            <span class="item-pct">{item.percentage}%</span>
          </div>
        );
      })}
    </div>

    <button type="button" id="openFundModalBtn" class="btn-open-modal">
      <span>Lihat Rincian Lengkap & Standar Audit</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m9 18 6-6-6-6"></path>
      </svg>
    </button>
  </div>

  <!-- Modal Dialog -->
  <div id="fundModal" class="modal-backdrop" aria-hidden="true" role="dialog" aria-labelledby="modalTitle">
    <div class="modal-dialog">
      <div class="modal-header">
        <div class="modal-title-group">
          <h2 id="modalTitle" class="modal-heading">Rincian Alokasi Penggunaan Dana</h2>
          <span class="modal-subheading">Total Kebutuhan Anggaran: {formatRupiah(totalTarget)}</span>
        </div>
        <button type="button" id="closeFundModalBtn" class="btn-close" aria-label="Tutup jendela rincian dana">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="modal-body">
        <div class="allocations-table">
          {allocations.map((item, idx) => (
            <div class="allocation-row">
              <div class="row-left">
                <span class="row-num">{idx + 1}</span>
                <div class="row-details">
                  <h4 class="row-title">{item.category}</h4>
                  <p class="row-desc">{item.description}</p>
                </div>
              </div>
              <div class="row-right">
                <span class="row-amount">{formatRupiah(item.amount)}</span>
                <span class="row-pct-pill">{item.percentage}%</span>
              </div>
            </div>
          ))}
        </div>

        <div class="audit-notice">
          <div class="audit-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </div>
          <div class="audit-text">
            <strong>Integritas Penyaluran Terjamin</strong>
            <p>
              Seluruh arus kas dan realisasi belanja material diawasi langsung oleh Komite Pengawas Nadzir,
              didukung faktur transaksi resmi, serta dilaporkan secara transparan pada tab Kabar Penyaluran.
            </p>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" id="modalDismissBtn" class="btn-dismiss">Mengerti</button>
      </div>
    </div>
  </div>
</div>

<script>
  const openBtn = document.getElementById('openFundModalBtn');
  const modal = document.getElementById('fundModal');
  const closeBtn = document.getElementById('closeFundModalBtn');
  const dismissBtn = document.getElementById('modalDismissBtn');

  function openModal() {
    if (modal) {
      modal.classList.add('active');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.remove('active');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  }

  openBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  dismissBtn?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('active')) {
      closeModal();
    }
  });
</script>

<style>
  .fund-usage-wrapper {
    margin: 24px 0;
  }

  .fund-summary-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 20px;
  }

  .summary-header {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 16px;
  }

  .icon-bubble {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: #dbeafe;
    color: #0969da;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .summary-title {
    font-size: 16px;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 4px;
  }

  .summary-desc {
    font-size: 13px;
    color: #64748b;
    line-height: 1.4;
  }

  .segmented-bar {
    display: flex;
    height: 10px;
    width: 100%;
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 16px;
  }

  .segment {
    height: 100%;
    transition: width 0.3s ease;
  }

  .quick-breakdown {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 20px;
    margin-bottom: 18px;
  }

  .breakdown-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
  }

  .color-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .item-cat {
    color: #334155;
    font-weight: 500;
  }

  .item-pct {
    color: #0f172a;
    font-weight: 700;
  }

  .btn-open-modal {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #ffffff;
    color: #0969da;
    border: 1px solid #cbd5e1;
    font-size: 13px;
    font-weight: 600;
    padding: 10px 16px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-open-modal:hover {
    background: #eff6ff;
    border-color: #0969da;
  }

  /* Modal Styles */
  .modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(4px);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .modal-backdrop.active {
    display: flex;
  }

  .modal-dialog {
    background: #ffffff;
    border-radius: 16px;
    width: 100%;
    max-width: 600px;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    animation: modalPop 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes modalPop {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(10px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 24px;
    border-bottom: 1px solid #e2e8f0;
  }

  .modal-heading {
    font-size: 18px;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 4px;
  }

  .modal-subheading {
    font-size: 13px;
    color: #64748b;
  }

  .btn-close {
    background: transparent;
    border: none;
    color: #64748b;
    cursor: pointer;
    padding: 6px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
  }

  .btn-close:hover {
    background: #f1f5f9;
    color: #0f172a;
  }

  .modal-body {
    padding: 24px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .allocations-table {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .allocation-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    padding: 14px 16px;
    background: #f8fafc;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
  }

  .row-left {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .row-num {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #e2e8f0;
    color: #475569;
    font-size: 12px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .row-title {
    font-size: 14px;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 4px;
  }

  .row-desc {
    font-size: 12px;
    color: #64748b;
    line-height: 1.4;
  }

  .row-right {
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    flex-shrink: 0;
  }

  .row-amount {
    font-size: 14px;
    font-weight: 700;
    color: #0969da;
  }

  .row-pct-pill {
    background: #dbeafe;
    color: #0752a8;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 999px;
  }

  .audit-notice {
    display: flex;
    gap: 12px;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 10px;
    padding: 14px 16px;
  }

  .audit-icon {
    color: #0969da;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .audit-text strong {
    display: block;
    font-size: 13px;
    color: #0752a8;
    margin-bottom: 2px;
  }

  .audit-text p {
    font-size: 12px;
    color: #334155;
    line-height: 1.5;
  }

  .modal-footer {
    padding: 16px 24px;
    border-top: 1px solid #e2e8f0;
    display: flex;
    justify-content: flex-end;
  }

  .btn-dismiss {
    background: #0969da;
    color: #ffffff;
    border: none;
    font-size: 14px;
    font-weight: 600;
    padding: 10px 24px;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .btn-dismiss:hover {
    background: #0752a8;
  }
</style>
