---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';

export function getStaticPaths() {
  return [
    { params: { orderId: 'FLN-829103' } },
    { params: { orderId: 'FLN-DEMO' } },
    { params: { orderId: 'FLN-SAMPLE' } },
  ];
}

const { orderId } = Astro.params;
---

<Layout title={`Instruksi Pembayaran ${orderId} - Filantrofi`}>
  <Navbar />

  <main class="payment-main">
    <div class="payment-container">
      <!-- Status Banner -->
      <div class="status-banner">
        <div class="status-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
        </div>
        <div class="status-info">
          <h1 class="status-title">Menunggu Pembayaran</h1>
          <p class="status-sub">Selesaikan transaksi sebelum batas waktu berakhir agar donasi tercatat otomatis.</p>
        </div>
        <div class="timer-badge">
          <span class="timer-label">Sisa Waktu</span>
          <span id="countdownTimer" class="timer-clock">23:59:59</span>
        </div>
      </div>

      <!-- Transaction Card Grid -->
      <div class="payment-grid">
        <!-- Main Instructions Column -->
        <div class="instructions-col">
          <!-- Total Payment Card -->
          <div class="card-total-box">
            <div class="total-header">
              <span class="header-label">Jumlah yang Harus Dibayar</span>
              <span class="header-order">ID: <strong id="displayOrderId">{orderId}</strong></span>
            </div>

            <div class="amount-display-row">
              <div class="nominal-group">
                <span id="displayTotalAmount" class="nominal-value">Rp 50.000</span>
                <span class="amount-tag">Tepat hingga 3 digit terakhir</span>
              </div>
              <button type="button" id="copyAmountBtn" class="btn-copy">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span class="btn-copy-text">Salin Jumlah</span>
              </button>
            </div>

            <div class="warning-box">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <span>Pastikan nominal yang ditransfer sesuai hingga angka terakhir untuk verifikasi instan tanpa konfirmasi manual.</span>
            </div>
          </div>

          <!-- Payment Destination Details -->
          <div class="card-dest-box">
            <h2 id="methodTitle" class="dest-title">Detail Pembayaran</h2>

            <!-- QRIS View -->
            <div id="qrisContainer" class="qris-view">
              <div class="qr-frame">
                <!-- Clean SVG QR Placeholder -->
                <svg class="qr-svg-mock" width="180" height="180" viewBox="0 0 100 100" fill="#0f172a">
                  <rect width="100" height="100" fill="#ffffff" />
                  <!-- Corner 1 -->
                  <rect x="5" y="5" width="30" height="30" fill="#0f172a" />
                  <rect x="10" y="10" width="20" height="20" fill="#ffffff" />
                  <rect x="15" y="15" width="10" height="10" fill="#0f172a" />
                  <!-- Corner 2 -->
                  <rect x="65" y="5" width="30" height="30" fill="#0f172a" />
                  <rect x="70" y="10" width="20" height="20" fill="#ffffff" />
                  <rect x="75" y="15" width="10" height="10" fill="#0f172a" />
                  <!-- Corner 3 -->
                  <rect x="5" y="65" width="30" height="30" fill="#0f172a" />
                  <rect x="10" y="70" width="20" height="20" fill="#ffffff" />
                  <rect x="15" y="75" width="10" height="10" fill="#0f172a" />
                  <!-- Pattern dots -->
                  <rect x="42" y="10" width="10" height="10" fill="#0f172a" />
                  <rect x="42" y="30" width="15" height="10" fill="#0f172a" />
                  <rect x="25" y="42" width="10" height="15" fill="#0f172a" />
                  <rect x="50" y="50" width="15" height="15" fill="#0f172a" />
                  <rect x="70" y="42" width="20" height="10" fill="#0f172a" />
                  <rect x="42" y="75" width="15" height="15" fill="#0f172a" />
                  <rect x="75" y="70" width="15" height="10" fill="#0f172a" />
                </svg>
              </div>
              <div class="qr-info">
                <span class="qr-inst">NMID: ID1020039182901</span>
                <span class="qr-merchant">Yayasan Global Village Fund (Wakaf)</span>
                <p class="qr-desc">Scan kode QR di atas menggunakan GoPay, OVO, ShopeePay, BCA Mobile, atau aplikasi pembayaran apa pun yang berlogo QRIS.</p>
              </div>
            </div>

            <!-- Virtual Account / Bank Transfer View -->
