                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span class="btn-copy-text">Salin Nomor</span>
                </button>
              </div>

              <div class="dest-field-row">
                <div class="field-info">
                  <span class="field-title">Nama Pemilik Rekening</span>
                  <span class="field-val">Yayasan Global Village Fund</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Step by Step Guide Accordion -->
          <div class="card-guide-box">
            <h3 class="guide-title">Petunjuk Cara Pembayaran</h3>

            <div class="guide-steps-list">
              <div class="step-guide-item">
                <div class="step-num">1</div>
                <div class="step-text">
                  <strong>Buka Aplikasi Pembayaran</strong>
                  <p>Buka aplikasi Mobile Banking atau e-Wallet yang Anda gunakan.</p>
                </div>
              </div>

              <div class="step-guide-item">
                <div class="step-num">2</div>
                <div class="step-text">
                  <strong>Pilih Menu Transfer / Bayar</strong>
                  <p>Pilih menu Virtual Account, Transfer Bank, atau Scan QRIS sesuai metode yang dipilih di atas.</p>
                </div>
              </div>

              <div class="step-guide-item">
                <div class="step-num">3</div>
                <div class="step-text">
                  <strong>Input Nomor & Pastikan Nominal Tepat</strong>
                  <p>Salin nomor VA / Rekening dan masukkan nominal tepat hingga digit terakhir agar sistem dapat mendeteksi secara otomatis.</p>
                </div>
              </div>

              <div class="step-guide-item">
                <div class="step-num">4</div>
                <div class="step-text">
                  <strong>Selesaikan Transaksi & Simpan Resi</strong>
                  <p>Setelah pembayaran sukses, sistem kami akan memperbarui status kampanye dan mengirimkan kwitansi digital via WhatsApp.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar Actions Column -->
        <div class="actions-col">
          <div class="action-card">
            <h3 class="action-title">Bantuan & Konfirmasi</h3>
            <p class="action-desc">Sudah mentransfer dana atau membutuhkan bantuan verifikasi manual?</p>

            <div class="action-buttons-group">
              <a
                id="btnWaConfirm"
                href="https://wa.me/6281234567890?text=Halo%20Admin%20Filantrofi,%20saya%20sudah%20melakukan%20pembayaran%20donasi"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-action-primary"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                </svg>
                <span>Konfirmasi via WhatsApp</span>
              </a>

              <a href="/" class="btn-action-secondary">
                <span>Kembali ke Beranda</span>
              </a>
            </div>

            <div class="security-guarantee">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              <span>Verifikasi otomatis oleh sistem pembayaran mitra perbankan.</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  // Countdown Timer (24 Hours)
  let duration = 24 * 60 * 60 - 15;
  const timerEl = document.getElementById('countdownTimer');

  function updateTimer() {
    if (duration <= 0) {
      if (timerEl) timerEl.textContent = '00:00:00 (Kedaluwarsa)';
      return;
    }
    const hours = Math.floor(duration / 3600);
    const minutes = Math.floor((duration % 3600) / 60);
    const seconds = duration % 60;

    const pad = (n: number) => n.toString().padStart(2, '0');
    if (timerEl) {
      timerEl.textContent = `${pad(hours)}:${pad(minutes)}:${pad(seconds)}`;
    }
    duration--;
  }

  setInterval(updateTimer, 1000);
  updateTimer();

  // Parse URL search params to populate dynamic transaction values
  const urlParams = new URLSearchParams(window.location.search);
  const totalParam = urlParams.get('total');
  const methodParam = urlParams.get('method') || 'qris';
  const nameParam = urlParams.get('name') || 'Donatur';

  if (totalParam) {
    const totalNum = parseInt(totalParam, 10);
    const displayTotalEl = document.getElementById('displayTotalAmount');
    if (displayTotalEl && !isNaN(totalNum)) {
      displayTotalEl.textContent = 'Rp ' + totalNum.toLocaleString('id-ID');
    }
  }

  // Handle payment method display
  const qrisContainer = document.getElementById('qrisContainer');
  const vaContainer = document.getElementById('vaContainer');
  const displayBankName = document.getElementById('displayBankName');
  const displayVaNumber = document.getElementById('displayVaNumber');
  const methodTitle = document.getElementById('methodTitle');

  if (methodParam.startsWith('va-')) {
    if (qrisContainer) qrisContainer.style.display = 'none';
    if (vaContainer) vaContainer.style.display = 'flex';
    if (methodTitle) methodTitle.textContent = 'Nomor Rekening Virtual Account';

    const bankMap: Record<string, { bank: string; va: string }> = {
      'va-bca': { bank: 'BCA Virtual Account', va: '8214 0812 3456 7890' },
      'va-mandiri': { bank: 'Mandiri Virtual Account (Livin)', va: '8910 2039 4810 2938' },
      'va-bri': { bank: 'BRI Virtual Account (BRIVA)', va: '1029 3847 5610 2938' },
      'va-bni': { bank: 'BNI Virtual Account', va: '9880 1928 3746 5102' },
      'va-bsi': { bank: 'BSI Virtual Account', va: '7102 9384 7561 0293' },
    };

    const target = bankMap[methodParam] || bankMap['va-bca'];
    if (displayBankName) displayBankName.textContent = target.bank;
    if (displayVaNumber) displayVaNumber.textContent = target.va;
  } else if (methodParam.startsWith('manual')) {
    if (qrisContainer) qrisContainer.style.display = 'none';
    if (vaContainer) vaContainer.style.display = 'flex';
    if (methodTitle) methodTitle.textContent = 'Rekening Transfer Manual';
    if (displayBankName) displayBankName.textContent = 'Bank Syariah Indonesia (BSI)';
    if (displayVaNumber) displayVaNumber.textContent = '712 3456 789';
  } else {
    // Default QRIS
    if (qrisContainer) qrisContainer.style.display = 'flex';
    if (vaContainer) vaContainer.style.display = 'none';
    if (methodTitle) methodTitle.textContent = 'Scan QRIS Real-Time';
  }

  // Copy helpers
  function setupCopyButton(btnId: string, getValue: () => string) {
    const btn = document.getElementById(btnId);
    btn?.addEventListener('click', async () => {
      const text = getValue();
      try {
        await navigator.clipboard.writeText(text);
        const textSpan = btn.querySelector('.btn-copy-text');
        if (textSpan) {
          const original = textSpan.textContent;
          textSpan.textContent = 'Tersalin!';
          setTimeout(() => {
            textSpan.textContent = original;
          }, 2000);
        }
      } catch (err) {
        alert('Tersalin: ' + text);
      }
    });
  }

  setupCopyButton('copyAmountBtn', () => {
    const el = document.getElementById('displayTotalAmount');
    return el ? el.textContent?.replace(/\D/g, '') || '' : '';
  });

  setupCopyButton('copyVaBtn', () => {
    const el = document.getElementById('displayVaNumber');
    return el ? el.textContent?.replace(/\s/g, '') || '' : '';
  });
</script>

