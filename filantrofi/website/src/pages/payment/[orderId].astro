                  <span class="field-title">Nomor Virtual Account / Rekening</span>
                  <span id="displayVaNumber" class="field-val va-code">8214 0812 3456 7890</span>
                </div>
                <button type="button" id="copyVaBtn" class="btn-copy">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
