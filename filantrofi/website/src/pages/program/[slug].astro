    }
  }

  .sticky-sidebar-card {
    position: sticky;
    top: 96px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .sidebar-badge {
    align-self: flex-start;
    background: #eff6ff;
    color: #0969da;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
  }

  .sidebar-heading {
    font-size: 18px;
    font-weight: 800;
    color: #0f172a;
  }

  .sidebar-sub {
    font-size: 13px;
    color: #64748b;
  }

  .sidebar-progress {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .sb-amount-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .sb-collected {
    font-size: 16px;
    font-weight: 800;
    color: #0969da;
  }

  .sb-pct {
    font-size: 12px;
    font-weight: 700;
    color: #475569;
  }

  .sb-bar-wrap {
    height: 6px;
    background: #e2e8f0;
    border-radius: 999px;
    overflow: hidden;
  }

  .sb-bar-fill {
