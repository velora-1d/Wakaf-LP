  .btn-sidebar-donate {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #0969da;
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    padding: 14px 20px;
    border-radius: 10px;
    transition: background 0.15s ease;
  }

  .btn-sidebar-donate:hover {
    background: #0752a8;
  }

  .sidebar-security-note {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    color: #64748b;
    padding-top: 8px;
    border-top: 1px solid #e2e8f0;
  }
</style>
