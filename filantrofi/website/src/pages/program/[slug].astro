---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import CampaignHeader from '../../components/detail/CampaignHeader.astro';
import StickyDonationBar from '../../components/detail/StickyDonationBar.astro';
import FundUsageModal from '../../components/detail/FundUsageModal.astro';
import DonorFeed from '../../components/donor/DonorFeed.astro';
import { campaigns, type Campaign } from '../../data/campaigns';

export function getStaticPaths() {
  return campaigns.map((campaign) => ({
    params: { slug: campaign.slug },
    props: { campaign },
  }));
}

interface Props {
  campaign: Campaign;
}

const { campaign } = Astro.props;

const percentage = Math.min(Math.round((campaign.collectedAmount / campaign.targetAmount) * 100), 100);

const formatRupiah = (val: number) => {
  return 'Rp ' + val.toLocaleString('id-ID');
};
---

<Layout title={`${campaign.title} - Filantrofi`} description={campaign.shortDescription}>
  <Navbar />

  <main class="detail-main">
    <!-- Campaign Header & Top Stats -->
    <CampaignHeader
      title={campaign.title}
      category={campaign.category}
      institution={campaign.institution}
      verified={campaign.verified}
      imageUrl={campaign.imageUrl}
      galleryImages={campaign.galleryImages}
      collectedAmount={campaign.collectedAmount}
      targetAmount={campaign.targetAmount}
      donorCount={campaign.donorCount}
      daysRemaining={campaign.daysRemaining}
      location={campaign.location}
      slug={campaign.slug}
    />

    <!-- Main Content Container with Tabs & Sidebar -->
    <section class="content-section">
      <div class="content-container">
        <div class="layout-grid">
          <!-- Primary Content Column -->
          <div class="primary-col">
            <!-- Navigation Tabs Bar -->
            <nav class="tabs-nav" role="tablist" aria-label="Navigasi Informasi Kampanye">
              <button
                type="button"
                role="tab"
                id="tab-btn-story"
                class="tab-btn active"
                aria-selected="true"
                aria-controls="panel-story"
                data-tab="story"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                  <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                </svg>
                <span>Cerita Lengkap</span>
              </button>

              <button
                type="button"
                role="tab"
                id="tab-btn-news"
                class="tab-btn"
                aria-selected="false"
                aria-controls="panel-news"
                data-tab="news"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M19 20H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v1m2 13a2 2 0 0 1-2-2V7m2 13a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
                </svg>
                <span>Kabar Penyaluran</span>
                <span class="tab-badge">{campaign.newsUpdates.length}</span>
              </button>

              <button
                type="button"
                role="tab"
                id="tab-btn-donatur"
                class="tab-btn"
                aria-selected="false"
                aria-controls="panel-donatur"
                data-tab="donatur"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                <span>Donatur & Doa</span>
                <span class="tab-badge">{campaign.donorCount}</span>
              </button>

              <button
                type="button"
                role="tab"
                id="tab-btn-fundraiser"
                class="tab-btn"
                aria-selected="false"
                aria-controls="panel-fundraiser"
                data-tab="fundraiser"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                <span>Profil Pengelola</span>
              </button>
            </nav>

            <!-- Tab Panels Container -->
            <div class="tab-panels-wrapper">
              <!-- Panel 1: Story -->
              <div
                id="panel-story"
                class="tab-panel active"
                role="tabpanel"
                aria-labelledby="tab-btn-story"
              >
                <div class="prose-content">
                  <div class="summary-highlight">
                    <p>{campaign.shortDescription}</p>
                  </div>

                  {campaign.story.map((paragraph) => (
                    <p class="story-paragraph">{paragraph}</p>
                  ))}
                </div>

                <!-- Fund Allocation Component -->
                <FundUsageModal
                  allocations={campaign.fundAllocations}
                  totalTarget={campaign.targetAmount}
                />

                <!-- Call to action inside story -->
                <div class="story-cta-box">
                  <div class="cta-text-col">
                    <h4 class="cta-box-title">Salurkan Wakaf Terbaik Anda Sekarang</h4>
                    <p class="cta-box-sub">Kebaikan abadi yang terus mengalir untuk pembangunan sarana umat.</p>
                  </div>
                  <a href={`/checkout/${campaign.slug}`} class="btn-box-donate">
                    <span>Tunaikan Wakaf</span>
                  </a>
                </div>
              </div>

              <!-- Panel 2: News Updates -->
              <div
                id="panel-news"
                class="tab-panel"
                role="tabpanel"
                aria-labelledby="tab-btn-news"
              >
                <div class="news-timeline">
                  {campaign.newsUpdates.map((news) => (
                    <article class="timeline-entry">
                      <div class="timeline-dot"></div>
                      <div class="timeline-card">
                        <div class="news-header">
                          <span class="news-date">{news.date}</span>
                          <span class="news-author">Ditulis oleh: {news.author}</span>
                        </div>
                        <h4 class="news-title">{news.title}</h4>
                        <p class="news-text">{news.content}</p>
                        {news.images && news.images.length > 0 && (
                          <div class="news-gallery">
                            {news.images.map((img) => (
                              <img src={img} alt={news.title} class="news-thumb" loading="lazy" />
                            ))}
                          </div>
                        )}
                      </div>
                    </article>
                  ))}
                </div>
              </div>

              <!-- Panel 3: Donatur & Doa Feed -->
              <div
                id="panel-donatur"
                class="tab-panel"
                role="tabpanel"
                aria-labelledby="tab-btn-donatur"
              >
                <DonorFeed prayers={campaign.donorPrayers} totalDonors={campaign.donorCount} />
              </div>

              <!-- Panel 4: Fundraiser Profile -->
              <div
                id="panel-fundraiser"
                class="tab-panel"
                role="tabpanel"
                aria-labelledby="tab-btn-fundraiser"
              >
                <div class="fundraiser-profile-card">
                  <div class="profile-header">
                    <img
                      src={campaign.fundraiser.avatarUrl}
                      alt={campaign.fundraiser.name}
                      class="profile-avatar"
                    />
                    <div class="profile-info">
                      <div class="name-status">
                        <h3 class="profile-name">{campaign.fundraiser.name}</h3>
                        {campaign.fundraiser.verified && (
                          <span class="verified-pill">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                              <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                            </svg>
                            Nadzir Resmi
                          </span>
                        )}
                      </div>
                      <span class="profile-role">{campaign.fundraiser.role}</span>
                      <span class="profile-org">{campaign.fundraiser.organization}</span>
                    </div>
                  </div>

                  <p class="profile-bio">{campaign.fundraiser.bio}</p>

                  <div class="credentials-grid">
                    <div class="cred-item">
                      <span class="cred-title">SK Kemenag / BWI</span>
                      <span class="cred-val">No. 3.3.00281/BWI/2021</span>
                    </div>
                    <div class="cred-item">
                      <span class="cred-title">Kepatuhan Syariah</span>
                      <span class="cred-val">Diawasi Dewan Syariah</span>
                    </div>
                    <div class="cred-item">
                      <span class="cred-title">Kontak Resmi</span>
                      <span class="cred-val">{campaign.fundraiser.contactEmail}</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Secondary Column: Desktop Sticky Donation Sidebar -->
          <aside class="sidebar-col">
            <div class="sticky-sidebar-card">
              <div class="sidebar-badge">AKSI CEPAT</div>
              <h3 class="sidebar-heading">Tunaikan Sekarang</h3>
              <p class="sidebar-sub">Pilih nominal sedekah jariah untuk program ini.</p>

              <div class="sidebar-progress">
                <div class="sb-amount-row">
                  <span class="sb-collected">{formatRupiah(campaign.collectedAmount)}</span>
                  <span class="sb-pct">{percentage}%</span>
                </div>
                <div class="sb-bar-wrap">
                  <div class="sb-bar-fill" style={`width: ${percentage}%`}></div>
                </div>
                <div class="sb-target-row">
                  <span>Target: {formatRupiah(campaign.targetAmount)}</span>
                  <span>{campaign.daysRemaining} hari lagi</span>
                </div>
              </div>

              <div class="quick-preset-list">
                <a href={`/checkout/${campaign.slug}?nominal=50000`} class="quick-preset-link">
                  <span>Rp 50.000</span>
                  <span class="link-arrow">&rarr;</span>
                </a>
                <a href={`/checkout/${campaign.slug}?nominal=100000`} class="quick-preset-link">
                  <span>Rp 100.000</span>
                  <span class="link-arrow">&rarr;</span>
                </a>
                <a href={`/checkout/${campaign.slug}?nominal=500000`} class="quick-preset-link">
                  <span>Rp 500.000</span>
                  <span class="link-arrow">&rarr;</span>
                </a>
              </div>

              <a href={`/checkout/${campaign.slug}`} class="btn-sidebar-donate">
                <span>Wakaf Sekarang</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </a>

              <div class="sidebar-security-note">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <path d="m9 12 2 2 4-4"></path>
                </svg>
                <span>Pembayaran aman bersertifikasi enkripsi SSL 256-bit</span>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>

  <!-- Mobile Sticky Bottom Floating Bar -->
  <StickyDonationBar
    slug={campaign.slug}
    collectedAmount={campaign.collectedAmount}
    percentage={percentage}
    ctaText="Wakaf Sekarang"
  />
</Layout>

<script>
  // Tab switching logic
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const tabPanels = document.querySelectorAll<HTMLDivElement>('.tab-panel');

  function switchTab(tabName: string) {
    tabBtns.forEach((btn) => {
      const isTarget = btn.getAttribute('data-tab') === tabName;
      btn.classList.toggle('active', isTarget);
      btn.setAttribute('aria-selected', isTarget ? 'true' : 'false');
    });

    tabPanels.forEach((panel) => {
      const isTarget = panel.id === `panel-${tabName}`;
      panel.classList.toggle('active', isTarget);
    });
  }

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tabName = btn.getAttribute('data-tab');
      if (tabName) {
        switchTab(tabName);
        window.location.hash = tabName;
      }
    });
  });

  // Handle URL hash on initial load
  window.addEventListener('DOMContentLoaded', () => {
    const hash = window.location.hash.replace('#', '');
    if (hash && ['story', 'news', 'donatur', 'fundraiser'].includes(hash)) {
      switchTab(hash);
    }
  });
</script>

<style>
  .detail-main {
    min-height: 100vh;
    background: #f8fafc;
    padding-bottom: 80px;
  }

  .content-section {
    padding-top: 32px;
  }

  .content-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 992px) {
    .layout-grid {
      grid-template-columns: 1fr 360px;
      gap: 40px;
      align-items: start;
    }
  }

  /* Navigation Tabs */
  .tabs-nav {
    display: flex;
    gap: 8px;
    border-bottom: 2px solid #e2e8f0;
    margin-bottom: 28px;
    overflow-x: auto;
    padding-bottom: 2px;
  }

  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    margin-bottom: -2px;
    padding: 12px 18px;
    font-size: 14px;
    font-weight: 600;
    color: #64748b;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .tab-btn:hover {
    color: #0969da;
  }

  .tab-btn.active {
    color: #0969da;
    border-bottom-color: #0969da;
  }

  .tab-badge {
    background: #e2e8f0;
    color: #475569;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 999px;
  }

  .tab-btn.active .tab-badge {
    background: #dbeafe;
    color: #0969da;
  }

  /* Tab Panels */
  .tab-panel {
    display: none;
  }

  .tab-panel.active {
    display: block;
    animation: fadeIn 0.2s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Story Panel */
  .prose-content {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .summary-highlight {
    background: #f0f7ff;
    border-left: 4px solid #0969da;
    padding: 16px 20px;
    border-radius: 0 8px 8px 0;
    font-size: 15px;
    font-weight: 500;
    color: #0c4a6e;
    line-height: 1.6;
  }

  .story-paragraph {
    font-size: 15px;
    line-height: 1.75;
    color: #334155;
  }

  .story-cta-box {
    margin-top: 24px;
    background: #ffffff;
    border: 1.5px solid #0969da;
    border-radius: 12px;
    padding: 20px 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .cta-box-title {
    font-size: 16px;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 2px;
  }

  .cta-box-sub {
    font-size: 13px;
    color: #64748b;
  }

  .btn-box-donate {
    background: #0969da;
    color: #ffffff;
    font-weight: 700;
    font-size: 14px;
    padding: 10px 20px;
    border-radius: 8px;
    transition: background 0.15s ease;
  }

  .btn-box-donate:hover {
    background: #0752a8;
  }

  /* News Timeline */
  .news-timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-left: 20px;
    border-left: 2px solid #e2e8f0;
    margin-left: 10px;
  }

  .timeline-entry {
    position: relative;
  }

  .timeline-dot {
    position: absolute;
    left: -29px;
    top: 6px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #0969da;
    border: 3px solid #ffffff;
    box-shadow: 0 0 0 2px #bfdbfe;
  }

  .timeline-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .news-header {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: #64748b;
  }

  .news-date {
    font-weight: 600;
    color: #0969da;
  }

  .news-title {
    font-size: 17px;
    font-weight: 800;
    color: #0f172a;
  }

  .news-text {
    font-size: 14px;
    color: #334155;
    line-height: 1.6;
  }

  .news-gallery {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding-top: 6px;
  }

  .news-thumb {
    width: 140px;
    height: 95px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
  }

  /* Fundraiser Profile */
