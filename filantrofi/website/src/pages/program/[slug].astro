    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .profile-header {
    display: flex;
    gap: 18px;
    align-items: center;
  }

  .profile-avatar {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #e2e8f0;
  }

  .profile-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .name-status {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .profile-name {
    font-size: 18px;
    font-weight: 800;
    color: #0f172a;
  }

  .verified-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #eff6ff;
    color: #0969da;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 999px;
  }

  .profile-role {
    font-size: 13px;
    font-weight: 600;
    color: #475569;
  }

  .profile-org {
    font-size: 12px;
    color: #64748b;
  }

  .profile-bio {
    font-size: 14px;
    color: #334155;
    line-height: 1.6;
  }

  .credentials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 14px;
    padding-top: 14px;
    border-top: 1px solid #e2e8f0;
  }

  .cred-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cred-title {
    font-size: 11px;
    text-transform: uppercase;
    color: #64748b;
    font-weight: 600;
  }

  .cred-val {
    font-size: 13px;
    font-weight: 700;
    color: #0f172a;
  }

  /* Sidebar Column */
  .sidebar-col {
    display: none;
  }

  @media (min-width: 992px) {
    .sidebar-col {
