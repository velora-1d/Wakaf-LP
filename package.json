{
  "name": "wakaf-monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:lp": "pnpm --filter landing-page dev",
    "dev:rutin": "pnpm --filter wakaf-rutin dev",
    "dev:web": "pnpm --filter astro-web dev",
    "build": "pnpm --filter astro-web build",
    "build:lp": "pnpm --filter landing-page build",
    "build:web": "pnpm --filter astro-web build",
    "build:cf": "CLOUDFLARE=true pnpm --filter astro-web build",
    "deploy:cf": "CLOUDFLARE=true pnpm --filter astro-web build && pnpm --filter astro-web exec wrangler deploy",
    "preview:lp": "pnpm --filter landing-page preview",
    "preview:web": "pnpm --filter astro-web preview"
  }
}
