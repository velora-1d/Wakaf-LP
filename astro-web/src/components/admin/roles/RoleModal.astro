---
// src/components/admin/roles/RoleModal.astro
interface Props {
  roles: Array<{ roleKey: string; roleName: string; [key: string]: any }>;
  menus: Array<{ key: string; name: string; category: string; desc?: string }>;
}

const { roles, menus } = Astro.props;
---

<!-- SLIDE-OVER DRAWER EDIT PERMISSIONS PER USER -->
<div id="userDrawerBackdrop" class="fixed inset-0 z-50 bg-slate-950/50 backdrop-blur-xs flex justify-end opacity-0 pointer-events-none transition-opacity duration-300">
  <div id="userDrawerBox" class="w-full sm:w-[600px] h-full bg-white flex flex-col shadow-2xl border-l border-slate-200 transform translate-x-full transition-transform duration-300 ease-out overflow-hidden">
    <!-- Drawer Header -->
    <div class="h-16 px-6 border-b border-slate-200 flex items-center justify-between bg-white shrink-0">
      <div>
        <span class="inline-flex px-1.5 py-0.5 rounded text-[10px] font-bold bg-blue-50 text-[#0969da] border border-blue-200 uppercase mb-0.5">
          Hak Akses Akun Pengguna
        </span>
        <h2 id="userDrawerTitle" class="text-base font-bold text-slate-900 m-0">Atur Menu Pengguna</h2>
      </div>
      <button
        type="button"
        id="btnCloseUserDrawer"
        class="p-2 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition-colors cursor-pointer"
        aria-label="Tutup Panel"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Drawer Body -->
    <div class="flex-1 overflow-y-auto p-6 space-y-5">
      <input type="hidden" id="editUserId" />

      <div class="space-y-1.5">
        <label class="text-xs font-bold text-slate-700">Role Pengguna</label>
        <select id="editUserRole" class="h-9 w-full rounded-md border border-slate-200 bg-white px-3 text-xs font-medium text-slate-800 focus:outline-none focus:ring-1 focus:ring-slate-950">
          {roles.map(r => (
            <option value={r.roleKey}>{r.roleName} ({r.roleKey})</option>
          ))}
        </select>
      </div>

      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <label class="text-xs font-bold text-slate-700 uppercase tracking-wide">Menu yang Diizinkan (Checkbox):</label>
          <div class="flex gap-2">
            <button type="button" id="btnUserSelectAll" class="text-[11px] font-semibold text-[#0969da] hover:underline cursor-pointer">Centang Semua</button>
            <span class="text-slate-300">&bull;</span>
            <button type="button" id="btnUserDeselectAll" class="text-[11px] font-semibold text-rose-600 hover:underline cursor-pointer">Hapus Centang</button>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          {menus.map((menu) => (
            <label class="flex items-start gap-2.5 p-2.5 rounded-lg border border-slate-200 bg-slate-50/50 hover:bg-blue-50/30 transition-colors cursor-pointer select-none">
              <input
                type="checkbox"
                class="user-menu-checkbox h-4 w-4 mt-0.5 rounded border-slate-300 text-[#0969da] focus:ring-1 focus:ring-[#0969da] cursor-pointer shrink-0"
                value={menu.key}
              />
              <div class="min-w-0">
                <span class="text-xs font-bold text-slate-800 block leading-tight">{menu.name}</span>
                <span class="text-[10px] text-slate-400 block leading-tight">{menu.category}</span>
              </div>
            </label>
          ))}
        </div>
      </div>
    </div>

    <!-- Drawer Footer -->
    <div class="p-4 border-t border-slate-200 bg-slate-50 flex items-center justify-end gap-2.5 shrink-0">
      <button
        type="button"
        id="btnCancelUserDrawer"
        class="h-9 px-4 rounded-md border border-slate-200 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-100 transition-colors cursor-pointer"
      >
        Batal
      </button>
      <button
        type="button"
        id="btnSaveUserPermissions"
        class="h-9 px-5 rounded-md bg-[#0969da] hover:bg-[#0752a8] text-white text-xs font-semibold shadow-xs transition-colors cursor-pointer flex items-center gap-1.5"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span id="btnSaveUserText">Simpan Hak Akses</span>
      </button>
    </div>
  </div>
</div>
