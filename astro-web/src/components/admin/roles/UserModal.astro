---
// src/components/admin/roles/UserModal.astro
interface Props {
  roles: Array<{ roleKey: string; roleName: string; [key: string]: any }>;
}

const { roles } = Astro.props;
---

<!-- MODAL TAMBAH & EDIT PENGGUNA -->
<div id="userAccountModal" class="fixed inset-0 z-50 bg-slate-950/50 backdrop-blur-xs flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-200">
  <div class="w-full max-w-md bg-white rounded-xl shadow-2xl border border-slate-200 overflow-hidden transform scale-95 transition-transform duration-200" id="userAccountModalBox">
    <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/70">
      <div class="flex items-center gap-2.5">
        <span class="w-8 h-8 rounded-lg bg-blue-50 border border-blue-200 text-[#0969da] flex items-center justify-center">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <line x1="19" y1="8" x2="19" y2="14"/>
            <line x1="22" y1="11" x2="16" y2="11"/>
          </svg>
        </span>
        <div>
          <h3 id="userAccountModalTitle" class="text-sm font-bold text-slate-900 m-0">Tambah Pengguna Baru</h3>
          <p class="text-[11px] text-slate-400 m-0">Pengaturan kredensial login dan wewenang akun admin.</p>
        </div>
      </div>
      <button type="button" id="btnCloseUserAccountModal" class="text-slate-400 hover:text-slate-700 p-1.5 rounded hover:bg-slate-100 transition-colors cursor-pointer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <form id="userAccountForm" class="p-5 space-y-4">
      <input type="hidden" id="inputUserId" value="" />

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1" for="inputUserName">
          Nama Lengkap <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="inputUserName"
          required
          placeholder="Contoh: Mahin Utsman Nawawi"
          class="h-9 w-full rounded-md border border-slate-200 bg-white px-3 text-xs text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-1 focus:ring-slate-950"
        />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1" for="inputUserUsername">
          Nama Pengguna (Username) <span class="text-red-500">*</span>
        </label>
        <div class="relative">
          <span class="absolute left-3 top-2.5 text-xs text-slate-400 font-mono">@</span>
          <input
            type="text"
            id="inputUserUsername"
            required
            placeholder="username_staf"
            class="h-9 w-full rounded-md border border-slate-200 bg-white pl-7 pr-3 text-xs font-mono text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-1 focus:ring-slate-950"
          />
        </div>
        <span class="text-[10px] text-slate-400 mt-1 block">Digunakan untuk autentikasi login ke dasbor.</span>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1" for="inputUserPassword">
          Kata Sandi (Password) <span id="inputUserPasswordRequiredStar" class="text-red-500">*</span>
        </label>
        <div class="relative">
          <input
            type="password"
            id="inputUserPassword"
            placeholder="Minimal 6 karakter"
            class="h-9 w-full rounded-md border border-slate-200 bg-white pl-3 pr-10 text-xs text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-1 focus:ring-slate-950"
          />
          <button
            type="button"
            id="btnToggleUserPassword"
            class="absolute right-1 top-1 h-7 w-8 flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors cursor-pointer rounded"
            aria-label="Tampilkan atau sembunyikan kata sandi"
            title="Tampilkan / Sembunyikan Kata Sandi"
          >
            <svg id="iconUserEyeOpen" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
            <svg id="iconUserEyeClosed" class="hidden" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/>
              <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/>
              <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/>
              <line x1="2" y1="2" x2="22" y2="22"/>
            </svg>
          </button>
        </div>
        <span id="inputUserPasswordHint" class="text-[10px] text-slate-400 mt-1 block">
          Minimal 6 karakter. Dienkripsi aman dengan bcryptjs.
        </span>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1" for="inputUserRoleSelect">
          Role Jabatan &amp; Wewenang <span class="text-red-500">*</span>
        </label>
        <select id="inputUserRoleSelect" required class="h-9 w-full rounded-md border border-slate-200 bg-white px-3 text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-950 cursor-pointer">
          {roles.map(r => (
            <option value={r.roleKey}>{r.roleName} ({r.roleKey})</option>
          ))}
        </select>
      </div>

      <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2">
        <button
          type="button"
          id="btnCancelUserAccountModal"
          class="h-8 px-3 rounded-md border border-slate-200 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-100 transition-colors cursor-pointer"
        >
          Batal
        </button>
        <button
          type="submit"
          id="btnSubmitUserAccount"
          class="h-8 px-4 rounded-md bg-[#0969da] hover:bg-[#0752a8] text-white text-xs font-semibold shadow-xs transition-colors cursor-pointer inline-flex items-center gap-1.5"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span id="btnSubmitUserAccountText">Simpan Pengguna</span>
        </button>
      </div>
    </form>
  </div>
</div>
