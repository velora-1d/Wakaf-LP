              </span>
              <p class="text-[11px] text-slate-500 mt-0.5 mb-0">Foto hasil pembangunan, kegiatan santri, atau sarana fasilitas.</p>
            </div>
            <div id="showcaseListContainer" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
          </div>

          <!-- 4 Nilai Utama -->
          <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-2xs space-y-3">
            <div class="pb-1 border-b border-slate-100">
              <span class="text-xs font-bold text-slate-800">
                4 Poin Keunggulan Program
              </span>
            </div>
            <div id="valueBoxesListContainer" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
          </div>

          <!-- Poin Jaminan -->
