              <div class="space-y-2">
                <div class="flex items-center justify-between">
                  <label class="block text-[11px] font-semibold text-slate-700">Foto Kanan</label>
                  <div class="flex items-center gap-1.5">
                    <button type="button" class="btn-upload-twin text-xs px-2.5 py-1 bg-blue-50 text-[#0969da] border border-blue-200 hover:bg-blue-100 rounded-lg transition-colors cursor-pointer font-medium" data-twin-idx="1">
                      Pilih Foto
                    </button>
                    <button type="button" class="btn-delete-twin text-xs px-2.5 py-1 bg-rose-50 text-rose-600 border border-rose-200 hover:bg-rose-100 rounded-lg transition-colors cursor-pointer font-medium" data-twin-idx="1">
                      Hapus
                    </button>
                  </div>
                </div>
                <input type="hidden" id="vfTwinImg2" />
                <div class="w-full aspect-[4/3] rounded-lg bg-slate-900/5 border border-slate-200 overflow-hidden relative flex items-center justify-center">
                  <img id="vfTwinImg2Preview" src="" alt="Pratinjau Foto Kanan" class="w-full h-full object-contain hidden" />
                  <div id="vfTwinImg2Empty" class="text-slate-400 text-xs text-center p-2 flex flex-col items-center justify-center gap-1">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
