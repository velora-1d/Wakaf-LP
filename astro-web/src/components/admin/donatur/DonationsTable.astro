---
// src/components/admin/donatur/DonationsTable.astro
// Tab 1: Riwayat Donatur & Penerimaan Donasi GVF

interface LabelItem {
  id: number;
  nama: string;
  warna: string;
  deskripsi?: string | null;
}

interface Props {
  donations: any[];
  metrics: {
    totalPenghimpunan: number;
    lunasCount: number;
    pendingCount: number;
    totalDonors: number;
  };
  allLabels: LabelItem[];
  leadsMap: Record<string, { label: string; bg: string; text: string; border: string }>;
  programMap: Record<string, string>;
  labelColorMap: Record<string, { bg: string; text: string; border: string }>;
  formatRupiah: (val: number) => string;
  formatDate: (date: Date | string | null) => string;
  isAlokasiTab: boolean;
}

const {
  donations = [],
  metrics,
  allLabels = [],
  leadsMap = {},
  programMap = {},
  labelColorMap = {},
  formatRupiah,
  formatDate,
  isAlokasiTab,
} = Astro.props;
---

<div id="tabContentDonatur" class={isAlokasiTab ? 'hidden space-y-5' : 'space-y-5'}>
  <!-- Metrik Statistik Dashboard (Shadcn Card Style) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-2xs">
      <div class="flex items-center justify-between pb-2">
        <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Total Penghimpunan</span>
        <div class="w-7 h-7 rounded-md bg-blue-50 text-[#0969da] flex items-center justify-center">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="1" x2="12" y2="23"></line>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
        </div>
      </div>
      <div class="text-xl font-bold tracking-tight text-slate-900 font-mono">{formatRupiah(metrics.totalPenghimpunan)}</div>
      <p class="text-[11px] text-slate-400 mt-1 mb-0">Dana terverifikasi lunas di bank</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-2xs">
      <div class="flex items-center justify-between pb-2">
        <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Donasi Lunas (Verified)</span>
        <div class="w-7 h-7 rounded-md bg-emerald-50 text-emerald-600 flex items-center justify-center">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
        </div>
      </div>
      <div class="text-xl font-bold tracking-tight text-slate-900">{metrics.lunasCount} <span class="text-xs font-medium text-slate-500">Transaksi</span></div>
      <p class="text-[11px] text-emerald-600 font-medium mt-1 mb-0">Telah diverifikasi oleh tim amil GVF</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-2xs">
      <div class="flex items-center justify-between pb-2">
        <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Menunggu Verifikasi</span>
        <div class="w-7 h-7 rounded-md bg-amber-50 text-amber-600 flex items-center justify-center">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
        </div>
      </div>
      <div class="text-xl font-bold tracking-tight text-amber-600">{metrics.pendingCount} <span class="text-xs font-medium text-slate-500">Transaksi</span></div>
      <p class="text-[11px] text-slate-400 mt-1 mb-0">Perlu cek mutasi / bukti transfer</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-2xs">
      <div class="flex items-center justify-between pb-2">
        <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Total Donatur Unik</span>
        <div class="w-7 h-7 rounded-md bg-slate-100 text-slate-700 flex items-center justify-center">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </div>
      </div>
      <div class="text-xl font-bold tracking-tight text-slate-900">{metrics.totalDonors} <span class="text-xs font-medium text-slate-500">Muhsinin</span></div>
      <p class="text-[11px] text-slate-400 mt-1 mb-0">Tercatat dalam basis data kontak</p>
    </div>
  </div>

  <!-- Toolbar: Search & Filters (Shadcn Style) -->
  <div class="rounded-lg border border-slate-200 bg-white p-3 shadow-2xs space-y-3">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
      <!-- Search -->
      <div class="relative flex-1 max-w-md">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="text"
          id="tableSearchInput"
          placeholder="Cari nama, nomor WA, kota, atau kode transaksi..."
          class="h-9 w-full rounded-md border border-slate-200 bg-slate-50/50 pl-9 pr-3 text-xs text-slate-800 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-1 focus:ring-slate-950 focus:border-slate-400 transition-colors"
        />
      </div>

      <!-- Filters -->
      <div class="flex items-center gap-2 flex-wrap">
        <!-- Status Filter -->
        <select id="filterStatus" class="h-9 rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 shadow-2xs focus:outline-none focus:ring-1 focus:ring-slate-950 cursor-pointer">
          <option value="all">Semua Status</option>
          <option value="lunas">Lunas (Verified)</option>
          <option value="menunggu_verifikasi">Menunggu Verifikasi</option>
          <option value="dibatalkan">Dibatalkan</option>
        </select>

        <!-- Leads Filter -->
        <select id="filterLeads" class="h-9 rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 shadow-2xs focus:outline-none focus:ring-1 focus:ring-slate-950 cursor-pointer">
          <option value="all">Semua Saluran Leads</option>
          <option value="meta_ads">Meta Ads (FB/IG)</option>
          <option value="tiktok_ads">TikTok Ads</option>
          <option value="google_seo">Google SEO</option>
          <option value="safari_dakwah">Safari Dakwah</option>
          <option value="brosur_event">Brosur &amp; Event</option>
          <option value="relasi_langsung">Relasi Langsung</option>
          <option value="walk_in">Walk-in</option>
        </select>

        <!-- Program Filter (Hanya 4 Program Resmi di Web) -->
        <select id="filterProgram" class="h-9 rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 shadow-2xs focus:outline-none focus:ring-1 focus:ring-slate-950 cursor-pointer">
          <option value="all">Semua Program (4 Program)</option>
          <option value="wakaf">Wakaf (Wakaf Produktif &amp; Lahan)</option>
          <option value="infaq">Infaq (Infaq Pembangunan Fisik)</option>
          <option value="sedekah">Shodaqoh (Sedekah Nutrisi &amp; Pangan)</option>
          <option value="zakat">Zakat (Zakat Maal &amp; Fitrah)</option>
        </select>

        <!-- Filter Rentang Nominal Dinamis (Preset + Input Min/Max) -->
        <div class="flex items-center gap-1.5 rounded-md border border-slate-200 bg-white px-2 py-1 shadow-2xs">
          <select id="filterNominal" class="h-7 rounded border-0 bg-transparent pr-1 text-xs font-medium text-slate-700 focus:outline-none focus:ring-0 cursor-pointer">
            <option value="all">Semua Nominal</option>
            <option value="custom">Kustom (Min - Max)</option>
            <option value="under_100k">&lt; Rp 100.000</option>
            <option value="100k_500k">Rp 100.000 - Rp 500.000</option>
            <option value="500k_1m">Rp 500.000 - Rp 1.000.000</option>
            <option value="1m_5m">Rp 1.000.000 - Rp 5.000.000</option>
            <option value="above_5m">&gt; Rp 5.000.000 (Besar / VIP)</option>
          </select>
          <div class="flex items-center gap-1 pl-1.5 border-l border-slate-200">
            <span class="text-[11px] font-semibold text-slate-400 select-none">Rp</span>
            <input
              type="text"
              id="inputNominalMin"
              placeholder="Min"
              class="h-7 w-20 sm:w-24 rounded border border-slate-200 bg-slate-50/60 px-2 py-0.5 text-xs text-slate-800 placeholder:text-slate-400 focus:bg-white focus:border-[#0969da] focus:outline-none focus:ring-1 focus:ring-[#0969da]"
              title="Nominal Minimum (contoh: 50.000)"
            />
            <span class="text-slate-300 font-bold select-none">-</span>
            <input
              type="text"
              id="inputNominalMax"
              placeholder="Max"
              class="h-7 w-20 sm:w-24 rounded border border-slate-200 bg-slate-50/60 px-2 py-0.5 text-xs text-slate-800 placeholder:text-slate-400 focus:bg-white focus:border-[#0969da] focus:outline-none focus:ring-1 focus:ring-[#0969da]"
              title="Nominal Maksimum (contoh: 1.000.000)"
            />
          </div>
        </div>

        <!-- Filter Label Donatur -->
        <select id="filterLabel" class="h-9 rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 shadow-2xs focus:outline-none focus:ring-1 focus:ring-slate-950 cursor-pointer">
          <option value="all">Semua Label Donatur</option>
          {allLabels.map((lbl) => (
            <option value={String(lbl.id)}>Label: {lbl.nama}</option>
          ))}
        </select>

        <button
          type="button"
          id="btnResetFilters"
          class="h-9 px-3 rounded-md border border-slate-200 bg-white text-xs font-medium text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-colors cursor-pointer"
        >
          Reset
        </button>
      </div>
    </div>

    <!-- Bulk Action Bar (Hidden by default, shown when items checked) -->
    <div id="bulkActionBar" class="hidden items-center justify-between p-2 rounded-md bg-blue-50/70 border border-blue-200 text-xs">
      <div class="flex items-center gap-2 text-slate-800 font-medium">
        <span id="selectedCountText" class="font-bold text-[#0969da]">0</span>
        <span>transaksi dipilih</span>
      </div>
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="btnBulkVerifyLunas"
          class="h-7 px-2.5 rounded bg-emerald-600 text-white font-medium hover:bg-emerald-700 transition-colors shadow-2xs cursor-pointer flex items-center gap-1.5"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Verifikasi Lunas</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Table Container (Shadcn Data Table Style) -->
  <div class="rounded-lg border border-slate-200 bg-white overflow-hidden shadow-2xs">
    <div class="overflow-x-auto w-full">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-50/75 text-slate-500 font-medium tracking-wide">
            <!-- Checkbox Kolom -->
            <th class="w-10 px-3 py-3 text-center">
              <input
                type="checkbox"
                id="selectAllCheckbox"
                class="h-3.5 w-3.5 rounded border-slate-300 text-[#0969da] focus:ring-1 focus:ring-[#0969da] cursor-pointer"
                title="Pilih Semua"
              />
            </th>
            <!-- No Kolom -->
            <th class="w-12 px-2 py-3 text-center font-semibold text-slate-600">NO</th>
            <th class="px-3 py-3 font-semibold text-slate-600 whitespace-nowrap">KODE &amp; TANGGAL</th>
            <th class="px-3 py-3 font-semibold text-slate-600">PROFIL DONATUR</th>
            <th class="px-3 py-3 font-semibold text-slate-600">PROGRAM &amp; NIAT</th>
            <th class="px-3 py-3 font-semibold text-slate-600 whitespace-nowrap">NOMINAL (RP)</th>
            <th class="px-3 py-3 font-semibold text-slate-600 whitespace-nowrap">SUMBER LEADS</th>
            <th class="px-3 py-3 font-semibold text-slate-600 whitespace-nowrap">METODE &amp; BUKTI</th>
            <th class="px-3 py-3 font-semibold text-slate-600 whitespace-nowrap">STATUS</th>
            <th class="px-3 py-3 font-semibold text-slate-600 text-right whitespace-nowrap">AKSI</th>
          </tr>
        </thead>
        <tbody id="donationsTableBody" class="divide-y divide-slate-100">
          {donations.length === 0 ? (
            <tr>
              <td colspan="10" class="py-12 text-center text-slate-400">
                <div class="flex flex-col items-center justify-center gap-1.5">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-slate-300">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                  </svg>
                  <span class="font-semibold text-slate-700 text-sm">Belum ada catatan transaksi donasi</span>
                  <span class="text-xs text-slate-400">Klik "Catat Donasi Baru" untuk menambahkan data donatur.</span>
                </div>
              </td>
            </tr>
          ) : (
            donations.map((d, index) => {
              const leadInfo = leadsMap[d.sumberLeads] || { label: d.sumberLeads, bg: 'bg-slate-100', text: 'text-slate-700', border: 'border-slate-200' };
              const programName = programMap[d.programTujuan] || d.programTujuan;

              const waText = encodeURIComponent(
                `Assalamu'alaikum Warahmatullahi Wabarakatuh, Bpk/Ibu ${d.donor.namaLengkap}.\n\n` +
                `Terima kasih atas amanah donasi dan wakaf yang telah Anda salurkan melalui Global Village Fund (GVF).\n\n` +
                `*Rincian Transaksi Donasi:*\n` +
                `- No. Transaksi: *${d.kodeTransaksi}*\n` +
                `- Program: *${programName}*\n` +
                `- Atas Nama / Niat: *${d.atasNamaNiat || d.donor.namaLengkap}*\n` +
                `- Nominal: *${formatRupiah(d.nominalTotal)}*\n` +
                `- Status: *${d.statusPembayaran.toUpperCase()}*\n\n` +
                `Semoga Allah SWT melipatgandakan pahala kebaikan, menjadikannya amal jariyah yang mengalir abadi, serta memberkahi keluarga Bpk/Ibu sekalian. Aamiin ya Rabbal 'Alamin.\n\n` +
                `_Pusat Layanan Donatur Global Village Fund (GVF)_`
              );
              const waLink = `https://wa.me/${d.donor.noWhatsapp.replace(/^0/, '62').replace(/[^0-9]/g, '')}?text=${waText}`;

              return (
                <tr
                  class="donation-row hover:bg-slate-50/70 transition-colors"
                  data-search={`${d.kodeTransaksi} ${d.donor.namaLengkap} ${d.donor.noWhatsapp} ${d.donor.kotaDomisili || ''}`.toLowerCase()}
                  data-status={d.statusPembayaran}
                  data-lead={d.sumberLeads}
                  data-program={d.programTujuan}
                  data-nominal={d.nominalTotal}
                  data-labels={JSON.stringify((d.donor.labels || []).map((l: any) => String(l.id)))}
                  data-id={d.id}
                >
                  <!-- Checkbox -->
                  <td class="w-10 px-3 py-3 text-center">
                    <input
                      type="checkbox"
                      class="row-checkbox h-3.5 w-3.5 rounded border-slate-300 text-[#0969da] focus:ring-1 focus:ring-[#0969da] cursor-pointer"
                      data-id={d.id}
                    />
                  </td>

                  <!-- No -->
                  <td class="w-12 px-2 py-3 text-center font-mono font-medium text-slate-400">
                    {index + 1}
                  </td>

                  <!-- Kode & Tanggal -->
                  <td class="px-3 py-3 whitespace-nowrap">
                    <span class="font-mono font-semibold text-slate-900 block">{d.kodeTransaksi}</span>
                    <span class="text-[11px] text-slate-400 block">{formatDate(d.createdAt)}</span>
                  </td>

                  <!-- Profil Donatur -->
                  <td class="px-3 py-3">
                    <div class="flex items-center gap-1.5 flex-wrap">
                      <span class="font-semibold text-slate-900">{d.donor.namaLengkap}</span>
                      <span class={`inline-flex px-1.5 py-0.5 rounded text-[10px] font-semibold border ${
                        d.donor.tipeDonatur === 'korporasi'
                          ? 'bg-blue-50 text-[#0969da] border-blue-200'
                          : 'bg-slate-100 text-slate-600 border-slate-200'
                      }`}>
                        {d.donor.tipeDonatur}
                      </span>
                    </div>
                    <div class="text-[11px] text-slate-500 mt-0.5">
                      <span>{d.donor.noWhatsapp}</span>
                      {d.donor.kotaDomisili && <span> &bull; {d.donor.kotaDomisili}</span>}
                    </div>
                    {d.donor.labels && d.donor.labels.length > 0 && (
                      <div class="flex flex-wrap gap-1 mt-1.5">
                        {d.donor.labels.map((lbl: any) => {
                          const col = labelColorMap[lbl.warna] || labelColorMap.blue;
                          return (
                            <span class={`inline-flex items-center px-1.5 py-0.2 rounded text-[10px] font-semibold border ${col.bg} ${col.text} ${col.border}`}>
                              {lbl.nama}
                            </span>
                          );
                        })}
                      </div>
                    )}
                  </td>

                  <!-- Program & Niat -->
                  <td class="px-3 py-3">
                    <span class="font-medium text-slate-900 block">{programName}</span>
                    {d.atasNamaNiat && (
                      <span class="text-[11px] text-[#0969da] block">Niat: {d.atasNamaNiat}</span>
                    )}
                    {d.doaDonatur && (
                      <span class="text-[11px] text-slate-500 italic block truncate max-w-[200px]" title={d.doaDonatur}>
                        "{d.doaDonatur}"
                      </span>
                    )}
                  </td>

                  <!-- Nominal -->
                  <td class="px-3 py-3 whitespace-nowrap">
                    <span class="font-mono font-bold text-slate-900 text-xs block">{formatRupiah(d.nominalTotal)}</span>
                    {d.kodeUnik != null && d.kodeUnik > 0 && (
                      <span class="font-mono text-[10px] text-slate-400 block">Kode: +{d.kodeUnik}</span>
                    )}
                  </td>

                  <!-- Sumber Leads -->
                  <td class="px-3 py-3 whitespace-nowrap">
                    <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium border ${leadInfo.bg} ${leadInfo.text} ${leadInfo.border}`}>
                      {leadInfo.label}
                    </span>
                    {d.campaignUtm && (
                      <span class="font-mono text-[10px] text-slate-400 block mt-0.5">{d.campaignUtm}</span>
                    )}
                  </td>

                  <!-- Metode & Bukti S3 -->
                  <td class="px-3 py-3 whitespace-nowrap">
                    <span class="inline-flex px-1.5 py-0.5 rounded text-[11px] font-medium bg-slate-100 text-slate-700 border border-slate-200">
                      {d.metodePembayaran}
                    </span>
                    {d.buktiTransferUrl ? (
                      <button
                        type="button"
                        class="btn-view-proof flex items-center gap-1 text-[11px] font-semibold text-[#0969da] hover:underline mt-1 cursor-pointer"
                        data-proof-url={d.buktiTransferUrl}
                        data-kode={d.kodeTransaksi}
                      >
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
                          <circle cx="9" cy="9" r="2"></circle>
                          <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
                        </svg>
                        <span>Lihat Bukti S3</span>
                      </button>
                    ) : (
                      <span class="text-[10px] text-slate-300 block mt-0.5">Tanpa bukti</span>
                    )}
                  </td>

                  <!-- Status -->
                  <td class="px-3 py-3 whitespace-nowrap">
                    {d.statusPembayaran === 'lunas' && (
                      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                        Lunas
                      </span>
                    )}
                    {d.statusPembayaran === 'menunggu_verifikasi' && (
                      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                        Pending
                      </span>
                    )}
                    {d.statusPembayaran === 'dibatalkan' && (
                      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-600 border border-slate-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                        Batal
                      </span>
                    )}
                  </td>

                  <!-- Aksi -->
                  <td class="px-3 py-3 text-right whitespace-nowrap">
                    <div class="inline-flex items-center gap-1.5">
                      <!-- Kirim WhatsApp -->
                      <a
                        href={waLink}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-action-wa h-7 px-2 rounded bg-emerald-50 border border-emerald-200 text-emerald-700 hover:bg-emerald-600 hover:text-white transition-colors inline-flex items-center gap-1 font-semibold text-[11px] shadow-2xs cursor-pointer select-none"
                        data-action="wa"
                        data-wa-url={waLink}
                        title="Kirim Kwitansi via WhatsApp"
                      >
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none">
                          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                        <span class="pointer-events-none">WA</span>
                      </a>

                      <!-- Verifikasi Toggle -->
                      {d.statusPembayaran === 'menunggu_verifikasi' ? (
                        <button
                          type="button"
                          class="h-7 w-7 rounded bg-emerald-50 border border-emerald-200 text-emerald-700 hover:bg-emerald-600 hover:text-white transition-colors inline-flex items-center justify-center cursor-pointer shadow-2xs"
                          data-action="verify-lunas"
                          data-id={d.id}
                          title="Klik untuk Verifikasi LUNAS"
                        >
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none">
                            <polyline points="20 6 9 17 4 12"></polyline>
                          </svg>
                        </button>
                      ) : (
                        <button
                          type="button"
                          class="h-7 w-7 rounded bg-amber-50 border border-amber-200 text-amber-700 hover:bg-amber-600 hover:text-white transition-colors inline-flex items-center justify-center cursor-pointer shadow-2xs"
                          data-action="verify-pending"
                          data-id={d.id}
                          title="Klik untuk Ubah ke Status PENDING"
                        >
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                          </svg>
                        </button>
                      )}

                      <!-- Edit Transaksi & Profil Donatur -->
                      <button
                        type="button"
                        class="h-7 w-7 rounded bg-blue-50 border border-blue-200 text-[#0969da] hover:bg-[#0969da] hover:text-white transition-colors inline-flex items-center justify-center cursor-pointer shadow-2xs"
                        data-action="edit"
                        data-id={d.id}
                        data-json={JSON.stringify({
                          id: d.id,
                          kodeTransaksi: d.kodeTransaksi,
                          tanggalTransaksi: d.createdAt ? new Date(d.createdAt).toISOString().split('T')[0] : '',
                          namaLengkap: d.donor.namaLengkap,
                          namaTampilan: d.donor.namaTampilan || '',
                          tipeDonatur: d.donor.tipeDonatur,
                          noWhatsapp: d.donor.noWhatsapp,
                          email: d.donor.email || '',
                          kotaDomisili: d.donor.kotaDomisili || '',
                          programTujuan: d.programTujuan,
                          akadPeruntukan: d.akadPeruntukan,
                          nominal: d.nominal,
                          kodeUnik: d.kodeUnik,
                          atasNamaNiat: d.atasNamaNiat || '',
                          doaDonatur: d.doaDonatur || '',
                          sumberLeads: d.sumberLeads,
                          campaignUtm: d.campaignUtm || '',
                          metodePembayaran: d.metodePembayaran,
                          statusPembayaran: d.statusPembayaran,
                          buktiTransferUrl: d.buktiTransferUrl || '',
                          catatanTransaksi: d.catatanTransaksi || '',
                          labelIds: (d.donor.labels || []).map((l: any) => l.id),
                        })}
                        title="Edit Transaksi & Donatur"
                      >
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none">
                          <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                          <path d="m15 5 4 4"/>
                        </svg>
                      </button>

                      <!-- Hapus -->
                      <button
                        type="button"
                        class="h-7 w-7 rounded bg-red-50 border border-red-200 text-red-600 hover:bg-red-600 hover:text-white transition-colors inline-flex items-center justify-center cursor-pointer shadow-2xs"
                        data-action="delete"
                        data-id={d.id}
                        data-kode={d.kodeTransaksi}
                        title="Hapus Transaksi"
                      >
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none">
                          <polyline points="3 6 5 6 21 6"></polyline>
                          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                      </button>
                    </div>
                  </td>
                </tr>
              );
            })
          )}
        </tbody>
      </table>
    </div>
    <div class="px-4 py-3 border-t border-slate-200 bg-slate-50/75 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-600">
      <!-- Per-page selection & count -->
      <div class="flex items-center gap-2.5">
        <span class="text-slate-500">Tampilkan</span>
        <select id="donationsPerPage" class="h-8 rounded-md border border-slate-200 bg-white px-2 py-0.5 text-xs font-semibold text-slate-700 shadow-2xs focus:outline-none focus:ring-1 focus:ring-slate-950 cursor-pointer">
          <option value="10">10 data</option>
          <option value="25" selected>25 data</option>
          <option value="50">50 data</option>
          <option value="all">Semua</option>
        </select>
        <span class="text-slate-500">
          dari <strong id="donationsTotalCount" class="font-semibold text-slate-800">{donations.length}</strong> data
          <span id="donationsRangeText" class="text-slate-400 text-[11px] ml-1"></span>
        </span>
      </div>

      <!-- Pagination Controls -->
      <div class="flex items-center gap-1.5" id="donationsPaginationControls">
        <button
          type="button"
          id="btnDonationsPrevPage"
          class="h-8 px-2.5 rounded-md border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 hover:text-slate-900 disabled:opacity-40 disabled:cursor-not-allowed transition-colors shadow-2xs flex items-center gap-1 font-medium cursor-pointer"
          aria-label="Halaman Sebelumnya"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span class="hidden sm:inline">Sebelumnya</span>
        </button>

        <div id="donationsPageNumbers" class="flex items-center gap-1">
          <!-- Injected by JS -->
        </div>

        <button
          type="button"
          id="btnDonationsNextPage"
          class="h-8 px-2.5 rounded-md border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 hover:text-slate-900 disabled:opacity-40 disabled:cursor-not-allowed transition-colors shadow-2xs flex items-center gap-1 font-medium cursor-pointer"
          aria-label="Halaman Berikutnya"
        >
          <span class="hidden sm:inline">Berikutnya</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>
