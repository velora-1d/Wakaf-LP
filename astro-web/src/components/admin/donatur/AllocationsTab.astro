---
// src/components/admin/donatur/AllocationsTab.astro
// Tab 2: Realisasi Alokasi Kas GVF (Debit • Kredit • Saldo)

interface Props {
  allocations: any[];
  allocMetrics: {
    totalDebit: number;
    totalKredit: number;
    saldoAkhir: number;
    totalTransaksi: number;
  };
  programMap: Record<string, string>;
  programBadgeMap: Record<string, { bg: string; text: string; border: string }>;
  formatRupiah: (val: number) => string;
  formatDate: (date: Date | string | null) => string;
  isAlokasiTab: boolean;
}

const {
  allocations = [],
  allocMetrics,
  programMap = {},
  programBadgeMap = {},
  formatRupiah,
  formatDate,
  isAlokasiTab,
} = Astro.props;
---

<div id="tabContentAlokasi" class={isAlokasiTab ? 'space-y-5' : 'hidden space-y-5'}>
  <!-- Metrik Arus Kas (Shadcn Card Style) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-2xs">
      <div class="flex items-center justify-between pb-2">
        <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Total Kas Masuk (+Debit)</span>
        <div class="w-7 h-7 rounded-md bg-blue-50 text-[#0969da] flex items-center justify-center">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 5v14M19 12l-7 7-7-7"/>
          </svg>
        </div>
      </div>
      <div class="text-xl font-bold tracking-tight text-emerald-600 font-mono">+{formatRupiah(allocMetrics.totalDebit)}</div>
      <p class="text-[11px] text-slate-400 mt-1 mb-0">Total pencairan dana masuk ke kas</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-2xs">
      <div class="flex items-center justify-between pb-2">
        <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Realisasi Belanja (-Kredit)</span>
        <div class="w-7 h-7 rounded-md bg-rose-50 text-rose-600 flex items-center justify-center">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 19V5M5 12l7-7 7 7"/>
          </svg>
        </div>
      </div>
      <div class="text-xl font-bold tracking-tight text-rose-600 font-mono">-{formatRupiah(allocMetrics.totalKredit)}</div>
      <p class="text-[11px] text-slate-400 mt-1 mb-0">Pengeluaran terdistribusi &amp; belanja program</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-2xs">
      <div class="flex items-center justify-between pb-2">
        <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Saldo Kas Berjalan</span>
        <div class="w-7 h-7 rounded-md bg-slate-100 text-slate-700 flex items-center justify-center">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="5" width="20" height="14" rx="2"/>
            <line x1="2" y1="10" x2="22" y2="10"/>
          </svg>
        </div>
      </div>
      <div class={`text-xl font-bold tracking-tight font-mono ${allocMetrics.saldoAkhir >= 0 ? 'text-[#0969da]' : 'text-rose-600'}`}>
        {formatRupiah(allocMetrics.saldoAkhir)}
      </div>
      <div class="mt-1 flex items-center gap-1.5">
        <span class={`inline-flex items-center px-1.5 py-0.2 rounded text-[10px] font-semibold ${allocMetrics.saldoAkhir >= 0 ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-rose-50 text-rose-700 border border-rose-200'}`}>
          {allocMetrics.saldoAkhir >= 0 ? 'Surplus Kas' : 'Defisit Kas'}
        </span>
        <span class="text-[11px] text-slate-400">Buku Kas GVF</span>
      </div>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-2xs">
      <div class="flex items-center justify-between pb-2">
        <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Total Mutasi Transaksi</span>
        <div class="w-7 h-7 rounded-md bg-slate-50 text-slate-600 flex items-center justify-center">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
        </div>
      </div>
      <div class="text-xl font-bold tracking-tight text-slate-900">{allocMetrics.totalTransaksi} <span class="text-xs font-medium text-slate-500">Voucher</span></div>
      <p class="text-[11px] text-slate-400 mt-1 mb-0">Debit &amp; kredit terverifikasi</p>
    </div>
  </div>

  <!-- Filter & Action Bar Alokasi Kas -->
  <div class="rounded-xl border border-slate-200 bg-white p-3.5 shadow-2xs space-y-3">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3">
      <!-- Search & Filter Controls -->
      <div class="flex flex-wrap items-center gap-2.5 flex-1">
        <!-- Input Search Realtime -->
        <div class="relative flex-1 min-w-[240px] max-w-md">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
          <input
            type="text"
            id="alokasiSearchInput"
            placeholder="Cari voucher, pos belanja, uraian, atau PIC..."
            class="w-full pl-9 pr-3 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded-md focus:bg-white focus:outline-hidden focus:ring-1 focus:ring-[#0969da] focus:border-[#0969da] transition-all placeholder:text-slate-400"
          />
        </div>

        <!-- Filter Program GVF -->
        <div class="w-44">
          <select
            id="alokasiFilterProgram"
            class="w-full px-2.5 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded-md focus:bg-white focus:outline-hidden focus:ring-1 focus:ring-[#0969da] text-slate-700 cursor-pointer"
          >
            <option value="all">Semua Program GVF</option>
            <option value="wakaf">Wakaf</option>
            <option value="infaq">Infaq</option>
            <option value="sedekah">Shodaqoh</option>
            <option value="zakat">Zakat</option>
          </select>
        </div>

        <!-- Filter Jenis Transaksi -->
        <div class="w-40">
          <select
            id="alokasiFilterJenis"
            class="w-full px-2.5 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded-md focus:bg-white focus:outline-hidden focus:ring-1 focus:ring-[#0969da] text-slate-700 cursor-pointer"
          >
            <option value="all">Semua Jenis Kas</option>
            <option value="debit">+ Debit (Penerimaan)</option>
            <option value="kredit">- Kredit (Pengeluaran)</option>
          </select>
        </div>

        <button
          type="button"
          id="alokasiBtnResetFilters"
          class="h-8 px-2.5 text-xs text-slate-600 hover:text-slate-900 border border-slate-200 rounded-md hover:bg-slate-50 transition-colors cursor-pointer"
        >
          Reset
        </button>
      </div>

      <!-- Buttons Tambah Transaksi -->
      <div class="flex items-center gap-2 shrink-0">
        <button
          type="button"
          id="btnOpenCreateDebitAlokasi"
          class="inline-flex items-center gap-1.5 h-8 px-3 rounded-md text-xs font-semibold bg-[#0969da] text-white hover:bg-[#0752a8] shadow-2xs transition-colors cursor-pointer"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>+ Catat Kas Masuk</span>
        </button>

        <button
          type="button"
          id="btnOpenCreateKreditAlokasi"
          class="inline-flex items-center gap-1.5 h-8 px-3 rounded-md text-xs font-semibold bg-rose-600 text-white hover:bg-rose-700 shadow-2xs transition-colors cursor-pointer"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>- Catat Belanja</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Tabel Buku Kas Realisasi Alokasi (Shadcn Table Style) -->
  <div class="rounded-xl border border-slate-200 bg-white shadow-2xs overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-50/75 text-slate-600 font-semibold">
            <th class="py-3 px-3 text-center w-12">No</th>
            <th class="py-3 px-3 w-32">Tanggal</th>
            <th class="py-3 px-3 w-36">No. Bukti / Voucher</th>
            <th class="py-3 px-3 w-32">Program GVF</th>
            <th class="py-3 px-3 min-w-[220px]">Pos Anggaran &amp; Uraian Belanja</th>
            <th class="py-3 px-3 text-center w-24">Jenis</th>
            <th class="py-3 px-3 text-right w-36">Nominal</th>
            <th class="py-3 px-3 text-right w-36">Saldo Berjalan</th>
            <th class="py-3 px-3 text-center w-24">Nota S3</th>
            <th class="py-3 px-3 w-32">PIC Pelaksana</th>
            <th class="py-3 px-3 text-center w-20">Aksi</th>
          </tr>
        </thead>
        <tbody id="alokasiTableBody" class="divide-y divide-slate-100">
          {allocations.length === 0 ? (
            <tr id="emptyAlokasiRow">
              <td colspan="11" class="py-12 text-center text-slate-400">
                <div class="max-w-xs mx-auto space-y-2">
                  <div class="w-10 h-10 mx-auto rounded-full bg-slate-100 text-slate-400 flex items-center justify-center">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                      <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                    </svg>
                  </div>
                  <p class="text-xs font-medium text-slate-600 m-0">Belum ada catatan realisasi alokasi kas</p>
                  <p class="text-[11px] text-slate-400 m-0">Mulai catat belanja atau kas masuk dengan tombol di atas.</p>
                </div>
              </td>
            </tr>
          ) : (
            allocations.map((a, idx) => {
              const isDebit = a.jenisTransaksi === 'debit';
              const pKey = a.program.toLowerCase();
              const badge = programBadgeMap[pKey] || { bg: 'bg-slate-50', text: 'text-slate-700', border: 'border-slate-200' };
              const pLabel = programMap[pKey] ? programMap[pKey].split(' ')[0] : a.program;

              return (
                <tr
                  class="alokasi-row hover:bg-slate-50/70 transition-colors"
                  data-id={a.id}
                  data-program={pKey}
                  data-jenis={a.jenisTransaksi}
                  data-search={`${a.kodeTransaksi} ${a.posAnggaran} ${a.uraian} ${a.pic || ''}`.toLowerCase()}
                >
                  <td class="py-3 px-3 text-center text-slate-400 font-mono text-[11px]">{idx + 1}</td>
                  <td class="py-3 px-3 text-slate-600 whitespace-nowrap text-[11px] font-mono">
                    {formatDate(a.tanggalTransaksi)}
                  </td>
                  <td class="py-3 px-3 whitespace-nowrap">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono font-semibold bg-slate-100 text-slate-800 border border-slate-200">
                      {a.kodeTransaksi}
                    </span>
                  </td>
                  <td class="py-3 px-3 whitespace-nowrap">
                    <span class={`inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold border ${badge.bg} ${badge.text} ${badge.border}`}>
                      {pLabel}
                    </span>
                  </td>
                  <td class="py-3 px-3">
                    <div class="font-semibold text-slate-900 text-xs">{a.posAnggaran}</div>
                    <div class="text-[11px] text-slate-500 line-clamp-1 mt-0.5" title={a.uraian}>
                      {a.uraian}
                    </div>
                  </td>
                  <td class="py-3 px-3 text-center whitespace-nowrap">
                    {isDebit ? (
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        + DEBIT
                      </span>
                    ) : (
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                        - KREDIT
                      </span>
                    )}
                  </td>
                  <td class="py-3 px-3 text-right whitespace-nowrap font-mono font-bold">
                    {isDebit ? (
                      <span class="text-emerald-700">+{formatRupiah(a.nominal)}</span>
                    ) : (
                      <span class="text-rose-700">-{formatRupiah(a.nominal)}</span>
                    )}
                  </td>
                  <td class="py-3 px-3 text-right whitespace-nowrap font-mono font-semibold text-slate-900">
                    {formatRupiah(a.saldoBerjalan)}
                  </td>
                  <td class="py-3 px-3 text-center whitespace-nowrap">
                    {a.buktiNotaUrl ? (
                      <button
                        type="button"
                        class="btn-view-alokasi-proof inline-flex items-center gap-1 px-2 py-1 rounded text-[11px] font-medium bg-blue-50 text-[#0969da] border border-blue-200 hover:bg-blue-100 transition-colors cursor-pointer"
                        data-proof-url={a.buktiNotaUrl}
                        data-kode={a.kodeTransaksi}
                        title="Lihat Nota S3"
                      >
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                          <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                        <span>Nota</span>
                      </button>
                    ) : (
                      <span class="text-[11px] text-slate-300 italic">-</span>
                    )}
                  </td>
                  <td class="py-3 px-3 whitespace-nowrap text-xs text-slate-600">
                    {a.pic || '-'}
                  </td>
                  <td class="py-3 px-3 text-center whitespace-nowrap">
                    <div class="inline-flex items-center gap-1">
                      <button
                        type="button"
                        class="h-7 w-7 rounded bg-blue-50 border border-blue-200 text-[#0969da] hover:bg-[#0969da] hover:text-white transition-colors inline-flex items-center justify-center cursor-pointer shadow-2xs"
                        data-action="edit-alokasi"
                        data-id={a.id}
                        data-json={JSON.stringify({
                          id: a.id,
                          program: a.program,
                          posAnggaran: a.posAnggaran,
                          uraian: a.uraian,
                          jenisTransaksi: a.jenisTransaksi,
                          nominal: a.nominal,
                          buktiNotaUrl: a.buktiNotaUrl || '',
                          pic: a.pic || '',
                          tanggalTransaksi: a.tanggalTransaksi ? new Date(a.tanggalTransaksi).toISOString().split('T')[0] : '',
                        })}
                        title="Edit Catatan Kas"
                      >
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none">
                          <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                          <path d="m15 5 4 4"/>
                        </svg>
                      </button>
                      <button
                        type="button"
                        class="h-7 w-7 rounded bg-red-50 border border-red-200 text-red-600 hover:bg-red-600 hover:text-white transition-colors inline-flex items-center justify-center cursor-pointer shadow-2xs"
                        data-action="delete-alokasi"
                        data-id={a.id}
                        data-kode={a.kodeTransaksi}
                        title="Hapus Transaksi Kas"
                      >
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none">
                          <polyline points="3 6 5 6 21 6"></polyline>
                          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                      </button>
                    </div>
                  </td>
                </tr>
              );
            })
          )}
        </tbody>
      </table>
    </div>
    <div class="px-4 py-3 border-t border-slate-200 bg-slate-50/75 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-600">
      <!-- Per-page selection & count -->
      <div class="flex items-center gap-2.5">
        <span class="text-slate-500">Tampilkan</span>
        <select id="alokasiPerPage" class="h-8 rounded-md border border-slate-200 bg-white px-2 py-0.5 text-xs font-semibold text-slate-700 shadow-2xs focus:outline-none focus:ring-1 focus:ring-slate-950 cursor-pointer">
          <option value="10">10 data</option>
          <option value="25" selected>25 data</option>
          <option value="50">50 data</option>
          <option value="all">Semua</option>
        </select>
        <span class="text-slate-500">
          dari <strong id="alokasiTotalCount" class="font-semibold text-slate-800">{allocations.length}</strong> transaksi
          <span id="alokasiRangeText" class="text-slate-400 text-[11px] ml-1"></span>
        </span>
      </div>

      <!-- Pagination Controls -->
      <div class="flex items-center gap-1.5" id="alokasiPaginationControls">
        <button
          type="button"
          id="btnAlokasiPrevPage"
          class="h-8 px-2.5 rounded-md border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 hover:text-slate-900 disabled:opacity-40 disabled:cursor-not-allowed transition-colors shadow-2xs flex items-center gap-1 font-medium cursor-pointer"
          aria-label="Halaman Sebelumnya"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span class="hidden sm:inline">Sebelumnya</span>
        </button>

        <div id="alokasiPageNumbers" class="flex items-center gap-1">
          <!-- Injected by JS -->
        </div>

        <button
          type="button"
          id="btnAlokasiNextPage"
          class="h-8 px-2.5 rounded-md border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 hover:text-slate-900 disabled:opacity-40 disabled:cursor-not-allowed transition-colors shadow-2xs flex items-center gap-1 font-medium cursor-pointer"
          aria-label="Halaman Berikutnya"
        >
          <span class="hidden sm:inline">Berikutnya</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>
