---
// src/components/admin/donatur/DonationFormModal.astro
// Confirmation, Verification & Proof Preview Modals for Donations
---

<!-- Modal Pratinjau Bukti Transfer S3 -->
<div id="proofModal" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs hidden items-center justify-center p-4">
  <div class="bg-white rounded-lg border border-slate-200 max-w-lg w-full overflow-hidden shadow-xl flex flex-col">
    <div class="h-12 px-4 border-b border-slate-200 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-xs font-semibold text-slate-800">Bukti Transfer:</span>
        <span id="proofCodeBadge" class="font-mono text-xs font-bold text-[#0969da] bg-blue-50 px-2 py-0.5 rounded border border-blue-200"></span>
      </div>
      <button type="button" id="btnCloseProof" class="text-slate-400 hover:text-slate-700 p-1 rounded hover:bg-slate-100 cursor-pointer" aria-label="Tutup Pratinjau Bukti">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="p-3 bg-slate-900 flex items-center justify-center min-h-[300px] max-h-[60vh] overflow-y-auto">
      <img id="proofImageElement" src="" alt="Bukti Transfer" class="max-h-[55vh] max-w-full object-contain rounded" />
    </div>
    <div class="h-12 px-4 border-t border-slate-200 flex items-center justify-end bg-slate-50">
      <a id="proofExternalLink" href="" target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-[#0969da] hover:underline flex items-center gap-1.5">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
        <span>Buka di Tab Baru</span>
      </a>
    </div>
  </div>
</div>

<!-- Modal Konfirmasi Hapus Transaksi (Shadcn Style) -->
<div id="deleteConfirmModal" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs hidden items-center justify-center p-4">
  <div class="bg-white rounded-lg border border-slate-200 max-w-sm w-full p-5 shadow-xl flex flex-col space-y-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-full bg-red-100 text-red-600 flex items-center justify-center shrink-0">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 6h18"></path>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          <line x1="10" y1="11" x2="10" y2="17"></line>
          <line x1="14" y1="11" x2="14" y2="17"></line>
        </svg>
      </div>
      <div>
        <h3 class="text-sm font-bold text-slate-900 m-0">Hapus Catatan Donasi?</h3>
        <p class="text-xs text-slate-500 mt-0.5 mb-0">Tindakan ini tidak dapat dibatalkan.</p>
      </div>
    </div>
    <p class="text-xs text-slate-600 bg-slate-50 p-2.5 rounded border border-slate-200 m-0 leading-relaxed">
      Transaksi dengan kode <strong id="deleteTargetKodeDisplay" class="font-mono text-slate-900"></strong> akan dihapus permanen dari basis data.
    </p>
    <div class="flex items-center justify-end gap-2 pt-1">
      <button
        type="button"
        id="btnCancelDeleteModal"
        class="h-8 px-3 rounded-md border border-slate-200 bg-white text-xs font-medium text-slate-700 hover:bg-slate-50 transition-colors cursor-pointer"
      >
        Batal
      </button>
      <button
        type="button"
        id="btnExecuteDeleteModal"
        class="h-8 px-3 rounded-md bg-red-600 text-white text-xs font-semibold hover:bg-red-700 transition-colors cursor-pointer shadow-2xs"
      >
        Ya, Hapus Transaksi
      </button>
    </div>
  </div>
</div>

<!-- Modal Konfirmasi Ubah Status Verifikasi (Shadcn Style) -->
<div id="verifyConfirmModal" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs hidden items-center justify-center p-4">
  <div class="bg-white rounded-lg border border-slate-200 max-w-sm w-full p-5 shadow-xl flex flex-col space-y-4">
    <div class="flex items-center gap-3">
      <div id="verifyModalIconContainer" class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <div>
        <h3 id="verifyModalTitle" class="text-sm font-bold text-slate-900 m-0">Ubah Status Pembayaran?</h3>
        <p id="verifyModalSubtitle" class="text-xs text-slate-500 mt-0.5 mb-0">Sinkronisasi status verifikasi amil.</p>
      </div>
    </div>
    <p id="verifyModalDesc" class="text-xs text-slate-600 bg-slate-50 p-2.5 rounded border border-slate-200 m-0 leading-relaxed">
      Apakah Anda yakin ingin memverifikasi transaksi donasi ini?
    </p>
    <div class="flex items-center justify-end gap-2 pt-1">
      <button
        type="button"
        id="btnCancelVerifyModal"
        class="h-8 px-3 rounded-md border border-slate-200 bg-white text-xs font-medium text-slate-700 hover:bg-slate-50 transition-colors cursor-pointer"
      >
        Batal
      </button>
      <button
        type="button"
        id="btnExecuteVerifyModal"
        class="h-8 px-3 rounded-md bg-[#0969da] text-white text-xs font-semibold hover:bg-[#0752a8] transition-colors cursor-pointer shadow-2xs"
      >
        Ya, Konfirmasi
      </button>
    </div>
  </div>
</div>
