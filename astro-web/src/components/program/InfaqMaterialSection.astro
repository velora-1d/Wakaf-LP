---
// src/components/program/InfaqMaterialSection.astro
// Gotong Royong Material Fisik Pembangunan Kampus Jonggol
// 100% ISAVO Feature Section Style (Pola "Siapa Kami" - Foto Besar di Kiri + List Editorial 01-04 di Kanan)
// ZERO Card Grid, ZERO Kotak Kasir, Murni Tipografi Arsitektural Mewah
import type { ProgramData } from '../../data/programs';

interface Props {
  program: ProgramData;
}

const { program } = Astro.props;

// 4 Material Fisik Riil dengan foto lapangan & detail dampak langsung
const materials = [
  {
    id: 'semen',
    number: '01',
    name: 'Semen Konstruksi SNI',
    unit: 'sak',
    price: 65000,
    target: 2500,
    collected: 1840,
    image: '/gambar-bahan/pelataran mesjid.jpeg',
    captionTitle: 'Pengecoran Pelataran Masjid',
    captionDesc: '1 sak semen menyelesaikan ±0.5 m² lantai pelataran ibadah santri dan warga Jonggol.'
  },
  {
    id: 'pasir',
    number: '02',
    name: 'Pasir Cor & Pasang',
    unit: 'm³',
    price: 350000,
    target: 450,
    collected: 310,
    image: '/gambar-bahan/lahan donasi.jpg',
    captionTitle: 'Agregat Struktur Lahan Wakaf',
    captionDesc: '1 m³ pasir mencukupi adukan plester dan pasang dinding studio vokasi SMK.'
  },
  {
    id: 'roster',
    number: '03',
    name: 'Bata Roster Terakota Alami',
    unit: 'buah',
    price: 15000,
    target: 8000,
    collected: 5400,
    image: '/gambar design/interior masjid.jpg',
    captionTitle: 'Sirkulasi Udara Alami Ramah Energi',
    captionDesc: '10 roster menyusun 1 panel sirkulasi udara sejuk alami ruang ibadah tanpa AC.'
  },
  {
    id: 'sanitasi',
    number: '04',
    name: 'Kran Sanitasi & Eco-Drainase',
    unit: 'titik',
    price: 250000,
    target: 60,
    collected: 42,
    image: '/gambar-bahan/wc mesjid.jpeg',
    captionTitle: 'Instalasi Sanitasi & Eco-Wudhu',
    captionDesc: '1 titik kran wudhu melayani ratusan basuhan air suci jamaah setiap waktu salat.'
  }
];
---

<section class="isavo-feature-material-section" id="gotong-royong-material">
  <div class="isavo-container">
    <!-- Header Split 2-Kolom Baku ISAVO -->
    <div class="isavo-section-header">
      <div class="header-left-col">
        <div class="isavo-tag-pill">
          <span class="isavo-tag-dot"></span>
          <span class="isavo-tag-text">GOTONG ROYONG FISIK</span>
        </div>
      </div>
      <div class="header-right-col">
        <h2 class="isavo-main-title">
          Wujudkan Bangunan Fisik Lewat <span class="title-accent">Material Nyata</span>
        </h2>
        <p class="isavo-main-desc">
          Bukan sekadar angka di atas kertas. Setiap rupiah infaq Anda dikonversikan langsung menjadi sak semen, pasir cor, dan bata roster yang terpasang nyata di kawasan Sukasirna, Jonggol, Kabupaten Bogor.
        </p>
      </div>
    </div>

    <!-- Pola Asli ISAVO: Foto Arsitektur Besar di Kiri + List Editorial 01-04 di Kanan -->
    <div class="isavo-feature-grid">
      <!-- SISI KIRI: Foto Dokumentasi Lapangan Skala Penuh + Dark Card Caption di Sudut Bawah -->
      <div class="feature-photo-side">
        <div class="photo-container">
          <img
            id="displayFeatureImg"
            src={materials[0].image}
            alt={materials[0].name}
            class="feature-main-img"
            loading="lazy"
          />
          <div class="photo-gradient-overlay"></div>
          
          <!-- Floating Dark Card Caption (Gaya Autentik ISAVO pada Foto "Siapa Kami") -->
          <div class="photo-dark-caption">
            <span class="caption-kicker">REALISASI FISIK LAPANGAN</span>
            <h4 class="caption-title" id="displayCaptionTitle">{materials[0].captionTitle}</h4>
            <p class="caption-desc" id="displayCaptionDesc">{materials[0].captionDesc}</p>
          </div>
        </div>
      </div>

      <!-- SISI KANAN: List Tipografi Editorial Bernomor (01 - 04) & Alur Partisipasi Flat -->
      <div class="feature-content-side">
        <!-- List Tipografi Material (Tanpa Kotak/Cards) -->
        <div class="editorial-material-list">
          {materials.map((mat, idx) => {
            const percent = Math.round((mat.collected / mat.target) * 100);
            return (
              <div
                class={`editorial-item ${idx === 0 ? 'active' : ''}`}
                data-mat-id={mat.id}
                data-price={mat.price}
                data-name={mat.name}
                data-unit={mat.unit}
                data-img={mat.image}
                data-caption-title={mat.captionTitle}
                data-caption-desc={mat.captionDesc}
              >
                <div class="item-number-col">
                  <span class="mat-number">{mat.number}</span>
                </div>

                <div class="item-text-col">
                  <h3 class="mat-name-title">{mat.name}</h3>
                  <div class="mat-meta-row">
                    <span class="mat-rate">Rp {mat.price.toLocaleString('id-ID')} / {mat.unit}</span>
                    <span class="meta-dot">•</span>
                    <span class="mat-progress-note">Terkumpul {mat.collected.toLocaleString('id-ID')} {mat.unit} ({percent}%)</span>
                  </div>
                </div>

                <div class="item-arrow-col">
                  <div class="circle-arrow-btn" title="Pilih Material Ini">
                    <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <line x1="7" y1="17" x2="17" y2="7"></line>
                      <polyline points="7 7 17 7 17 17"></polyline>
                    </svg>
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        <!-- Alur Partisipasi Fleksibel Menyatu (Flat Flow, Bebas Kontainer Kasir) -->
        <div class="participation-flow-inline">
          <div class="calc-label-row">
            <span class="flow-kicker">TENTUKAN JUMLAH DUKUNGAN</span>
            <div class="counter-display-pill">
              <span id="displayCounterNum" class="counter-val">5</span>
              <span id="displayCounterUnit" class="counter-unit">sak</span>
            </div>
          </div>

          <!-- Slider Interaktif Mulus -->
          <div class="slider-track-wrap">
            <input
              type="range"
              id="inputMaterialSlider"
              class="isavo-range-slider"
              min="1"
              max="50"
              step="1"
              value="5"
              aria-label="Slider jumlah partisipasi"
            />
            <div class="slider-scale-row">
              <span>1</span>
              <span>10</span>
              <span>25</span>
              <span>50</span>
            </div>
          </div>

          <!-- Chip Presets Kapsul Bulat Penuh (Bukan Kotak Kasir) -->
          <div class="pill-presets-cluster">
            <button type="button" class="preset-pill" data-qty="1">1</button>
            <button type="button" class="preset-pill active" data-qty="5">5</button>
            <button type="button" class="preset-pill" data-qty="10">10</button>
            <button type="button" class="preset-pill" data-qty="25">25</button>
            <button type="button" class="preset-pill" data-qty="50">50</button>
          </div>

          <!-- Total Nilai & Tombol Salur Bersih -->
          <div class="flow-footer-row">
            <div class="total-nominal-block">
              <span class="total-caption">Total Nilai Infaq:</span>
              <div class="total-price-large" id="displayTotalInfaq">Rp 325.000</div>
            </div>

            <a
              href="https://wa.me/6281226832326?text=Assalamualaikum%20Admin%20GVF%2C%20saya%20ingin%20berinfaq%205%20sak%20Semen%20sebesar%20Rp%20325.000%20untuk%20pembangunan%20Jonggol."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-salur-pill"
              id="btnInfaqWA"
            >
              <span>Salurkan Sekarang</span>
              <div class="btn-arrow-circle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </div>
            </a>
          </div>

          <!-- Rekening Transfer Minimalis Inline -->
          <div class="rekening-inline-strip">
            <div class="rek-bank-badge">BSI (451)</div>
            <div class="rek-number-text">7238890023</div>
            <span class="rek-owner-text">a.n. Yayasan Global Village Fund - Infaq</span>
            <button
              type="button"
              class="rek-copy-pill"
              id="btnCopyInfaq"
              data-clipboard="7238890023"
              title="Salin No Rekening"
            >
              <span id="labelCopyInfaq">Salin</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* =========================================================================
     100% ISAVO FEATURE SECTION ("SIAPA KAMI") ARCHITECTURAL STYLING
     ZERO Card Grid, ZERO Boks Kasir, Flat Editorial Tipografi
     ========================================================================= */
  .isavo-feature-material-section {
    background-color: #f7f7f8;
    padding: 110px 0 130px 0;
    color: #191919;
  }

  .isavo-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* HEADER SPLIT ISAVO */
  .isavo-section-header {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 3.5rem;
    align-items: flex-start;
    margin-bottom: 4.5rem;
  }

  @media (max-width: 991px) {
    .isavo-section-header {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-bottom: 2.5rem;
    }
  }

  .isavo-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.1);
    padding: 0.4rem 1rem;
    border-radius: 9999px;
  }

  .isavo-tag-dot {
    width: 6px;
    height: 6px;
    background-color: #0969da;
    border-radius: 50%;
  }

  .isavo-tag-text {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #0f172a;
    text-transform: uppercase;
    font-family: 'Golos Text', sans-serif;
  }

  .isavo-main-title {
    font-size: clamp(2.2rem, 3.8vw, 3.3rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #0f172a;
    margin: 0 0 1.25rem 0;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  .title-accent {
    color: #0969da;
  }

  .isavo-main-desc {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #475569;
    margin: 0;
    max-width: 820px;
  }

  /* 2-COLUMN FEATURE LAYOUT (KIRI FOTO BESAR, KANAN LIST EDITORIAL) */
  .isavo-feature-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 4rem;
    align-items: start;
  }

  @media (max-width: 1024px) {
    .isavo-feature-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  /* SISI KIRI: FOTO BESAR LAPANGAN + DARK CAPTION */
  .feature-photo-side {
    position: sticky;
    top: 90px;
  }

  .photo-container {
    position: relative;
    width: 100%;
    height: 560px;
    border-radius: 24px;
    overflow: hidden;
    background-color: #e2e8f0;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.06);
  }

  @media (max-width: 768px) {
    .photo-container {
      height: 380px;
    }
  }

  .feature-main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.35s ease;
  }

  .photo-gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.02) 40%, rgba(15, 23, 42, 0.75) 100%);
    pointer-events: none;
  }

  .photo-dark-caption {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: 24px;
    background: rgba(15, 23, 42, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    padding: 1.5rem 1.75rem;
    color: #ffffff;
    transition: all 0.3s ease;
  }

  .caption-kicker {
    font-size: 0.72rem;
    font-weight: 800;
    color: #38bdf8;
    letter-spacing: 0.08em;
    font-family: 'Golos Text', sans-serif;
    display: block;
    margin-bottom: 0.35rem;
  }

  .caption-title {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0 0 0.35rem 0;
    color: #ffffff;
    font-family: 'Golos Text', sans-serif;
  }

  .caption-desc {
    font-size: 0.85rem;
    line-height: 1.55;
    color: #cbd5e1;
    margin: 0;
  }

  /* SISI KANAN: LIST EDITORIAL ARSITEKTURAL (01 - 04) */
  .feature-content-side {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .editorial-material-list {
    display: flex;
    flex-direction: column;
  }

  .editorial-item {
    display: grid;
    grid-template-columns: 50px 1fr 48px;
    gap: 1.25rem;
    align-items: center;
    padding: 1.75rem 0.5rem;
    border-bottom: 1px solid #e2e8f0;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .editorial-item:first-child {
    border-top: 1px solid #e2e8f0;
  }

  .editorial-item:hover {
    padding-left: 0.75rem;
  }

  .item-number-col {
    display: flex;
    align-items: center;
  }

  .mat-number {
    font-size: 1.35rem;
    font-weight: 800;
    color: #94a3b8;
    font-family: 'Golos Text', sans-serif;
    transition: color 0.2s ease;
  }

  .editorial-item.active .mat-number {
    color: #0969da;
  }

  .item-text-col {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .mat-name-title {
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    line-height: 1.25;
    letter-spacing: -0.02em;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
    transition: color 0.2s ease;
  }

  .editorial-item.active .mat-name-title {
    color: #0969da;
  }

  .mat-meta-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.88rem;
    color: #64748b;
  }

  .mat-rate {
    font-weight: 700;
    color: #0969da;
  }

  .meta-dot {
    color: #cbd5e1;
  }

  .mat-progress-note {
    color: #64748b;
  }

  .item-arrow-col {
    display: flex;
    justify-content: flex-end;
  }

  .circle-arrow-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease;
  }

  .circle-arrow-btn .arrow-icon {
    width: 18px;
    height: 18px;
    transition: transform 0.25s ease;
  }

  .editorial-item:hover .circle-arrow-btn {
    border-color: #0969da;
    color: #0969da;
    transform: rotate(45deg);
  }

  .editorial-item.active .circle-arrow-btn {
    background: #0969da;
    border-color: #0969da;
    color: #ffffff;
    transform: rotate(45deg);
  }

  /* ALUR PARTISIPASI INLINE (FLAT FLOW, TANPA BOKS KARTU) */
  .participation-flow-inline {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: 1rem;
  }

  .calc-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .flow-kicker {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #64748b;
    text-transform: uppercase;
    font-family: 'Golos Text', sans-serif;
  }

  .counter-display-pill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 0.35rem 0.95rem;
    border-radius: 9999px;
  }

  .counter-val {
    font-size: 1.25rem;
    font-weight: 800;
    color: #0969da;
    font-family: 'Golos Text', sans-serif;
    line-height: 1;
  }

  .counter-unit {
    font-size: 0.8rem;
    font-weight: 700;
    color: #64748b;
  }

  /* SLIDER TRACK */
  .slider-track-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .isavo-range-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    border-radius: 9999px;
    background: #cbd5e1;
    outline: none;
    cursor: pointer;
  }

  .isavo-range-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #0969da;
    border: 3px solid #ffffff;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(9, 105, 218, 0.3);
    transition: transform 0.15s ease;
  }

  .isavo-range-slider::-webkit-slider-thumb:hover {
    transform: scale(1.15);
  }

  .slider-scale-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: #94a3b8;
    font-family: ui-monospace, monospace;
    font-weight: 600;
    padding: 0 2px;
  }

  /* CHIP PRESETS (Pill Kapsul) */
  .pill-presets-cluster {
    display: flex;
    gap: 0.5rem;
  }

  .preset-pill {
    flex: 1;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 9999px;
    padding: 0.5rem 0;
    font-size: 0.85rem;
    font-weight: 700;
    color: #475569;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: center;
  }

  .preset-pill:hover {
    border-color: #0969da;
    color: #0969da;
  }

  .preset-pill.active {
    background: #0969da;
    border-color: #0969da;
    color: #ffffff;
  }

  /* TOTAL & TOMBOL SALUR */
  .flow-footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-top: 0.75rem;
  }

  @media (max-width: 640px) {
    .flow-footer-row {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }
  }

  .total-nominal-block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .total-caption {
    font-size: 0.78rem;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .total-price-large {
    font-size: 2.25rem;
    font-weight: 900;
    color: #0969da;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  .btn-salur-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: #0969da;
    color: #ffffff;
    font-size: 0.98rem;
    font-weight: 700;
    padding: 0.9rem 1.6rem;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.25s ease;
    font-family: 'Golos Text', sans-serif;
    white-space: nowrap;
  }

  .btn-salur-pill:hover {
    background: #0756b2;
    transform: translateY(-2px);
    color: #ffffff;
  }

  .btn-arrow-circle {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .btn-arrow-circle svg {
    width: 14px;
    height: 14px;
  }

  /* REKENING INLINE STRIP */
  .rekening-inline-strip {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.25rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 9999px;
    font-size: 0.82rem;
  }

  @media (max-width: 640px) {
    .rekening-inline-strip {
      flex-wrap: wrap;
      border-radius: 16px;
    }
  }

  .rek-bank-badge {
    background: #0f172a;
    color: #ffffff;
    font-weight: 800;
    font-size: 0.7rem;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    letter-spacing: 0.05em;
  }

  .rek-number-text {
    font-weight: 800;
    font-size: 1rem;
    color: #0f172a;
    font-family: ui-monospace, monospace;
    letter-spacing: 0.04em;
  }

  .rek-owner-text {
    color: #64748b;
    font-size: 0.78rem;
    flex: 1;
  }

  .rek-copy-pill {
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.72rem;
    font-weight: 700;
    color: #1e293b;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .rek-copy-pill:hover {
    border-color: #0969da;
    color: #0969da;
  }
</style>

<script is:inline define:vars={{ materials }}>
  (function() {
    let activeMat = materials[0];
    let qty = 5;

    const displayFeatureImg = document.getElementById('displayFeatureImg');
    const displayCaptionTitle = document.getElementById('displayCaptionTitle');
    const displayCaptionDesc = document.getElementById('displayCaptionDesc');
    const inputSlider = document.getElementById('inputMaterialSlider');
    const displayCounterNum = document.getElementById('displayCounterNum');
    const displayCounterUnit = document.getElementById('displayCounterUnit');
    const displayTotalInfaq = document.getElementById('displayTotalInfaq');
    const btnInfaqWA = document.getElementById('btnInfaqWA');

    function formatRupiah(num) {
      return new Intl.NumberFormat('id-ID').format(Math.max(0, Math.round(num)));
    }

    function updateView() {
      // Update image & caption
      if (displayFeatureImg && activeMat.image) {
        displayFeatureImg.src = activeMat.image;
        displayFeatureImg.alt = activeMat.name;
      }
      if (displayCaptionTitle) displayCaptionTitle.textContent = activeMat.captionTitle;
      if (displayCaptionDesc) displayCaptionDesc.textContent = activeMat.captionDesc;

      // Update counters & totals
      if (inputSlider) inputSlider.value = qty;
      if (displayCounterNum) displayCounterNum.textContent = qty;
      if (displayCounterUnit) displayCounterUnit.textContent = activeMat.unit;

      const total = activeMat.price * qty;
      if (displayTotalInfaq) displayTotalInfaq.textContent = `Rp ${formatRupiah(total)}`;

      if (btnInfaqWA) {
        const msg = encodeURIComponent(`Assalamualaikum Admin GVF, saya ingin berinfaq ${qty} ${activeMat.unit} ${activeMat.name} sebesar Rp ${formatRupiah(total)} untuk pembangunan Jonggol.`);
        btnInfaqWA.href = `https://wa.me/6281226832326?text=${msg}`;
      }

      // Update active editorial item
      document.querySelectorAll('.editorial-item').forEach(item => {
        const isCurrent = item.getAttribute('data-mat-id') === activeMat.id;
        if (isCurrent) {
          item.classList.add('active');
        } else {
          item.classList.remove('active');
        }
      });

      // Update active preset pill
      document.querySelectorAll('.preset-pill').forEach(btn => {
        if (parseInt(btn.getAttribute('data-qty'), 10) === qty) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    }

    // Click on editorial row
    document.querySelectorAll('.editorial-item').forEach(item => {
      item.addEventListener('click', function() {
        const id = this.getAttribute('data-mat-id');
        const found = materials.find(m => m.id === id);
        if (found) {
          activeMat = found;
          updateView();
        }
      });
    });

    // Slider change
    if (inputSlider) {
      inputSlider.addEventListener('input', function() {
        qty = parseInt(this.value, 10) || 1;
        updateView();
      });
    }

    // Preset Pill Buttons
    document.querySelectorAll('.preset-pill').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        const val = parseInt(this.getAttribute('data-qty'), 10);
        if (!isNaN(val) && val > 0) {
          qty = val;
          updateView();
        }
      });
    });

    // Copy No Rekening
    const btnCopyInfaq = document.getElementById('btnCopyInfaq');
    const labelCopyInfaq = document.getElementById('labelCopyInfaq');
    if (btnCopyInfaq && labelCopyInfaq) {
      btnCopyInfaq.addEventListener('click', function() {
        const rek = this.getAttribute('data-clipboard');
        if (navigator.clipboard) {
          navigator.clipboard.writeText(rek).then(() => {
            labelCopyInfaq.textContent = 'Tersalin!';
            setTimeout(() => {
              labelCopyInfaq.textContent = 'Salin';
            }, 2500);
          });
        }
      });
    }

    // Init
    updateView();
  })();
</script>
