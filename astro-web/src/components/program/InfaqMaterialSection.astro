---
// src/components/program/InfaqMaterialSection.astro
// Gotong Royong Material Fisik Pembangunan Kampus Jonggol
// 100% Modern & Aesthetic — ISAVO Architectural Style (Zero Slop, Zero Table Lines, Zero Cashier Boxes)
import type { ProgramData } from '../../data/programs';

interface Props {
  program: ProgramData;
}

const { program } = Astro.props;

// Daftar Material Fisik Konstruksi Riil di Sukasirna Jonggol
const materials = [
  {
    id: 'semen',
    name: 'Semen Konstruksi SNI',
    unit: 'sak',
    price: 65000,
    target: 2500,
    collected: 1840,
    desc: 'Pengecoran pilar, dak lantai pelataran ibadah, dan workshop santri vokasi.',
    impactText: '1 sak semen menyelesaikan ±0.5 m² lantai pelataran ibadah.'
  },
  {
    id: 'pasir',
    name: 'Pasir Cor & Pasang',
    unit: 'm³',
    price: 350000,
    target: 450,
    collected: 310,
    desc: 'Agregat halus standar mutu beton tinggi untuk struktur bangunan kokoh.',
    impactText: '1 m³ pasir mencukupi adukan plester dan pasang dinding studio.'
  },
  {
    id: 'roster',
    name: 'Bata Roster Terakota Alami',
    unit: 'buah',
    price: 15000,
    target: 8000,
    collected: 5400,
    desc: 'Sirkulasi udara alami ramah energi agar ruangan belajar sejuk alami tanpa AC.',
    impactText: '10 roster menyusun 1 panel sirkulasi udara alami ruang ibadah.'
  },
  {
    id: 'sanitasi',
    name: 'Kran Sanitasi & Eco-Drainase Wudhu',
    unit: 'titik',
    price: 250000,
    target: 60,
    collected: 42,
    desc: 'Instalasi kran hemat air dengan saluran daur ulang air wudhu untuk kebun pesantren.',
    impactText: '1 titik wudhu melayani ratusan basuhan air suci jamaah setiap waktu salat.'
  }
];
---

<section class="infaq-material-section" id="gotong-royong-material">
  <div class="infaq-container">
    <!-- Header Section Split 2-Kolom (Gaya Baku ISAVO) -->
    <div class="isavo-section-header reveal-on-scroll">
      <div class="header-left-col">
        <div class="isavo-tag-pill">
          <span class="isavo-tag-dot"></span>
          <span class="isavo-tag-text">GOTONG ROYONG FISIK</span>
        </div>
      </div>
      <div class="header-right-col">
        <h2 class="isavo-main-title">
          Wujudkan Bangunan Fisik Lewat <span class="title-accent">Material Nyata</span>
        </h2>
        <p class="isavo-main-desc">
          Bukan sekadar angka di atas kertas. Setiap rupiah infaq Anda dikonversikan langsung menjadi sak semen, pasir cor, dan bata roster yang terpasang nyata di kawasan Sukasirna, Jonggol, Kabupaten Bogor.
        </p>
      </div>
    </div>

    <!-- Main 2-Column Architectural Layout -->
    <div class="material-architectural-layout">
      <!-- Kolom Kiri: 4 Kartu Material Arsitektural Mewah -->
      <div class="material-cards-col">
        <div class="col-kicker-wrap">
          <h3 class="col-title">Pilih Komponen Material</h3>
          <span class="col-hint">Klik kartu untuk menentukan partisipasi Anda</span>
        </div>

        <div class="material-cards-grid">
          {materials.map((mat, idx) => {
            const percent = Math.round((mat.collected / mat.target) * 100);
            return (
              <div
                class={`mat-card-item ${idx === 0 ? 'active' : ''}`}
                data-mat-id={mat.id}
                data-price={mat.price}
                data-name={mat.name}
                data-unit={mat.unit}
              >
                <div class="mat-card-top">
                  <span class="mat-badge-cat">MATERIAL 0{idx + 1}</span>
                  <div class="mat-price-pill">
                    Rp {mat.price.toLocaleString('id-ID')}
                    <span class="unit-sub">/{mat.unit}</span>
                  </div>
                </div>

                <h4 class="mat-card-title">{mat.name}</h4>
                <p class="mat-card-desc">{mat.desc}</p>

                <div class="mat-card-bottom">
                  <div class="mat-collected-stat">
                    <span>Terkumpul <strong>{mat.collected.toLocaleString('id-ID')}</strong> dari {mat.target.toLocaleString('id-ID')} {mat.unit}</span>
                    <span class="stat-pct">{percent}%</span>
                  </div>
                  <div class="mat-select-action">
                    <span class="select-chip-text">{idx === 0 ? 'Sedang Dipilih' : 'Pilih Material'}</span>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Kolom Kanan: Panel Partisipasi Modern & Elegan -->
      <div class="calc-panel-col">
        <div class="calc-card-modern">
          <div class="panel-header">
            <span class="panel-kicker">KOMITMEN DUKUNGAN</span>
            <h3 class="panel-title" id="displayMatName">Semen Konstruksi SNI</h3>
            <div class="panel-price-rate" id="displayMatRate">Rp 65.000 / sak</div>
          </div>

          <!-- Slider Interaktif Mulus & Presets -->
          <div class="qty-controller-wrap">
            <div class="qty-header-row">
              <label for="inputSlider" class="qty-label">Tentukan Jumlah:</label>
              <div class="qty-counter-display">
                <span class="counter-num" id="displayCounterNum">5</span>
                <span class="counter-unit" id="displayUnitSuffix">sak</span>
              </div>
            </div>

            <!-- Modern Architectural Range Slider -->
            <div class="range-slider-container">
              <input
                type="range"
                id="inputSlider"
                class="modern-slider"
                min="1"
                max="50"
                step="1"
                value="5"
                aria-label="Slider jumlah partisipasi material"
              />
              <div class="slider-scale-points">
                <span>1</span>
                <span>10</span>
                <span>25</span>
                <span>50</span>
              </div>
            </div>

            <!-- Pill Presets (Rounded Full, No Rigid Square Boxes) -->
            <div class="pill-presets-row">
              <button type="button" class="preset-pill-btn" data-qty="1">1</button>
              <button type="button" class="preset-pill-btn active" data-qty="5">5</button>
              <button type="button" class="preset-pill-btn" data-qty="10">10</button>
              <button type="button" class="preset-pill-btn" data-qty="25">25</button>
              <button type="button" class="preset-pill-btn" data-qty="50">50</button>
            </div>
          </div>

          <!-- Total Nilai Infaq: Prominent Typography -->
          <div class="total-display-card">
            <span class="total-label">Total Nilai Infaq Material:</span>
            <div class="total-amount-huge" id="displayTotalInfaq">Rp 325.000</div>
            <p class="impact-narrative" id="displayImpactDesc">
              Setara <strong>5 sak semen</strong> untuk percepatan pengecoran pelataran ibadah di Sukasirna Jonggol.
            </p>
          </div>

          <!-- Direct Pill Action Button -->
          <div class="panel-actions">
            <a
              href="https://wa.me/6281226832326?text=Assalamualaikum%20Admin%20GVF%2C%20saya%20ingin%20berinfaq%205%20sak%20Semen%20sebesar%20Rp%20325.000%20untuk%20pembangunan%20Jonggol."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-infaq-pill"
              id="btnInfaqWA"
            >
              <span>Salurkan Infaq Sekarang</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>

            <!-- Rekening Info Bersih & Elegan -->
            <div class="rekening-clean-card">
              <div class="rek-top">
                <span class="rek-bank-name">BSI KHUSUS INFAQ</span>
                <button
                  type="button"
                  class="rek-copy-pill"
                  id="btnCopyInfaq"
                  data-clipboard="7238890023"
                  title="Salin No Rekening"
                >
                  <span id="labelCopyInfaq">Salin</span>
                </button>
              </div>
              <div class="rek-number">7238890023</div>
              <div class="rek-owner">a.n. Yayasan Global Village Fund - Infaq</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Dokumentasi Lapangan Riil (2 Large Architectural Cards) -->
    <div class="field-showcase-row">
      <div class="field-card">
        <div class="field-img-wrap">
          <img
            src="/gambar-bahan/pelataran mesjid.jpeg"
            alt="Pelataran Masjid Khairu Ummah Sugro Jonggol"
            class="field-img"
            loading="lazy"
          />
        </div>
        <div class="field-info">
          <span class="field-tag">REALISASI FISIK</span>
          <h4 class="field-title">Pelataran Masjid Khairu Ummah</h4>
          <p class="field-desc">Realisasi pengecoran lantai dan halaman terbuka yang menampung santri vokasi dan jamaah masyarakat Jonggol.</p>
        </div>
      </div>

      <div class="field-card">
        <div class="field-img-wrap">
          <img
            src="/gambar-bahan/wc mesjid.jpeg"
            alt="Fasilitas Sanitasi dan Wudhu Masjid Jonggol"
            class="field-img"
            loading="lazy"
          />
        </div>
        <div class="field-info">
          <span class="field-tag">FASILITAS WUDHU</span>
          <h4 class="field-title">Sanitasi & Eco-Drainase</h4>
          <p class="field-desc">Pembangunan titik wudhu modern dengan sirkulasi udara alami dan saluran daur ulang air ramah lingkungan.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* 100% MODERN & AESTHETIC ISAVO ARCHITECTURAL SPECIFICATION */
  .infaq-material-section {
    background-color: #f8fafc;
    padding: 100px 0 120px 0;
  }

  .infaq-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* HEADER SPLIT ISAVO */
  .isavo-section-header {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 3.5rem;
    align-items: flex-start;
    margin-bottom: 4rem;
  }

  @media (max-width: 991px) {
    .isavo-section-header {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-bottom: 2.5rem;
    }
  }

  .isavo-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.1);
    padding: 0.35rem 0.95rem;
    border-radius: 9999px;
  }

  .isavo-tag-dot {
    width: 6px;
    height: 6px;
    background-color: #0969da;
    border-radius: 50%;
  }

  .isavo-tag-text {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #0f172a;
    text-transform: uppercase;
    font-family: 'Golos Text', sans-serif;
  }

  .isavo-main-title {
    font-size: clamp(2.2rem, 3.8vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #0f172a;
    margin: 0 0 1.25rem 0;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  .title-accent {
    color: #0969da;
  }

  .isavo-main-desc {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #475569;
    margin: 0;
    max-width: 820px;
  }

  /* 2-COLUMN ARCHITECTURAL LAYOUT */
  .material-architectural-layout {
    display: grid;
    grid-template-columns: 1.3fr 0.9fr;
    gap: 3rem;
    align-items: start;
    margin-bottom: 5rem;
  }

  @media (max-width: 1024px) {
    .material-architectural-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  /* COLUMN KICKER */
  .col-kicker-wrap {
    margin-bottom: 1.75rem;
  }

  .col-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 0.35rem 0;
    letter-spacing: -0.02em;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  .col-hint {
    font-size: 0.875rem;
    color: #64748b;
  }

  /* 4 MATERIAL CARDS (Aesthetic Cards, Zero Divider Lines) */
  .material-cards-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  @media (max-width: 640px) {
    .material-cards-grid {
      grid-template-columns: 1fr;
    }
  }

  .mat-card-item {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    padding: 1.75rem;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 240px;
  }

  .mat-card-item:hover {
    border-color: #0969da;
    transform: translateY(-3px);
  }

  .mat-card-item.active {
    background: #f0f7ff;
    border: 2px solid #0969da;
  }

  .mat-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
    gap: 0.75rem;
  }

  .mat-badge-cat {
    font-size: 0.72rem;
    font-weight: 800;
    color: #64748b;
    letter-spacing: 0.08em;
    font-family: ui-monospace, monospace;
  }

  .mat-card-item.active .mat-badge-cat {
    color: #0969da;
  }

  .mat-price-pill {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.92rem;
    font-weight: 800;
    color: #0969da;
    white-space: nowrap;
  }

  .mat-card-item.active .mat-price-pill {
    background: #ffffff;
    border-color: #bae6fd;
  }

  .unit-sub {
    font-size: 0.75rem;
    font-weight: 600;
    color: #64748b;
  }

  .mat-card-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.35;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.01em;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  .mat-card-desc {
    font-size: 0.85rem;
    line-height: 1.6;
    color: #475569;
    margin: 0 0 1.25rem 0;
    flex-grow: 1;
  }

  .mat-card-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding-top: 1rem;
    border-top: 1px dashed rgba(226, 232, 240, 0.8);
  }

  .mat-collected-stat {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.78rem;
    color: #64748b;
  }

  .mat-collected-stat strong {
    color: #0f172a;
  }

  .stat-pct {
    font-weight: 800;
    color: #0969da;
  }

  .mat-select-action {
    display: flex;
    justify-content: flex-end;
  }

  .select-chip-text {
    font-size: 0.78rem;
    font-weight: 700;
    color: #64748b;
    padding: 0.3rem 0.85rem;
    border-radius: 9999px;
    background: #f1f5f9;
    transition: all 0.2s ease;
  }

  .mat-card-item.active .select-chip-text {
    background: #0969da;
    color: #ffffff;
  }

  /* KOLOM KANAN: PANEL PARTISIPASI MODERN */
  .calc-card-modern {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    padding: 2.5rem;
    position: sticky;
    top: 90px;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .panel-header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .panel-kicker {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #0969da;
    text-transform: uppercase;
    font-family: 'Golos Text', sans-serif;
  }

  .panel-title {
    font-size: 1.45rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    letter-spacing: -0.02em;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  .panel-price-rate {
    font-size: 1.05rem;
    font-weight: 700;
    color: #0969da;
  }

  /* SLIDER & PRESETS (NO RIGID SQUARES) */
  .qty-controller-wrap {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    background: #f8fafc;
    padding: 1.5rem;
    border-radius: 20px;
  }

  .qty-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .qty-label {
    font-size: 0.88rem;
    font-weight: 700;
    color: #1e293b;
    font-family: 'Golos Text', sans-serif;
  }

  .qty-counter-display {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 0.4rem 0.95rem;
    border-radius: 9999px;
  }

  .counter-num {
    font-size: 1.35rem;
    font-weight: 800;
    color: #0969da;
    font-family: 'Golos Text', sans-serif;
    line-height: 1;
  }

  .counter-unit {
    font-size: 0.82rem;
    font-weight: 700;
    color: #64748b;
  }

  /* ARCHITECTURAL SLIDER */
  .range-slider-container {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .modern-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    border-radius: 9999px;
    background: #cbd5e1;
    outline: none;
    cursor: pointer;
    transition: background 0.2s;
  }

  .modern-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #0969da;
    border: 3px solid #ffffff;
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  .modern-slider::-webkit-slider-thumb:hover {
    transform: scale(1.15);
  }

  .slider-scale-points {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: #94a3b8;
    font-family: ui-monospace, monospace;
    font-weight: 600;
    padding: 0 4px;
  }

  /* PILL PRESETS (NOT SQUARES) */
  .pill-presets-row {
    display: flex;
    gap: 0.5rem;
    justify-content: space-between;
  }

  .preset-pill-btn {
    flex: 1;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 9999px;
    padding: 0.5rem 0;
    font-size: 0.85rem;
    font-weight: 700;
    color: #475569;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: center;
  }

  .preset-pill-btn:hover {
    border-color: #0969da;
    color: #0969da;
  }

  .preset-pill-btn.active {
    background: #0969da;
    border-color: #0969da;
    color: #ffffff;
  }

  /* TOTAL DISPLAY CARD */
  .total-display-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .total-label {
    font-size: 0.82rem;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .total-amount-huge {
    font-size: 2.25rem;
    font-weight: 900;
    color: #0969da;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  .impact-narrative {
    font-size: 0.88rem;
    line-height: 1.55;
    color: #475569;
    margin: 0;
  }

  .impact-narrative strong {
    color: #0f172a;
  }

  /* PANEL ACTIONS */
  .panel-actions {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .btn-infaq-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: #0969da;
    color: #ffffff;
    font-size: 1rem;
    font-weight: 700;
    padding: 1.05rem 2rem;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.25s ease;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  .btn-infaq-pill:hover {
    background: #0756b2;
    transform: translateY(-2px);
    color: #ffffff;
  }

  /* REKENING CLEAN CARD */
  .rekening-clean-card {
    background: #f8fafc;
    border-radius: 20px;
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .rek-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .rek-bank-name {
    font-size: 0.75rem;
    font-weight: 800;
    color: #0969da;
    letter-spacing: 0.08em;
    font-family: 'Golos Text', sans-serif;
  }

  .rek-copy-pill {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    color: #1e293b;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .rek-copy-pill:hover {
    border-color: #0969da;
    color: #0969da;
  }

  .rek-number {
    font-size: 1.15rem;
    font-weight: 800;
    color: #0f172a;
    font-family: ui-monospace, monospace;
    letter-spacing: 0.04em;
  }

  .rek-owner {
    font-size: 0.78rem;
    color: #64748b;
  }

  /* FIELD SHOWCASE ROW */
  .field-showcase-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  @media (max-width: 768px) {
    .field-showcase-row {
      grid-template-columns: 1fr;
    }
  }

  .field-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .field-img-wrap {
    width: 100%;
    height: 280px;
    overflow: hidden;
  }

  .field-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .field-card:hover .field-img {
    transform: scale(1.05);
  }

  .field-info {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field-tag {
    font-size: 0.72rem;
    font-weight: 800;
    color: #0969da;
    letter-spacing: 0.08em;
    font-family: 'Golos Text', sans-serif;
  }

  .field-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  .field-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: #475569;
    margin: 0;
  }
</style>

<script is:inline define:vars={{ materials }}>
  (function() {
    let activeMat = materials[0];
    let qty = 5;

    const displayMatName = document.getElementById('displayMatName');
    const displayMatRate = document.getElementById('displayMatRate');
    const inputSlider = document.getElementById('inputSlider');
    const displayCounterNum = document.getElementById('displayCounterNum');
    const displayUnitSuffix = document.getElementById('displayUnitSuffix');
    const displayTotalInfaq = document.getElementById('displayTotalInfaq');
    const displayImpactDesc = document.getElementById('displayImpactDesc');
    const btnInfaqWA = document.getElementById('btnInfaqWA');

    function formatRupiah(num) {
      return new Intl.NumberFormat('id-ID').format(Math.max(0, Math.round(num)));
    }

    function updateView() {
      if (displayMatName) displayMatName.textContent = activeMat.name;
      if (displayMatRate) displayMatRate.textContent = `Rp ${formatRupiah(activeMat.price)} / ${activeMat.unit}`;
      if (inputSlider) inputSlider.value = qty;
      if (displayCounterNum) displayCounterNum.textContent = qty;
      if (displayUnitSuffix) displayUnitSuffix.textContent = activeMat.unit;

      const total = activeMat.price * qty;
      if (displayTotalInfaq) displayTotalInfaq.textContent = `Rp ${formatRupiah(total)}`;

      if (displayImpactDesc) {
        displayImpactDesc.innerHTML = `Setara <strong>${qty} ${activeMat.unit} ${activeMat.name}</strong> untuk percepatan pembangunan di Sukasirna Jonggol.`;
      }

      if (btnInfaqWA) {
        const msg = encodeURIComponent(`Assalamualaikum Admin GVF, saya ingin berinfaq ${qty} ${activeMat.unit} ${activeMat.name} sebesar Rp ${formatRupiah(total)} untuk pembangunan Jonggol.`);
        btnInfaqWA.href = `https://wa.me/6281226832326?text=${msg}`;
      }

      // Update active highlight on material cards
      document.querySelectorAll('.mat-card-item').forEach(card => {
        const isCurrent = card.getAttribute('data-mat-id') === activeMat.id;
        if (isCurrent) {
          card.classList.add('active');
          const chip = card.querySelector('.select-chip-text');
          if (chip) chip.textContent = 'Sedang Dipilih';
        } else {
          card.classList.remove('active');
          const chip = card.querySelector('.select-chip-text');
          if (chip) chip.textContent = 'Pilih Material';
        }
      });

      // Update active preset pill
      document.querySelectorAll('.preset-pill-btn').forEach(btn => {
        if (parseInt(btn.getAttribute('data-qty'), 10) === qty) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    }

    // Material card click selection
    document.querySelectorAll('.mat-card-item').forEach(card => {
      card.addEventListener('click', function() {
        const id = this.getAttribute('data-mat-id');
        const found = materials.find(m => m.id === id);
        if (found) {
          activeMat = found;
          updateView();
        }
      });
    });

    // Slider change
    if (inputSlider) {
      inputSlider.addEventListener('input', function() {
        qty = parseInt(this.value, 10) || 1;
        updateView();
      });
    }

    // Preset Pill Buttons
    document.querySelectorAll('.preset-pill-btn').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        const val = parseInt(this.getAttribute('data-qty'), 10);
        if (!isNaN(val) && val > 0) {
          qty = val;
          updateView();
        }
      });
    });

    // Copy No Rekening
    const btnCopyInfaq = document.getElementById('btnCopyInfaq');
    const labelCopyInfaq = document.getElementById('labelCopyInfaq');
    if (btnCopyInfaq && labelCopyInfaq) {
      btnCopyInfaq.addEventListener('click', function() {
        const rek = this.getAttribute('data-clipboard');
        if (navigator.clipboard) {
          navigator.clipboard.writeText(rek).then(() => {
            labelCopyInfaq.textContent = 'Tersalin!';
            setTimeout(() => {
              labelCopyInfaq.textContent = 'Salin';
            }, 2500);
          });
        }
      });
    }

    // Init
    updateView();
  })();
</script>
