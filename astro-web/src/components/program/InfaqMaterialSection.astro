---
// src/components/program/InfaqMaterialSection.astro
// Gotong Royong Material Fisik Pembangunan Kampus Jonggol
// STANDAR ISAVO EDITORIAL: SPLIT 2-KOLOM HEADER, ZERO BOX-SHADOW, ZERO GRID LINES, ZERO TOMBOL KASIR SHOPPING-CART
import type { ProgramData } from '../../data/programs';

interface Props {
  program: ProgramData;
}

const { program } = Astro.props;

// Daftar Material Fisik Konstruksi Riil di Sukasirna Jonggol
const materials = [
  {
    id: 'semen',
    name: 'Semen Konstruksi SNI',
    unit: 'sak',
    price: 65000,
    target: 2500,
    collected: 1840,
    desc: 'Pengecoran pilar, dak lantai pelataran ibadah, dan workshop santri vokasi.',
    impactText: '1 sak semen menyelesaikan ±0.5 m² lantai pelataran ibadah.'
  },
  {
    id: 'pasir',
    name: 'Pasir Cor & Pasang',
    unit: 'm³',
    price: 350000,
    target: 450,
    collected: 310,
    desc: 'Agregat halus standar mutu beton tinggi untuk struktur bangunan kokoh.',
    impactText: '1 m³ pasir mencukupi adukan plester dan pasang dinding studio.'
  },
  {
    id: 'roster',
    name: 'Bata Roster Terakota Alami',
    unit: 'buah',
    price: 15000,
    target: 8000,
    collected: 5400,
    desc: 'Sirkulasi udara alami ramah energi agar ruangan belajar sejuk alami tanpa AC.',
    impactText: '10 roster menyusun 1 panel sirkulasi udara alami ruang ibadah.'
  },
  {
    id: 'sanitasi',
    name: 'Kran Sanitasi & Eco-Drainase Wudhu',
    unit: 'titik',
    price: 250000,
    target: 60,
    collected: 42,
    desc: 'Instalasi kran hemat air dengan saluran daur ulang air wudhu untuk kebun pesantren.',
    impactText: '1 titik wudhu melayani ratusan basuhan air suci jamaah setiap waktu salat.'
  }
];
---

<section class="infaq-material-section" id="gotong-royong-material">
  <div class="infaq-container">
    <!-- Header Section Split 2-Kolom (Gaya Baku ISAVO) -->
    <div class="isavo-section-header">
      <div class="header-left-col">
        <span class="isavo-subheading">GOTONG ROYONG FISIK</span>
      </div>
      <div class="header-right-col">
        <h2 class="isavo-main-title">
          Wujudkan Bangunan Fisik Lewat <span class="title-accent">Material Nyata</span>
        </h2>
        <p class="isavo-main-desc">
          Bukan sekadar angka di atas kertas. Setiap rupiah infaq Anda dikonversikan langsung menjadi sak semen, pasir cor, dan bata roster yang terpasang nyata di kawasan Sukasirna, Jonggol, Kabupaten Bogor.
        </p>
      </div>
    </div>

    <!-- Main Open Layout: Dua Kolom Terbuka (Flat & Grounded) -->
    <div class="material-open-layout">
      <!-- Kolom Kiri: Ledger Baris Material -->
      <div class="material-ledger-col">
        <div class="ledger-header-row">
          <h3 class="ledger-title">Daftar Kebutuhan Konstruksi di Lapangan</h3>
        </div>

        <div class="material-flat-list">
          {materials.map(mat => {
            const percent = Math.round((mat.collected / mat.target) * 100);
            return (
              <div
                class="mat-flat-row"
                data-mat-id={mat.id}
                data-price={mat.price}
                data-name={mat.name}
                data-unit={mat.unit}
              >
                <div class="mat-info-block">
                  <div class="mat-name-row">
                    <h4 class="mat-name">{mat.name}</h4>
                    <span class="mat-price-label">Rp {mat.price.toLocaleString('id-ID')} <small>/{mat.unit}</small></span>
                  </div>
                  <p class="mat-desc">{mat.desc}</p>
                </div>

                <!-- Flat Progress Indicator -->
                <div class="mat-progress-rail">
                  <div class="mat-progress-bar" style={`width: ${percent}%;`}></div>
                </div>

                <div class="mat-meta-row">
                  <span class="mat-stat">Terkumpul <strong>{mat.collected.toLocaleString('id-ID')}</strong> dari {mat.target.toLocaleString('id-ID')} {mat.unit} ({percent}%)</span>
                  <button type="button" class="btn-select-flat" data-mat-id={mat.id}>
                    Pilih Material
                  </button>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Kolom Kanan: Formulir Partisipasi Vokasi (Flat, Zero Shadow, Zero Stepper Belanja) -->
      <div class="calc-open-col">
        <div class="calc-sticky-flat">
          <div class="calc-flat-head">
            <span class="calc-eyebrow-mini">KOMITMEN PARTISIPASI FISIK</span>
            <h3 class="calc-main-title">Pilihan Paket Dukungan</h3>
          </div>

          <!-- Active Selection Summary -->
          <div class="active-item-flat">
            <div class="item-name-big" id="displayMatName">Semen Konstruksi SNI</div>
            <div class="item-price-rate" id="displayMatRate">Rp 65.000 / sak</div>
          </div>

          <!-- Paket Unit Pilihan (Clean Editorial Radio Chips, Bukan Stepper Ritel) -->
          <div class="package-selection-wrap">
            <label class="package-label-text">Tentukan Jumlah Partisipasi:</label>
            <div class="package-chips-grid">
              <button type="button" class="pkg-chip-btn" data-qty="1">
                <span class="pkg-qty">1</span>
                <span class="pkg-unit" id="chipUnit1">sak</span>
              </button>
              <button type="button" class="pkg-chip-btn active" data-qty="5">
                <span class="pkg-qty">5</span>
                <span class="pkg-unit" id="chipUnit2">sak</span>
              </button>
              <button type="button" class="pkg-chip-btn" data-qty="10">
                <span class="pkg-qty">10</span>
                <span class="pkg-unit" id="chipUnit3">sak</span>
              </button>
              <button type="button" class="pkg-chip-btn" data-qty="25">
                <span class="pkg-qty">25</span>
                <span class="pkg-unit" id="chipUnit4">sak</span>
              </button>
            </div>

            <!-- Manual Custom Input (Opsional Bersih Tanpa Plus Minus) -->
            <div class="custom-input-row">
              <span class="custom-input-label">Atau masukkan jumlah kustom:</span>
              <div class="custom-input-field">
                <input
                  type="number"
                  id="inputQty"
                  class="input-clean"
                  value="5"
                  min="1"
                  max="5000"
                  aria-label="Jumlah kustom material"
                />
                <span class="custom-unit-suffix" id="displayUnitSuffix">sak</span>
              </div>
            </div>
          </div>

          <!-- Total Nominal: Flat Prominent Typography -->
          <div class="total-nominal-flat">
            <span class="nominal-caption">Total Nilai Infaq Material:</span>
            <div class="nominal-val-huge" id="displayTotalInfaq">Rp 325.000</div>
            <p class="nominal-impact-text" id="displayImpactDesc">
              Setara <strong>5 sak semen</strong> untuk percepatan pengecoran pelataran ibadah.
            </p>
          </div>

          <!-- Direct Flat Action CTA (Zero Shadow) -->
          <div class="cta-flat-actions">
            <a
              href="https://wa.me/6281226832326?text=Assalamualaikum%20Admin%20GVF%2C%20saya%20ingin%20berinfaq%205%20sak%20Semen%20sebesar%20Rp%20325.000%20untuk%20pembangunan%20Jonggol."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-submit-flat"
              id="btnInfaqWA"
            >
              <span>Salurkan Infaq Material</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>

            <!-- Flat Rekening Info -->
            <div class="rekening-flat-strip">
              <div class="rek-meta-flat">
                <span class="rek-bank-label">BSI Khusus Infaq</span>
                <strong class="rek-digits-flat">7238890023</strong>
                <button
                  type="button"
                  class="btn-copy-flat"
                  id="btnCopyInfaq"
                  data-clipboard="7238890023"
                  title="Salin No Rekening Infaq"
                >
                  <span id="labelCopyInfaq">Salin</span>
                </button>
              </div>
              <div class="rek-holder-flat">a.n. <strong>Yayasan Global Village Fund - Infaq</strong></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Dokumentasi Lapangan Riil (Galeri Flat Sesuai Standar ISAVO) -->
    <div class="field-photos-flat">
      <div class="photo-item-flat">
        <img
          src="/gambar-bahan/pelataran mesjid.jpeg"
          alt="Pelataran Masjid Khairu Ummah Sugro Jonggol"
          class="img-flat"
          loading="lazy"
        />
        <div class="caption-flat">
          <strong>Pelataran Masjid Khairu Ummah:</strong> Realisasi pengecoran lantai dan halaman terbuka yang menampung santri vokasi dan jamaah masyarakat Jonggol.
        </div>
      </div>
      <div class="photo-item-flat">
        <img
          src="/gambar-bahan/wc mesjid.jpeg"
          alt="Fasilitas Sanitasi dan Wudhu Masjid Jonggol"
          class="img-flat"
          loading="lazy"
        />
        <div class="caption-flat">
          <strong>Fasilitas Sanitasi & Wudhu Bersih:</strong> Pembangunan titik wudhu modern dengan sirkulasi udara alami dan saluran air ramah lingkungan.
        </div>
      </div>
    </div>
  </div>
</section>

<style>
