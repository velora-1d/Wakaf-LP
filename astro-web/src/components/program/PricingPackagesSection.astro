---
// src/components/program/PricingPackagesSection.astro
// Komponen Pilihan Paket Program GVF & Live Donatur Feed Terintegrasi DB PostgreSQL
// Menggunakan Vanilla Scoped CSS murni untuk menjamin render 100% akurat dan responsif
import type { ProgramData, PricingPackage, DeliverableItem } from '../../data/programs';
import { getVerifiedDonationsByProgram, getProgramPackages, getVerifiedDonationSum } from '../../lib/db';

interface Props {
  program: ProgramData;
}

const { program } = Astro.props;

// Ambil paket dinamis dari DB jika telah diatur di CMS, fallback ke data static programs.ts
const dbPackageData = await getProgramPackages(program.slug);
const pricingHeading = dbPackageData?.heading || program.pricingHeading;
const pricingSubheading = dbPackageData?.subheading || program.pricingSubheading;
const rawPackages = (dbPackageData?.packages && dbPackageData.packages.length > 0) ? dbPackageData.packages : program.packages;

// Sanitasi judul paket: eliminasi total prefiks A., B., C. maupun angka 1., 2., 3.
const packages = rawPackages.map((pkg: PricingPackage) => ({
  ...pkg,
  title: (pkg.title || '').replace(/^[A-Za-z0-9]\.\s*/, '').trim(),
  isPopular: false,
}));

// Ambil riwayat donatur terverifikasi (lunas) real-time dan agregasi SQL SUM tanpa batas limit
const [verifiedDonations, programSummary] = await Promise.all([
  getVerifiedDonationsByProgram(program.slug, 100),
  getVerifiedDonationSum([program.slug]),
]);
const totalTerhimpun = programSummary.totalNominal;
const totalTransaksi = programSummary.totalTransaksi;

// Penomoran resmi murni angka tanpa simbol pagar
const numberedDonations = verifiedDonations.map((item, idx) => ({
  ...item,
  no: idx + 1,
}));

// Preview ringkas 8 donatur teratas di landing page program agar halaman tidak scroll panjang
const previewDonations = numberedDonations.slice(0, 8);

function formatRupiah(amount: number): string {
  return new Intl.NumberFormat('id-ID', {
    style: 'currency',
    currency: 'IDR',
    minimumFractionDigits: 0,
    maximumFractionDigits: 0,
  }).format(amount).replace(/\s/g, ' ');
}

function formatRelativeDate(date: Date | string): string {
  const d = new Date(date);
  const now = new Date();
  const diffMs = now.getTime() - d.getTime();
  const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

  if (diffHours < 1) return 'Baru saja';
  if (diffHours < 24) return `${diffHours} jam lalu`;
  if (diffDays === 1) return 'Kemarin';
  if (diffDays < 7) return `${diffDays} hari lalu`;
  return d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
}
---

<section class="pen-pricing-section" id="paket-pilihan">
  <div class="pricing-container">
    <div class="pricing-header-wrap">
      <h2 class="pricing-main-heading">
        {pricingHeading}
      </h2>
      <p class="pricing-sub-heading">
        {pricingSubheading}
      </p>
    </div>

    <div class={`pricing-cards-grid ${packages.length >= 4 ? 'pricing-cards-grid-4' : ''}`}>
      {packages.map((pkg: PricingPackage) => (
        <div class="pkg-card">
          {pkg.image && (
            <div class="pkg-card-media">
              <img src={pkg.image} alt={pkg.title} loading="lazy" />
            </div>
          )}
          <div class="card-content-top">
            <div class="card-title-group">
              <h3 class="card-title">{pkg.title}</h3>
              <p class="card-subtitle">{pkg.subtitle}</p>

              <div class="card-price-val">
                {pkg.pricePrefix}{pkg.priceAmount}{pkg.priceUnit}
              </div>
              <div class="card-price-desc">
                {pkg.priceDesc}
              </div>
              <div class="card-estimation-pill">
                {pkg.estimation}
              </div>
            </div>

            <div class="what-do-you-get-bar">
              <span>RINCIAN ALOKASI & MANFAAT DONASI:</span>
            </div>

            <ul class="card-deliverables-list">
              {pkg.deliverables.map((item: DeliverableItem) => (
                <li class="deliverable-item">
                  <span class="check-icon-wrap" aria-hidden="true">
                    <svg viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                  </span>
                  <div class="deliverable-content">
                    <span class="deliverable-title">{item.bold}</span>
                    {item.text && <span class="deliverable-desc">{item.text}</span>}
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <div class="card-cta-wrap">
            <button
              type="button"
              class="pkg-cta-button js-open-checkout"
              data-pkg-title={pkg.title}
              data-pkg-price={String(pkg.priceAmount || '').replace(/[^\d]/g, '') || '0'}
              data-pkg-unit={pkg.priceUnit || ''}
              data-program-slug={program.slug}
              data-program-title={program.title}
            >
              {pkg.ctaText}
            </button>
          </div>
        </div>
      ))}
    </div>

    <!-- DAFTAR DONATUR & MUHSININ TERKINI (LIVE VERIFIED FEED) -->
    <div class="donatur-feed-section" id="daftar-donatur">
      <div class="donatur-section-header">
        <h3 class="donatur-section-title">
          Daftar Muhsinin &amp; Donatur Terkini
        </h3>
        <p class="donatur-section-subtitle">
          Transparansi amanah filantropi Islam pada program <strong>{program.title}</strong> yang telah terverifikasi lunas oleh tim amil Global Village Fund.
        </p>
      </div>

      <!-- Mini Metrics Bar -->
      <div class="donatur-metrics-bar">
        <div class="metric-chip">
          <div class="metric-chip-icon text-blue">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="1" x2="12" y2="23"></line>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <div class="metric-chip-content">
            <span class="chip-label">Total Terhimpun</span>
            <span class="chip-val font-mono">{formatRupiah(totalTerhimpun)}</span>
          </div>
        </div>

        <div class="metric-chip">
          <div class="metric-chip-icon text-blue">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <div class="metric-chip-content">
            <span class="chip-label">Muhsinin Terdaftar</span>
            <span class="chip-val">{totalTransaksi} Transaksi Lunas</span>
          </div>
        </div>

        <div class="metric-chip">
          <div class="metric-chip-icon text-green">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
          </div>
          <div class="metric-chip-content">
            <span class="chip-label">Tata Kelola Syariah</span>
            <span class="chip-val">Akuntabel &amp; Sah Peruntukan</span>
          </div>
        </div>
      </div>

      <!-- Donors Search Toolbar & Counter -->
      <div class="donor-toolbar">
        <div class="donor-counter-badge">
          <span class="count-total">{totalTransaksi}</span>
          <span>Transaksi Lunas Terverifikasi</span>
        </div>

        <a href={`/donatur?program=${program.slug}`} class="btn-goto-all-donors">
          <span>Lihat Semua Donatur ({totalTransaksi} Transaksi)</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <!-- Donors Unified Table -->
      {verifiedDonations.length > 0 ? (
        <div class="donatur-tables-container">
          <div class="donatur-table-column">
            <div class="donatur-table-scroll">
              <table class="donatur-table">
                <thead>
                  <tr>
                    <th class="col-no">No</th>
                    <th class="col-donor">Muhsinin / Donatur</th>
                    <th class="col-intent">Niat &amp; Doa Kebaikan</th>
                    <th class="col-amount">Nominal Donasi</th>
                    <th class="col-status">Status Amil</th>
                  </tr>
                </thead>
                <tbody>
                  {previewDonations.map((item) => (
                    <tr class="donor-row">
                      <td class="col-no">
                        <span class="no-val">{item.no}</span>
                      </td>
                      <td class="col-donor">
                        <div class="donor-info">
                          <span class="donor-name">{item.namaDonatur || 'Hamba Allah'}</span>
                          <span class="donor-date">{formatRelativeDate(item.createdAt)}</span>
                        </div>
                      </td>
                      <td class="col-intent">
                        <div class="intent-wrapper">
                          {item.atasNamaNiat && (
                            <span class="atas-nama-tag">
                              Atas Nama: <strong>{item.atasNamaNiat}</strong>
                            </span>
                          )}
                          {item.doaDonatur ? (
                            <p class="donor-prayer">&ldquo;{item.doaDonatur}&rdquo;</p>
                          ) : (
                            <p class="donor-prayer-empty">Semoga menjadi amal shodaqoh jariyah yang kekal dan membawa keberkahan keluarga.</p>
                          )}
                        </div>
                      </td>
                      <td class="col-amount">
                        <span class="amount-val font-mono">{formatRupiah(item.nominalTotal)}</span>
                        {item.metodePembayaran && (
                          <span class="payment-method-badge">{item.metodePembayaran}</span>
                        )}
                      </td>
                      <td class="col-status">
                        <span class="status-verified-badge">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"></polyline>
                          </svg>
                          <span>Lunas Terverifikasi</span>
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <!-- Table Bottom Bar -->
            <div class="table-bottom-bar">
              <span class="table-bottom-hint">Menampilkan {previewDonations.length} dari {totalTransaksi} transaksi terkini</span>
              <a href={`/donatur?program=${program.slug}`} class="btn-more-donors-link">
                <span>Buka Seluruh Daftar Donatur ({totalTransaksi})</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </div>
        ) : (
          <div class="donatur-empty-state">
            <div class="empty-icon-wrap">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#0969da" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
              </svg>
            </div>
            <h4 class="empty-title">Belum Ada Riwayat Transaksi Publik untuk Program Ini</h4>
            <p class="empty-desc">
              Jadilah muhsinin pertama yang mengalirkan jariyah kebaikan untuk kemaslahatan santri dan umat melalui program <strong>{program.title}</strong>.
            </p>
            <a
              href={`https://wa.me/6281226832326?text=${encodeURIComponent(`Assalamualaikum Admin GVF, saya ingin menyalurkan donasi pertama untuk program ${program.title}. Mohon panduan nomor rekening resmi yayasan dan akadnya.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="empty-cta-btn"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
              <span>Salurkan Donasi Pertama Sekarang</span>
            </a>
          </div>
        )}
    </div>
  </div>
</section>

<!-- Modal Checkout Transfer BSI & Upload Bukti -->
<div id="gvfCheckoutModal" class="gvf-modal-backdrop" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="gvfModalTitle">
  <div class="gvf-modal-card">
    <div class="gvf-modal-header">
      <div>
        <span class="gvf-modal-eyebrow" id="gvfModalProgramLabel">Program Kontribusi</span>
        <h3 class="gvf-modal-title" id="gvfModalTitle">Konfirmasi Transfer BSI</h3>
      </div>
      <button type="button" class="gvf-modal-close" id="gvfModalCloseBtn" aria-label="Tutup modal">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>

    <div class="gvf-modal-body">
      <!-- Form View -->
      <form id="gvfCheckoutForm" class="gvf-checkout-form" novalidate>
        <!-- Ringkasan Paket & Jumlah -->
        <div class="gvf-summary-box">
          <div class="gvf-summary-top">
            <div>
              <span class="gvf-summary-label">Paket Dipilih</span>
              <div class="gvf-summary-pkg" id="gvfPkgName">-</div>
            </div>
            <div class="gvf-qty-wrap" id="gvfQtyWrap">
              <button type="button" class="gvf-qty-btn" id="gvfQtyMinus" aria-label="Kurangi jumlah">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 12h14"></path></svg>
              </button>
              <span class="gvf-qty-val" id="gvfQtyVal">1</span>
              <button type="button" class="gvf-qty-btn" id="gvfQtyPlus" aria-label="Tambah jumlah">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
              </button>
            </div>
          </div>

          <div id="gvfCustomNominalWrap" class="gvf-field" hidden style="margin-top: 12px;">
            <label for="gvfCustomNominal" class="gvf-label">Nominal Kontribusi (Rp)</label>
            <input type="number" id="gvfCustomNominal" class="gvf-input" min="10000" step="1000" placeholder="Contoh: 100000" />
          </div>

          <div class="gvf-summary-total-row">
            <span>Total Transfer</span>
            <strong class="gvf-total-amount" id="gvfTotalDisplay">Rp 0</strong>
          </div>
        </div>

        <!-- Step 1: Rekening Resmi BSI -->
        <div class="gvf-bank-card">
          <div class="gvf-bank-head">
            <span class="gvf-bank-step">1. Transfer ke Rekening Resmi</span>
            <span class="gvf-bank-code">Kode Bank: 451</span>
          </div>
          <div class="gvf-bank-name">Bank Syariah Indonesia (BSI)</div>
          <div class="gvf-bank-acc-row">
            <span class="gvf-bank-acc-num">7142 2637 63</span>
            <button type="button" class="gvf-copy-btn" id="gvfCopyRekBtn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
              </svg>
              <span id="gvfCopyRekText">Salin</span>
            </button>
          </div>
          <div class="gvf-bank-owner">a.n. Yayasan Permata Cendekia Indonesia</div>
        </div>

        <!-- Step 2: Data Donatur & Upload Bukti -->
        <div class="gvf-form-section-title">2. Lengkapi Data &amp; Unggah Bukti Transfer</div>

        <div class="gvf-form-grid">
          <div class="gvf-field">
            <label for="gvfNamaLengkap" class="gvf-label">Nama Lengkap <span class="gvf-req">*</span></label>
            <input type="text" id="gvfNamaLengkap" name="namaLengkap" class="gvf-input" placeholder="Masukkan nama lengkap Anda" required />
          </div>

          <div class="gvf-field">
            <label for="gvfNoWhatsapp" class="gvf-label">Nomor WhatsApp <span class="gvf-req">*</span></label>
            <input type="tel" id="gvfNoWhatsapp" name="noWhatsapp" class="gvf-input" placeholder="0812xxxxxxxx" required />
          </div>
        </div>

        <div class="gvf-field">
          <label for="gvfNamaTampilan" class="gvf-label">Nama Tampilan di Daftar Donatur (Opsional)</label>
          <input type="text" id="gvfNamaTampilan" name="namaTampilan" class="gvf-input" placeholder="Kosongkan jika ingin tampil sebagai Hamba Allah" />
        </div>

        <div class="gvf-field">
          <label for="gvfDoaDonatur" class="gvf-label">Doa atau Harapan (Opsional)</label>
          <textarea id="gvfDoaDonatur" name="doaDonatur" class="gvf-textarea" rows="2" placeholder="Tuliskan doa atau niat kebaikan Anda..."></textarea>
        </div>

        <div class="gvf-field">
          <label for="gvfBuktiFile" class="gvf-label">Unggah Bukti Transfer (JPG, PNG, WEBP, PDF maks. 15MB) <span class="gvf-req">*</span></label>
          <label for="gvfBuktiFile" class="gvf-upload-dropzone" id="gvfUploadDropzone">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0969da" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" x2="12" y1="3" y2="15"></line>
            </svg>
            <span id="gvfBuktiFileName">Pilih file bukti transfer dari perangkat Anda</span>
          </label>
          <input type="file" id="gvfBuktiFile" name="bukti" accept=".jpg,.jpeg,.png,.webp,.pdf,image/jpeg,image/png,image/webp,application/pdf" class="gvf-sr-only" required />
        </div>

        <div id="gvfFormError" class="gvf-error-banner" hidden role="alert"></div>

        <button type="submit" class="gvf-submit-btn" id="gvfSubmitBtn">
          Kirim Bukti &amp; Catat Kontribusi
        </button>
      </form>

      <!-- Step 3: Success & Konfirmasi WA -->
      <div id="gvfCheckoutSuccess" class="gvf-success-view" hidden>
        <div class="gvf-success-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
        </div>
        <h4 class="gvf-success-title">Bukti Transfer Berhasil Diunggah</h4>
        <p class="gvf-success-desc">
          Kontribusi Anda telah tercatat dengan status <strong>Menunggu Verifikasi Amil</strong>. Silakan lanjutkan konfirmasi ke WhatsApp resmi kami agar segera diverifikasi.
        </p>

        <div class="gvf-receipt-box">
          <div class="gvf-receipt-row">
            <span>Kode Transaksi</span>
            <strong id="gvfSuccessKode">-</strong>
          </div>
          <div class="gvf-receipt-row">
            <span>Total Nominal</span>
            <strong id="gvfSuccessNominal">-</strong>
          </div>
        </div>

        <button type="button" id="gvfShareWaBtn" class="gvf-share-wa-btn" hidden>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="18" cy="5" r="3"></circle>
            <circle cx="6" cy="12" r="3"></circle>
            <circle cx="18" cy="19" r="3"></circle>
            <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line>
            <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line>
          </svg>
          <span>Kirim Gambar + Teks ke WhatsApp</span>
        </button>

        <button type="button" id="gvfCopyImgBtn" class="gvf-copy-img-btn" hidden>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
          </svg>
          <span id="gvfCopyImgText">Salin Gambar Bukti (Tempel Ctrl+V di WA)</span>
        </button>

        <a id="gvfWaConfirmBtn" href="#" target="_blank" rel="noopener noreferrer" class="gvf-wa-confirm-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          <span>Buka WhatsApp Admin</span>
        </a>

        <p id="gvfCopyImgHint" class="gvf-copy-img-hint" hidden>
          Gambar bukti otomatis disalin ke clipboard — di chat WhatsApp tinggal tekan <strong>Ctrl+V</strong> (atau tempel) sebelum kirim.
        </p>

