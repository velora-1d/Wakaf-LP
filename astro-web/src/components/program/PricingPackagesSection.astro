---
// src/components/program/PricingPackagesSection.astro
// Komponen Pilihan Paket ZISWAF & Live Donatur Feed Terintegrasi DB PostgreSQL
// Menggunakan Vanilla Scoped CSS murni untuk menjamin render 100% akurat dan responsif
import type { ProgramData } from '../../data/programs';
import { getVerifiedDonationsByProgram, getProgramPackages } from '../../lib/db';

interface Props {
  program: ProgramData;
}

const { program } = Astro.props;

// Ambil paket dinamis dari DB jika telah diatur di CMS, fallback ke data static programs.ts
const dbPackageData = await getProgramPackages(program.slug);
const pricingHeading = dbPackageData?.heading || program.pricingHeading;
const pricingSubheading = dbPackageData?.subheading || program.pricingSubheading;
const packages = (dbPackageData?.packages && dbPackageData.packages.length > 0) ? dbPackageData.packages : program.packages;

// Ambil riwayat donatur terverifikasi (lunas) real-time untuk program ini (hingga 100 donatur)
const verifiedDonations = await getVerifiedDonationsByProgram(program.slug, 100);
const totalTerhimpun = verifiedDonations.reduce((acc, cur) => acc + (cur.nominalTotal || 0), 0);

function formatRupiah(amount: number): string {
  return new Intl.NumberFormat('id-ID', {
    style: 'currency',
    currency: 'IDR',
    minimumFractionDigits: 0,
    maximumFractionDigits: 0,
  }).format(amount).replace(/\s/g, ' ');
}

function formatRelativeDate(date: Date | string): string {
  const d = new Date(date);
  const now = new Date();
  const diffMs = now.getTime() - d.getTime();
  const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

  if (diffHours < 1) return 'Baru saja';
  if (diffHours < 24) return `${diffHours} jam lalu`;
  if (diffDays === 1) return 'Kemarin';
  if (diffDays < 7) return `${diffDays} hari lalu`;
  return d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
}
---

<section class="pen-pricing-section" id="paket-pilihan">
  <div class="pricing-container">
    <div class="pricing-header-wrap">
      <div class="pricing-badge-pill">
        <span class="dot-green"></span>
        <span class="badge-text">{program.slug === 'infaq' ? 'PILIHAN PAKET INFAQ' : 'PAKET PILIHAN PROGRAM'}</span>
      </div>
      <h2 class="pricing-main-heading">
        {pricingHeading}
      </h2>
      <p class="pricing-sub-heading">
        {pricingSubheading}
      </p>
    </div>

    <div class="pricing-cards-grid">
      {packages.map((pkg) => (
        <div class={`pkg-card ${pkg.isPopular ? 'is-popular' : ''}`}>
          {pkg.isPopular && (
            <div class="rekomendasi-tag">
              REKOMENDASI PROGRAM
            </div>
          )}

          <div class="card-content-top">
            <div class="card-title-group">
              <h3 class="card-title">{pkg.title}</h3>
              <p class="card-subtitle">{pkg.subtitle}</p>

              <div class="card-price-val">
                {pkg.pricePrefix}{pkg.priceAmount}{pkg.priceUnit}
              </div>
              <div class="card-price-desc">
                {pkg.priceDesc}
              </div>
              <div class="card-estimation-pill">
                {pkg.estimation}
              </div>
            </div>

            <div class="what-do-you-get-bar">
              <span>RINCIAN ALOKASI & MANFAAT DONASI:</span>
            </div>

            <ul class="card-deliverables-list">
              {pkg.deliverables.map((item) => (
                <li class="deliverable-item">
                  <span class="check-icon-wrap">
                    <svg viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                  </span>
                  <div class="deliverable-text">
                    <strong>{item.bold} — </strong>{item.text}
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <div class="card-cta-wrap">
            <a
              href={`https://wa.me/6281226832326?text=${encodeURIComponent(`Assalamualaikum Admin GVF, saya ingin menyalurkan ${program.title} untuk paket: ${pkg.title} sebesar ${pkg.pricePrefix || ''}${pkg.priceAmount}. Mohon panduan transfer dan akadnya.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="pkg-cta-button"
            >
              {pkg.ctaText}
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- DAFTAR DONATUR & MUHSININ TERKINI (LIVE VERIFIED FEED) -->
    <div class="donatur-feed-section" id="daftar-donatur">
      <div class="donatur-section-header">
        <div class="live-status-pill">
          <span class="pulse-dot-wrap">
            <span class="pulse-dot-ping"></span>
            <span class="pulse-dot-core"></span>
          </span>
          <span class="live-pill-text">TRANSAKSI TERVERIFIKASI REAL-TIME</span>
        </div>
        <h3 class="donatur-section-title">
          Daftar Muhsinin &amp; Donatur Terkini
        </h3>
        <p class="donatur-section-subtitle">
          Transparansi amanah filantropi Islam pada program <strong>{program.title}</strong> yang telah terverifikasi lunas oleh tim amil Global Village Fund.
        </p>
      </div>

      <!-- Mini Metrics Bar -->
      <div class="donatur-metrics-bar">
        <div class="metric-chip">
          <div class="metric-chip-icon text-blue">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="1" x2="12" y2="23"></line>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <div class="metric-chip-content">
            <span class="chip-label">Total Terhimpun</span>
            <span class="chip-val font-mono">{formatRupiah(totalTerhimpun)}</span>
          </div>
        </div>

        <div class="metric-chip">
          <div class="metric-chip-icon text-blue">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <div class="metric-chip-content">
            <span class="chip-label">Muhsinin Terdaftar</span>
            <span class="chip-val">{verifiedDonations.length} Transaksi Lunas</span>
          </div>
        </div>

        <div class="metric-chip">
          <div class="metric-chip-icon text-green">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
          </div>
          <div class="metric-chip-content">
            <span class="chip-label">Tata Kelola Syariah</span>
            <span class="chip-val">Akuntabel &amp; Sah Peruntukan</span>
          </div>
        </div>
      </div>

      <!-- Donors Table / Card -->
      <div class="donatur-table-card">
        {verifiedDonations.length > 0 ? (
          <div class="donatur-table-scroll">
            <table class="donatur-table">
              <thead>
                <tr>
                  <th class="col-donor">Muhsinin / Donatur</th>
                  <th class="col-intent">Niat &amp; Doa Kebaikan</th>
                  <th class="col-amount">Nominal Donasi</th>
                  <th class="col-status">Status Amil</th>
                </tr>
              </thead>
              <tbody>
                {verifiedDonations.map((item) => {
                  const initial = (item.namaDonatur || 'HA').charAt(0).toUpperCase();
                  return (
                    <tr>
                      <td class="col-donor">
                        <div class="donor-profile-group">
                          <div class="donor-avatar">
                            {initial}
                          </div>
                          <div class="donor-info">
                            <span class="donor-name">{item.namaDonatur}</span>
                            <span class="donor-date">{formatRelativeDate(item.createdAt)}</span>
                          </div>
                        </div>
                      </td>
                      <td class="col-intent">
                        <div class="intent-wrapper">
                          {item.atasNamaNiat && (
                            <span class="atas-nama-tag">
                              Atas Nama: <strong>{item.atasNamaNiat}</strong>
                            </span>
                          )}
                          {item.doaDonatur ? (
                            <p class="donor-prayer">&ldquo;{item.doaDonatur}&rdquo;</p>
                          ) : (
                            <p class="donor-prayer-empty">Semoga menjadi amal jariyah yang berlipat ganda bagi keluarga.</p>
                          )}
                        </div>
                      </td>
                      <td class="col-amount">
                        <span class="amount-val font-mono">{formatRupiah(item.nominalTotal)}</span>
                        {item.metodePembayaran && (
                          <span class="payment-method-badge">{item.metodePembayaran}</span>
                        )}
                      </td>
                      <td class="col-status">
                        <span class="status-verified-badge">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                          </svg>
                          <span>Lunas Terverifikasi</span>
                        </span>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="donatur-empty-state">
            <div class="empty-icon-wrap">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#0969da" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
              </svg>
            </div>
            <h4 class="empty-title">Belum Ada Riwayat Transaksi Publik untuk Program Ini</h4>
            <p class="empty-desc">
              Jadilah muhsinin pertama yang mengalirkan jariyah kebaikan untuk kemaslahatan santri dan umat melalui program <strong>{program.title}</strong>.
            </p>
            <a
              href={`https://wa.me/6281226832326?text=${encodeURIComponent(`Assalamualaikum Admin GVF, saya ingin menyalurkan donasi pertama untuk program ${program.title}. Mohon panduan nomor rekening resmi yayasan dan akadnya.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="empty-cta-btn"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
              <span>Salurkan Donasi Pertama Sekarang</span>
            </a>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  /* =========================================================================
     VANILLA SCOPED CSS UNTUK PAKET PRICING PEN.DEV
     ========================================================================= */
  .pen-pricing-section {
    background-color: #f8f8f8;
    padding: 80px 24px 100px;
    width: 100%;
    box-sizing: border-box;
  }

  .pricing-container {
    max-width: 1380px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  /* Header Section */
  .pricing-header-wrap {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 56px;
  }

  .pricing-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgba(114, 114, 114, 0.25);
    border-radius: 9999px;
    padding: 6px 18px;
    background: #ffffff;
    margin-bottom: 16px;
  }

  .dot-green {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #0969da;
  }

  .badge-text {
    font-family: 'Golos Text', system-ui, sans-serif;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-weight: 600;
    color: #191919;
  }

  .pricing-main-heading {
    font-family: 'Golos Text', system-ui, sans-serif;
    font-size: clamp(28px, 4vw, 48px);
    color: #0f172a;
    line-height: 1.15;
    margin: 0 0 16px;
    font-weight: 500;
  }

  .pricing-sub-heading {
    font-family: 'Golos Text', system-ui, sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: #4d4d52;
    margin: 0 auto;
    max-width: 720px;
  }

  /* 3 Pricing Cards Grid */
  .pricing-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    align-items: stretch;
    margin-bottom: 70px;
  }

  @media (max-width: 1024px) {
    .pricing-cards-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  .pkg-card {
    background: #ffffff;
    border-radius: 24px;
    border: 1px solid #e3e3e8;
    padding: 44px 32px 36px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    box-sizing: border-box;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    transition: transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .pkg-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .pkg-card.is-popular {
    border: 2px solid #0969da;
    box-shadow: 0 10px 30px rgba(9, 105, 218, 0.12);
    padding-top: 56px;
  }

  .rekomendasi-tag {
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    background-color: #0969da;
    color: #ffffff;
    font-family: 'Golos Text', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 700;
    padding: 6px 20px;
    border-radius: 0 0 10px 10px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    box-shadow: 0 2px 8px rgba(9, 105, 218, 0.25);
    white-space: nowrap;
  }

  .card-title-group {
    text-align: center;
    margin-bottom: 24px;
  }

  .card-title {
    font-family: 'Golos Text', system-ui, sans-serif;
    font-size: 24px;
    color: #191919;
    margin: 0 0 4px;
    font-weight: 600;
  }

  .card-subtitle {
    font-family: 'Golos Text', system-ui, sans-serif;
    font-size: 13px;
    color: #4d4d52;
    margin: 0 0 18px;
  }

  .card-price-val {
    font-family: 'Golos Text', system-ui, sans-serif;
    font-size: 36px;
    font-weight: 700;
    color: #191919;
    margin: 0 0 4px;
    line-height: 1.1;
  }

  .card-price-desc {
    font-family: 'Golos Text', sans-serif;
    font-size: 12px;
    font-style: italic;
    color: #4d4d52;
    margin-bottom: 8px;
  }

  .card-estimation-pill {
    display: inline-block;
    font-family: 'Golos Text', sans-serif;
    font-size: 12px;
    font-weight: 700;
    color: #0752a8;
    background-color: rgba(9, 105, 218, 0.12);
    padding: 4px 14px;
    border-radius: 9999px;
    margin-top: 4px;
  }

  .what-do-you-get-bar {
    border-bottom: 2px solid #0969da;
    padding-bottom: 6px;
    margin-bottom: 16px;
  }

  .what-do-you-get-bar span {
    font-family: 'Golos Text', sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.5px;
    color: #191919;
    text-transform: uppercase;
  }

  .card-deliverables-list {
    list-style: none;
    margin: 0 0 32px;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .deliverable-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid #e3e3e8;
    font-family: 'Golos Text', sans-serif;
    font-size: 13px;
    color: #4d4d52;
    line-height: 1.5;
  }

  .deliverable-item:last-child {
    border-bottom: none;
  }

  .check-icon-wrap {
    color: #0969da;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .check-icon-wrap svg {
    width: 16px;
    height: 16px;
    display: block;
  }

  .deliverable-text strong {
    color: #191919;
    font-weight: 600;
  }

  .card-cta-wrap {
    margin-top: auto;
    padding-top: 10px;
  }

  .pkg-cta-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 52px;
    background-color: #0969da;
    color: #ffffff !important;
    font-family: 'Golos Text', system-ui, sans-serif;
    font-size: 15px;
    border-radius: 100px;
    text-decoration: none;
    font-weight: 600;
    box-shadow: 0 4px 12px rgba(9, 105, 218, 0.2);
    transition: background-color 180ms cubic-bezier(0.2, 0.8, 0.2, 1), transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .pkg-cta-button:hover {
    background-color: #0752a8;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(9, 105, 218, 0.35);
  }

  .pkg-cta-button:active {
    transform: scale(0.97);
  }

  .pkg-cta-button:focus-visible {
    outline: 2px solid #0969da;
    outline-offset: 2px;
  }

  /* =========================================================================
     LIVE DONATUR FEED SECTION (MODERN SOCIAL PROOF & TRANSPARANSI SYARIAH)
     ========================================================================= */
  .donatur-feed-section {
    max-width: 1120px;
    margin: 40px auto 60px;
    width: 100%;
    box-sizing: border-box;
  }

  .donatur-section-header {
    text-align: center;
    margin-bottom: 28px;
  }

  .live-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid #bae6fd;
    background: #f0f9ff;
    border-radius: 9999px;
    padding: 5px 14px;
    margin-bottom: 12px;
  }

  .pulse-dot-wrap {
    position: relative;
    width: 8px;
    height: 8px;
    display: inline-flex;
  }

  .pulse-dot-ping {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #0969da;
    animation: livePing 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
    opacity: 0.75;
  }

  .pulse-dot-core {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #0969da;
  }

  @keyframes livePing {
    75%, 100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  .live-pill-text {
    font-size: 11px;
    font-weight: 700;
    color: #0369a1;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .donatur-section-title {
    font-family: 'Golos Text', system-ui, sans-serif;
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 8px;
  }

  .donatur-section-subtitle {
    font-family: 'Golos Text', system-ui, sans-serif;
    font-size: 14px;
    color: #64748b;
    margin: 0 auto;
    line-height: 1.6;
    max-width: 680px;
  }

  .donatur-section-subtitle strong {
    color: #0f172a;
  }

  /* Metrics Bar */
  .donatur-metrics-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }

  .metric-chip {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.02);
  }

  .metric-chip-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: #eff6ff;
    color: #0969da;
  }

  .metric-chip-icon.text-green {
    background: #ecfdf5;
    color: #059669;
  }

  .metric-chip-content {
    display: flex;
    flex-direction: column;
  }

  .chip-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    color: #64748b;
    letter-spacing: 0.03em;
  }

  .chip-val {
    font-size: 15px;
    font-weight: 700;
    color: #0f172a;
    margin-top: 2px;
  }

  /* Table Card */
  .donatur-table-card {
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 0 4px 16px rgba(0,0,0,0.02);
  }

  .donatur-table-scroll {
    overflow-x: auto;
    overflow-y: auto;
    max-height: 520px;
    width: 100%;
    scrollbar-width: thin;
    scrollbar-color: #0969da #f1f5f9;
  }

  .donatur-table-scroll::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }

  .donatur-table-scroll::-webkit-scrollbar-track {
    background: #f1f5f9;
  }

  .donatur-table-scroll::-webkit-scrollbar-thumb {
    background: #0969da;
    border-radius: 4px;
  }

