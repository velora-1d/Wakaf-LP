<script>
  function setupDonorGridFeed() {
    const searchInput = document.getElementById('donorSearchField') as HTMLInputElement | null;
    const gridLayout = document.getElementById('donorGridLayout');
    const paginationWrap = document.getElementById('donorPaginationWrap');
    const btnLoadMore = document.getElementById('btnLoadMoreDonors');
    const btnShowAll = document.getElementById('btnShowAllDonors');
    const countDisplay = document.getElementById('donorDisplayCount');
    const emptyState = document.getElementById('donorSearchEmpty');

    if (!gridLayout) return;

    const cards = Array.from(gridLayout.querySelectorAll<HTMLElement>('.donor-grid-card'));
    const total = cards.length;
    let visibleLimit = 12;

    function renderVisibility() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      let matchCount = 0;

      cards.forEach((card, idx) => {
        const searchData = card.getAttribute('data-search') || '';
        const matchesSearch = !query || searchData.includes(query);

        if (matchesSearch) {
          matchCount++;
          if (query) {
            // Jika sedang mencari, tampilkan semua yang cocok
            card.style.display = 'flex';
          } else {
            // Mode normal: patuhi batas limit
            card.style.display = idx < visibleLimit ? 'flex' : 'none';
          }
        } else {
          card.style.display = 'none';
        }
      });

      if (countDisplay) {
        countDisplay.textContent = query ? String(matchCount) : String(Math.min(visibleLimit, total));
      }

      if (paginationWrap) {
        if (query || visibleLimit >= total) {
          paginationWrap.style.display = 'none';
        } else {
          paginationWrap.style.display = 'flex';
        }
      }

      if (emptyState) {
        emptyState.style.display = matchCount === 0 ? 'block' : 'none';
      }
    }

    renderVisibility();

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        renderVisibility();
      });
    }

    if (btnLoadMore) {
      btnLoadMore.addEventListener('click', () => {
        visibleLimit += 12;
        renderVisibility();
      });
    }

    if (btnShowAll) {
      btnShowAll.addEventListener('click', () => {
        visibleLimit = total;
        renderVisibility();
      });
    }
  }

  // Jalankan saat load awal & saat transisi navigasi halaman
  setupDonorGridFeed();
  document.addEventListener('astro:page-load', setupDonorGridFeed);
</script>
