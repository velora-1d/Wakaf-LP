---
// src/components/program/PricingPackagesSection.astro
// Komponen Pilihan Paket ZISWAF Presisi 100% Desain Pen.dev (global village fund.pen)
// Menggunakan Vanilla Scoped CSS murni untuk menjamin render 100% akurat tanpa isu compiler utility
import type { ProgramData } from '../../data/programs';

interface Props {
  program: ProgramData;
}

const { program } = Astro.props;
---

<section class="pen-pricing-section" id="paket-pilihan">
  <div class="pricing-container">
    <div class="pricing-header-wrap">
      <div class="pricing-badge-pill">
        <span class="dot-green"></span>
        <span class="badge-text">{program.slug === 'infaq' ? 'PILIHAN PAKET INFAQ' : 'PAKET PILIHAN PROGRAM'}</span>
      </div>
      <h2 class="pricing-main-heading">
        {program.pricingHeading}
      </h2>
      <p class="pricing-sub-heading">
        {program.pricingSubheading}
      </p>
    </div>

    <div class="pricing-cards-grid">
      {program.packages.map((pkg) => (
        <div class={`pkg-card ${pkg.isPopular ? 'is-popular' : ''}`}>
          {pkg.isPopular && (
            <div class="rekomendasi-tag">
              REKOMENDASI PROGRAM
            </div>
          )}

          <div class="card-content-top">
            <div class="card-title-group">
              <h3 class="card-title">{pkg.title}</h3>
              <p class="card-subtitle">{pkg.subtitle}</p>

              <div class="card-price-val">
                {pkg.pricePrefix}{pkg.priceAmount}{pkg.priceUnit}
              </div>
              <div class="card-price-desc">
                {pkg.priceDesc}
              </div>
              <div class="card-estimation-pill">
                {pkg.estimation}
              </div>
            </div>

            <div class="what-do-you-get-bar">
              <span>WHAT DO YOU GET:</span>
            </div>

            <ul class="card-deliverables-list">
              {pkg.deliverables.map((item) => (
                <li class="deliverable-item">
                  <span class="check-icon-wrap">
                    <svg viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                  </span>
                  <div class="deliverable-text">
                    <strong>{item.bold} — </strong>{item.text}
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <div class="card-cta-wrap">
            <a
              href={`https://wa.me/6281226832326?text=${encodeURIComponent(`Assalamualaikum Admin GVF, saya ingin menyalurkan ${program.title} untuk paket: ${pkg.title} sebesar ${pkg.pricePrefix || ''}${pkg.priceAmount}. Mohon panduan transfer dan akadnya.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="pkg-cta-button"
            >
              {pkg.ctaText}
            </a>
          </div>
        </div>
      ))}
    </div>

    {program.addonItems && program.addonItems.length > 0 && (
      <div class="addon-table-section">
        <h3 class="addon-section-title">
          {program.addonTitle || 'Pilihan Saluran Infaq Tambahan'}
        </h3>

        <div class="addon-table-card">
          <div class="addon-table-scroll">
            <table class="addon-table">
              <thead>
                <tr>
                  <th class="col-category">Infaq</th>
                  <th class="col-desc">Keterangan</th>
                  <th class="col-price">Harga</th>
                  <th class="col-avail">Ketersediaan</th>
                </tr>
              </thead>
              <tbody>
                {program.addonItems.map((addon) => (
                  <tr>
                    <td class="col-category font-bold">{addon.name}</td>
                    <td class="col-desc">{addon.desc}</td>
                    <td class="col-price font-bold text-green">{addon.price}</td>
                    <td class="col-avail italic">{addon.availability}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  /* =========================================================================
     VANILLA SCOPED CSS UNTUK PAKET PRICING PEN.DEV
     ========================================================================= */
  .pen-pricing-section {
    background-color: #f8f8f8;
    padding: 80px 24px 100px;
    width: 100%;
    box-sizing: border-box;
  }

  .pricing-container {
    max-width: 1380px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  /* Header Section */
  .pricing-header-wrap {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 56px;
  }

  .pricing-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgba(114, 114, 114, 0.25);
    border-radius: 9999px;
    padding: 6px 18px;
    background: #ffffff;
    margin-bottom: 16px;
  }

  .dot-green {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #0969da;
  }

  .badge-text {
    font-family: 'Cal Sans', sans-serif;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-weight: 600;
    color: #191919;
  }

  .pricing-main-heading {
    font-family: 'Cal Sans', sans-serif;
    font-size: clamp(28px, 4vw, 48px);
    color: #0f172a;
    line-height: 1.15;
    margin: 0 0 16px;
    font-weight: normal;
  }

  .pricing-sub-heading {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: #4d4d52;
    margin: 0 auto;
    max-width: 720px;
  }

  /* 3 Pricing Cards Grid */
  .pricing-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    align-items: stretch;
    margin-bottom: 70px;
  }

  @media (max-width: 1024px) {
    .pricing-cards-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  .pkg-card {
    background: #ffffff;
    border-radius: 24px;
    border: 1px solid #e3e3e8;
    padding: 44px 32px 36px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    box-sizing: border-box;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .pkg-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .pkg-card.is-popular {
    border: 2px solid #0969da;
    box-shadow: 0 10px 30px rgba(9, 105, 218, 0.12);
    padding-top: 56px;
  }

  .rekomendasi-tag {
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    background-color: #0969da;
    color: #ffffff;
    font-family: 'Golos Text', sans-serif;
    font-size: 11px;
    font-weight: 700;
    padding: 6px 20px;
    border-radius: 0 0 10px 10px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    box-shadow: 0 2px 8px rgba(0, 107, 62, 0.25);
    white-space: nowrap;
  }

  .card-title-group {
    text-align: center;
    margin-bottom: 24px;
  }

  .card-title {
    font-family: 'Cal Sans', sans-serif;
    font-size: 24px;
    color: #191919;
    margin: 0 0 4px;
    font-weight: 600;
  }

  .card-subtitle {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px;
    color: #4d4d52;
    margin: 0 0 18px;
  }

  .card-price-val {
    font-family: 'Cal Sans', sans-serif;
    font-size: 36px;
    font-weight: 700;
    color: #191919;
    margin: 0 0 4px;
    line-height: 1.1;
  }

  .card-price-desc {
    font-family: 'Golos Text', sans-serif;
    font-size: 12px;
    font-style: italic;
    color: #4d4d52;
    margin-bottom: 8px;
  }

  .card-estimation-pill {
    display: inline-block;
    font-family: 'Golos Text', sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: #0969da;
    background-color: rgba(9, 105, 218, 0.08);
    padding: 4px 14px;
    border-radius: 9999px;
    margin-top: 4px;
  }

  .what-do-you-get-bar {
    border-bottom: 2px solid #0969da;
    padding-bottom: 6px;
    margin-bottom: 16px;
  }

  .what-do-you-get-bar span {
    font-family: 'Golos Text', sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.5px;
    color: #191919;
    text-transform: uppercase;
  }

  .card-deliverables-list {
    list-style: none;
    margin: 0 0 32px;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .deliverable-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid #e3e3e8;
    font-family: 'Golos Text', sans-serif;
    font-size: 13px;
    color: #4d4d52;
    line-height: 1.5;
  }

  .deliverable-item:last-child {
    border-bottom: none;
  }

  .check-icon-wrap {
    color: #0969da;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .check-icon-wrap svg {
    width: 16px;
    height: 16px;
    display: block;
  }

  .deliverable-text strong {
    color: #191919;
    font-weight: 600;
  }

  .card-cta-wrap {
    margin-top: auto;
    padding-top: 10px;
  }

  .pkg-cta-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 52px;
    background-color: #0969da;
    color: #ffffff !important;
    font-family: 'Cal Sans', sans-serif;
    font-size: 15px;
    border-radius: 100px;
    text-decoration: none;
    font-weight: 500;
    box-shadow: 0 4px 12px rgba(9, 105, 218, 0.2);
    transition: background-color 0.2s, transform 0.15s;
  }

  .pkg-cta-button:hover {
    background-color: #0752a8;
    transform: scale(0.99);
  }

  /* Add-on Table Section */
  .addon-table-section {
    max-width: 960px;
    margin: 0 auto 60px;
  }

  .addon-section-title {
    font-family: 'Cal Sans', sans-serif;
    font-size: 26px;
    color: #191919;
    text-align: center;
    margin: 0 0 24px;
    font-weight: 600;
  }

  .addon-table-card {
    border: 1px solid #e3e3e8;
    border-radius: 16px;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 0 4px 16px rgba(0,0,0,0.02);
  }

  .addon-table-scroll {
    overflow-x: auto;
    width: 100%;
  }

  .addon-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    min-width: 680px;
  }

  .addon-table thead tr {
    background-color: #191919;
  }

  .addon-table th {
    padding: 14px 20px;
    color: #ffffff;
    font-family: 'Golos Text', sans-serif;
    font-size: 13px;
    font-weight: 600;
    text-align: left;
  }

  .addon-table th.col-price,
  .addon-table th.col-avail {
    text-align: right;
  }

  .col-category { width: 28%; }
  .col-desc { width: 40%; }
  .col-price { width: 16%; }
  .col-avail { width: 16%; }

  .addon-table tbody tr {
    border-bottom: 1px solid #e3e3e8;
    transition: background-color 0.15s;
  }

  .addon-table tbody tr:hover {
    background-color: #fbfbfb;
  }

  .addon-table tbody tr:last-child {
    border-bottom: none;
  }

  .addon-table td {
    padding: 16px 20px;
    font-family: 'Golos Text', sans-serif;
    font-size: 13px;
    color: #4d4d52;
    line-height: 1.5;
  }

  .addon-table td.col-price,
  .addon-table td.col-avail {
    text-align: right;
  }

  .addon-table td.font-bold {
    font-weight: 600;
    color: #191919;
  }

  .addon-table td.text-green {
    color: #0969da;
  }

  .addon-table td.italic {
    font-style: italic;
  }

</style>
