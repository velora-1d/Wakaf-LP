<script>
  (() => {
    const modal = document.getElementById('gvfCheckoutModal');
    if (!modal) return;

    const closeBtn = document.getElementById('gvfModalCloseBtn');
    const successDoneBtn = document.getElementById('gvfSuccessDoneBtn');
    const form = document.getElementById('gvfCheckoutForm') as HTMLFormElement | null;
    const successView = document.getElementById('gvfCheckoutSuccess');
    const programLabel = document.getElementById('gvfModalProgramLabel');
    const pkgNameEl = document.getElementById('gvfPkgName');
    const qtyWrap = document.getElementById('gvfQtyWrap');
    const qtyMinus = document.getElementById('gvfQtyMinus');
    const qtyPlus = document.getElementById('gvfQtyPlus');
    const qtyValEl = document.getElementById('gvfQtyVal');
    const customNominalWrap = document.getElementById('gvfCustomNominalWrap');
    const customNominalInput = document.getElementById('gvfCustomNominal') as HTMLInputElement | null;
    const totalDisplay = document.getElementById('gvfTotalDisplay');
    const copyRekBtn = document.getElementById('gvfCopyRekBtn');
    const copyRekText = document.getElementById('gvfCopyRekText');
    const buktiInput = document.getElementById('gvfBuktiFile') as HTMLInputElement | null;
    const buktiFileName = document.getElementById('gvfBuktiFileName');
    const errorBanner = document.getElementById('gvfFormError');
    const submitBtn = document.getElementById('gvfSubmitBtn') as HTMLButtonElement | null;
    const successKode = document.getElementById('gvfSuccessKode');
    const successNominal = document.getElementById('gvfSuccessNominal');
    const waConfirmBtn = document.getElementById('gvfWaConfirmBtn') as HTMLAnchorElement | null;
    const shareWaBtn = document.getElementById('gvfShareWaBtn') as HTMLButtonElement | null;
    const copyImgBtn = document.getElementById('gvfCopyImgBtn') as HTMLButtonElement | null;
    const copyImgText = document.getElementById('gvfCopyImgText');
    const copyImgHint = document.getElementById('gvfCopyImgHint');

    let currentUnitPrice = 0;
    let currentQty = 1;
    let currentPkgTitle = '';
    let currentProgramTitle = '';
    let lastUploadedFile: File | null = null;
    let lastWaMessage = '';

    const copyImageFileToClipboard = async (file: File): Promise<boolean> => {
      if (!file.type.startsWith('image/') || typeof ClipboardItem === 'undefined' || !navigator.clipboard?.write) {
        return false;
      }
      try {
        const pngBlob = await new Promise<Blob>((resolve, reject) => {
          const img = new Image();
          const url = URL.createObjectURL(file);
          img.onload = () => {
            const canvas = document.createElement('canvas');
            canvas.width = img.naturalWidth || img.width;
            canvas.height = img.naturalHeight || img.height;
            const ctx = canvas.getContext('2d');
            if (!ctx) {
              URL.revokeObjectURL(url);
              reject(new Error('No canvas context'));
              return;
            }
            ctx.drawImage(img, 0, 0);
            URL.revokeObjectURL(url);
            canvas.toBlob((blob) => {
              if (blob) resolve(blob);
              else reject(new Error('Failed to encode PNG'));
            }, 'image/png');
          };
          img.onerror = () => {
            URL.revokeObjectURL(url);
            reject(new Error('Image load error'));
          };
          img.src = url;
        });
        await navigator.clipboard.write([new ClipboardItem({ 'image/png': pngBlob })]);
        return true;
      } catch {
        return false;
      }
    };

    const formatRp = (val: number) => 'Rp ' + new Intl.NumberFormat('id-ID').format(Math.max(0, Math.round(val)));

    const getEffectiveTotal = () => {
      if (currentUnitPrice > 0) return currentUnitPrice * currentQty;
      return Number(customNominalInput?.value) || 0;
    };

    const syncTotalDisplay = () => {
      if (qtyValEl) qtyValEl.textContent = String(currentQty);
      if (totalDisplay) totalDisplay.textContent = formatRp(getEffectiveTotal());
    };

    const showError = (msg: string) => {
      if (!errorBanner) return;
      errorBanner.textContent = msg;
      errorBanner.hidden = false;
    };

    const clearError = () => {
      if (!errorBanner) return;
      errorBanner.textContent = '';
      errorBanner.hidden = true;
    };

    const openModal = (btn: HTMLElement) => {
      currentPkgTitle = btn.dataset.pkgTitle || 'Paket Kontribusi';
      currentProgramTitle = btn.dataset.programTitle || 'Program Kebaikan';
      currentUnitPrice = Number(btn.dataset.pkgPrice) || 0;
      currentQty = 1;

      if (programLabel) programLabel.textContent = currentProgramTitle;
      if (pkgNameEl) pkgNameEl.textContent = currentPkgTitle;

      if (currentUnitPrice > 0) {
        if (qtyWrap) qtyWrap.hidden = false;
        if (customNominalWrap) customNominalWrap.hidden = true;
      } else {
        if (qtyWrap) qtyWrap.hidden = true;
        if (customNominalWrap) customNominalWrap.hidden = false;
        if (customNominalInput) customNominalInput.value = '100000';
      }

      form?.reset();
      if (currentUnitPrice <= 0 && customNominalInput) customNominalInput.value = '100000';
      if (buktiFileName) buktiFileName.textContent = 'Pilih file bukti transfer dari perangkat Anda';
      clearError();

      if (form) form.hidden = false;
      if (successView) successView.hidden = true;
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Kirim Bukti & Catat Kontribusi';
      }

      syncTotalDisplay();
      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };

    const closeModal = () => {
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    document.querySelectorAll('.js-open-checkout').forEach((btn) => {
      btn.addEventListener('click', () => openModal(btn as HTMLElement));
    });

    closeBtn?.addEventListener('click', closeModal);
    successDoneBtn?.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) closeModal();
    });

    qtyMinus?.addEventListener('click', () => {
      if (currentQty > 1) {
        currentQty -= 1;
        syncTotalDisplay();
      }
    });

    qtyPlus?.addEventListener('click', () => {
      currentQty += 1;
      syncTotalDisplay();
    });

    customNominalInput?.addEventListener('input', syncTotalDisplay);

    copyRekBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('7142263763');
        if (copyRekText) {
          copyRekText.textContent = 'Tersalin!';
          setTimeout(() => {
            copyRekText.textContent = 'Salin';
          }, 2000);
        }
      } catch {
        // Fallback silently if clipboard unavailable
      }
    });

    buktiInput?.addEventListener('change', () => {
      const file = buktiInput.files?.[0];
      if (buktiFileName) {
        buktiFileName.textContent = file
          ? `${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)`
          : 'Pilih file bukti transfer dari perangkat Anda';
      }
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearError();

      const namaLengkap = (document.getElementById('gvfNamaLengkap') as HTMLInputElement)?.value.trim() || '';
      const namaTampilan = (document.getElementById('gvfNamaTampilan') as HTMLInputElement)?.value.trim() || '';
      const noWhatsapp = (document.getElementById('gvfNoWhatsapp') as HTMLInputElement)?.value.trim() || '';
      const doaDonatur = (document.getElementById('gvfDoaDonatur') as HTMLTextAreaElement)?.value.trim() || '';
      const file = buktiInput?.files?.[0];
      const totalNominal = getEffectiveTotal();

      if (!namaLengkap) {
        showError('Nama lengkap wajib diisi.');
        return;
      }
      if (!noWhatsapp) {
        showError('Nomor WhatsApp wajib diisi.');
        return;
      }
      if (totalNominal <= 0) {
        showError('Nominal kontribusi harus lebih dari 0.');
        return;
      }
      if (!file) {
        showError('Silakan unggah bukti transfer BSI terlebih dahulu.');
        return;
      }

      const fd = new FormData();
      fd.append('namaLengkap', namaLengkap);
      fd.append('namaTampilan', namaTampilan);
      fd.append('noWhatsapp', noWhatsapp);
      fd.append('programTujuan', currentProgramTitle);
      fd.append('paketNama', currentPkgTitle);
      fd.append('jumlahPaket', String(currentQty));
      fd.append('nominal', String(totalNominal));
      fd.append('doaDonatur', doaDonatur);
      fd.append('bukti', file);

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Mengunggah Bukti & Menyimpan...';
      }

      try {
        const res = await fetch('/api/kontribusi/submit', {
          method: 'POST',
          body: fd,
        });
        const data = await res.json();

        if (!res.ok || !data?.success) {
          throw new Error(data?.error || 'Gagal mengirim bukti transfer.');
        }

        const kode = data.data?.kodeTransaksi || '-';
        const nominalTotal = Number(data.data?.nominalTotal) || totalNominal;

        if (successKode) successKode.textContent = kode;
        if (successNominal) successNominal.textContent = formatRp(nominalTotal);

        const waMsg = [
          'Assalamualaikum Admin GVF,',
          'Saya telah melakukan transfer BSI dan mengunggah bukti pembayaran melalui website.',
          '',
          `Kode Transaksi: ${kode}`,
          `Program: ${currentProgramTitle}`,
          `Paket: ${currentPkgTitle}${currentQty > 1 ? ` (${currentQty}x)` : ''}`,
          `Nominal: ${formatRp(nominalTotal)}`,
          `Nama Donatur: ${namaLengkap}`,
          '',
          'Mohon bantuannya untuk verifikasi. Terima kasih.',
        ].join('\n');

        lastUploadedFile = file;
        lastWaMessage = waMsg;

        if (waConfirmBtn) {
          waConfirmBtn.href = `https://wa.me/6281226832326?text=${encodeURIComponent(waMsg)}`;
        }

        const isImage = file.type.startsWith('image/');
        const canNativeShareFile = Boolean(
          isImage && typeof navigator.canShare === 'function' && navigator.canShare({ files: [file] }),
        );

        if (shareWaBtn) shareWaBtn.hidden = !canNativeShareFile;
        if (copyImgBtn) copyImgBtn.hidden = !isImage;
        if (copyImgHint) copyImgHint.hidden = !isImage;
        if (copyImgText) copyImgText.textContent = 'Salin Gambar Bukti (Tempel Ctrl+V di WA)';

        form.hidden = true;
        if (successView) successView.hidden = false;
      } catch (err: any) {
        showError(err?.message || 'Terjadi kesalahan jaringan. Silakan coba lagi.');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Kirim Bukti & Catat Kontribusi';
        }
      }
    });

    shareWaBtn?.addEventListener('click', async () => {
      if (!lastUploadedFile || !navigator.share) return;
      try {
        await navigator.share({
          files: [lastUploadedFile],
          text: lastWaMessage,
        });
      } catch {
        // User cancelled share sheet
      }
    });

    copyImgBtn?.addEventListener('click', async () => {
      if (!lastUploadedFile) return;
      const ok = await copyImageFileToClipboard(lastUploadedFile);
      if (copyImgText) {
        copyImgText.textContent = ok
          ? 'Gambar Tersalin! Buka WA lalu Ctrl+V'
          : 'Browser tidak mendukung salin gambar otomatis';
      }
    });

    waConfirmBtn?.addEventListener('click', async () => {
      if (!lastUploadedFile || !lastUploadedFile.type.startsWith('image/')) return;
      const ok = await copyImageFileToClipboard(lastUploadedFile);
      if (ok && copyImgText) {
        copyImgText.textContent = 'Gambar Tersalin! Tinggal Ctrl+V di WA';
      }
    });
  })();
</script>
