---
// src/components/program/WakafLandSliderSection.astro
// Interactive Land Meter Slider (1 m² s/d 100 m² @ Rp 150.000 / m²)
// Berbasis Lahan Abadi Sukasirna Jonggol (Anti-Slop, Tanpa Pricing Table)
import type { ProgramData } from '../../data/programs';

interface Props {
  program: ProgramData;
}

const { program } = Astro.props;

const PRICE_PER_METER = 150000; // Rp 150.000 / m²
---

<section class="wakaf-slider-section" id="simulasi-wakaf-tanah">
  <div class="wakaf-container">
    <!-- Header -->
    <div class="wakaf-header text-center">
      <span class="wakaf-eyebrow">AMAL JARIYAH ABADI • DIAWASI BADAN WAKAF INDONESIA</span>
      <h2 class="wakaf-title">
        Simulasi Wakaf <span class="wakaf-accent">Pembebasan Lahan Abadi</span>
      </h2>
      <p class="wakaf-desc">
        Setiap meter persegi tanah yang Anda wakafkan di Sukasirna Jonggol akan menjadi tanah abadi yang menopang masjid, asrama, dan studio vokasi santri, mengalirkan pahala tak terputus lintas generasi.
      </p>
    </div>

    <!-- Main Interactive Card -->
    <div class="wakaf-interactive-card">
      <div class="slider-left-col">
        <div class="slider-box-head">
          <span class="badge-syariah">AKTA IKRAR WAKAF (AIW) RESMI BWI</span>
          <h3 class="box-title">Pilih Luas Meter Persegi (m²)</h3>
          <p class="box-subtitle">Geser slider atau pilih luas meter di bawah untuk menghitung partisipasi wakaf lahan Anda:</p>
        </div>

        <!-- Live Meter Counter Display -->
        <div class="meter-counter-display">
          <span class="meter-number" id="displayMeterVal">5</span>
          <span class="meter-unit">m² Lahan Abadi</span>
        </div>

        <!-- Range Slider -->
        <div class="range-slider-wrap">
          <input
            type="range"
            id="wakafRangeSlider"
            class="wakaf-range-input"
            min="1"
            max="100"
            value="5"
            step="1"
            aria-label="Pilih Luas Meter Persegi Lahan"
          />
          <div class="range-ticks">
            <span>1 m²</span>
            <span>25 m²</span>
            <span>50 m²</span>
            <span>75 m²</span>
            <span>100 m²</span>
          </div>
        </div>

        <!-- Quick Meter Presets -->
        <div class="meter-presets-row">
          <span class="presets-label">Pilihan Cepat:</span>
          <button type="button" class="preset-meter-btn" data-meter="1">1 m² (Rp 150 rb)</button>
          <button type="button" class="preset-meter-btn active" data-meter="5">5 m² (Rp 750 rb)</button>
          <button type="button" class="preset-meter-btn" data-meter="10">10 m² (Rp 1,5 Jt)</button>
          <button type="button" class="preset-meter-btn" data-meter="25">25 m² (Rp 3,75 Jt)</button>
          <button type="button" class="preset-meter-btn" data-meter="50">50 m² (Rp 7,5 Jt)</button>
        </div>

        <!-- Legal Notice -->
        <div class="wakaf-syariah-note">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <p>
            <strong>Kepastian Hukum Syar'i & Positif:</strong> Tanah wakaf berstatus aset abadi (mauquf bih) yang dilindungi UU No. 41 Tahun 2004. Nilai pokok tidak dapat dijual, diwariskan, dialihkan, atau disita.
          </p>
        </div>
      </div>

      <!-- Right Column: Result & AIW Digital Certificate Preview -->
      <div class="slider-right-col">
        <div class="aiw-preview-card">
          <div class="aiw-card-header">
            <span class="aiw-tag">ESTIMASI AKTA IKRAR WAKAF</span>
            <span class="bwi-verified">✓ Nazhir Terdaftar BWI</span>
          </div>

          <div class="aiw-amount-block">
            <span class="amount-label">Nilai Partisipasi Wakaf Lahan:</span>
            <div class="amount-number" id="displayTotalWakaf">Rp 750.000</div>
            <p class="amount-rate-note">@ Rp 150.000 / m² (Bebas biaya administrasi & notariat)</p>
          </div>

          <div class="aiw-deliverables-list">
            <div class="deliverable-item">
              <span class="deliv-icon">✓</span>
              <span><strong>Sertifikat Wakaf Digital:</strong> Berkode verifikasi QR resmi dari Nazhir Yayasan.</span>
            </div>
            <div class="deliverable-item">
              <span class="deliv-icon">✓</span>
              <span><strong>Inskripsi Dokumen Kawasan:</strong> Tercatat permanen pada buku induk wakif kampus Sukasirna Jonggol.</span>
            </div>
            <div class="deliverable-item">
              <span class="deliv-icon">✓</span>
              <span><strong>Pahala Berkelanjutan:</strong> Mengalir abadi dari setiap sujud jamaah dan pembelajaran santri vokasi.</span>
            </div>
          </div>

          <!-- CTAs -->
          <div class="aiw-actions">
            <a
              href="https://wa.me/6281226832326?text=Assalamualaikum%20Nazhir%20GVF%2C%20saya%20ingin%20berwakaf%20lahan%20seluas%205%20m%C2%B2%20sebesar%20Rp%20750.000%20untuk%20kawasan%20Jonggol."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-wakaf-primary"
              id="btnWakafWA"
            >
              <span>Ikrar Wakaf Sekarang</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>

            <!-- Quick Account Copy Card -->
            <div class="bank-wakaf-box">
              <div class="bank-wakaf-row">
                <div class="bw-info">
                  <span class="bw-tag">BSI WAKAF</span>
                  <strong class="bw-acc">7238890012</strong>
                </div>
                <button
                  type="button"
                  class="btn-copy-bw"
                  id="btnCopyWakaf"
                  data-clipboard="7238890012"
                  title="Salin No Rekening Wakaf"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span id="labelCopyWakaf">Salin Rekening</span>
                </button>
              </div>
              <div class="bw-holder">a.n. <strong>Yayasan Global Village Fund Wakaf</strong></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Real Land Documentation Strip -->
    <div class="real-land-strip">
      <div class="land-photo-wrap">
        <img
          src="/gambar-bahan/lahan donasi.jpg"
          alt="Hamparan Lahan Wakaf Abadi Sukasirna Jonggol Bogor"
          class="land-img"
          loading="lazy"
        />
        <div class="land-overlay">
          <div class="land-tag">LOKASI FISIK KAWASAN</div>
          <h4 class="land-title">Hamparan Lahan Abadi ±3 Hektare Sukasirna Jonggol</h4>
          <p class="land-desc">Tinjau langsung batas patok lahan dan masterplan pengembangan agro-technopark & SMK Skill Village terpadu.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .wakaf-slider-section {
    padding: 80px 0 100px;
    background-color: #ffffff;
    background-image: radial-gradient(ellipse at 50% 0%, rgba(2, 132, 199, 0.05) 0%, transparent 70%);
  }

  .wakaf-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .wakaf-header {
    max-width: 780px;
    margin: 0 auto 50px;
  }

  .wakaf-eyebrow {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #0284c7;
    margin-bottom: 12px;
  }

  .wakaf-title {
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.2;
    color: #0f172a;
    margin: 0 0 18px;
    letter-spacing: -0.02em;
  }

  .wakaf-accent {
    color: #0284c7;
  }

  .wakaf-desc {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: #475569;
    margin: 0;
  }

  /* Interactive Card */
  .wakaf-interactive-card {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 36px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    padding: 40px;
    box-shadow: none;
  }

  @media (max-width: 991px) {
    .wakaf-interactive-card {
      grid-template-columns: 1fr;
      padding: 28px;
    }
  }

  .badge-syariah {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: #15803d;
    background: #dcfce7;
    padding: 4px 10px;
    border-radius: 6px;
    margin-bottom: 10px;
  }

  .box-title {
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
    font-size: 1.5rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 6px;
  }

  .box-subtitle {
    font-size: 0.875rem;
    color: #64748b;
    margin: 0 0 24px;
    line-height: 1.5;
  }

  /* Meter Counter */
  .meter-counter-display {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 24px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 20px 24px;
  }

  .meter-number {
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
    font-size: 3.5rem;
    font-weight: 800;
    color: #0284c7;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .meter-unit {
    font-size: 1.25rem;
    font-weight: 700;
    color: #334155;
  }

  /* Slider */
  .range-slider-wrap {
    margin-bottom: 28px;
  }

  .wakaf-range-input {
    width: 100%;
    height: 10px;
    border-radius: 9999px;
    background: #e2e8f0;
    outline: none;
    -webkit-appearance: none;
    cursor: pointer;
  }

  .wakaf-range-input::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #0969da;
    border: 3px solid #ffffff;
    box-shadow: none;
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  .wakaf-range-input::-webkit-slider-thumb:hover {
    transform: scale(1.15);
  }

  .range-ticks {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    font-weight: 600;
    color: #94a3b8;
    margin-top: 8px;
  }

  /* Presets */
  .meter-presets-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  .presets-label {
    font-size: 0.8125rem;
    color: #64748b;
    font-weight: 600;
  }

  .preset-meter-btn {
    padding: 6px 12px;
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #334155;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .preset-meter-btn:hover,
  .preset-meter-btn.active {
    background: #0284c7;
    border-color: #0284c7;
    color: #ffffff;
  }

  /* Syariah Note */
  .wakaf-syariah-note {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: 12px;
    padding: 16px;
  }

  .wakaf-syariah-note svg {
    color: #16a34a;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .wakaf-syariah-note p {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #166534;
    margin: 0;
  }

  /* Right Col: AIW Card */
  .aiw-preview-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
  }

  .aiw-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }

  .aiw-tag {
    font-size: 0.75rem;
    font-weight: 800;
    color: #0284c7;
    letter-spacing: 0.05em;
  }

  .bwi-verified {
    font-size: 0.75rem;
    font-weight: 700;
    color: #15803d;
  }

  .aiw-amount-block {
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px dashed #cbd5e1;
  }

  .amount-label {
    display: block;
    font-size: 0.875rem;
    color: #64748b;
    font-weight: 600;
    margin-bottom: 6px;
  }

  .amount-number {
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
    font-size: 2.75rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 6px;
  }

  .amount-rate-note {
    font-size: 0.8125rem;
    color: #64748b;
    margin: 0;
  }

  .aiw-deliverables-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 28px;
  }

  .deliverable-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.875rem;
    line-height: 1.5;
    color: #334155;
  }

  .deliv-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    background: #dcfce7;
    color: #15803d;
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 800;
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Buttons */
  .aiw-actions {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .btn-wakaf-primary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: #0969da;
    color: #ffffff;
    padding: 16px 28px;
    border-radius: 9999px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    box-shadow: none;
    transition: all 0.2s ease;
  }

  .btn-wakaf-primary:hover {
    background: #0756b2;
    transform: translateY(-2px);
    box-shadow: none;
    color: #ffffff;
  }

  .bank-wakaf-box {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 12px 14px;
  }

  .bank-wakaf-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .bw-info {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .bw-tag {
    background: #0f172a;
    color: #ffffff;
    font-size: 0.6875rem;
    font-weight: 800;
    padding: 3px 6px;
    border-radius: 4px;
  }

  .bw-acc {
    font-size: 0.9375rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: 0.03em;
  }

  .btn-copy-bw {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 8px;
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 0.6875rem;
    font-weight: 700;
    color: #334155;
    cursor: pointer;
  }

  .bw-holder {
    font-size: 0.6875rem;
    color: #64748b;
    margin-top: 4px;
  }

  /* Land Photo Strip */
  .real-land-strip {
    margin-top: 60px;
    border-radius: 20px;
    overflow: hidden;
    position: relative;
    border: 1px solid #e2e8f0;
  }

  .land-photo-wrap {
    position: relative;
    height: 380px;
  }

  .land-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .land-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 32px 36px;
    background: linear-gradient(180deg, transparent 0%, rgba(15, 23, 42, 0.85) 100%);
    color: #ffffff;
  }

  .land-tag {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: #38bdf8;
    margin-bottom: 6px;
  }

  .land-title {
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
    font-size: 1.5rem;
    font-weight: 800;
    margin: 0 0 6px;
    color: #ffffff;
  }

  .land-desc {
    font-size: 0.9375rem;
    margin: 0;
    color: #cbd5e1;
  }
</style>

<script is:inline define:vars={{ PRICE_PER_METER }}>
  (function() {
    let currentMeter = 5;

    const rangeSlider = document.getElementById('wakafRangeSlider');
    const displayMeterVal = document.getElementById('displayMeterVal');
    const displayTotalWakaf = document.getElementById('displayTotalWakaf');
    const btnWakafWA = document.getElementById('btnWakafWA');

    function formatRupiah(num) {
      return new Intl.NumberFormat('id-ID').format(Math.max(0, Math.round(num)));
    }

    function updateWakaf(meter) {
      currentMeter = meter;
      if (rangeSlider) rangeSlider.value = meter;
      if (displayMeterVal) displayMeterVal.textContent = meter;

      const total = meter * PRICE_PER_METER;
      if (displayTotalWakaf) displayTotalWakaf.textContent = `Rp ${formatRupiah(total)}`;

      if (btnWakafWA) {
        const msg = encodeURIComponent(`Assalamualaikum Nazhir GVF, saya ingin berwakaf lahan seluas ${meter} m² sebesar Rp ${formatRupiah(total)} untuk kawasan Jonggol.`);
        btnWakafWA.href = `https://wa.me/6281226832326?text=${msg}`;
      }

      // Update preset buttons
      document.querySelectorAll('.preset-meter-btn').forEach(btn => {
        const m = parseInt(btn.getAttribute('data-meter'), 10);
        if (m === meter) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    }

    if (rangeSlider) {
      rangeSlider.addEventListener('input', function() {
        const val = parseInt(this.value, 10) || 1;
        updateWakaf(val);
      });
    }

    document.querySelectorAll('.preset-meter-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const m = parseInt(this.getAttribute('data-meter'), 10) || 1;
        updateWakaf(m);
      });
    });

    // Copy Account
    const btnCopyWakaf = document.getElementById('btnCopyWakaf');
    const labelCopyWakaf = document.getElementById('labelCopyWakaf');
    if (btnCopyWakaf) {
      btnCopyWakaf.addEventListener('click', function() {
        const textToCopy = this.getAttribute('data-clipboard') || '7238890012';
        navigator.clipboard.writeText(textToCopy).then(() => {
          if (labelCopyWakaf) labelCopyWakaf.textContent = 'Tersalin!';
          setTimeout(() => {
            if (labelCopyWakaf) labelCopyWakaf.textContent = 'Salin Rekening';
          }, 2500);
        });
      });
    }

    // Initial
    updateWakaf(5);
  })();
</script>
