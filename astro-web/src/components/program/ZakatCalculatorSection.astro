<script is:inline define:vars={{ GOLD_PRICE_PER_GRAM, NISAB_YEARLY, NISAB_MONTHLY }}>
  (function() {
    // Parser & Formatter Rupiah
    function parseRupiah(val) {
      if (!val) return 0;
      const clean = String(val).replace(/[^0-9]/g, '');
      return parseInt(clean, 10) || 0;
    }

    function formatRupiah(num) {
      return new Intl.NumberFormat('id-ID').format(Math.max(0, Math.round(num)));
    }

    // Tab State
    let currentMode = 'profesi'; // 'profesi' | 'maal'

    const tabBtnProfesi = document.getElementById('tabBtnProfesi');
    const tabBtnMaal = document.getElementById('tabBtnMaal');
    const panelProfesi = document.getElementById('panelProfesi');
    const panelMaal = document.getElementById('panelMaal');

    // Inputs
    const inputGaji = document.getElementById('inputGaji');
    const inputBonus = document.getElementById('inputBonus');
    const inputHutangBulanan = document.getElementById('inputHutangBulanan');

    const inputTabungan = document.getElementById('inputTabungan');
    const inputEmas = document.getElementById('inputEmas');
    const inputHutangTahunan = document.getElementById('inputHutangTahunan');

    // Output Elements
    const statusNisabBadge = document.getElementById('statusNisabBadge');
    const resultLabelPeriod = document.getElementById('resultLabelPeriod');
    const resultNominalZakat = document.getElementById('resultNominalZakat');
    const resultBasisDetail = document.getElementById('resultBasisDetail');
    const nisabBarProfesi = document.getElementById('nisabBarProfesi');
    const nisabBarMaal = document.getElementById('nisabBarMaal');
    const btnSalurkanWA = document.getElementById('btnSalurkanWA');

    // Auto-formatting input listener
    const inputsToFormat = [
      inputGaji, inputBonus, inputHutangBulanan,
      inputTabungan, inputEmas, inputHutangTahunan
    ];

    inputsToFormat.forEach(input => {
      if (!input) return;
      input.addEventListener('input', function() {
        const raw = parseRupiah(this.value);
        this.value = raw > 0 ? formatRupiah(raw) : '';
        calculateZakat();
      });
    });

    // Preset chips
    document.querySelectorAll('.chip-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const targetId = this.getAttribute('data-target');
        const val = parseInt(this.getAttribute('data-val'), 10);
        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          targetEl.value = formatRupiah(val);
          calculateZakat();
        }
      });
    });

    // Switch Tabs
    function switchTab(mode) {
      currentMode = mode;
      if (mode === 'profesi') {
        tabBtnProfesi.classList.add('active');
        tabBtnProfesi.setAttribute('aria-selected', 'true');
        tabBtnMaal.classList.remove('active');
        tabBtnMaal.setAttribute('aria-selected', 'false');

        panelProfesi.hidden = false;
        panelProfesi.classList.add('active');
        panelMaal.hidden = true;
        panelMaal.classList.remove('active');
      } else {
        tabBtnMaal.classList.add('active');
        tabBtnMaal.setAttribute('aria-selected', 'true');
        tabBtnProfesi.classList.remove('active');
        tabBtnProfesi.setAttribute('aria-selected', 'false');

        panelMaal.hidden = false;
        panelMaal.classList.add('active');
        panelProfesi.hidden = true;
        panelProfesi.classList.remove('active');
      }
      calculateZakat();
    }

    if (tabBtnProfesi) tabBtnProfesi.addEventListener('click', () => switchTab('profesi'));
    if (tabBtnMaal) tabBtnMaal.addEventListener('click', () => switchTab('maal'));

    // Calculation Core
    function calculateZakat() {
      if (currentMode === 'profesi') {
        const gaji = parseRupiah(inputGaji?.value);
        const bonus = parseRupiah(inputBonus?.value);
        const hutang = parseRupiah(inputHutangBulanan?.value);

        const totalNet = Math.max(0, (gaji + bonus) - hutang);
        const isMencapaiNisab = totalNet >= NISAB_MONTHLY;
        const zakatWajib = isMencapaiNisab ? Math.round(totalNet * 0.025) : 0;

        if (resultLabelPeriod) resultLabelPeriod.textContent = 'Kewajiban Zakat Profesi Bulanan:';
        if (resultNominalZakat) {
          resultNominalZakat.textContent = `Rp ${formatRupiah(isMencapaiNisab ? zakatWajib : 0)}`;
          resultNominalZakat.style.color = isMencapaiNisab ? '#0f172a' : '#d97706';
        }

        if (statusNisabBadge) {
          if (isMencapaiNisab) {
            statusNisabBadge.textContent = 'MEMENUHI NISAB';
            statusNisabBadge.className = 'result-badge-label';
          } else {
            statusNisabBadge.textContent = 'BELUM CAPAI NISAB';
            statusNisabBadge.className = 'result-badge-label below-nisab';
          }
        }

        if (resultBasisDetail) {
          if (isMencapaiNisab) {
            resultBasisDetail.textContent = `2,5% dari total penghasilan bersih Rp ${formatRupiah(totalNet)} / bulan (Nisab: Rp ${formatRupiah(NISAB_MONTHLY)})`;
          } else {
            resultBasisDetail.textContent = `Penghasilan bersih Rp ${formatRupiah(totalNet)} belum mencapai nisab bulanan (Rp ${formatRupiah(NISAB_MONTHLY)}). Disarankan Infaq/Sedekah.`;
          }
        }

        if (nisabBarProfesi) {
          if (isMencapaiNisab) {
            nisabBarProfesi.classList.remove('below-nisab');
          } else {
            nisabBarProfesi.classList.add('below-nisab');
          }
        }

        // WhatsApp Link
        if (btnSalurkanWA) {
          const nominalStr = formatRupiah(isMencapaiNisab ? zakatWajib : 0);
          const msg = encodeURIComponent(`Assalamualaikum Amil GVF, saya telah menghitung Zakat Profesi sebesar Rp ${nominalStr}/bulan dan ingin menunaikannya.`);
          btnSalurkanWA.href = `https://wa.me/6281226832326?text=${msg}`;
        }

      } else {
        // Maal
        const tabungan = parseRupiah(inputTabungan?.value);
        const emas = parseRupiah(inputEmas?.value);
        const hutang = parseRupiah(inputHutangTahunan?.value);

        const totalNet = Math.max(0, (tabungan + emas) - hutang);
        const isMencapaiNisab = totalNet >= NISAB_YEARLY;
        const zakatWajib = isMencapaiNisab ? Math.round(totalNet * 0.025) : 0;

        if (resultLabelPeriod) resultLabelPeriod.textContent = 'Kewajiban Zakat Maal Tahunan (Haul 1 Tahun):';
        if (resultNominalZakat) {
          resultNominalZakat.textContent = `Rp ${formatRupiah(isMencapaiNisab ? zakatWajib : 0)}`;
          resultNominalZakat.style.color = isMencapaiNisab ? '#0f172a' : '#d97706';
        }

        if (statusNisabBadge) {
          if (isMencapaiNisab) {
            statusNisabBadge.textContent = 'MEMENUHI NISAB';
            statusNisabBadge.className = 'result-badge-label';
          } else {
            statusNisabBadge.textContent = 'BELUM CAPAI NISAB';
            statusNisabBadge.className = 'result-badge-label below-nisab';
          }
        }

        if (resultBasisDetail) {
          if (isMencapaiNisab) {
            resultBasisDetail.textContent = `2,5% dari harta mengendap Rp ${formatRupiah(totalNet)} / tahun (Nisab: Rp ${formatRupiah(NISAB_YEARLY)})`;
          } else {
            resultBasisDetail.textContent = `Total harta bersih Rp ${formatRupiah(totalNet)} belum mencapai nisab tahunan (Rp ${formatRupiah(NISAB_YEARLY)}).`;
          }
        }

        if (nisabBarMaal) {
          if (isMencapaiNisab) {
            nisabBarMaal.classList.remove('below-nisab');
          } else {
            nisabBarMaal.classList.add('below-nisab');
          }
        }

        if (btnSalurkanWA) {
          const nominalStr = formatRupiah(isMencapaiNisab ? zakatWajib : 0);
          const msg = encodeURIComponent(`Assalamualaikum Amil GVF, saya telah menghitung Zakat Maal sebesar Rp ${nominalStr} dan ingin menunaikannya.`);
          btnSalurkanWA.href = `https://wa.me/6281226832326?text=${msg}`;
        }
      }
    }

    // Copy Account Button
    const btnCopyZakat = document.getElementById('btnCopyZakat');
    const copyBtnLabel = document.getElementById('copyBtnLabel');
    if (btnCopyZakat) {
      btnCopyZakat.addEventListener('click', function() {
        const textToCopy = this.getAttribute('data-clipboard') || '7238890045';
        navigator.clipboard.writeText(textToCopy).then(() => {
          if (copyBtnLabel) copyBtnLabel.textContent = 'Tersalin!';
          setTimeout(() => {
            if (copyBtnLabel) copyBtnLabel.textContent = 'Salin Rekening';
          }, 2500);
        });
      });
    }

    // Initial run
    calculateZakat();
  })();
</script>
