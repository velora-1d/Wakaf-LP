---
// src/components/layout/Footer.astro
// Exact ISAVO Footer UI/UX Design: Moody Interior Backdrop, 4-Col Grid, Large Contacts, & Giant "gvf" Watermark
---

<footer class="isavo-footer-section" id="tentang-kami">
  <!-- Architectural Interior Backdrop Image ala ISAVO -->
  <div
    class="isavo-footer-bg"
    style="background-image: url('/gambar design/interior masjid.jpg');"
    aria-hidden="true"
  ></div>

  <!-- Dark Atmospheric Shade Overlay -->
  <div class="isavo-footer-shade" aria-hidden="true"></div>

  <div class="isavo-footer-container">
    <div class="isavo-footer-wrap">
      <!-- Col 1: Logo Box, Tagline, & Physical Address -->
      <div class="isavo-footer-col isavo-col-brand">
        <div class="isavo-brand-header">
          <!-- Boxed Logo ala [ISAVO] -->
          <a href="/" class="isavo-boxed-logo" aria-label="Global Village Fund Beranda">
            <span class="isavo-boxed-text">GVF</span>
          </a>
        </div>

        <p class="isavo-footer-tagline">
          #WakafBerkelanjutan — Pendidikan · <br />
          Ibadah · Agro-Technopark
        </p>

        <p class="isavo-footer-address">
          Kampus SMK Skill Village Islamic School, <br />
          Desa Sukasirna, Kec. Jonggol, <br />
          Kabupaten Bogor, Jawa Barat 16830
        </p>
      </div>

      <!-- Col 2: Navigation Links 1 -->
      <div class="isavo-footer-col isavo-col-nav">
        <ul class="isavo-footer-nav-list">
          <li><a href="/" class="isavo-nav-item">Home</a></li>
          <li><a href="#pilar" class="isavo-nav-item">Layanan</a></li>
          <li><a href="#galeri" class="isavo-nav-item">Portofolio</a></li>
          <li><a href="#tentang-kami" class="isavo-nav-item">Tentang Kami</a></li>
        </ul>
      </div>

      <!-- Col 3: Navigation Links 2 -->
      <div class="isavo-footer-col isavo-col-nav">
        <ul class="isavo-footer-nav-list">
          <li><a href="#galeri" class="isavo-nav-item">Galeri</a></li>
          <li><a href="/contact" class="isavo-nav-item">Kontak</a></li>
          <li><a href="#simulasi" class="isavo-nav-item">Simulasi</a></li>
          <li><a href="#pengurus" class="isavo-nav-item">Pengurus</a></li>
        </ul>
      </div>

      <!-- Col 4: Large Contacts & Social Links -->
      <div class="isavo-footer-col isavo-col-contact">
        <div class="isavo-contact-group">
          <a class="isavo-big-number" href="tel:+6281226832326">
            +62 812 2683 2326
          </a>
          <a class="isavo-big-mail" href="https://globalvillagefund.org">
            www.globalvillagefund.org
          </a>
          <div class="isavo-social-row">
            <a
              href="https://instagram.com/globalvillagefund"
              target="_blank"
              rel="noopener noreferrer"
              class="isavo-social-link"
            >Instagram</a>
            <span class="isavo-social-sep">-</span>
            <a
              href="https://wa.me/6281226832326"
              target="_blank"
              rel="noopener noreferrer"
              class="isavo-social-link"
            >WhatsApp</a>
            <span class="isavo-social-sep">-</span>
            <a
              href="https://youtube.com"
              target="_blank"
              rel="noopener noreferrer"
              class="isavo-social-link"
            >YouTube</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Centered Copyright Line -->
    <div class="isavo-copyright-area">
      <p class="isavo-copyright-text">
        &copy; {new Date().getFullYear()} GLOBAL VILLAGE FUND • YAYASAN PERMATA CENDEKIA INDONESIA. All Rights Reserved.
      </p>
    </div>
  </div>

  <!-- Giant Faint Bottom Text Watermark ala ISAVO [isavo] -->
  <div class="isavo-giant-watermark" aria-hidden="true">
    <span>gvf</span>
  </div>
</footer>

<style is:global>
  /* ==========================================================================
     ISAVO FOOTER BULLETPROOF EXACT STYLING
     ========================================================================== */
  .isavo-footer-section {
    position: relative !important;
    padding-top: 100px !important;
    padding-bottom: 40px !important;
    color: #ffffff !important;
    background-color: #0b1120 !important;
    overflow: hidden !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }

  /* Architectural Interior Image Backdrop */
  .isavo-footer-bg {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    background-size: cover !important;
    background-position: center !important;
    background-repeat: no-repeat !important;
    filter: brightness(0.6) contrast(1.1) !important;
    z-index: 1 !important;
    pointer-events: none !important;
  }

  /* Dark Atmospheric Shade Overlay */
  .isavo-footer-shade {
    position: absolute !important;
    inset: 0 !important;
    background: linear-gradient(
      180deg,
      rgba(10, 15, 29, 0.88) 0%,
      rgba(9, 14, 26, 0.93) 40%,
      rgba(7, 11, 22, 0.97) 100%
    ) !important;
    z-index: 2 !important;
    backdrop-filter: blur(2px) !important;
    pointer-events: none !important;
  }

  .isavo-footer-container {
    position: relative !important;
    z-index: 3 !important;
    max-width: 1360px !important;
    margin: 0 auto !important;
    padding: 0 2.5rem !important;
    box-sizing: border-box !important;
  }

  /* 4-Column Grid */
  .isavo-footer-wrap {
    display: grid !important;
    grid-template-columns: 1.4fr 0.9fr 0.9fr 1.6fr !important;
    gap: 3.5rem !important;
    padding-bottom: 50px !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12) !important;
    align-items: flex-start !important;
  }

  /* Col 1: Brand & Address */
  .isavo-brand-header {
    margin-bottom: 1.5rem !important;
  }

  .isavo-boxed-logo {
    display: inline-block !important;
    border: 2px solid rgba(255, 255, 255, 0.85) !important;
    border-radius: 10px !important;
    padding: 6px 18px !important;
    text-decoration: none !important;
    transition: all 0.25s ease !important;
  }

  .isavo-boxed-logo:hover {
    border-color: #0969da !important;
    background-color: rgba(9, 105, 218, 0.2) !important;
  }

  .isavo-boxed-text {
    font-size: 1.35rem !important;
    font-weight: 900 !important;
    letter-spacing: 0.08em !important;
    color: #ffffff !important;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif !important;
  }

  .isavo-footer-tagline {
    font-size: 0.92rem !important;
    font-weight: 700 !important;
    line-height: 1.55 !important;
    color: #ffffff !important;
    margin: 0 0 1.25rem 0 !important;
    letter-spacing: -0.01em !important;
    font-family: 'Golos Text', sans-serif !important;
  }

  .isavo-footer-address {
    font-size: 0.88rem !important;
    line-height: 1.65 !important;
    color: #94a3b8 !important;
    margin: 0 !important;
    font-family: 'Golos Text', sans-serif !important;
  }

  /* Col 2 & 3: Navigation Links */
  .isavo-footer-nav-list {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 1.15rem !important;
  }

  .isavo-nav-item {
    font-size: 0.98rem !important;
    font-weight: 700 !important;
    color: #ffffff !important;
    text-decoration: none !important;
    letter-spacing: -0.01em !important;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif !important;
    transition: color 0.2s ease, transform 0.2s ease !important;
    display: inline-block !important;
  }

  .isavo-nav-item:hover {
    color: #38bdf8 !important;
    transform: translateX(4px) !important;
  }

  /* Col 4: Contacts & Socials */
  .isavo-contact-group {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-end !important;
    text-align: right !important;
  }

  .isavo-big-number {
    font-size: clamp(1.4rem, 2.2vw, 2.1rem) !important;
    font-weight: 900 !important;
    color: #ffffff !important;
    text-decoration: none !important;
    letter-spacing: -0.02em !important;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif !important;
    margin-bottom: 0.35rem !important;
    line-height: 1.2 !important;
    transition: color 0.2s ease !important;
  }

  .isavo-big-number:hover {
    color: #38bdf8 !important;
  }

  .isavo-big-mail {
    font-size: clamp(1.15rem, 1.7vw, 1.6rem) !important;
    font-weight: 800 !important;
    color: #ffffff !important;
    text-decoration: none !important;
    letter-spacing: -0.02em !important;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif !important;
    margin-bottom: 1.75rem !important;
    line-height: 1.2 !important;
    transition: color 0.2s ease !important;
  }

  .isavo-big-mail:hover {
    color: #38bdf8 !important;
  }

  .isavo-social-row {
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.75rem !important;
  }

  .isavo-social-link {
    font-size: 0.9rem !important;
    font-weight: 700 !important;
    color: #cbd5e1 !important;
    text-decoration: none !important;
    transition: color 0.2s ease !important;
    font-family: 'Golos Text', sans-serif !important;
  }

  .isavo-social-link:hover {
    color: #ffffff !important;
  }

  .isavo-social-sep {
    color: #64748b !important;
    font-size: 0.9rem !important;
  }

  /* Centered Copyright */
  .isavo-copyright-area {
    padding-top: 32px !important;
    padding-bottom: 70px !important;
    text-align: center !important;
  }

  .isavo-copyright-text {
    font-size: 0.85rem !important;
    color: #94a3b8 !important;
    margin: 0 !important;
    letter-spacing: 0.01em !important;
    font-family: 'Golos Text', sans-serif !important;
  }

  /* Giant Faint Bottom Text Watermark ala ISAVO [isavo] */
  .isavo-giant-watermark {
    position: absolute !important;
    bottom: -35px !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
    pointer-events: none !important;
    user-select: none !important;
    z-index: 2 !important;
    width: 100% !important;
    text-align: center !important;
    white-space: nowrap !important;
  }

  .isavo-giant-watermark span {
    font-size: clamp(7.5rem, 21vw, 20rem) !important;
    font-weight: 900 !important;
    color: rgba(255, 255, 255, 0.045) !important;
    letter-spacing: -0.05em !important;
    line-height: 0.8 !important;
    display: inline-block !important;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif !important;
  }

  @media (max-width: 1024px) {
    .isavo-footer-wrap {
      grid-template-columns: 1fr 1fr !important;
      gap: 2.5rem !important;
    }

    .isavo-contact-group {
      align-items: flex-start !important;
      text-align: left !important;
    }
  }

  @media (max-width: 640px) {
    .isavo-footer-section {
      padding-top: 60px !important;
    }

    .isavo-footer-wrap {
      grid-template-columns: 1fr !important;
      gap: 2rem !important;
      padding-bottom: 40px !important;
    }

    .isavo-contact-group {
      align-items: flex-start !important;
      text-align: left !important;
    }

    .isavo-big-number {
      font-size: 1.45rem !important;
    }

    .isavo-big-mail {
      font-size: 1.2rem !important;
      margin-bottom: 1.25rem !important;
    }

    .isavo-copyright-area {
      padding-bottom: 50px !important;
    }
  }
</style>
