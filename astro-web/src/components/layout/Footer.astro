---
// src/components/layout/Footer.astro
// Exact ISAVO Footer UI/UX Design: Moody Interior Backdrop, 4-Col Grid, Large Contacts, & Giant "gvf" Watermark
---

<footer class="isavo-footer-section overflow-hidden">
  <!-- Architectural Interior Backdrop Image ala ISAVO -->
  <div
    class="isavo-footer-bg"
    style="background-image: url('/gambar design/interior masjid.jpg');"
    aria-hidden="true"
  ></div>

  <!-- Dark Atmospheric Shade Overlay -->
  <div class="isavo-footer-shade" aria-hidden="true"></div>

  <div class="isavo-footer-container">
    <div class="isavo-footer-wrap">
      <!-- Col 1: Logo Box, Tagline, & Physical Address -->
      <div class="isavo-footer-col isavo-col-brand">
        <div class="isavo-footer-widget">
          <div class="isavo-brand-header">
            <!-- Boxed Logo ala [ISAVO] -->
            <a href="/" class="isavo-boxed-logo" aria-label="Global Village Fund Beranda">
              <span class="isavo-boxed-text">GVF</span>
            </a>
          </div>

          <p class="isavo-footer-tagline">
            #WakafBerkelanjutan — Pendidikan · <br />
            Ibadah · Agro-Technopark
          </p>

          <p class="isavo-footer-address">
            Kampus SMK Skill Village Islamic School, <br />
            Desa Sukasirna, Kec. Jonggol, <br />
            Kabupaten Bogor, Jawa Barat 16830
          </p>
        </div>
      </div>

      <!-- Col 2: Navigation Links 1 -->
      <div class="isavo-footer-col isavo-col-nav">
        <div class="isavo-footer-widget">
          <ul class="isavo-footer-nav-list">
            <li><a href="/" class="isavo-nav-item">Home</a></li>
            <li><a href="#pilar" class="isavo-nav-item">Program</a></li>
            <li><a href="#galeri" class="isavo-nav-item">Portofolio</a></li>
            <li><a href="#tentang-kami" class="isavo-nav-item">Tentang Kami</a></li>
          </ul>
        </div>
      </div>

      <!-- Col 3: Navigation Links 2 -->
      <div class="isavo-footer-col isavo-col-nav">
        <div class="isavo-footer-widget">
          <ul class="isavo-footer-nav-list">
            <li><a href="#galeri" class="isavo-nav-item">Galeri</a></li>
            <li><a href="#pengurus" class="isavo-nav-item">Pengurus</a></li>
            <li><a href="#simulasi" class="isavo-nav-item">Simulasi</a></li>
            <li><a href="#rekening" class="isavo-nav-item">Kontak</a></li>
          </ul>
        </div>
      </div>

      <!-- Col 4: Large Contacts & Social Links -->
      <div class="isavo-footer-col isavo-col-contact">
        <div class="isavo-footer-widget">
          <div class="isavo-contact-group">
            <a class="isavo-big-number" href="tel:+6281226832326">
              +62 812 2683 2326
            </a>
            <a class="isavo-big-mail" href="https://globalvillagefund.org">
              www.globalvillagefund.org
            </a>
            <div class="isavo-social-row">
              <a
                href="https://instagram.com/globalvillagefund"
                target="_blank"
                rel="noopener noreferrer"
                class="isavo-social-link"
              >Instagram</a>
              <span class="isavo-social-sep">-</span>
              <a
                href="https://wa.me/6281226832326"
                target="_blank"
                rel="noopener noreferrer"
                class="isavo-social-link"
              >WhatsApp</a>
              <span class="isavo-social-sep">-</span>
              <a
                href="https://youtube.com"
                target="_blank"
                rel="noopener noreferrer"
                class="isavo-social-link"
              >YouTube</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Centered Copyright Line -->
    <div class="isavo-copyright-area">
      <p class="isavo-copyright-text">
        &copy; {new Date().getFullYear()} GLOBAL VILLAGE FUND • YAYASAN PERMATA CENDEKIA INDONESIA. All Rights Reserved.
      </p>
    </div>
  </div>

  <!-- Giant Faint Bottom Text Watermark ala ISAVO [isavo] -->
  <div class="isavo-giant-watermark" aria-hidden="true">
    <span>gvf</span>
  </div>
</footer>

<style>
  .isavo-footer-section {
    position: relative;
    padding-top: 100px;
    padding-bottom: 50px;
    color: #ffffff;
    background-color: #0b1120;
    overflow: hidden;
  }

  /* Architectural Interior Image Backdrop */
  .isavo-footer-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    filter: brightness(0.65) contrast(1.1);
    z-index: 0;
  }

  /* Dark Atmospheric Shade Overlay */
  .isavo-footer-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 15, 29, 0.88) 0%,
      rgba(9, 14, 26, 0.93) 40%,
      rgba(7, 11, 22, 0.97) 100%
    );
    z-index: 1;
    backdrop-filter: blur(2px);
  }

  .isavo-footer-container {
    position: relative;
    z-index: 2;
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 2.5rem;
  }

  /* 4-Column Grid */
  .isavo-footer-wrap {
    display: grid;
    grid-template-columns: 1.4fr 0.9fr 0.9fr 1.6fr;
    gap: 3.5rem;
    padding-bottom: 60px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    align-items: flex-start;
  }

  /* Col 1: Brand & Address */
  .isavo-boxed-logo {
    display: inline-block;
    border: 2px solid rgba(255, 255, 255, 0.85);
    border-radius: 10px;
    padding: 6px 16px;
    margin-bottom: 1.75rem;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .isavo-boxed-logo:hover {
    border-color: #0969da;
    background-color: rgba(9, 105, 218, 0.15);
  }

  .isavo-boxed-text {
    font-size: 1.35rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    color: #ffffff;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  .isavo-footer-tagline {
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.55;
    color: #ffffff;
    margin: 0 0 1.25rem 0;
    letter-spacing: -0.01em;
  }

  .isavo-footer-address {
    font-size: 0.88rem;
    line-height: 1.65;
    color: #94a3b8;
    margin: 0;
  }

  /* Col 2 & 3: Navigation Links */
  .isavo-footer-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .isavo-nav-item {
    font-size: 0.98rem;
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
    letter-spacing: -0.01em;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .isavo-nav-item:hover {
    color: #38bdf8;
    transform: translateX(4px);
  }

  /* Col 4: Contacts & Socials */
  .isavo-contact-group {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
  }

  .isavo-big-number {
    font-size: clamp(1.4rem, 2.2vw, 2.1rem);
    font-weight: 900;
    color: #ffffff;
    text-decoration: none;
    letter-spacing: -0.02em;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
    margin-bottom: 0.4rem;
    line-height: 1.2;
    transition: color 0.2s ease;
  }

  .isavo-big-number:hover {
    color: #38bdf8;
  }

  .isavo-big-mail {
    font-size: clamp(1.2rem, 1.8vw, 1.65rem);
    font-weight: 800;
    color: #ffffff;
    text-decoration: none;
    letter-spacing: -0.02em;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
    margin-bottom: 2rem;
    line-height: 1.2;
    transition: color 0.2s ease;
  }

  .isavo-big-mail:hover {
    color: #38bdf8;
  }

  .isavo-social-row {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .isavo-social-link {
    font-size: 0.9rem;
    font-weight: 700;
    color: #cbd5e1;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .isavo-social-link:hover {
    color: #ffffff;
  }

  .isavo-social-sep {
    color: #64748b;
    font-size: 0.9rem;
  }

  /* Centered Copyright */
  .isavo-copyright-area {
    padding-top: 36px;
    padding-bottom: 80px;
    text-align: center;
  }

  .isavo-copyright-text {
    font-size: 0.85rem;
    color: #94a3b8;
    margin: 0;
    letter-spacing: 0.01em;
  }

  /* Giant Faint Bottom Text Watermark ala ISAVO [isavo] */
  .isavo-giant-watermark {
    position: absolute;
    bottom: -35px;
    left: 50%;
    transform: translateX(-50%);
    pointer-events: none;
    user-select: none;
    z-index: 1;
    width: 100%;
    text-align: center;
    white-space: nowrap;
  }

  .isavo-giant-watermark span {
    font-size: clamp(7.5rem, 21vw, 20rem);
    font-weight: 900;
    color: rgba(255, 255, 255, 0.045);
    letter-spacing: -0.05em;
    line-height: 0.8;
    display: inline-block;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  @media (max-width: 1024px) {
    .isavo-footer-wrap {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }

    .isavo-contact-group {
      align-items: flex-start;
      text-align: left;
    }
  }

  @media (max-width: 640px) {
    .isavo-footer-section {
      padding-top: 60px;
    }

    .isavo-footer-wrap {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-bottom: 40px;
    }

    .isavo-contact-group {
      align-items: flex-start;
      text-align: left;
    }

    .isavo-big-number {
      font-size: 1.45rem;
    }

    .isavo-big-mail {
      font-size: 1.2rem;
      margin-bottom: 1.25rem;
    }

    .isavo-copyright-area {
      padding-bottom: 60px;
    }
  }
</style>
