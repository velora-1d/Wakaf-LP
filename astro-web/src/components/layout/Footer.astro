// Exact ISAVO Footer UI/UX Design (isavo.co.id)
// Exact CSS, 4-Col Center-Aligned Grid, Living Room Background, & 480px "isavo" Watermark
---

<footer class="footer-section overflow-hidden" id="tentang-kami">
  <div
    class="footer-bg"
    style="background-image: url('/gambar design/interior mesjid 2.jpg');"
    aria-hidden="true"
  ></div>

  <div class="footer-shade" aria-hidden="true"></div>

  <div class="container-2">
    <div class="footer-grid-wrap">
      <div class="footer-grid-col">
        <div class="footer-widget">
          <div class="widget-header">
            <div class="footer-logo">
              <a href="/" class="pen-boxed-logo" aria-label="Global Village Fund Beranda">
                <img src="/images/logo.png" alt="Global Village Fund" class="pen-footer-logo-img" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                <span class="pen-boxed-text" style="display:none;">GVF</span>
              </a>
            </div>
          </div>
          <p class="footer-slogan">
            #WakafProduktif — Pendidikan · Masjid · Agro-Technopark
          </p>
