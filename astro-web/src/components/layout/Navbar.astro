---
// src/components/layout/Navbar.astro
// GVF Header: Boxed Logo [GVF], Transparent overlay at top, Sticky animated on scroll (#121417), Phone Handset, Pill CTA, 4-Dots Circle Trigger
const currentPath = Astro.url.pathname;
---

<header class="gvf-header" id="main-header">
  <div class="gvf-header-inner">
    <!-- Brand Boxed Logo -->
    <a
      href="/"
      class="gvf-boxed-logo"
      aria-label="Global Village Fund Beranda"
    >
      <img
        src="/logo-gvf-3d.png"
        alt="Global Village Fund"
        class="gvf-logo-img"
      />
    </a>

    <!-- Desktop Navigation Menu (7 Menu Akhir) -->
    <nav class="gvf-nav-desktop" aria-label="Navigasi Utama">
      <ul class="gvf-nav-list">
        <li>
          <a
            href="/"
            class={`gvf-nav-link ${currentPath === "/" ? "active" : ""}`}
            >Beranda</a
          >
        </li>
        <li>
          <a
            href="/tentang-kami"
            class={`gvf-nav-link ${currentPath === "/tentang-kami" ? "active" : ""}`}
            >Tentang Kami</a
          >
        </li>
        <li>
          <a
            href="/program"
            class={`gvf-nav-link ${currentPath.startsWith("/program") ? "active" : ""}`}
            >Program</a
          >
        </li>
        <li>
          <a
            href="/kontribusi"
            class={`gvf-nav-link ${currentPath.startsWith("/kontribusi") ? "active" : ""}`}
            >Bentuk Kontribusi</a
          >
        </li>
        {false && (
          <li>
            <a
              href="/edukasi"
              class={`gvf-nav-link ${currentPath.startsWith("/edukasi") ? "active" : ""}`}
              >Edukasi &amp; Kajian</a
            >
          </li>
        )}
        <li>
          <a
            href="/kabar"
            class={`gvf-nav-link ${currentPath.startsWith("/kabar") ? "active" : ""}`}
            >Kabar &amp; Laporan</a
          >
        </li>
        {false && (
          <li>
            <a
              href="/kemitraan"
              class={`gvf-nav-link ${currentPath === "/kemitraan" ? "active" : ""}`}
              >Kemitraan</a
            >
          </li>
        )}
      </ul>
    </nav>

    <div class="gvf-header-right">
      <a href="tel:+6281226832326" class="gvf-phone-widget">
        <svg
          class="phone-handset-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
          ></path>
        </svg>
        <div class="phone-info">
          <span class="phone-label">Call Us Phone</span>
          <span class="phone-val">0812-2683-2326</span>
        </div>
      </a>

      <a
        href={currentPath === "/" ? "#program-kebaikan" : "/kontribusi/wakaf"}
        class="gvf-header-pill-btn"
        aria-label="Salurkan Donasi"
      >
        <svg class="pill-calc-icon" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
          ></path>
        </svg>
        <span>Salurkan Donasi</span>
      </a>

      <a
        href={currentPath === "/" ? "#program-kebaikan" : "/#program-kebaikan"}
        class="gvf-circle-dots-btn"
        aria-label="Lihat Program Kebaikan"
      >
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="dot"></span>
      </a>

      <button
        type="button"
        class="gvf-mobile-toggle"
        id="gvf-toggle"
        aria-label="Buka Menu Navigasi"
        aria-expanded="false"
        aria-controls="gvf-drawer"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div
    class="gvf-drawer"
    id="gvf-drawer"
    role="dialog"
    aria-modal="true"
    aria-label="Menu Navigasi Mobile"
  >
    <div class="gvf-drawer-panel">
      <div class="gvf-drawer-top">
        <div class="gvf-boxed-logo">
          <img
            src="/logo-gvf-3d.png"
            alt="Global Village Fund"
            class="gvf-logo-img"
          />
        </div>
        <button
          type="button"
          class="gvf-drawer-close"
          id="gvf-close"
          aria-label="Tutup Menu Navigasi">&times;</button
        >
      </div>
      <nav class="gvf-drawer-nav">
        <a href="/">Beranda</a>
        <a href="/tentang-kami">Tentang Kami</a>
        <details class="gvf-drawer-group" open>
          <summary>Program</summary>
          <div class="gvf-drawer-sublinks">
            <a href="/program/pembangunan-masjid">Pembangunan Masjid</a>
            <a href="/program/gota-ssm">GOTA SSM</a>
          </div>
        </details>
        <details class="gvf-drawer-group" open>
          <summary>Bentuk Kontribusi</summary>
          <div class="gvf-drawer-sublinks">
            <a href="/kontribusi/infaq">Infak (Material Masjid)</a>
            <a href="/kontribusi/sedekah">Sedekah (Dukungan GOTA SSM)</a>
            <a href="/kontribusi/zakat">Zakat (Ramadan &amp; Idulfitri)</a>
            <a href="/kontribusi/wakaf">Wakaf (Objek &amp; Peruntukan)</a>
          </div>
        </details>
        {false && <a href="/edukasi">Edukasi &amp; Kajian</a>}
        <a href="/kabar">Kabar &amp; Laporan</a>
        {false && <a href="/kemitraan">Kemitraan</a>}
        <a href="/donatur" class="drawer-donatur-link">Daftar Donatur</a>
        <a href="/contact">Kontak</a>
      </nav>
      <div class="gvf-drawer-bottom">
        <a
          href={currentPath === "/" ? "#program-kebaikan" : "/kontribusi/wakaf"}
          class="gvf-header-pill-btn"
          style="width: 100%; justify-content: center;"
        >
          Salurkan Donasi
        </a>
      </div>
    </div>
  </div>
  <nav class="gvf-bottom-tabbar" aria-label="Navigasi Cepat Mobile">
    <a href="/" class={`gvf-tab-item ${currentPath === "/" ? "is-active" : ""}`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8" />
        <path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
      </svg>
      <span>Beranda</span>
    </a>

    <a href="/program" class={`gvf-tab-item ${currentPath.startsWith("/program") ? "is-active" : ""}`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z" />
        <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65" />
        <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65" />
      </svg>
      <span>Program</span>
    </a>

    <a
      href={currentPath === "/" ? "#program-kebaikan" : "/kontribusi"}
      class={`gvf-tab-item gvf-tab-primary ${currentPath.startsWith("/kontribusi") ? "is-active" : ""}`}
    >
      <span class="gvf-tab-primary-icon">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
        </svg>
      </span>
      <span>Kontribusi</span>
    </a>

    <a href="/kabar" class={`gvf-tab-item ${currentPath.startsWith("/kabar") ? "is-active" : ""}`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2" />
        <path d="M18 14h-8" />
        <path d="M15 18h-5" />
        <path d="M10 6h8v4h-8V6Z" />
      </svg>
      <span>Kabar</span>
    </a>

    <button
      type="button"
      class="gvf-tab-item"
      id="gvf-bottom-more"
      aria-label="Buka Menu Lainnya"
      aria-expanded="false"
      aria-controls="gvf-drawer"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect width="7" height="7" x="3" y="3" rx="1" />
        <rect width="7" height="7" x="14" y="3" rx="1" />
        <rect width="7" height="7" x="14" y="14" rx="1" />
        <rect width="7" height="7" x="3" y="14" rx="1" />
      </svg>
      <span>Lainnya</span>
    </button>
  </nav>
</header>

<style>
  /* Header Container: Floating Pill Overlay di puncak, Solid Charcoal Pill saat scroll */
  .gvf-header {
    position: fixed;
    top: 14px;
    left: 0;
    right: 0;
    width: 100%;
    padding-inline: 16px;
    z-index: 999;
    pointer-events: none;
  }

  .gvf-header-inner {
    pointer-events: auto;
    width: 100%;
    max-width: 1360px;
    margin: 0 auto;
    padding: 8px 14px 8px 16px;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(12, 18, 30, 0.55);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.22);
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .gvf-header.fixed .gvf-header-inner {
    background: rgba(15, 23, 42, 0.92);
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.38);
  }

  /* 1. Brand Logo */
  .gvf-boxed-logo {
    border: none;
    border-radius: 9999px;
    padding: 2px 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: background-color 0.25s ease, transform 0.25s ease;
  }

  .gvf-header-inner .gvf-boxed-logo {
    margin-left: 0;
  }

  .gvf-logo-img {
    height: 38px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.4));
  }

  .gvf-boxed-logo span {
    font-family: "Golos Text", "Plus Jakarta Sans", sans-serif;
    font-size: 20px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.12em;
    line-height: 1;
  }

  .gvf-boxed-logo:hover {
    background-color: rgba(255, 255, 255, 0.15);
  }

  /* 2. Desktop Nav */
  .gvf-nav-desktop {
    display: flex;
    align-items: center;
  }

  .gvf-nav-list {
    display: flex;
    align-items: center;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .gvf-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 7px 15px;
    border-radius: 9999px;
    color: rgba(255, 255, 255, 0.86);
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .gvf-nav-link:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.08);
  }

  .gvf-nav-link.active {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.16);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.18);
  }

  .gvf-chevron {
    width: 11px;
    height: 11px;
    margin-left: 2px;
    transition: transform 0.2s ease;
  }

  .gvf-has-dropdown {
    position: relative;
  }

  .gvf-has-dropdown:hover .gvf-chevron {
    transform: rotate(180deg);
  }

  /* Dropdown Menu White Card */
  .gvf-dropdown-menu {
    position: absolute;
    top: calc(100% + 14px);
    left: 0;
    min-width: 240px;
    background: #ffffff;
    border-radius: 16px;
    padding: 10px 0;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.18);
    opacity: 0;
    visibility: hidden;
    transform: rotateX(-20deg) translateY(8px);
    transform-origin: top;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    list-style: none;
    margin: 0;
    z-index: 1000;
  }

  .gvf-has-dropdown:hover .gvf-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: rotateX(0deg) translateY(0);
  }

  .gvf-dropdown-menu li a {
    color: #0f172a;
    padding: 9px 22px;
    font-family: "Golos Text", "Plus Jakarta Sans", sans-serif;
    font-size: 14px;
    font-weight: 500;
    display: block;
    text-decoration: none;
    transition:
      color 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .gvf-dropdown-menu li a:hover {
    color: #0969da;
    background: #eff6ff;
  }

  .dropdown-sep-row {
    border-top: 1px solid #f1f5f9;
    margin-top: 6px;
    padding-top: 6px;
  }

  .link-highlight-donatur {
    color: #0969da !important;
    font-weight: 600 !important;
  }

  .drawer-donatur-link {
    color: #0969da !important;
    font-weight: 700 !important;
  }

  /* 3. Right Header Actions */
  .gvf-header-right {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-right: 0;
  }

  /* Call Us Phone Widget (Icon Handset Polos + Teks 2 Baris) */
  .gvf-phone-widget {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: #ffffff;
  }

  .phone-handset-icon {
    width: 24px;
    height: 24px;
    color: #ffffff;
    flex-shrink: 0;
    transform: rotate(-10deg);
  }

  .phone-info {
    display: flex;
    flex-direction: column;
  }

  .phone-label {
    font-family: var(--font-sans);
    font-size: 11px;
    color: #cbd5e1;
    font-weight: 500;
    line-height: 1.2;
  }

  .phone-val {
    font-family: "Golos Text", "Plus Jakarta Sans", sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  /* 4. Pill Button CTA ("Salurkan Donasi" Royal Blue Signature Pen.dev GVF) */
  .gvf-header-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #0969da;
    color: #ffffff;
    text-decoration: none;
    border-radius: 9999px;
    padding: 11px 22px;
    font-family: "Golos Text", "Plus Jakarta Sans", sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.01em;
    transition:
      transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
    box-shadow: 0 4px 16px rgba(9, 105, 218, 0.35);
  }

  .gvf-header-pill-btn:hover {
    background: #0752a8;
    transform: translateY(-2px);
    box-shadow: 0 6px 22px rgba(9, 105, 218, 0.5);
  }

  .gvf-header-pill-btn:active {
    transform: scale(0.97);
  }

  .pill-calc-icon {
    width: 16px;
    height: 16px;
  }

  .pill-chevron-icon {
    width: 13px;
    height: 13px;
  }

  /* 5. Circle Button dengan 4 ROUND DOTS (2x2 Grid) */
  .gvf-circle-dots-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.16);
    display: grid;
    grid-template-columns: repeat(2, 4px);
    grid-gap: 5px;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition:
      transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
    cursor: pointer;
    flex-shrink: 0;
  }

  .gvf-circle-dots-btn .dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: #ffffff;
    display: block;
    transition: transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .gvf-circle-dots-btn:hover {
    background-color: #0969da;
    border-color: #0969da;
    transform: rotate(90deg);
  }

  .gvf-circle-dots-btn:active {
    transform: rotate(90deg) scale(0.94);
  }

  /* Mobile Hamburger Toggle */
  .gvf-mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 9999px;
    padding: 10px;
    cursor: pointer;
  }

  .gvf-mobile-toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background: #ffffff;
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease, background-color 0.25s ease;
  }

  /* Mobile Drawer */
  .gvf-drawer {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .gvf-drawer.open {
    opacity: 1;
    pointer-events: auto;
  }

  .gvf-drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: 85%;
    max-width: 360px;
    height: 100%;
    background: #111827;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gvf-drawer.open .gvf-drawer-panel {
    transform: translateX(0);
  }

  .gvf-drawer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .gvf-drawer-close {
    background: none;
    border: none;
    color: #ffffff;
    font-size: 2rem;
    cursor: pointer;
    line-height: 1;
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gvf-drawer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .gvf-drawer-nav a {
    color: #ffffff;
    text-decoration: none;
    font-size: 1.1rem;
    font-weight: 600;
    min-height: 44px;
    display: flex;
    align-items: center;
    transition: color 0.2s ease;
  }

  .gvf-drawer-nav a:hover {
    color: #38bdf8;
  }

  .gvf-drawer-group {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.25rem 0;
  }

  .gvf-drawer-group summary {
    list-style: none;
    color: #93c5fd;
    font-size: 0.95rem;
    font-weight: 700;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
  }

  .gvf-drawer-sublinks {
    display: flex;
    flex-direction: column;
    padding-left: 1rem;
    padding-bottom: 0.35rem;
  }

  .gvf-drawer-sublinks a {
    font-size: 0.98rem;
    font-weight: 500;
    color: #e2e8f0;
  }

  .gvf-drawer-bottom {
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 1220px) {
    .gvf-nav-desktop,
    .gvf-phone-widget {
      display: none;
    }
    .gvf-mobile-toggle,
    .gvf-drawer {
      display: flex;
    }
    .gvf-header {
      top: 10px;
      padding-inline: 12px;
    }
    .gvf-header-inner {
      padding: 8px 12px;
    }
    .gvf-header-inner .gvf-boxed-logo {
      margin-left: 0;
    }
    .gvf-header-right {
      margin-right: 0;
    }
  }

  /* Mobile 5-Tab Bottom Bar */
  .gvf-bottom-tabbar {
    display: none;
  }

  @media (max-width: 768px) {
    .gvf-mobile-toggle {
      display: none;
    }

    .gvf-bottom-tabbar {
      position: fixed;
      bottom: calc(10px + env(safe-area-inset-bottom, 0px));
      left: 12px;
      right: 12px;
      z-index: 998;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      align-items: center;
      gap: 2px;
      padding: 6px 8px;
      border-radius: 9999px;
      background: rgba(15, 23, 42, 0.94);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.14);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.36);
      pointer-events: auto;
    }

    .gvf-tab-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      min-height: 48px;
      padding: 4px 2px;
      color: #cbd5e1;
      text-decoration: none;
      background: transparent;
      border: none;
