---
// src/components/layout/Navbar.astro
// Exact ISAVO Header: Dark Bar, Boxed Logo, Call Info, Pill Button, Grid Icon
const currentPath = Astro.url.pathname;
---

<header class="isavo-header" id="main-header">
  <div class="isavo-header-inner">
    <!-- Brand Box Logo ala ISAVO [ISAVO] -->
    <a href="/" class="isavo-brand-box" aria-label="Global Village Fund Beranda">
      <span class="isavo-brand-text">GVF</span>
    </a>

    <!-- Desktop Navigation Menu -->
    <nav class="isavo-nav-desktop" aria-label="Navigasi Utama">
      <ul class="isavo-nav-list">
        <li><a href="/" class={`isavo-nav-link ${currentPath === '/' ? 'active' : ''}`}>Home</a></li>
        <li class="isavo-has-dropdown">
          <a href="/#pilar" class="isavo-nav-link">
            <span>Program</span>
            <svg class="isavo-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>
          <ul class="isavo-dropdown-menu">
            <li><a href="/#pilar">Masjid Khairu Ummah</a></li>
            <li><a href="/#pilar">Skill Village Islamic School</a></li>
            <li><a href="/#pilar">Green Waqf Agro-Technopark</a></li>
          </ul>
        </li>
        <li><a href="/portofolio" class={`isavo-nav-link ${currentPath === '/portofolio' ? 'active' : ''}`}>Portofolio</a></li>
        <li><a href="/#tentang-kami" class="isavo-nav-link">Tentang Kami</a></li>
        <li><a href="/#dokumentasi" class="isavo-nav-link">Galeri</a></li>
        <li class="isavo-has-dropdown">
          <a href="/#simulasi" class="isavo-nav-link">
            <span>Simulasi</span>
            <svg class="isavo-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>
          <ul class="isavo-dropdown-menu">
            <li><a href="/#simulasi">Simulasi Wakaf Meter Lahan</a></li>
            <li><a href="/#simulasi">Simulasi Material Masjid</a></li>
            <li><a href="/#simulasi">Simulasi Wakaf Uang</a></li>
          </ul>
        </li>
        <li><a href="/contact" class={`isavo-nav-link ${currentPath === '/contact' ? 'active' : ''}`}>Kontak</a></li>
      </ul>
    </nav>

    <!-- Right Header Actions ala ISAVO -->
    <div class="isavo-header-right">
      <!-- Call Us Phone -->
      <a href="tel:+6281226832326" class="isavo-phone-widget">
        <svg class="isavo-phone-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <div class="isavo-phone-text">
          <span class="isavo-phone-label">Call Us Phone</span>
          <span class="isavo-phone-number">0812-2683-2326</span>
        </div>
      </a>

      <!-- Pill Button ala ISAVO (Blue accent instead of red) -->
      <a href="#simulasi" class="isavo-btn-pill-cta">
        <svg class="isavo-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <rect x="2" y="3" width="20" height="18" rx="2"></rect>
          <line x1="8" y1="7" x2="16" y2="7"></line>
          <line x1="8" y1="11" x2="16" y2="11"></line>
          <line x1="8" y1="15" x2="12" y2="15"></line>
        </svg>
        <span>Simulasi Wakaf</span>
        <svg class="isavo-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </a>

      <!-- 4-Dots Grid Icon Button ala ISAVO -->
      <a href="#rekening" class="isavo-grid-btn" aria-label="Menu Ekstra">
        <span class="isavo-dot"></span>
        <span class="isavo-dot"></span>
        <span class="isavo-dot"></span>
        <span class="isavo-dot"></span>
      </a>

      <!-- Mobile Hamburger Toggle -->
      <button type="button" class="isavo-mobile-toggle" id="isavo-toggle" aria-label="Buka Menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div class="isavo-drawer" id="isavo-drawer">
    <div class="isavo-drawer-panel">
      <div class="isavo-drawer-top">
        <div class="isavo-brand-box">
          <span class="isavo-brand-text">GVF</span>
        </div>
        <button type="button" class="isavo-drawer-close" id="isavo-close">&times;</button>
      </div>
      <nav class="isavo-drawer-nav">
        <a href="/">Home</a>
        <a href="/#pilar">Program Wakaf</a>
        <a href="/portofolio">Portofolio</a>
        <a href="/#tentang-kami">Tentang Kami</a>
        <a href="/#dokumentasi">Galeri</a>
        <a href="/#simulasi">Simulasi Wakaf</a>
        <a href="/contact">Kontak</a>
      </nav>
      <div class="isavo-drawer-bottom">
        <a href="#simulasi" class="isavo-btn-pill-cta" style="width: 100%; justify-content: center;">
          Simulasi Wakaf
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .isavo-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 999;
    background: rgba(18, 20, 24, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 1rem 2.5rem;
    transition: all 0.3s ease;
  }

  .isavo-header-inner {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Logo Kotak Persegi Panjang ala [ISAVO] */
  .isavo-brand-box {
    border: 2px solid #ffffff;
    border-radius: 8px;
    padding: 0.35rem 1.15rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .isavo-brand-box:hover {
    background-color: rgba(255, 255, 255, 0.15);
  }

  .isavo-brand-text {
    font-size: 1.5rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.12em;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  /* Desktop Nav */
  .isavo-nav-desktop {
    display: flex;
    align-items: center;
  }

  .isavo-nav-list {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .isavo-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .isavo-nav-link:hover,
  .isavo-nav-link.active {
    color: #0969da; /* Blue accent instead of red */
  }

  .isavo-chevron {
    width: 12px;
    height: 12px;
  }

  /* Dropdown */
  .isavo-has-dropdown {
    position: relative;
  }

  .isavo-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    background: #1c1c1c;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 0.5rem;
    list-style: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: all 0.2s ease;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
  }

  .isavo-has-dropdown:hover .isavo-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .isavo-dropdown-menu li a {
    display: block;
    padding: 0.6rem 0.85rem;
    color: #e2e8f0;
    text-decoration: none;
    font-size: 0.875rem;
    border-radius: 8px;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .isavo-dropdown-menu li a:hover {
    background: rgba(9, 105, 218, 0.2);
    color: #38bdf8;
  }

  /* Right Action Widgets */
  .isavo-header-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .isavo-phone-widget {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: #ffffff;
  }

  .isavo-phone-icon {
    width: 20px;
    height: 20px;
    color: #ffffff;
  }

  .isavo-phone-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .isavo-phone-label {
    font-size: 0.6875rem;
    color: #94a3b8;
    text-transform: capitalize;
  }

  .isavo-phone-number {
    font-size: 0.9375rem;
    font-weight: 700;
    color: #ffffff;
    font-family: monospace;
  }

  /* Pill Button ala ISAVO [Simulasi Biaya ⌵] */
  .isavo-btn-pill-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #0969da; /* Blue vibrant */
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.75rem 1.6rem;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 15px rgba(9, 105, 218, 0.35);
  }

  .isavo-btn-pill-cta:hover {
    background-color: #0052cc;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(9, 105, 218, 0.5);
  }

  .isavo-btn-icon {
    width: 15px;
    height: 15px;
  }

  /* 4-Dots Grid Icon [ :: ] */
  .isavo-grid-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    display: grid;
    grid-template-columns: repeat(2, 6px);
    gap: 4px;
    align-content: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .isavo-grid-btn:hover {
    background-color: rgba(255, 255, 255, 0.3);
    transform: scale(1.05);
  }

  .isavo-dot {
    width: 5px;
    height: 5px;
    background-color: #ffffff;
    border-radius: 1px;
  }

  /* Mobile Toggle */
  .isavo-mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 6px;
  }

  .isavo-mobile-toggle span {
    width: 24px;
    height: 2px;
    background-color: #ffffff;
    border-radius: 2px;
  }

  /* Mobile Drawer */
  .isavo-drawer {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(6px);
    z-index: 200;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .isavo-drawer.open {
    opacity: 1;
    pointer-events: auto;
  }

  .isavo-drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: 80%;
    max-width: 320px;
    height: 100%;
    background: #161616;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.3s ease;
  }

  .isavo-drawer.open .isavo-drawer-panel {
    transform: translateX(0);
  }

  .isavo-drawer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .isavo-drawer-close {
    background: none;
    border: none;
    color: #ffffff;
    font-size: 2rem;
    cursor: pointer;
    line-height: 1;
  }

  .isavo-drawer-nav {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    flex: 1;
  }

  .isavo-drawer-nav a {
    color: #ffffff;
    text-decoration: none;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .isavo-drawer-nav a:hover {
    color: #0969da;
  }

  .isavo-drawer-bottom {
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 1100px) {
    .isavo-nav-desktop,
    .isavo-phone-widget {
      display: none;
    }
    .isavo-mobile-toggle,
    .isavo-drawer {
      display: flex;
    }
    .isavo-header {
      padding: 1rem 1.5rem;
    }
  }
</style>

<script>
  const toggle = document.getElementById('isavo-toggle');
  const close = document.getElementById('isavo-close');
  const drawer = document.getElementById('isavo-drawer');

  if (toggle && close && drawer) {
    toggle.addEventListener('click', () => drawer.classList.add('open'));
    close.addEventListener('click', () => drawer.classList.remove('open'));
    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) drawer.classList.remove('open');
    });
    drawer.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => drawer.classList.remove('open'));
    });
  }
</script>
