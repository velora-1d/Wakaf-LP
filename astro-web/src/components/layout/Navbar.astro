---
// src/components/layout/Navbar.astro
// Exact ISAVO Header: Transparent overlay at rest, Sticky on scroll (#191919), Glassmorphism circle trigger, White animated dropdown
const currentPath = Astro.url.pathname;
---

<header class="isavo-header" id="main-header">
  <div class="isavo-header-inner">
    <!-- Brand Logo ala ISAVO (Clean typography without bulky box border) -->
    <a href="/" class="isavo-brand" aria-label="Global Village Fund Beranda">
      <span class="isavo-brand-text">GVF</span>
      <span class="isavo-brand-tag">ZISWAF</span>
    </a>

    <!-- Desktop Navigation Menu -->
    <nav class="isavo-nav-desktop" aria-label="Navigasi Utama">
      <ul class="isavo-nav-list">
        <li><a href="/" class={`isavo-nav-link ${currentPath === '/' ? 'active' : ''}`}>Home</a></li>
        <li class="isavo-has-dropdown">
          <a href="/program/wakaf" class={`isavo-nav-link ${currentPath.startsWith('/program') ? 'active' : ''}`}>
            <span>Program</span>
            <svg class="isavo-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>
          <ul class="isavo-dropdown-menu">
            <li><a href="/program/wakaf">Wakaf Produktif & Lahan</a></li>
            <li><a href="/program/zakat">Zakat Maal & Profesi</a></li>
            <li><a href="/program/infaq">Infaq Pembangunan</a></li>
            <li><a href="/program/sedekah">Sedekah Subuh & Pangan</a></li>
          </ul>
        </li>
        <li><a href="/portofolio" class={`isavo-nav-link ${currentPath === '/portofolio' ? 'active' : ''}`}>Portofolio</a></li>
        <li><a href="/#tentang-kami" class="isavo-nav-link">Tentang Kami</a></li>
        <li><a href="/#dokumentasi" class="isavo-nav-link">Galeri</a></li>
        <li class="isavo-has-dropdown">
          <a href="/#simulasi" class="isavo-nav-link">
            <span>Simulasi</span>
            <svg class="isavo-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>
          <ul class="isavo-dropdown-menu">
            <li><a href="/#simulasi">Simulasi Wakaf Meter Lahan</a></li>
            <li><a href="/#simulasi">Simulasi Material Masjid</a></li>
            <li><a href="/#simulasi">Simulasi Wakaf Uang</a></li>
          </ul>
        </li>
        <li><a href="/contact" class={`isavo-nav-link ${currentPath === '/contact' ? 'active' : ''}`}>Kontak</a></li>
      </ul>
    </nav>

    <!-- Right Header Actions ala ISAVO -->
    <div class="isavo-header-right">
      <!-- Call Us Phone Widget -->
      <a href="tel:+6281226832326" class="isavo-phone-widget">
        <span class="isavo-phone-icon-circle">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </span>
        <div class="isavo-phone-text">
          <span class="isavo-phone-label">Call Us Phone</span>
          <span class="isavo-phone-number">0812-2683-2326</span>
        </div>
      </a>

      <!-- Pill Button CTA ("Simulasi Wakaf" ala ISAVO Simulasi Biaya) -->
      <a href="#simulasi" class="isavo-header-cta-btn">
        <svg class="cta-calc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="4" y="2" width="16" height="20" rx="2"></rect>
          <line x1="8" y1="6" x2="16" y2="6"></line>
          <line x1="16" y1="14" x2="16" y2="18"></line>
          <path d="M16 10h.01"></path>
          <path d="M12 10h.01"></path>
          <path d="M8 10h.01"></path>
          <path d="M12 14h.01"></path>
          <path d="M8 14h.01"></path>
          <path d="M12 18h.01"></path>
          <path d="M8 18h.01"></path>
        </svg>
        <span>Simulasi Wakaf</span>
        <svg class="cta-chevron-icon" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </a>

      <!-- Circle Glassmorphism Sidebar Icon Button ala ISAVO -->
      <a href="#rekening" class="isavo-sidebar-circle-btn" aria-label="Menu Ekstra">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="none">
          <rect x="0" y="0" width="6" height="6" rx="1.5" fill="currentColor"></rect>
          <rect x="10" y="0" width="6" height="6" rx="1.5" fill="currentColor"></rect>
          <rect x="0" y="10" width="6" height="6" rx="1.5" fill="currentColor"></rect>
          <rect x="10" y="10" width="6" height="6" rx="1.5" fill="currentColor"></rect>
        </svg>
      </a>

      <!-- Mobile Hamburger Toggle -->
      <button type="button" class="isavo-mobile-toggle" id="isavo-toggle" aria-label="Buka Menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div class="isavo-drawer" id="isavo-drawer">
    <div class="isavo-drawer-panel">
      <div class="isavo-drawer-top">
        <div class="isavo-brand">
          <span class="isavo-brand-text">GVF</span>
          <span class="isavo-brand-tag">ZISWAF</span>
        </div>
        <button type="button" class="isavo-drawer-close" id="isavo-close">&times;</button>
      </div>
      <nav class="isavo-drawer-nav">
        <a href="/">Home</a>
        <a href="/program/wakaf">Wakaf Produktif & Lahan</a>
        <a href="/program/zakat">Zakat Maal & Profesi</a>
        <a href="/program/infaq">Infaq Pembangunan</a>
        <a href="/program/sedekah">Sedekah Subuh & Pangan</a>
        <a href="/portofolio">Portofolio</a>
        <a href="/#tentang-kami">Tentang Kami</a>
        <a href="/#dokumentasi">Galeri</a>
        <a href="/#simulasi">Simulasi Wakaf</a>
        <a href="/contact">Kontak</a>
      </nav>
      <div class="isavo-drawer-bottom">
        <a href="#simulasi" class="isavo-header-cta-btn" style="width: 100%; justify-content: center;">
          Simulasi Wakaf
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* ISAVO Header: Transparent Overlay at Rest, Smooth Sticky on Scroll */
  @keyframes menuSticky {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(0);
    }
  }

  .isavo-header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 999;
    background-color: transparent;
    transition: background-color 0.3s ease, padding 0.3s ease, box-shadow 0.3s ease;
  }

  .isavo-header.fixed {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background-color: #191919;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    animation: menuSticky 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .isavo-header-inner {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 24px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: padding 0.3s ease;
  }

  .isavo-header.fixed .isavo-header-inner {
    padding: 14px 24px;
  }

  /* Brand Logo (Clean modern typography like ISAVO) */
  .isavo-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .isavo-brand-text {
    font-size: 1.85rem;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: 0.05em;
    line-height: 1;
  }

  .isavo-brand-tag {
    font-size: 0.65rem;
    font-weight: 800;
    background-color: #0284c7;
    color: #ffffff;
    padding: 3px 8px;
    border-radius: 9999px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Desktop Nav */
  .isavo-nav-desktop {
    display: flex;
    align-items: center;
  }

  .isavo-nav-list {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .isavo-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .isavo-nav-link:hover,
  .isavo-nav-link.active {
    color: #38bdf8;
  }

  .isavo-chevron {
    width: 12px;
    height: 12px;
    transition: transform 0.2s ease;
  }

  .isavo-has-dropdown {
    position: relative;
  }

  .isavo-has-dropdown:hover .isavo-chevron {
    transform: rotate(180deg);
  }

  /* Dropdown Menu White Card ala ISAVO */
  .isavo-dropdown-menu {
    position: absolute;
    top: calc(100% + 14px);
    left: 0;
    min-width: 240px;
    background: #ffffff;
    border-radius: 16px;
    padding: 10px 0;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.16);
    opacity: 0;
    visibility: hidden;
    transform: rotateX(-20deg) translateY(8px);
    transform-origin: top;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    list-style: none;
    margin: 0;
    z-index: 1000;
  }

  .isavo-has-dropdown:hover .isavo-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: rotateX(0deg) translateY(0);
  }

  .isavo-dropdown-menu li a {
    color: #0f172a;
    padding: 9px 22px;
    font-size: 0.88rem;
    font-weight: 500;
    display: block;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .isavo-dropdown-menu li a:hover {
    color: #0284c7;
    background: #f8fafc;
    padding-left: 26px;
  }

  /* Right Header Actions */
  .isavo-header-right {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  /* Phone Widget */
  .isavo-phone-widget {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .isavo-phone-icon-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .isavo-phone-widget:hover .isavo-phone-icon-circle {
    background: #0284c7;
    transform: scale(1.05);
  }

  .isavo-phone-icon-circle svg {
    width: 18px;
    height: 18px;
  }

  .isavo-phone-text {
    display: flex;
    flex-direction: column;
  }

  .isavo-phone-label {
    font-size: 0.68rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  .isavo-phone-number {
    font-size: 0.95rem;
    color: #ffffff;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  /* Header CTA Button (Simulasi Wakaf) */
  .isavo-header-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: #0284c7;
    color: #ffffff;
    text-decoration: none;
    border-radius: 100px;
    padding: 10px 20px;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    transition: all 0.3s ease;
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.35);
  }

  .isavo-header-cta-btn:hover {
    background-color: #0369a1;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(2, 132, 199, 0.45);
  }

  .cta-calc-icon {
    width: 16px;
    height: 16px;
  }

  .cta-chevron-icon {
    width: 14px;
    height: 14px;
  }

  /* Circle Glassmorphism Sidebar Icon Button ala ISAVO */
  .isavo-sidebar-circle-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(216, 218, 223, 0.13);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(29px);
    -webkit-backdrop-filter: blur(29px);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .isavo-sidebar-circle-btn:hover {
    background-color: #0284c7;
    border-color: #0284c7;
    transform: rotate(90deg);
  }

  /* Mobile Toggle */
  .isavo-mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    border-radius: 8px;
    padding: 8px;
    cursor: pointer;
  }

  .isavo-mobile-toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background: #ffffff;
    border-radius: 2px;
    transition: all 0.25s ease;
  }

  /* Mobile Drawer */
  .isavo-drawer {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .isavo-drawer.open {
    opacity: 1;
    pointer-events: auto;
  }

  .isavo-drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: 85%;
    max-width: 360px;
    height: 100%;
    background: #111827;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .isavo-drawer.open .isavo-drawer-panel {
    transform: translateX(0);
  }

  .isavo-drawer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .isavo-drawer-close {
    background: none;
    border: none;
    color: #ffffff;
    font-size: 2rem;
    cursor: pointer;
    line-height: 1;
  }

  .isavo-drawer-nav {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    flex: 1;
  }

  .isavo-drawer-nav a {
    color: #ffffff;
    text-decoration: none;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .isavo-drawer-nav a:hover {
    color: #38bdf8;
  }

  .isavo-drawer-bottom {
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 1100px) {
    .isavo-nav-desktop,
    .isavo-phone-widget {
      display: none;
    }
    .isavo-mobile-toggle,
    .isavo-drawer {
      display: flex;
    }
    .isavo-header-inner {
      padding: 16px 20px;
    }
  }
</style>

<script>
  // Dynamic Scroll Listener for Sticky State (Identik ISAVO .primary-header.fixed)
  const header = document.getElementById('main-header');

  const onScroll = () => {
    if (window.scrollY > 40) {
      header?.classList.add('fixed');
    } else {
      header?.classList.remove('fixed');
    }
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Mobile Drawer Toggle
  const toggle = document.getElementById('isavo-toggle');
  const close = document.getElementById('isavo-close');
  const drawer = document.getElementById('isavo-drawer');

  if (toggle && close && drawer) {
    toggle.addEventListener('click', () => drawer.classList.add('open'));
    close.addEventListener('click', () => drawer.classList.remove('open'));
    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) drawer.classList.remove('open');
    });
    drawer.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => drawer.classList.remove('open'));
    });
  }
</script>
