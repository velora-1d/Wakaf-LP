---
// src/components/layout/Navbar.astro
// GVF Header: Boxed Logo [GVF], Transparent overlay at top, Sticky animated on scroll (#121417), Phone Handset, Pill CTA, 4-Dots Circle Trigger
const currentPath = Astro.url.pathname;
---

<header class="gvf-header" id="main-header">
  <div class="gvf-header-inner">
    <!-- Brand Boxed Logo -->
    <a
      href="/"
      class="gvf-boxed-logo"
      aria-label="Global Village Fund Beranda"
    >
      <img
        src="/logo-gvf-3d.png"
        alt="Global Village Fund"
        class="gvf-logo-img"
      />
    </a>

    <!-- Desktop Navigation Menu -->
    <nav class="gvf-nav-desktop" aria-label="Navigasi Utama">
      <ul class="gvf-nav-list">
        <li>
          <a
            href="/"
            class={`gvf-nav-link ${currentPath === "/" ? "active" : ""}`}
            >Beranda</a
          >
        </li>
        <li>
          <a
            href="/tentang-kami"
            class={`gvf-nav-link ${currentPath === "/tentang-kami" ? "active" : ""}`}
            >Tentang Kami</a
          >
        </li>
        <li class="gvf-has-dropdown">
          <a
            href="/#program-kebaikan"
            class={`gvf-nav-link ${currentPath.startsWith("/program") ? "active" : ""}`}
          >
            <span>Program</span>
            <svg
              class="gvf-chevron"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>
          <ul class="gvf-dropdown-menu">
            <li><a href="/program/infaq">Infak</a></li>
            <li><a href="/program/sedekah">Sedekah</a></li>
            <li><a href="/program/zakat">Zakat</a></li>
            <li><a href="/program/wakaf">Wakaf</a></li>
          </ul>
        </li>
        <li>
          <a
            href="/kemitraan"
            class={`gvf-nav-link ${currentPath === "/kemitraan" ? "active" : ""}`}
            >Kemitraan</a
          >
        </li>
        <li>
          <a
            href="/kabar"
            class={`gvf-nav-link ${currentPath.startsWith("/kabar") ? "active" : ""}`}
            >Kabar</a
          >
        </li>
        <li>
          <a
            href="/contact"
            class={`gvf-nav-link ${currentPath === "/contact" ? "active" : ""}`}
            >Kontak</a
          >
        </li>
      </ul>
    </nav>

    <div class="gvf-header-right">
      <a href="tel:+6287865994786" class="gvf-phone-widget">
        <svg
          class="phone-handset-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
          ></path>
        </svg>
        <div class="phone-info">
          <span class="phone-label">Call Us Phone</span>
          <span class="phone-val">0878-6599-4786</span>
        </div>
      </a>

      <a
        href={currentPath === "/" ? "#program-kebaikan" : "/program/wakaf"}
        class="gvf-header-pill-btn"
        aria-label="Salurkan Donasi"
      >
        <svg class="pill-calc-icon" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
          ></path>
        </svg>
        <span>Salurkan Donasi</span>
      </a>

      <a
        href={currentPath === "/" ? "#program-kebaikan" : "/#program-kebaikan"}
        class="gvf-circle-dots-btn"
        aria-label="Lihat Program Kebaikan"
      >
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="dot"></span>
      </a>

      <button
        type="button"
        class="gvf-mobile-toggle"
        id="gvf-toggle"
        aria-label="Buka Menu Navigasi"
        aria-expanded="false"
        aria-controls="gvf-drawer"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div
    class="gvf-drawer"
    id="gvf-drawer"
    role="dialog"
    aria-modal="true"
    aria-label="Menu Navigasi Mobile"
  >
    <div class="gvf-drawer-panel">
      <div class="gvf-drawer-top">
        <div class="gvf-boxed-logo">
          <img
            src="/logo-gvf-3d.png"
            alt="Global Village Fund"
            class="gvf-logo-img"
          />
        </div>
        <button
          type="button"
          class="gvf-drawer-close"
          id="gvf-close"
          aria-label="Tutup Menu Navigasi">&times;</button
        >
      </div>
      <nav class="gvf-drawer-nav">
        <a href="/">Beranda</a>
        <a href="/tentang-kami">Tentang Kami</a>
        <a href="/program/infaq">Infak</a>
        <a href="/program/sedekah">Sedekah</a>
        <a href="/program/zakat">Zakat</a>
        <a href="/program/wakaf">Wakaf</a>
        <a href="/kemitraan">Kemitraan</a>
        <a href="/kabar">Kabar &amp; Warta</a>
        <a href="/contact">Kontak</a>
      </nav>
      <div class="gvf-drawer-bottom">
        <a
          href={currentPath === "/" ? "#program-kebaikan" : "/program/wakaf"}
          class="gvf-header-pill-btn"
          style="width: 100%; justify-content: center;"
        >
          Salurkan Donasi
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* Header Container: Transparan saat di puncak (scroll = 0), Meluncur sticky saat scroll */
  @keyframes menuSticky {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(0);
    }
  }

  .gvf-header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 999;
    background: linear-gradient(180deg, rgba(6, 24, 41, 0.75) 0%, rgba(6, 24, 41, 0.4) 65%, rgba(6, 24, 41, 0) 100%);
    transition:
      background-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .gvf-header.fixed {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background: #121417; /* Solid sleek charcoal black */
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
    animation: menuSticky 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gvf-header-inner {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .gvf-header.fixed .gvf-header-inner {
    max-width: 100%;
    margin: 0;
    padding: 14px 24px;
  }

  /* 1. Boxed Logo */
  .gvf-boxed-logo {
    border: 2px solid #ffffff;
    border-radius: 8px;
    padding: 4px 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .gvf-header-inner .gvf-boxed-logo {
    margin-left: 160px;
  }

  .gvf-logo-img {
    height: 50px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.4));
  }

  .gvf-boxed-logo span {
    font-family: "Golos Text", "Plus Jakarta Sans", sans-serif;
    font-size: 20px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.12em;
    line-height: 1;
  }

  .gvf-boxed-logo:hover {
    background-color: rgba(255, 255, 255, 0.15);
  }

  /* 2. Desktop Nav */
  .gvf-nav-desktop {
    display: flex;
    align-items: center;
  }

  .gvf-nav-list {
    display: flex;
    align-items: center;
    gap: 26px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .gvf-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: #ffffff;
    text-decoration: none;
    font-family: "Golos Text", "Plus Jakarta Sans", sans-serif;
    font-size: 15px;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .gvf-nav-link:hover,
  .gvf-nav-link.active {
    color: #38bdf8; /* Aksen biru langit arsitektural GVF */
  }

  .gvf-chevron {
    width: 11px;
    height: 11px;
    margin-left: 2px;
    transition: transform 0.2s ease;
  }

  .gvf-has-dropdown {
    position: relative;
  }

  .gvf-has-dropdown:hover .gvf-chevron {
    transform: rotate(180deg);
  }

  /* Dropdown Menu White Card */
  .gvf-dropdown-menu {
    position: absolute;
    top: calc(100% + 14px);
    left: 0;
    min-width: 240px;
    background: #ffffff;
    border-radius: 16px;
    padding: 10px 0;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.18);
    opacity: 0;
    visibility: hidden;
    transform: rotateX(-20deg) translateY(8px);
    transform-origin: top;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    list-style: none;
    margin: 0;
    z-index: 1000;
  }

  .gvf-has-dropdown:hover .gvf-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: rotateX(0deg) translateY(0);
  }

  .gvf-dropdown-menu li a {
    color: #0f172a;
    padding: 9px 22px;
    font-family: "Golos Text", "Plus Jakarta Sans", sans-serif;
    font-size: 14px;
    font-weight: 500;
    display: block;
    text-decoration: none;
    transition:
      color 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .gvf-dropdown-menu li a:hover {
    color: #0969da;
    background: #eff6ff;
  }

  /* 3. Right Header Actions */
  .gvf-header-right {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-right: 120px;
  }

  /* Call Us Phone Widget (Icon Handset Polos + Teks 2 Baris) */
  .gvf-phone-widget {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: #ffffff;
  }

  .phone-handset-icon {
    width: 24px;
    height: 24px;
    color: #ffffff;
    flex-shrink: 0;
    transform: rotate(-10deg);
  }

  .phone-info {
    display: flex;
    flex-direction: column;
  }

  .phone-label {
    font-family: "Golos Text", "Plus Jakarta Sans", sans-serif;
    font-size: 11px;
    color: #cbd5e1;
    font-weight: 500;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .phone-val {
    font-family: "Golos Text", "Plus Jakarta Sans", sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  /* 4. Pill Button CTA ("Salurkan Donasi" Royal Blue Signature Pen.dev GVF) */
  .gvf-header-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #0969da;
    color: #ffffff;
    text-decoration: none;
    border-radius: 9999px;
    padding: 11px 22px;
    font-family: "Golos Text", "Plus Jakarta Sans", sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.01em;
    transition:
      transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
    box-shadow: 0 4px 16px rgba(9, 105, 218, 0.35);
  }

  .gvf-header-pill-btn:hover {
    background: #0752a8;
    transform: translateY(-2px);
    box-shadow: 0 6px 22px rgba(9, 105, 218, 0.5);
  }

  .gvf-header-pill-btn:active {
    transform: scale(0.97);
  }

  .pill-calc-icon {
    width: 16px;
    height: 16px;
  }

  .pill-chevron-icon {
    width: 13px;
    height: 13px;
  }

  /* 5. Circle Button dengan 4 ROUND DOTS (2x2 Grid) */
  .gvf-circle-dots-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.16);
    display: grid;
    grid-template-columns: repeat(2, 4px);
    grid-gap: 5px;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition:
      transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
    cursor: pointer;
    flex-shrink: 0;
  }

  .gvf-circle-dots-btn .dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: #ffffff;
    display: block;
    transition: transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .gvf-circle-dots-btn:hover {
    background-color: #0969da;
    border-color: #0969da;
    transform: rotate(90deg);
  }

  .gvf-circle-dots-btn:active {
    transform: rotate(90deg) scale(0.94);
  }

  /* Mobile Hamburger Toggle */
  .gvf-mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    border-radius: 8px;
    padding: 8px;
    cursor: pointer;
  }

  .gvf-mobile-toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background: #ffffff;
    border-radius: 2px;
    transition: all 0.25s ease;
  }

  /* Mobile Drawer */
  .gvf-drawer {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .gvf-drawer.open {
    opacity: 1;
    pointer-events: auto;
  }

  .gvf-drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: 85%;
    max-width: 360px;
    height: 100%;
    background: #111827;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gvf-drawer.open .gvf-drawer-panel {
    transform: translateX(0);
  }

  .gvf-drawer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .gvf-drawer-close {
    background: none;
    border: none;
    color: #ffffff;
    font-size: 2rem;
    cursor: pointer;
    line-height: 1;
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gvf-drawer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .gvf-drawer-nav a {
    color: #ffffff;
    text-decoration: none;
    font-size: 1.1rem;
    font-weight: 600;
    min-height: 44px;
    display: flex;
    align-items: center;
    transition: color 0.2s ease;
  }

  .gvf-drawer-nav a:hover {
    color: #38bdf8;
  }

  .gvf-drawer-bottom {
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 1100px) {
    .gvf-nav-desktop,
    .gvf-phone-widget {
      display: none;
    }
    .gvf-mobile-toggle,
    .gvf-drawer {
      display: flex;
    }
    .gvf-header-inner {
      padding: 14px 20px;
    }
    .gvf-header-inner .gvf-boxed-logo {
      margin-left: 10px;
    }
    .gvf-header-right {
      margin-right: 10px;
    }
  }
</style>

<script>
  // Dynamic Scroll Listener for Sticky State
  const header = document.getElementById("main-header");

  const onScroll = () => {
    if (window.scrollY > 40) {
      header?.classList.add("fixed");
    } else {
      header?.classList.remove("fixed");
    }
  };

  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // Mobile Drawer Toggle
  const toggle = document.getElementById("gvf-toggle");
  const close = document.getElementById("gvf-close");
  const drawer = document.getElementById("gvf-drawer");

  function openDrawer() {
    drawer?.classList.add("open");
    toggle?.setAttribute("aria-expanded", "true");
    close?.focus();
  }

  function closeDrawer() {
    drawer?.classList.remove("open");
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.focus();
  }

  if (toggle && close && drawer) {
    toggle.addEventListener("click", openDrawer);
    close.addEventListener("click", closeDrawer);
    drawer.addEventListener("click", (e) => {
      if (e.target === drawer) closeDrawer();
    });
    drawer.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", closeDrawer);
    });
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && drawer.classList.contains("open")) {
        closeDrawer();
      }
    });
  }
</script>
