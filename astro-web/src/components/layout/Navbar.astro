---
// src/components/layout/Navbar.astro
// Exact ISAVO Header: Boxed Logo [GVF], Transparent overlay at top, Sticky animated on scroll (#121417), Phone Handset, Pill CTA, 4-Dots Circle Trigger
const currentPath = Astro.url.pathname;
---

<header class="isavo-header" id="main-header">
  <div class="isavo-header-inner">
    <!-- Brand Boxed Logo ala ISAVO [ISAVO] -->
    <a href="/" class="isavo-boxed-logo" aria-label="Global Village Fund Beranda">
      <span>GVF</span>
    </a>

    <!-- Desktop Navigation Menu -->
    <!-- Desktop Navigation Menu -->
    <nav class="isavo-nav-desktop" aria-label="Navigasi Utama">
      <ul class="isavo-nav-list">
        <li><a href="/" class={`isavo-nav-link ${currentPath === '/' ? 'active' : ''}`}>Home</a></li>
        <li class="isavo-has-dropdown">
          <a href="/#program" class={`isavo-nav-link ${currentPath.startsWith('/program') ? 'active' : ''}`}>
            <span>Program</span>
            <svg class="isavo-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>
          <ul class="isavo-dropdown-menu">
            <li><a href="/program/wakaf">Wakaf</a></li>
            <li><a href="/program/infaq">Infaq</a></li>
            <li><a href="/program/zakat">Zakat</a></li>
            <li><a href="/program/sedekah">Sedekah</a></li>
          </ul>
        </li>
        <li><a href="/#kemitraan" class="isavo-nav-link">Kemitraan</a></li>
        <li><a href="/#dampak" class="isavo-nav-link">Dampak</a></li>
        <li><a href="/contact" class={`isavo-nav-link ${currentPath === '/contact' ? 'active' : ''}`}>Kontak</a></li>
      </ul>
    </nav>

    <!-- Right Header Actions ala ISAVO -->
    <div class="isavo-header-right">
      <!-- Call Us Phone Widget (Icon Handset Polos + Teks 2 Baris) -->
      <a href="tel:+6287865994786" class="isavo-phone-widget">
        <svg class="phone-handset-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <div class="phone-info">
          <span class="phone-label">Call Us Phone</span>
          <span class="phone-val">0878-6599-4786</span>
        </div>
      </a>

      <!-- Tombol Paling Menonjol: DONASI SEKARANG ala ISAVO -->
      <a href="#donasi" class="isavo-header-pill-btn" aria-label="Donasi Sekarang">
        <svg class="pill-calc-icon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
        <span>DONASI SEKARANG</span>
      </a>

      <!-- Circle Button dengan 4 ROUND DOTS (2x2 Grid) ala ISAVO -->
      <a href="#rekening" class="isavo-circle-dots-btn" aria-label="Menu Ekstra Rekening">
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="dot"></span>
      </a>

      <!-- Mobile Hamburger Toggle -->
      <button type="button" class="isavo-mobile-toggle" id="isavo-toggle" aria-label="Buka Menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div class="isavo-drawer" id="isavo-drawer">
    <div class="isavo-drawer-panel">
      <div class="isavo-drawer-top">
        <div class="isavo-boxed-logo">
          <span>GVF</span>
        </div>
        <button type="button" class="isavo-drawer-close" id="isavo-close">&times;</button>
      </div>
      <nav class="isavo-drawer-nav">
        <a href="/">Home</a>
        <a href="/program/wakaf">Wakaf</a>
        <a href="/program/infaq">Infaq</a>
        <a href="/program/zakat">Zakat</a>
        <a href="/program/sedekah">Sedekah</a>
        <a href="/#kemitraan">Kemitraan</a>
        <a href="/#dampak">Dampak</a>
        <a href="/contact">Kontak</a>
      </nav>
      <div class="isavo-drawer-bottom">
        <a href="#donasi" class="isavo-header-pill-btn" style="width: 100%; justify-content: center;">
          DONASI SEKARANG
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* Header Container: Transparan saat di puncak (scroll = 0), Meluncur sticky saat scroll */
  @keyframes menuSticky {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(0);
    }
  }

  .isavo-header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 999;
    background-color: transparent;
    transition: background-color 0.3s ease, padding 0.3s ease, box-shadow 0.3s ease;
  }

  .isavo-header.fixed {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background-color: #121417; /* Solid sleek charcoal black persis screenshot ISAVO */
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
    animation: menuSticky 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .isavo-header-inner {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 18px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: padding 0.3s ease;
  }

  .isavo-header.fixed .isavo-header-inner {
    max-width: 100%;
    margin: 0;
    padding: 12px 24px;
  }

  /* 1. Boxed Logo ala ISAVO [ISAVO] */
  .isavo-boxed-logo {
    border: 2px solid #ffffff;
    border-radius: 8px;
    padding: 6px 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .isavo-boxed-logo span {
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
    font-size: 20px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.12em;
    line-height: 1;
  }

  .isavo-boxed-logo:hover {
    background-color: rgba(255, 255, 255, 0.15);
  }

  /* 2. Desktop Nav */
  .isavo-nav-desktop {
    display: flex;
    align-items: center;
  }

  .isavo-nav-list {
    display: flex;
    align-items: center;
    gap: 26px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .isavo-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: #ffffff;
    text-decoration: none;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
    font-size: 15px;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .isavo-nav-link:hover,
  .isavo-nav-link.active {
    color: #e53935; /* Aksen merah signature ISAVO */
  }

  .isavo-chevron {
    width: 11px;
    height: 11px;
    margin-left: 2px;
    transition: transform 0.2s ease;
  }

  .isavo-has-dropdown {
    position: relative;
  }

  .isavo-has-dropdown:hover .isavo-chevron {
    transform: rotate(180deg);
  }

  /* Dropdown Menu White Card */
  .isavo-dropdown-menu {
    position: absolute;
    top: calc(100% + 14px);
    left: 0;
    min-width: 240px;
    background: #ffffff;
    border-radius: 16px;
    padding: 10px 0;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.18);
    opacity: 0;
    visibility: hidden;
    transform: rotateX(-20deg) translateY(8px);
    transform-origin: top;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    list-style: none;
    margin: 0;
    z-index: 1000;
  }

  .isavo-has-dropdown:hover .isavo-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: rotateX(0deg) translateY(0);
  }

  .isavo-dropdown-menu li a {
    color: #0f172a;
    padding: 9px 22px;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    font-weight: 500;
    display: block;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .isavo-dropdown-menu li a:hover {
    color: #e53935;
    background: #fff5f5;
    padding-left: 26px;
  }

  /* 3. Right Header Actions */
  .isavo-header-right {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  /* Call Us Phone Widget (Icon Handset Polos + Teks 2 Baris) */
  .isavo-phone-widget {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: #ffffff;
  }

  .phone-handset-icon {
    width: 24px;
    height: 24px;
    color: #ffffff;
    flex-shrink: 0;
    transform: rotate(-10deg);
  }

  .phone-info {
    display: flex;
    flex-direction: column;
  }

  .phone-label {
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
    font-size: 11px;
    color: #cbd5e1;
    font-weight: 500;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .phone-val {
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  /* 4. Pill Button CTA ("Simulasi Biaya ⌵" Merah Signature ISAVO) */
  .isavo-header-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #e53935 0%, #d32f2f 100%);
    color: #ffffff;
    text-decoration: none;
    border-radius: 9999px;
    padding: 11px 22px;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.01em;
    transition: all 0.25s ease;
    box-shadow: 0 4px 16px rgba(229, 57, 53, 0.4);
  }

  .isavo-header-pill-btn:hover {
    background: linear-gradient(135deg, #d32f2f 0%, #c62828 100%);
    transform: translateY(-2px);
    box-shadow: 0 6px 22px rgba(229, 57, 53, 0.55);
  }

  .pill-calc-icon {
    width: 16px;
    height: 16px;
  }

  .pill-chevron-icon {
    width: 13px;
    height: 13px;
  }

  /* 5. Circle Button dengan 4 ROUND DOTS (2x2 Grid) ala ISAVO */
  .isavo-circle-dots-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.16);
    display: grid;
    grid-template-columns: repeat(2, 4px);
    grid-gap: 5px;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
    flex-shrink: 0;
  }

  .isavo-circle-dots-btn .dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: #ffffff;
    display: block;
    transition: transform 0.25s ease;
  }

  .isavo-circle-dots-btn:hover {
    background-color: #e53935;
    border-color: #e53935;
    transform: rotate(90deg);
  }

  /* Mobile Hamburger Toggle */
  .isavo-mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    border-radius: 8px;
    padding: 8px;
    cursor: pointer;
  }

  .isavo-mobile-toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background: #ffffff;
    border-radius: 2px;
    transition: all 0.25s ease;
  }

  /* Mobile Drawer */
  .isavo-drawer {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .isavo-drawer.open {
    opacity: 1;
    pointer-events: auto;
  }

  .isavo-drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: 85%;
    max-width: 360px;
    height: 100%;
    background: #111827;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .isavo-drawer.open .isavo-drawer-panel {
    transform: translateX(0);
  }

  .isavo-drawer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .isavo-drawer-close {
    background: none;
    border: none;
    color: #ffffff;
    font-size: 2rem;
    cursor: pointer;
    line-height: 1;
  }

  .isavo-drawer-nav {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    flex: 1;
  }

  .isavo-drawer-nav a {
    color: #ffffff;
    text-decoration: none;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .isavo-drawer-nav a:hover {
    color: #0284c7;
  }

  .isavo-drawer-bottom {
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 1100px) {
    .isavo-nav-desktop,
    .isavo-phone-widget {
      display: none;
    }
    .isavo-mobile-toggle,
    .isavo-drawer {
      display: flex;
    }
    .isavo-header-inner {
      padding: 14px 20px;
    }
  }
</style>

<script>
  // Dynamic Scroll Listener for Sticky State (Identik ISAVO .primary-header.fixed)
  const header = document.getElementById('main-header');

  const onScroll = () => {
    if (window.scrollY > 40) {
      header?.classList.add('fixed');
    } else {
      header?.classList.remove('fixed');
    }
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Mobile Drawer Toggle
  const toggle = document.getElementById('isavo-toggle');
  const close = document.getElementById('isavo-close');
  const drawer = document.getElementById('isavo-drawer');

  if (toggle && close && drawer) {
    toggle.addEventListener('click', () => drawer.classList.add('open'));
    close.addEventListener('click', () => drawer.classList.remove('open'));
    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) drawer.classList.remove('open');
    });
    drawer.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => drawer.classList.remove('open'));
    });
  }
</script>
