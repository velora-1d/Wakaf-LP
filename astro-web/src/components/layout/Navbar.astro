<script>
  // Dynamic Scroll Listener for Sticky State
  const header = document.getElementById("main-header");

  const onScroll = () => {
    if (window.scrollY > 40) {
      header?.classList.add("fixed");
    } else {
      header?.classList.remove("fixed");
    }
  };

  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // Mobile Drawer Toggle
  const toggle = document.getElementById("gvf-toggle");
  const bottomMore = document.getElementById("gvf-bottom-more");
  const close = document.getElementById("gvf-close");
  const drawer = document.getElementById("gvf-drawer");

  function openDrawer() {
    drawer?.classList.add("open");
    toggle?.setAttribute("aria-expanded", "true");
    bottomMore?.setAttribute("aria-expanded", "true");
    close?.focus();
  }

  function closeDrawer() {
    drawer?.classList.remove("open");
    toggle?.setAttribute("aria-expanded", "false");
    bottomMore?.setAttribute("aria-expanded", "false");
    toggle?.focus();
  }

  if (close && drawer) {
    toggle?.addEventListener("click", openDrawer);
    bottomMore?.addEventListener("click", openDrawer);
    close.addEventListener("click", closeDrawer);
    drawer.addEventListener("click", (e) => {
      if (e.target === drawer) closeDrawer();
    });
    drawer.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", closeDrawer);
    });
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && drawer.classList.contains("open")) {
        closeDrawer();
      }
    });
  }
</script>
