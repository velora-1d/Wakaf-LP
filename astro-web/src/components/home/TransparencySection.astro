---
// src/components/home/TransparencySection.astro
// Section 11: Transparency & Governance — Kepercayaan Dibangun dengan Keterbukaan
const auditPoints = [
  {
    title: 'Akuntabilitas Keuangan Berkala',
    desc: 'Laporan arus kas penerimaan donasi dan penyerapan biaya konstruksi disusun berkala dan dapat diakses publik.'
  },
  {
    title: 'Dokumentasi Fisik Lapangan',
    desc: 'Pembaruan foto dan video progres proyek diunggah secara konsisten dari lokasi kawasan Jonggol Bogor.'
  },
  {
    title: 'Verifikasi Legalitas Sah Negara',
    desc: 'Beroperasi di bawah naungan resmi Yayasan Permata Cendekia Indonesia dengan nomor legalitas Kemenkumham & rekomendasi BWI.'
  }
];
---

<section class="transparency-section" id="transparansi">
  <div class="transparency-container">
    <div class="transparency-card">
      <div class="trans-content">
        <span class="section-kicker reveal-on-scroll">Tata Kelola & Transparansi</span>
        <h2 class="trans-title reveal-heading">Kepercayaan Dibangun dengan Keterbukaan.</h2>
        <p class="trans-desc reveal-on-scroll" data-delay="0.1">
          Kami percaya bahwa setiap rupiah amanah harus dapat dipertanggungjawabkan di dunia dan di akhirat. Karena itu, kami berkomitmen menyampaikan perkembangan program, penggunaan dana donasi, serta dokumentasi kegiatan secara terbuka dan bertanggung jawab.
        </p>

        <div class="audit-points-list reveal-stagger">
          {auditPoints.map((item, idx) => (
            <div class="audit-item">
              <span class="audit-check-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="audit-check-svg">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
              <div>
                <h4 class="audit-item-title">{item.title}</h4>
                <p class="audit-item-desc">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="trans-actions-wrap reveal-on-scroll" data-delay="0.3">
          <a href="#dokumentasi" class="gvf-btn gvf-btn-primary">
            <span>Lihat Dokumentasi Kegiatan</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="arrow-svg">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>

          <a href="/program/wakaf#legalitas" class="gvf-btn gvf-btn-secondary">
            <span>Periksa Legalitas Lembaga</span>
          </a>
        </div>
      </div>

      <div class="trans-visual-side reveal-scale" data-delay="0.2">
        <div class="audit-seal-box">
          <div class="seal-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="seal-icon-svg">
              <path d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M20 10v11M8 14v4M12 14v4M16 14v4"></path>
            </svg>
          </div>
          <h3 class="seal-title">Standar Tata Kelola YPCI</h3>
          <p class="seal-desc">
            Sistem tata kelola profesional menjamin pemisahan yang tegas antara dana operasional yayasan dan dana amanah wakaf abadi.
          </p>
          <div class="seal-metrics">
            <div class="seal-col">
              <span class="seal-val">100%</span>
              <span class="seal-lbl">Penyaluran Program</span>
            </div>
            <div class="seal-divider" aria-hidden="true"></div>
            <div class="seal-col">
              <span class="seal-val">BWI</span>
              <span class="seal-lbl">Terdaftar Resmi</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .transparency-section {
    position: relative;
    padding: var(--section-padding-y-lg) 0;
    background-color: var(--color-surface-50);
    border-bottom: 1px solid var(--color-border);
  }

  .transparency-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .transparency-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-9) var(--space-8);
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-9);
    align-items: center;
    box-shadow: var(--shadow-lg);
  }

  .trans-title {
    font-size: var(--text-heading-lg);
    font-weight: 800;
    line-height: var(--leading-tight);
    color: var(--color-text-heading);
    letter-spacing: var(--tracking-tighter);
    margin-bottom: var(--space-4);
    font-family: var(--font-display);
  }

  .trans-desc {
    font-size: var(--text-body);
    line-height: var(--leading-loose);
    color: var(--color-text-muted);
    margin-bottom: var(--space-7);
  }

  .audit-points-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .audit-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-surface-100);
  }

  .audit-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .audit-check-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--blue-50);
    color: var(--blue-600);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .audit-check-svg {
    width: 15px;
    height: 15px;
  }

  .audit-item-title {
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-text-heading);
    margin-bottom: 2px;
  }

  .audit-item-desc {
    font-size: var(--text-label);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  .trans-actions-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .arrow-svg {
    width: 16px;
    height: 16px;
  }

  /* Visual Seal Box */
  .audit-seal-box {
    background: linear-gradient(135deg, var(--navy-950) 0%, var(--navy-800) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    padding: var(--space-8) var(--space-7);
    color: #ffffff;
    text-align: center;
    box-shadow: var(--shadow-dark);
  }

  .seal-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: var(--radius-lg);
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.25);
    color: #38bdf8;
    margin: 0 auto var(--space-4);
  }

  .seal-icon-svg {
    width: 30px;
    height: 30px;
  }

  .seal-title {
    font-size: var(--text-heading-sm);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: var(--space-2);
  }

  .seal-desc {
    font-size: var(--text-label);
    line-height: var(--leading-relaxed);
    color: var(--color-text-on-dark);
    opacity: 0.8;
    margin-bottom: var(--space-6);
  }

  .seal-metrics {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .seal-val {
    font-size: 1.75rem;
    font-weight: 900;
    color: #38bdf8;
    display: block;
    line-height: 1;
    margin-bottom: 4px;
    font-family: var(--font-display);
  }

  .seal-lbl {
    font-size: var(--text-micro);
    color: #cbd5e1;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    font-weight: 600;
  }

  @media (max-width: 1024px) {
    .transparency-card {
      grid-template-columns: 1fr;
      padding: var(--space-7) var(--space-5);
      gap: var(--space-7);
    }
  }

  @media (max-width: 640px) {
    .transparency-section {
      padding: var(--section-padding-y-sm) 0;
    }
    .transparency-container {
      padding: 0 var(--space-5);
    }
  }
</style>
