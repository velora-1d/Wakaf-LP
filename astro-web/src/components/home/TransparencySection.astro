---
// src/components/home/TransparencySection.astro
// Section 11: Transparency & Governance — Kepercayaan Dibangun dengan Keterbukaan
const auditPoints = [
  {
    title: 'Akuntabilitas Keuangan Berkala',
    desc: 'Laporan arus kas penerimaan donasi dan penyerapan biaya konstruksi disusun berkala dan dapat diakses publik.'
  },
  {
    title: 'Dokumentasi Fisik Lapangan',
    desc: 'Pembaruan foto dan video progres proyek diunggah secara konsisten dari lokasi kawasan Jonggol Bogor.'
  },
  {
    title: 'Verifikasi Legalitas Sah Negara',
    desc: 'Beroperasi di bawah naungan resmi Yayasan Permata Cendekia Indonesia dengan nomor legalitas Kemenkumham & rekomendasi BWI.'
  }
];
---

<section class="transparency-section" id="transparansi">
  <div class="transparency-container">
    <div class="transparency-card reveal-on-scroll">
      <div class="trans-content">
        <div class="trans-pill">
          <span class="pill-dot"></span>
          <span>11 • TRANSPARENCY & GOVERNANCE</span>
        </div>

        <h2 class="trans-title">Kepercayaan Dibangun dengan Keterbukaan.</h2>
        <p class="trans-desc">
          Kami percaya bahwa setiap rupiah amanah harus dapat dipertanggungjawabkan di dunia dan di akhirat. Karena itu, kami berkomitmen menyampaikan perkembangan program, penggunaan dana donasi, serta dokumentasi kegiatan secara terbuka dan bertanggung jawab.
        </p>

        <div class="audit-points-list">
          {auditPoints.map((item, idx) => (
            <div class="audit-item">
              <span class="audit-check-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="audit-check-svg">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
              <div>
                <h4 class="audit-item-title">{item.title}</h4>
                <p class="audit-item-desc">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="trans-actions-wrap">
          <a href="#dokumentasi" class="trans-btn-primary">
            <span>Lihat Dokumentasi Kegiatan</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="arrow-svg">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>

          <a href="/program/wakaf#legalitas" class="trans-btn-outline">
            <span>Periksa Legalitas Lembaga</span>
          </a>
        </div>
      </div>

      <div class="trans-visual-side">
        <div class="audit-seal-box">
          <div class="seal-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="seal-icon-svg">
              <path d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M20 10v11M8 14v4M12 14v4M16 14v4"></path>
            </svg>
          </div>
          <h3 class="seal-title">Standar Tata Kelola YPCI</h3>
          <p class="seal-desc">
            Sistem tata kelola profesional menjamin pemisahan yang tegas antara dana operasional yayasan dan dana amanah wakaf abadi.
          </p>
          <div class="seal-metrics">
            <div class="seal-col">
              <span class="seal-val">100%</span>
              <span class="seal-lbl">Penyaluran Program</span>
            </div>
            <div class="seal-col">
              <span class="seal-val">BWI</span>
              <span class="seal-lbl">Terdaftar Resmi</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .transparency-section {
    position: relative;
    padding: 110px 0 120px;
    background-color: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
  }

  .transparency-container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .transparency-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 32px;
    padding: 60px 50px;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 60px;
    align-items: center;
    box-shadow: 0 10px 35px rgba(15, 23, 42, 0.04);
  }

  .trans-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(2, 132, 199, 0.1);
    border: 1px solid rgba(2, 132, 199, 0.25);
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #0284c7;
    margin-bottom: 20px;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    background-color: #0284c7;
    border-radius: 50%;
  }

  .trans-title {
    font-size: clamp(2.2rem, 3.6vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    color: #0f172a;
    letter-spacing: -0.025em;
    margin-bottom: 18px;
  }

  .trans-desc {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #64748b;
    margin-bottom: 32px;
  }

  .audit-points-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 36px;
  }

  .audit-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid #f1f5f9;
  }

  .audit-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .audit-check-icon {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #e0f2fe;
    color: #0284c7;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .audit-check-svg {
    width: 14px;
    height: 14px;
  }

  .audit-item-title {
    font-size: 1rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 2px;
  }

  .audit-item-desc {
    font-size: 0.9rem;
    line-height: 1.5;
    color: #64748b;
  }

  .trans-actions-wrap {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .trans-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #0284c7;
    color: #ffffff;
    padding: 12px 26px;
    border-radius: 9999px;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.35);
    transition: all 0.25s ease;
  }

  .trans-btn-primary:hover {
    background: #0369a1;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(2, 132, 199, 0.45);
  }

  .arrow-svg {
    width: 16px;
    height: 16px;
  }

  .trans-btn-outline {
    display: inline-flex;
    align-items: center;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    color: #334155;
    padding: 12px 22px;
    border-radius: 9999px;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .trans-btn-outline:hover {
    background: #e2e8f0;
    color: #0f172a;
  }

  /* Visual Seal Box */
  .audit-seal-box {
    background: linear-gradient(135deg, #0a2540 0%, #0f172a 100%);
    border-radius: 24px;
    padding: 40px 36px;
    color: #ffffff;
    text-align: center;
    box-shadow: 0 16px 40px rgba(10, 37, 64, 0.25);
  }

  .seal-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    border-radius: 20px;
    background: rgba(56, 189, 248, 0.15);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: #38bdf8;
    margin: 0 auto 18px;
  }

  .seal-icon-svg {
    width: 32px;
    height: 32px;
  }

  .seal-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 10px;
  }

  .seal-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #94a3b8;
    margin-bottom: 28px;
  }

  .seal-metrics {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .seal-val {
    font-size: 1.8rem;
    font-weight: 900;
    color: #38bdf8;
    display: block;
    line-height: 1;
    margin-bottom: 4px;
  }

  .seal-lbl {
    font-size: 0.75rem;
    color: #cbd5e1;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 1024px) {
    .transparency-card {
      grid-template-columns: 1fr;
      padding: 40px 30px;
    }
  }
</style>
