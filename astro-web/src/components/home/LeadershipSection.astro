<script>
  // Interactive Team Member Hover/Click Switcher
  const rows = document.querySelectorAll('.pen-member-row');
  const activeImg = document.getElementById('teamActiveImg') as HTMLImageElement | null;

  let currentIndex = 0;
  let autoCycleTimer: any = null;
  let isHovered = false;

  const setActiveMember = (index: number) => {
    if (index < 0 || index >= rows.length) return;
    currentIndex = index;

    rows.forEach((row, i) => {
      if (i === index) {
        row.classList.add('active');
        row.setAttribute('aria-pressed', 'true');
      } else {
        row.classList.remove('active');
        row.setAttribute('aria-pressed', 'false');
      }
    });

    const activeRow = rows[index] as HTMLElement;
    const photo = activeRow.getAttribute('data-photo') || '';
    const name = activeRow.getAttribute('data-name') || '';

    if (activeImg) {
      activeImg.style.opacity = '0';
      activeImg.style.transform = 'scale(0.96)';

      setTimeout(() => {
        activeImg.src = photo;
        activeImg.alt = name;
        activeImg.style.opacity = '1';
        activeImg.style.transform = 'scale(1)';
      }, 140);
    }
  };

  rows.forEach((row, i) => {
    row.addEventListener('mouseenter', () => {
      isHovered = true;
      setActiveMember(i);
    });

    row.addEventListener('click', () => {
      setActiveMember(i);
    });

    row.addEventListener('keydown', (e: Event) => {
      const ke = e as KeyboardEvent;
      if (ke.key === 'Enter' || ke.key === ' ') {
        ke.preventDefault();
        setActiveMember(i);
      }
    });
  });

  const teamSection = document.getElementById('pengurus');
  if (teamSection) {
    teamSection.addEventListener('mouseenter', () => {
      isHovered = true;
    });

    teamSection.addEventListener('mouseleave', () => {
      isHovered = false;
    });
  }

  autoCycleTimer = setInterval(() => {
    if (!isHovered) {
      const nextIndex = (currentIndex + 1) % rows.length;
      setActiveMember(nextIndex);
    }
  }, 4500);
</script>

<style>
  .pen-leadership-section {
    position: relative;
    padding: 120px 0 140px 0;
    background-color: #f6f6f3;
    overflow: hidden;
  }

  .pen-leadership-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Header Pen.dev */
  .pen-leadership-header {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 60px;
  }

  .pen-team-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 18px 6px 14px;
    border: 1px solid rgba(114, 114, 114, 0.2);
    border-radius: 32px;
    background: transparent;
  }

  .pen-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #0969da;
  }

  .pen-badge-text {
    font-size: 12px;
    line-height: 14px;
    letter-spacing: 1px;
    color: #000000;
    font-weight: 500;
  }

  .pen-leadership-title {
    font-size: 48px;
    line-height: 55px;
    font-weight: 400;
    color: #000000;
    margin: 0;
    letter-spacing: -0.02em;
  }

  /* Grid Layout: Kiri Foto 416x416, Kanan List 5 Baris */
  .pen-team-grid {
    display: grid;
    grid-template-columns: 416px 1fr;
    gap: 70px;
    align-items: center;
  }

  .pen-photo-col {
    display: flex;
    justify-content: center;
  }

  .pen-photo-wrapper {
    width: 416px;
    height: 416px;
    border-radius: 16px;
    overflow: hidden;
    background-color: #e2e8f0;
    box-shadow: 0px 8px 30px rgba(0, 0, 0, 0.06);
  }

  .pen-team-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: opacity 180ms cubic-bezier(0.2, 0.8, 0.2, 1), transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* Member List */
  .pen-member-list {
    display: flex;
    flex-direction: column;
  }

  .pen-member-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px 0;
    border-bottom: 1px solid rgba(159, 159, 164, 0.24);
    cursor: pointer;
    transition: background-color 180ms cubic-bezier(0.2, 0.8, 0.2, 1), transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
    user-select: none;
  }

  .pen-member-row:focus-visible {
    outline: 2px solid #0969da;
    outline-offset: 2px;
  }

  .pen-member-row:active {
    transform: scale(0.995);
  }

  .pen-member-row:first-child {
    border-top: 1px solid rgba(159, 159, 164, 0.24);
  }

  .pen-row-left {
    display: flex;
    align-items: center;
    gap: 15px;
    width: 380px;
    flex-shrink: 0;
  }

  .pen-member-num {
    font-size: 16px;
    line-height: 26px;
    color: #62625b;
    font-weight: 400;
    transition: color 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .pen-member-row.active .pen-member-num,
  .pen-member-row:hover .pen-member-num {
    color: #000000;
  }

  .pen-member-name {
    font-size: 24px;
    line-height: 24px;
    font-weight: 400;
    color: #000000;
    margin: 0;
    transition: color 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .pen-member-row.active .pen-member-name,
  .pen-member-row:hover .pen-member-name {
    color: #0969da;
  }

  .pen-row-role {
    font-size: 13px;
    line-height: 21px;
    letter-spacing: 1px;
    color: #0969da;
    font-weight: 400;
    text-transform: uppercase;
  }

  .pen-row-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #000000;
    transition: transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1), color 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .pen-member-row.active .pen-row-arrow {
    color: #0969da;
  }

  .pen-member-row:hover .pen-row-arrow {
    color: #0969da;
    transform: translate(3px, -3px);
  }

  @media (max-width: 1024px) {
    .pen-team-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .pen-photo-wrapper {
      width: 100%;
      max-width: 416px;
      height: 380px;
    }

    .pen-row-left {
      width: auto;
    }

    .pen-leadership-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .pen-leadership-title {
      font-size: 36px;
      line-height: 42px;
    }
  }

  @media (max-width: 640px) {
    .pen-leadership-section {
      padding: 80px 0 100px 0;
    }

    .pen-member-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
      padding: 20px 0;
    }

    .pen-row-role {
      font-size: 12px;
    }

    .pen-member-name {
      font-size: 18px;
    }
  }
</style>
