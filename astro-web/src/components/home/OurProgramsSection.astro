---

<section class="isavo-services-section" id="program-kebaikan">
  <div class="isavo-blueprint-shape" aria-hidden="true">
    <svg viewBox="0 0 1440 400" fill="none" stroke="rgba(15, 23, 42, 0.03)" stroke-width="1">
      <path d="M0 350 L400 100 L750 250 L1100 80 L1440 300" />
      <path d="M100 380 L500 130 L850 280 L1200 110" />
      <line x1="0" y1="350" x2="1440" y2="350" />
      <line x1="400" y1="100" x2="400" y2="350" />
      <line x1="750" y1="250" x2="750" y2="350" />
      <line x1="1100" y1="80" x2="1100" y2="350" />
    </svg>
  </div>

  <div class="isavo-services-container">
    <div class="isavo-section-heading-wrap">
      <div class="heading-left-col">
        <div class="pilar-badge-pill">
          <span class="pilar-dot-halo">
            <span class="pilar-halo-ring"></span>
            <span class="pilar-core-dot"></span>
          </span>
          <span class="pilar-badge-text">Empat Pilar Kebaikan</span>
        </div>
      </div>
      <div class="heading-right-col">
        <h2 class="isavo-main-title">
          Satu Wadah, Empat Pilar Kebaikan Berkelanjutan
        </h2>
        <p class="isavo-lead-desc">
          Layanan filantropi terpadu dari Hulu ke Hilir. Infaq, Shodaqoh, Zakat, dan Wakaf dalam satu pintu ekosistem terintegrasi untuk membangun peradaban dan kemandirian santri vokasi di Sukasirna Jonggol.
        </p>
      </div>
    </div>

    <div class="isavo-cards-grid">
      {programs.map((prog) => (
        <a href={prog.link} class="isavo-service-card" id={`card-${prog.id}`}>
          <div class="card-top-row">
            <h3 class="card-title">{prog.title}</h3>
            <div class="card-icon-wrap" set:html={prog.iconSvg} />
          </div>

          <p class="card-desc">{prog.desc}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .isavo-services-section {
    position: relative;
    padding: 100px 0;
    background-color: #f6f6f3;
    overflow: hidden;
  }

  .isavo-blueprint-shape {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .isavo-services-container {
    position: relative;
    z-index: 2;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* HEADER SECTION SPLIT 2-KOLOM */
  .isavo-section-heading-wrap {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
    margin-bottom: 60px;
  }

  @media (max-width: 900px) {
    .isavo-section-heading-wrap {
      flex-direction: column;
      gap: 20px;
      margin-bottom: 40px;
    }
  }

  /* Halo Badge Pill from Pen.dev */
  .pilar-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px 6px 10px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 32px;
    box-shadow: 0px 1px 4px rgba(0, 0, 0, 0.04);
  }

  .pilar-dot-halo {
    position: relative;
    width: 14px;
    height: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pilar-halo-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(0, 107, 62, 0.12);
  }

  .pilar-core-dot {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #0969da;
  }

  .pilar-badge-text {
    font-size: 12px;
    font-weight: 600;
    color: #000000;
    letter-spacing: 0.2px;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  .heading-right-col {
    max-width: 900px;
  }

  .isavo-main-title {
    font-family: 'Golos Text', system-ui, sans-serif;
    font-size: clamp(2rem, 3.2vw, 48px);
    font-weight: 400;
    line-height: 1.15;
    color: #000000;
    letter-spacing: -0.01em;
    margin: 0 0 16px 0;
  }

  .isavo-lead-desc {
    font-family: 'Golos Text', system-ui, sans-serif;
    font-size: 16px;
    line-height: 27px;
    color: #62625b;
    margin: 0;
  }

  /* 4 WHITE ROUNDED CARDS GRID ALA PEN.DEV */
  .isavo-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  @media (max-width: 1200px) {
    .isavo-cards-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media (max-width: 640px) {
    .isavo-cards-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  /* KARTU PUTIH PEN.DEV (RADIUS 16PX, SHADOW HALUS) */
  .isavo-service-card {
    background: #ffffff;
    border-radius: 16px;
    padding: 36px;
    min-height: 280px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    text-decoration: none;
    color: inherit;
    box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.04);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .isavo-service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0px 10px 30px rgba(0, 0, 0, 0.08);
  }

  .card-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 24px;
    border-bottom: 1px solid #e3e3e8;
    width: 100%;
  }

  .card-title {
    font-family: 'Golos Text', system-ui, sans-serif;
    font-size: 26px;
    font-weight: 400;
    line-height: 1.2;
    color: #000000;
    margin: 0;
  }

  .card-icon-wrap {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.card-svg-pencil) {
    width: 38px;
    height: 38px;
    display: block;
  }

  .card-desc {
    font-family: 'Golos Text', system-ui, sans-serif;
    font-size: 15px;
    line-height: 26px;
    color: #62625b;
    margin: 24px 0 0 0;
  }
</style>
