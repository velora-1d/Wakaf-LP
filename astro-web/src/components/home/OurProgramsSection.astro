---
// src/components/home/OurProgramsSection.astro
// Exact ISAVO "Layanan Kami" 4-Card Architecture Section (Screenshot 2 isavo.co.id)
// White rounded cards (radius 24px), gold/brass architectural geometric icons, subtle wireframe background
const programs = [
  {
    id: 'wakaf-produktif',
    title: 'Wakaf Produktif Lahan',
    badge: 'KEMASLAHATAN ABADI',
    desc: 'Pembebasan dan pengelolaan lahan abadi seluas ±3 hektare di Sukasirna Jonggol untuk kawasan masjid, pendidikan vokasi, dan agro-technopark berkelanjutan.',
    link: '/program/wakaf',
    // Geometric Brass Architectural Icon ala ISAVO
    iconSvg: `<svg viewBox="0 0 52 52" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="4" y="4" width="44" height="44" rx="10" stroke="#b4914c" stroke-width="1.75"/>
      <path d="M4 26H48" stroke="#b4914c" stroke-width="1.5" stroke-dasharray="3 3"/>
      <path d="M26 4V48" stroke="#b4914c" stroke-width="1.5" stroke-dasharray="3 3"/>
      <circle cx="26" cy="26" r="12" stroke="#b4914c" stroke-width="1.75"/>
      <polygon points="26,16 34,32 18,32" stroke="#b4914c" stroke-width="1.5" fill="none"/>
    </svg>`
  },
  {
    id: 'infaq-material',
    title: 'Infaq Pembangunan Fisik',
    badge: 'GOTONG ROYONG NYATA',
    desc: 'Partisipasi pengadaan material konstruksi riil (semen, pasir, bata roster, sanitasi wudhu) untuk percepatan sarana ibadah dan workshop santri.',
    link: '/program/infaq',
    iconSvg: `<svg viewBox="0 0 52 52" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M10 42L26 10L42 42H10Z" stroke="#b4914c" stroke-width="1.75"/>
      <line x1="18" y1="26" x2="34" y2="26" stroke="#b4914c" stroke-width="1.5"/>
      <circle cx="26" cy="32" r="4" stroke="#b4914c" stroke-width="1.5"/>
    </svg>`
  },
  {
    id: 'zakat-profesi-maal',
    title: 'Zakat Maal & Profesi',
    badge: 'HAK 8 ASNAF RIIL',
    desc: 'Penyaluran kewajiban zakat 2,5% secara amanah dan terhisab akurat untuk beasiswa penuh santri vokasi fi sabilillah dan pembinaan kemandirian keluarga binaan.',
    link: '/program/zakat',
    iconSvg: `<svg viewBox="0 0 52 52" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="26" cy="26" r="20" stroke="#b4914c" stroke-width="1.75"/>
      <circle cx="26" cy="26" r="10" stroke="#b4914c" stroke-width="1.5" stroke-dasharray="2 2"/>
      <path d="M26 6V46" stroke="#b4914c" stroke-width="1.5"/>
      <path d="M6 26H46" stroke="#b4914c" stroke-width="1.5"/>
    </svg>`
  },
  {
    id: 'sedekah-nutrisi',
    title: 'Sedekah Asupan Nutrisi',
    badge: 'KETAHANAN GIZI SANTRI',
    desc: 'Penyediaan makanan sehat, susu gizi, dan kebutuhan pangan harian santri vokasi dan penghafal quran selama menempuh masa penggemblengan keahlian.',
    link: '/program/sedekah',
    iconSvg: `<svg viewBox="0 0 52 52" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="8" y="14" width="36" height="28" rx="8" stroke="#b4914c" stroke-width="1.75"/>
      <path d="M8 24C18 20 34 20 44 24" stroke="#b4914c" stroke-width="1.5"/>
      <circle cx="26" cy="33" r="3" fill="#b4914c"/>
    </svg>`
  }
];
---

<section class="isavo-services-section" id="program-kebaikan">
  <!-- Subtle Architectural Blueprint Sketch Watermark ala ISAVO -->
  <div class="isavo-blueprint-shape" aria-hidden="true">
    <svg viewBox="0 0 1440 400" fill="none" stroke="rgba(15, 23, 42, 0.03)" stroke-width="1">
      <path d="M0 350 L400 100 L750 250 L1100 80 L1440 300" />
      <path d="M100 380 L500 130 L850 280 L1200 110" />
      <line x1="0" y1="350" x2="1440" y2="350" />
      <line x1="400" y1="100" x2="400" y2="350" />
      <line x1="750" y1="250" x2="750" y2="350" />
      <line x1="1100" y1="80" x2="1100" y2="350" />
    </svg>
  </div>

  <div class="isavo-services-container">
    <!-- Header Section Split 2-Kolom Khas ISAVO (Screenshot 2) -->
    <div class="isavo-section-heading-wrap">
      <div class="heading-left-col">
        <div class="isavo-pill-badge">
          <span class="badge-dot"></span>
          <span class="badge-text">PROGRAM UTAMA</span>
        </div>
      </div>
      <div class="heading-right-col">
        <h2 class="isavo-main-title">
          Satu Wadah, <span class="title-accent">Empat Pilar Kebaikan</span> Berkelanjutan
        </h2>
        <p class="isavo-lead-desc">
          Layanan filantropi terpadu dari <span class="text-accent">Hulu ke Hilir</span>. Wakaf, Infaq, Zakat, dan Sedekah dalam satu ekosistem terintegrasi untuk membangun peradaban dan kemandirian santri vokasi di Sukasirna Jonggol.
        </p>
      </div>
    </div>

    <!-- 4 White Rounded Cards Grid ala ISAVO Screenshot 2 (radius 24px) -->
    <div class="isavo-cards-grid">
      {programs.map((prog) => (
        <a href={prog.link} class="isavo-service-card" id={`card-${prog.id}`}>
          <div class="card-top-row">
            <h3 class="card-title">{prog.title}</h3>
            <div class="card-icon-wrap" set:html={prog.iconSvg} />
          </div>

          <!-- Subtle Divider Line Khas ISAVO Card -->
          <div class="card-hairline-sep"></div>

          <p class="card-desc">{prog.desc}</p>

          <div class="card-bottom-action">
            <span class="action-text">Pelajari Program</span>
            <span class="action-arrow">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="arrow-svg">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* STANDAR ASLI ISAVO (SCREENSHOT 2 isavo.co.id) */
  .isavo-services-section {
    position: relative;
    padding: 110px 0 120px 0;
    background-color: #f7f7f8;
    overflow: hidden;
  }

  .isavo-blueprint-shape {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .isavo-services-container {
    position: relative;
    z-index: 2;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* HEADER SECTION SPLIT 2-KOLOM KHAS ISAVO */
  .isavo-section-heading-wrap {
    display: grid;
    grid-template-columns: 3.5fr 8.5fr;
    gap: 40px;
    margin-bottom: 56px;
    align-items: start;
  }

  @media (max-width: 900px) {
    .isavo-section-heading-wrap {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-bottom: 40px;
    }
  }

  /* Badge Pill dengan Dot Khas ISAVO */
  .isavo-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 9999px;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    background: #0969da;
    border-radius: 50%;
  }

  .badge-text {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #191919;
    text-transform: uppercase;
  }

  .isavo-main-title {
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    color: #191919;
    letter-spacing: -0.02em;
    margin: 0 0 14px 0;
  }

  .title-accent {
    color: #0969da;
  }

  .isavo-lead-desc {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: #4d4d52;
    margin: 0;
    max-width: 820px;
  }

  .text-accent {
    color: #0969da;
    font-weight: 600;
  }

  /* 4 WHITE ROUNDED CARDS GRID ALA ISAVO */
  .isavo-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  @media (max-width: 1200px) {
    .isavo-cards-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media (max-width: 640px) {
    .isavo-cards-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  /* KARTU PUTIH MEWAH (BORDER RADIUS 24PX) */
  .isavo-service-card {
    background: #ffffff;
    border-radius: 24px;
    padding: 36px 28px 32px 28px;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border: 1px solid #f0f0f0;
    transition: transform 0.25s ease, border-color 0.25s ease;
    box-shadow: none; /* MUTLAK ZERO SHADOW */
  }

  .isavo-service-card:hover {
    transform: translateY(-4px);
    border-color: #cbd5e1;
  }

  .card-top-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    min-height: 64px;
  }

  .card-title {
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.25;
    color: #191919;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .card-icon-wrap {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
  }

  /* GARIS PEMISAH TIPIS KHAS KARTU ISAVO */
  .card-hairline-sep {
    width: 100%;
    height: 1px;
    background: #f0f0f0;
    margin: 22px 0 18px 0;
  }

  .card-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: #4d4d52;
    margin: 0 0 24px 0;
    flex-grow: 1;
  }

  /* BOTTOM ACTION LINK */
  .card-bottom-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top: 1px dashed #f0f0f0;
  }

  .action-text {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #0969da;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .action-arrow {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #f7f7f8;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0969da;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .arrow-svg {
    width: 15px;
    height: 15px;
  }

  .isavo-service-card:hover .action-arrow {
    background: #0969da;
    color: #ffffff;
    transform: translate(2px, -2px);
  }
</style>
