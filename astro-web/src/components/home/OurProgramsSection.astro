---
// src/components/home/OurProgramsSection.astro
// Section 06: Our Programs — 4 Kartu Program Interaktif yang Bisa Diklik
const programs = [
  {
    id: 'masjid-khairu-ummah',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3c-1.5 2-3 3.5-3 5.5a3 3 0 1 0 6 0c0-2-1.5-3.5-3-5.5z"></path><path d="M4 21V10l8-5 8 5v11H4z"></path><path d="M9 21v-6a3 3 0 0 1 6 0v6"></path></svg>`,
    title: 'Masjid Khairu Ummah Sugro',
    category: 'MASJID & RUMAH KEBAIKAN',
    desc: 'Pembangunan masjid sebagai ruang ibadah, pembelajaran terpadu, pembinaan karakter FAST, dan ruang kebermanfaatan bersama masyarakat.',
    image: '/gambar design/interior mesjid 2.jpg',
    btnText: 'Lihat Program & Donasi',
    link: '/program/wakaf'
  },
  {
    id: 'pendidikan-vokasi',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>`,
    title: 'Pendidikan Vokasi & Karakter',
    category: 'SMK SKILL VILLAGE',
    desc: 'Menghadirkan fasilitas pembelajaran vokasi integratif, laboratorium teknologi, dan beasiswa santri berprestasi agar mandiri dan berdaya.',
    image: '/gambar design/learning studio & workshop.jpg',
    btnText: 'Dukung Beasiswa Santri',
    link: '/program/sedekah'
  },
  {
    id: 'agro-technopark',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22v-9"></path><path d="M12 13a6 6 0 0 0 6-6c0-3-2-5-5-5a6 6 0 0 0-6 6c0 3 2 5 5 5z"></path><path d="M6 13a6 6 0 0 1 6-6"></path></svg>`,
    title: 'Agro-Technopark & Pangan',
    category: 'KETAHANAN & KEMANDIRIAN',
    desc: 'Inkubasi bisnis santri di bidang pertanian presisi (greenhouse) dan energi surya untuk menopang kebutuhan pangan harian serta kemandirian ekonomi.',
    image: '/gambar design/gh learning area.jpg',
    btnText: 'Jelajahi Inisiatif Mandiri',
    link: '/program/infaq'
  },
  {
    id: 'kemitraan-multipihak',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`,
    title: 'Kemitraan Multipihak',
    category: 'KOLABORASI STRATEGIS',
    desc: 'Membuka ruang sinergi bagi korporasi (CSR), perguruan tinggi, dunia industri, dan lembaga zakat untuk mengembangkan model pesantren berdaya.',
    image: '/gambar design/workshop.jpg',
    btnText: 'Konsultasi Kemitraan',
    link: '#kolaborasi'
  }
];
---

<section class="our-programs-section" id="program-kebaikan">
  <div class="our-programs-container">
    <div class="our-programs-header text-center">
      <span class="section-kicker reveal-on-scroll">Program Kebaikan</span>
      <h2 class="programs-title reveal-heading">
        Empat Pilar Ekosistem Kebaikan
      </h2>
      <p class="programs-desc reveal-on-scroll" data-delay="0.15">
        Setiap program dirancang untuk menjadi bagian dari ekosistem yang saling menguatkan, menghubungkan ibadah, pendidikan, ketahanan pangan, dan kemandirian nyata.
      </p>
    </div>

    <div class="programs-grid reveal-stagger">
      {programs.map((prog, idx) => (
        <a href={prog.link} class="program-card" id={`card-${prog.id}`}>
          <div class="prog-img-wrap parallax-wrap">
            <img src={prog.image} alt={prog.title} class="prog-img" loading="lazy" />
            <div class="prog-img-overlay"></div>
            <span class="prog-cat-badge">{prog.category}</span>
          </div>

          <div class="prog-content">
            <div class="prog-title-row">
              <span class="prog-icon" aria-hidden="true" set:html={prog.icon} />
              <h3 class="prog-title">{prog.title}</h3>
            </div>
            <p class="prog-desc">{prog.desc}</p>

            <div class="prog-cta-row">
              <span class="prog-cta-text">{prog.btnText}</span>
              <span class="prog-cta-arrow">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .our-programs-section {
    position: relative;
    padding: var(--section-padding-y) 0 var(--section-padding-y-lg);
    background-color: var(--color-surface-50);
  }

  .our-programs-container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .our-programs-header {
    max-width: 780px;
    margin: 0 auto var(--space-9);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .programs-title {
    font-size: var(--text-heading-lg);
    font-weight: 800;
    line-height: var(--leading-tight);
    color: var(--color-text-heading);
    letter-spacing: var(--tracking-tighter);
    font-family: var(--font-display);
  }

  .programs-desc {
    font-size: var(--text-body-lg);
    line-height: var(--leading-loose);
    color: var(--color-text-muted);
  }

  .programs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  /* ── Card ─────────────────────────────────────── */
  .program-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    position: relative;
    transition:
      border-color  var(--duration-slow) var(--ease-out),
      box-shadow    var(--duration-slow) var(--ease-out),
      transform     var(--duration-slow) var(--ease-out);
    will-change: transform;
  }

  .program-card:hover {
    border-color: hsl(214 89% 52% / 0.35);
    box-shadow: var(--shadow-xl), 0 0 0 1px hsl(214 89% 52% / 0.1);
    transform: translateY(-5px);
  }

  /* ── Image ────────────────────────────────────── */
  .prog-img-wrap {
    position: relative;
    width: 100%;
    height: 240px;
    overflow: hidden;
  }

  .prog-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-crawl) var(--ease-out);
    transform-origin: center;
  }

  .program-card:hover .prog-img {
    transform: scale(1.05);
  }

  .prog-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, hsl(222 47% 11% / 0.55) 100%);
  }

  .prog-cat-badge {
    position: absolute;
    bottom: var(--space-4);
    left: var(--space-5);
    z-index: 2;
    background: rgba(255, 255, 255, 0.95);
    color: var(--color-text-heading);
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: var(--tracking-wider);
    padding: 5px 14px;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    box-shadow: var(--shadow-md);
  }

  /* ── Content ──────────────────────────────────── */
  .prog-content {
    padding: var(--space-7) var(--space-7);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .prog-title-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .prog-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--blue-50);
    color: var(--blue-500);
    flex-shrink: 0;
    margin-top: 2px;
    transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }

  .program-card:hover .prog-icon {
    background: var(--blue-100);
    color: var(--blue-700);
  }

  .prog-icon :global(svg) {
    width: 20px;
    height: 20px;
  }

  .prog-title {
    font-size: var(--text-heading-sm);
    font-weight: 700;
    color: var(--color-text-heading);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
    font-family: var(--font-display);
  }

  .prog-desc {
    font-size: var(--text-small);
    line-height: var(--leading-loose);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
    flex: 1;
  }

  /* CTA row — replaces old pill button */
  .prog-cta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-body);
    font-size: var(--text-small);
    font-weight: 600;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .program-card:hover .prog-cta-row {
    color: var(--blue-600);
  }

  .prog-cta-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-surface-100);
    transition:
      background     var(--duration-fast) var(--ease-out),
      transform      var(--duration-normal) var(--ease-spring);
  }

  .prog-cta-arrow svg {
    width: 14px;
    height: 14px;
  }

  .program-card:hover .prog-cta-arrow {
    background: var(--blue-500);
    color: #ffffff;
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .programs-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .our-programs-container {
      padding: 0 var(--space-5);
    }
  }
</style>
