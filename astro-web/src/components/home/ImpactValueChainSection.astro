---
// src/components/home/ImpactValueChainSection.astro
// Section 10: Impact Value Chain — Human-Crafted Editorial Layout (Anti-Slop, No Nested Cards)
const chainSteps = [
  { 
    step: '01', 
    title: 'Donasi & Amanah', 
    desc: 'Penghimpunan dana halal dari donatur perorangan dan korporasi.',
    tag: 'Input'
  },
  { 
    step: '02', 
    title: 'Fasilitas & Sarana', 
    desc: 'Pembangunan masjid, asrama, dan sarana belajar vokasi.',
    tag: 'Infrastruktur'
  },
  { 
    step: '03', 
    title: 'Pembelajaran Adab', 
    desc: 'Kurikulum integratif ilmu syariah, akhlak, dan sains teknologi.',
    tag: 'Pendidikan'
  },
  { 
    step: '04', 
    title: 'Praktik Vokasi', 
    desc: 'Magang teaching factory pada 4 pilar kompetensi industri.',
    tag: 'Keahlian'
  },
  { 
    step: '05', 
    title: 'Kemandirian Usaha', 
    desc: 'Unit agro-technopark dan usaha wakaf produktif bergulir.',
    tag: 'Kemandirian'
  },
  { 
    step: '06', 
    title: 'Dampak Peradaban', 
    desc: 'Generasi berdaya, ekonomi lokal tumbuh, dan jariyah abadi.',
    tag: 'Keberlanjutan'
  }
];

const beneficiaries = [
  {
    num: '01',
    role: 'Santri & Yatim',
    target: 'Generasi Berkarakter',
    text: 'Memperoleh bekal syariah mendalam, pendidikan adab, sertifikasi keahlian vokasi nasional, dan pengalaman kerja riil tanpa beban biaya.'
  },
  {
    num: '02',
    role: 'Pesantren',
    target: 'Kemandirian Lembaga',
    text: 'Memiliki ekosistem sarana modern dan unit usaha produktif mandiri yang menopang operasional dakwah tanpa ketergantungan donasi rutin.'
  },
  {
    num: '03',
    role: 'Masyarakat Sekitar',
    target: 'Pemberdayaan Ekonomi',
    text: 'Menikmati fasilitas ibadah yang asri, terbukanya lapangan kerja agribisnis, serta transfer ilmu dan teknologi pertanian modern.'
  },
  {
    num: '04',
    role: 'Mitra & Donatur',
    target: 'Akuntabilitas Berdampak',
    text: 'Penyaluran CSR dan dana kebajikan dengan laporan transparan, akuntabel, dan berdampak sosial-ekonomi terukur secara jangka panjang.'
  }
];

const fastValues = [
  { letter: 'F', name: 'Fathanah', desc: 'Cerdas, kritis, dan solutif' },
  { letter: 'A', name: 'Amanah', desc: 'Dapat dipercaya dan bertanggung jawab' },
  { letter: 'S', name: 'Siddiq', desc: 'Jujur, lurus, dan berintegritas' },
  { letter: 'T', name: 'Tabligh', desc: 'Komunikatif dan aktif berdakwah' }
];
---

<section class="impact-section" id="dampak">
  <div class="impact-container">
    <!-- Section Header (Clean Typographic, No Artificial Badges) -->
    <div class="impact-header reveal-on-scroll">
      <span class="impact-eyebrow">Rantai Transformasi Nilai YPCI</span>
      <h2 class="impact-title">Ketika Kebaikan Bertumbuh, Dampaknya Ikut Meluas</h2>
      <p class="impact-lead">
        Filantropi sejati bukan hanya mencatat berapa rupiah yang dihimpun, melainkan bagaimana setiap rupiah amanah bertransformasi menjadi kemandirian bagi manusia dan peradaban.
      </p>
    </div>

    <!-- 1. Open Editorial Pipeline Stepper (No Outer Card Wrapper, Clean Horizontal Flow) -->
    <div class="editorial-pipeline reveal-on-scroll">
      <div class="pipeline-track-header">
        <span class="track-heading">Alur Rantai Nilai Berkelanjutan</span>
        <span class="track-count">6 Tahap Realisasi Program</span>
      </div>

      <div class="pipeline-flow">
        {chainSteps.map((s) => (
          <div class="pipeline-node">
            <div class="node-top">
              <span class="node-num">{s.step}</span>
              <span class="node-tag">{s.tag}</span>
            </div>
            <h3 class="node-title">{s.title}</h3>
            <p class="node-desc">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- 2. Beneficiaries: Editorial 4-Column Divided Layout (No Floating Cards, No Box Accent Strips) -->
    <div class="beneficiaries-editorial reveal-on-scroll">
      <div class="beneficiaries-header">
        <span class="beneficiaries-label">Penerima Manfaat Ekosistem</span>
        <h3 class="beneficiaries-heading">Dampak Nyata yang Dirasakan Langsung di Lapangan</h3>
      </div>

      <div class="beneficiaries-columns">
        {beneficiaries.map((b) => (
          <div class="beneficiary-col">
            <div class="col-meta">
              <span class="col-num">{b.num}</span>
              <span class="col-target">{b.target}</span>
            </div>
            <h4 class="col-role">{b.role}</h4>
            <p class="col-text">{b.text}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- 3. FAST Values: Clean Typographic Credo Strip (No Nested Cards inside Cards) -->
    <div class="fast-credo-strip reveal-on-scroll">
      <div class="fast-credo-intro">
        <span class="fast-credo-tag">Standar Nilai Lulusan Santri</span>
        <h4 class="fast-credo-title">Karakter Berbasis FAST</h4>
      </div>
      <div class="fast-credo-items">
        {fastValues.map((v) => (
          <div class="fast-item">
            <span class="fast-badge">{v.letter}</span>
            <div class="fast-meta">
              <span class="fast-name">{v.name}</span>
              <span class="fast-desc">{v.desc}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .impact-section {
    position: relative;
    padding: var(--section-padding-y-lg) 0;
    background-color: #ffffff;
  }

  .impact-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  /* Header */
  .impact-header {
    max-width: 820px;
    margin-bottom: var(--space-9);
  }

  .impact-eyebrow {
    display: inline-block;
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--blue-600);
    margin-bottom: var(--space-3);
  }

  .impact-title {
    font-size: var(--text-heading-lg);
    font-weight: 800;
    line-height: var(--leading-tight);
    color: var(--color-text-heading);
    letter-spacing: var(--tracking-tighter);
    margin: 0 0 var(--space-4) 0;
    font-family: var(--font-display);
  }

  .impact-lead {
    font-size: var(--text-body-lg);
    line-height: var(--leading-loose);
    color: var(--color-text-muted);
    margin: 0;
  }

  /* 1. Pipeline Stepper */
  .editorial-pipeline {
    margin-bottom: var(--space-10);
  }

  .pipeline-track-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-5);
  }

  .track-heading {
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-heading);
  }

  .track-count {
    font-size: var(--text-micro);
    font-weight: 700;
    color: var(--blue-600);
    background-color: var(--blue-50);
    padding: 4px 12px;
    border-radius: var(--radius-full);
  }

  .pipeline-flow {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-4);
  }

  .pipeline-node {
    background: var(--color-surface-50);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-4);
    display: flex;
    flex-direction: column;
    position: relative;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .pipeline-node:hover {
    background: #ffffff;
    border-color: var(--blue-300);
    transform: translateY(-2px);
  }

  .node-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .node-num {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--blue-600);
    background: var(--blue-100);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  .node-tag {
    font-size: var(--text-micro);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .node-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-heading);
    line-height: var(--leading-snug);
    margin: 0 0 var(--space-2) 0;
    font-family: var(--font-display);
  }

  .node-desc {
    font-size: 0.8125rem;
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    margin: 0;
  }

  /* 2. Beneficiaries (4-Card Grid, No Table Borders) */
  .beneficiaries-editorial {
    margin-bottom: var(--space-10);
  }

  .beneficiaries-header {
    margin-bottom: var(--space-6);
  }

  .beneficiaries-label {
    display: block;
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--blue-600);
    margin-bottom: var(--space-2);
  }

  .beneficiaries-heading {
    font-size: var(--text-heading-md);
    font-weight: 800;
    color: var(--color-text-heading);
    letter-spacing: var(--tracking-tight);
    margin: 0;
    font-family: var(--font-display);
  }

  .beneficiaries-columns {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }

  .beneficiary-col {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-7) var(--space-6);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-xs);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .beneficiary-col:hover {
    border-color: var(--blue-300);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .col-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .col-num {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--blue-600);
    background: var(--blue-50);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  .col-target {
    font-size: var(--text-micro);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-text-faint);
  }

  .col-role {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-text-heading);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-2) 0;
    font-family: var(--font-display);
  }

  .col-text {
    font-size: 0.875rem;
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    margin: 0;
  }

  /* 3. FAST Values */
  .fast-credo-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    padding: var(--space-7) var(--space-8);
    background-color: var(--color-surface-50);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
  }

  .fast-credo-intro {
    flex-shrink: 0;
    max-width: 260px;
  }

  .fast-credo-tag {
    display: block;
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--blue-600);
    margin-bottom: var(--space-1);
  }

  .fast-credo-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-text-heading);
    margin: 0;
    letter-spacing: var(--tracking-tight);
    font-family: var(--font-display);
  }

  .fast-credo-items {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
    flex-grow: 1;
  }

  .fast-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .fast-badge {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 800;
    color: #ffffff;
    background-color: var(--blue-600);
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .fast-meta {
    display: flex;
    flex-direction: column;
  }

  .fast-name {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text-heading);
    line-height: var(--leading-snug);
  }

  .fast-desc {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    margin-top: 2px;
  }

  /* Responsive */
  @media (max-width: 1100px) {
    .fast-credo-strip {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-6);
    }
    .fast-credo-intro {
      max-width: 100%;
    }
  }

  @media (max-width: 1024px) {
    .pipeline-flow {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
    }
    .beneficiaries-columns {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
    }
    .fast-credo-items {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .impact-section {
      padding: var(--section-padding-y-sm) 0;
    }
    .impact-container {
      padding: 0 var(--space-5);
    }
    .pipeline-flow {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .beneficiaries-columns {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .fast-credo-items {
      grid-template-columns: 1fr;
    }
  }
</style>
