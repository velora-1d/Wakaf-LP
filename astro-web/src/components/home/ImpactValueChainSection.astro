---
// src/components/home/ImpactValueChainSection.astro
// Section 10: Impact Value Chain — Ketika Kebaikan Bertumbuh, Dampaknya Ikut Meluas
const chainSteps = [
  { step: '01', title: 'DONASI', desc: 'Amanah donatur dihimpun' },
  { step: '02', title: 'FASILITAS & PROGRAM', desc: 'Dibangun sarana fisik' },
  { step: '03', title: 'PEMBELAJARAN', desc: 'Santri belajar & beradab' },
  { step: '04', title: 'KETERAMPILAN', desc: 'Praktik industri nyata' },
  { step: '05', title: 'KEMANDIRIAN', desc: 'Unit usaha bergulir' },
  { step: '06', title: 'DAMPAK LUAS', desc: 'Umat berdaya & makmur' }
];

const beneficiaries = [
  {
    role: 'Untuk Santri',
    tag: 'TALENTA MUDA',
    text: 'Memperoleh bekal ilmu syariah, penguatan karakter adab, keterampilan vokasi bersertifikat, dan pengalaman kerja riil.',
    color: '#0284c7'
  },
  {
    role: 'Untuk Pesantren',
    tag: 'LEMBAGA BERKELANJUTAN',
    text: 'Memiliki ekosistem sarana modern dan unit usaha produktif mandiri yang menopang keberlangsungan dakwah jangka panjang.',
    color: '#059669'
  },
  {
    role: 'Untuk Masyarakat',
    tag: 'EKONOMI & DAKWAH',
    text: 'Mendapat fasilitas ibadah ramah lingkungan, peluang pemberdayaan ekonomi lokal, dan transfer teknologi aplikatif.',
    color: '#d97706'
  },
  {
    role: 'Untuk Mitra',
    tag: 'KOLABORASI SOSIAL',
    text: 'Memperoleh wadah kolaborasi sosial (CSR/ESG) yang akuntabel, transparan, dan berdampak sistemik langsung ke akar rumput.',
    color: '#0ea5e9'
  }
];
---

<section class="impact-section" id="dampak">
  <div class="impact-container">
    <div class="impact-header text-center reveal-on-scroll">
      <div class="impact-pill">
        <span class="pill-dot"></span>
        <span>10 • MEASURABLE IMPACT</span>
      </div>
      <h2 class="impact-title">Ketika Kebaikan Bertumbuh, Dampaknya Ikut Meluas.</h2>
      <p class="impact-lead">
        Website filantropi sejati bukan hanya mencatat berapa rupiah yang dihimpun, melainkan bagaimana setiap amanah bertransformasi menjadi rantai nilai kemandirian bagi manusia dan peradaban.
      </p>
    </div>

    <!-- Value Chain Step Flow (Horizontal on Desktop) -->
    <div class="chain-flow-wrap reveal-on-scroll delay-100">
      <div class="chain-flow-track">
        {chainSteps.map((s, idx) => (
          <div class="chain-step-card">
            <span class="step-num">{s.step}</span>
            <h4 class="step-title">{s.title}</h4>
            <p class="step-desc">{s.desc}</p>
            {idx < chainSteps.length - 1 && (
              <span class="step-arrow" aria-hidden="true">→</span>
            )}
          </div>
        ))}
      </div>
    </div>

    <!-- 4 Beneficiaries Grid -->
    <div class="beneficiaries-grid mt-60">
      {beneficiaries.map((b, idx) => (
        <div class={`benefit-card reveal-on-scroll delay-${(idx + 1) * 100}`} style={`--card-tint: ${b.color};`}>
          <div class="benefit-top">
            <span class="benefit-tag">{b.tag}</span>
            <div class="benefit-indicator"></div>
          </div>
          <h3 class="benefit-role">{b.role}</h3>
          <p class="benefit-text">{b.text}</p>
        </div>
      ))}
    </div>

    <!-- YPCI Fast Character Badge Box -->
    <div class="ypci-character-box reveal-on-scroll mt-50">
      <div class="char-badge-left">
        <span class="char-eyebrow">STANDAR LULUSAN SANTRI YPCI</span>
        <h4 class="char-title">Generasi Alim, FAST, Kompeten, dan Kontributif</h4>
      </div>
      <div class="char-pills-right">
        <span class="pill-fast"><strong>F</strong>athanah (Cerdas)</span>
        <span class="pill-fast"><strong>A</strong>manah (Terpercaya)</span>
        <span class="pill-fast"><strong>S</strong>iddiq (Jujur)</span>
        <span class="pill-fast"><strong>T</strong>abligh (Komunikatif)</span>
      </div>
    </div>
  </div>
</section>

<style>
  .impact-section {
    position: relative;
    padding: 110px 0 120px;
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
  }

  .impact-container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .impact-header {
    max-width: 860px;
    margin: 0 auto 50px;
  }

  .impact-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(2, 132, 199, 0.1);
    border: 1px solid rgba(2, 132, 199, 0.25);
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #0284c7;
    margin-bottom: 20px;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    background-color: #0284c7;
    border-radius: 50%;
  }

  .impact-title {
    font-size: clamp(2.2rem, 3.8vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    color: #0f172a;
    letter-spacing: -0.025em;
    margin-bottom: 18px;
  }

  .impact-lead {
    font-size: 1.1rem;
    line-height: 1.7;
    color: #64748b;
  }

  /* Chain Flow Horizontal Track */
  .chain-flow-wrap {
    overflow-x: auto;
    padding-bottom: 12px;
  }

  .chain-flow-track {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
    min-width: 960px;
  }

  .chain-step-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 22px 18px;
    position: relative;
    display: flex;
    flex-direction: column;
    transition: all 0.25s ease;
  }

  .chain-step-card:hover {
    background: #ffffff;
    border-color: #0284c7;
    box-shadow: 0 10px 25px rgba(2, 132, 199, 0.08);
  }

  .step-num {
    font-size: 0.8rem;
    font-weight: 900;
    color: #0284c7;
    font-family: monospace;
    margin-bottom: 6px;
  }

  .step-title {
    font-size: 0.92rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: 0.01em;
    margin-bottom: 6px;
  }

  .step-desc {
    font-size: 0.82rem;
    line-height: 1.45;
    color: #64748b;
  }

  .step-arrow {
    position: absolute;
    right: -14px;
    top: 50%;
    transform: translateY(-50%);
    color: #cbd5e1;
    font-size: 1.1rem;
    font-weight: 800;
    z-index: 2;
  }

  .mt-60 {
    margin-top: 50px;
  }

  .mt-50 {
    margin-top: 40px;
  }

  /* Beneficiaries Grid */
  .beneficiaries-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .benefit-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .benefit-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: var(--card-tint);
  }

  .benefit-card:hover {
    background: #ffffff;
    transform: translateY(-5px);
    box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);
    border-color: #cbd5e1;
  }

  .benefit-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .benefit-tag {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--card-tint);
  }

  .benefit-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--card-tint);
  }

  .benefit-role {
    font-size: 1.25rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 12px;
  }

  .benefit-text {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #64748b;
  }

  /* YPCI Character Box */
  .ypci-character-box {
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 24px 30px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .char-eyebrow {
    font-size: 0.72rem;
    font-weight: 800;
    color: #0284c7;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 4px;
  }

  .char-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: #0f172a;
  }

  .char-pills-right {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .pill-fast {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.85rem;
    color: #334155;
  }

  .pill-fast strong {
    color: #0284c7;
  }

  @media (max-width: 1024px) {
    .beneficiaries-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .beneficiaries-grid {
      grid-template-columns: 1fr;
    }
    .ypci-character-box {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
