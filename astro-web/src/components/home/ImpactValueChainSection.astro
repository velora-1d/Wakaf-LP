---
// src/components/home/ImpactValueChainSection.astro
// Section 10: Impact Value Chain — Human-Crafted Editorial Layout (Anti-Slop, No Nested Cards)
const chainSteps = [
  { 
    step: '01', 
    title: 'Donasi & Amanah', 
    desc: 'Penghimpunan dana halal dari donatur perorangan dan korporasi.',
    tag: 'Input'
  },
  { 
    step: '02', 
    title: 'Fasilitas & Sarana', 
    desc: 'Pembangunan masjid, asrama, dan sarana belajar vokasi.',
    tag: 'Infrastruktur'
  },
  { 
    step: '03', 
    title: 'Pembelajaran Adab', 
    desc: 'Kurikulum integratif ilmu syariah, akhlak, dan sains teknologi.',
    tag: 'Pendidikan'
  },
  { 
    step: '04', 
    title: 'Praktik Vokasi', 
    desc: 'Magang teaching factory pada 4 pilar kompetensi industri.',
    tag: 'Keahlian'
  },
  { 
    step: '05', 
    title: 'Kemandirian Usaha', 
    desc: 'Unit agro-technopark dan usaha wakaf produktif bergulir.',
    tag: 'Kemandirian'
  },
  { 
    step: '06', 
    title: 'Dampak Peradaban', 
    desc: 'Generasi berdaya, ekonomi lokal tumbuh, dan jariyah abadi.',
    tag: 'Keberlanjutan'
  }
];

const beneficiaries = [
  {
    num: '01',
    role: 'Santri & Yatim',
    target: 'Generasi Berkarakter',
    text: 'Memperoleh bekal syariah mendalam, pendidikan adab, sertifikasi keahlian vokasi nasional, dan pengalaman kerja riil tanpa beban biaya.'
  },
  {
    num: '02',
    role: 'Pesantren',
    target: 'Kemandirian Lembaga',
    text: 'Memiliki ekosistem sarana modern dan unit usaha produktif mandiri yang menopang operasional dakwah tanpa ketergantungan donasi rutin.'
  },
  {
    num: '03',
    role: 'Masyarakat Sekitar',
    target: 'Pemberdayaan Ekonomi',
    text: 'Menikmati fasilitas ibadah yang asri, terbukanya lapangan kerja agribisnis, serta transfer ilmu dan teknologi pertanian modern.'
  },
  {
    num: '04',
    role: 'Mitra & Donatur',
    target: 'Akuntabilitas Berdampak',
    text: 'Penyaluran CSR dan dana kebajikan dengan laporan transparan, akuntabel, dan berdampak sosial-ekonomi terukur secara jangka panjang.'
  }
];

const fastValues = [
  { letter: 'F', name: 'Fathanah', desc: 'Cerdas, kritis, dan solutif' },
  { letter: 'A', name: 'Amanah', desc: 'Dapat dipercaya dan bertanggung jawab' },
  { letter: 'S', name: 'Siddiq', desc: 'Jujur, lurus, dan berintegritas' },
  { letter: 'T', name: 'Tabligh', desc: 'Komunikatif dan aktif berdakwah' }
];
---

<section class="impact-section" id="dampak">
  <div class="impact-container">
    <!-- Section Header (Clean Typographic, No Artificial Badges) -->
    <div class="impact-header reveal-on-scroll">
      <span class="impact-eyebrow">Rantai Transformasi Nilai YPCI</span>
      <h2 class="impact-title">Ketika Kebaikan Bertumbuh, Dampaknya Ikut Meluas</h2>
      <p class="impact-lead">
        Filantropi sejati bukan hanya mencatat berapa rupiah yang dihimpun, melainkan bagaimana setiap rupiah amanah bertransformasi menjadi kemandirian bagi manusia dan peradaban.
      </p>
    </div>

    <!-- 1. Continuous Editorial Timeline Rail (Stripe/Linear Inspired, Zero Card Boxes) -->
    <div class="editorial-timeline reveal-on-scroll">
      <div class="timeline-header">
        <span class="timeline-eyebrow">Alur Rantai Nilai Berkelanjutan</span>
        <span class="timeline-meta">6 Tahap Realisasi Terintegrasi</span>
      </div>

      <div class="timeline-rail-wrap">
        <div class="timeline-track-line" aria-hidden="true"></div>
        <ol class="timeline-steps" role="list">
          {chainSteps.map((s) => (
            <li class="timeline-step">
              <div class="step-milestone">
                <span class="step-node-dot" aria-hidden="true"></span>
                <span class="step-num">{s.step}</span>
              </div>
              <span class="step-tag">{s.tag}</span>
              <h3 class="step-title">{s.title}</h3>
              <p class="step-desc">{s.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <!-- 2. Beneficiaries: Open Editorial Column Storytelling (Gates Foundation / McKinsey Style, Zero Card Boxes) -->
    <div class="beneficiaries-section reveal-on-scroll">
      <div class="beneficiaries-header">
        <span class="beneficiaries-eyebrow">Penerima Manfaat Ekosistem</span>
        <h3 class="beneficiaries-heading">Dampak Nyata yang Dirasakan Langsung di Lapangan</h3>
      </div>

      <div class="beneficiaries-grid">
        {beneficiaries.map((b) => (
          <article class="beneficiary-col">
            <div class="beneficiary-top">
              <span class="beneficiary-num" aria-hidden="true">{b.num}</span>
              <span class="beneficiary-target">{b.target}</span>
            </div>
            <h4 class="beneficiary-role">{b.role}</h4>
            <p class="beneficiary-story">{b.text}</p>
          </article>
        ))}
      </div>
    </div>

    <!-- 3. FAST Character Stand: Open Typographic Credo Bar (Zero Outer Container Boxes) -->
    <div class="fast-credo-section reveal-on-scroll">
      <div class="fast-credo-content">
        <div class="fast-credo-lead">
          <span class="fast-eyebrow">Standar Karakter Santri</span>
          <h4 class="fast-title">Karakter Berbasis FAST</h4>
          <p class="fast-summary">Nilai profetik yang menjadi kompas kepemimpinan dan etos kerja seluruh santri lulusan.</p>
        </div>
        <div class="fast-grid">
          {fastValues.map((v) => (
            <div class="fast-node">
              <span class="fast-letter" aria-hidden="true">{v.letter}</span>
              <div class="fast-detail">
                <strong class="fast-name">{v.name}</strong>
                <span class="fast-desc">{v.desc}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .impact-section {
    position: relative;
    padding: var(--section-padding-y-lg) 0;
    background-color: #ffffff;
  }

  .impact-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  /* Header */
  .impact-header {
    max-width: 820px;
    margin-bottom: var(--space-9);
  }

  .impact-eyebrow {
    display: inline-block;
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--blue-600);
    margin-bottom: var(--space-3);
  }

  .impact-title {
    font-size: var(--text-heading-lg);
    font-weight: 800;
    line-height: var(--leading-tight);
    color: var(--color-text-heading);
    letter-spacing: var(--tracking-tighter);
    margin: 0 0 var(--space-4) 0;
    font-family: var(--font-display);
  }

  .impact-lead {
    font-size: var(--text-body-lg);
    line-height: var(--leading-loose);
    color: var(--color-text-muted);
    margin: 0;
  }

  /* 1. Continuous Editorial Timeline Rail */
  .editorial-timeline {
    margin-bottom: var(--space-10);
  }

  .timeline-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-6);
  }

  .timeline-eyebrow {
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-heading);
  }

  .timeline-meta {
    font-size: var(--text-micro);
    font-weight: 700;
    color: var(--blue-600);
    background-color: var(--blue-50);
    padding: 4px 12px;
    border-radius: var(--radius-full);
  }

  .timeline-rail-wrap {
    position: relative;
    padding-top: var(--space-2);
  }

  .timeline-track-line {
    position: absolute;
    top: 15px;
    left: 20px;
    right: 20px;
    height: 2px;
    background-color: var(--color-border);
    z-index: 1;
  }

  .timeline-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-5);
    position: relative;
    z-index: 2;
  }

  .timeline-step {
    display: flex;
    flex-direction: column;
    padding: 0;
    background: transparent;
    border: none;
    box-shadow: none;
  }

  .step-milestone {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .step-node-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 3px solid var(--blue-600);
    box-shadow: 0 0 0 4px #ffffff;
    flex-shrink: 0;
  }

  .step-num {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--blue-700);
    letter-spacing: 0.04em;
  }

  .step-tag {
    font-size: var(--text-micro);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-text-faint);
    margin-bottom: var(--space-2);
  }

  .step-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-heading);
    line-height: var(--leading-snug);
    margin: 0 0 var(--space-2) 0;
    font-family: var(--font-display);
  }

  .step-desc {
    font-size: 0.8125rem;
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    margin: 0;
  }

  /* 2. Open Editorial Beneficiaries Columns */
  .beneficiaries-section {
    margin-bottom: var(--space-10);
  }

  .beneficiaries-header {
    margin-bottom: var(--space-6);
  }

  .beneficiaries-eyebrow {
    display: block;
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--blue-600);
    margin-bottom: var(--space-2);
  }

  .beneficiaries-heading {
    font-size: var(--text-heading-md);
    font-weight: 800;
    color: var(--color-text-heading);
    letter-spacing: var(--tracking-tight);
    margin: 0;
    font-family: var(--font-display);
  }

  .beneficiaries-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-7);
    padding-top: var(--space-7);
    border-top: 1px solid var(--color-border);
  }

  .beneficiary-col {
    display: flex;
    flex-direction: column;
    padding: 0;
    background: transparent;
    border: none;
    box-shadow: none;
  }

  .beneficiary-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .beneficiary-num {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--blue-600);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .beneficiary-target {
    font-size: var(--text-micro);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-text-faint);
  }

  .beneficiary-role {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-text-heading);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-3) 0;
    font-family: var(--font-display);
  }

  .beneficiary-story {
    font-size: 0.875rem;
    line-height: var(--leading-loose);
    color: var(--color-text-muted);
    margin: 0;
  }

  /* 3. FAST Typographic Credo Section */
  .fast-credo-section {
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .fast-credo-content {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: var(--space-8);
    align-items: flex-start;
  }

  .fast-credo-lead {
    display: flex;
    flex-direction: column;
  }

  .fast-eyebrow {
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--blue-600);
    margin-bottom: var(--space-2);
  }

  .fast-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-text-heading);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-2) 0;
    font-family: var(--font-display);
  }

  .fast-summary {
    font-size: 0.875rem;
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    margin: 0;
  }

  .fast-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }

  .fast-node {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .fast-letter {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--blue-600);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .fast-detail {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .fast-name {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text-heading);
    line-height: var(--leading-snug);
  }

  .fast-desc {
    font-size: 0.8125rem;
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }

  /* Responsive Reflow */
  @media (max-width: 1024px) {
    .timeline-steps {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6) var(--space-4);
    }

    .timeline-track-line {
      display: none;
    }

    .beneficiaries-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }

    .fast-credo-content {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .fast-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
    }
  }

  @media (max-width: 640px) {
    .impact-section {
      padding: var(--section-padding-y-sm) 0;
    }

    .impact-container {
      padding: 0 var(--space-5);
    }

    .timeline-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .timeline-steps {
      grid-template-columns: 1fr;
      gap: var(--space-5);
      padding-left: var(--space-6);
      border-left: 2px solid var(--color-border);
      position: relative;
    }

    .timeline-step {
      position: relative;
    }

    .step-milestone {
      position: relative;
    }

    .step-node-dot {
      position: absolute;
      left: calc(-1 * var(--space-6) - 8px);
      top: 2px;
    }

    .beneficiaries-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .fast-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
