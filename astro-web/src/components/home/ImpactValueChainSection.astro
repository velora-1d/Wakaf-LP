---
// src/components/home/ImpactValueChainSection.astro
// Section 10: Impact Value Chain — Human-Crafted Editorial Layout (Anti-Slop, No Nested Cards)
const chainSteps = [
  { 
    step: '01', 
    title: 'Donasi & Amanah', 
    desc: 'Penghimpunan dana halal dari donatur perorangan dan korporasi.',
    tag: 'Input'
  },
  { 
    step: '02', 
    title: 'Fasilitas & Sarana', 
    desc: 'Pembangunan masjid, asrama, dan sarana belajar vokasi.',
    tag: 'Infrastruktur'
  },
  { 
    step: '03', 
    title: 'Pembelajaran Adab', 
    desc: 'Kurikulum integratif ilmu syariah, akhlak, dan sains teknologi.',
    tag: 'Pendidikan'
  },
  { 
    step: '04', 
    title: 'Praktik Vokasi', 
    desc: 'Magang teaching factory pada 4 pilar kompetensi industri.',
    tag: 'Keahlian'
  },
  { 
    step: '05', 
    title: 'Kemandirian Usaha', 
    desc: 'Unit agro-technopark dan usaha wakaf produktif bergulir.',
    tag: 'Kemandirian'
  },
  { 
    step: '06', 
    title: 'Dampak Peradaban', 
    desc: 'Generasi berdaya, ekonomi lokal tumbuh, dan jariyah abadi.',
    tag: 'Keberlanjutan'
  }
];

const beneficiaries = [
  {
    num: '01',
    role: 'Santri & Yatim',
    target: 'Generasi Berkarakter',
    text: 'Memperoleh bekal syariah mendalam, pendidikan adab, sertifikasi keahlian vokasi nasional, dan pengalaman kerja riil tanpa beban biaya.'
  },
  {
    num: '02',
    role: 'Pesantren',
    target: 'Kemandirian Lembaga',
    text: 'Memiliki ekosistem sarana modern dan unit usaha produktif mandiri yang menopang operasional dakwah tanpa ketergantungan donasi rutin.'
  },
  {
    num: '03',
    role: 'Masyarakat Sekitar',
    target: 'Pemberdayaan Ekonomi',
    text: 'Menikmati fasilitas ibadah yang asri, terbukanya lapangan kerja agribisnis, serta transfer ilmu dan teknologi pertanian modern.'
  },
  {
    num: '04',
    role: 'Mitra & Donatur',
    target: 'Akuntabilitas Berdampak',
    text: 'Penyaluran CSR dan dana kebajikan dengan laporan transparan, akuntabel, dan berdampak sosial-ekonomi terukur secara jangka panjang.'
  }
];

const fastValues = [
  { letter: 'F', name: 'Fathanah', desc: 'Cerdas, kritis, dan solutif' },
  { letter: 'A', name: 'Amanah', desc: 'Dapat dipercaya dan bertanggung jawab' },
  { letter: 'S', name: 'Siddiq', desc: 'Jujur, lurus, dan berintegritas' },
  { letter: 'T', name: 'Tabligh', desc: 'Komunikatif dan aktif berdakwah' }
];
---

<section class="impact-section" id="dampak">
  <div class="impact-container">
    <!-- Section Header (Clean Typographic, No Artificial Badges) -->
    <div class="impact-header reveal-on-scroll">
      <span class="impact-eyebrow">Rantai Transformasi Nilai YPCI</span>
      <h2 class="impact-title">Ketika Kebaikan Bertumbuh, Dampaknya Ikut Meluas</h2>
      <p class="impact-lead">
        Filantropi sejati bukan hanya mencatat berapa rupiah yang dihimpun, melainkan bagaimana setiap rupiah amanah bertransformasi menjadi kemandirian bagi manusia dan peradaban.
      </p>
    </div>

    <!-- 1. Open Editorial Pipeline Stepper (No Outer Card Wrapper, Clean Horizontal Flow) -->
    <div class="editorial-pipeline reveal-on-scroll">
      <div class="pipeline-track-header">
        <span class="track-heading">Alur Rantai Nilai Berkelanjutan</span>
        <span class="track-count">6 Tahap Realisasi Program</span>
      </div>

      <div class="pipeline-flow">
        {chainSteps.map((s) => (
          <div class="pipeline-node">
            <div class="node-top">
              <span class="node-num">{s.step}</span>
              <span class="node-tag">{s.tag}</span>
            </div>
            <h3 class="node-title">{s.title}</h3>
            <p class="node-desc">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- 2. Beneficiaries: Editorial 4-Column Divided Layout (No Floating Cards, No Box Accent Strips) -->
    <div class="beneficiaries-editorial reveal-on-scroll">
      <div class="beneficiaries-header">
        <span class="beneficiaries-label">Penerima Manfaat Ekosistem</span>
        <h3 class="beneficiaries-heading">Dampak Nyata yang Dirasakan Langsung di Lapangan</h3>
      </div>

      <div class="beneficiaries-columns">
        {beneficiaries.map((b) => (
          <div class="beneficiary-col">
            <div class="col-meta">
              <span class="col-num">{b.num}</span>
              <span class="col-target">{b.target}</span>
            </div>
            <h4 class="col-role">{b.role}</h4>
            <p class="col-text">{b.text}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- 3. FAST Values: Clean Typographic Credo Strip (No Nested Cards inside Cards) -->
    <div class="fast-credo-strip reveal-on-scroll">
      <div class="fast-credo-intro">
        <span class="fast-credo-tag">Standar Nilai Lulusan Santri</span>
        <h4 class="fast-credo-title">Karakter Berbasis FAST</h4>
      </div>
      <div class="fast-credo-items">
        {fastValues.map((v) => (
          <div class="fast-item">
            <span class="fast-badge">{v.letter}</span>
            <div class="fast-meta">
              <span class="fast-name">{v.name}</span>
              <span class="fast-desc">{v.desc}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  .impact-section {
    position: relative;
    padding: 100px 0 120px;
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
  }

  .impact-container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Header — Clean Typography, No Slop Badges */
  .impact-header {
    max-width: 820px;
    margin-bottom: 60px;
  }

  .impact-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #0284c7;
    margin-bottom: 12px;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  .impact-title {
    font-size: clamp(2.2rem, 3.8vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    color: #0f172a;
    letter-spacing: -0.025em;
    margin: 0 0 16px 0;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  .impact-lead {
    font-size: 1.1rem;
    line-height: 1.7;
    color: #64748b;
    margin: 0;
  }

  /* 1. Open Editorial Pipeline Stepper */
  .editorial-pipeline {
    margin-bottom: 72px;
    padding-bottom: 56px;
    border-bottom: 1px solid #e2e8f0;
  }

  .pipeline-track-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 20px;
    border-bottom: 1px solid #f1f5f9;
    margin-bottom: 32px;
  }

  .track-heading {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #0f172a;
    font-family: 'Golos Text', sans-serif;
  }

  .track-count {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 600;
    color: #64748b;
  }

  .pipeline-flow {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 32px;
    position: relative;
  }

  .pipeline-node {
    display: flex;
    flex-direction: column;
    position: relative;
    padding-top: 18px;
    border-top: 2px solid #e2e8f0;
    transition: border-color 0.2s ease;
  }

  .pipeline-node:hover {
    border-top-color: #0284c7;
  }

  .node-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .node-num {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.95rem;
    font-weight: 800;
    color: #0284c7;
    letter-spacing: -0.02em;
  }

  .node-tag {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #94a3b8;
  }

  .node-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.25;
    margin: 0 0 8px 0;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  .node-desc {
    font-size: 0.85rem;
    line-height: 1.55;
    color: #64748b;
    margin: 0;
  }

  /* 2. Beneficiaries — Editorial 4-Column Divided Layout */
  .beneficiaries-editorial {
    margin-bottom: 64px;
  }

  .beneficiaries-header {
    margin-bottom: 36px;
  }

  .beneficiaries-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #0284c7;
    margin-bottom: 8px;
    font-family: 'Golos Text', sans-serif;
  }

  .beneficiaries-heading {
    font-size: 1.6rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
    margin: 0;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  .beneficiaries-columns {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
  }

  .beneficiary-col {
    padding: 36px 28px;
    border-right: 1px solid #e2e8f0;
    display: flex;
    flex-direction: column;
    transition: background-color 0.2s ease;
  }

  .beneficiary-col:first-child {
    padding-left: 0;
  }

  .beneficiary-col:last-child {
    border-right: none;
    padding-right: 0;
  }

  .beneficiary-col:hover {
    background-color: #f8fafc;
  }

  .col-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .col-num {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.85rem;
    font-weight: 700;
    color: #94a3b8;
  }

  .col-target {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #0284c7;
  }

  .col-role {
    font-size: 1.25rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.015em;
    margin: 0 0 10px 0;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  .col-text {
    font-size: 0.9rem;
    line-height: 1.65;
    color: #64748b;
    margin: 0;
  }

  /* 3. FAST Credo Strip — Clean Typography, Zero Nested Boxes */
  .fast-credo-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
    padding: 32px 36px;
    background-color: #f8fafc;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
  }

  .fast-credo-intro {
    flex-shrink: 0;
    max-width: 280px;
  }

  .fast-credo-tag {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #0284c7;
    margin-bottom: 4px;
    font-family: 'Golos Text', sans-serif;
  }

  .fast-credo-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    letter-spacing: -0.015em;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  .fast-credo-items {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    flex-grow: 1;
  }

  .fast-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .fast-badge {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8rem;
    font-weight: 800;
    color: #0284c7;
    background-color: #e0f2fe;
    width: 22px;
    height: 22px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .fast-meta {
    display: flex;
    flex-direction: column;
  }

  .fast-name {
    font-size: 0.88rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.25;
  }

  .fast-desc {
    font-size: 0.75rem;
    color: #64748b;
    line-height: 1.4;
    margin-top: 2px;
  }

  /* Responsive Breakpoints */
  @media (max-width: 1200px) {
    .fast-credo-strip {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }
    .fast-credo-intro {
      max-width: 100%;
    }
  }

  @media (max-width: 1024px) {
    .pipeline-flow {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .beneficiaries-columns {
      grid-template-columns: repeat(2, 1fr);
    }
    .beneficiary-col:nth-child(2) {
      border-right: none;
      padding-right: 0;
    }
    .beneficiary-col:nth-child(3) {
      border-top: 1px solid #e2e8f0;
      padding-left: 0;
    }
    .beneficiary-col:nth-child(4) {
      border-top: 1px solid #e2e8f0;
      border-right: none;
      padding-right: 0;
    }
    .fast-credo-items {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .pipeline-flow {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .pipeline-node {
      border-top: none;
      border-left: 2px solid #0284c7;
      padding-top: 0;
      padding-left: 16px;
    }
    .beneficiaries-columns {
      grid-template-columns: 1fr;
    }
    .beneficiary-col {
      border-right: none !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
      border-bottom: 1px solid #e2e8f0;
    }
    .beneficiary-col:last-child {
      border-bottom: none;
    }
    .fast-credo-items {
      grid-template-columns: 1fr;
    }
  }
</style>
