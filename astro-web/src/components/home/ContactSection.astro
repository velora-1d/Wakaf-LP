---
// src/components/home/ContactSection.astro
// GVF Contact Section UI/UX & Animations
---

<section class="gvf-contact-section reveal-on-scroll" id="rekening">
  <div id="kontak" class="gvf-anchor-target"></div>

  <div class="gvf-contact-container">
    <!-- Header Row Split: Left Tag, Right Big Title -->
    <div class="gvf-contact-header-wrap">
      <div class="gvf-contact-heading-grid">
        <div class="gvf-heading-left">
          <span class="section-kicker reveal-on-scroll">Konsultasi & Kontak</span>
        </div>
        <div class="gvf-heading-right">
          <h2 class="gvf-contact-main-title reveal-heading">
            Punya Niat Wakaf <span class="gvf-blue-accent">&amp; Pertanyaan?</span><br />
            Wujudkan Bersama Kami
          </h2>
          <p class="gvf-contact-subtitle reveal-on-scroll" data-delay="0.12">
            Bicaralah dengan tim pengurus dan nazhir kami, tanpa kewajiban dan tanpa tekanan. Kami siap memandu Anda dari niat awal, pemilihan akad, hingga penerbitan akta ikrar wakaf resmi.
          </p>
        </div>
      </div>
    </div>

    <!-- Main Content: 2-Column Split (Left Info, Right Form) -->
    <div class="gvf-contact-body-grid">
      <!-- Left Column: Contact Cards -->
      <div class="gvf-contact-info-col">
        <div class="gvf-info-card">
          <div class="gvf-info-item">
            <span class="gvf-info-label">Alamat Kantor &amp; Lokasi</span>
            <p class="gvf-info-text">
              Kampus SMK Skill Village Islamic School, <br />
              Desa Sukasirna, Kec. Jonggol, <br />
              Kabupaten Bogor, Jawa Barat 16830
            </p>
          </div>

          <div class="gvf-info-item">
            <span class="gvf-info-label">Kontak Resmi</span>
            <a href="tel:+6281226832326" class="gvf-info-link gvf-link-phone">
              +62 812-2683-2326
            </a>
            <a
              href="https://wa.me/6281226832326?text=Assalamualaikum%20Admin%20GVF%2C%20saya%20ingin%20konsultasi%20program%20wakaf."
              target="_blank"
              rel="noopener noreferrer"
              class="gvf-info-link gvf-link-wa"
            >
              <span>WhatsApp Fast Response</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="display: inline-block; vertical-align: middle; margin-left: 4px;">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <a href="mailto:info@globalvillagefund.org" class="gvf-info-link">
              info@globalvillagefund.org
            </a>
          </div>

          <div class="gvf-info-item">
            <span class="gvf-info-label">Sosial Media</span>
            <div class="gvf-social-links-stacked">
              <a href="https://instagram.com/globalvillagefund" target="_blank" rel="noopener noreferrer" class="gvf-info-link">
                Instagram @globalvillagefund
              </a>
              <a href="https://globalvillagefund.org" target="_blank" rel="noopener noreferrer" class="gvf-info-link">
                Website: www.globalvillagefund.org
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Consultation Form -->
      <div class="gvf-contact-form-col">
        <form id="gvfContactForm" class="gvf-contact-form">
          <div class="gvf-form-row">
            <div class="gvf-form-group">
              <label for="contactFullName" class="gvf-form-label">Nama Lengkap *</label>
              <input
                type="text"
                id="contactFullName"
                name="fullname"
                class="gvf-form-input"
                placeholder="Nama lengkap Anda"
                required
              />
            </div>
            <div class="gvf-form-group">
              <label for="contactPhone" class="gvf-form-label">Telepon / WhatsApp *</label>
              <input
                type="tel"
                id="contactPhone"
                name="phone"
                class="gvf-form-input"
                placeholder="0812-3456-7890"
                required
              />
            </div>
          </div>

          <div class="gvf-form-row">
            <div class="gvf-form-group">
              <label for="contactEmail" class="gvf-form-label">Alamat Email *</label>
              <input
                type="email"
                id="contactEmail"
                name="email"
                class="gvf-form-input"
                placeholder="contoh@email.com"
                required
              />
            </div>
            <div class="gvf-form-group">
              <label for="contactService" class="gvf-form-label">Pilihan Program *</label>
              <select id="contactService" name="service" class="gvf-form-input gvf-form-select" required>
                <option value="" disabled selected>-- Pilih Program Wakaf --</option>
                <option value="Wakaf Masjid Khairu Ummah">Wakaf Masjid Khairu Ummah</option>
                <option value="Wakaf SMK Skill Village">Wakaf SMK Skill Village Islamic School</option>
                <option value="Wakaf Produktif Agro-Technopark">Wakaf Produktif Kebun Anggur</option>
                <option value="Konsultasi Akad & Niat Wakaf">Konsultasi Akad &amp; Niat Wakaf</option>
                <option value="Lainnya">Pertanyaan Lainnya</option>
              </select>
            </div>
          </div>

          <div class="gvf-form-group gvf-form-full">
            <label for="contactMessage" class="gvf-form-label">Pesan / Pertanyaan *</label>
            <textarea
              id="contactMessage"
              name="message"
              rows="4"
              class="gvf-form-input gvf-form-textarea"
              placeholder="Ceritakan rencana, niat wakaf, atau pertanyaan yang ingin Anda konsultasikan..."
              required
            ></textarea>
          </div>

          <button type="submit" class="gvf-submit-btn" id="contactSubmitBtn">
            <span>Kirim Pesan / Konsultasi Sekarang</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  // Handle Contact Form Submission to WhatsApp Fast Response
  const form = document.getElementById('gvfContactForm') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('contactFullName') as HTMLInputElement)?.value || '';
      const phone = (document.getElementById('contactPhone') as HTMLInputElement)?.value || '';
      const email = (document.getElementById('contactEmail') as HTMLInputElement)?.value || '';
      const service = (document.getElementById('contactService') as HTMLSelectElement)?.value || '';
      const message = (document.getElementById('contactMessage') as HTMLTextAreaElement)?.value || '';

      const waText = encodeURIComponent(
        `Assalamualaikum Admin Global Village Fund,\n\nSaya ingin berkonsultasi mengenai program wakaf:\n` +
        `• Nama: ${name}\n` +
        `• No. Kontak: ${phone}\n` +
        `• Email: ${email}\n` +
        `• Pilihan Program: ${service}\n` +
        `• Pesan: ${message}`
      );

      window.open(`https://wa.me/6281226832326?text=${waText}`, '_blank');
    });
  }
</script>

<style>
  .gvf-contact-section {
    position: relative;
    padding: 100px 0 120px 0;
    background-color: #f7f9fc;
    overflow: hidden;
  }

  .gvf-anchor-target {
    position: absolute;
    top: -85px;
    left: 0;
  }

  .gvf-contact-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 1;
  }

  /* Header Wrap */
  .gvf-contact-header-wrap {
    margin-bottom: 4rem;
  }

  .gvf-contact-heading-grid {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 3rem;
    align-items: flex-start;
  }

  .gvf-contact-main-title {
    font-size: clamp(2.3rem, 4vw, 3.4rem);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
    margin: 0 0 1rem 0;
  }

  .gvf-blue-accent {
    color: #0969da;
  }

  .gvf-contact-subtitle {
    font-size: 1.05rem;
    color: #64748b;
    line-height: 1.65;
    max-width: 720px;
    margin: 0;
  }

  /* Body 2-Col Grid */
  .gvf-contact-body-grid {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 3.5rem;
    align-items: flex-start;
  }

  /* Left Column: Info Card */
  .gvf-info-card {
    background-color: #ffffff;
    border-radius: 24px;
    padding: 2.5rem;
    box-shadow: none;
    border: 1px solid #e5e7eb;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .gvf-info-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #0969da;
    margin-bottom: 0.6rem;
    font-family: 'Golos Text', sans-serif;
  }

  .gvf-info-text {
    font-size: 0.95rem;
    line-height: 1.65;
    color: #334155;
    margin: 0;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  .gvf-info-link {
    display: block;
    font-size: 0.95rem;
    color: #334155;
    text-decoration: none;
    margin-bottom: 0.5rem;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .gvf-info-link:hover {
    color: #0969da;
  }

  .gvf-link-phone {
    font-size: 1.25rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.01em;
  }

  .gvf-link-wa {
    color: #10b981;
    font-weight: 700;
  }

  .gvf-link-wa:hover {
    color: #059669;
  }

  .gvf-social-links-stacked {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  /* Right Column: Form */
  .gvf-contact-form {
    background-color: #ffffff;
    border-radius: 24px;
    padding: 2.5rem;
    box-shadow: none;
    border: 1px solid #e5e7eb;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .gvf-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .gvf-form-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .gvf-form-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: #1e293b;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  .gvf-form-input {
    width: 100%;
    padding: 0.85rem 1.15rem;
    font-size: 0.92rem;
    color: #0f172a;
    background-color: #f8fafc;
    border: 1px solid rgba(203, 213, 225, 0.8);
    border-radius: 10px;
    transition: all 0.25s ease;
    font-family: inherit;
    box-sizing: border-box;
  }

  .gvf-form-input:focus {
    outline: none;
    background-color: #ffffff;
    border-color: #0969da;
    box-shadow: none;
  }

  .gvf-form-select {
    cursor: pointer;
  }

  .gvf-form-textarea {
    resize: vertical;
    min-height: 100px;
  }

  .gvf-submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background-color: #0969da;
    color: #ffffff;
    font-size: 1rem;
    font-weight: 700;
    padding: 1rem 2rem;
    border-radius: 9999px;
    border: none;
    cursor: pointer;
    transition: all 0.25s ease;
    box-shadow: none;
    margin-top: 0.5rem;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  .gvf-submit-btn:hover {
    background-color: #0858b8;
    transform: translateY(-2px);
    box-shadow: none;
  }

  @media (max-width: 1024px) {
    .gvf-contact-heading-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .gvf-contact-body-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .gvf-contact-section {
      padding: 60px 0 80px 0;
    }
    .gvf-form-row {
      grid-template-columns: 1fr;
    }
    .gvf-info-card,
    .gvf-contact-form {
      padding: 1.5rem;
    }
  }
</style>
