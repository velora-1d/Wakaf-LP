---
// src/components/home/OurApproachSection.astro
// Modul 6 Tahap Pendekatan & Transformasi (Modular 3x2 Matrix sesuai Desain Referensi)

interface ApproachModule {
  num: string;
  name: string;
  focus: string;
  desc: string;
  bgClass: string;
}

const approachModules: ApproachModule[] = [
  {
    num: '1',
    name: 'Kebaikan',
    focus: 'Filantropi & Wakaf Umat',
    desc: 'Menghimpun amanah infaq, sedekah, zakat, dan wakaf produktif secara transparan dari para donatur dan masyarakat luas.',
    bgClass: 'cell-shade-1',
  },
  {
    num: '2',
    name: 'Pendidikan',
    focus: 'Karakter & Fasilitas Pembelajaran',
    desc: 'Membangun sarana belajar representatif, masjid beradab, dan kurikulum FAST sebagai fondasi akhlak santri.',
    bgClass: 'cell-shade-2',
  },
  {
    num: '3',
    name: 'Kompetensi',
    focus: 'Vokasi & Keterampilan Riil',
    desc: 'Membekali santri keahlian vokasi terapan (arsitektur, agriteknologi, digital) melalui laboratorium praktik nyata.',
    bgClass: 'cell-shade-3',
  },
  {
    num: '4',
    name: 'Kemandirian',
    focus: 'Agroteknopreneur & Unit Usaha',
    desc: 'Mengembangkan unit usaha mandiri pesantren (Greenhouse, Agro-Technopark) agar mandiri tanpa terus bergantung donasi.',
    bgClass: 'cell-shade-4',
  },
  {
    num: '5',
    name: 'Kolaborasi',
    focus: 'Kemitraan Industri & Komunitas',
    desc: 'Menyambungkan santri dengan dunia industri, asosiasi profesi, akademisi, dan jaringan pasar terpercaya.',
    bgClass: 'cell-shade-5',
  },
  {
    num: '6',
    name: 'Dampak Sosial',
    focus: 'Muzakki Baru & Berdaya',
    desc: 'Mencetak lulusan berdaya saing yang mandiri secara ekonomi dan kembali menebar manfaat luas sebagai muzakki baru.',
    bgClass: 'cell-shade-6',
  },
];
---

<section class="approach-section" id="pendekatan">
  <div class="approach-container">
    <!-- Section Heading -->
    <div class="approach-header reveal-on-scroll">
      <h2 class="approach-title">
        Dari Kebaikan Menjadi Kebermanfaatan.
      </h2>
      <p class="approach-desc">
        Kami percaya bahwa dukungan yang tepat dapat membangun kemampuan, bukan hanya memenuhi kebutuhan sesaat. Inilah yang menjadi pembeda Global Village Fund.
      </p>
    </div>

    <!-- 6-Block Modular Grid Container (Sesuai Referensi Gambar) -->
    <div class="matrix-card-wrapper reveal-on-scroll delay-100">
      <div class="matrix-grid">
        {approachModules.map((item) => (
          <div class:list={['matrix-cell', item.bgClass]}>
            <!-- Badge Angka Kotak Oranye/Kuning -->
            <div class="badge-square">
              <span>{item.num}</span>
            </div>

            <!-- Judul & Subjudul / Focus -->
            <h3 class="cell-title">{item.name}</h3>
            <span class="cell-focus">{item.focus}</span>

            <!-- Deskripsi -->
            <p class="cell-desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:inline>
  .approach-section {
    position: relative;
    padding: 90px 0 100px;
    background-color: #fafafc;
    border: none;
  }

  .approach-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Header Section */
  .approach-header {
    max-width: 860px;
    margin-bottom: 48px;
  }

  .isavo-pill-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: #e0f2fe;
    border: 1px solid #bae6fd;
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #0369a1;
    margin-bottom: 20px;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    background-color: #0052cc;
    border-radius: 50%;
  }

  .approach-title {
    font-size: clamp(2.2rem, 3.8vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    color: #0f172a;
    letter-spacing: -0.025em;
    margin-bottom: 16px;
  }

  .approach-desc {
    font-size: 1.05rem;
    line-height: 1.68;
    color: #475569;
    max-width: 780px;
    margin: 0;
  }

  /* Matrix Unified Container Card (Tanpa Garis Tepi) */
  .matrix-card-wrapper {
    background: #ffffff;
    border-radius: 20px;
    overflow: hidden;
    border: none;
    box-shadow: 0 10px 28px -6px rgba(15, 23, 42, 0.06);
  }

  .matrix-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  /* Individual Cells */
  .matrix-cell {
    padding: 38px 32px 42px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  /* Palette 6 Blok Bernuansa Pastel Bersih & Lembut (Sama Sekali Tidak Pekat) */
  .cell-shade-1 {
    background-color: #ffffff;
  }

  .cell-shade-2 {
    background-color: #f6faff;
  }

  .cell-shade-3 {
    background-color: #edf5fd;
  }

  .cell-shade-4 {
    background-color: #e4f0fc;
  }

  .cell-shade-5 {
    background-color: #d8e9fa;
  }

  .cell-shade-6 {
    background-color: #cbe2f7;
  }

  /* Badge Square (Kotak Kuning/Oranye) */
  .badge-square {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background-color: #f59e0b; /* Amber/Orange */
    color: #1e293b;
    font-weight: 800;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 22px;
    box-shadow: 0 2px 6px rgba(245, 158, 11, 0.25);
  }

  /* Titles */
  .cell-title {
    font-size: 1.45rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin: 0 0 6px 0;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
    color: #0f172a;
  }

  /* Focus Subtitle */
  .cell-focus {
    font-size: 0.88rem;
    font-weight: 700;
    margin-bottom: 16px;
    display: inline-block;
    letter-spacing: 0.01em;
    color: #0284c7; /* Ocean blue */
  }

  /* Description Body */
  .cell-desc {
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0;
    color: #475569;
  }

  /* Responsive Breakpoints */
  @media (max-width: 960px) {
    .matrix-grid {
      grid-template-columns: 1fr;
    }

    .matrix-cell {
      padding: 28px 24px;
    }
  }
</style>


