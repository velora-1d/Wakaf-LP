---
// src/components/home/OurApproachSection.astro
// Section 04: Ekosistem Terpadu Berpusat pada Masjid (Editorial Architecture Style ala ISAVO)

const approachSteps = [
  {
    step: '01',
    name: 'Kebaikan',
    focus: 'Filantropi & Wakaf Umat',
    desc: 'Menghimpun amanah infaq, sedekah, zakat, dan wakaf produktif secara transparan dari para donatur dan masyarakat luas.'
  },
  {
    step: '02',
    name: 'Pendidikan',
    focus: 'Karakter & Fasilitas Pembelajaran',
    desc: 'Membangun sarana belajar representatif, masjid beradab, dan kurikulum FAST sebagai fondasi akhlak santri.'
  },
  {
    step: '03',
    name: 'Kompetensi',
    focus: 'Vokasi & Keterampilan Riil',
    desc: 'Membekali santri keahlian vokasi terapan (arsitektur, agriteknologi, digital) melalui laboratorium praktik nyata.'
  },
  {
    step: '04',
    name: 'Kemandirian',
    focus: 'Agroteknopreneur & Unit Usaha',
    desc: 'Mengembangkan unit usaha mandiri pesantren (Greenhouse, Agro-Technopark) agar mandiri tanpa terus bergantung donasi.'
  },
  {
    step: '05',
    name: 'Kolaborasi',
    focus: 'Kemitraan Industri & Komunitas',
    desc: 'Menyambungkan santri dengan dunia industri, asosiasi profesi, akademisi, dan jaringan pasar terpercaya.'
  },
  {
    step: '06',
    name: 'Dampak Sosial',
    focus: 'Muzakki Baru & Berdaya',
    desc: 'Mencetak lulusan berdaya saing yang mandiri secara ekonomi dan kembali menebar manfaat luas sebagai muzakki baru.'
  }
];
---

<section class="approach-section" id="pendekatan">
  <div class="approach-container">
    <!-- Section Heading -->
    <div class="approach-header reveal-on-scroll">
      <div class="isavo-pill-tag">
        <span class="pill-dot"></span>
        <span>OUR APPROACH • CARA KERJA</span>
      </div>
      <h2 class="approach-title">
        Dari Kebaikan Menjadi Kebermanfaatan.
      </h2>
      <p class="approach-desc">
        Kami percaya bahwa dukungan yang tepat dapat membangun kemampuan, bukan hanya memenuhi kebutuhan sesaat. Inilah yang menjadi pembeda Global Village Fund.
      </p>
    </div>

    <!-- 6-Stage Horizontal Transformation Chain Grid Persis Screenshot 1 -->
    <div class="approach-chain-grid">
      {approachSteps.map((item, idx) => (
        <div class={`chain-card reveal-on-scroll delay-${(idx + 1) * 100}`}>
          <div class="chain-meta">
            <span class="chain-step">{item.step}</span>
            <span class="chain-arrow" aria-hidden="true">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M4 10h12M12 5l5 5-5 5" />
              </svg>
            </span>
          </div>
          <h3 class="chain-name">{item.name}</h3>
          <span class="chain-focus">{item.focus}</span>
          <p class="chain-desc">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:inline>
  .approach-section {
    position: relative;
    padding: 100px 0;
    background-color: #fafafc; /* Clean off-white surface */
    border: none;
  }

  .approach-container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Header Section */
  .approach-header {
    max-width: 880px;
    margin-bottom: 60px;
  }

  .isavo-pill-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: #e0f2fe;
    border: 1px solid #bae6fd;
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #0369a1;
    margin-bottom: 22px;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    background-color: #0052cc;
    border-radius: 50%;
  }

  .approach-title {
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    font-weight: 800;
    line-height: 1.15;
    color: #0f172a;
    letter-spacing: -0.025em;
    margin-bottom: 20px;
  }

  .approach-title span {
    color: #0052cc; /* Blue brand accent */
  }

  .approach-desc {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #475569;
    max-width: 820px;
    margin: 0;
  }

  /* 6-Stage Transformation Chain Grid Persis Screenshot 1 (3 Kolom x 2 Baris) */
  .approach-chain-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 1024px) {
    .approach-chain-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .approach-chain-grid {
      grid-template-columns: 1fr;
    }
  }

  .chain-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .chain-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
    border-color: #93c5fd;
  }

  .chain-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .chain-step {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.95rem;
    font-weight: 800;
    color: #0052cc;
    background: #eff6ff;
    padding: 5px 12px;
    border-radius: 8px;
  }

  .chain-arrow {
    width: 22px;
    height: 22px;
    color: #94a3b8;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .chain-card:hover .chain-arrow {
    color: #0052cc;
    transform: translateX(3px);
  }

  .chain-arrow svg {
    width: 20px;
    height: 20px;
  }

  .chain-name {
    font-size: 1.45rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.2;
    margin-bottom: 6px;
    letter-spacing: -0.015em;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  .chain-focus {
    font-size: 0.88rem;
    font-weight: 600;
    color: #0969da;
    margin-bottom: 16px;
    display: inline-block;
  }

  .chain-desc {
    font-size: 0.92rem;
    line-height: 1.65;
    color: #64748b;
    text-align: left;
    margin: 0;
  }
</style>
