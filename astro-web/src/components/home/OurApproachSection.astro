---
// src/components/home/OurApproachSection.astro
// Modul 6 Tahap Pendekatan & Kurikulum (Modular 3x2 Matrix ala Referensi Gambar)

const approachModules = [
  {
    num: '1',
    title: 'Dasar Logic & Karakter Tani Alami',
    bgClass: 'cell-white',
    isDark: false,
    items: [
      'Logis & Sistematika Integrated Farming',
      'Etika Profesional & Budaya Kerja Lapangan',
      'Stamina Fisik & Kecakapan Teknis Lapangan',
      'Siklus Hara & Keseimbangan Alam'
    ]
  },
  {
    num: '2',
    title: 'Smart Horticulture & Hidroponik',
    bgClass: 'cell-mint-light',
    isDark: false,
    items: [
      'Manajemen Tanah & Kompos Terpadu',
      'Formulasi Nutrisi & Pestisida Hayati Alami',
      'Praktik Greenhouse & Fertigasi Otomatis',
      'Standardisasi Kualitas Komoditas Segar'
    ]
  },
  {
    num: '3',
    title: 'Smart Poultry & Happy Chicken',
    bgClass: 'cell-sage',
    isDark: false,
    items: [
      'Prinsip Kandang Bahagia & Ihsan Ternak',
      'Formulasi Pakan Mandiri & Biokonversi BSF',
      'Manajemen DOC, Grower, hingga Pullet',
      'Pengendalian Sanitasi Ternak Alami'
    ]
  },
  {
    num: '4',
    title: 'Agribusiness & Supply Chain',
    bgClass: 'cell-emerald',
    isDark: true,
    items: [
      'Business Model Canvas Agribisnis Modern',
      'DKV & Kemasan Produk Hasil Bumi (Packaging)',
      'E-Commerce & Live Selling Hasil Panen',
      'Rantai Pasok B2B Skillage Mart & Ritel'
    ]
  },
  {
    num: '5',
    title: "Qur'anic Agripreneurship",
    bgClass: 'cell-forest',
    isDark: true,
    items: [
      'Fiqih Muamalah Musaqah & Zakat Pertanian',
      'Etika Rantai Pasok Pangan Halal & Thoyyib',
      'Tadabbur Ayat Kauniyah Bumi & Tumbuhan',
      'Jiwa Entrepreneur Mandiri & Berkelanjutan'
    ]
  },
  {
    num: '6',
    title: 'Real Farm Project & TeFa',
    bgClass: 'cell-deep-dark',
    isDark: true,
    items: [
      'Eksekusi Unit Usaha Greenhouse & Ternak',
      'Pengelolaan Rantai Usaha Skillage Mart',
      'Pembukuan Omzet & Laporan Keuangan Riil',
      'Sertifikasi BNSP & Portofolio Agripreneur'
    ]
  }
];
---

<section class="approach-section" id="pendekatan">
  <div class="approach-container">
    <!-- Section Heading -->
    <div class="approach-header reveal-on-scroll">
      <div class="isavo-pill-tag">
        <span class="pill-dot"></span>
        <span>OUR APPROACH • TAHAPAN KURIKULUM</span>
      </div>
      <h2 class="approach-title">
        Dari Kebaikan Menjadi Kebermanfaatan.
      </h2>
      <p class="approach-desc">
        Pola pembinaan komprehensif 6 tahap yang mengintegrasikan fondasi karakter, sains pertanian modern, syariat muamalah, hingga kemandirian wirausaha riil santri.
      </p>
    </div>

    <!-- 6-Block Modular Grid Container (Sesuai Referensi Gambar) -->
    <div class="matrix-card-wrapper reveal-on-scroll delay-100">
      <div class="matrix-grid">
        {approachModules.map((item) => (
          <div class={`matrix-cell ${item.bgClass} ${item.isDark ? 'theme-dark' : 'theme-light'}`}>
            <!-- Badge Angka Kotak Oranye/Kuning -->
            <div class="badge-square">
              <span>{item.num}</span>
            </div>

            <!-- Judul Modul -->
            <h3 class="cell-title">{item.title}</h3>

            <!-- List Bullet Points -->
            <ul class="bullet-list">
              {item.items.map((pt) => (
                <li class="bullet-item">
                  <span class="bullet-dot" aria-hidden="true"></span>
                  <span class="bullet-text">{pt}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:inline>
  .approach-section {
    position: relative;
    padding: 90px 0 100px;
    background-color: #fafafc;
    border: none;
  }

  .approach-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Header Section */
  .approach-header {
    max-width: 860px;
    margin-bottom: 48px;
  }

  .isavo-pill-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: #e0f2fe;
    border: 1px solid #bae6fd;
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #0369a1;
    margin-bottom: 20px;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    background-color: #0052cc;
    border-radius: 50%;
  }

  .approach-title {
    font-size: clamp(2.2rem, 3.8vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    color: #0f172a;
    letter-spacing: -0.025em;
    margin-bottom: 16px;
  }

  .approach-desc {
    font-size: 1.05rem;
    line-height: 1.68;
    color: #475569;
    max-width: 780px;
    margin: 0;
  }

  /* Matrix Unified Container Card */
  .matrix-card-wrapper {
    background: #ffffff;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 30px -5px rgba(15, 23, 42, 0.08), 0 0 0 1px rgba(15, 23, 42, 0.06);
  }

  .matrix-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  /* Individual Cells */
  .matrix-cell {
    padding: 36px 32px 40px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  /* Palette Baris Atas & Bawah */
  .cell-white {
    background-color: #ffffff;
  }

  .cell-mint-light {
    background-color: #e7f2e9;
  }

  .cell-sage {
    background-color: #b0ceba;
  }

  .cell-emerald {
    background-color: #3f8b5a;
  }

  .cell-forest {
    background-color: #1e6b3b;
  }

  .cell-deep-dark {
    background-color: #0e3e21;
  }

  /* Badge Square (Kotak Kuning/Oranye) */
  .badge-square {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background-color: #f59e0b; /* Amber/Orange */
    color: #1e293b;
    font-weight: 800;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 22px;
    box-shadow: 0 2px 6px rgba(245, 158, 11, 0.3);
  }

  /* Titles */
  .cell-title {
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin: 0 0 24px 0;
    min-height: 52px;
  }

  .theme-light .cell-title {
    color: #111827;
  }

  .theme-dark .cell-title {
    color: #ffffff;
  }

  /* Bullet List */
  .bullet-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .bullet-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .bullet-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    margin-top: 7px;
    flex-shrink: 0;
  }

  .theme-light .bullet-dot {
    background-color: #2d7a4d;
  }

  .theme-dark .bullet-dot {
    background-color: #fbbf24;
  }

  .bullet-text {
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .theme-light .bullet-text {
    color: #334155;
    font-weight: 500;
  }

  .theme-dark .bullet-text {
    color: #f1f5f9;
    font-weight: 400;
  }

  /* Responsive Breakpoints */
  @media (max-width: 960px) {
    .matrix-grid {
      grid-template-columns: 1fr;
    }

    .matrix-cell {
      padding: 28px 24px;
    }

    .cell-title {
      min-height: auto;
      margin-bottom: 18px;
    }
  }
</style>

