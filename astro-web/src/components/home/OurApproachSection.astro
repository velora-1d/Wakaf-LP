---
// src/components/home/OurApproachSection.astro
// Section 04: Ekosistem Terpadu Berpusat pada Masjid (Editorial Architecture Style ala ISAVO)

const approachSteps = [
  {
    step: '01',
    name: 'Kebaikan',
    focus: 'Filantropi & Wakaf Umat',
    desc: 'Menghimpun amanah infaq, sedekah, zakat, dan wakaf produktif secara transparan dari para donatur dan masyarakat luas.'
  },
  {
    step: '02',
    name: 'Pendidikan',
    focus: 'Karakter & Fasilitas Pembelajaran',
    desc: 'Membangun sarana belajar representatif, masjid beradab, dan kurikulum FAST sebagai fondasi akhlak santri.'
  },
  {
    step: '03',
    name: 'Kompetensi',
    focus: 'Vokasi & Keterampilan Riil',
    desc: 'Membekali santri keahlian vokasi terapan (arsitektur, agriteknologi, digital) melalui laboratorium praktik nyata.'
  },
  {
    step: '04',
    name: 'Kemandirian',
    focus: 'Agroteknopreneur & Unit Usaha',
    desc: 'Mengembangkan unit usaha mandiri pesantren (Greenhouse, Agro-Technopark) agar mandiri tanpa terus bergantung donasi.'
  },
  {
    step: '05',
    name: 'Kolaborasi',
    focus: 'Kemitraan Industri & Komunitas',
    desc: 'Menyambungkan santri dengan dunia industri, asosiasi profesi, akademisi, dan jaringan pasar terpercaya.'
  },
  {
    step: '06',
    name: 'Dampak Sosial',
    focus: 'Muzakki Baru & Berdaya',
    desc: 'Mencetak lulusan berdaya saing yang mandiri secara ekonomi dan kembali menebar manfaat luas sebagai muzakki baru.'
  }
];
---

<section class="approach-section" id="pendekatan">
  <div class="approach-container">
    <!-- Section Heading -->
    <div class="approach-header reveal-on-scroll">
      <div class="isavo-pill-tag">
        <span class="pill-dot"></span>
        <span>OUR APPROACH • CARA KERJA</span>
      </div>
      <h2 class="approach-title">
        Dari Kebaikan Menjadi Kebermanfaatan.
      </h2>
      <p class="approach-desc">
        Kami percaya bahwa dukungan yang tepat dapat membangun kemampuan, bukan hanya memenuhi kebutuhan sesaat. Inilah yang menjadi pembeda Global Village Fund.
      </p>
    </div>

    <!-- Diagram Alur Rantai Transformasi 6 Tahap (Process Step Flow, Bukan Kotak-Kotak Biasa) -->
    <div class="process-flow-container">
      <div class="process-flow-track" aria-hidden="true"></div>

      <div class="process-steps-list">
        {approachSteps.map((item, idx) => (
          <div class={`process-step-item reveal-on-scroll delay-${(idx + 1) * 100}`}>
            <!-- Step Marker Node -->
            <div class="step-marker-col">
              <div class="step-node-badge">
                <span>{item.step}</span>
              </div>
              {idx < approachSteps.length - 1 && (
                <div class="step-connector-line"></div>
              )}
            </div>

            <!-- Step Content Body -->
            <div class="step-content-body">
              <div class="step-title-row">
                <h3 class="step-title">{item.name}</h3>
                <span class="step-focus-badge">{item.focus}</span>
              </div>
              <p class="step-description">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:inline>
  .approach-section {
    position: relative;
    padding: 100px 0;
    background-color: #fafafc; /* Clean off-white surface */
    border: none;
  }

  .approach-container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Header Section */
  .approach-header {
    max-width: 880px;
    margin-bottom: 60px;
  }

  .isavo-pill-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: #e0f2fe;
    border: 1px solid #bae6fd;
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #0369a1;
    margin-bottom: 22px;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    background-color: #0052cc;
    border-radius: 50%;
  }

  .approach-title {
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    font-weight: 800;
    line-height: 1.15;
    color: #0f172a;
    letter-spacing: -0.025em;
    margin-bottom: 20px;
  }

  .approach-title span {
    color: #0052cc; /* Blue brand accent */
  }

  .approach-desc {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #475569;
    max-width: 820px;
    margin: 0;
  }

  /* Connected Process Flow Diagram (Bukan Kotak-Kotak Lepas) */
  .process-flow-container {
    max-width: 920px;
    margin: 0 auto;
    position: relative;
    padding: 20px 0;
  }

  .process-steps-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .process-step-item {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 24px;
    position: relative;
  }

  /* Node Marker Column */
  .step-marker-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .step-node-badge {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #0969da;
    color: #ffffff;
    font-weight: 800;
    font-size: 1.05rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(9, 105, 218, 0.35);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    z-index: 2;
    flex-shrink: 0;
  }

  .step-connector-line {
    width: 2px;
    flex-grow: 1;
    min-height: 44px;
    background: linear-gradient(180deg, #93c5fd 0%, #dbeafe 100%);
    margin: 8px 0;
  }

  /* Content Column */
  .step-content-body {
    padding-bottom: 44px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .step-title-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .step-title {
    font-size: 1.45rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.25;
    letter-spacing: -0.02em;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
    margin: 0;
  }

  .step-focus-badge {
    font-size: 0.8rem;
    font-weight: 700;
    color: #0284c7;
    background: #e0f2fe;
    padding: 3px 12px;
    border-radius: 9999px;
    letter-spacing: 0.02em;
  }

  .step-description {
    font-size: 0.98rem;
    line-height: 1.68;
    color: #475569;
    margin: 0;
    max-width: 680px;
  }

  @media (max-width: 640px) {
    .process-step-item {
      grid-template-columns: 50px 1fr;
      gap: 16px;
    }

    .step-node-badge {
      width: 40px;
      height: 40px;
      font-size: 0.9rem;
    }

    .step-title {
      font-size: 1.25rem;
    }
  }
</style>
