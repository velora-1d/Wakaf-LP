---
// src/components/home/OurApproachSection.astro
// Modul 6 Tahap Pendekatan & Transformasi (Modular 3x2 Matrix sesuai Desain Referensi)

interface ApproachModule {
  num: string;
  name: string;
  focus: string;
  desc: string;
  bgClass: string;
}

const approachModules: ApproachModule[] = [
  {
    num: '1',
    name: 'Kebaikan',
    focus: 'Filantropi & Wakaf Umat',
    desc: 'Menghimpun amanah infaq, sedekah, zakat, dan wakaf produktif secara transparan dari para donatur dan masyarakat luas.',
    bgClass: 'cell-shade-1',
  },
  {
    num: '2',
    name: 'Pendidikan',
    focus: 'Karakter & Fasilitas Pembelajaran',
    desc: 'Membangun sarana belajar representatif, masjid beradab, dan kurikulum FAST sebagai fondasi akhlak santri.',
    bgClass: 'cell-shade-2',
  },
  {
    num: '3',
    name: 'Kompetensi',
    focus: 'Vokasi & Keterampilan Riil',
    desc: 'Membekali santri keahlian vokasi terapan (arsitektur, agriteknologi, digital) melalui laboratorium praktik nyata.',
    bgClass: 'cell-shade-3',
  },
  {
    num: '4',
    name: 'Kemandirian',
    focus: 'Agroteknopreneur & Unit Usaha',
    desc: 'Mengembangkan unit usaha mandiri pesantren (Greenhouse, Agro-Technopark) agar mandiri tanpa terus bergantung donasi.',
    bgClass: 'cell-shade-4',
  },
  {
    num: '5',
    name: 'Kolaborasi',
    focus: 'Kemitraan Industri & Komunitas',
    desc: 'Menyambungkan santri dengan dunia industri, asosiasi profesi, akademisi, dan jaringan pasar terpercaya.',
    bgClass: 'cell-shade-5',
  },
  {
    num: '6',
    name: 'Dampak Sosial',
    focus: 'Muzakki Baru & Berdaya',
    desc: 'Mencetak lulusan berdaya saing yang mandiri secara ekonomi dan kembali menebar manfaat luas sebagai muzakki baru.',
    bgClass: 'cell-shade-6',
  },
];
---

<section class="approach-section" id="pendekatan">
  <div class="approach-container">
    <!-- Section Heading -->
    <div class="approach-header text-center">
      <span class="section-kicker reveal-on-scroll">Pendekatan Ekosistem</span>
      <h2 class="approach-title reveal-heading">
        Dari Kebaikan Menjadi Kebermanfaatan.
      </h2>
      <p class="approach-desc reveal-on-scroll" data-delay="0.12">
        Kami percaya bahwa dukungan yang tepat dapat membangun kemampuan, bukan hanya memenuhi kebutuhan sesaat. Inilah yang menjadi pembeda Global Village Fund.
      </p>
    </div>

    <!-- 6-Block Modular Grid Container -->
    <div class="matrix-grid reveal-stagger">
      {approachModules.map((item) => (
        <div class="matrix-cell">
          <!-- Badge Angka -->
          <div class="badge-square">
            <span>{item.num}</span>
          </div>

          <!-- Judul & Subjudul / Focus -->
          <h3 class="cell-title">{item.name}</h3>
          <span class="cell-focus">{item.focus}</span>

          <!-- Deskripsi -->
          <p class="cell-desc">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .approach-section {
    position: relative;
    padding: var(--section-padding-y-lg) 0;
    background-color: var(--color-surface-50);
    border-bottom: 1px solid var(--color-border);
  }

  .approach-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  /* Header Section */
  .approach-header {
    max-width: 820px;
    margin: 0 auto var(--space-9);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .approach-title {
    font-size: var(--text-heading-lg);
    font-weight: 800;
    line-height: var(--leading-tight);
    color: var(--color-text-heading);
    letter-spacing: var(--tracking-tighter);
    margin-bottom: var(--space-3);
    font-family: var(--font-display);
  }

  .approach-desc {
    font-size: var(--text-body-lg);
    line-height: var(--leading-loose);
    color: var(--color-text-muted);
    max-width: 740px;
    margin: 0;
  }

  .matrix-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  /* Individual Cells */
  .matrix-cell {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-7) var(--space-6) var(--space-8);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    transition: border-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  .matrix-cell:hover {
    border-color: var(--blue-300);
    transform: translateY(-2px);
  }

  /* Subtle background shading */
  .cell-shade-1 { background-color: #ffffff; }
  .cell-shade-2 { background-color: var(--color-surface-50); }
  .cell-shade-3 { background-color: #f1f7fd; }
  .cell-shade-4 { background-color: #e9f3fc; }
  .cell-shade-5 { background-color: #dfedfa; }
  .cell-shade-6 { background-color: #d6e8f8; }

  /* Badge Square (Kotak Kuning/Oranye) */
  .badge-square {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background-color: var(--amber-400);
    color: #1e293b;
    font-weight: 800;
    font-size: var(--text-small);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-5);
    box-shadow: 0 2px 6px rgba(245, 158, 11, 0.25);
  }

  /* Titles */
  .cell-title {
    font-size: var(--text-heading-sm);
    font-weight: 800;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-1) 0;
    font-family: var(--font-display);
    color: var(--color-text-heading);
  }

  /* Focus Subtitle */
  .cell-focus {
    font-size: var(--text-label);
    font-weight: 700;
    margin-bottom: var(--space-4);
    display: inline-block;
    letter-spacing: var(--tracking-tight);
    color: var(--blue-600);
  }

  /* Description Body */
  .cell-desc {
    font-size: var(--text-label);
    line-height: var(--leading-relaxed);
    margin: 0;
    color: var(--color-text-muted);
  }

  /* Responsive Breakpoints */
  @media (max-width: 960px) {
    .matrix-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .matrix-cell {
      padding: var(--space-6) var(--space-5);
    }
  }

  @media (max-width: 640px) {
    .approach-section {
      padding: var(--section-padding-y-sm) 0;
    }
    .approach-container {
      padding: 0 var(--space-5);
    }
  }
</style>


