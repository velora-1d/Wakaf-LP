    desc: 'Harmonisasi regulasi pesantren mandiri bersama Kemenag, BWI, dan asosiasi filantropi nasional.',
    accent: '#0891b2',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M20 10v11M8 14v4M12 14v4M16 14v4"></path></svg>`
  }
];
---

<section class="approach-section" id="pendekatan">
  <div class="approach-container">
    <div class="approach-header text-center reveal-on-scroll">
      <div class="approach-pill">
        <span class="pill-dot"></span>
        <span>04 • OUR APPROACH</span>
      </div>
      <h2 class="approach-title">
        Kami Membangun Ekosistem,<br />
        Bukan Sekadar Menjalankan Program.
      </h2>
      <p class="approach-desc">
        Model ini dikembangkan oleh <strong>Yayasan Permata Cendekia Indonesia (YPCI)</strong> melalui ekosistem <em>Academy, Business, Community, Family, and Government (ABCFG)</em> yang berpusat pada masjid. Di dalamnya, seluruh pilar saling terhubung dan menguatkan.
      </p>
    </div>

    <!-- Cluster Grid of 7 Elements -->
    <div class="approach-grid">
      {ecosystemNodes.map((node, idx) => (
        <div
          class={`approach-card ${node.isCenter ? 'center-hub' : ''} reveal-on-scroll delay-${(idx + 1) * 100}`}
          style={`--node-accent: ${node.accent};`}
        >
          <div class="node-top">
            <span class="node-tag">{node.tag}</span>
            <div class="node-icon">
              <Fragment set:html={node.icon} />
            </div>
          </div>
          <h3 class="node-title">{node.title}</h3>
          <span class="node-role">{node.role}</span>
          <p class="node-desc">{node.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .approach-section {
    position: relative;
    padding: 110px 0 120px;
    background-color: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
  }

  .approach-container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .approach-header {
    max-width: 860px;
    margin: 0 auto 60px;
  }

  .approach-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(2, 132, 199, 0.1);
    border: 1px solid rgba(2, 132, 199, 0.25);
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #0284c7;
    margin-bottom: 20px;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    background-color: #0284c7;
    border-radius: 50%;
  }

  .approach-title {
    font-size: clamp(2.2rem, 3.8vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    color: #0f172a;
    letter-spacing: -0.025em;
    margin-bottom: 20px;
  }

  .approach-desc {
    font-size: 1.08rem;
    line-height: 1.75;
    color: #64748b;
  }

  /* Grid Layout: 3 Columns, with First Center-Hub spanning visually */
  .approach-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .approach-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 30px 26px;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.03);
    position: relative;
    overflow: hidden;
  }

  .approach-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: var(--node-accent);
  }

  .approach-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);
    border-color: #cbd5e1;
  }

  /* Special Center Hub Card (MASJID) */
  .approach-card.center-hub {
    grid-column: span 3;
    background: linear-gradient(135deg, #0a2540 0%, #0f172a 100%);
    color: #ffffff;
    border: none;
    box-shadow: 0 12px 35px rgba(10, 37, 64, 0.22);
  }

  .approach-card.center-hub .node-tag {
    background: rgba(5, 150, 105, 0.25);
    color: #34d399;
    border: 1px solid rgba(52, 211, 153, 0.4);
  }

  .approach-card.center-hub .node-title {
    color: #ffffff;
    font-size: 1.6rem;
  }

  .approach-card.center-hub .node-role {
    color: #38bdf8;
    font-size: 1.05rem;
  }

  .approach-card.center-hub .node-desc {
    color: #cbd5e1;
    font-size: 1rem;
    max-width: 800px;
  }

  .approach-card.center-hub .node-icon {
    background: rgba(255, 255, 255, 0.1);
    color: #34d399;
  }

  .node-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .node-tag {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border-radius: 9999px;
    background: #f1f5f9;
    color: #475569;
  }

  .node-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(15, 23, 42, 0.04);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--node-accent);
  }

  .node-icon :global(svg) {
    width: 22px;
    height: 22px;
  }

  .node-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.01em;
    margin-bottom: 6px;
  }

  .node-role {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--node-accent);
    margin-bottom: 12px;
    display: inline-block;
  }

  .node-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #64748b;
  }

  @media (max-width: 1024px) {
    .approach-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .approach-card.center-hub {
      grid-column: span 2;
    }
  }

  @media (max-width: 640px) {
    .approach-grid {
      grid-template-columns: 1fr;
    }
    .approach-card.center-hub {
      grid-column: span 1;
    }
  }
</style>
