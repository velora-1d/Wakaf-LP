  {
    tag: 'PUSAT INTI',
    title: 'MASJID',
    role: 'Iman, Ibadah & Karakter',
    desc: 'Jantung spiritual, pembinaan adab santri, dan pusat integrasi seluruh aktivitas ekosistem.',
    isCenter: true,
    accent: '#059669',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3c-1.5 2-3 3.5-3 5.5a3 3 0 1 0 6 0c0-2-1.5-3.5-3-5.5z"></path><path d="M4 21V10l8-5 8 5v11H4z"></path><path d="M9 21v-6a3 3 0 0 1 6 0v6"></path></svg>`
  },
  {
    tag: 'ACADEMY',
    title: 'PENDIDIKAN',
    role: 'Ilmu & Pembelajaran',
    desc: 'Kurikulum integratif SMK Skill Village Islamic School memadukan sains, adab, dan kurikulum vokasi.',
    accent: '#0284c7',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>`
  },
  {
    tag: 'SKILLS',
    title: 'KETERAMPILAN',
    role: 'Kompetensi & Pengalaman',
    desc: 'Laboratorium praktik di bidang Konstruksi, Agribisnis, Teknologi, dan Bisnis Digital.',
    accent: '#d97706',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>`
  },
  {
    tag: 'BUSINESS',
    title: 'USAHA',
    role: 'Praktik & Kemandirian',
    desc: 'Unit usaha mandiri pesantren (Agro-Technopark, Green Waqf) yang menopang keberlanjutan operasional.',
    accent: '#2563eb',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>`
  },
  {
    tag: 'FAMILY & COMMUNITY',
