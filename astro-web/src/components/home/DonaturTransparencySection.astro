---
// src/components/home/DonaturTransparencySection.astro
// Transparansi Realisasi Anggaran & Daftar Donatur Terverifikasi
import donaturData from '../../data/donatur.json';

const totalTerkumpul = donaturData.reduce((acc, curr) => acc + curr.nominal, 0);
const totalAnggaran = 1215753350; // Sesuai data transparansi proyek
const realisasiPersen = ((totalTerkumpul / totalAnggaran) * 100).toFixed(2); // 3.85%

const formatRupiah = (val: number) => {
  return 'Rp ' + val.toLocaleString('id-ID');
};
---

<section class="gvf-transparency-section" id="transparansi">
  <div class="gvf-container">
    <!-- Main Transparency Card -->
    <div class="gvf-budget-card">
      <!-- Status & Spec Header -->
      <div class="gvf-budget-top">
        <div class="gvf-status-pill">
          <span class="gvf-status-dot"></span>
          <span>STATUS: TERHENTI KETERBATASAN DANA</span>
        </div>
        <div class="gvf-spec-text">
          <span>Spesifikasi: <strong>20 × 30 Meter</strong></span>
        </div>
      </div>

      <!-- Main Headline -->
      <h2 class="gvf-budget-headline">Transparansi Realisasi Anggaran Pembangunan</h2>
      <p class="gvf-budget-subtitle">
        Laporan terbuka penghimpunan wakaf pembangunan sarana ibadah dan asrama santri di Kampus Skill Village Islamic School, Sukasirna, Jonggol.
      </p>

      <!-- Metric Summary Cards (Card Sisa Target DIELIMINASI sesuai instruksi) -->
      <div class="gvf-metric-grid">
        <!-- Card 1: Dana Terhimpun -->
        <div class="gvf-metric-card gvf-metric-collected">
          <span class="gvf-metric-label">DANA TERHIMPUN</span>
          <div class="gvf-metric-val">{formatRupiah(totalTerkumpul)}</div>
          <span class="gvf-metric-badge">Tercatat {donaturData.length} Transaksi Donasi</span>
        </div>

        <!-- Card 2: Total Anggaran -->
        <div class="gvf-metric-card gvf-metric-target">
          <span class="gvf-metric-label">TOTAL ANGGARAN</span>
          <div class="gvf-metric-val">{formatRupiah(totalAnggaran)}</div>
          <span class="gvf-metric-badge gvf-badge-muted">Kawasan Terpadu Sukasirna</span>
        </div>
      </div>

      <!-- Progress Bar Tracker -->
      <div class="gvf-progress-wrap">
        <div class="gvf-progress-markers">
          <span>0%</span>
          <span>25%</span>
          <span>50%</span>
          <span>75%</span>
          <span>100% Target</span>
        </div>
        <div class="gvf-progress-track">
          <div class="gvf-progress-fill" style={`width: ${realisasiPersen}%;`}></div>
        </div>
        <div class="gvf-progress-info">
          <span>Realisasi Saat Ini: <strong>{realisasiPersen}%</strong></span>
          <span class="gvf-progress-note">Diperbarui berkala secara transparan</span>
        </div>
      </div>

      <!-- Donor Table & Search Component -->
      <div class="gvf-donors-block">
        <div class="gvf-donors-header">
          <div>
            <h3 class="gvf-donors-title">Daftar Donatur &amp; Pewakif Terverifikasi</h3>
            <p class="gvf-donors-sub">Semoga Allah membalas dengan pahala jariyah yang senantiasa mengalir abadi.</p>
          </div>
          <div class="gvf-search-wrap">
            <svg class="gvf-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              id="donorSearchInput"
              placeholder="Cari nama donatur..."
              class="gvf-search-input"
            />
          </div>
        </div>

        <!-- Table Display (Tanpa Kolom Sisa Target) -->
        <div class="gvf-table-container">
          <table class="gvf-donor-table" id="donorTable">
            <thead>
              <tr>
                <th style="width: 60px; text-align: center;">No</th>
                <th>Nama Donatur</th>
                <th style="text-align: right;">Nominal (Rp)</th>
                <th>Tanggal</th>
                <th>Akad / Keterangan</th>
              </tr>
            </thead>
            <tbody id="donorTableBody">
              {donaturData.map((d, index) => (
                <tr class="gvf-donor-row" data-index={index}>
                  <td class="gvf-col-no">{d.no}</td>
                  <td class="gvf-col-name">
                    <strong>{d.nama}</strong>
                  </td>
                  <td class="gvf-col-nominal">{formatRupiah(d.nominal)}</td>
                  <td class="gvf-col-date">{d.tanggal !== '-' ? d.tanggal : 'Tercatat'}</td>
                  <td class="gvf-col-desc">
                    {d.keterangan !== '-' ? (
                      <span class="gvf-badge-desc">{d.keterangan}</span>
                    ) : (
                      <span class="gvf-text-faint">Wakaf Pembangunan</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Toggle View More Button -->
        <div class="gvf-table-footer">
          <button type="button" id="toggleMoreDonorsBtn" class="gvf-toggle-btn">
            <span id="toggleBtnText">Tampilkan Seluruh 36 Donatur</span>
            <svg id="toggleBtnIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Search and Collapsible Rows Logic
  const searchInput = document.getElementById('donorSearchInput') as HTMLInputElement | null;
  const toggleBtn = document.getElementById('toggleMoreDonorsBtn');
  const toggleText = document.getElementById('toggleBtnText');
  const toggleIcon = document.getElementById('toggleBtnIcon');
  const rows = document.querySelectorAll('.gvf-donor-row') as NodeListOf<HTMLTableRowElement>;

  let isExpanded = false;
  const INITIAL_VISIBLE_COUNT = 10;

  function renderRows() {
    const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

    rows.forEach((row, i) => {
      const name = row.querySelector('.gvf-col-name')?.textContent?.toLowerCase() || '';
      const desc = row.querySelector('.gvf-col-desc')?.textContent?.toLowerCase() || '';
      const matches = name.includes(query) || desc.includes(query);

      if (query.length > 0) {
        row.style.display = matches ? '' : 'none';
      } else {
        if (isExpanded || i < INITIAL_VISIBLE_COUNT) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      }
    });

    if (toggleBtn) {
      if (query.length > 0) {
        toggleBtn.style.display = 'none';
      } else {
        toggleBtn.style.display = 'inline-flex';
      }
    }
  }

  // Initial State
  renderRows();

  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      isExpanded = !isExpanded;
      if (toggleText) {
        toggleText.textContent = isExpanded ? 'Tampilkan 10 Teratas' : 'Tampilkan Seluruh 36 Donatur';
      }
      if (toggleIcon) {
        toggleIcon.style.transform = isExpanded ? 'rotate(180deg)' : 'rotate(0deg)';
      }
      renderRows();
    });
  }

  if (searchInput) {
    searchInput.addEventListener('input', () => {
      renderRows();
    });
  }
</script>

<style>
  .gvf-transparency-section {
    position: relative;
    padding: 100px 0 110px 0;
    background-color: #f8fafc;
  }

  .gvf-container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Big Budget Card */
  .gvf-budget-card {
    background-color: #ffffff;
    border: 1px solid rgba(226, 232, 240, 0.95);
    border-radius: 28px;
    padding: 44px 48px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
  }

  /* Top Status & Specs */
  .gvf-budget-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .gvf-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: #fef2f2;
    border: 1px solid #fecaca;
    color: #b91c1c;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 6px 16px;
    border-radius: 9999px;
  }

  .gvf-status-dot {
    width: 8px;
    height: 8px;
    background-color: #dc2626;
    border-radius: 50%;
    animation: gvfPulseDot 1.8s infinite;
  }

  @keyframes gvfPulseDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .gvf-spec-text {
    font-size: 0.9rem;
    color: #0f766e;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    background-color: #f0fdf4;
    padding: 4px 14px;
    border-radius: 8px;
    border: 1px solid #bbf7d0;
  }

  .gvf-spec-text strong {
    font-weight: 700;
    color: #065f46;
  }

  /* Headlines */
  .gvf-budget-headline {
    font-size: clamp(1.85rem, 3.2vw, 2.5rem);
    font-weight: 800;
    color: #16171a;
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 0 0 10px 0;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  .gvf-budget-subtitle {
    font-size: 1rem;
    color: #64748b;
    line-height: 1.6;
    margin: 0 0 36px 0;
    max-width: 800px;
  }

  /* Metric Grid (2 Cards: Dana Terhimpun & Total Anggaran) */
  .gvf-metric-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-bottom: 32px;
  }

  .gvf-metric-card {
    background-color: #f8fafc;
    border: 1px solid rgba(226, 232, 240, 0.85);
    border-radius: 20px;
    padding: 24px 28px;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .gvf-metric-card:hover {
    transform: translateY(-2px);
    border-color: rgba(9, 105, 218, 0.3);
  }

  .gvf-metric-label {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #64748b;
    margin-bottom: 8px;
    text-transform: uppercase;
  }

  .gvf-metric-val {
    font-size: clamp(1.75rem, 2.8vw, 2.4rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
    margin-bottom: 8px;
  }

  .gvf-metric-collected .gvf-metric-val {
    color: #047857; /* Hijau fresh / emerald */
  }

  .gvf-metric-target .gvf-metric-val {
    color: #1e293b; /* Dark charcoal */
  }

  .gvf-metric-badge {
    font-size: 0.78rem;
    color: #065f46;
    background-color: #d1fae5;
    padding: 4px 10px;
    border-radius: 6px;
    display: inline-block;
    align-self: flex-start;
    font-weight: 600;
  }

  .gvf-badge-muted {
    background-color: #e2e8f0;
    color: #475569;
  }

  /* Progress Bar */
  .gvf-progress-wrap {
    margin-bottom: 48px;
    background-color: #f8fafc;
    padding: 20px 24px;
    border-radius: 16px;
    border: 1px solid rgba(226, 232, 240, 0.85);
  }

  .gvf-progress-markers {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    font-weight: 600;
    color: #64748b;
    margin-bottom: 8px;
  }

  .gvf-progress-track {
    width: 100%;
    height: 10px;
    background-color: #e2e8f0;
    border-radius: 9999px;
    overflow: hidden;
    margin-bottom: 12px;
  }

  .gvf-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #10b981 0%, #059669 100%);
    border-radius: 9999px;
    transition: width 1s ease-in-out;
  }

  .gvf-progress-info {
    display: flex;
    justify-content: space-between;
    font-size: 0.88rem;
    color: #334155;
  }

  .gvf-progress-info strong {
    color: #047857;
    font-weight: 800;
  }

  .gvf-progress-note {
    font-size: 0.8rem;
    color: #94a3b8;
  }

  /* Donors Table Block */
  .gvf-donors-block {
    border-top: 1px solid #f1f5f9;
    padding-top: 36px;
  }

  .gvf-donors-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .gvf-donors-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #16171a;
    margin: 0 0 6px 0;
    letter-spacing: -0.02em;
  }

  .gvf-donors-sub {
    font-size: 0.9rem;
    color: #64748b;
    margin: 0;
  }

  /* Search Input */
  .gvf-search-wrap {
    position: relative;
    width: 260px;
  }

  .gvf-search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: #94a3b8;
    pointer-events: none;
  }

  .gvf-search-input {
    width: 100%;
    padding: 10px 14px 10px 42px;
    border-radius: 9999px;
    border: 1px solid #cbd5e1;
    font-size: 0.88rem;
    background-color: #ffffff;
    color: #1e293b;
    outline: none;
    transition: all 0.2s ease;
    font-family: inherit;
  }

  .gvf-search-input:focus {
    border-color: #0969da;
    box-shadow: 0 0 0 3px rgba(9, 105, 218, 0.12);
  }

  /* Table Style */
  .gvf-table-container {
    width: 100%;
    overflow-x: auto;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    background-color: #ffffff;
  }

  .gvf-donor-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
    text-align: left;
  }

  .gvf-donor-table th {
    background-color: #f8fafc;
    color: #475569;
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 14px 18px;
    border-bottom: 1px solid #e2e8f0;
  }

  .gvf-donor-table td {
    padding: 14px 18px;
    border-bottom: 1px solid #f1f5f9;
    color: #334155;
    vertical-align: middle;
  }

  .gvf-donor-row:hover td {
    background-color: #f8fafc;
  }

  .gvf-col-no {
    text-align: center;
    color: #94a3b8;
    font-weight: 600;
  }

  .gvf-col-name strong {
    color: #0f172a;
    font-weight: 700;
  }

  .gvf-col-nominal {
    text-align: right;
    font-weight: 800;
    color: #047857;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  .gvf-col-date {
    color: #64748b;
    font-size: 0.85rem;
  }

  .gvf-badge-desc {
    display: inline-block;
    background-color: #eff6ff;
    color: #1d4ed8;
    border: 1px solid #bfdbfe;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 9999px;
  }

  .gvf-text-faint {
    color: #94a3b8;
    font-size: 0.85rem;
  }

  /* Table Footer Button */
  .gvf-table-footer {
    display: flex;
    justify-content: center;
    margin-top: 24px;
  }

  .gvf-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid #cbd5e1;
    background-color: #ffffff;
    color: #1e293b;
    padding: 10px 22px;
    border-radius: 9999px;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s ease;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
    font-family: inherit;
  }

  .gvf-toggle-btn:hover {
    background-color: #0969da;
    border-color: #0969da;
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(9, 105, 218, 0.25);
  }

  #toggleBtnIcon {
    transition: transform 0.25s ease;
  }

  @media (max-width: 768px) {
    .gvf-budget-card {
      padding: 28px 20px;
      border-radius: 20px;
    }

    .gvf-metric-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .gvf-donors-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .gvf-search-wrap {
      width: 100%;
    }
  }
</style>
