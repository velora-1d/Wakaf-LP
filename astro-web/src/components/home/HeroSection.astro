---
// src/components/home/HeroSection.astro
// Hero Slider 4 Slide Sesuai Urutan Program: Shodaqoh, Infaq, Zakat, Wakaf
// Desain sinematik ala ISAVO dengan kepatuhan prinsip typeui-fundamentals

const heroSlides = [
  {
    id: 'slide-1',
    index: '01',
    label: 'Brand Utama',
    badge: 'FOSTERING PESANTREN ECOSYSTEMS FOR SELF-RELIANCE AND SOCIAL IMPACT',
    title: 'Membangun Ekosistem Pesantren.<br />Menghadirkan Kebermanfaatan.',
    lead: 'Global Village Fund adalah wadah kebaikan dan kolaborasi untuk memperkuat ekosistem pesantren menuju kemandirian dan dampak sosial.',
    taglineEn: 'Fostering Pesantren Ecosystems for Self-Reliance and Social Impact',
    image: '/gambar design/interior mesjid 2.jpg',
    buttons: [
      { text: 'Jelajahi Program', href: '#program-kebaikan', variant: 'primary' },
      { text: 'Dukung Kebaikan', href: '#donasi', variant: 'outline' }
    ],
    ctaText: 'Kenali Kami | Lihat Program'
  },
  {
    id: 'slide-2',
    index: '02',
    label: 'Pendidikan & Kompetensi',
    badge: 'PENDIDIKAN & KOMPETENSI',
    title: 'Menumbuhkan Potensi,<br />Membangun Kemandirian.',
    lead: 'Mendukung pendidikan, pengembangan kompetensi, dan pembentukan karakter santri sebagai bekal untuk menghadapi masa depan.',
    image: '/gambar design/learning studio & workshop.jpg',
    buttons: [
      { text: 'Lihat Program', href: '#program-kebaikan', variant: 'primary' }
    ]
  },
  {
    id: 'slide-3',
    index: '03',
    label: 'Masjid Khairu Ummah Sugro',
    badge: 'MASJID KHAIRU UMMAH SUGRO',
    title: 'Satu Rumah Allah,<br />Tumbuh Banyak Kebaikan.',
    lead: 'Bersama-sama menyelesaikan pembangunan Masjid Khairu Ummah Sugro sebagai bagian dari ekosistem pembelajaran dan kebermanfaatan pesantren.',
    image: '/gambar design/interior masjid.jpg',
    buttons: [
      { text: 'Dukung Pembangunan', href: '/program/wakaf', variant: 'primary' }
    ]
  },
  {
    id: 'slide-4',
    index: '04',
    label: 'Kemandirian & Lingkungan',
    badge: 'KEMANDIRIAN & LINGKUNGAN',
    title: 'Dari Pesantren,<br />Tumbuh Kemandirian.',
    lead: 'Mengembangkan ekosistem pendidikan, lingkungan, dan kewirausahaan yang saling terhubung untuk menciptakan manfaat yang berkelanjutan.',
    image: '/gambar design/belakang masjid.jpg',
    buttons: [
      { text: 'Jelajahi Ekosistem', href: '#pendekatan', variant: 'primary' }
    ]
  }
];
---

<section class="isavo-hero" id="hero-carousel" aria-roledescription="carousel" aria-label="Global Village Fund Hero">
  <!-- Multi-Slide Backgrounds with Cinematic Crossfade & Ambient Zoom -->
  <div class="hero-bgs-container" aria-hidden="true">
    {heroSlides.map((slide, i) => (
      <div class={`hero-bg-item ${i === 0 ? 'is-active' : ''}`} data-bg-index={i}>
        <img
          src={slide.image}
          alt={slide.label}
          class="hero-bg-img"
          loading={i === 0 ? 'eager' : 'lazy'}
        />
        <div class="hero-bg-overlay"></div>
      </div>
    ))}
  </div>

  <div class="isavo-hero-container">
    <!-- Slides Content Deck -->
    <div class="hero-slides-deck">
      {heroSlides.map((slide, i) => (
        <div
          class={`hero-slide-pane ${i === 0 ? 'is-active' : ''}`}
          data-slide-index={i}
          role="tabpanel"
          aria-label={`Slide ${slide.index}: ${slide.label}`}
        >
          <!-- Tag Pill -->
          <div class="isavo-tag-pill">
            <span class="isavo-tag-dot"></span>
            <span class="isavo-tag-text">{slide.badge}</span>
          </div>

          <!-- Display Heading (typeui principle: line-height tight, crisp contrast) -->
          <h1 class="isavo-hero-title" set:html={slide.title} />

          <!-- Narrative Subtext -->
          <div class="isavo-hero-sub">
            <p>{slide.lead}</p>
            {slide.taglineEn && (
              <p class="hero-tagline-en">{slide.taglineEn}</p>
            )}
          </div>

          <!-- Matched Height Action Buttons -->
          <div class="isavo-hero-cta-wrap">
            {slide.buttons.map((btn) => (
              <a
                href={btn.href}
                class={btn.variant === 'primary' ? 'isavo-btn-primary-pill' : 'isavo-btn-outline-pill'}
              >
                <span>{btn.text}</span>
                {btn.variant === 'outline' && (
                  <span class="isavo-btn-arrow-circle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="isavo-arrow-icon">
                      <line x1="7" y1="17" x2="17" y2="7"></line>
                      <polyline points="7 7 17 7 17 17"></polyline>
                    </svg>
                  </span>
                )}
              </a>
            ))}
          </div>

          {slide.ctaText && (
            <div class="hero-cta-text-nav">
              <a href="#tentang-kami" class="hero-text-link">Kenali Kami</a>
              <span class="hero-text-divider">|</span>
              <a href="#program-kebaikan" class="hero-text-link">Lihat Program</a>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .isavo-hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding-top: 130px;
    padding-bottom: 70px;
    overflow: hidden;
    background-color: #070e17;
  }

  /* Multi-slide Background Layer */
  .hero-bgs-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }

  .hero-bg-item {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), visibility 1s;
    transform: scale(1);
  }

  .hero-bg-item.is-active {
    opacity: 1;
    visibility: visible;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    filter: brightness(0.85);
    transform: scale(1.0);
    transition: transform 7s cubic-bezier(0.1, 0.9, 0.2, 1);
  }

  .hero-bg-item.is-active .hero-bg-img {
    transform: scale(1.06);
  }

  /* Deep cinematic dark overlay (typeui contrast safety) */
  .hero-bg-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      rgba(7, 14, 23, 0.95) 0%,
      rgba(7, 14, 23, 0.82) 48%,
      rgba(7, 14, 23, 0.45) 100%
    );
  }

  /* typeui principle: 1280px standard container */
  .isavo-hero-container {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .hero-slides-deck {
    max-width: 840px;
    position: relative;
    padding-top: 20px;
  }

  /* Slide Pane Transition */
  .hero-slide-pane {
    display: none;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-slide-pane.is-active {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  /* Tag Pill with dot ala ISAVO */
  .isavo-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 6px 16px;
    border-radius: 9999px;
    margin-bottom: 24px;
  }

  .isavo-tag-dot {
    width: 7px;
    height: 7px;
    background-color: var(--gvf-blue-vibrant, #0969da);
    border-radius: 50%;
    box-shadow: 0 0 10px #0969da;
  }

  .isavo-tag-text {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #ffffff;
    text-transform: uppercase;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  /* Giant Display Title (typeui principle: line-height: 1.04, margin-bottom 28px) */
  .isavo-hero-title {
    font-size: clamp(2.8rem, 5.2vw, 4.8rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin-bottom: 24px;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }

  .isavo-hero-sub {
    max-width: 720px;
    margin-bottom: 36px;
  }

  .isavo-hero-sub p {
    font-size: 1.0625rem;
    line-height: 1.68;
    color: #e2e8f0;
    font-weight: 400;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6);
    margin-bottom: 10px;
  }

  .hero-tagline-en {
    font-size: 0.95rem !important;
    font-style: italic;
    color: #38bdf8 !important;
    font-weight: 500 !important;
    margin-top: 6px;
    letter-spacing: 0.01em;
  }

  /* Text CTA link: Kenali Kami | Lihat Program */
  .hero-cta-text-nav {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
    font-size: 0.92rem;
    font-weight: 600;
  }

  .hero-text-link {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .hero-text-link:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .hero-text-divider {
    color: rgba(255, 255, 255, 0.3);
  }

  /* Buttons Row (Matching box height: 50px) */
  .isavo-hero-cta-wrap {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .isavo-btn-primary-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 50px;
    background: linear-gradient(135deg, #e53935 0%, #d32f2f 100%);
    color: #ffffff;
    padding: 0 28px;
    border-radius: 9999px;
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.01em;
    white-space: nowrap;
    box-shadow: 0 8px 20px rgba(229, 57, 53, 0.4);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .isavo-btn-primary-pill:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(229, 57, 53, 0.55);
  }

  .cta-heart-icon {
    width: 18px;
    height: 18px;
    color: #ffffff;
  }

  .isavo-btn-outline-pill {
    display: inline-flex;
    align-items: center;
    height: 50px;
    gap: 14px;
    background: rgba(15, 23, 42, 0.45);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.35);
    padding: 0 6px 0 24px;
    border-radius: 9999px;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }

  .isavo-btn-outline-pill:hover {
    background-color: rgba(255, 255, 255, 0.15);
    border-color: #ffffff;
    transform: translateY(-2px);
  }

  .isavo-btn-text {
    font-size: 0.9375rem;
    font-weight: 700;
    color: #ffffff;
  }

  .isavo-btn-arrow-circle {
    width: 38px;
    height: 38px;
    background-color: var(--gvf-blue-vibrant, #0969da);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    transition: transform 0.3s ease, background-color 0.25s ease;
    box-shadow: 0 4px 12px rgba(9, 105, 218, 0.35);
  }

  .isavo-btn-outline-pill:hover .isavo-btn-arrow-circle {
    transform: rotate(45deg);
    background-color: #0052cc;
  }

  .isavo-arrow-icon {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 900px) {
    .isavo-hero-container {
      padding: 0 20px;
    }
    .isavo-hero {
      padding-top: 110px;
      padding-bottom: 60px;
    }
  }
</style>

<script>
  function initHeroCarousel() {
    const root = document.getElementById('hero-carousel');
    if (!root) return;

    const bgItems = root.querySelectorAll<HTMLElement>('.hero-bg-item');
    const slidePanes = root.querySelectorAll<HTMLElement>('.hero-slide-pane');

    const totalSlides = slidePanes.length;
    let currentIndex = 0;
    let slideTimer: ReturnType<typeof setInterval> | null = null;
    const DURATION = 4000;

    function goToSlide(index: number) {
      if (index === currentIndex) return;
      currentIndex = (index + totalSlides) % totalSlides;
      updateUI();
      resetTimer();
    }

    function updateUI() {
      // 1. Update background images
      bgItems.forEach((bg, idx) => {
        bg.classList.toggle('is-active', idx === currentIndex);
      });

      // 2. Update slide content panes
      slidePanes.forEach((pane, idx) => {
        pane.classList.toggle('is-active', idx === currentIndex);
      });
    }

    function nextSlide() {
      goToSlide(currentIndex + 1);
    }

    function prevSlide() {
      goToSlide(currentIndex - 1);
    }

    function resetTimer() {
      if (slideTimer) clearInterval(slideTimer);
      slideTimer = setInterval(nextSlide, DURATION);
    }

    // Keyboard navigation (Left / Right arrow keys)
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') nextSlide();
      if (e.key === 'ArrowLeft') prevSlide();
    });

    // Pause on hover
    root.addEventListener('mouseenter', () => {
      if (slideTimer) clearInterval(slideTimer);
    });
    root.addEventListener('mouseleave', () => {
      resetTimer();
    });

    // Start initial timer
    resetTimer();
  }

  // Run on initial load and Astro page transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroCarousel);
  } else {
    initHeroCarousel();
  }
  document.addEventListener('astro:page-load', initHeroCarousel);
</script>
