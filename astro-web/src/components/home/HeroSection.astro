---
// src/components/home/HeroSection.astro
// Hero Slider 4 Slide Sesuai Urutan Program: Shodaqoh, Infaq, Zakat, Wakaf
// Desain sinematik ala ISAVO dengan kepatuhan prinsip typeui-fundamentals

const heroSlides = [
  {
    id: 'slide-1',
    index: '01',
    label: 'Brand Utama',
    title: 'Membangun Ekosistem Pesantren.<br />Menghadirkan Kebermanfaatan.',
    lead: 'Global Village Fund adalah wadah kebaikan dan kolaborasi untuk memperkuat ekosistem pesantren menuju kemandirian dan dampak sosial.',
    taglineEn: 'Fostering Pesantren Ecosystems for Self-Reliance and Social Impact',
    image: '/gambar design/interior mesjid 2.jpg',
    buttons: [
      { text: 'Jelajahi Program', href: '#program-kebaikan', variant: 'primary' },
      { text: 'Dukung Kebaikan', href: '#donasi', variant: 'outline' }
    ],
    ctaText: 'Kenali Kami | Lihat Program'
  },
  {
    id: 'slide-2',
    index: '02',
    label: 'Pendidikan & Kompetensi',
    badge: 'PENDIDIKAN & KOMPETENSI',
    title: 'Menumbuhkan Potensi,<br />Membangun Kemandirian.',
    lead: 'Mendukung pendidikan, pengembangan kompetensi, dan pembentukan karakter santri sebagai bekal untuk menghadapi masa depan.',
    image: '/gambar design/learning studio & workshop.jpg',
    buttons: [
      { text: 'Lihat Program', href: '#program-kebaikan', variant: 'primary' }
    ]
  },
  {
    id: 'slide-3',
    index: '03',
    label: 'Masjid Khairu Ummah Sugro',
    badge: 'MASJID KHAIRU UMMAH SUGRO',
    title: 'Satu Rumah Allah,<br />Tumbuh Banyak Kebaikan.',
    lead: 'Bersama-sama menyelesaikan pembangunan Masjid Khairu Ummah Sugro sebagai bagian dari ekosistem pembelajaran dan kebermanfaatan pesantren.',
    image: '/gambar design/interior masjid.jpg',
    buttons: [
      { text: 'Dukung Pembangunan', href: '/program/wakaf', variant: 'primary' }
    ]
  },
  {
    id: 'slide-4',
    index: '04',
    label: 'Kemandirian & Lingkungan',
    badge: 'KEMANDIRIAN & LINGKUNGAN',
    title: 'Dari Pesantren,<br />Tumbuh Kemandirian.',
    lead: 'Mengembangkan ekosistem pendidikan, lingkungan, dan kewirausahaan yang saling terhubung untuk menciptakan manfaat yang berkelanjutan.',
    image: '/gambar design/belakang masjid.jpg',
    buttons: [
      { text: 'Jelajahi Ekosistem', href: '#pendekatan', variant: 'primary' }
    ]
  }
];
---

<section class="isavo-hero" id="hero-carousel" aria-roledescription="carousel" aria-label="Global Village Fund Hero">
  <div class="hero-bgs-container" aria-hidden="true">
    {heroSlides.map((slide, i) => (
      <div class={`hero-bg-item ${i === 0 ? 'is-active' : ''}`} data-bg-index={i}>
        <img
          src={slide.image}
          alt={slide.label}
          class="hero-bg-img"
          loading={i === 0 ? 'eager' : 'lazy'}
        />
        <div class="hero-bg-overlay"></div>
      </div>
    ))}
  </div>

  <div class="isavo-hero-container">
    <div class="hero-slides-deck">
      {heroSlides.map((slide, i) => (
        <div
          class={`hero-slide-pane ${i === 0 ? 'is-active' : ''}`}
          data-slide-index={i}
          role="tabpanel"
          aria-label={`Slide ${slide.index}: ${slide.label}`}
        >
          <div class="hero-badge-pill">
            <span class="hero-badge-dot"></span>
            <span class="hero-badge-text">{slide.taglineEn || slide.badge || 'FOSTERING PESANTREN ECOSYSTEMS FOR SELF-RELIANCE AND SOCIAL IMPACT'}</span>
          </div>

          {i === 0 ? (
            <h1 class="isavo-hero-title" set:html={slide.title} />
          ) : (
            <h2 class="isavo-hero-title" set:html={slide.title} />
          )}

          <div class="isavo-hero-sub">
            <p>{slide.lead}</p>
          </div>

          <div class="isavo-hero-cta-wrap">
            {slide.buttons.map((btn) => (
              <a
                href={btn.href}
                class={btn.variant === 'primary' ? 'isavo-btn-primary-pill' : 'isavo-btn-outline-pill'}
              >
                <span>{btn.text}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="hero-carousel-controls" aria-label="Kontrol Slider">
      <div class="hero-dots-row">
        {heroSlides.map((slide, i) => (
          <button
            type="button"
            class={`hero-dot-btn ${i === 0 ? 'is-active' : ''}`}
            data-dot-index={i}
            aria-label={`Lihat Slide ${i + 1}: ${slide.label}`}
            aria-pressed={i === 0 ? 'true' : 'false'}
          ></button>
        ))}
      </div>

      <div class="hero-control-actions">
        <button
          type="button"
          class="hero-ctrl-btn"
          id="hero-prev-btn"
          aria-label="Slide sebelumnya"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <button
          type="button"
          class="hero-ctrl-btn"
          id="hero-pause-btn"
          aria-label="Jeda rotasi otomatis slide"
          aria-pressed="false"
        >
          <svg id="hero-pause-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="6" y="4" width="4" height="16"></rect>
            <rect x="14" y="4" width="4" height="16"></rect>
          </svg>
          <svg id="hero-play-icon" style="display: none;" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
        </button>

        <button
          type="button"
          class="hero-ctrl-btn"
          id="hero-next-btn"
          aria-label="Slide berikutnya"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .isavo-hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding-top: 130px;
    padding-bottom: 70px;
    overflow: hidden;
    background-color: #070e17;
  }

  /* Multi-slide Background Layer */
  .hero-bgs-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }

  .hero-bg-item {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), visibility 1s;
    transform: scale(1);
  }

  .hero-bg-item.is-active {
    opacity: 1;
    visibility: visible;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    filter: brightness(0.85);
    transform: scale(1.0);
    transition: transform 7s cubic-bezier(0.1, 0.9, 0.2, 1);
  }

  .hero-bg-item.is-active .hero-bg-img {
    transform: scale(1.06);
  }

  /* Pen.dev exact dark cinematic overlay */
  .hero-bg-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #061829;
    opacity: 0.72;
  }

  /* typeui principle: 1280px standard container */
  .isavo-hero-container {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .hero-slides-deck {
    max-width: 960px;
    position: relative;
    padding-top: 20px;
  }

  /* Slide Pane Transition */
  .hero-slide-pane {
    display: none;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-slide-pane.is-active {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  /* Badge Pill from Pen.dev */
  .hero-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 32px;
    margin-bottom: 24px;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(4px);
  }

  .hero-badge-dot {
    width: 6px;
    height: 6px;
    background-color: #10b981;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .hero-badge-text {
    font-size: 12px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  /* Pen.dev 72px Display Title */
  .isavo-hero-title {
    font-size: clamp(2.8rem, 5.2vw, 4.5rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin-bottom: 24px;
    font-family: 'Golos Text', system-ui, sans-serif;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .isavo-hero-sub {
    max-width: 720px;
    margin-bottom: 36px;
  }

  .isavo-hero-sub p {
    font-size: 1.0625rem;
    line-height: 1.68;
    color: #e2e8f0;
    font-weight: 400;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6);
    margin-bottom: 10px;
  }

  .hero-tagline-en {
    font-size: 0.95rem !important;
    font-style: italic;
    color: #38bdf8 !important;
    font-weight: 500 !important;
    margin-top: 6px;
    letter-spacing: 0.01em;
  }

  /* Text CTA link: Kenali Kami | Lihat Program */
  .hero-cta-text-nav {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
    font-size: 0.92rem;
    font-weight: 600;
  }

  .hero-text-link {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .hero-text-link:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .hero-text-divider {
    color: rgba(255, 255, 255, 0.3);
  }

  /* Buttons Row (Matching box height: 50px) */
  .isavo-hero-cta-wrap {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .isavo-btn-primary-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 52px;
    background: #0969da;
    border: 1px solid #0969da;
    color: #ffffff;
    padding: 0 28px;
    border-radius: 9999px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.01em;
    white-space: nowrap;
    box-shadow: none;
    transition: transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1), background-color 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .isavo-btn-primary-pill:hover {
    background: #0752a8;
    transform: translateY(-2px);
    box-shadow: none;
  }

  .isavo-btn-primary-pill:active {
    transform: translateY(0) scale(0.98);
  }

  .cta-heart-icon {
    width: 18px;
    height: 18px;
    color: #ffffff;
  }

  .isavo-btn-outline-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 52px;
    background: rgba(255, 255, 255, 0.1);
    outline: 1px solid rgba(255, 255, 255, 0.3);
    outline-offset: -0.5px;
    padding: 0 28px;
    border-radius: 9999px;
    text-decoration: none;
    white-space: nowrap;
    color: #ffffff;
    font-size: 1rem;
    font-weight: 600;
    backdrop-filter: blur(8px);
    transition: transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1), background-color 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .isavo-btn-outline-pill:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .isavo-btn-outline-pill:active {
    transform: translateY(0) scale(0.98);
  }
    font-weight: 600;
    transition: background-color 0.25s ease, transform 0.25s ease;
  }

  .isavo-btn-outline-pill:hover {
    background-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  /* Accessible Carousel Controls */
  .hero-carousel-controls {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    margin-top: 36px;
    padding: 8px 16px;
    background: rgba(6, 24, 41, 0.65);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 9999px;
  }

  .hero-dots-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .hero-dot-btn {
    width: 24px;
    height: 6px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.3);
    border: none;
    cursor: pointer;
    transition: width 200ms cubic-bezier(0.2, 0.8, 0.2, 1), background-color 200ms cubic-bezier(0.2, 0.8, 0.2, 1);
    padding: 0;
    position: relative;
  }

  .hero-dot-btn::after {
    content: '';
    position: absolute;
    inset: -14px -6px;
  }

  .hero-dot-btn.is-active {
    width: 40px;
    background: #0969da;
  }

  .hero-control-actions {
    display: flex;
    align-items: center;
    gap: 4px;
    border-left: 1px solid rgba(255, 255, 255, 0.15);
    padding-left: 12px;
  }

  .hero-ctrl-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: transparent;
    border: 1px solid transparent;
    color: #e2e8f0;
    cursor: pointer;
    transition: background-color 180ms cubic-bezier(0.2, 0.8, 0.2, 1), color 180ms cubic-bezier(0.2, 0.8, 0.2, 1), border-color 180ms cubic-bezier(0.2, 0.8, 0.2, 1), transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hero-ctrl-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.2);
    transform: scale(1.05);
  }

  .hero-ctrl-btn:active {
    transform: scale(0.95);
  }

  @media (max-width: 900px) {
    .isavo-hero-container {
      padding: 0 20px;
    }
    .isavo-hero {
      padding-top: 110px;
      padding-bottom: 60px;
    }
    .hero-carousel-controls {
      margin-top: 28px;
    }
  }
</style>

<script>
  function initHeroCarousel() {
    const root = document.getElementById('hero-carousel');
    if (!root) return;

    const bgItems = root.querySelectorAll<HTMLElement>('.hero-bg-item');
    const slidePanes = root.querySelectorAll<HTMLElement>('.hero-slide-pane');
    const dotBtns = root.querySelectorAll<HTMLButtonElement>('.hero-dot-btn');
    const prevBtn = document.getElementById('hero-prev-btn');
    const nextBtn = document.getElementById('hero-next-btn');
    const pauseBtn = document.getElementById('hero-pause-btn');
    const pauseIcon = document.getElementById('hero-pause-icon');
    const playIcon = document.getElementById('hero-play-icon');

    const totalSlides = slidePanes.length;
    let currentIndex = 0;
    let isPaused = false;
    let slideTimer: ReturnType<typeof setInterval> | null = null;
    const DURATION = 4000;

    function goToSlide(index: number) {
      currentIndex = (index + totalSlides) % totalSlides;
      updateUI();
      if (!isPaused) {
        resetTimer();
      }
    }

    function updateUI() {
      bgItems.forEach((bg, idx) => {
        bg.classList.toggle('is-active', idx === currentIndex);
      });

      slidePanes.forEach((pane, idx) => {
        pane.classList.toggle('is-active', idx === currentIndex);
      });

      dotBtns.forEach((dot, idx) => {
        const active = idx === currentIndex;
        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-pressed', String(active));
      });
    }

    function nextSlide() {
      goToSlide(currentIndex + 1);
    }

    function prevSlide() {
      goToSlide(currentIndex - 1);
    }

    function resetTimer() {
      if (slideTimer) clearInterval(slideTimer);
      if (!isPaused) {
        slideTimer = setInterval(nextSlide, DURATION);
      }
    }

    function togglePause() {
      isPaused = !isPaused;
      if (isPaused) {
        if (slideTimer) clearInterval(slideTimer);
        slideTimer = null;
        if (pauseIcon) pauseIcon.style.display = 'none';
        if (playIcon) playIcon.style.display = 'block';
        pauseBtn?.setAttribute('aria-label', 'Putar rotasi otomatis slide');
        pauseBtn?.setAttribute('aria-pressed', 'true');
      } else {
        if (pauseIcon) pauseIcon.style.display = 'block';
        if (playIcon) playIcon.style.display = 'none';
        pauseBtn?.setAttribute('aria-label', 'Jeda rotasi otomatis slide');
        pauseBtn?.setAttribute('aria-pressed', 'false');
        resetTimer();
      }
    }

    prevBtn?.addEventListener('click', prevSlide);
    nextBtn?.addEventListener('click', nextSlide);
    pauseBtn?.addEventListener('click', togglePause);

    dotBtns.forEach((dot, idx) => {
      dot.addEventListener('click', () => goToSlide(idx));
    });

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') nextSlide();
      if (e.key === 'ArrowLeft') prevSlide();
    });

    root.addEventListener('mouseenter', () => {
      if (!isPaused && slideTimer) clearInterval(slideTimer);
    });
    root.addEventListener('mouseleave', () => {
      if (!isPaused) resetTimer();
    });

    resetTimer();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroCarousel);
  } else {
    initHeroCarousel();
  }
  document.addEventListener('astro:page-load', initHeroCarousel);
</script>
