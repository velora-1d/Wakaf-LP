---
// src/components/home/HeroSection.astro
// Exact ISAVO Hero Section Replication (Screenshot 1)
---

<section class="isavo-hero">
  <!-- Full-Screen Hero Background with Cinematic Dark Overlay -->
  <div class="isavo-hero-bg" aria-hidden="true">
    <img
      src="/gambar design/interior masjid.jpg"
      alt="Global Village Fund"
      class="isavo-hero-img"
    />
    <div class="isavo-hero-overlay"></div>
  </div>

  <div class="isavo-hero-container">
    <div class="isavo-hero-content">
      <!-- Tag Pill with Dot ala ISAVO: • #WADAHKEBAIKANDANKOLABORASI -->
      <div class="isavo-tag-pill isavo-hero-anim isavo-anim-1">
        <span class="isavo-tag-dot"></span>
        <span class="isavo-tag-text">#WADAHKEBAIKANDANKOLABORASI</span>
      </div>

      <!-- Giant Bold Title ala ISAVO -->
      <h1 class="isavo-hero-title isavo-hero-anim isavo-anim-2">
        Kebaikan yang Tumbuh<br />
        Menjadi Kebermanfaatan
      </h1>

      <!-- Supporting Prose ala ISAVO -->
      <div class="isavo-hero-sub isavo-hero-anim isavo-anim-3">
        <p>
          Global Village Fund adalah wadah kebaikan dan kolaborasi yang dikembangkan oleh <strong>Yayasan Permata Cendekia Indonesia (YPCI)</strong> untuk membangun ekosistem pesantren yang mandiri, berkarakter, terampil, dan memberikan dampak nyata bagi masyarakat.
        </p>
        <p style="margin-top: 12px; font-size: 0.98rem; opacity: 0.92;">
          Melalui donasi, zakat, wakaf, dan kemitraan, setiap dukungan diarahkan untuk memperkuat pendidikan, pengembangan kompetensi, kemandirian, serta keberlanjutan ekosistem pesantren.
        </p>
      </div>

      <!-- Dual Pill Buttons ala ISAVO (Donasi Sekarang + Lihat Program) -->
      <div class="isavo-hero-cta-wrap isavo-hero-anim isavo-anim-4">
        <!-- Primary Action: Donasi Sekarang (Red Pill) -->
        <a href="#donasi" class="isavo-btn-primary-pill">
          <svg class="cta-heart-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
          <span>Donasi Sekarang</span>
        </a>

        <!-- Secondary Action: Lihat Program (Outlined Pill) -->
        <a href="#program" class="isavo-btn-outline-pill">
          <span class="isavo-btn-text">Lihat Program</span>
          <span class="isavo-btn-arrow-circle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="isavo-arrow-icon">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .isavo-hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding-top: 140px;
    padding-bottom: 80px;
    overflow: hidden;
    background-color: #0d1117;
  }

  .isavo-hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }

  /* Slow cinematic background zoom-in on page load ala ISAVO */
  .isavo-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    filter: brightness(0.9);
    animation: isavoHeroZoom 1.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    transform-origin: center center;
    will-change: transform;
  }

  @keyframes isavoHeroZoom {
    0% {
      transform: scale(1.1);
    }
    100% {
      transform: scale(1.0);
    }
  }

  /* Deep cinematic dark overlay so white typography pops crisply ala ISAVO */
  .isavo-hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      rgba(10, 15, 24, 0.94) 0%,
      rgba(10, 15, 24, 0.82) 45%,
      rgba(10, 15, 24, 0.45) 100%
    );
  }

  .isavo-hero-container {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 3rem;
  }

  .isavo-hero-content {
    max-width: 820px;
  }

  /* Staggered entrance animations ala ISAVO */
  .isavo-hero-anim {
    opacity: 0;
    transform: translateY(28px);
    animation: isavoSlideUp 0.85s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    will-change: opacity, transform;
  }

  .isavo-anim-1 {
    animation-delay: 0.15s;
  }

  .isavo-anim-2 {
    animation-delay: 0.3s;
  }

  .isavo-anim-3 {
    animation-delay: 0.45s;
  }

  .isavo-anim-4 {
    animation-delay: 0.6s;
  }

  @keyframes isavoSlideUp {
    0% {
      opacity: 0;
      transform: translateY(28px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Tag Pill with dot ala ISAVO: #SOLUSISATUPINTU */
  .isavo-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 0.4rem 1.05rem;
    border-radius: 9999px;
    margin-bottom: 2rem;
  }

  .isavo-tag-dot {
    width: 7px;
    height: 7px;
    background-color: #0969da; /* Blue vibrant accent */
    border-radius: 50%;
    box-shadow: 0 0 8px #0969da;
  }

  .isavo-tag-text {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #ffffff;
    text-transform: uppercase;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  /* Giant Title ala ISAVO */
  .isavo-hero-title {
    font-size: clamp(3.2rem, 6.2vw, 5.75rem);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin-bottom: 1.85rem;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .isavo-hero-sub {
    max-width: 760px;
    margin-bottom: 2.75rem;
  }

  .isavo-hero-sub p {
    font-size: 1.15rem;
    line-height: 1.75;
    color: #f1f5f9 !important;
    font-weight: 400;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.7);
    text-align: justify;
    margin-bottom: 0.75rem;
  }

  .isavo-hero-sub p:last-child {
    margin-bottom: 0;
  }

  .isavo-hero-sub strong {
    color: #ffffff !important;
    font-weight: 700;
  }

  .isavo-hero-cta-wrap {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  /* Primary Pill (Red Gradient ala ISAVO) */
  .isavo-btn-primary-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: linear-gradient(135deg, #e53935 0%, #d32f2f 100%);
    color: #ffffff;
    padding: 0.92rem 2.2rem;
    border-radius: 9999px;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.01em;
    box-shadow: 0 8px 24px rgba(229, 57, 53, 0.45);
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .isavo-btn-primary-pill:hover {
    background: linear-gradient(135deg, #d32f2f 0%, #c62828 100%);
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(229, 57, 53, 0.6);
  }

  .cta-heart-icon {
    width: 20px;
    height: 20px;
    color: #ffffff;
  }

  /* Outlined Pill Button with Circle Arrow ala ISAVO */
  .isavo-btn-outline-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.95rem;
    background: rgba(15, 23, 42, 0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1.5px solid rgba(255, 255, 255, 0.5);
    padding: 0.45rem 0.55rem 0.45rem 1.65rem;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .isavo-btn-outline-pill:hover {
    background-color: rgba(255, 255, 255, 0.18);
    border-color: #ffffff;
    transform: translateY(-2px);
  }

  .isavo-btn-text {
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.01em;
  }

  .isavo-btn-arrow-circle {
    width: 40px;
    height: 40px;
    background-color: #0969da; /* Blue vibrant accent */
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1), background-color 0.25s ease;
    box-shadow: 0 4px 12px rgba(9, 105, 218, 0.4);
  }

  .isavo-btn-outline-pill:hover .isavo-btn-arrow-circle {
    transform: rotate(45deg);
    background-color: #0052cc;
  }

  .isavo-arrow-icon {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 900px) {
    .isavo-hero-container {
      padding: 0 1.5rem;
    }
    .isavo-hero {
      padding-top: 120px;
      min-height: 90vh;
    }
    .isavo-hero-sub br {
      display: none;
    }
  }
</style>
