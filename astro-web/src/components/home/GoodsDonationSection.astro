---
// src/components/home/GoodsDonationSection.astro
// Section Donasi dalam Bentuk Barang — Global Village Fund
// Standar Desain ISAVO & Pen.dev, responsif, tipografi Golos Text murni
---

<section class="goods-donation-section reveal-on-scroll" id="donasi-barang">
  <div class="goods-donation-container">
    <div class="goods-header-wrap">
      <h2 class="goods-main-title">
        Ingin Berdonasi dalam Bentuk Barang?
      </h2>

      <p class="goods-lead-desc">
        Setiap kontribusi berupa barang dapat membantu memenuhi berbagai kebutuhan pembangunan, fasilitas, operasional, pendidikan, dan pengembangan sarana produktif. Pilih bentuk kontribusi yang ingin Anda salurkan melalui infak atau sedekah dalam bentuk barang.
      </p>
    </div>

    <div class="goods-cards-grid">
      <!-- Card 1: Infak Barang -->
      <div class="goods-card card-infak">
        <div class="goods-card-badge">
          <span>INSTRUMEN INFAK</span>
        </div>

        <h3 class="goods-card-title">Infak dalam Bentuk Barang</h3>
        <p class="goods-card-summary">
          Salurkan material pembangunan, perlengkapan operasional, maupun peralatan penunjang program sesuai kebutuhan yang tersedia. Setiap kontribusi akan diarahkan berdasarkan peruntukan infak dan kebutuhan program.
        </p>

        <div class="goods-examples-box">
          <div class="goods-examples-title">Kategori Barang yang Dibutuhkan:</div>
          <ul class="goods-examples-list">
            <li>
              <span class="list-bullet">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </span>
              <span><strong>Konstruksi &amp; Material:</strong> Semen, bata ringan, pasir, besi beton, baja ringan, keramik, cat.</span>
            </li>
            <li>
              <span class="list-bullet">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </span>
              <span><strong>Fasilitas &amp; Sanitasi:</strong> Kusen pintu/jendela, aluminium, kaca, kabel, saklar, lampu, pipa air, pompa sumur.</span>
            </li>
            <li>
              <span class="list-bullet">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </span>
              <span><strong>Pemberdayaan:</strong> Peralatan greenhouse, mesin pertanian, instalasi fertigasi, alat produksi pangan.</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Card 2: Sedekah Barang -->
      <div class="goods-card card-sedekah">
        <div class="goods-card-badge">
          <span>INSTRUMEN SEDEKAH</span>
        </div>

        <h3 class="goods-card-title">Sedekah dalam Bentuk Barang</h3>
        <p class="goods-card-summary">
          Berikan bahan pangan, perlengkapan, peralatan, maupun kebutuhan lainnya yang dapat dimanfaatkan untuk mendukung berbagai fasilitas dan kelancaran aktivitas santri mukim.
        </p>

        <div class="goods-examples-box">
          <div class="goods-examples-title">Kategori Barang yang Dibutuhkan:</div>
          <ul class="goods-examples-list">
            <li>
              <span class="list-bullet">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </span>
              <span><strong>Pangan &amp; Konsumsi:</strong> Beras, minyak goreng, telur, sayur mayur segar, lauk pauk, makanan bernutrisi.</span>
            </li>
            <li>
              <span class="list-bullet">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </span>
              <span><strong>Perlengkapan Asrama &amp; Ibadah:</strong> Ranjang kasur, meja belajar lipat, lemari loker, karpet masjid, sajadah.</span>
            </li>
            <li>
              <span class="list-bullet">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </span>
              <span><strong>Pendidikan &amp; Media:</strong> Kitab Al-Quran, buku bacaan, alat tulis, perangkat komputer PC/laptop, proyektor.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- WhatsApp Confirmation Banner -->
    <div class="goods-cta-banner">
      <div class="goods-cta-info">
        <h4 class="goods-cta-heading">Prosedur Konfirmasi Penyerahan Donasi Barang</h4>
        <p class="goods-cta-text">
          Untuk menyalurkan donasi barang, silakan hubungi Customer Service Global Village Fund melalui WhatsApp dengan menyampaikan jenis dan jumlah barang yang ingin didonasikan. Tim kami akan membantu proses konfirmasi, kesesuaian kebutuhan, serta informasi penyerahan donasi ke lokasi Jonggol.
        </p>
      </div>

      <div class="goods-cta-action">
        <a
          href="https://wa.me/6287865994786?text=Assalamu'alaikum%20Tim%20Global%20Village%20Fund,%20saya%20ingin%20berdonasi%20dalam%20bentuk%20barang"
          target="_blank"
          rel="noopener noreferrer"
          class="goods-wa-btn"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          <span>Konfirmasi Donasi Barang via WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .goods-donation-section {
    position: relative;
    padding: 90px 0;
    background-color: #f8fafc;
  }

  .goods-donation-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .goods-header-wrap {
    max-width: 860px;
    margin: 0 auto 54px auto;
    text-align: center;
  }

  /* Badge Pill */
  .goods-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px 6px 10px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 32px;
    box-shadow: 0px 1px 4px rgba(0, 0, 0, 0.04);
    margin-bottom: 16px;
  }

  .dot-halo {
    position: relative;
    width: 14px;
    height: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .halo-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(9, 105, 218, 0.12);
  }

  .core-dot {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #0969da;
  }

  .badge-text {
    font-size: 12px;
    font-weight: 700;
    color: #0969da;
    letter-spacing: 0.06em;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  .goods-main-title {
    font-family: 'Golos Text', system-ui, sans-serif;
    font-size: clamp(2rem, 3.2vw, 44px);
    font-weight: 500;
    line-height: 1.2;
    color: #0f172a;
    letter-spacing: -0.01em;
    margin: 0 0 16px 0;
  }

  .goods-lead-desc {
    font-family: 'Golos Text', system-ui, sans-serif;
    font-size: 16px;
    line-height: 27px;
    color: #475569;
    margin: 0;
  }

  /* 2-Card Grid */
  .goods-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    margin-bottom: 40px;
  }

  @media (max-width: 860px) {
    .goods-cards-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  .goods-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 36px;
    border: 1px solid #e2e8f0;
    box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    transition: transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .goods-card:hover {
    transform: translateY(-4px);
    box-shadow: 0px 12px 32px rgba(9, 105, 218, 0.08);
  }

  .goods-card-badge {
    display: inline-block;
    align-self: flex-start;
    padding: 4px 10px;
    background: #eff6ff;
    color: #0969da;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    border-radius: 6px;
    margin-bottom: 16px;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  .goods-card-title {
    font-family: 'Golos Text', system-ui, sans-serif;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.25;
    color: #0f172a;
    margin: 0 0 12px 0;
  }

  .goods-card-summary {
    font-family: 'Golos Text', system-ui, sans-serif;
    font-size: 15px;
    line-height: 25px;
    color: #64748b;
    margin: 0 0 24px 0;
  }

  .goods-examples-box {
    background: #f8fafc;
    border-radius: 12px;
    padding: 20px;
    border: 1px solid #f1f5f9;
    margin-top: auto;
  }

  .goods-examples-title {
    font-family: 'Golos Text', system-ui, sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: #334155;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 12px;
  }

  .goods-examples-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .goods-examples-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-family: 'Golos Text', system-ui, sans-serif;
    font-size: 13.5px;
    line-height: 21px;
    color: #475569;
  }

  .goods-examples-list li strong {
    color: #0f172a;
  }

  .list-bullet {
    color: #0969da;
    flex-shrink: 0;
    margin-top: 3px;
  }

  /* WhatsApp CTA Banner */
  .goods-cta-banner {
    background: #ffffff;
    border-radius: 20px;
    padding: 32px 40px;
    border: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    box-shadow: 0px 4px 16px rgba(0, 0, 0, 0.03);
  }

  @media (max-width: 900px) {
    .goods-cta-banner {
      flex-direction: column;
      align-items: flex-start;
      padding: 28px;
    }
  }

  .goods-cta-info {
    max-width: 780px;
  }

  .goods-cta-heading {
    font-family: 'Golos Text', system-ui, sans-serif;
    font-size: 18px;
    font-weight: 600;
    color: #0f172a;
    margin: 0 0 8px 0;
  }

  .goods-cta-text {
    font-family: 'Golos Text', system-ui, sans-serif;
    font-size: 14.5px;
    line-height: 24px;
    color: #64748b;
    margin: 0;
  }

  .goods-cta-action {
    flex-shrink: 0;
  }

  .goods-wa-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    background: #0969da;
    color: #ffffff;
    font-family: 'Golos Text', system-ui, sans-serif;
    font-size: 14.5px;
    font-weight: 600;
    border-radius: 9999px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(9, 105, 218, 0.25);
    transition: background-color 150ms ease, transform 150ms ease;
  }

  .goods-wa-btn:hover {
    background: #0752a8;
    transform: translateY(-2px);
  }

  .goods-wa-btn:active {
    transform: translateY(0);
  }
</style>
