---
// src/components/home/InteractiveServicesSection.astro
// Exact ISAVO "Jelajahi Layanan Desain Interior Kami Yang Menyeluruh" Interactive Split + Stats (Screenshot 2)
---

<section class="isavo-interactive-section" id="layanan">
  <div class="isavo-interactive-container">
    <div class="isavo-interactive-header">
      <div class="header-badge-pill">
        <span class="header-dot-halo">
          <span class="header-halo-ring"></span>
          <span class="header-core-dot"></span>
        </span>
        <span class="header-badge-text">Ekosistem Skill Village GVF</span>
      </div>

      <h2 class="isavo-interactive-title">
        Jelajahi Ekosistem Terpadu Skill Village Jonggol
      </h2>

      <p class="isavo-interactive-sub">
        Pengembangan ekosistem Skill Village mencakup pendidikan dan pembinaan karakter, keterampilan vokasi, kewirausahaan, pertanian produktif, serta fasilitas kehidupan yang saling mendukung.
      </p>
    </div>

    <div class="isavo-interactive-split">
      <div class="isavo-preview-card" id="service-preview-panel" role="tabpanel" aria-labelledby="service-tab-0">
        <div class="isavo-preview-media">
          <img
            id="preview-img"
            src="/bahan-konten/kegiatan-dan-prestasi-santri/suasana-kbm-santri-ikhwan-di-aula.webp"
            alt="Pendidikan dan Pembinaan Karakter Santri"
            class="isavo-preview-image"
          />
        </div>

        <div class="isavo-glass-caption">
          <p id="preview-caption-text">
            Pembinaan adab, kurikulum vokasi FAST, dan tahfidz Al-Quran intensif untuk mencetak santri yang berakhlak mulia dan mandiri.
          </p>
        </div>
      </div>

      <div class="isavo-services-list" role="tablist" aria-label="Daftar Ekosistem Terpadu">
        <button
          type="button"
          class="isavo-service-item is-active"
          id="service-tab-0"
          role="tab"
          aria-selected="true"
          aria-controls="service-preview-panel"
          tabindex="0"
          data-index="0"
          data-img="/bahan-konten/kegiatan-dan-prestasi-santri/suasana-kbm-santri-ikhwan-di-aula.webp"
          data-caption="Pembinaan adab, kurikulum vokasi FAST, dan tahfidz Al-Quran intensif untuk mencetak santri yang berakhlak mulia dan mandiri."
        >
          <div class="isavo-item-left">
            <span class="isavo-item-num">01</span>
            <span class="isavo-item-title">Pendidikan &amp; Pembinaan Karakter</span>
          </div>
          <div class="isavo-item-arrow-wrap">
            <span class="isavo-item-arrow-circle">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="isavo-arrow-svg">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </span>
          </div>
        </button>

        <button
          type="button"
          class="isavo-service-item"
          id="service-tab-1"
          role="tab"
          aria-selected="false"
          aria-controls="service-preview-panel"
          tabindex="-1"
          data-index="1"
          data-img="/bahan-konten/masjid-dan-kelas/kandang-ayam-petelur.jpeg"
          data-caption="Unit usaha produktif peternakan ayam petelur dan praktik kewirausahaan santri vokasi sebagai bekal kemandirian ekonomi nyata."
        >
          <div class="isavo-item-left">
            <span class="isavo-item-num">02</span>
            <span class="isavo-item-title">Keterampilan Vokasi &amp; Wirausaha</span>
          </div>
          <div class="isavo-item-arrow-wrap">
            <span class="isavo-item-arrow-circle">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="isavo-arrow-svg">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </span>
          </div>
        </button>

        <button
          type="button"
          class="isavo-service-item"
          id="service-tab-2"
          role="tab"
          aria-selected="false"
          aria-controls="service-preview-panel"
          tabindex="-1"
          data-index="2"
          data-img="/bahan-konten/masjid-dan-kelas/sayuran-kangkung.jpeg"
          data-caption="Budidaya sayuran hijau segar dan pemanfaatan lahan kebun produktif sebagai penopang ketahanan pangan mandiri santri."
        >
          <div class="isavo-item-left">
            <span class="isavo-item-num">03</span>
            <span class="isavo-item-title">Pertanian Produktif &amp; Pangan</span>
          </div>
          <div class="isavo-item-arrow-wrap">
            <span class="isavo-item-arrow-circle">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="isavo-arrow-svg">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </span>
          </div>
        </button>

        <button
          type="button"
          class="isavo-service-item"
          id="service-tab-3"
          role="tab"
          aria-selected="false"
          aria-controls="service-preview-panel"
          tabindex="-1"
          data-index="3"
          data-img="/bahan-konten/fasilitas-dan-infrastruktur/pelataran-depan-masjid.webp"
          data-caption="Masjid Khairu Ummah Sugro sebagai pusat ibadah kawasan terpadu serta fasilitas asrama santri yang bersih dan tertata."
        >
          <div class="isavo-item-left">
            <span class="isavo-item-num">04</span>
            <span class="isavo-item-title">Fasilitas Kehidupan &amp; Ibadah</span>
          </div>
          <div class="isavo-item-arrow-wrap">
            <span class="isavo-item-arrow-circle">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="isavo-arrow-svg">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </span>
          </div>
        </button>
      </div>
    </div>
  </div>
</section>

<!-- Client Interactivity Script -->
<script>
  const serviceItems = document.querySelectorAll<HTMLButtonElement>('.isavo-service-item');
  const previewImg = document.getElementById('preview-img') as HTMLImageElement;
  const captionText = document.getElementById('preview-caption-text');
  const previewPanel = document.getElementById('service-preview-panel');

  function activateTab(index: number) {
    serviceItems.forEach((btn, idx) => {
      const isTarget = idx === index;
      btn.classList.toggle('is-active', isTarget);
      btn.setAttribute('aria-selected', String(isTarget));
      btn.setAttribute('tabindex', isTarget ? '0' : '-1');
      if (isTarget) {
        btn.focus();
        previewPanel?.setAttribute('aria-labelledby', btn.id);

        const imgSrc = btn.getAttribute('data-img');
        const caption = btn.getAttribute('data-caption');

        if (previewImg && imgSrc) {
          previewImg.style.opacity = '0';
          previewImg.style.transform = 'scale(0.97)';
          setTimeout(() => {
            previewImg.src = imgSrc;
            previewImg.alt = btn.querySelector('.isavo-item-title')?.textContent || 'Pratinjau Layanan';
            previewImg.style.opacity = '1';
            previewImg.style.transform = 'scale(1)';
          }, 180);
        }

        if (captionText && caption) {
          captionText.style.opacity = '0';
          setTimeout(() => {
            captionText.innerHTML = caption;
            captionText.style.opacity = '1';
          }, 180);
        }
      }
    });
  }

  serviceItems.forEach((btn, idx) => {
    btn.addEventListener('click', () => activateTab(idx));

    // Keyboard Arrow Navigation
    btn.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
        e.preventDefault();
        activateTab((idx + 1) % serviceItems.length);
      } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
        e.preventDefault();
        activateTab((idx - 1 + serviceItems.length) % serviceItems.length);
      }
    });
  });
</script>

<style>
  .isavo-interactive-section {
    position: relative;
    background-color: #ffffff;
    padding: 60px 0 80px 0;
    overflow: hidden;
  }

  .isavo-interactive-container {
    width: 100%;
    max-width: 1425px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Header Centered ala Pen.dev */
  .isavo-interactive-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 48px;
  }

  .header-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px 5px 10px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 32px;
    box-shadow: 0px 1px 4px rgba(0, 0, 0, 0.04);
    margin-bottom: 16px;
  }

  .header-dot-halo {
    position: relative;
    width: 14px;
    height: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .header-halo-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(9, 105, 218, 0.12);
  }

  .header-core-dot {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #0969da;
  }

  .header-badge-text {
    font-size: 12px;
    font-weight: 600;
    color: #000000;
    letter-spacing: 0.2px;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  .isavo-interactive-title {
    font-size: clamp(2rem, 3.2vw, 48px);
    font-weight: 400;
    line-height: 1.2;
    color: #000000;
    font-family: 'Golos Text', system-ui, sans-serif;
    margin: 0 0 16px 0;
    text-align: center;
  }

  .isavo-interactive-sub {
    font-size: 16px;
    line-height: 26px;
    color: #62625b;
    max-width: 820px;
    margin: 0;
    text-align: center;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  /* 2-Column Split */
  .isavo-interactive-split {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 48px;
    align-items: center;
  }

  /* Left: Preview Card with 16px Radius ala Pen.dev */
  .isavo-preview-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    height: 500px;
    background-color: #061829;
  }

  .isavo-preview-media {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .isavo-preview-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 240ms cubic-bezier(0.2, 0.8, 0.2, 1), transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* Glass Floating Box Inside Image ala Pen.dev */
  .isavo-glass-caption {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    max-width: 440px;
    background: #061829;
    opacity: 0.95;
    backdrop-filter: blur(14.5px);
    -webkit-backdrop-filter: blur(14.5px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 24px 30px;
  }

  .isavo-glass-caption p {
    font-size: 15px;
    line-height: 26px;
    color: #ffffff;
    margin: 0;
    font-family: 'Golos Text', system-ui, sans-serif;
    transition: opacity 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* Right: Interactive List */
  .isavo-services-list {
    display: flex;
    flex-direction: column;
  }

  .isavo-service-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 24px 0;
    background: transparent;
    border: none;
    border-bottom: 1px solid #e3e3e8;
    text-align: left;
    cursor: pointer;
    font-family: 'Golos Text', system-ui, sans-serif;
    transition: color 180ms cubic-bezier(0.2, 0.8, 0.2, 1), transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .isavo-service-item:active {
    transform: scale(0.99);
  }

  .isavo-service-item:focus-visible {
    outline: 2px solid #0969da;
    outline-offset: 4px;
    border-radius: 4px;
  }

  .isavo-service-item:first-child {
    border-top: 1px solid #e3e3e8;
  }

  .isavo-item-left {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .isavo-item-num {
    font-size: 16px;
    font-weight: 400;
    color: #62625b;
    font-family: 'Golos Text', system-ui, sans-serif;
    transition: color 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .isavo-item-title {
    font-size: clamp(1.4rem, 2.2vw, 36px);
    font-weight: 400;
    line-height: 1.25;
    color: #000000;
    font-family: 'Golos Text', system-ui, sans-serif;
    transition: color 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* Arrow Circle ala Pen.dev */
  .isavo-item-arrow-circle {
    width: 42px;
    height: 42px;
    border-radius: 32px;
    background-color: #0969da;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1), background-color 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .isavo-arrow-svg {
    width: 18px;
    height: 18px;
  }

  /* ACTIVE STATE ALA PEN.DEV */
  .isavo-service-item.is-active .isavo-item-num {
    color: #0969da;
  }

  .isavo-service-item.is-active .isavo-item-title {
    color: #0969da;
  }

  .isavo-service-item.is-active .isavo-item-arrow-circle {
    transform: rotate(-45deg);
  }

  .isavo-service-item:hover:not(.is-active) .isavo-item-title {
    color: #0969da;
  }

  @media (max-width: 1024px) {
    .isavo-interactive-split {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .isavo-preview-card {
      height: 380px;
    }
  }
</style>
