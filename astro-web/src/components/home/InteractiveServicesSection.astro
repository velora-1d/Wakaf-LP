---
// src/components/home/InteractiveServicesSection.astro
// Exact ISAVO "Jelajahi Layanan Desain Interior Kami Yang Menyeluruh" Interactive Split + Stats (Screenshot 2)
---

<section class="isavo-interactive-section" id="layanan">
  <div class="isavo-interactive-container">
    <!-- Header Centered ala Pen.dev -->
    <div class="isavo-interactive-header">
      <div class="header-badge-pill">
        <span class="header-dot-halo">
          <span class="header-halo-ring"></span>
          <span class="header-core-dot"></span>
        </span>
        <span class="header-badge-text">Ekosistem Global Skill Village Fund</span>
      </div>

      <h2 class="isavo-interactive-title">
        Jelajahi Ekosistem Terpadu Global Skill Village Fund
      </h2>

      <p class="isavo-interactive-sub">
        Mewujudkan visi kemandirian umat dan peradaban generasi santri melalui integrasi sarana ibadah, pendidikan kejuruan vokasi, agroteknologi, dan infrastruktur berkelanjutan.
      </p>
    </div>

    <!-- Interactive 2-Column Split: Image Preview (Left) & 4-Item List (Right) -->
    <div class="isavo-interactive-split">
      <!-- Left: Big Rounded Card (16px radius) with Floating Glass Caption ala Pen.dev -->
      <div class="isavo-preview-card">
        <div class="isavo-preview-media">
          <img
            id="preview-img"
            src="/gambar design/skywalk learning room.jpg"
            alt="Masjid Khairu Ummah Sugro"
            class="isavo-preview-image"
          />
        </div>

        <!-- Glass Caption Card at Bottom Inside Image ala Pen.dev -->
        <div class="isavo-glass-caption">
          <p id="preview-caption-text">
            Solusi desain arsitektur hijau &amp; ramah lingkungan untuk pusat ibadah, mezanin dua lantai, dan ruang belajar santri.
          </p>
        </div>
      </div>

      <!-- Right: Interactive 4-Item List with Hairline Dividers ala Pen.dev -->
      <div class="isavo-services-list">
        <!-- Item 01 -->
        <button
          type="button"
          class="isavo-service-item is-active"
          data-index="0"
          data-img="/gambar design/skywalk learning room.jpg"
          data-caption="Solusi desain arsitektur hijau &amp; ramah lingkungan untuk pusat ibadah, mezanin dua lantai, dan ruang belajar santri."
        >
          <div class="isavo-item-left">
            <span class="isavo-item-num">01</span>
            <span class="isavo-item-title">Masjid Khairu Ummah Sugro</span>
          </div>
          <div class="isavo-item-arrow-wrap">
            <span class="isavo-item-arrow-circle">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="isavo-arrow-svg">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </span>
          </div>
        </button>

        <!-- Item 02 -->
        <button
          type="button"
          class="isavo-service-item"
          data-index="1"
          data-img="/gambar design/learning studio & workshop.jpg"
          data-caption="Pesantren vokasi kejuruan dengan kurikulum teknik konstruksi &amp; kewirausahaan santri."
        >
          <div class="isavo-item-left">
            <span class="isavo-item-num">02</span>
            <span class="isavo-item-title">SMK Skill Village Vokasi</span>
          </div>
          <div class="isavo-item-arrow-wrap">
            <span class="isavo-item-arrow-circle">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="isavo-arrow-svg">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </span>
          </div>
        </button>

        <!-- Item 03 -->
        <button
          type="button"
          class="isavo-service-item"
          data-index="2"
          data-img="/gambar design/gh learning area.jpg"
          data-caption="Laboratorium agro-technopark pemuliaan anggur, hortikultura organik, dan ketahanan pangan mandiri pesantren."
        >
          <div class="isavo-item-left">
            <span class="isavo-item-num">03</span>
            <span class="isavo-item-title">Agro-Technopark Hortikultura</span>
          </div>
          <div class="isavo-item-arrow-wrap">
            <span class="isavo-item-arrow-circle">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="isavo-arrow-svg">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </span>
          </div>
        </button>

        <!-- Item 04 -->
        <button
          type="button"
          class="isavo-service-item"
          data-index="3"
          data-img="/gambar design/belakang masjid.jpg"
          data-caption="Infrastruktur ramah lingkungan dengan panel surya mandiri dan konservasi air bersih."
        >
          <div class="isavo-item-left">
            <span class="isavo-item-num">04</span>
            <span class="isavo-item-title">Energi Bersih Solar Panel &amp; Air</span>
          </div>
          <div class="isavo-item-arrow-wrap">
            <span class="isavo-item-arrow-circle">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="isavo-arrow-svg">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </span>
          </div>
        </button>
      </div>
    </div>
  </div>
</section>

<!-- Client Interactivity Script -->
<script>
  const serviceItems = document.querySelectorAll('.isavo-service-item');
  const previewImg = document.getElementById('preview-img') as HTMLImageElement;
  const captionText = document.getElementById('preview-caption-text');

  serviceItems.forEach((btn) => {
    btn.addEventListener('click', () => {
      serviceItems.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      const imgSrc = btn.getAttribute('data-img');
      const caption = btn.getAttribute('data-caption');

      if (previewImg && imgSrc) {
        previewImg.style.opacity = '0';
        previewImg.style.transform = 'scale(0.97)';
        setTimeout(() => {
          previewImg.src = imgSrc;
          previewImg.style.opacity = '1';
          previewImg.style.transform = 'scale(1)';
        }, 180);
      }

      if (captionText && caption) {
        captionText.style.opacity = '0';
        setTimeout(() => {
          captionText.innerHTML = caption;
          captionText.style.opacity = '1';
        }, 180);
      }
    });
  });
</script>

<style>
  .isavo-interactive-section {
    position: relative;
    background-color: #ffffff;
    padding: 60px 0 80px 0;
    overflow: hidden;
  }

  .isavo-interactive-container {
    width: 100%;
    max-width: 1425px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Header Centered ala Pen.dev */
  .isavo-interactive-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 48px;
  }

  .header-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px 5px 10px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 32px;
    box-shadow: 0px 1px 4px rgba(0, 0, 0, 0.04);
    margin-bottom: 16px;
  }

  .header-dot-halo {
    position: relative;
    width: 14px;
    height: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .header-halo-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(0, 107, 62, 0.12);
  }

  .header-core-dot {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #006B3E;
  }

  .header-badge-text {
    font-size: 12px;
    font-weight: 600;
    color: #000000;
    letter-spacing: 0.2px;
    font-family: 'Inter', system-ui, sans-serif;
  }

  .isavo-interactive-title {
    font-size: clamp(2rem, 3.2vw, 48px);
    font-weight: 400;
    line-height: 1.2;
    color: #000000;
    font-family: 'Inter', system-ui, sans-serif;
    margin: 0 0 16px 0;
    text-align: center;
  }

  .isavo-interactive-sub {
    font-size: 16px;
    line-height: 26px;
    color: #62625b;
    max-width: 820px;
    margin: 0;
    text-align: center;
    font-family: 'Inter', system-ui, sans-serif;
  }

  /* 2-Column Split */
  .isavo-interactive-split {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 48px;
    align-items: center;
  }

  /* Left: Preview Card with 16px Radius ala Pen.dev */
  .isavo-preview-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    height: 500px;
    background-color: #061829;
  }

  .isavo-preview-media {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .isavo-preview-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.35s ease, transform 0.4s ease;
  }

  /* Glass Floating Box Inside Image ala Pen.dev */
  .isavo-glass-caption {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    max-width: 440px;
    background: #061829;
    opacity: 0.95;
    backdrop-filter: blur(14.5px);
    -webkit-backdrop-filter: blur(14.5px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 24px 30px;
  }

  .isavo-glass-caption p {
    font-size: 15px;
    line-height: 26px;
    color: #ffffff;
    margin: 0;
    font-family: 'Inter', system-ui, sans-serif;
    transition: opacity 0.25s ease;
  }

  /* Right: Interactive List */
  .isavo-services-list {
    display: flex;
    flex-direction: column;
  }

  .isavo-service-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 24px 0;
    background: transparent;
    border: none;
    border-bottom: 1px solid #e3e3e8;
    text-align: left;
    cursor: pointer;
    font-family: 'Inter', system-ui, sans-serif;
    transition: all 0.25s ease;
  }

  .isavo-service-item:first-child {
    border-top: 1px solid #e3e3e8;
  }

  .isavo-item-left {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .isavo-item-num {
    font-size: 16px;
    font-weight: 400;
    color: #62625b;
    font-family: 'Inter', system-ui, sans-serif;
    transition: color 0.25s ease;
  }

  .isavo-item-title {
    font-size: clamp(1.4rem, 2.2vw, 36px);
    font-weight: 400;
    line-height: 1.25;
    color: #000000;
    font-family: 'Inter', system-ui, sans-serif;
    transition: color 0.25s ease;
  }

  /* Arrow Circle ala Pen.dev */
  .isavo-item-arrow-circle {
    width: 42px;
    height: 42px;
    border-radius: 32px;
    background-color: #006B3E;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .isavo-arrow-svg {
    width: 18px;
    height: 18px;
  }

  /* ACTIVE STATE ALA PEN.DEV */
  .isavo-service-item.is-active .isavo-item-num {
    color: #006B3E;
  }

  .isavo-service-item.is-active .isavo-item-title {
    color: #006B3E;
  }

  .isavo-service-item.is-active .isavo-item-arrow-circle {
    transform: rotate(-45deg);
  }

  .isavo-service-item:hover:not(.is-active) .isavo-item-title {
    color: #006B3E;
  }

  @media (max-width: 1024px) {
    .isavo-interactive-split {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .isavo-preview-card {
      height: 380px;
    }
  }
</style>
