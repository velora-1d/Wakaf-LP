---
// src/components/home/WhyWeExistSection.astro
// Section 02: Why We Exist — Data Urgensi Sosial & Rantai Transformasi Nilai
// v2.0 — Dengan counter animation, stagger grid, reveal-heading
---

<section class="why-exist-section" id="why-we-exist">
  <div class="why-exist-container">
    <!-- Header Pendek & Padat -->
    <div class="why-exist-header text-center">
      <span class="section-kicker reveal-on-scroll">Kenapa Global Village Fund?</span>
      <h2 class="why-exist-title reveal-heading">
        Kebaikan yang Tumbuh Menjadi Ekosistem.
      </h2>
      <p class="why-exist-lead reveal-on-scroll" data-delay="0.1">
        Kebaikan tidak berhenti pada satu bantuan. Ia dapat tumbuh menjadi pendidikan, kompetensi, kemandirian, dan kebermanfaatan yang dirasakan lebih luas.
      </p>
      <p class="why-exist-sub reveal-on-scroll" data-delay="0.2">
        Global Village Fund hadir sebagai wadah kebaikan dan kolaborasi untuk mendukung penguatan ekosistem pesantren—menghubungkan pendidikan, pengembangan kompetensi, lingkungan, kemandirian, dan kebermanfaatan sosial.
      </p>
    </div>

    <!-- 4 Metrik Kunci — stagger grid dengan counter animation -->
    <div class="stats-compact-grid reveal-stagger">
      <div class="stat-compact-card">
        <div class="stat-icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="stat-icon-svg">
            <path d="M12 3c-1.5 2-3 3.5-3 5.5a3 3 0 1 0 6 0c0-2-1.5-3.5-3-5.5z"></path>
            <path d="M4 21V10l8-5 8 5v11H4z"></path>
            <path d="M9 21v-6a3 3 0 0 1 6 0v6"></path>
          </svg>
        </div>
        <span class="stat-val">1</span>
        <h3 class="stat-name">Pilot Project</h3>
        <p class="stat-info">Pesantren Integratif Holistik Skill Village Islamic School di Jonggol Bogor.</p>
      </div>

      <div class="stat-compact-card">
        <div class="stat-icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="stat-icon-svg">
            <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>
          </svg>
        </div>
        <span class="stat-val">±3 Ha</span>
        <h3 class="stat-name">Kawasan Pengembangan</h3>
        <p class="stat-info">Lahan terpadu masjid, ruang vokasi, greenhouse, & agriteknologi ramah lingkungan.</p>
      </div>

      <div class="stat-compact-card">
        <div class="stat-icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="stat-icon-svg">
            <circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/>
          </svg>
        </div>
        <span class="stat-val">FAST</span>
        <h3 class="stat-name">Character Development</h3>
        <p class="stat-info">Pembentukan karakter luhur Fathonah, Amanah, Shiddiq, dan Tabligh.</p>
      </div>

      <div class="stat-compact-card">
        <div class="stat-icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="stat-icon-svg">
            <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 0v10l6 3"/>
          </svg>
        </div>
        <span class="stat-val">∞</span>
        <h3 class="stat-name">Potensi Kebermanfaatan</h3>
        <p class="stat-info">Pahala jariyah abadi dan dampak kemandirian yang terus berlipat ganda.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .why-exist-section {
    position: relative;
    padding: var(--section-padding-y) 0;
    background-color: #ffffff;
    overflow: hidden;
  }

  /* Background accent lines */
  .why-exist-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, var(--color-border) 30%, var(--color-border) 70%, transparent 100%);
  }

  .why-exist-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  /* Compact Header */
  .why-exist-header {
    max-width: 820px;
    margin: 0 auto var(--space-9);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .why-exist-title {
    font-size: var(--text-heading-lg);
    font-weight: 800;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tighter);
    color: var(--color-text-heading);
    margin-bottom: var(--space-2);
    font-family: var(--font-display);
  }

  .why-exist-lead {
    font-size: var(--text-body-lg);
    line-height: var(--leading-loose);
    color: var(--color-text-body);
    font-weight: 500;
  }

  .why-exist-sub {
    font-size: var(--text-small);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    max-width: 680px;
  }

  /* ── Stat Cards Grid ─────────────────────────────── */
  .stats-compact-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }

  .stat-compact-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-7) var(--space-6);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    transition:
      border-color var(--duration-normal) var(--ease-out),
      box-shadow   var(--duration-normal) var(--ease-out),
      transform    var(--duration-normal) var(--ease-out);
    will-change: transform;
  }

  /* Subtle top accent line on hover */
  .stat-compact-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--blue-400), var(--blue-600));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .stat-compact-card:hover {
    border-color: var(--blue-200);
    box-shadow: var(--shadow-lg), 0 0 0 1px hsl(214 89% 52% / 0.08);
    transform: translateY(-4px);
  }

  .stat-compact-card:hover::before {
    transform: scaleX(1);
  }

  /* Icon */
  .stat-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--blue-50);
    color: var(--blue-500);
    margin-bottom: var(--space-5);
    transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }

  .stat-compact-card:hover .stat-icon-wrap {
    background: var(--blue-100);
    color: var(--blue-700);
  }

  .stat-icon-svg {
    width: 20px;
    height: 20px;
  }

  .stat-val {
    font-size: 2.5rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: var(--tracking-tighter);
    color: var(--blue-600);
    font-variant-numeric: tabular-nums;
    margin-bottom: var(--space-3);
    font-family: var(--font-display);
    display: block;
  }

  .stat-name {
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-text-heading);
    margin-bottom: var(--space-2);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
  }

  .stat-info {
    font-size: 0.8125rem;
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    margin: 0;
    flex: 1;
  }

  @media (max-width: 1024px) {
    .stats-compact-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .why-exist-section {
      padding: var(--section-padding-y-sm) 0;
    }
    .why-exist-container {
      padding: 0 var(--space-5);
    }
    .why-exist-header {
      margin-bottom: var(--space-7);
    }
    .stats-compact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>
