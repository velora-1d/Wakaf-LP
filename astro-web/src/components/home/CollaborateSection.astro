---
// src/components/home/CollaborateSection.astro
// Section 12: Collaborate — Matriks Kemitraan 5 Stakeholder YPCI
const partners = [
  {
    role: 'Perguruan Tinggi',
    badge: 'AKADEMIK & RISET',
    desc: 'Pengembangan kurikulum vokasi, transfer teknologi aplikatif, riset pertanian, dan beasiswa lanjutan.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>`
  },
  {
    role: 'Perusahaan & Industri',
    badge: 'CSR, ESG & MAGANG',
    desc: 'Keahlian teknologi, fasilitas teaching factory, penyaluran magang santri, dan penyerapan kerja.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><path d="M9 22v-4h6v4"></path><path d="M8 6h.01"></path><path d="M16 6h.01"></path><path d="M12 6h.01"></path><path d="M12 10h.01"></path><path d="M12 14h.01"></path><path d="M16 10h.01"></path><path d="M16 14h.01"></path><path d="M8 10h.01"></path><path d="M8 14h.01"></path></svg>`
  },
  {
    role: 'Funding Partner',
    badge: 'LEMBAGA FILANTROPI',
    desc: 'Pendanaan program, hibah modal usaha mandiri, dan dukungan keberlanjutan investasi wakaf produktif.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>`
  },
  {
    role: 'Pemerintah',
    badge: 'REGULASI & FASILITASI',
    desc: 'Harmonisasi kebijakan pesantren vokasi bersama Kemenag, BWI, Kemendikbudristek, dan Pemda setempat.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M20 10v11M8 14v4M12 14v4M16 14v4"></path></svg>`
  },
  {
    role: 'Masyarakat & Relawan',
    badge: 'KOMUNITAS & MENTOR',
    desc: 'Dukungan moril, tenaga ahli sukarela, pembinaan adab santri, dan kolaborasi ekonomi kerakyatan.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`
  }
];
---

<section class="collaborate-section" id="kemitraan">
  <div class="collaborate-container">
    <div class="collaborate-header text-center reveal-on-scroll">
      <div class="collaborate-pill">
        <span class="pill-dot"></span>
        <span>12 • COLLABORATE & PARTNERSHIP</span>
      </div>
      <h2 class="collaborate-title">Tidak Semua Orang Memberi dengan Cara yang Sama.</h2>
      <p class="collaborate-lead">
        Ada yang memberikan dana. Ada yang memberikan ilmu. Ada yang memberikan fasilitas. Ada yang membuka jaringan industri, serta meluangkan waktu dan keahlian. Semuanya adalah pilar penting ekosistem ini.
      </p>
    </div>

    <!-- 5 Stakeholders Grid -->
    <div class="collaborate-grid">
      {partners.map((p, idx) => (
        <div class={`partner-card reveal-on-scroll delay-${(idx + 1) * 100}`}>
          <div class="partner-top">
            <span class="partner-icon" aria-hidden="true" set:html={p.icon} />
            <span class="partner-badge">{p.badge}</span>
          </div>

          <h3 class="partner-role">{p.role}</h3>
          <p class="partner-desc">{p.desc}</p>
        </div>
      ))}

      <!-- Special CTA Card for Inquiries -->
      <div class="partner-card cta-card reveal-on-scroll delay-500">
        <div class="cta-inner">
          <span class="cta-eyebrow">SINERGI STRATEGIS</span>
          <h3 class="cta-title">Siap Bermitra dengan GVF?</h3>
          <p class="cta-desc">Mari berdiskusi bagaimana institusi atau keahlian Anda dapat berkolaborasi.</p>
          <a
            href="https://wa.me/6281226832326?text=Halo%20Admin%20GVF%2C%20saya%20tertarik%20membahas%20kemitraan%20strategis."
            target="_blank"
            rel="noopener noreferrer"
            class="partner-btn"
          >
            <span>Bangun Kemitraan</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="arrow-svg">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .collaborate-section {
    position: relative;
    padding: 110px 0 120px;
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
  }

  .collaborate-container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .collaborate-header {
    max-width: 860px;
    margin: 0 auto 60px;
  }

  .collaborate-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(2, 132, 199, 0.1);
    border: 1px solid rgba(2, 132, 199, 0.25);
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #0284c7;
    margin-bottom: 20px;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    background-color: #0284c7;
    border-radius: 50%;
  }

  .collaborate-title {
    font-size: clamp(2.2rem, 3.8vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    color: #0f172a;
    letter-spacing: -0.025em;
    margin-bottom: 18px;
  }

  .collaborate-lead {
    font-size: 1.1rem;
    line-height: 1.7;
    color: #64748b;
  }

  .collaborate-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .partner-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.04), 0 1px 2px -1px rgba(0, 0, 0, 0.04);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .partner-card:hover {
    background: #ffffff;
    transform: translateY(-3px);
    border-color: #cbd5e1;
    box-shadow: 0 12px 28px -6px rgba(15, 23, 42, 0.08);
  }

  .partner-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .partner-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: #f0f9ff;
    border: 1px solid rgba(2, 132, 199, 0.15);
    color: #0284c7;
  }

  .partner-icon :global(svg) {
    width: 20px;
    height: 20px;
  }

  .partner-badge {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 4px 10px;
    border-radius: 9999px;
    background: #f1f5f9;
    color: #475569;
    border: 1px solid #e2e8f0;
  }

  .partner-role {
    font-size: 1.15rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.015em;
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .partner-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: #64748b;
    margin: 0;
  }

  /* Special CTA Card */
  .partner-card.cta-card {
    background: linear-gradient(135deg, #0a2540 0%, #0f172a 100%);
    border: 1px solid rgba(56, 189, 248, 0.25);
    color: #ffffff;
    box-shadow: 0 10px 25px -5px rgba(10, 37, 64, 0.3);
  }  justify-content: center;
  }

  .cta-eyebrow {
    font-size: 0.72rem;
    font-weight: 800;
    color: #38bdf8;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 8px;
  }

  .cta-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .cta-desc {
    font-size: 0.9rem;
    line-height: 1.5;
    color: #94a3b8;
    margin-bottom: 22px;
  }

  .partner-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #0284c7;
    color: #ffffff;
    padding: 12px 24px;
    border-radius: 9999px;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .partner-btn:hover {
    background: #0369a1;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(2, 132, 199, 0.45);
  }

  .arrow-svg {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 1024px) {
    .collaborate-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .collaborate-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
