---
// src/components/home/CollaborateSection.astro
// Section 12: Collaborate — Matriks Kemitraan 5 Stakeholder YPCI
const partners = [
  {
    role: 'Perguruan Tinggi',
    badge: 'AKADEMIK & RISET',
    desc: 'Pengembangan kurikulum vokasi, transfer teknologi aplikatif, riset pertanian, dan beasiswa lanjutan.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>`
  },
  {
    role: 'Perusahaan & Industri',
    badge: 'CSR, ESG & MAGANG',
    desc: 'Keahlian teknologi, fasilitas teaching factory, penyaluran magang santri, dan penyerapan kerja.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><path d="M9 22v-4h6v4"></path><path d="M8 6h.01"></path><path d="M16 6h.01"></path><path d="M12 6h.01"></path><path d="M12 10h.01"></path><path d="M12 14h.01"></path><path d="M16 10h.01"></path><path d="M16 14h.01"></path><path d="M8 10h.01"></path><path d="M8 14h.01"></path></svg>`
  },
  {
    role: 'Funding Partner',
    badge: 'LEMBAGA FILANTROPI',
    desc: 'Pendanaan program, hibah modal usaha mandiri, dan dukungan keberlanjutan investasi wakaf produktif.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>`
  },
  {
    role: 'Pemerintah',
    badge: 'REGULASI & FASILITASI',
    desc: 'Harmonisasi kebijakan pesantren vokasi bersama Kemenag, BWI, Kemendikbudristek, dan Pemda setempat.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M20 10v11M8 14v4M12 14v4M16 14v4"></path></svg>`
  },
  {
    role: 'Masyarakat & Relawan',
    badge: 'KOMUNITAS & MENTOR',
    desc: 'Dukungan moril, tenaga ahli sukarela, pembinaan adab santri, dan kolaborasi ekonomi kerakyatan.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`
  }
];
---

<section class="collaborate-section" id="kemitraan">
  <div class="collaborate-container">
    <div class="collaborate-header text-center">
      <span class="section-kicker reveal-on-scroll">Kemitraan & Sinergi</span>
      <h2 class="collaborate-title reveal-heading">Tidak Semua Orang Memberi dengan Cara yang Sama.</h2>
      <p class="collaborate-lead reveal-on-scroll" data-delay="0.12">
        Ada yang memberikan dana. Ada yang memberikan ilmu. Ada yang memberikan fasilitas. Ada yang membuka jaringan industri, serta meluangkan waktu dan keahlian. Semuanya adalah pilar penting ekosistem ini.
      </p>
    </div>

    <!-- 5 Stakeholders Grid -->
    <div class="collaborate-grid reveal-stagger">
      {partners.map((p, idx) => (
        <div class="partner-card">
          <div class="partner-top">
            <span class="partner-icon" aria-hidden="true" set:html={p.icon} />
            <span class="partner-badge">{p.badge}</span>
          </div>

          <h3 class="partner-role">{p.role}</h3>
          <p class="partner-desc">{p.desc}</p>
        </div>
      ))}

      <!-- Special CTA Card for Inquiries -->
      <div class="partner-card cta-card">
        <div class="cta-inner">
          <span class="cta-eyebrow">SINERGI STRATEGIS</span>
          <h3 class="cta-title">Siap Bermitra dengan GVF?</h3>
          <p class="cta-desc">Mari berdiskusi bagaimana institusi atau keahlian Anda dapat berkolaborasi.</p>
          <a
            href="https://wa.me/6281226832326?text=Halo%20Admin%20GVF%2C%20saya%20tertarik%20membahas%20kemitraan%20strategis."
            target="_blank"
            rel="noopener noreferrer"
            class="gvf-btn gvf-btn-primary partner-btn"
          >
            <span>Bangun Kemitraan</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="arrow-svg">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .collaborate-section {
    position: relative;
    padding: var(--section-padding-y-lg) 0;
    background-color: #ffffff;
    border-bottom: 1px solid var(--color-border);
  }

  .collaborate-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .collaborate-header {
    max-width: 820px;
    margin: 0 auto var(--space-9);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .collaborate-title {
    font-size: var(--text-heading-lg);
    font-weight: 800;
    line-height: var(--leading-tight);
    color: var(--color-text-heading);
    letter-spacing: var(--tracking-tighter);
    margin-bottom: var(--space-3);
    font-family: var(--font-display);
  }

  .collaborate-lead {
    font-size: var(--text-body-lg);
    line-height: var(--leading-loose);
    color: var(--color-text-muted);
  }

  .collaborate-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .partner-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 24px;
    padding: var(--space-7) var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: none;
    transition:
      border-color var(--duration-normal) var(--ease-out),
      transform    var(--duration-normal) var(--ease-out);
    will-change: transform;
  }

  .partner-card:hover {
    background: #ffffff;
    transform: translateY(-3px);
    border-color: #0969da;
    box-shadow: none;
  }

  .partner-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-5);
  }

  .partner-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--blue-50);
    border: 1px solid var(--blue-100);
    color: var(--blue-600);
  }

  .partner-icon :global(svg) {
    width: 20px;
    height: 20px;
  }

  .partner-badge {
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    padding: 3px 10px;
    border-radius: var(--radius-full);
    background: var(--color-surface-100);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
  }

  .partner-role {
    font-size: var(--text-heading-sm);
    font-weight: 800;
    color: var(--color-text-heading);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-2);
    line-height: var(--leading-snug);
    font-family: var(--font-display);
  }

  .partner-desc {
    font-size: var(--text-label);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Special CTA Card */
  .partner-card.cta-card {
    background: linear-gradient(135deg, var(--navy-950) 0%, var(--navy-900) 100%);
    border: 1px solid rgba(56, 189, 248, 0.25);
    color: #ffffff;
    box-shadow: none;
    border-radius: 24px;
    justify-content: center;
  }

  .cta-eyebrow {
    font-size: var(--text-micro);
    font-weight: 800;
    color: #38bdf8;
    letter-spacing: var(--tracking-wider);
    display: block;
    margin-bottom: var(--space-2);
  }

  .cta-title {
    font-size: var(--text-heading-sm);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: var(--space-2);
    font-family: var(--font-display);
  }

  .cta-desc {
    font-size: var(--text-label);
    line-height: var(--leading-relaxed);
    color: var(--color-text-on-dark);
    opacity: 0.8;
    margin-bottom: var(--space-5);
  }

  .partner-btn {
    padding: 10px 22px;
    font-size: var(--text-small);
  }

  .arrow-svg {
    width: 15px;
    height: 15px;
  }

  @media (max-width: 1024px) {
    .collaborate-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .collaborate-section {
      padding: var(--section-padding-y-sm) 0;
    }
    .collaborate-container {
      padding: 0 var(--space-5);
    }
    .collaborate-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
