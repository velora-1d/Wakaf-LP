---
// src/components/home/QuickActionBar.astro
// Quick Action Bar: 4 Kartu Aksi Cepat Filantropi ala ISAVO (Donasi, Zakat, Wakaf, Kemitraan)
const actions = [
  {
    id: 'donasi',
    title: 'DONASI',
    subtitle: 'Bantu kebutuhan program & pembangunan yang sedang berjalan.',
    badge: 'Program Aktif',
    href: '#donasi',
    iconColor: '#e53935',
    svgIcon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>`
  },
  {
    id: 'zakat',
    title: 'ZAKAT',
    subtitle: 'Tunaikan zakat maal & profesi melalui layanan terkelola YPCI.',
    badge: 'Wajib 2.5%',
    href: '/program/zakat',
    iconColor: '#0284c7',
    svgIcon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>`
  },
  {
    id: 'wakaf',
    title: 'WAKAF',
    subtitle: 'Bangun aset produktif abadi yang memberi manfaat berkelanjutan.',
    badge: 'Aset Abadi',
    href: '/program/wakaf',
    iconColor: '#059669',
    svgIcon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>`
  },
  {
    id: 'kemitraan',
    title: 'KEMITRAAN',
    subtitle: 'Tumbuh bersama melalui kolaborasi strategis & multipihak.',
    badge: 'Sinergi ABCFG',
    href: '#kemitraan',
    iconColor: '#d97706',
    svgIcon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`
  }
];
---

<section class="quick-action-section" aria-label="Salurkan Kebaikan Anda">
  <div class="quick-action-container">
    <div class="quick-action-header text-center reveal-on-scroll">
      <div class="quick-action-pill">
        <span class="pill-dot"></span>
        <span>SALURKAN KEBAIKAN ANDA</span>
      </div>
      <h2 class="quick-action-heading">Empat Pintu Kebaikan untuk Dampak Nyata</h2>
    </div>

    <div class="quick-action-grid">
      {actions.map((act, idx) => (
        <a
          href={act.href}
          class={`quick-action-card reveal-on-scroll delay-${(idx + 1) * 100}`}
          id={`quick-${act.id}`}
        >
          <div class="card-top">
            <div class="card-icon-box" style={`--icon-tint: ${act.iconColor};`}>
              <Fragment set:html={act.svgIcon} />
            </div>
            <span class="card-badge">{act.badge}</span>
          </div>

          <div class="card-body">
            <h3 class="card-title">{act.title}</h3>
            <p class="card-desc">{act.subtitle}</p>
          </div>

          <div class="card-bottom">
            <span class="card-link-text">Salurkan Sekarang</span>
            <span class="card-arrow-circle">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="arrow-svg">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .quick-action-section {
    position: relative;
    padding: 70px 0 90px;
    background-color: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
  }

  .quick-action-container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .quick-action-header {
    margin-bottom: 40px;
  }

  .quick-action-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(2, 132, 199, 0.1);
    border: 1px solid rgba(2, 132, 199, 0.25);
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #0284c7;
    margin-bottom: 12px;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    background-color: #0284c7;
    border-radius: 50%;
  }

  .quick-action-heading {
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
  }

  .quick-action-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }

  .quick-action-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.03);
    position: relative;
    overflow: hidden;
  }

  .quick-action-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: transparent;
    transition: background 0.3s ease;
  }

  .quick-action-card:hover {
    transform: translateY(-6px);
    border-color: #cbd5e1;
    box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);
  }

  .quick-action-card:hover::before {
    background: linear-gradient(90deg, #0284c7, #e53935);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .card-icon-box {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: rgba(15, 23, 42, 0.04);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--icon-tint);
    transition: all 0.3s ease;
  }

  .card-icon-box :global(svg) {
    width: 24px;
    height: 24px;
  }

  .quick-action-card:hover .card-icon-box {
    background: var(--icon-tint);
    color: #ffffff;
    transform: scale(1.08);
  }

  .card-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 9999px;
    background: #f1f5f9;
    color: #475569;
    letter-spacing: 0.02em;
  }

  .card-body {
    margin-bottom: 24px;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.01em;
    margin-bottom: 8px;
  }

  .card-desc {
    font-size: 0.92rem;
    line-height: 1.55;
    color: #64748b;
  }

  .card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid #f1f5f9;
  }

  .card-link-text {
    font-size: 0.85rem;
    font-weight: 700;
    color: #0f172a;
    transition: color 0.2s ease;
  }

  .card-arrow-circle {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0f172a;
    transition: all 0.3s ease;
  }

  .arrow-svg {
    width: 14px;
    height: 14px;
    transition: transform 0.3s ease;
  }

  .quick-action-card:hover .card-link-text {
    color: #0284c7;
  }

  .quick-action-card:hover .card-arrow-circle {
    background: #0284c7;
    color: #ffffff;
    transform: translateX(4px);
  }

  .quick-action-card:hover .arrow-svg {
    transform: translateX(2px);
  }

  @media (max-width: 1024px) {
    .quick-action-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .quick-action-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
