---
// src/components/home/WakafPillarsSection.astro
// Section 09: Wakaf Pillars — Wakaf Hari Ini. Manfaat untuk Hari Esok.
const wakafPillars = [
  {
    num: '01',
    title: 'Wakaf Uang',
    badge: 'Mulai Rp 50.000',
    desc: 'Cara mudah dan terjangkau bagi siapa saja untuk mengambil bagian dalam pembebasan lahan abadi dan instrumen wakaf produktif terdaftar BWI.',
    ctaText: 'Wakaf Uang Sekarang',
    link: '/program/wakaf',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"></path><line x1="12" y1="6" x2="12" y2="8"></line><line x1="12" y1="16" x2="12" y2="18"></line></svg>`
  },
  {
    num: '02',
    title: 'Wakaf Pembangunan',
    badge: 'Infrastruktur Abadi',
    desc: 'Mendukung langsung pembangunan sarana fisik kawasan: mezanin masjid, skywalk learning room, ruang kelas kejuruan, dan workshop.',
    ctaText: 'Pilih Titik Bangun',
    link: '/program/wakaf#paket-donasi',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M9 8h1M9 12h1M9 16h1M14 8h1M14 12h1M14 16h1M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"></path></svg>`
  },
  {
    num: '03',
    title: 'Wakaf Fasilitas',
    badge: 'Sarana Praktik',
    desc: 'Penyediaan sarana yang digunakan santri setiap hari: instalasi filtrasi wudhu, peralatan teaching factory, dan panel surya mandiri energi.',
    ctaText: 'Wakaf Fasilitas',
    link: '/program/wakaf#paket-donasi',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>`
  }
];
---

<section class="wakaf-pillars-section" id="wakaf-section">
  <div class="wakaf-pillars-container">
    <div class="wakaf-pillars-header text-center reveal-on-scroll">
      <div class="wakaf-pill">
        <span class="pill-dot"></span>
        <span>09 • WAKAF PRODUKTIF</span>
      </div>
      <h2 class="wakaf-title">Wakaf Hari Ini. Manfaat untuk Hari Esok.</h2>
      <p class="wakaf-lead">
        Wakaf bukan hanya tentang memberi sesaat. Wakaf adalah tentang menghadirkan aset abadi yang terus mengalirkan kebermanfaatan dan pahala jariyah tanpa pernah terputus.
      </p>
      <p class="wakaf-sub">
        Melalui Wakaf Produktif, dukungan masyarakat dihimpun untuk membangun aset riil yang memperkuat kemandirian pendidikan santri dan peradaban umat.
      </p>
    </div>

    <div class="wakaf-grid">
      {wakafPillars.map((item, idx) => (
        <div class={`wakaf-card reveal-on-scroll delay-${(idx + 1) * 100}`}>
          <div class="card-top">
            <div class="card-tag-group">
              <span class="card-num">{item.num}</span>
              <span class="card-badge">{item.badge}</span>
            </div>
            <div class="card-icon-box">
              <Fragment set:html={item.icon} />
            </div>
          </div>

          <h3 class="card-title">{item.title}</h3>
          <p class="card-desc">{item.desc}</p>

          <a href={item.link} class="card-btn">
            <span>{item.ctaText}</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="arrow-icon">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      ))}
    </div>

    <!-- Bottom Center Highlight CTA -->
    <div class="wakaf-center-cta text-center reveal-on-scroll mt-50">
      <a href="/program/wakaf" class="wakaf-big-btn">
        <span>KONSULTASI & AKAD WAKAF SEKARANG</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="arrow-right">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .wakaf-pillars-section {
    position: relative;
    padding: 110px 0 120px;
    background-color: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
  }

  .wakaf-pillars-container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .wakaf-pillars-header {
    max-width: 820px;
    margin: 0 auto 60px;
  }

  .wakaf-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(5, 150, 105, 0.1);
    border: 1px solid rgba(5, 150, 105, 0.25);
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #059669;
    margin-bottom: 20px;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    background-color: #059669;
    border-radius: 50%;
  }

  .wakaf-title {
    font-size: clamp(2.2rem, 3.8vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    color: #0f172a;
    letter-spacing: -0.025em;
    margin-bottom: 20px;
  }

  .wakaf-lead {
    font-size: 1.12rem;
    line-height: 1.7;
    color: #334155;
    margin-bottom: 12px;
    font-weight: 500;
  }

  .wakaf-sub {
    font-size: 0.98rem;
    line-height: 1.65;
    color: #64748b;
  }

  .wakaf-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .wakaf-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.04), 0 1px 2px -1px rgba(0, 0, 0, 0.04);
  }

  .wakaf-card:hover {
    transform: translateY(-3px);
    border-color: #cbd5e1;
    box-shadow: 0 12px 28px -6px rgba(15, 23, 42, 0.08);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .card-tag-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .card-num {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8rem;
    font-weight: 800;
    color: #059669;
    background: #d1fae5;
    padding: 3px 8px;
    border-radius: 6px;
  }

  .card-badge {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: #64748b;
    text-transform: uppercase;
  }

  .card-icon-box {
    width: 38px;
    height: 38px;
    min-width: 38px;
    min-height: 38px;
    max-width: 38px;
    max-height: 38px;
    border-radius: 10px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #059669;
    transition: all 0.25s ease;
    overflow: hidden;
    flex-shrink: 0;
  }

  .wakaf-card:hover .card-icon-box {
    background: #059669;
    color: #ffffff;
    border-color: #059669;
  }

  .card-icon-box :global(svg),
  .card-icon-box svg {
    width: 18px !important;
    height: 18px !important;
    max-width: 18px !important;
    max-height: 18px !important;
    display: block;
  }

  .card-title {
    font-size: 1.22rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.015em;
    margin-bottom: 10px;
    line-height: 1.3;
  }

  .card-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: #64748b;
    margin-bottom: 24px;
    flex: 1;
  }

  .card-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 10px 18px;
    border-radius: 9999px;
    color: #0f172a;
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .arrow-icon {
    width: 14px;
    height: 14px;
    transition: transform 0.25s ease;
  }

  .wakaf-card:hover .card-btn {
    background: #059669;
    border-color: #059669;
    color: #ffffff;
  }

  .wakaf-card:hover .arrow-icon {
    transform: translateX(4px);
  }

  .mt-50 {
    margin-top: 50px;
  }

  .wakaf-big-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: #0a2540;
    color: #ffffff;
    padding: 14px 34px;
    border-radius: 9999px;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(10, 37, 64, 0.25);
    transition: all 0.3s ease;
  }

  .wakaf-big-btn:hover {
    background: #0284c7;
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(2, 132, 199, 0.4);
  }

  .arrow-right {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 1024px) {
    .wakaf-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .wakaf-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
