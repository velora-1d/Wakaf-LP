---
// src/components/home/NewsSection.astro
import { getActiveNewsArticles } from '../../lib/db';

const dbArticles = await getActiveNewsArticles(6);

// Fallback data jika database belum memiliki artikel aktif
const fallbackArticles = [
  {
    title: 'Fiqih Wakaf Produktif: Menghidupkan Aset Umat Menjadi Sumber Pahala Abadi',
    slug: 'fiqih-wakaf-produktif-pahala-abadi',
    category: 'LITERASI WAKAF',
    summary: 'Transformasi aset abadi menjadi sarana pendidikan berkelanjutan dan kemandirian pangan santri secara amanah.',
    author: 'Tim GVF',
    imageUrl: '/gambar design/interior masjid.jpg',
    publishedAt: new Date('2026-07-18')
  },
  {
    title: 'Perkembangan Fisik Masjid Khairu Ummah: Mezanin Dua Lantai Siap Digunakan',
    slug: 'perkembangan-fisik-masjid-khairu-ummah',
    category: 'PROGRESS MASJID',
    summary: 'Penyelesaian struktur utama dan mezanin shalat santri guna menampung jamaah ibadah dan tahfidz harian.',
    author: 'Tim GVF',
    imageUrl: '/gambar design/belakang masjid.jpg',
    publishedAt: new Date('2026-07-12')
  },
  {
    title: 'Santri Vokasi Agroteknologi: Dari Pembibitan Menuju Kemandirian Pangan',
    slug: 'santri-vokasi-agroteknologi-kemandirian-pangan',
    category: 'TECHNOPARK',
    summary: 'Keterampilan riil pembibitan hortikultura dan green house modern yang diajarkan langsung pada santri SMK Skill Village.',
    author: 'Tim GVF',
    imageUrl: '/gambar design/learning studio & workshop.jpg',
    publishedAt: new Date('2026-07-05')
  },
  {
    title: 'Sinergi Wakaf Tunai: Membuka Akses Sarana Digital Santri Vokasi',
    slug: 'sinergi-wakaf-tunai-sarana-digital',
    category: 'WAKAF DIGITAL',
    summary: 'Pemanfaatan instrumen wakaf uang untuk penyediaan sarana komputasi dan studio multimedia vokasi pesantren.',
    author: 'Tim GVF',
    imageUrl: '/gambar design/interior mesjid 2.jpg',
    publishedAt: new Date('2026-06-28')
  },
  {
    title: 'Kemitraan Multipihak: Sinergi CSR Korporasi Memperkuat Pesantren Jonggol',
    slug: 'kemitraan-multipihak-csr-pesantren-jonggol',
    category: 'KEMITRAAN',
    summary: 'Kolaborasi strategis dengan berbagai lembaga dan perusahaan demi memperluas manfaat beasiswa santri dhuafa.',
    author: 'Tim GVF',
    imageUrl: '/media-lp/WhatsApp Image 2026-10-05 at 09.22.04 (3).jpeg',
    publishedAt: new Date('2026-06-20')
  },
  {
    title: 'Mencetak Santri Berkarakter FAST: Fathonah, Amanah, Shiddiq, dan Tabligh',
    slug: 'mencetak-santri-berkarakter-fast',
    category: 'PENDIDIKAN',
    summary: 'Pondasi karakter unggul islami dan kesiapan kemandirian vokasi yang terintegrasi dalam keseharian santri.',
    author: 'Tim GVF',
    imageUrl: '/gambar design/panel surya.jpg',
    publishedAt: new Date('2026-06-14')
  }
];

const articles = dbArticles && dbArticles.length > 0 ? dbArticles : fallbackArticles;

const formatDate = (dateInput: Date | string | null) => {
  if (!dateInput) return 'Terkini';
  const date = typeof dateInput === 'string' ? new Date(dateInput) : dateInput;
  return new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  }).format(date);
};
---

<section class="pen-news-section reveal-on-scroll" id="kabar-gvf">
  <div class="pen-news-container">
    <div class="pen-news-header">
      <div class="pen-badge-pill">
        <div class="dot-halo">
          <div class="halo-ring"></div>
          <div class="core-dot"></div>
        </div>
        <span class="badge-text">Kabar Terkini &amp; Literasi</span>
      </div>
      <h2 class="pen-news-title">
        Kabar Global Skill Village Fund &amp;<br />
        Catatan Edukasi Kebermanfaatan
      </h2>
      <p class="pen-news-subtitle">
        Informasi terkini progres pembangunan kawasan, aktivitas santri vokasi, dan catatan fiqih wakaf produktif di Jonggol.
      </p>
    </div>

    <div class="news-symmetrical-grid">
      {articles.map((article) => (
        <article class="news-card">
          <div class="news-thumb-wrap">
            <img
              src={article.imageUrl || '/gambar design/interior masjid.jpg'}
              alt={article.title}
              class="news-thumb-img"
              loading="lazy"
            />
            <span class="news-category-badge">{article.category}</span>
          </div>
          <div class="news-card-body">
            <div class="news-meta-row">
              <span class="news-meta-date">{formatDate(article.publishedAt)}</span>
              <span class="news-meta-dot">&bull;</span>
              <span class="news-meta-author">Oleh <strong class="author-highlight">{article.author || 'Tim GVF'}</strong></span>
            </div>
            <h3 class="news-card-title">
              <a href={`/kabar/${article.slug}`} class="news-title-link">
                {article.title}
              </a>
            </h3>
            <p class="news-card-desc">
              {article.summary}
            </p>
            <a href={`/kabar/${article.slug}`} class="news-card-action">
              <span>Baca Selengkapnya</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="news-footer-action">
      <a href="/kabar" class="btn-all-kabar">
        <span>Buka Semua Kabar &amp; Warta</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .pen-news-section {
    position: relative;
    padding: 120px 0 130px 0;
    background-color: #fbfbf9;
    overflow: hidden;
  }

  .pen-news-container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Header */
  .pen-news-header {
    text-align: center;
    margin-bottom: 64px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .pen-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px 5px 10px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    box-shadow: 0px 1px 4px rgba(0, 0, 0, 0.04);
    border-radius: 32px;
  }

  .dot-halo {
    width: 14px;
    height: 14px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .halo-ring {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: rgba(9, 105, 218, 0.12);
  }

  .core-dot {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #0969da;
  }

  .badge-text {
    font-size: 12px;
    color: #000000;
    font-weight: 600;
    letter-spacing: 0.2px;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  .pen-news-title {
    font-size: clamp(32px, 3.5vw, 46px);
    line-height: 1.2;
    font-weight: 400;
    color: #000000;
    margin: 0;
    letter-spacing: -0.02em;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  .pen-news-subtitle {
    font-size: 16px;
    line-height: 26px;
    color: #62625b;
    max-width: 680px;
    margin: 0;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  /* Symmetrical 3-Column Grid */
  .news-symmetrical-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    width: 100%;
  }

  /* Card Item */
  .news-card {
    background: #ffffff;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid #f1f5f9;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    display: flex;
    flex-direction: column;
    transition: transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .news-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.08);
  }

  .news-card:active {
    transform: translateY(-2px) scale(0.995);
  }

  /* Thumbnail Wrap */
  .news-thumb-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: #e2e8f0;
  }

  .news-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .news-card:hover .news-thumb-img {
    transform: scale(1.06);
  }

  .news-category-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background-color: #0969da;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 4px 12px;
    border-radius: 32px;
    text-transform: uppercase;
    font-family: 'Golos Text', system-ui, sans-serif;
    box-shadow: 0 2px 8px rgba(9, 105, 218, 0.3);
  }

  /* Body Content */
  .news-card-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .news-meta-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: #64748b;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  .news-meta-dot {
    color: #cbd5e1;
  }

  .author-highlight {
    color: #0969da;
    font-weight: 600;
  }

  .news-card-title {
    margin: 0;
    font-size: 18px;
    line-height: 26px;
    font-weight: 600;
    font-family: 'Golos Text', system-ui, sans-serif;
    min-height: 52px;
  }

  .news-title-link {
    color: #111827;
    text-decoration: none;
    transition: color 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .news-title-link:hover {
    color: #0969da;
  }

  .news-card-desc {
    font-size: 14px;
    line-height: 22px;
    color: #62625b;
    margin: 0;
    font-family: 'Golos Text', system-ui, sans-serif;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .news-card-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: #0969da;
    text-decoration: none;
    font-family: 'Golos Text', system-ui, sans-serif;
    margin-top: auto;
    padding-top: 10px;
    transition: gap 180ms cubic-bezier(0.2, 0.8, 0.2, 1), color 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .news-card-action:hover {
    gap: 12px;
    color: #0752a8;
  }

  /* Footer Action */
  .news-footer-action {
    display: flex;
    justify-content: center;
    margin-top: 56px;
  }

  .btn-all-kabar {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 28px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 9999px;
    color: #0969da;
    font-size: 14px;
    font-weight: 600;
    font-family: 'Golos Text', system-ui, sans-serif;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: all 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .btn-all-kabar:hover {
    background: #0969da;
    color: #ffffff;
    border-color: #0969da;
    box-shadow: 0 8px 24px rgba(9, 105, 218, 0.25);
    transform: translateY(-2px);
  }

  /* Responsive Breakpoints */
  @media (max-width: 1080px) {
    .news-symmetrical-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
  }

  @media (max-width: 640px) {
    .pen-news-section {
      padding: 80px 0;
    }

    .news-symmetrical-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .news-card-title {
      min-height: auto;
    }
  }
</style>
