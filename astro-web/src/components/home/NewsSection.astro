<style>
  .pen-news-section {
    position: relative;
    padding: 120px 0 130px 0;
    background-color: #fbfbf9;
    overflow: hidden;
  }

  .pen-news-container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Header */
  .pen-news-header {
    text-align: center;
    margin-bottom: 64px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .pen-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px 5px 10px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    box-shadow: 0px 1px 4px rgba(0, 0, 0, 0.04);
    border-radius: 32px;
  }

  .dot-halo {
    width: 14px;
    height: 14px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .halo-ring {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: rgba(9, 105, 218, 0.12);
  }

  .core-dot {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #0969da;
  }

  .badge-text {
    font-size: 12px;
    color: #000000;
    font-weight: 600;
    letter-spacing: 0.2px;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  .pen-news-title {
    font-size: clamp(32px, 3.5vw, 46px);
    line-height: 1.2;
    font-weight: 400;
    color: #000000;
    margin: 0;
    letter-spacing: -0.02em;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  .pen-news-subtitle {
    font-size: 16px;
    line-height: 26px;
    color: #62625b;
    max-width: 680px;
    margin: 0;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  /* Symmetrical 3-Column Grid */
  .news-symmetrical-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    width: 100%;
  }

  /* Card Item */
  .news-card {
    background: #ffffff;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid #f1f5f9;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    display: flex;
    flex-direction: column;
    transition: transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .news-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.08);
  }

  .news-card:active {
    transform: translateY(-2px) scale(0.995);
  }

  /* Thumbnail Wrap */
  .news-thumb-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: #e2e8f0;
  }

  .news-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .news-card:hover .news-thumb-img {
    transform: scale(1.06);
  }

  .news-category-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background-color: #0969da;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 4px 12px;
    border-radius: 32px;
    text-transform: uppercase;
    font-family: 'Golos Text', system-ui, sans-serif;
    box-shadow: 0 2px 8px rgba(9, 105, 218, 0.3);
  }

  /* Body Content */
  .news-card-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .news-meta-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: #64748b;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  .news-meta-dot {
    color: #cbd5e1;
  }

  .author-highlight {
    color: #0969da;
    font-weight: 600;
  }

  .news-card-title {
    margin: 0;
    font-size: 18px;
    line-height: 26px;
    font-weight: 600;
    font-family: 'Golos Text', system-ui, sans-serif;
    min-height: 52px;
  }

  .news-title-link {
    color: #111827;
    text-decoration: none;
    transition: color 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .news-title-link:hover {
    color: #0969da;
  }

  .news-card-desc {
    font-size: 14px;
    line-height: 22px;
    color: #62625b;
    margin: 0;
    font-family: 'Golos Text', system-ui, sans-serif;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .news-card-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: #0969da;
    text-decoration: none;
    font-family: 'Golos Text', system-ui, sans-serif;
    margin-top: auto;
    padding-top: 10px;
    transition: gap 180ms cubic-bezier(0.2, 0.8, 0.2, 1), color 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .news-card-action:hover {
    gap: 12px;
    color: #0752a8;
  }

  /* Responsive Breakpoints */
  @media (max-width: 1080px) {
    .news-symmetrical-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
  }

  @media (max-width: 640px) {
    .pen-news-section {
      padding: 80px 0;
    }

    .news-symmetrical-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .news-card-title {
      min-height: auto;
    }
  }
</style>
