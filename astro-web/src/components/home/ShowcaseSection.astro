---
// src/components/home/ShowcaseSection.astro
// Exact ISAVO "Gallery" Section: Giant Background Watermark + Dual-Row Scroll Parallax
import ElasticGallery from '../ui/ElasticGallery.astro';
---

<section class="isavo-gallery-section" id="galeri">
  <div id="dokumentasi" class="isavo-anchor-target"></div>

  <div class="gallery-header reveal-on-scroll">
    <div class="gallery-badge-pill">
      <div class="dot-halo">
        <div class="halo-ring"></div>
        <div class="core-dot"></div>
      </div>
      <span class="badge-text">Dokumentasi &amp; Progres Riil</span>
    </div>
    <h2 class="gallery-title">Dokumentasi Riil &amp; Masterplan Kawasan</h2>
    <p class="gallery-subtitle">
      Transparansi pembangunan fisik di Sukasirna Jonggol • memadukan dokumentasi riil lapangan dan visualisasi masterplan ekosistem pesantren terpadu.
    </p>
  </div>

  <div class="max-w-6xl mx-auto px-4" style="max-width: 1152px; margin: 0 auto; width: 100%;">
    <ElasticGallery defaultActiveId="01" />
  </div>
</section>

<style>
  .isavo-gallery-section {
    position: relative;
    padding: 60px 0 100px 0;
    background-color: #ffffff;
    overflow: hidden;
    user-select: none;
  }

  .isavo-anchor-target {
    position: absolute;
    top: -85px;
    left: 0;
  }

  /* Gallery Header Exact Pen.dev */
  .gallery-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    padding: 40px 24px 50px 24px;
    max-width: 900px;
    margin: 0 auto;
  }

  .gallery-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px 5px 10px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    box-shadow: 0px 1px 4px rgba(0, 0, 0, 0.04);
    border-radius: 32px;
  }

  .dot-halo {
    width: 14px;
    height: 14px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .halo-ring {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: rgba(9, 105, 218, 0.12);
  }

  .core-dot {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #0969da;
  }

  .badge-text {
    font-size: 12px;
    line-height: normal;
    color: #000000;
    font-weight: 600;
    letter-spacing: 0.2px;
  }

  .gallery-title {
    font-size: 48px;
    line-height: 1.15;
    font-weight: 400;
    color: #000000;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .gallery-subtitle {
    font-size: 16px;
    line-height: 26px;
    color: #62625b;
    font-weight: 400;
    margin: 0;
    max-width: 760px;
  }

  @media (max-width: 768px) {
    .gallery-title {
      font-size: 32px;
    }

    .gallery-subtitle {
      font-size: 14px;
      line-height: 22px;
    }
  }
</style>
