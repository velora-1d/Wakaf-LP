  <!-- Interactive Lightbox Modal -->
  <dialog id="isavoGalleryModal" class="gallery-lightbox">
    <div class="lightbox-inner">
      <button type="button" class="lightbox-close" id="closeLightboxBtn" aria-label="Tutup Pratinjau">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <img id="lightboxImage" src="" alt="Pratinjau Galeri" class="lightbox-img" />
      <div id="lightboxCaption" class="lightbox-caption"></div>
    </div>
  </dialog>
</section>

<script>
  // Exact ISAVO Parallax Scroll Animation for Gallery Section
  const section = document.getElementById('galeri');
  const row1 = document.getElementById('galleryRow1');
  const row2 = document.getElementById('galleryRow2');

  let currentTranslate1 = 0;
  let currentTranslate2 = -350; // Initial start offset for row 2 to balance view
  let targetTranslate1 = 0;
  let targetTranslate2 = -350;

  // Hanya hitung parallax saat section dekat viewport
  let isNear = true;
  if (section && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      (entries) => {
        isNear = entries[0]?.isIntersecting ?? true;
        if (isNear) updateParallax();
      },
      { rootMargin: '400px 0px 400px 0px' }
    ).observe(section);
  }

  // Lenis sudah menghaluskan scroll, jadi transform langsung diterapkan (tanpa lerp ganda)
  function updateParallax() {
    if (!section || !row1 || !row2 || !isNear) return;

    const rect = section.getBoundingClientRect();
    const windowH = window.innerHeight;

    // Progres section melewati viewport (0 - 1)
    const progress = (windowH - rect.top) / (windowH + rect.height);
    const scrollShift = (progress - 0.5) * 750;

    targetTranslate1 = -scrollShift - 150;
    targetTranslate2 = scrollShift - 320;
    currentTranslate1 = targetTranslate1;
    currentTranslate2 = targetTranslate2;

    row1.style.transform = `translate3d(${currentTranslate1.toFixed(2)}px, 0, 0)`;
    row2.style.transform = `translate3d(${currentTranslate2.toFixed(2)}px, 0, 0)`;
  }

  // Bind ke Lenis, baik Lenis sudah siap sebelum maupun sesudah script ini jalan.
  // Fallback ke scroll native bila Lenis tidak ada (mis. touch device / gagal load).
  let boundToLenis = false;
  const bindLenis = (lenis: any) => {
    if (boundToLenis || !lenis) return;
    boundToLenis = true;
    window.removeEventListener('scroll', updateParallax);
    lenis.on('scroll', updateParallax);
  };

  window.addEventListener('scroll', updateParallax, { passive: true });
  if ((window as any).lenis) {
    bindLenis((window as any).lenis);
  } else {
    window.addEventListener('lenis:ready', (e) => bindLenis((e as CustomEvent).detail), { once: true });
  }
  window.addEventListener('resize', updateParallax, { passive: true });
  updateParallax();

  // Lightbox Modal Logic
  const modal = document.getElementById('isavoGalleryModal') as HTMLDialogElement | null;
  const modalImg = document.getElementById('lightboxImage') as HTMLImageElement | null;
  const modalCaption = document.getElementById('lightboxCaption');
  const closeBtn = document.getElementById('closeLightboxBtn');

  document.querySelectorAll('.gallary-scroll-item').forEach((item) => {
    item.addEventListener('click', () => {
      const img = item.querySelector('img');
      if (img && modal && modalImg) {
        modalImg.src = img.src;
        modalImg.alt = img.alt;
        if (modalCaption) modalCaption.textContent = img.alt;
        modal.showModal();
      }
    });
  });

  if (closeBtn && modal) {
    closeBtn.addEventListener('click', () => modal.close());
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
  }
</script>

<style>
  .isavo-gallery-section {
    position: relative;
    padding: 70px 0 90px 0;
    background-color: #ffffff;
    overflow: hidden;
    user-select: none;
  }

  .isavo-anchor-target {
    position: absolute;
    top: -85px;
    left: 0;
  }

  /* Giant Background Watermark Text ala ISAVO */
  .gallary-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    user-select: none;
    z-index: 0;
    width: 100%;
    text-align: center;
    white-space: nowrap;
  }

  .gallary-text span {
    font-size: clamp(6.5rem, 16vw, 15rem);
    font-weight: 900;
    color: rgba(15, 23, 42, 0.04);
    letter-spacing: -0.04em;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
    line-height: 1;
    display: inline-block;
  }

  /* Rows Wrapper */
  .gallary-wrap {
    position: relative;
    z-index: 1;
    width: 100%;
    overflow: hidden;
    padding: 10px 0;
  }

  .gallary-wrap.wrap-1 {
    margin-bottom: 20px;
  }

  /* The Moving Flex Track */
  .gallery-scroll-wrap {
    display: flex;
    align-items: center;
    gap: 22px;
    width: max-content;
    will-change: transform;
  }

  /* Gallery Item Cards */
  .gallary-scroll-item {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.07);
    border: 1px solid rgba(15, 23, 42, 0.08);
    background-color: #0f172a;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    flex-shrink: 0;
  }

  .gallary-scroll-item:hover {
    transform: translateY(-6px) scale(1.02);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.16);
    z-index: 2;
  }

  /* Varied Card Dimensions ala ISAVO Editorial Rhythm */
  .card-wide {
    width: 480px;
    height: 270px;
  }

  .card-large {
    width: 400px;
    height: 270px;
  }

  .card-medium {
    width: 330px;
    height: 270px;
  }

  .card-compact {
    width: 250px;
    height: 270px;
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .gallary-scroll-item:hover .gallery-img {
    transform: scale(1.08);
  }

  /* Lightbox Modal */
  .gallery-lightbox {
    border: none;
    border-radius: 16px;
    padding: 0;
    max-width: 90vw;
    max-height: 90vh;
    background: transparent;
    overflow: visible;
  }

  .gallery-lightbox::backdrop {
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(8px);
  }

  .lightbox-inner {
    position: relative;
    background: #0f172a;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .lightbox-close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: background 0.2s;
  }

  .lightbox-close:hover {
    background: #0969da;
  }

  .lightbox-img {
    display: block;
    max-width: 85vw;
    max-height: 78vh;
    object-fit: contain;
    margin: 0 auto;
  }

  .lightbox-caption {
    padding: 12px 20px;
    background: #091322;
    color: #e2e8f0;
    font-size: 0.92rem;
    font-weight: 600;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 768px) {
    .isavo-gallery-section {
      padding: 50px 0 70px 0;
    }

    .card-wide {
      width: 320px;
      height: 200px;
    }

    .card-large {
      width: 270px;
      height: 200px;
    }

    .card-medium {
      width: 220px;
      height: 200px;
    }

    .card-compact {
      width: 180px;
      height: 200px;
    }
  }
</style>
