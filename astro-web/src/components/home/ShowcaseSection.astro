  <!-- Interactive Lightbox Modal -->
  <dialog id="isavoGalleryModal" class="gallery-lightbox">
    <div class="lightbox-inner">
      <button type="button" class="lightbox-close" id="closeLightboxBtn" aria-label="Tutup Pratinjau">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <img id="lightboxImage" src="" alt="Pratinjau Galeri" class="lightbox-img" />
      <div id="lightboxCaption" class="lightbox-caption"></div>
    </div>
  </dialog>
</section>

<script>
  // Parallax Scroll Animation for Gallery Section
  const section = document.getElementById('galeri');
  const row1 = document.getElementById('galleryRow1');
  const row2 = document.getElementById('galleryRow2');

  let currentTranslate1 = 0;
  let currentTranslate2 = -350;
  let targetTranslate1 = 0;
  let targetTranslate2 = -350;

  let isNear = true;
  if (section && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      (entries) => {
        isNear = entries[0]?.isIntersecting ?? true;
        if (isNear) updateParallax();
      },
      { rootMargin: '400px 0px 400px 0px' }
    ).observe(section);
  }

  function updateParallax() {
    if (!section || !row1 || !row2 || !isNear) return;

    const rect = section.getBoundingClientRect();
    const windowH = window.innerHeight;

    const progress = (windowH - rect.top) / (windowH + rect.height);
    const scrollShift = (progress - 0.5) * 750;

    targetTranslate1 = -scrollShift - 150;
    targetTranslate2 = scrollShift - 320;
    currentTranslate1 = targetTranslate1;
    currentTranslate2 = targetTranslate2;

    row1.style.transform = `translate3d(${currentTranslate1.toFixed(2)}px, 0, 0)`;
    row2.style.transform = `translate3d(${currentTranslate2.toFixed(2)}px, 0, 0)`;
  }

  let boundToLenis = false;
  const bindLenis = (lenis: any) => {
    if (boundToLenis || !lenis) return;
    boundToLenis = true;
    window.removeEventListener('scroll', updateParallax);
    lenis.on('scroll', updateParallax);
  };

  window.addEventListener('scroll', updateParallax, { passive: true });
  if ((window as any).lenis) {
    bindLenis((window as any).lenis);
  } else {
    window.addEventListener('lenis:ready', (e) => bindLenis((e as CustomEvent).detail), { once: true });
  }
  window.addEventListener('resize', updateParallax, { passive: true });
  updateParallax();

  // Lightbox Modal Logic
  const modal = document.getElementById('isavoGalleryModal') as HTMLDialogElement | null;
  const modalImg = document.getElementById('lightboxImage') as HTMLImageElement | null;
  const modalCaption = document.getElementById('lightboxCaption');
  const closeBtn = document.getElementById('closeLightboxBtn');

  document.querySelectorAll('.gallary-scroll-item').forEach((item) => {
    item.addEventListener('click', () => {
      const img = item.querySelector('img');
      if (img && modal && modalImg) {
        modalImg.src = img.src;
        modalImg.alt = img.alt;
        if (modalCaption) modalCaption.textContent = img.alt;
        modal.showModal();
      }
    });
  });

  if (closeBtn && modal) {
    closeBtn.addEventListener('click', () => modal.close());
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
  }
</script>

<style>
  .isavo-gallery-section {
    position: relative;
    padding: 60px 0 100px 0;
    background-color: #ffffff;
    overflow: hidden;
    user-select: none;
  }

  .isavo-anchor-target {
    position: absolute;
    top: -85px;
    left: 0;
  }

  /* Gallery Header Exact Pen.dev */
  .gallery-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    padding: 40px 24px 50px 24px;
    max-width: 900px;
    margin: 0 auto;
  }

  .gallery-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px 5px 10px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    box-shadow: 0px 1px 4px rgba(0, 0, 0, 0.04);
    border-radius: 32px;
  }

  .dot-halo {
    width: 14px;
    height: 14px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .halo-ring {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: rgba(0, 107, 62, 0.12);
  }

  .core-dot {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #006B3E;
  }

  .badge-text {
    font-size: 12px;
    line-height: normal;
    color: #000000;
    font-weight: 600;
    letter-spacing: 0.2px;
  }

  .gallery-title {
    font-size: 48px;
    line-height: 1.15;
    font-weight: 400;
    color: #000000;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .gallery-subtitle {
    font-size: 16px;
    line-height: 26px;
    color: #62625b;
    font-weight: 400;
    margin: 0;
    max-width: 760px;
  }

  /* Rows Wrapper */
  .gallary-wrap {
    position: relative;
    z-index: 1;
    width: 100%;
    overflow: hidden;
    padding: 15px 0;
  }

  .gallary-wrap.wrap-1 {
    margin-bottom: 10px;
  }

  /* The Moving Flex Track with Pen.dev gap 30px */
  .gallery-scroll-wrap {
    display: flex;
    gap: 30px;
    width: max-content;
    will-change: transform;
  }

  .gallery-scroll-wrap.row-top {
    align-items: flex-end;
  }

  .gallery-scroll-wrap.row-bottom {
    align-items: flex-start;
  }

  /* Gallery Item Cards Pen.dev: rounded 10px */
  .gallary-scroll-item {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    box-shadow: 0px 4px 16px rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.06);
    background-color: #f6f6f3;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1), border-color 0.3s ease, box-shadow 0.3s ease;
    flex-shrink: 0;
  }

  .gallary-scroll-item:hover {
    transform: translateY(-4px) scale(1.015);
    border-color: #006B3E;
    box-shadow: 0px 8px 24px rgba(0, 107, 62, 0.15);
    z-index: 2;
  }

  /* Exact Pen.dev Dimensions: 380x200, 480x280, 680x360 */
  .card-sm {
    width: 380px;
    height: 200px;
  }

  .card-md {
    width: 480px;
    height: 280px;
  }

  .card-lg {
    width: 680px;
    height: 360px;
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .gallary-scroll-item:hover .gallery-img {
    transform: scale(1.05);
  }

  /* Lightbox Modal */
  .gallery-lightbox {
    border: none;
    border-radius: 16px;
    padding: 0;
    max-width: 90vw;
    max-height: 90vh;
    background: transparent;
    overflow: visible;
  }

  .gallery-lightbox::backdrop {
    background: rgba(6, 24, 41, 0.85);
    backdrop-filter: blur(8px);
  }

  .lightbox-inner {
    position: relative;
    background: #061829;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .lightbox-close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: background 0.2s;
  }

  .lightbox-close:hover {
    background: #006B3E;
  }

  .lightbox-img {
    display: block;
    max-width: 85vw;
    max-height: 78vh;
    object-fit: contain;
    margin: 0 auto;
  }

  .lightbox-caption {
    padding: 12px 20px;
    background: #061829;
    color: #e2e8f0;
    font-size: 0.92rem;
    font-weight: 500;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 768px) {
    .gallery-title {
      font-size: 32px;
    }

    .gallery-subtitle {
      font-size: 14px;
      line-height: 22px;
    }

    .card-sm {
      width: 280px;
      height: 160px;
    }

    .card-md {
      width: 340px;
      height: 200px;
    }

    .card-lg {
      width: 400px;
      height: 240px;
    }
  }
</style>
