---
// src/components/home/DonationChannelsSection.astro
// Section 07: Donation Channels — 6 Opsi Saluran Kebaikan (shadcn Card System)
const channels = [
  {
    tag: 'RUTIN & FLEKSIBEL',
    title: 'INFAK & SEDEKAH',
    desc: 'Untuk mendukung kebutuhan santri, pangan harian, dan operasional program dakwah yang sedang berjalan aktif.',
    actionText: 'Salurkan Infak',
    link: '/program/sedekah',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 12V8H6a2 2 0 0 1-2-2c0-1.1.9-2 2-2h12v4"></path><path d="M4 6v12c0 1.1.9 2 2 2h14v-4"></path><circle cx="18" cy="12" r="2"></circle></svg>`
  },
  {
    tag: 'KEWAJIBAN SYARIAH',
    title: 'ZAKAT MAAL & PROFESI',
    desc: 'Salurkan zakat melalui layanan terverifikasi YPCI sesuai 8 asnaf peruntukan syariah yang sah dan akuntabel.',
    actionText: 'Tunaikan Zakat',
    link: '/program/zakat',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="3" x2="12" y2="21"></line><path d="M5 21h14"></path><path d="M4 7l8-4 8 4"></path><circle cx="7" cy="14" r="3"></circle><circle cx="17" cy="14" r="3"></circle></svg>`
  },
  {
    tag: 'NILAI ABADI',
    title: 'WAKAF UANG & LAHAN',
    desc: 'Bangun manfaat yang terus bertumbuh tanpa henti melalui instrumen wakaf uang produktif mulai Rp 50.000.',
    actionText: 'Ikrar Wakaf',
    link: '/program/wakaf',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>`
  },
  {
    tag: 'SARANA & MATERIAL',
    title: 'DONASI BARANG / FASILITAS',
    desc: 'Dukungan konkret berupa material semen, besi, solar cell, perlengkapan laboratorium, atau bibit greenhouse.',
    actionText: 'Donasi Fasilitas',
    link: '/program/infaq',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>`
  },
  {
    tag: 'KOLABORASI STRATEGIS',
    title: 'KEMITRAAN MULTIPIHAK',
    desc: 'Dukungan institusional skala luas bersama perusahaan (CSR), kampus, dan lembaga donor nasional.',
    actionText: 'Bangun Sinergi',
    link: '#kemitraan',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`
  },
  {
    tag: 'ASISTENSI & AKAD',
    title: 'KONSULTASI & JEMPUT DONASI',
    desc: 'Bantuan hitung nisab zakat, konsultasi akad wakaf tunai, atau layanan jemput donasi resmi langsung dari tim kami.',
    actionText: 'Konsultasi Tim',
    link: 'https://wa.me/6287865994786?text=Halo%20Tim%20GVF,%20saya%20ingin%20konsultasi%20layanan%20donasi',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>`
  }
];
---

<section class="donation-channels-section" id="donasi">
  <div class="donation-channels-container">
    <div class="donation-channels-header text-center">
      <span class="section-kicker reveal-on-scroll">Saluran Kebaikan</span>
      <h2 class="channels-title reveal-heading">Anda Tidak Harus Menunggu untuk Berbuat Baik.</h2>
      <p class="channels-subtitle reveal-on-scroll" data-delay="0.12">Ada banyak cara untuk mengambil bagian dan melipatgandakan pahala jariyah Anda:</p>
    </div>

    <div class="channels-grid reveal-stagger">
      {channels.map((ch, idx) => (
        <div class="channel-card">
          <div class="channel-top">
            <div class="channel-tag-group">
              <span class="channel-num">0{idx + 1}</span>
              <span class="channel-tag">{ch.tag}</span>
            </div>
            <div class="channel-icon-box">
              <Fragment set:html={ch.icon} />
            </div>
          </div>

          <h3 class="channel-title">{ch.title}</h3>
          <p class="channel-desc">{ch.desc}</p>

          <a href={ch.link} class="channel-btn">
            <span>{ch.actionText}</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="btn-arrow">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      ))}
    </div>

    <div class="channels-footer-cta text-center reveal-on-scroll mt-60" data-delay="0.2">
      <a href="#rekening" class="gvf-btn gvf-btn-primary channels-main-cta">
        <span>Pilih Cara Anda Berkontribusi</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="cta-arrow-right">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .donation-channels-section {
    position: relative;
    padding: var(--section-padding-y-lg) 0;
    background-color: #ffffff;
    border-bottom: 1px solid var(--color-border);
  }

  .donation-channels-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .donation-channels-header {
    max-width: 820px;
    margin: 0 auto var(--space-9);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .channels-title {
    font-size: var(--text-heading-lg);
    font-weight: 800;
    line-height: var(--leading-tight);
    color: var(--color-text-heading);
    letter-spacing: var(--tracking-tighter);
    margin-bottom: var(--space-3);
    font-family: var(--font-display);
  }

  .channels-subtitle {
    font-size: var(--text-body-lg);
    line-height: var(--leading-loose);
    color: var(--color-text-muted);
  }

  .channels-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .channel-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-7) var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--shadow-xs);
    transition:
      border-color var(--duration-normal) var(--ease-out),
      box-shadow   var(--duration-normal) var(--ease-out),
      transform    var(--duration-normal) var(--ease-out);
    will-change: transform;
  }

  .channel-card:hover {
    border-color: var(--blue-200);
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg), 0 0 0 1px hsl(214 89% 52% / 0.08);
  }

  .channel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-5);
  }

  .channel-tag-group {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .channel-num {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: 800;
    color: var(--blue-600);
    background: var(--blue-100);
    padding: 3px 8px;
    border-radius: var(--radius-xs);
  }

  .channel-tag {
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .channel-icon-box {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    background: var(--color-surface-50);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--blue-600);
    transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
    flex-shrink: 0;
  }

  .channel-card:hover .channel-icon-box {
    background: var(--blue-500);
    color: #ffffff;
    border-color: var(--blue-500);
  }

  .channel-icon-box :global(svg),
  .channel-icon-box svg {
    width: 18px !important;
    height: 18px !important;
    display: block;
  }

  .channel-title {
    font-size: var(--text-heading-sm);
    font-weight: 800;
    color: var(--color-text-heading);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-2);
    line-height: var(--leading-snug);
    font-family: var(--font-display);
  }

  .channel-desc {
    font-size: var(--text-label);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
    flex: 1;
  }

  .channel-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    background: var(--color-surface-50);
    border: 1px solid var(--color-border);
    padding: 10px 18px;
    border-radius: var(--radius-full);
    color: var(--color-text-heading);
    font-size: var(--text-small);
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color     var(--duration-fast) var(--ease-out),
      color            var(--duration-fast) var(--ease-out);
  }

  .btn-arrow {
    width: 14px;
    height: 14px;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .channel-card:hover .channel-btn {
    background: var(--blue-500);
    border-color: var(--blue-500);
    color: #ffffff;
  }

  .channel-card:hover .btn-arrow {
    transform: translateX(4px);
  }

  .mt-60 {
    margin-top: var(--space-9);
  }

  .channels-main-cta {
    padding: 14px 34px;
    font-size: var(--text-body);
    font-weight: 700;
  }

  .cta-arrow-right {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 1024px) {
    .channels-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .donation-channels-section {
      padding: var(--section-padding-y-sm) 0;
    }
    .donation-channels-container {
      padding: 0 var(--space-5);
    }
    .channels-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
