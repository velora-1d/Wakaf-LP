---
// src/components/home/AboutSplitSection.astro
// Exact ISAVO "Tempat Dimana Rumah Impian Anda Menjadi Kenyataan" Split Section (Screenshot 3)
---

<section class="isavo-about-section" id="tentang-kami">
  <div class="isavo-about-ambient-bg" aria-hidden="true"></div>
  <div class="isavo-watermark" aria-hidden="true">Global Village Fund</div>

  <div class="isavo-about-container">
    <div class="isavo-about-left">
      <div class="about-badge-pill">
        <span class="about-dot-halo">
          <span class="about-halo-ring"></span>
          <span class="about-core-dot"></span>
        </span>
        <span class="about-badge-text">Tentang Global Village Fund</span>
      </div>

      <h2 class="isavo-about-title">
        Wadah Kolaborasi.<br />
        Penguatan Ekosistem Menuju Kemandirian.
      </h2>

      <div class="isavo-checklist-grid">
        <div class="isavo-check-item">
          <span class="isavo-check-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#0969da" stroke-width="3" class="check-svg">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <span class="isavo-check-label">Akad Syariah &amp; Transparan</span>
        </div>

        <div class="isavo-check-item">
          <span class="isavo-check-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#0969da" stroke-width="3" class="check-svg">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <span class="isavo-check-label">Pilar Ekosistem Terpadu</span>
        </div>

        <div class="isavo-check-item">
          <span class="isavo-check-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#0969da" stroke-width="3" class="check-svg">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <span class="isavo-check-label">Kemandirian Berkelanjutan</span>
        </div>

        <div class="isavo-check-item">
          <span class="isavo-check-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#0969da" stroke-width="3" class="check-svg">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <span class="isavo-check-label">Akuntabilitas &amp; Audit Terbuka</span>
        </div>
      </div>

      <p class="isavo-about-desc">
        Global Village Fund (GVF) di bawah Yayasan Permata Cendekia Indonesia (YPCI) memadukan filantropi dan wakaf produktif untuk membangun ekosistem pesantren terpadu 3 hektare di Sukasirna, Jonggol. Kami menghubungkan pendidikan vokasi, masjid, dan agro-technopark berkelanjutan.
      </p>

      <div class="isavo-about-btn-wrap">
        <a href="#layanan" class="isavo-about-pill-btn">
          Pelajari Ekosistem GVF
        </a>
      </div>
    </div>

    <div class="isavo-about-right">
      <div class="isavo-portrait-frame">
        <img
          src="/gambar design/learning studio & workshop.jpg"
          alt="Pilot Project Pesantren Integratif Holistik Skill Village Islamic School Jonggol"
          class="isavo-portrait-img"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .isavo-about-section {
    position: relative;
    padding: 75px 0;
    overflow: hidden;
    background-color: #000000;
  }

  .isavo-about-ambient-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: url('/gambar design/belakang masjid.jpg') no-repeat center center / cover;
    z-index: 0;
  }

  .isavo-about-ambient-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: #000000;
    opacity: 0.46;
  }

  /* Giant Translucent Watermark Text ala Pen.dev */
  .isavo-watermark {
    position: absolute;
    left: 28%;
    bottom: 20px;
    font-size: 140px;
    line-height: 140px;
    font-family: 'Golos Text', system-ui, sans-serif;
    font-weight: 400;
    color: #ffffff;
    opacity: 0.03;
    pointer-events: none;
    z-index: 1;
    white-space: nowrap;
    user-select: none;
  }

  .isavo-about-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }

  /* Left Column */
  .isavo-about-left {
    max-width: 720px;
  }

  /* Halo Badge Pill from Pen.dev */
  .about-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px 5px 10px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(5px);
    outline: 1px solid rgba(255, 255, 255, 0.18);
    outline-offset: -0.5px;
    border-radius: 32px;
    margin-bottom: 20px;
  }

  .about-dot-halo {
    position: relative;
    width: 14px;
    height: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .about-halo-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(74, 222, 128, 0.2);
  }

  .about-core-dot {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #4ade80;
  }

  .about-badge-text {
    font-size: 12px;
    font-weight: 600;
    color: #ffffff;
    letter-spacing: 0.2px;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  /* Giant Title Pen.dev */
  .isavo-about-title {
    font-size: clamp(2rem, 3vw, 42px);
    font-weight: 400;
    line-height: 50px;
    color: #ffffff;
    margin-bottom: 24px;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  /* 2-Column Checklist Grid (4 items) */
  .isavo-checklist-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 20px;
    margin-bottom: 24px;
  }

  .isavo-check-item {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
  }

  .isavo-check-icon {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(9, 105, 218, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .check-svg {
    width: 13px;
    height: 13px;
  }

  .isavo-check-label {
    font-size: 14px;
    font-weight: 600;
    color: #ffffff;
    line-height: 23px;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  /* Description */
  .isavo-about-desc {
    font-size: 15px;
    line-height: 26px;
    color: #ffffff;
    margin-bottom: 32px;
    font-family: 'Golos Text', system-ui, sans-serif;
    font-weight: 400;
  }

  /* Pill Button Pen.dev */
  .isavo-about-pill-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #0969da;
    border: 1px solid #0969da;
    color: #ffffff;
    font-size: 16px;
    font-weight: 400;
    font-family: 'Golos Text', system-ui, sans-serif;
    padding: 14px 32px;
    border-radius: 32px;
    text-decoration: none;
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .isavo-about-pill-btn:hover {
    background: #0752a8;
    transform: translateY(-2px);
  }

  /* Right Column: Framed Portrait Image */
  .isavo-portrait-frame {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    height: 600px;
    background-color: #02070e;
  }

  .isavo-portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.5s ease;
  }

  .isavo-portrait-frame:hover .isavo-portrait-img {
    transform: scale(1.03);
  }

  @media (max-width: 1024px) {
    .isavo-about-container {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .isavo-checklist-grid {
      grid-template-columns: 1fr;
    }
    .isavo-portrait-frame {
      height: 400px;
    }
    .isavo-watermark {
      display: none;
    }
  }
</style>
