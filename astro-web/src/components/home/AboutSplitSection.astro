---
// src/components/home/AboutSplitSection.astro
// GVF Split Section Dinamis dengan Fallback Aman
interface Props {
  content?: Record<string, any>;
}

const { content } = Astro.props;

const DEFAULT_IMAGE = "https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/kegiatan-dan-prestasi-santri/foto-ustadz-bersama-duta-santri.webp";
const imageUrl = content?.imageUrl || content?.mediaUrl || DEFAULT_IMAGE;

const title = content?.heading || content?.title || "Satu Wadah, Empat Pilar Penggerak Kebaikan.";
const leadIntro = content?.subheading || "Layanan filantropi terpadu dari hulu ke hilir yang mengintegrasikan zakat, infak, sedekah, dan wakaf dalam satu ekosistem. Menghubungkan kepedulian dengan berbagai program kebaikan, pemberdayaan, serta pembangunan berkelanjutan.";
const paragraph1 = content?.paragraph1 || content?.desc || content?.description || "Global Village Fund (GVF) merupakan inisiatif filantropi Islam di bawah Yayasan Permata Cendekia Indonesia (YPCI) yang mengintegrasikan pengelolaan zakat, infak, sedekah, dan wakaf untuk mendukung pengembangan ekosistem pesantren. Melalui penghimpunan dan pengelolaan dana filantropi secara amanah, GVF menghubungkan kepedulian para donatur dengan berbagai kebutuhan dan program, meliputi pendidikan, pembinaan karakter, pengembangan kompetensi vokasi, pertanian produktif, fasilitas ibadah, serta penguatan sarana penunjang lainnya. Melalui kolaborasi dan pengelolaan yang bertanggung jawab, GVF berupaya menghadirkan manfaat nyata sekaligus memperkuat fondasi kemandirian ekosistem secara berkelanjutan.";
const paragraph2 = content?.paragraph2 || "";
const ctaText = content?.ctaText || content?.primaryCtaText || "Mengenal Profil GVF";
const ctaUrl = content?.ctaUrl || content?.primaryCtaUrl || "/tentang-kami";
---

<section class="gvf-about-section" id="tentang-kami">
  <div class="gvf-about-ambient-bg" aria-hidden="true"></div>
  <div class="gvf-watermark" aria-hidden="true">Global Village Fund</div>

  <div class="gvf-about-container">
    <div class="gvf-about-left">
      <h2 class="gvf-about-title">
        {title}
      </h2>

      <p class="gvf-lead-intro">
        {leadIntro}
      </p>

      <div class="gvf-checklist-grid">
        <div class="gvf-check-item">
          <span class="gvf-check-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#0969da" stroke-width="3" class="check-svg">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <span class="gvf-check-label">Menghubungkan Kebaikan, Menguatkan Ekosistem</span>
        </div>

        <div class="gvf-check-item">
          <span class="gvf-check-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#0969da" stroke-width="3" class="check-svg">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <span class="gvf-check-label">Kolaborasi Filantropi untuk Kemandirian</span>
        </div>

        <div class="gvf-check-item">
          <span class="gvf-check-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#0969da" stroke-width="3" class="check-svg">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <span class="gvf-check-label">Pengelolaan Sesuai Prinsip Syariah</span>
        </div>

        <div class="gvf-check-item">
          <span class="gvf-check-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#0969da" stroke-width="3" class="check-svg">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <span class="gvf-check-label">Empat Pilar Filantropi Terintegrasi</span>
        </div>

        <div class="gvf-check-item">
          <span class="gvf-check-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#0969da" stroke-width="3" class="check-svg">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <span class="gvf-check-label">Penguatan Ekosistem dan Kemandirian</span>
        </div>

        <div class="gvf-check-item">
          <span class="gvf-check-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#0969da" stroke-width="3" class="check-svg">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <span class="gvf-check-label">Transparansi dan Akuntabilitas</span>
        </div>
      </div>

      <p class="gvf-about-desc">
        {paragraph1}
      </p>

      {paragraph2 && (
        <p class="gvf-about-desc" style="margin-top: 16px;">
          {paragraph2}
        </p>
      )}

      <div class="gvf-about-btn-wrap">
        <a href={ctaUrl} class="gvf-about-pill-btn uiverse-ripple-btn uiverse-ripple-btn-dark">
          <span>{ctaText}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>

    <div class="gvf-about-right">
      <div class="gvf-portrait-frame">
        <img
          src={imageUrl}
          alt="Ustadz Pembina dan Duta Santri Berprestasi Binaan Global Village Fund Sukasirna"
          class="gvf-portrait-img"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .gvf-about-section {
    position: relative;
    padding: 85px 0;
    overflow: hidden;
    background-color: #f8fafc;
  }

  .gvf-about-ambient-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 50%, #f6f6f3 100%);
    z-index: 0;
  }

  .gvf-about-ambient-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 80% 10%, rgba(9, 105, 218, 0.04) 0%, transparent 60%);
    pointer-events: none;
  }

  /* Giant Translucent Watermark Text */
  .gvf-watermark {
    position: absolute;
    left: 28%;
    bottom: 20px;
    font-size: 140px;
    line-height: 140px;
    font-family: 'Golos Text', system-ui, sans-serif;
    font-weight: 400;
    color: #0f172a;
    opacity: 0.03;
    pointer-events: none;
    z-index: 1;
    white-space: nowrap;
    user-select: none;
  }

  .gvf-about-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }

  /* Left Column */
  .gvf-about-left {
    max-width: 720px;
  }

  /* Giant Title */
  .gvf-about-title {
    font-size: clamp(2rem, 3vw, 42px);
    font-weight: 700;
    line-height: 50px;
    letter-spacing: -0.02em;
    color: #0f172a;
    margin-bottom: 20px;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  .gvf-lead-intro {
    font-size: 16px;
    line-height: 27px;
    color: #475569;
    margin: 0 0 24px 0;
    font-family: 'Golos Text', system-ui, sans-serif;
    text-align: justify;
    text-justify: inter-word;
    text-align-last: left;
  }

  /* 2-Column Checklist Grid (4 items) */
  .gvf-checklist-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 20px;
    margin-bottom: 24px;
  }

  .gvf-check-item {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
  }

  .gvf-check-icon {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(9, 105, 218, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .check-svg {
    width: 13px;
    height: 13px;
  }

  .gvf-check-label {
    font-size: 14px;
    font-weight: 600;
    color: #1e293b;
    line-height: 23px;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  /* Description */
  .gvf-about-desc {
    font-size: 15px;
    line-height: 26px;
    color: #475569;
    margin-bottom: 32px;
    font-family: 'Golos Text', system-ui, sans-serif;
    font-weight: 400;
    text-align: justify;
    text-justify: inter-word;
    text-align-last: left;
  }

  /* Pill Button */
  .gvf-about-pill-btn {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: transparent;
    border: 1px solid rgba(15, 23, 42, 0.3);
    color: #0f172a;
    font-size: 16px;
    font-weight: 500;
    font-family: 'Golos Text', system-ui, sans-serif;
    padding: 14px 32px;
    border-radius: 32px;
    text-decoration: none;
    transition: transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.4s ease, color 0.4s ease;
  }

  .gvf-about-pill-btn::before {
    content: "";
    position: absolute;
    z-index: -1;
    background: #0969da;
    height: 220px;
    width: 260px;
    border-radius: 50%;
    top: 100%;
    left: 100%;
    transition: all 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .gvf-about-pill-btn:hover {
    color: #ffffff;
    border-color: #0969da;
    transform: translateY(-2px);
  }

  .gvf-about-pill-btn:hover::before {
    top: -40px;
    left: -40px;
  }

  .gvf-about-pill-btn:active {
    transform: translateY(0) scale(0.98);
  }

  .gvf-about-pill-btn:active::before {
    background: #0752a8;
  }

  .gvf-about-pill-btn > span,
  .gvf-about-pill-btn > svg {
    position: relative;
    z-index: 1;
    transition: transform 0.2s ease;
  }

  .gvf-about-pill-btn:hover > svg {
    transform: translateX(3px);
  }

  /* Right Column: Framed Portrait Image */
  .gvf-portrait-frame {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 4 / 3;
    height: auto;
    background-color: #e8edf2;
    border: 1px solid rgba(0, 0, 0, 0.07);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.08), 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .gvf-portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.5s ease;
  }

  .gvf-portrait-frame:hover .gvf-portrait-img {
    transform: scale(1.03);
  }

  @media (max-width: 1024px) {
    .gvf-about-container {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .gvf-checklist-grid {
      grid-template-columns: 1fr;
    }
    .gvf-portrait-frame {
      width: 100%;
      aspect-ratio: 4 / 3;
      height: auto;
    }
    .gvf-watermark {
      display: none;
    }
  }
</style>
