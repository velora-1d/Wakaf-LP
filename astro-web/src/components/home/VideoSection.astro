---
// src/components/home/VideoSection.astro
// Video Dokumentasi GVF: Aesthetic Frosted Glass Play Button & In-Place Section Video Player
---

<section class="pen-video-section reveal-on-scroll" id="video-dokumentasi">
  <div class="video-bg-media" aria-hidden="true">
    <img
      src="https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/kegiatan-dan-prestasi-santri/pengajian-ramai-santri-aula-masjid.webp"
      alt="Dokumentasi Kajian Akbar dan Keberkahan Santri Global Village Fund"
      class="video-bg-img"
      loading="lazy"
    />
    <div class="video-overlay"></div>
  </div>

  <!-- Normal State: Video Content & Aesthetic Play Button -->
  <div class="video-content-container" id="videoContentContainer">
    <div class="play-btn-wrapper">
      <button
        type="button"
        class="aesthetic-play-btn"
        id="openInlineVideoBtn"
        aria-label="Putar Video Dokumentasi Kawasan GVF"
      >
        <!-- Dual Radar Ripple Waves -->
        <span class="play-ripple ripple-outer" aria-hidden="true"></span>
        <span class="play-ripple ripple-inner" aria-hidden="true"></span>
        <!-- Frosted Glass Halo Ring -->
        <span class="play-glass-ring" aria-hidden="true"></span>
        <!-- Core Gradient Circle -->
        <span class="play-core-circle">
          <svg
            class="play-icon"
            viewBox="0 0 24 24"
            fill="currentColor"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path d="M8 5.14v13.72a1 1 0 001.52.85l11-6.86a1 1 0 000-1.7l-11-6.86A1 1 0 008 5.14z"></path>
          </svg>
        </span>
      </button>
    </div>

    <h2 class="video-title">
      Satu Kebaikan Bisa Menjadi<br />
      Awal Banyak Kebaikan.
    </h2>

    <p class="video-subtitle">
      Simak lebih dekat semangat, visi, dan ikhtiar Global Village Fund dalam membangun ekosistem pesantren terpadu di Sukasirna, Jonggol melalui video dokumentasi resmi.
    </p>
  </div>

  <!-- Active State: In-Place Video Player Container (Muncul Presisi di Dalam Section) -->
  <div class="video-in-place-container" id="videoInPlaceContainer" aria-hidden="true">
    <div class="video-in-place-card">
      <div class="video-in-place-header">
        <div class="video-indicator-badge">
          <span class="video-indicator-dot"></span>
          <span class="video-indicator-text">Video Dokumentasi GVF Sukasirna</span>
        </div>
        <button
          type="button"
          class="video-in-place-close-btn"
          id="closeInlineVideoBtn"
          aria-label="Tutup Video Dokumentasi"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
          <span>Tutup Video</span>
        </button>
      </div>

      <div class="video-in-place-frame-wrap">
        <iframe
          id="gvfInlineVideoFrame"
          src=""
          data-src="https://www.youtube.com/embed/UDuRQb4ABBs?autoplay=1&rel=0&modestbranding=1&playsinline=1"
          title="Video Dokumentasi Global Village Fund"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.getElementById('video-dokumentasi');
  const openBtn = document.getElementById('openInlineVideoBtn');
  const closeBtn = document.getElementById('closeInlineVideoBtn');
  const container = document.getElementById('videoInPlaceContainer');
  const iframe = document.getElementById('gvfInlineVideoFrame') as HTMLIFrameElement | null;

  function openVideo() {
    if (section && container && iframe) {
      const videoSrc = iframe.getAttribute('data-src') || '';
      iframe.src = videoSrc;
      section.classList.add('is-video-active');
      container.setAttribute('aria-hidden', 'false');
      // Scroll into view gently so the section is framed precisely in viewport
      section.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }

  function closeVideo() {
    if (section && container && iframe) {
      iframe.src = '';
      section.classList.remove('is-video-active');
      container.setAttribute('aria-hidden', 'true');
    }
  }

  if (openBtn) {
    openBtn.addEventListener('click', openVideo);
  }

  if (closeBtn) {
    closeBtn.addEventListener('click', closeVideo);
  }

  // Keyboard accessibility: Escape to close video
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && section?.classList.contains('is-video-active')) {
      closeVideo();
    }
  });
</script>

<style>
  .pen-video-section {
    position: relative;
    width: 100%;
    min-height: 700px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 90px 24px;
    box-sizing: border-box;
    background-color: #061829;
    transition: padding 0.35s ease;
  }

  .video-bg-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  .video-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .video-overlay {
    position: absolute;
    inset: 0;
    background-color: #061829;
    opacity: 0.82;
    transition: opacity 0.4s ease, background-color 0.4s ease;
  }

  /* When Video is Active in Section */
  .pen-video-section.is-video-active .video-bg-img {
    transform: scale(1.04);
  }

  .pen-video-section.is-video-active .video-overlay {
    background-color: #020617;
    opacity: 0.94;
  }

  /* Normal Content Container */
  .video-content-container {
    position: relative;
    z-index: 1;
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .pen-video-section.is-video-active .video-content-container {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.96) translateY(-14px);
    display: none;
  }

  /* Aesthetic Play Button */
  .play-btn-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
  }

  .aesthetic-play-btn {
    position: relative;
    width: 96px;
    height: 96px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    outline: none;
    border-radius: 50%;
    -webkit-tap-highlight-color: transparent;
  }

  /* Frosted Glass Halo Ring */
  .play-glass-ring {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  /* Core Gradient Circle */
  .play-core-circle {
    position: relative;
    width: 78px;
    height: 78px;
    border-radius: 50%;
    background: linear-gradient(135deg, #0969da 0%, #064ea4 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 12px 28px rgba(9, 105, 218, 0.45), inset 0 1px 1.5px rgba(255, 255, 255, 0.5);
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), background 0.25s ease;
  }

  /* Dual Pulse Ripple Waves */
  .play-ripple {
    position: absolute;
    inset: -14px;
    border-radius: 50%;
    border: 1.5px solid rgba(9, 105, 218, 0.55);
    pointer-events: none;
  }

  .ripple-outer {
    animation: ripplePulse 2.8s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
  }

  .ripple-inner {
    animation: ripplePulse 2.8s cubic-bezier(0.2, 0.8, 0.2, 1) infinite 1.4s;
  }

  @keyframes ripplePulse {
    0% {
      transform: scale(0.9);
      opacity: 0.85;
    }
    100% {
      transform: scale(1.65);
      opacity: 0;
    }
  }

  /* Hover & Active Interactions */
  .aesthetic-play-btn:hover .play-glass-ring {
    inset: -10px;
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.45);
    box-shadow: 0 0 30px rgba(9, 105, 218, 0.4);
  }

  .aesthetic-play-btn:hover .play-core-circle {
    transform: scale(1.06);
    background: linear-gradient(135deg, #1b7cf0 0%, #0969da 100%);
    box-shadow: 0 16px 36px rgba(9, 105, 218, 0.6), inset 0 1px 2px rgba(255, 255, 255, 0.7);
  }

  .aesthetic-play-btn:active .play-core-circle {
    transform: scale(0.95);
  }

  .play-icon {
    width: 32px;
    height: 32px;
    margin-left: 4px;
    fill: #ffffff;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
    transition: transform 0.2s ease;
  }

  .aesthetic-play-btn:hover .play-icon {
    transform: scale(1.06);
  }

  /* Typography */
  .video-title {
    font-size: 48px;
    line-height: 58px;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.02em;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  .video-subtitle {
    font-size: 16px;
    line-height: 26px;
    color: #cbd5e1;
    font-weight: 400;
    margin: 0;
    max-width: 760px;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  /* In-Place Video Player Container */
  .video-in-place-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1060px;
    margin: 0 auto;
    display: none;
    opacity: 0;
    transform: scale(0.97);
    transition: opacity 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .pen-video-section.is-video-active .video-in-place-container {
    display: block;
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  .video-in-place-card {
    position: relative;
    width: 100%;
    background: #020617;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.85), 0 0 40px rgba(9, 105, 218, 0.22);
  }

  .video-in-place-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    background: rgba(15, 23, 42, 0.95);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .video-indicator-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .video-indicator-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #0969da;
    box-shadow: 0 0 10px #0969da;
    animation: livePulse 2s infinite ease-in-out;
  }

  @keyframes livePulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(0.85);
    }
  }

  .video-indicator-text {
    font-family: 'Golos Text', system-ui, sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: #cbd5e1;
    letter-spacing: -0.01em;
  }

  .video-in-place-close-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    font-family: 'Golos Text', system-ui, sans-serif;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
    min-height: 36px;
    -webkit-tap-highlight-color: transparent;
  }

  .video-in-place-close-btn:hover {
    background: #0969da;
    border-color: rgba(255, 255, 255, 0.5);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(9, 105, 218, 0.4);
  }

  .video-in-place-close-btn:active {
    transform: scale(0.96);
  }

  .video-in-place-frame-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000000;
    overflow: hidden;
  }

  .video-in-place-frame-wrap iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  /* Responsive Breakpoints */
  @media (max-width: 768px) {
    .pen-video-section {
      min-height: 560px;
      padding: 60px 16px;
    }

    .aesthetic-play-btn {
      width: 78px;
      height: 78px;
    }

    .play-glass-ring {
      inset: -5px;
    }

    .play-core-circle {
      width: 64px;
      height: 64px;
    }

    .play-icon {
      width: 26px;
      height: 26px;
      margin-left: 3px;
    }

    .video-title {
      font-size: 30px;
      line-height: 38px;
    }

    .video-subtitle {
      font-size: 14px;
      line-height: 22px;
    }

    .video-in-place-card {
      border-radius: 16px;
    }

    .video-in-place-header {
      padding: 10px 14px;
    }

    .video-indicator-text {
      font-size: 12px;
      max-width: 160px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .video-in-place-close-btn {
      padding: 6px 12px;
      font-size: 12px;
    }
  }
</style>
