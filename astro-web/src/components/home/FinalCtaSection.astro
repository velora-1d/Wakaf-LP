---
// src/components/home/FinalCtaSection.astro
// Section 13: Final CTA & Official Brand Closing
---

<section class="final-cta-section" id="final-cta">
  <div class="final-cta-container">
    <div class="final-cta-box reveal-on-scroll">
      <div class="cta-inner-content text-center">
        <h2 class="final-cta-heading">
          Satu Kebaikan Bisa Menjadi Awal<br />
          dari Banyak Kebaikan.
        </h2>

        <p class="final-cta-paragraph">
          Mari bersama membangun ekosistem yang membuat pendidikan menjadi kesempatan, keterampilan menjadi kemandirian, dan kebaikan menjadi kebermanfaatan yang terus tumbuh sepanjang masa.
        </p>

        <!-- Dual CTA Buttons -->
        <div class="final-buttons-row">
          <a href="#donasi" class="btn-final-primary">
            <svg class="heart-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
            <span>Salurkan Donasi Sekarang</span>
          </a>

          <a href="#kemitraan" class="btn-final-outline">
            <span>Konsultasi Kemitraan</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="arrow-icon">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <!-- Official Tagline & Brand Identity Footer -->
        <div class="brand-closing-seal">
          <span class="brand-name">GLOBAL VILLAGE FUND</span>
          <span class="brand-motto">Fostering Pesantren Ecosystems for Self-Reliance & Social Impact</span>
          <span class="brand-pillars">Donasi • Zakat • Wakaf • Kemitraan</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta-section {
    position: relative;
    padding: 100px 0 120px;
    background-color: #0f172a;
    overflow: hidden;
  }

  .final-cta-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .final-cta-box {
    background: linear-gradient(135deg, rgba(10, 37, 64, 0.95) 0%, rgba(15, 23, 42, 0.98) 100%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 36px;
    padding: 80px 48px;
    position: relative;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.45);
  }

  .cta-inner-content {
    max-width: 820px;
    margin: 0 auto;
  }

  .cta-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(56, 189, 248, 0.15);
    border: 1px solid rgba(56, 189, 248, 0.35);
    padding: 6px 16px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #38bdf8;
    margin-bottom: 24px;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    background-color: #38bdf8;
    border-radius: 50%;
  }

  .final-cta-heading {
    font-size: clamp(2.4rem, 4.5vw, 3.6rem);
    font-weight: 900;
    line-height: 1.15;
    color: #ffffff;
    letter-spacing: -0.03em;
    margin-bottom: 22px;
  }

  .final-cta-paragraph {
    font-size: 1.15rem;
    line-height: 1.75;
    color: #cbd5e1;
    margin-bottom: 40px;
  }

  .final-buttons-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-bottom: 50px;
  }

  .btn-final-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(135deg, #e53935 0%, #d32f2f 100%);
    color: #ffffff;
    padding: 16px 36px;
    border-radius: 9999px;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    text-decoration: none;
    box-shadow: 0 10px 30px rgba(229, 57, 53, 0.45);
    transition: all 0.3s ease;
  }

  .btn-final-primary:hover {
    background: linear-gradient(135deg, #d32f2f 0%, #c62828 100%);
    transform: translateY(-2px);
    box-shadow: 0 14px 36px rgba(229, 57, 53, 0.6);
  }

  .heart-icon {
    width: 20px;
    height: 20px;
  }

  .btn-final-outline {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.06);
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
    padding: 16px 32px;
    border-radius: 9999px;
    font-size: 1.02rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .btn-final-outline:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: #ffffff;
    transform: translateY(-2px);
  }

  .arrow-icon {
    width: 16px;
    height: 16px;
    transition: transform 0.25s ease;
  }

  .btn-final-outline:hover .arrow-icon {
    transform: translateX(4px);
  }

  /* Seal Footer */
  .brand-closing-seal {
    padding-top: 36px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .brand-name {
    font-size: 1.25rem;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: 0.12em;
  }

  .brand-motto {
    font-size: 0.92rem;
    color: #38bdf8;
    font-weight: 600;
    font-style: italic;
  }

  .brand-pillars {
    font-size: 0.8rem;
    color: #94a3b8;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-top: 4px;
  }

  @media (max-width: 768px) {
    .final-cta-box {
      padding: 50px 24px;
    }
  }
</style>
