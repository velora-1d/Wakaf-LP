---
// src/components/home/FinalCtaSection.astro
// Section 13: Final CTA & Official Brand Closing
---

<section class="final-cta-section" id="final-cta">
  <div class="final-cta-container">
    <div class="final-cta-box reveal-scale">
      <div class="cta-inner-content text-center">
        <span class="section-kicker reveal-on-scroll">Awal Kebaikan Berkelanjutan</span>
        <h2 class="final-cta-heading reveal-heading">
          Satu Kebaikan Bisa Menjadi Awal Banyak Kebaikan.
        </h2>

        <p class="final-cta-paragraph reveal-on-scroll" data-delay="0.15">
          Mari bersama membangun ekosistem yang membuat pendidikan menjadi kesempatan, keterampilan menjadi kemandirian, dan kebaikan menjadi kebermanfaatan yang terus tumbuh sepanjang masa.
        </p>

        <!-- Dual CTA Buttons -->
        <div class="final-buttons-row reveal-on-scroll" data-delay="0.25">
          <a href="#donasi" class="gvf-btn gvf-btn-primary final-btn-primary">
            <svg class="heart-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
            <span>Salurkan Donasi Sekarang</span>
          </a>

          <a href="#kemitraan" class="btn-final-outline">
            <span>Konsultasi Kemitraan</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="arrow-icon">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <!-- Official Tagline & Brand Identity Footer -->
        <div class="brand-closing-seal reveal-on-scroll" data-delay="0.35">
          <span class="brand-name">GLOBAL VILLAGE FUND</span>
          <span class="brand-motto">Fostering Pesantren Ecosystems for Self-Reliance & Social Impact</span>
          <span class="brand-pillars">Donasi • Zakat • Wakaf • Kemitraan</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta-section {
    position: relative;
    padding: var(--section-padding-y-lg) 0;
    background-color: var(--navy-950);
    overflow: hidden;
  }

  /* Subtle background radial glow */
  .final-cta-section::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 800px;
    height: 500px;
    background: radial-gradient(ellipse at center, rgba(14, 116, 226, 0.12) 0%, transparent 70%);
    pointer-events: none;
  }

  .final-cta-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 var(--space-6);
    position: relative;
    z-index: 1;
  }

  .final-cta-box {
    background: linear-gradient(135deg, var(--navy-900) 0%, var(--navy-800) 100%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-2xl);
    padding: var(--space-11) var(--space-8);
    position: relative;
    box-shadow: var(--shadow-dark);
  }

  .cta-inner-content {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .final-cta-heading {
    font-size: var(--text-heading-xl);
    font-weight: 800;
    line-height: var(--leading-tight);
    color: #ffffff;
    letter-spacing: var(--tracking-tighter);
    margin-bottom: var(--space-4);
    font-family: var(--font-display);
  }

  .final-cta-paragraph {
    font-size: var(--text-body-lg);
    line-height: var(--leading-loose);
    color: var(--color-text-on-dark);
    opacity: 0.85;
    margin-bottom: var(--space-8);
    max-width: 700px;
  }

  .final-buttons-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-10);
  }

  .final-btn-primary {
    padding: 14px 34px;
    font-size: var(--text-body);
    font-weight: 700;
  }

  .heart-icon {
    width: 18px;
    height: 18px;
  }

  .btn-final-outline {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    padding: 14px 30px;
    border-radius: var(--radius-full);
    font-size: var(--text-body);
    font-weight: 600;
    text-decoration: none;
    font-family: var(--font-sans);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color     var(--duration-fast) var(--ease-out),
      transform        var(--duration-fast) var(--ease-out);
    will-change: transform;
  }

  .btn-final-outline:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-2px);
  }

  .btn-final-outline:active {
    transform: translateY(0);
  }

  .arrow-icon {
    width: 16px;
    height: 16px;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .btn-final-outline:hover .arrow-icon {
    transform: translateX(4px);
  }

  /* Seal Footer */
  .brand-closing-seal {
    width: 100%;
    padding-top: var(--space-7);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }

  .brand-name {
    font-size: var(--text-heading-sm);
    font-weight: 800;
    color: #ffffff;
    letter-spacing: var(--tracking-wider);
    font-family: var(--font-display);
  }

  .brand-motto {
    font-size: var(--text-label);
    color: var(--blue-400);
    font-weight: 500;
  }

  .brand-pillars {
    font-size: var(--text-micro);
    color: var(--color-text-faint);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    margin-top: var(--space-1);
  }

  @media (max-width: 768px) {
    .final-cta-section {
      padding: var(--section-padding-y-sm) 0;
    }
    .final-cta-box {
      padding: var(--space-7) var(--space-5);
    }
  }
</style>
