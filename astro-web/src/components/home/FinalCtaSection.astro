---
// src/components/home/FinalCtaSection.astro
// Exact Pen.dev "Punya Niat Amal Jariyah & Pertanyaan?" Final CTA Section
---

<section class="pen-final-cta-section reveal-on-scroll" id="konsultasi">
  <div class="pen-final-cta-container">
    <div class="pen-final-cta-content">
      <div class="pen-cta-badge">
        <div class="dot-halo">
          <div class="halo-ring"></div>
          <div class="core-dot"></div>
        </div>
        <span class="badge-text">Kolaborasi &amp; Amal Jariyah</span>
      </div>

      <h2 class="pen-cta-title">
        Punya Niat Amal Jariyah &amp; Pertanyaan?<br />
        Wujudkan Bersama Kami Hari Ini
      </h2>

      <p class="pen-cta-desc">
        Konsultasikan niat amal jariyah, infaq, sedekah, zakat, wakaf, atau kemitraan korporasi bersama tim Global Village Fund. Kami siap mendampingi amanah kebaikan Anda dari niat hingga kemanfaatan abadi.
      </p>

      <div class="pen-cta-action">
        <a
          href="https://wa.me/6287865994786?text=Assalamu'alaikum%20Admin%20Global%20Village%20Fund,%20saya%20ingin%20konsultasi%20amal%20jariyah"
          target="_blank"
          rel="noopener noreferrer"
          class="pen-cta-btn"
        >
          <span>Konsultasi Amal Jariyah</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .pen-final-cta-section {
    position: relative;
    padding: 100px 0 120px 0;
    background-color: #ffffff;
    overflow: hidden;
  }

  .pen-final-cta-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .pen-final-cta-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 22px;
    max-width: 860px;
    margin: 0 auto;
  }

  /* Badge Pill */
  .pen-cta-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px 5px 10px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    box-shadow: 0px 1px 4px rgba(0, 0, 0, 0.04);
    border-radius: 32px;
  }

  .dot-halo {
    width: 14px;
    height: 14px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .halo-ring {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: rgba(9, 105, 218, 0.12);
  }

  .core-dot {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #0969da;
  }

  .badge-text {
    font-size: 12px;
    line-height: normal;
    color: #000000;
    font-weight: 600;
    letter-spacing: 0.2px;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  /* Title & Description */
  .pen-cta-title {
    font-size: 48px;
    line-height: 55px;
    font-weight: 400;
    color: #000000;
    margin: 0;
    letter-spacing: -0.02em;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  .pen-cta-desc {
    font-size: 18px;
    line-height: 31px;
    color: #62625b;
    font-weight: 400;
    margin: 0;
    max-width: 820px;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  /* CTA Button exact Pen.dev */
  .pen-cta-action {
    margin-top: 16px;
  }

  .pen-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 36px;
    height: 54px;
    background-color: #0969da;
    border: 1px solid #0969da;
    border-radius: 32px;
    color: #ffffff;
    font-size: 18px;
    line-height: 18px;
    font-weight: 600;
    text-decoration: none;
    font-family: 'Golos Text', system-ui, sans-serif;
    transition: transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1), background-color 180ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
    box-shadow: 0 4px 14px rgba(9, 105, 218, 0.25);
  }

  .pen-cta-btn:hover {
    background-color: #0752a8;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(9, 105, 218, 0.35);
  }

  .pen-cta-btn:active {
    transform: scale(0.97);
  }

  @media (max-width: 768px) {
    .pen-final-cta-section {
      padding: 70px 0 90px 0;
    }

    .pen-cta-title {
      font-size: 32px;
      line-height: 40px;
    }

    .pen-cta-desc {
      font-size: 15px;
      line-height: 25px;
    }

    .pen-cta-btn {
      width: 100%;
      font-size: 16px;
      padding: 14px 28px;
    }
  }
</style>
