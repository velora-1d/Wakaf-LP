---
// src/components/home/WhereSupportGoesSection.astro
// Section 05: Where Your Support Goes — Transparansi Alokasi 6 Pilar Kebaikan
const supportPillars = [
  {
    num: '01',
    title: 'Pendidikan',
    desc: 'Mendukung pengembangan pembelajaran, beasiswa tahfidz, adab, dan kompetensi santri terpadu.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>`
  },
  {
    num: '02',
    title: 'Fasilitas',
    desc: 'Membangun dan melengkapi ruang serta sarana ramah lingkungan yang menunjang aktivitas pendidikan.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M9 8h1M9 12h1M9 16h1M14 8h1M14 12h1M14 16h1M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"></path></svg>`
  },
  {
    num: '03',
    title: 'Keterampilan',
    desc: 'Mendukung pengembangan skill, teaching factory, laboratorium, dan pengalaman praktik dunia riil.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>`
  },
  {
    num: '04',
    title: 'Kemandirian',
    desc: 'Mengembangkan unit usaha dan aset produktif kawasan yang menopang keberlanjutan masa depan.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>`
  },
  {
    num: '05',
    title: 'Wakaf Produktif',
    desc: 'Membangun aset abadi yang memiliki nilai manfaat jangka panjang dan potensi pertumbuhan ekonomi umat.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>`
  },
  {
    num: '06',
    title: 'Pemberdayaan',
    desc: 'Membuka ruang kolaborasi multipihak dan kesempatan agar santri serta masyarakat sekitar dapat berkembang.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`
  }
];
---

<section class="support-goes-section" id="alokasi-dukungan">
  <div class="support-goes-container">
    <div class="support-goes-header text-center reveal-on-scroll">
      <div class="support-goes-pill">
        <span class="pill-dot"></span>
        <span>05 • WHERE YOUR SUPPORT GOES</span>
      </div>
      <h2 class="support-goes-title">Setiap Kebaikan Memiliki Tujuan.</h2>
      <p class="support-goes-desc">
        Transparansi adalah janji kami kepada donatur. Setiap rupiah dan aset yang Anda amanahkan disalurkan dengan teliti untuk memperkuat 6 pilar utama ekosistem:
      </p>
    </div>

    <div class="support-goes-grid">
      {supportPillars.map((item, idx) => (
        <div class={`support-card reveal-on-scroll delay-${(idx + 1) * 100}`}>
          <div class="card-head">
            <span class="card-num">{item.num}</span>
            <div class="card-icon">
              <Fragment set:html={item.icon} />
            </div>
          </div>
          <h3 class="card-title">{item.title}</h3>
          <p class="card-desc">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .support-goes-section {
    position: relative;
    padding: 110px 0 120px;
    background-color: #ffffff;
    border-bottom: 1px solid #f1f5f9;
  }

  .support-goes-container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .support-goes-header {
    max-width: 820px;
    margin: 0 auto 60px;
  }

  .support-goes-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(2, 132, 199, 0.1);
    border: 1px solid rgba(2, 132, 199, 0.25);
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #0284c7;
    margin-bottom: 20px;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    background-color: #0284c7;
    border-radius: 50%;
  }

  .support-goes-title {
    font-size: clamp(2.2rem, 3.8vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    color: #0f172a;
    letter-spacing: -0.025em;
    margin-bottom: 20px;
  }

  .support-goes-desc {
    font-size: 1.08rem;
    line-height: 1.7;
    color: #64748b;
  }

  .support-goes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }

  .support-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .support-card:hover {
    background: #ffffff;
    transform: translateY(-5px);
    border-color: #0284c7;
    box-shadow: 0 16px 36px rgba(2, 132, 199, 0.08);
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
  }

  .card-num {
    font-size: 1.4rem;
    font-weight: 900;
    color: #cbd5e1;
    letter-spacing: -0.02em;
    font-family: monospace;
    transition: color 0.3s ease;
  }

  .support-card:hover .card-num {
    color: #0284c7;
  }

  .card-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0284c7;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    transition: all 0.3s ease;
  }

  .card-icon :global(svg) {
    width: 22px;
    height: 22px;
  }

  .support-card:hover .card-icon {
    background: #0284c7;
    color: #ffffff;
  }

  .card-title {
    font-size: 1.3rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.01em;
    margin-bottom: 10px;
  }

  .card-desc {
    font-size: 0.95rem;
    line-height: 1.65;
    color: #64748b;
  }

  @media (max-width: 1024px) {
    .support-goes-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .support-goes-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
