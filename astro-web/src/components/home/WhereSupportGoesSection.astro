---
// src/components/home/WhereSupportGoesSection.astro
// Section 05: Where Your Support Goes — Asymmetric Bento Grid Transparansi Alokasi 6 Pilar
const supportPillars = [
  {
    num: '01',
    title: 'Pendidikan & Beasiswa Santri',
    category: 'PILAR UTAMA',
    isFeatured: true,
    desc: 'Mendukung kurikulum terpadu ilmu syariah, sains modern, pembentukan karakter FAST, dan pembiayaan beasiswa santri berprestasi dari berbagai pelosok negeri.',
    stats: '40% Fokus Ekosistem',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>`
  },
  {
    num: '02',
    title: 'Fasilitas & Sarana Hijau',
    category: 'INFRASTRUKTUR',
    desc: 'Membangun dan melengkapi ruang belajar hemat energi, sanitasi terpadu, mezanin masjid, dan sarana ramah lingkungan di Jonggol Bogor.',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M9 8h1M9 12h1M9 16h1M14 8h1M14 12h1M14 16h1M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"></path></svg>`
  },
  {
    num: '03',
    title: 'Keterampilan & Teaching Factory',
    category: 'VOKASI TERAPAN',
    desc: 'Pengadaan laboratorium praktik dan teaching factory di 4 bidang: Pertanian Modern, Rekayasa Teknologi, Konstruksi, dan Bisnis Digital.',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>`
  },
  {
    num: '04',
    title: 'Kemandirian & Unit Usaha',
    category: 'EKONOMI SANTRI',
    desc: 'Inkubasi unit usaha pesantren seperti greenhouse hidroponik dan olahan pangan yang menopang keberlangsungan dakwah.',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>`
  },
  {
    num: '05',
    title: 'Wakaf Produktif Abadi',
    category: 'ASET BERKELANJUTAN',
    isFeatured: true,
    desc: 'Investasi pada aset produktif riil yang nilai pokoknya dijaga abadi sesuai syariat, dengan dividen manfaat sosial dialirkan terus-menerus ke beasiswa santri.',
    stats: 'Nilai Pokok Abadi',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>`
  },
  {
    num: '06',
    title: 'Pemberdayaan Masyarakat Sekitar',
    category: 'DAMPAK SOSIAL',
    desc: 'Program transfer teknologi pertanian dan pelibatan warga lokal Jonggol untuk bersama-sama menggerakkan ekonomi kerakyatan.',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`
  }
];
---

<section class="support-goes-section" id="alokasi-dukungan">
  <div class="support-goes-container">
    <div class="support-goes-header text-center reveal-on-scroll">
      <div class="support-goes-pill">
        <span class="pill-dot"></span>
        <span>05 • WHERE YOUR SUPPORT GOES</span>
      </div>
      <h2 class="support-goes-title">Setiap Kebaikan Memiliki Tujuan.</h2>
      <p class="support-goes-desc">
        Transparansi adalah janji kami kepada donatur. Setiap rupiah dan aset yang Anda amanahkan disalurkan dengan teliti untuk memperkuat 6 pilar utama ekosistem:
      </p>
    </div>

    <!-- Asymmetric Bento Grid (shadcn-inspired Architecture) -->
    <div class="bento-allocation-grid">
      {supportPillars.map((item, idx) => (
        <div class={`bento-card reveal-on-scroll delay-${(idx + 1) * 100} ${item.isFeatured ? 'is-featured' : ''}`}>
          <div class="bento-card-top">
            <div class="bento-badge-group">
              <span class="bento-num">{item.num}</span>
              <span class="bento-tag">{item.category}</span>
            </div>
            <div class="bento-icon-box">
              <Fragment set:html={item.icon} />
            </div>
          </div>

          <div class="bento-card-content">
            <h3 class="bento-card-title">{item.title}</h3>
            <p class="bento-card-desc">{item.desc}</p>
          </div>

          {item.stats && (
            <div class="bento-card-footer">
              <span class="bento-stats-badge">
                <span class="stats-dot"></span>
                <span>{item.stats}</span>
              </span>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .support-goes-section {
    position: relative;
    padding: 100px 0 120px;
    background-color: #ffffff;
    border-bottom: 1px solid #f1f5f9;
  }

  .support-goes-container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .support-goes-header {
    max-width: 820px;
    margin: 0 auto 50px;
  }

  .support-goes-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(2, 132, 199, 0.08);
    border: 1px solid rgba(2, 132, 199, 0.2);
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #0284c7;
    margin-bottom: 20px;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    background-color: #0284c7;
    border-radius: 50%;
  }

  .support-goes-title {
    font-size: clamp(2.2rem, 3.8vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    color: #0f172a;
    letter-spacing: -0.025em;
    margin-bottom: 18px;
  }

  .support-goes-desc {
    font-size: 1.08rem;
    line-height: 1.7;
    color: #64748b;
  }

  /* Asymmetric Bento Grid */
  .bento-allocation-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .bento-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.04), 0 1px 2px -1px rgba(0, 0, 0, 0.04);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
  }

  .bento-card:hover {
    border-color: #cbd5e1;
    transform: translateY(-3px);
    box-shadow: 0 12px 28px -6px rgba(15, 23, 42, 0.08);
  }

  /* Featured Bento Cards (Highlighted with subtle tint & border) */
  .bento-card.is-featured {
    background: linear-gradient(180deg, #f0f9ff 0%, #ffffff 100%);
    border-color: rgba(2, 132, 199, 0.3);
  }

  .bento-card.is-featured:hover {
    border-color: #0284c7;
    box-shadow: 0 14px 32px -6px rgba(2, 132, 199, 0.12);
  }

  .bento-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .bento-badge-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .bento-num {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8rem;
    font-weight: 800;
    color: #0284c7;
    background: #e0f2fe;
    padding: 3px 8px;
    border-radius: 6px;
  }

  .bento-tag {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: #64748b;
    text-transform: uppercase;
  }

  .bento-icon-box {
    width: 38px;
    height: 38px;
    min-width: 38px;
    min-height: 38px;
    max-width: 38px;
    max-height: 38px;
    border-radius: 10px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0284c7;
    transition: all 0.25s ease;
    overflow: hidden;
    flex-shrink: 0;
  }

  .bento-card:hover .bento-icon-box {
    background: #0284c7;
    color: #ffffff;
    border-color: #0284c7;
  }

  .bento-icon-box :global(svg),
  .bento-icon-box svg {
    width: 20px !important;
    height: 20px !important;
    max-width: 20px !important;
    max-height: 20px !important;
    display: block;
  }

  .bento-card-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .bento-card-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.015em;
    margin: 0;
    line-height: 1.3;
  }

  .bento-card-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: #64748b;
    margin: 0;
  }

  .bento-card-footer {
    padding-top: 16px;
    margin-top: 16px;
    border-top: 1px solid #f1f5f9;
  }

  .bento-stats-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    font-weight: 800;
    color: #0284c7;
    background: rgba(2, 132, 199, 0.08);
    padding: 4px 10px;
    border-radius: 9999px;
  }

  .stats-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: #0284c7;
  }

  @media (max-width: 1024px) {
    .bento-allocation-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .bento-allocation-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
