---
// src/components/home/FeaturedCampaignSection.astro
// Section 08: Featured Campaign — Bantu Menyelesaikan Masjid Khairu Ummah Sugro
const collectedAmount = "Rp 348.500.000";
const targetAmount = "Rp 1.250.000.000";
const percentage = 28;
---
<section class="featured-campaign-section" id="campaign-masjid">
  <div class="featured-campaign-container">
    <div class="campaign-grid">
      <!-- Left Content: Campaign Info, Metrics, & CTAs -->
      <div class="campaign-content">
        <span class="section-kicker reveal-on-scroll">Campaign Prioritas</span>
        <h2 class="campaign-title reveal-heading">
          Bantu Menyelesaikan Masjid Khairu Ummah Sugro
        </h2>

        <div class="campaign-verses reveal-on-scroll" data-delay="0.1">
          <span>Satu bangunan.</span>
          <span class="dot-sep">•</span>
          <span>Satu ruang ibadah.</span>
          <span class="dot-sep">•</span>
          <span>Satu pusat kebaikan bagi ekosistem pesantren.</span>
        </div>

        <p class="campaign-desc reveal-on-scroll" data-delay="0.15">
          Masjid ramah lingkungan dengan konsep green architecture di kawasan Jonggol Bogor. Menjadi pusat ibadah harian santri, salat berjamaah warga sekitar, kajian adab, dan pusat koordinasi ekosistem ABCFG.
        </p>

        <!-- Live Donation Progress Bar -->
        <div class="progress-container reveal-on-scroll" data-delay="0.2">
          <div class="progress-labels">
            <div class="collected-wrap">
              <span class="prog-meta-lbl">Terkumpul Saat Ini:</span>
              <span class="prog-meta-val">{collectedAmount}</span>
            </div>
            <div class="target-wrap">
              <span class="prog-meta-lbl">Target Pembangunan:</span>
              <span class="prog-meta-val target">{targetAmount}</span>
            </div>
          </div>

          <div class="progress-bar-bg" role="progressbar" aria-valuenow={percentage} aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar-fill" style={`width: ${percentage}%;`}>
              <span class="progress-pct-badge">{percentage}%</span>
            </div>
          </div>
        </div>

        <!-- Dual CTA Buttons -->
        <div class="campaign-cta-wrap reveal-on-scroll" data-delay="0.25">
          <a href="#donasi" class="gvf-btn gvf-btn-primary campaign-btn-primary">
            <svg class="heart-svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
            <span>Donasi Sekarang</span>
          </a>

          <a href="/program/wakaf" class="campaign-btn-outline">
            <span>Lihat Detail Campaign</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="arrow-svg">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Visual: Architectural 3D Rendering of the Mosque -->
      <div class="campaign-media reveal-scale parallax-wrap" data-delay="0.15">
        <img
          src="/gambar design/belakang masjid (2).jpg"
          alt="Desain Arsitektur Masjid Khairu Ummah Sugro"
          class="campaign-img parallax-img"
          data-speed="12"
          loading="lazy"
        />
        <div class="campaign-media-overlay"></div>
        <div class="campaign-floating-badge">
          <span class="badge-num">±3 Hektare</span>
          <span class="badge-sub">Kawasan Terpadu Jonggol</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .featured-campaign-section {
    position: relative;
    padding: var(--section-padding-y-lg) 0;
    background-color: var(--navy-950);
  }

  .featured-campaign-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .campaign-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-9);
    align-items: center;
  }

  .campaign-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .campaign-title {
    font-size: var(--text-heading-lg);
    font-weight: 800;
    line-height: var(--leading-tight);
    color: #ffffff;
    letter-spacing: var(--tracking-tighter);
    margin-bottom: var(--space-3);
    font-family: var(--font-display);
  }

  .campaign-verses {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-label);
    font-weight: 600;
    color: var(--blue-400);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }

  .dot-sep {
    color: var(--color-text-muted);
  }

  .campaign-desc {
    font-size: var(--text-body);
    line-height: var(--leading-loose);
    color: var(--color-text-on-dark);
    opacity: 0.85;
    margin-bottom: var(--space-7);
  }

  /* Progress Bar Container */
  .progress-container {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
    margin-bottom: var(--space-8);
  }

  .progress-labels {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .prog-meta-lbl {
    font-size: var(--text-micro);
    color: var(--color-text-faint);
    display: block;
    margin-bottom: 2px;
  }

  .prog-meta-val {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--blue-400);
    letter-spacing: var(--tracking-tight);
    font-family: var(--font-display);
  }

  .prog-meta-val.target {
    color: #ffffff;
  }

  .progress-bar-bg {
    width: 100%;
    height: 10px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-full);
    overflow: visible;
    position: relative;
  }

  .progress-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--blue-500) 0%, var(--blue-400) 100%);
    border-radius: var(--radius-full);
    position: relative;
    transition: width 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .progress-pct-badge {
    position: absolute;
    right: -12px;
    top: -26px;
    background: var(--blue-500);
    color: #ffffff;
    font-size: var(--text-micro);
    font-weight: 800;
    padding: 2px 7px;
    border-radius: var(--radius-xs);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
  }

  /* CTA Wrap */
  .campaign-cta-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .campaign-btn-primary {
    padding: 14px 30px;
    font-size: var(--text-small);
    font-weight: 700;
  }

  .heart-svg {
    width: 18px;
    height: 18px;
  }

  .campaign-btn-outline {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    padding: 13px 26px;
    border-radius: var(--radius-full);
    font-size: var(--text-small);
    font-weight: 600;
    text-decoration: none;
    font-family: var(--font-sans);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color     var(--duration-fast) var(--ease-out),
      transform        var(--duration-fast) var(--ease-out);
    will-change: transform;
  }

  .campaign-btn-outline:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-2px);
  }

  .campaign-btn-outline:active {
    transform: translateY(0);
  }

  .arrow-svg {
    width: 15px;
    height: 15px;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .campaign-btn-outline:hover .arrow-svg {
    transform: translateX(4px);
  }

  /* Right Media */
  .campaign-media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xl);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: var(--shadow-dark);
  }

  .campaign-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    min-height: 480px;
  }

  .campaign-media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--navy-900) 0%, rgba(15, 23, 42, 0.25) 50%, transparent 100%);
  }

  .campaign-floating-badge {
    position: absolute;
    bottom: var(--space-6);
    right: var(--space-6);
    background: rgba(6, 24, 41, 0.88);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 14px 20px;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-dark);
  }

  .badge-num {
    font-size: 1.15rem;
    font-weight: 800;
    color: #38bdf8;
    display: block;
    line-height: 1.1;
    font-family: var(--font-display);
  }

  .badge-sub {
    font-size: var(--text-micro);
    color: #cbd5e1;
    font-weight: 500;
  }

  @media (max-width: 1024px) {
    .campaign-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .campaign-content {
      padding: 0;
    }
    .campaign-media {
      max-height: 360px;
    }
    .campaign-img {
      min-height: 320px;
    }
  }

  @media (max-width: 640px) {
    .featured-campaign-section {
      padding: var(--section-padding-y-sm) 0;
    }
    .featured-campaign-container {
      padding: 0 var(--space-5);
    }
  }
</style>
