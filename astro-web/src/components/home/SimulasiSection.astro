---
// src/components/home/SimulasiSection.astro
// Simulasi wakaf, struktur mengikuti halaman isavo.co.id/simulasi-renovasi:
// kolom kiri = panel form (pilih program + rincian), kolom kanan = ringkasan sticky.

const programs = [
  {
    id: 'lahan',
    label: 'Pembebasan Lahan',
    hint: 'Rp 150.000 / m²',
    desc: 'Lahan kawasan masjid & sekolah di Sukasirna, Jonggol. Disertifikatkan sebagai tanah wakaf.',
    unit: 'm²',
    qtyLabel: 'Luas lahan',
    options: [
      { label: 'Lahan Kawasan Masjid & Sekolah', price: 150000, desc: 'Harga per meter persegi, sudah termasuk biaya pengurusan akta ikrar wakaf.' },
    ],
    presets: [1, 3, 5, 10],
  },
  {
    id: 'material',
    label: 'Material Konstruksi',
    hint: 'Mulai Rp 75.000',
    desc: 'Material untuk pembangunan Masjid Khairu Ummah, dibelanjakan sesuai RAB proyek.',
    unit: 'paket',
    qtyLabel: 'Jumlah paket',
    options: [
      { label: 'Semen 50 kg', price: 75000, desc: '1 sak, untuk pengecoran kolom dan plester dinding.' },
      { label: 'Bata Ringan ½ m³', price: 250000, desc: 'Setara ±41 buah bata ringan 10 cm untuk dinding.' },
      { label: 'Granit 60×60', price: 500000, desc: '5 dus, penutup lantai ruang salat utama.' },
      { label: 'Rangka Atap Baja Ringan', price: 1000000, desc: 'Satu bentang rangka C75 beserta reng.' },
    ],
    presets: [1, 2, 5, 10],
  },
  {
    id: 'tunai',
    label: 'Wakaf Uang',
    hint: 'Nominal bebas',
    desc: 'Dialokasikan ke kebutuhan paling mendesak: sanitasi, wudhu, dan operasional sekolah.',
    unit: '',
    qtyLabel: '',
    options: [
      { label: 'Rp 50.000', price: 50000, desc: '' },
      { label: 'Rp 100.000', price: 100000, desc: '' },
      { label: 'Rp 250.000', price: 250000, desc: '' },
      { label: 'Rp 500.000', price: 500000, desc: '' },
    ],
    presets: [],
  },
];

const rupiah = (n: number) => 'Rp ' + n.toLocaleString('id-ID');
---

<section class="gvf-section sim-section" id="simulasi">
  <div class="gvf-container">
    <header class="sim-header reveal-on-scroll">
      <h2 class="sim-title">Simulasi Wakaf</h2>
      <p class="sim-subtitle">
        Pilih program dan jumlahnya, lalu lihat rincian nilai wakaf Anda.
        Seluruh dana tercatat dan dilaporkan terbuka kepada wakif.
      </p>
    </header>

    <div class="sim-grid">
      <!-- Kolom kiri: form -->
      <div class="sim-form reveal-on-scroll delay-100">
        <div class="sim-block">
          <h3 class="sim-block-title">Pilih program</h3>
          <div class="sim-options sim-options--program" role="radiogroup" aria-label="Program wakaf">
            {programs.map((p, i) => (
              <label class:list={['sim-option', { active: i === 0 }]} data-program={p.id}>
                <input type="radio" name="sim-program" value={p.id} checked={i === 0} />
                <span class="sim-option-label">{p.label}</span>
                <span class="sim-option-price">{p.hint}</span>
                <span class="sim-option-desc">{p.desc}</span>
              </label>
            ))}
          </div>
        </div>

        <div class="sim-block">
          {programs.map((p, i) => (
            <div class="sim-panel" data-panel={p.id} hidden={i !== 0}>
              {p.options.length > 1 && (
                <div class="sim-group">
                  <h4 class="sim-group-name">{p.id === 'tunai' ? 'Nominal' : 'Jenis material'}</h4>
                  <div class:list={['sim-options', { 'sim-options--compact': p.id === 'tunai' }]}>
                    {p.options.map((o, j) => (
                      <label class:list={['sim-option', { active: (p.id === 'tunai' ? j === 1 : j === 0) }]}>
                        <input
                          type="radio"
                          name={`sim-opt-${p.id}`}
                          value={j}
                          data-price={o.price}
                          data-label={o.label}
                          checked={p.id === 'tunai' ? j === 1 : j === 0}
                        />
                        <span class="sim-option-label">{o.label}</span>
                        {p.id !== 'tunai' && <span class="sim-option-price">{rupiah(o.price)}</span>}
                        {o.desc && <span class="sim-option-desc">{o.desc}</span>}
                      </label>
                    ))}
                  </div>
                </div>
              )}

              {p.options.length === 1 && (
                <input type="hidden" name={`sim-opt-${p.id}`} value="0" data-price={p.options[0].price} data-label={p.options[0].label} />
              )}

              {p.id === 'tunai' ? (
                <div class="sim-group">
                  <h4 class="sim-group-name">Atau tulis nominal sendiri</h4>
                  <div class="sim-field">
                    <span class="sim-field-prefix">Rp</span>
                    <input
                      type="number"
                      inputmode="numeric"
                      class="sim-input"
                      id="sim-custom-tunai"
                      min="10000"
                      step="10000"
                      placeholder="300000"
                    />
                  </div>
                  <p class="sim-note">Minimal Rp 10.000.</p>
                </div>
              ) : (
                <div class="sim-group">
                  <h4 class="sim-group-name">{p.qtyLabel}</h4>
                  <div class="sim-qty-row">
                    <div class="sim-stepper">
                      <button type="button" class="sim-step" data-step="-1" aria-label="Kurangi">−</button>
                      <input
                        type="number"
                        inputmode="numeric"
                        class="sim-input sim-qty"
                        data-qty={p.id}
                        id={`sim-qty-${p.id}`}
                        min="1"
                        max="1000"
                        value="1"
                        aria-label={p.qtyLabel}
                      />
                      <span class="sim-qty-unit">{p.unit}</span>
                      <button type="button" class="sim-step" data-step="1" aria-label="Tambah">+</button>
                    </div>
                    <div class="sim-presets">
                      {p.presets.map((n) => (
                        <button type="button" class="sim-preset" data-preset={n}>{n} {p.unit}</button>
                      ))}
                    </div>
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- Kolom kanan: ringkasan -->
      <aside class="sim-summary reveal-on-scroll delay-200" aria-live="polite">
        <h3 class="sim-summary-title">Ringkasan</h3>

        <dl class="sim-list">
          <div><dt>Program</dt><dd id="sum-program">Pembebasan Lahan</dd></div>
          <div><dt>Item</dt><dd id="sum-item">Lahan Kawasan Masjid &amp; Sekolah</dd></div>
          <div id="sum-row-qty">
            <dt>Jumlah</dt>
            <dd><span id="sum-qty">1 m²</span> × <span id="sum-price">Rp 150.000</span></dd>
          </div>
        </dl>

        <div class="sim-total">
          <span class="sim-total-label">Total wakaf</span>
          <span class="sim-total-value" id="sum-total">Rp 150.000</span>
        </div>

        <a
          id="sim-wa"
          class="sim-btn sim-btn--primary"
          href="https://wa.me/6281226832326"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35zM12.04 21.5h-.01a9.47 9.47 0 0 1-4.83-1.32l-.35-.21-3.59.94.96-3.5-.23-.36a9.46 9.46 0 0 1-1.45-5.05c0-5.23 4.26-9.49 9.5-9.49 2.54 0 4.92.99 6.71 2.79a9.43 9.43 0 0 1 2.78 6.71c0 5.24-4.26 9.49-9.49 9.49zm8.08-17.57A11.35 11.35 0 0 0 12.04.5C5.74.5.62 5.62.62 11.92c0 2.01.53 3.98 1.53 5.71L.52 23.5l6.01-1.58a11.4 11.4 0 0 0 5.5 1.4h.01c6.3 0 11.42-5.12 11.42-11.42 0-3.05-1.19-5.92-3.34-8.07z"/>
          </svg>
          Kirim ke Admin via WhatsApp
        </a>
        <a
          class="sim-btn sim-btn--ghost"
          href="https://velora-id.myscalev.com/p/wakaf-pembangunan-garden-mosque-khoiru-ummah"
          target="_blank"
          rel="noopener noreferrer"
        >
          Langsung bayar (QRIS / VA)
        </a>

        <p class="sim-disclaimer">
          Lokasi proyek: Sukasirna, Jonggol, Bogor. Angka di atas adalah simulasi. Setelah dana
          diterima, admin mengirimkan bukti penerimaan dan laporan penggunaan dana secara berkala
          ke nomor WhatsApp Anda.
        </p>
      </aside>
    </div>
  </div>
</section>

<style>
  .sim-section {
    background-color: var(--gvf-surface-50);
  }

  .sim-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 2.75rem;
  }

  .sim-title {
    font-size: clamp(1.875rem, 3vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--gvf-text-heading);
    margin-bottom: 0.75rem;
  }

  .sim-subtitle {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--gvf-text-muted);
    text-wrap: balance;
  }

  .sim-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 1.5rem;
    align-items: start;
    max-width: 1080px;
    margin: 0 auto;
  }

  /* Panel form: satu kartu, langkah dipisah jarak + garis tipis */
  .sim-form,
  .sim-summary {
    background: var(--gvf-white);
    border: 1px solid var(--gvf-surface-200);
    border-radius: var(--gvf-radius-lg);
    padding: 2rem;
  }

  .sim-block + .sim-block {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--gvf-surface-100);
  }

  .sim-block-title,
  .sim-group-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--gvf-text-heading);
    margin-bottom: 0.875rem;
  }

  .sim-group + .sim-group {
    margin-top: 1.75rem;
  }

  /* Opsi: baris penuh — radio | nama + deskripsi | harga */
  .sim-options {
    display: grid;
    gap: 0.625rem;
  }

  .sim-option {
    position: relative;
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr) auto;
    grid-template-areas:
      'radio label price'
      '.     desc  desc';
    column-gap: 0.875rem;
    row-gap: 0.25rem;
    align-items: start;
    padding: 1rem 1.125rem;
    border: 1px solid var(--gvf-surface-200);
    border-radius: var(--gvf-radius-md);
    background: var(--gvf-white);
    cursor: pointer;
    transition:
      border-color var(--gvf-transition-fast),
      background-color var(--gvf-transition-fast),
      box-shadow var(--gvf-transition-fast);
  }

  .sim-option:hover {
    border-color: var(--gvf-surface-300);
  }

  .sim-option.active {
    border-color: var(--gvf-blue-vibrant);
    background: var(--gvf-blue-ice);
    box-shadow: 0 0 0 1px var(--gvf-blue-vibrant);
  }

  .sim-option:has(input:focus-visible) {
    outline: 2px solid var(--gvf-blue-vibrant);
    outline-offset: 2px;
  }

  /* Radio kustom agar tampil sama di semua browser */
  .sim-option input[type='radio'] {
    grid-area: radio;
    appearance: none;
    -webkit-appearance: none;
    width: 20px;
    height: 20px;
    margin: 1px 0 0;
    border: 1.5px solid var(--gvf-surface-300);
    border-radius: 50%;
    background: var(--gvf-white);
    cursor: pointer;
    transition: border-color var(--gvf-transition-fast), box-shadow var(--gvf-transition-fast);
  }

  .sim-option input[type='radio']:checked {
    border-color: var(--gvf-blue-vibrant);
    background: var(--gvf-blue-vibrant);
    box-shadow: inset 0 0 0 4px var(--gvf-white);
  }

  .sim-option-label {
    grid-area: label;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--gvf-text-heading);
  }

  .sim-option-price {
    grid-area: price;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--gvf-text-heading);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    text-align: right;
  }

  .sim-option-desc {
    grid-area: desc;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--gvf-text-muted);
  }

  /* Nominal wakaf uang: chip ringkas tanpa lingkaran radio */
  .sim-options--compact {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .sim-options--compact .sim-option {
    display: flex;
    justify-content: center;
    padding: 0.875rem 0.5rem;
  }

  .sim-options--compact .sim-option input[type='radio'] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
  }

  .sim-options--compact .sim-option-label {
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }

  /* Input jumlah — stepper dan preset sama tinggi (48px) */
  .sim-qty-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .sim-stepper {
    display: inline-flex;
    align-items: center;
    height: 48px;
    border: 1px solid var(--gvf-surface-200);
    border-radius: var(--gvf-radius-md);
    background: var(--gvf-white);
    overflow: hidden;
  }

  .sim-step {
    width: 48px;
    height: 100%;
    border: none;
    background: var(--gvf-white);
    font-family: inherit;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--gvf-text-heading);
    cursor: pointer;
    transition: background-color var(--gvf-transition-fast);
  }

  .sim-step:first-child {
    border-right: 1px solid var(--gvf-surface-200);
  }

  .sim-step:last-child {
    border-left: 1px solid var(--gvf-surface-200);
  }

  .sim-step:hover {
    background: var(--gvf-surface-50);
  }

  .sim-step:focus-visible {
    outline: 2px solid var(--gvf-blue-vibrant);
    outline-offset: -2px;
  }

  .sim-input {
    font-family: inherit;
    font-size: 1rem;
    color: var(--gvf-text-heading);
    border: none;
    outline: none;
    background: transparent;
  }

  .sim-qty {
    width: 56px;
    height: 100%;
    text-align: right;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    -moz-appearance: textfield;
  }

  .sim-qty::-webkit-outer-spin-button,
  .sim-qty::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .sim-qty-unit {
    padding: 0 0.875rem 0 0.375rem;
    font-size: 0.9375rem;
    color: var(--gvf-text-muted);
  }

  .sim-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .sim-preset {
    height: 48px;
    padding: 0 1.125rem;
    font-family: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--gvf-text-body);
    background: var(--gvf-white);
    border: 1px solid var(--gvf-surface-200);
    border-radius: var(--gvf-radius-md);
    cursor: pointer;
    transition:
      border-color var(--gvf-transition-fast),
      color var(--gvf-transition-fast),
      background-color var(--gvf-transition-fast);
  }

  .sim-preset:hover {
    border-color: var(--gvf-surface-300);
  }

  .sim-preset.active {
    border-color: var(--gvf-blue-vibrant);
    color: var(--gvf-blue-vibrant);
    background: var(--gvf-blue-ice);
    box-shadow: 0 0 0 1px var(--gvf-blue-vibrant);
  }

  .sim-preset:focus-visible {
    outline: 2px solid var(--gvf-blue-vibrant);
    outline-offset: 2px;
  }

  .sim-field {
    display: flex;
    align-items: center;
    max-width: 320px;
    height: 48px;
    border: 1px solid var(--gvf-surface-200);
    border-radius: var(--gvf-radius-md);
    background: var(--gvf-white);
    overflow: hidden;
    transition: border-color var(--gvf-transition-fast), box-shadow var(--gvf-transition-fast);
  }

  .sim-field:focus-within {
    border-color: var(--gvf-blue-vibrant);
    box-shadow: 0 0 0 1px var(--gvf-blue-vibrant);
  }

  .sim-field-prefix {
    display: flex;
    align-items: center;
    height: 100%;
    padding: 0 0.875rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--gvf-text-muted);
    background: var(--gvf-surface-50);
    border-right: 1px solid var(--gvf-surface-200);
  }

  .sim-field .sim-input {
    flex: 1;
    height: 100%;
    padding: 0 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .sim-note {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--gvf-text-muted);
  }

  /* Ringkasan */
  .sim-summary {
    position: sticky;
    top: 100px;
  }

  .sim-summary-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--gvf-text-heading);
    margin-bottom: 1rem;
  }

  .sim-list {
    margin: 0;
    border-top: 1px solid var(--gvf-surface-100);
  }

  .sim-list > div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.25rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--gvf-surface-100);
  }

  .sim-list > div[hidden] {
    display: none;
  }

  .sim-list dt {
    flex-shrink: 0;
    font-size: 0.9375rem;
    color: var(--gvf-text-muted);
  }

  .sim-list dd {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--gvf-text-heading);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .sim-total {
    display: grid;
    gap: 0.25rem;
    padding: 1.5rem 0;
  }

  .sim-total-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--gvf-text-muted);
  }

  .sim-total-value {
    font-size: clamp(1.875rem, 2.6vw, 2.25rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--gvf-text-heading);
    font-variant-numeric: tabular-nums;
  }

  .sim-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    height: 52px;
    padding: 0 1rem;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--gvf-radius-md);
    transition:
      background-color var(--gvf-transition-fast),
      border-color var(--gvf-transition-fast);
  }

  .sim-btn:focus-visible {
    outline: 2px solid var(--gvf-blue-vibrant);
    outline-offset: 2px;
  }

  .sim-btn--primary {
    background: var(--gvf-blue-vibrant);
    color: var(--gvf-white);
  }

  .sim-btn--primary:hover {
    background: var(--gvf-blue-hover);
  }

  .sim-btn--ghost {
    margin-top: 0.625rem;
    color: var(--gvf-text-heading);
    border: 1px solid var(--gvf-surface-200);
  }

  .sim-btn--ghost:hover {
    border-color: var(--gvf-surface-300);
    background: var(--gvf-surface-50);
  }

  .sim-disclaimer {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--gvf-text-muted);
  }

  @media (max-width: 1024px) {
    .sim-grid {
      grid-template-columns: 1fr;
    }
    .sim-summary {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .sim-form,
    .sim-summary {
      padding: 1.25rem;
    }
    .sim-option {
      grid-template-columns: 20px minmax(0, 1fr);
      grid-template-areas:
        'radio label'
        '.     price'
        '.     desc';
    }
    .sim-option-price {
      text-align: left;
    }
    .sim-options--compact {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .sim-preset {
      padding: 0 0.875rem;
    }
  }
</style>

<script>
  const root = document.getElementById('simulasi');

  if (root) {
    const fmt = (n: number) => 'Rp ' + n.toLocaleString('id-ID');
    const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel);

    const programNames: Record<string, string> = {
      lahan: 'Pembebasan Lahan',
      material: 'Material Konstruksi',
      tunai: 'Wakaf Uang',
    };
    const units: Record<string, string> = { lahan: 'm²', material: 'paket', tunai: '' };

    const sum = {
      program: $('#sum-program'),
      item: $('#sum-item'),
      price: $('#sum-price'),
      qty: $('#sum-qty'),
      rowPrice: $('#sum-row-price'),
      rowQty: $('#sum-row-qty'),
      total: $('#sum-total'),
      wa: $<HTMLAnchorElement>('#sim-wa'),
    };

    const customTunai = $<HTMLInputElement>('#sim-custom-tunai');

    const currentProgram = () =>
      root.querySelector<HTMLInputElement>('input[name="sim-program"]:checked')?.value ?? 'lahan';

    const selectedOption = (pid: string) =>
      root.querySelector<HTMLInputElement>(
        `input[name="sim-opt-${pid}"]:checked, input[type="hidden"][name="sim-opt-${pid}"]`
      );

    const qtyOf = (pid: string) => {
      const el = root.querySelector<HTMLInputElement>(`[data-qty="${pid}"]`);
      const n = parseInt(el?.value ?? '1', 10);
      return Number.isFinite(n) && n > 0 ? n : 1;
    };

    function syncActive(group: Element | null) {
      group?.querySelectorAll('.sim-option').forEach((opt) => {
        const input = opt.querySelector('input');
        opt.classList.toggle('active', !!input?.checked);
      });
    }

    function syncPresets(pid: string) {
      const panel = root.querySelector(`[data-panel="${pid}"]`);
      const q = qtyOf(pid);
      panel?.querySelectorAll<HTMLButtonElement>('.sim-preset').forEach((b) => {
        b.classList.toggle('active', Number(b.dataset.preset) === q);
      });
    }

    function render() {
      const pid = currentProgram();
      const opt = selectedOption(pid);
      let price = Number(opt?.dataset.price ?? 0);
      let item = opt?.dataset.label ?? '-';
      let qty = 1;

      if (pid === 'tunai') {
        const custom = parseInt(customTunai?.value ?? '', 10);
        if (Number.isFinite(custom) && custom >= 10000) {
          price = custom;
          item = 'Nominal pilihan sendiri';
        }
      } else {
        qty = qtyOf(pid);
        syncPresets(pid);
      }

      const total = price * qty;
      const isTunai = pid === 'tunai';

      if (sum.program) sum.program.textContent = programNames[pid];
      if (sum.item) sum.item.textContent = item;
      if (sum.price) sum.price.textContent = fmt(price);
      if (sum.qty) sum.qty.textContent = `${qty} ${units[pid]}`;
      if (sum.rowPrice) sum.rowPrice.hidden = isTunai;
      if (sum.rowQty) sum.rowQty.hidden = isTunai;
      if (sum.total) sum.total.textContent = fmt(total);

      if (sum.wa) {
        const lines = [
          'Assalamualaikum Admin GVF,',
          'saya ingin menunaikan wakaf dengan rincian berikut:',
          `- Program: ${programNames[pid]}`,
          `- Item: ${item}`,
          ...(isTunai ? [] : [`- Jumlah: ${qty} ${units[pid]} x ${fmt(price)}`]),
          `- Total: ${fmt(total)}`,
          '',
          'Mohon info rekening / cara pembayarannya.',
        ];
        sum.wa.href = `https://wa.me/6281226832326?text=${encodeURIComponent(lines.join('\n'))}`;
      }
    }

    // Ganti program
    root.querySelectorAll<HTMLInputElement>('input[name="sim-program"]').forEach((r) => {
      r.addEventListener('change', () => {
        syncActive(root.querySelector('.sim-options--program'));
        root.querySelectorAll<HTMLElement>('.sim-panel').forEach((p) => {
          p.hidden = p.dataset.panel !== r.value;
        });
        render();
      });
    });

    // Opsi di dalam panel
    root.querySelectorAll<HTMLInputElement>('.sim-panel input[type="radio"]').forEach((r) => {
      r.addEventListener('change', () => {
        syncActive(r.closest('.sim-options'));
        if (r.name === 'sim-opt-tunai' && customTunai) customTunai.value = '';
        render();
      });
    });

    // Stepper & preset
    root.querySelectorAll<HTMLElement>('.sim-panel').forEach((panel) => {
      const input = panel.querySelector<HTMLInputElement>('.sim-qty');
      if (!input) return;

      panel.querySelectorAll<HTMLButtonElement>('.sim-step').forEach((btn) => {
        btn.addEventListener('click', () => {
          const next = Math.min(1000, Math.max(1, (parseInt(input.value, 10) || 1) + Number(btn.dataset.step)));
          input.value = String(next);
          render();
        });
      });

      panel.querySelectorAll<HTMLButtonElement>('.sim-preset').forEach((btn) => {
        btn.addEventListener('click', () => {
          input.value = btn.dataset.preset ?? '1';
          render();
        });
      });

      input.addEventListener('input', render);
    });

    // Nominal bebas
    customTunai?.addEventListener('input', () => {
      const v = parseInt(customTunai.value, 10);
      const group = root.querySelector('[data-panel="tunai"] .sim-options');
      if (Number.isFinite(v) && v >= 10000) {
        group?.querySelectorAll<HTMLInputElement>('input').forEach((i) => (i.checked = false));
        syncActive(group);
      }
      render();
    });

    render();
  }
</script>
