---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getPageBySlug, getAllPageSections } from '../../../lib/db';
import SectionEditorModal from '../../../components/admin/pages/SectionEditorModal.astro';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/admin');
}

// Find page safely with fallback
const currentPage = await getPageBySlug(slug);
if (!currentPage) {
  return Astro.redirect('/admin');
}

// Find all sections for this page safely
const sections = await getAllPageSections(slug);

function getPublicUrl(slugStr: string) {
  if (slugStr === 'home') return '/';
  if (slugStr === 'pembangunan-masjid' || slugStr === 'gota-ssm') return `/program/${slugStr}`;
  if (['wakaf', 'infaq', 'sedekah', 'zakat'].includes(slugStr)) return `/kontribusi/${slugStr}`;
  return `/${slugStr}`;
}

const publicPageUrl = getPublicUrl(slug);
---

<AdminLayout title={`Kelola Section: ${currentPage.title}`} activeSlug={slug}>
  <div class="space-y-6">
    <!-- Top Action & Navigation Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <a
            href="/admin"
            class="text-xs font-semibold text-slate-500 hover:text-[#0969da] flex items-center gap-1 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m15 18-6-6 6-6"/>
            </svg>
            <span>Semua Halaman</span>
          </a>
          <span class="text-slate-300">/</span>
          <span class="text-xs font-medium text-[#0969da]">{currentPage.title}</span>
        </div>
        <h2 class="text-xl font-bold text-slate-900 tracking-tight">{currentPage.title}</h2>
        <p class="text-xs text-slate-500 mt-0.5">
          {sections.length} Bagian tersedia &bull; {sections.filter((s) => s.isEnabled).length} Sedang ditampilkan di web
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href={publicPageUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold text-white bg-[#0969da] hover:bg-[#0752a8] rounded-xl transition-all shadow-xs"
        >
          <span>Lihat Halaman Langsung</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" x2="21" y1="14" y2="3"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Instructions Banner -->
    <div class="bg-blue-50/60 border border-blue-200/80 rounded-2xl p-4 text-xs text-blue-900 flex items-start gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600 shrink-0 mt-0.5">
        <circle cx="12" cy="12" r="10"/>
        <path d="M12 16v-4"/>
        <path d="M12 8h.01"/>
      </svg>
      <div>
        <p class="font-semibold text-blue-950">Panduan Pengelolaan Konten Halaman:</p>
        <p class="mt-0.5 text-blue-800">
          Gunakan tombol <strong>Tampilkan</strong> di kanan kartu untuk menampilkan atau menyembunyikan bagian pada halaman publik.
          Klik <strong>"Ubah Teks &amp; Konten"</strong> untuk mengganti judul, tulisan, foto, atau tujuan tombol dengan formulir visual yang mudah digunakan.
        </p>
      </div>
    </div>

    <!-- Section Cards List (Grid 2 Kolom) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4" id="sectionsListContainer">
      {sections.map((section, idx) => {
        const contentJson = JSON.stringify(section.content, null, 2);
        const headingPreview = (section.content as any)?.heading || (section.content as any)?.title || '';
        const badgePreview = (section.content as any)?.badge || '';
        const subheadingPreview = (section.content as any)?.subheading || (section.content as any)?.desc || (section.content as any)?.paragraph1 || '';

        return (
          <div
            class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs transition-all hover:border-slate-300 hover:shadow-sm relative flex flex-col justify-between"
            id={`section-card-${section.id}`}
            data-section-id={section.id}
          >
            <!-- Top Section Info & Preview -->
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2 flex-wrap">
                <div class="flex items-center gap-2">
                  <span class="w-6 h-6 rounded-md bg-slate-100 text-slate-700 font-bold text-xs flex items-center justify-center">
                    {section.sortOrder || idx + 1}
                  </span>
                  <span class="text-[11px] font-semibold text-slate-500">
                    Bagian #{section.sortOrder || idx + 1}
                  </span>
                </div>
                <span
                  id={`status-badge-${section.id}`}
                  class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold ${
                    section.isEnabled
                      ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                      : 'bg-slate-100 text-slate-500 border border-slate-200'
                  }`}
                >
                  <span class={`w-1.5 h-1.5 rounded-full ${section.isEnabled ? 'bg-emerald-500' : 'bg-slate-400'}`}></span>
                  <span id={`status-text-${section.id}`}>{section.isEnabled ? 'Aktif (Tampil)' : 'Nonaktif (Sembunyi)'}</span>
                </span>
              </div>

              <div>
                <h3 class="font-bold text-slate-900 text-sm md:text-base flex items-center gap-2">
                  <span id={`title-display-${section.id}`}>{section.title}</span>
                </h3>
                {section.sectionKey === 'hero' && Array.isArray((section.content as any)?.slides) ? (
                  <div class="mt-2.5 space-y-2 bg-blue-50/50 border border-blue-200/60 rounded-xl p-3">
                    <div class="flex items-center justify-between">
                      <span class="text-[11px] font-bold text-[#0969da] uppercase tracking-wider font-mono">
                        Carousel: {((section.content as any).slides as any[]).length} Slide Aktif
                      </span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                      {((section.content as any).slides as any[]).map((slide: any, sIdx: number) => (
                        <div class="flex items-center gap-2 text-xs text-slate-700 bg-white border border-slate-200 rounded-lg px-2.5 py-1.5 shadow-2xs">
                          <span class="w-5 h-5 rounded-md bg-blue-50 text-[#0969da] font-mono font-bold text-[11px] flex items-center justify-center shrink-0 border border-blue-200">
                            {sIdx + 1}
                          </span>
                          <span class="font-semibold text-slate-800 truncate" title={slide.label || slide.badge}>
                            {slide.label || slide.badge}
                          </span>
                        </div>
                      ))}
                    </div>
                  </div>
                ) : section.sectionKey === 'prog_pricing' && Array.isArray((section.content as any)?.packages) ? (
                  <div class="mt-2.5 space-y-2 bg-blue-50/50 border border-blue-200/60 rounded-xl p-3">
                    <div class="flex items-center justify-between">
                      <span class="text-[11px] font-bold text-[#0969da] uppercase tracking-wider font-mono">
                        Pilihan Paket: {((section.content as any).packages as any[]).length} Paket Terdaftar
                      </span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                      {((section.content as any).packages as any[]).map((pkg: any, pIdx: number) => (
                        <div class="flex items-center gap-2 text-xs text-slate-700 bg-white border border-slate-200 rounded-lg px-2.5 py-1.5 shadow-2xs">
                          <span class="w-5 h-5 rounded-md bg-blue-50 text-[#0969da] font-mono font-bold text-[11px] flex items-center justify-center shrink-0 border border-blue-200">
                            {pIdx + 1}
                          </span>
                          <div class="min-w-0 flex-1 truncate">
                            <span class="font-semibold text-slate-800">{pkg.title}</span>
                            <span class="text-[11px] text-slate-500 font-mono ml-1">({pkg.pricePrefix || ''}{pkg.priceAmount})</span>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                ) : section.sectionKey === 'prog_details' ? (
                  <div class="mt-2.5 space-y-2 bg-slate-50 border border-slate-200/80 rounded-xl p-3">
                    <div class="flex items-center justify-between">
                      <span class="text-[11px] font-bold text-slate-700 uppercase tracking-wider">
                        Dokumentasi: {Array.isArray((section.content as any)?.portfolioShowcaseItems) ? (section.content as any).portfolioShowcaseItems.length : 4} Foto Lapangan &bull; 2 Foto Utama
                      </span>
                    </div>
                    {headingPreview && (
                      <p class="text-xs font-semibold text-slate-800 line-clamp-1">
                        {headingPreview}
                      </p>
                    )}
                    {(section.content as any)?.imageUrl && (
                      <div class="flex items-center gap-2.5 p-1.5 bg-white border border-slate-200 rounded-lg">
                        <div class="w-20 aspect-video rounded-lg bg-slate-100 overflow-hidden shrink-0 border border-slate-200 flex items-center justify-center">
                          <img src={(section.content as any).imageUrl} alt="Banner" class="w-full h-full object-contain" loading="lazy" />
                        </div>
                        <div class="min-w-0 flex-1">
                          <span class="text-[11px] font-semibold text-[#0969da] block">Foto Banner Utama</span>
                          <p class="text-[11px] text-slate-500 mt-0.5 mb-0">Tersimpan dan siap ditampilkan</p>
                        </div>
                      </div>
                    )}
                  </div>
                ) : section.sectionKey === 'prog_faq' && Array.isArray((section.content as any)?.faqs) ? (
                  <div class="mt-2.5 space-y-2 bg-slate-50 border border-slate-200/80 rounded-xl p-3">
                    <div class="flex items-center justify-between">
                      <span class="text-[11px] font-bold text-[#0969da] uppercase tracking-wider font-mono">
                        Tanya Jawab: {((section.content as any).faqs as any[]).length} Butir Pertanyaan
                      </span>
                    </div>
                    <div class="space-y-1.5">
                      {((section.content as any).faqs as any[]).slice(0, 2).map((faq: any, fIdx: number) => (
                        <div class="text-xs text-slate-700 bg-white border border-slate-200 rounded-lg px-2.5 py-1.5 shadow-2xs truncate">
                          <span class="font-bold text-slate-900 mr-1.5">Q{fIdx + 1}:</span>
                          <span>{faq.question}</span>
                        </div>
                      ))}
                      {((section.content as any).faqs as any[]).length > 2 && (
                        <p class="text-[10px] text-slate-500 italic text-right">+ {((section.content as any).faqs as any[]).length - 2} pertanyaan lainnya</p>
                      )}
                    </div>
                  </div>
                ) : section.sectionKey === 'news_section' ? (
                  <div class="mt-2.5 space-y-2.5 bg-blue-50/40 border border-blue-200/70 rounded-xl p-3.5">
                    <div class="flex items-center justify-between">
                      <span class="text-[11px] font-bold text-[#0969da] uppercase tracking-wider font-mono flex items-center gap-1.5">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/>
                          <path d="M18 14h-8"/>
                          <path d="M15 18h-5"/>
                          <path d="M10 6h8v4h-8V6Z"/>
                        </svg>
                        <span>Seksi Kabar &amp; Catatan Edukasi</span>
                      </span>
                      <a
                        href="/admin/kabar"
                        class="inline-flex items-center gap-1 text-[11px] font-bold text-[#0969da] hover:text-[#0752a8] bg-white px-2.5 py-1 rounded-lg border border-blue-200 shadow-2xs hover:bg-blue-50 transition-colors"
                      >
                        <span>Kelola Artikel &amp; Foto Warta</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M7 17L17 7"/>
                          <path d="M7 7h10v10"/>
                        </svg>
                      </a>
                    </div>

                    <div>
                      {badgePreview && (
                        <span class="inline-block text-[10px] font-bold text-blue-600 uppercase tracking-wider">
                          Badge: {badgePreview}
                        </span>
                      )}
                      {headingPreview && (
                        <p class="text-xs font-semibold text-slate-800 mt-0.5 line-clamp-2">
                          Judul Seksi: &ldquo;{headingPreview}&rdquo;
                        </p>
                      )}
                      {subheadingPreview && (
                        <p class="text-xs text-slate-600 mt-1 line-clamp-2 leading-relaxed">
                          Pengantar: {subheadingPreview}
                        </p>
                      )}
                    </div>

                      <div class="pt-2 border-t border-blue-200/50 flex items-center justify-between text-[11px] text-slate-500">
                      <span>Artikel &amp; foto warta dikelola dari menu Kabar &amp; Laporan.</span>
                      <span class="font-semibold text-slate-700">Terhubung Otomatis</span>
                    </div>
                  </div>
                ) : section.sectionKey === 'masjid_progress' ? (
                  <div class="mt-2.5 space-y-2 bg-blue-50/50 border border-blue-200/60 rounded-xl p-3">
                    <div class="flex items-center justify-between">
                      <span class="text-[11px] font-bold text-[#0969da] uppercase tracking-wider font-mono">
                        Target: {(section.content as any)?.targetLabel || 'Rp 1.310.753.350'}
                      </span>
                      <span class="text-[11px] font-mono text-slate-600">
                        {Array.isArray((section.content as any)?.milestones) ? (section.content as any).milestones.length : 0} Milestone
                      </span>
                    </div>
                    <p class="text-[11px] text-slate-600">
                      Dana terhimpun dihitung otomatis dari database donasi terverifikasi.
                    </p>
                  </div>
                ) : section.sectionKey === 'gota_schemes' && Array.isArray((section.content as any)?.schemes) ? (
                  <div class="mt-2.5 space-y-2 bg-blue-50/50 border border-blue-200/60 rounded-xl p-3">
                    <div class="flex items-center justify-between">
                      <span class="text-[11px] font-bold text-[#0969da] uppercase tracking-wider font-mono">
                        Skema Orang Tua Asuh: {((section.content as any).schemes as any[]).length} Skema
                      </span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                      {((section.content as any).schemes as any[]).map((sch: any, sIdx: number) => (
                        <div class="flex items-center gap-2 text-xs text-slate-700 bg-white border border-slate-200 rounded-lg px-2.5 py-1.5 shadow-2xs">
                          <span class="w-5 h-5 rounded-md bg-blue-50 text-[#0969da] font-mono font-bold text-[11px] flex items-center justify-center shrink-0 border border-blue-200">
                            {sIdx + 1}
                          </span>
                          <div class="min-w-0 flex-1 truncate">
                            <span class="font-semibold text-slate-800">{sch.title}</span>
                            <span class="text-[11px] text-slate-500 font-mono ml-1">({sch.amount})</span>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                ) : (
                  <div>
                    {badgePreview && (
                      <span class="inline-block text-[10px] font-bold text-blue-600 uppercase tracking-wider mt-1">
                        Badge: {badgePreview}
                      </span>
                    )}
                    {headingPreview && (
                      <p class="text-xs font-semibold text-slate-700 mt-1 line-clamp-2">
                        Heading: &ldquo;{headingPreview}&rdquo;
                      </p>
                    )}
                    {subheadingPreview && (
                      <p class="text-xs text-slate-500 mt-1 line-clamp-2">
                        Deskripsi: {subheadingPreview}
                      </p>
                    )}
                    {(section.content as any)?.imageUrl && (
                      <div class="mt-2.5 flex items-center gap-3 p-2 bg-slate-50 border border-slate-200 rounded-xl">
                        <div class="w-24 aspect-video rounded-lg bg-slate-200 overflow-hidden shrink-0 border border-slate-300 flex items-center justify-center">
                          <img
                            src={(section.content as any).imageUrl}
                            alt={section.title}
                            class="w-full h-full object-contain"
                            loading="lazy"
                          />
                        </div>
                        <div class="min-w-0 flex-1">
                          <span class="text-[11px] font-bold text-[#0969da] block">Foto Terpasang</span>
                          <p class="text-[11px] text-slate-500 mt-0.5 mb-0">
                            Klik Ubah Teks &amp; Konten untuk mengganti foto ini
                          </p>
                        </div>
                      </div>
                    )}
                  </div>
                )}
              </div>
            </div>

            <!-- Bottom Actions: Toggle Switch & Edit Button -->
            <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between gap-3">
              <!-- Toggle Switch -->
              <div class="flex items-center gap-2.5 bg-slate-50 px-3 py-1.5 rounded-xl border border-slate-200/80">
                <label for={`toggle-${section.id}`} class="text-xs font-semibold text-slate-700 cursor-pointer select-none">
                  Tampilkan
                </label>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input
                    type="checkbox"
                    id={`toggle-${section.id}`}
                    class="sr-only peer section-toggle-checkbox"
                    data-section-id={section.id}
                    checked={section.isEnabled}
                  />
                  <div class="w-10 h-5.5 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4.5 after:w-4.5 after:transition-all peer-checked:bg-[#0969da]"></div>
                </label>
              </div>

              <!-- Edit Button -->
              <button
                type="button"
                class="edit-section-btn inline-flex items-center gap-1.5 px-3.5 py-2 bg-white hover:bg-slate-50 text-slate-700 hover:text-[#0969da] border border-slate-300 hover:border-[#0969da]/60 rounded-xl text-xs font-semibold transition-all shadow-2xs cursor-pointer"
                data-section-id={section.id}
                data-section-title={section.title}
                data-section-key={section.sectionKey}
                data-section-order={section.sortOrder}
                data-section-content={contentJson}
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 20h9"/>
                  <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>
                </svg>
                <span>Ubah Teks &amp; Konten</span>
              </button>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Edit Section Slide-Over Drawer Subcomponent -->
  <SectionEditorModal />

  <script src="../../../scripts/admin/page-editor.ts"></script>
</AdminLayout>
