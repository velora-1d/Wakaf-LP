---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getPageBySlug, getAllPageSections } from '../../../lib/db';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/admin');
}

// Find page safely with fallback
const currentPage = await getPageBySlug(slug);
if (!currentPage) {
  return Astro.redirect('/admin');
}

// Find all sections for this page safely
const sections = await getAllPageSections(slug);

function getPublicUrl(slugStr: string) {
  if (slugStr === 'home') return '/';
  if (['wakaf', 'infaq', 'sedekah', 'zakat'].includes(slugStr)) return `/program/${slugStr}`;
  return `/${slugStr}`;
}

const publicPageUrl = getPublicUrl(slug);
---

<AdminLayout title={`Kelola Section: ${currentPage.title}`} activeSlug={slug}>
  <div class="space-y-6">
    <!-- Top Action & Navigation Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <a
            href="/admin"
            class="text-xs font-semibold text-slate-500 hover:text-[#0969da] flex items-center gap-1 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m15 18-6-6 6-6"/>
            </svg>
            <span>Semua Halaman</span>
          </a>
          <span class="text-slate-300">/</span>
          <span class="text-xs font-mono text-[#0969da] bg-blue-50 px-2 py-0.5 rounded font-medium">/{slug === 'home' ? '' : slug}</span>
        </div>
        <h2 class="text-xl font-bold text-slate-900 tracking-tight">{currentPage.title}</h2>
        <p class="text-xs text-slate-500 mt-0.5">
          {sections.length} Section terdaftar &bull; {sections.filter((s) => s.isEnabled).length} Sedang aktif ditampilkan
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href={publicPageUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold text-white bg-[#0969da] hover:bg-[#0752a8] rounded-xl transition-all shadow-xs"
        >
          <span>Lihat Halaman Langsung</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" x2="21" y1="14" y2="3"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Instructions Banner -->
    <div class="bg-blue-50/60 border border-blue-200/80 rounded-2xl p-4 text-xs text-blue-900 flex items-start gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600 shrink-0 mt-0.5">
        <circle cx="12" cy="12" r="10"/>
        <path d="M12 16v-4"/>
        <path d="M12 8h.01"/>
      </svg>
      <div>
        <p class="font-semibold text-blue-950">Cara Kerja Section Dinamis:</p>
        <p class="mt-0.5 text-blue-800">
          Gunakan toggle switch di kanan kartu untuk <strong>menampilkan atau menyembunyikan (on/off)</strong> section secara instan.
          Klik tombol <strong>"Edit Teks & Konten"</strong> untuk memperbarui judul, narasi, link, atau data JSON section tersebut.
        </p>
      </div>
    </div>

    <!-- Section Cards List (Grid 2 Kolom) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4" id="sectionsListContainer">
      {sections.map((section, idx) => {
        const contentJson = JSON.stringify(section.content, null, 2);
        const headingPreview = (section.content as any)?.heading || (section.content as any)?.title || '';
        const badgePreview = (section.content as any)?.badge || '';
        const subheadingPreview = (section.content as any)?.subheading || (section.content as any)?.desc || (section.content as any)?.paragraph1 || '';

        return (
          <div
            class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs transition-all hover:border-slate-300 hover:shadow-sm relative flex flex-col justify-between"
            id={`section-card-${section.id}`}
            data-section-id={section.id}
          >
            <!-- Top Section Info & Preview -->
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2 flex-wrap">
                <div class="flex items-center gap-2">
                  <span class="w-6 h-6 rounded-md bg-slate-100 text-slate-700 font-mono font-bold text-xs flex items-center justify-center">
                    {section.sortOrder || idx + 1}
                  </span>
                  <span class="font-mono text-xs font-semibold px-2 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200/60">
                    {section.sectionKey}
                  </span>
                </div>
                <span
                  id={`status-badge-${section.id}`}
                  class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold ${
                    section.isEnabled
                      ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                      : 'bg-slate-100 text-slate-500 border border-slate-200'
                  }`}
                >
                  <span class={`w-1.5 h-1.5 rounded-full ${section.isEnabled ? 'bg-emerald-500' : 'bg-slate-400'}`}></span>
                  <span id={`status-text-${section.id}`}>{section.isEnabled ? 'Aktif (Tampil)' : 'Nonaktif (Sembunyi)'}</span>
                </span>
              </div>

              <div>
                <h3 class="font-bold text-slate-900 text-sm md:text-base flex items-center gap-2">
                  <span id={`title-display-${section.id}`}>{section.title}</span>
                </h3>
                {badgePreview && (
                  <span class="inline-block text-[10px] font-bold text-blue-600 uppercase tracking-wider mt-1">
                    Badge: {badgePreview}
                  </span>
                )}
                {headingPreview && (
                  <p class="text-xs font-semibold text-slate-700 mt-1 line-clamp-2">
                    Heading: &ldquo;{headingPreview}&rdquo;
                  </p>
                )}
                {subheadingPreview && (
                  <p class="text-xs text-slate-500 mt-1 line-clamp-2">
                    Deskripsi: {subheadingPreview}
                  </p>
                )}
              </div>
            </div>

            <!-- Bottom Actions: Toggle Switch & Edit Button -->
            <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between gap-3">
              <!-- Toggle Switch -->
              <div class="flex items-center gap-2.5 bg-slate-50 px-3 py-1.5 rounded-xl border border-slate-200/80">
                <label for={`toggle-${section.id}`} class="text-xs font-semibold text-slate-700 cursor-pointer select-none">
                  Tampilkan
                </label>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input
                    type="checkbox"
                    id={`toggle-${section.id}`}
                    class="sr-only peer section-toggle-checkbox"
                    data-section-id={section.id}
                    checked={section.isEnabled}
                  />
                  <div class="w-10 h-5.5 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4.5 after:w-4.5 after:transition-all peer-checked:bg-[#0969da]"></div>
                </label>
              </div>

              <!-- Edit Button -->
              <button
                type="button"
                class="edit-section-btn inline-flex items-center gap-1.5 px-3.5 py-2 bg-white hover:bg-slate-50 text-slate-700 hover:text-[#0969da] border border-slate-300 hover:border-[#0969da]/60 rounded-xl text-xs font-semibold transition-all shadow-2xs cursor-pointer"
                data-section-id={section.id}
                data-section-title={section.title}
                data-section-key={section.sectionKey}
                data-section-order={section.sortOrder}
                data-section-content={contentJson}
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 20h9"/>
                  <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>
                </svg>
                <span>Edit Teks & Konten</span>
              </button>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Edit Section Slide-Over Drawer dari Kanan (Lebar 70% Layar) -->
  <div
    id="editModal"
    class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs flex justify-end items-stretch opacity-0 pointer-events-none transition-opacity duration-200"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modalTitle"
  >
    <div class="bg-white rounded-l-2xl w-full sm:w-[70vw] sm:max-w-[70vw] h-full flex flex-col shadow-2xl border-l border-slate-200 transform translate-x-full transition-transform duration-300 ease-out overflow-hidden" id="modalBox">
      <!-- Modal Header -->
      <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between bg-slate-50/60">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-blue-50 border border-blue-200 text-[#0969da] flex items-center justify-center font-bold text-xs shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9"/>
              <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>
            </svg>
          </div>
          <div>
            <h3 id="modalTitle" class="text-sm font-bold text-slate-900">Edit Konten Section</h3>
            <p id="modalSubtitle" class="text-[11px] text-slate-500 font-mono mt-0.5"></p>
          </div>
        </div>

        <button
          type="button"
          id="closeModalBtn"
          class="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-200/60 transition-colors"
          aria-label="Tutup modal"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <!-- Tab Navigation (Form Visual vs JSON) -->
      <div class="px-6 pt-3 border-b border-slate-200 flex items-center justify-between bg-white">
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="tabVisualBtn"
            class="px-3.5 py-2 text-xs font-semibold border-b-2 border-[#0969da] text-[#0969da] flex items-center gap-1.5 transition-colors cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="18" x="3" y="3" rx="2"/>
              <path d="M3 9h18"/>
              <path d="M9 21V9"/>
            </svg>
            <span>Formulir Visual (Mudah Digunakan)</span>
          </button>

          <button
            type="button"
            id="tabJsonBtn"
            class="px-3.5 py-2 text-xs font-medium border-b-2 border-transparent text-slate-500 hover:text-slate-900 flex items-center gap-1.5 transition-colors cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"/>
              <polyline points="8 6 2 12 8 18"/>
            </svg>
            <span>Mode Teknis (Data JSON)</span>
          </button>
        </div>
      </div>

      <!-- Modal Body (Form Fields) -->
      <div class="px-6 py-5 overflow-y-auto space-y-5 flex-1 max-h-[calc(92vh-140px)]">
        <input type="hidden" id="editSectionId" />

        <!-- TAB 1: FORM VISUAL (USER FRIENDLY) -->
        <div id="visualFormContainer" class="space-y-4">
          <!-- Section 1: Heading & Badge -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="sm:col-span-2">
              <label for="vfHeading" class="block text-xs font-semibold text-slate-700 mb-1">
                Judul Utama / Heading Section <span class="text-blue-600 font-normal">(Ditampilkan di web)</span>
              </label>
              <input
                type="text"
                id="vfHeading"
                placeholder="Contoh: Membangun Peradaban Melalui Wakaf Berkelanjutan"
                class="w-full bg-slate-50 border border-slate-300 focus:bg-white focus:border-[#0969da] focus:ring-2 focus:ring-[#0969da]/20 rounded-xl px-3.5 py-2 text-xs text-slate-900 outline-none transition-all"
              />
            </div>

            <div>
              <label for="vfBadge" class="block text-xs font-semibold text-slate-700 mb-1">
                Badge / Label Tagline Kecil
              </label>
              <input
                type="text"
                id="vfBadge"
                placeholder="Contoh: YAYASAN FILANTROPI ISLAM"
                class="w-full bg-slate-50 border border-slate-300 focus:bg-white focus:border-[#0969da] focus:ring-2 focus:ring-[#0969da]/20 rounded-xl px-3.5 py-2 text-xs text-slate-900 outline-none transition-all"
              />
            </div>

            <div>
              <label for="vfSubheading" class="block text-xs font-semibold text-slate-700 mb-1">
                Sub-Judul / Tagline Ringkas
              </label>
              <input
                type="text"
                id="vfSubheading"
                placeholder="Ringkasan atau tagline singkat"
                class="w-full bg-slate-50 border border-slate-300 focus:bg-white focus:border-[#0969da] focus:ring-2 focus:ring-[#0969da]/20 rounded-xl px-3.5 py-2 text-xs text-slate-900 outline-none transition-all"
              />
            </div>
          </div>

          <!-- Section 2: Narrative & Paragraphs -->
          <div class="space-y-3">
            <div>
              <label for="vfDesc" class="block text-xs font-semibold text-slate-700 mb-1">
                Deskripsi / Paragraf Utama
              </label>
              <textarea
                id="vfDesc"
                rows="3"
                placeholder="Tuliskan narasi penjelasan lengkap section ini..."
                class="w-full bg-slate-50 border border-slate-300 focus:bg-white focus:border-[#0969da] focus:ring-2 focus:ring-[#0969da]/20 rounded-xl px-3.5 py-2 text-xs text-slate-900 outline-none leading-relaxed transition-all"
              ></textarea>
            </div>

            <div id="vfParagraph2Wrapper">
              <label for="vfParagraph2" class="block text-xs font-semibold text-slate-700 mb-1">
                Paragraf Tambahan <span class="text-slate-400 font-normal">(Opsional)</span>
              </label>
              <textarea
                id="vfParagraph2"
                rows="2"
                placeholder="Paragraf lanjutan jika ada..."
                class="w-full bg-slate-50 border border-slate-300 focus:bg-white focus:border-[#0969da] focus:ring-2 focus:ring-[#0969da]/20 rounded-xl px-3.5 py-2 text-xs text-slate-900 outline-none leading-relaxed transition-all"
              ></textarea>
            </div>
          </div>

          <!-- Section 3: Call to Action (Buttons) -->
          <div class="p-3.5 rounded-xl border border-slate-200 bg-slate-50/50 space-y-3">
            <span class="text-[11px] font-bold text-slate-700 uppercase tracking-wider block">
              Tombol Aksi (Call To Action / Link)
            </span>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="vfPrimaryCtaText" class="block text-[11px] font-semibold text-slate-600 mb-1">
                  Teks Tombol Utama
                </label>
                <input
                  type="text"
                  id="vfPrimaryCtaText"
                  placeholder="Misal: Salurkan Wakaf"
                  class="w-full bg-white border border-slate-300 focus:border-[#0969da] rounded-lg px-3 py-1.5 text-xs text-slate-900 outline-none"
                />
              </div>
              <div>
                <label for="vfPrimaryCtaUrl" class="block text-[11px] font-semibold text-slate-600 mb-1">
                  Link URL Tombol Utama
                </label>
                <input
                  type="text"
                  id="vfPrimaryCtaUrl"
                  placeholder="Misal: /program/wakaf atau #donasi"
                  class="w-full bg-white border border-slate-300 focus:border-[#0969da] rounded-lg px-3 py-1.5 text-xs text-slate-900 outline-none font-mono"
                />
              </div>

              <div>
                <label for="vfSecondaryCtaText" class="block text-[11px] font-semibold text-slate-600 mb-1">
                  Teks Tombol Sekunder (Opsional)
                </label>
                <input
                  type="text"
                  id="vfSecondaryCtaText"
                  placeholder="Misal: Jelajahi Ekosistem"
                  class="w-full bg-white border border-slate-300 focus:border-[#0969da] rounded-lg px-3 py-1.5 text-xs text-slate-900 outline-none"
                />
              </div>
              <div>
                <label for="vfSecondaryCtaUrl" class="block text-[11px] font-semibold text-slate-600 mb-1">
                  Link URL Tombol Sekunder
                </label>
                <input
                  type="text"
                  id="vfSecondaryCtaUrl"
                  placeholder="Misal: #ekosistem atau /tentang-kami"
                  class="w-full bg-white border border-slate-300 focus:border-[#0969da] rounded-lg px-3 py-1.5 text-xs text-slate-900 outline-none font-mono"
                />
              </div>
            </div>
          </div>

          <!-- Section 4: Media & Image Link -->
          <div>
            <label for="vfImageUrl" class="block text-xs font-semibold text-slate-700 mb-1">
              URL Gambar / Media Banner <span class="text-slate-400 font-normal">(Opsional)</span>
            </label>
            <input
              type="text"
              id="vfImageUrl"
              placeholder="/images/... atau https://..."
              class="w-full bg-slate-50 border border-slate-300 focus:bg-white focus:border-[#0969da] focus:ring-2 focus:ring-[#0969da]/20 rounded-xl px-3.5 py-2 text-xs text-slate-900 outline-none font-mono transition-all"
            />
          </div>

          <!-- Section 5: Meta Info (Internal Title & Order) -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 border-t border-slate-200">
            <div class="sm:col-span-2">
              <label for="editTitle" class="block text-xs font-semibold text-slate-700 mb-1">
                Label Internal Section (Admin)
              </label>
              <input
                type="text"
                id="editTitle"
                class="w-full bg-slate-50 border border-slate-300 focus:bg-white focus:border-[#0969da] rounded-xl px-3 py-2 text-xs text-slate-900 outline-none"
              />
            </div>
            <div>
              <label for="editSortOrder" class="block text-xs font-semibold text-slate-700 mb-1">
                Nomor Urutan
              </label>
              <input
                type="number"
                id="editSortOrder"
                class="w-full bg-slate-50 border border-slate-300 focus:bg-white focus:border-[#0969da] rounded-xl px-3 py-2 text-xs text-slate-900 outline-none"
              />
            </div>
          </div>
        </div>

        <!-- TAB 2: MODE LANJUTAN (JSON) -->
        <div id="jsonFormContainer" class="space-y-2 hidden">
          <div class="flex items-center justify-between mb-1.5">
            <label for="editJsonContent" class="block text-xs font-semibold text-slate-700">
              Struktur JSON Mentah
            </label>
            <span class="text-[11px] text-slate-500 font-normal">Sinkron otomatis dengan Form Visual</span>
          </div>
          <div class="relative">
            <textarea
              id="editJsonContent"
              rows="14"
              class="w-full font-mono text-xs bg-slate-900 text-slate-100 border border-slate-800 rounded-xl p-3.5 focus:border-[#0969da] focus:ring-2 focus:ring-[#0969da]/30 outline-none leading-relaxed"
              spellcheck="false"
            ></textarea>
          </div>
          <p id="jsonError" class="text-xs text-red-600 mt-1 hidden"></p>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="px-6 py-4 border-t border-slate-200 bg-slate-50 flex items-center justify-between gap-3">
        <p class="text-[11px] text-slate-500 hidden sm:block">Perubahan akan langsung aktif di web publik setelah disimpan.</p>
        <div class="flex items-center gap-2.5 ml-auto">
          <button
            type="button"
            id="cancelModalBtn"
            class="px-4 py-2 rounded-xl border border-slate-300 text-xs font-medium text-slate-700 hover:bg-slate-100 transition-colors cursor-pointer"
          >
            Batal
          </button>
          <button
            type="button"
            id="saveSectionBtn"
            class="px-5 py-2 rounded-xl bg-[#0969da] hover:bg-[#0752a8] text-white text-xs font-semibold flex items-center gap-2 shadow-xs transition-colors cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
              <polyline points="17 21 17 13 7 13 7 21"/>
              <polyline points="7 3 7 8 15 8"/>
            </svg>
            <span id="saveBtnText">Simpan Perubahan</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    function initSectionEditor() {
      // 1. Checkbox Toggle Visibility Logic
      const toggleCheckboxes = document.querySelectorAll('.section-toggle-checkbox');
      toggleCheckboxes.forEach((checkbox) => {
        checkbox.addEventListener('change', async (e) => {
          const target = e.target as HTMLInputElement;
          const sectionId = target.dataset.sectionId;
          const isEnabled = target.checked;

          // UI Optimistic Feedback
          const statusBadge = document.getElementById(`status-badge-${sectionId}`);
          const statusText = document.getElementById(`status-text-${sectionId}`);
          if (statusBadge && statusText) {
            if (isEnabled) {
              statusBadge.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200';
              statusText.textContent = 'Aktif (Tampil)';
            } else {
              statusBadge.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-500 border border-slate-200';
              statusText.textContent = 'Nonaktif (Sembunyi)';
            }
          }

          try {
            const res = await fetch('/api/admin/sections/toggle', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ sectionId, isEnabled }),
            });
            const data = await res.json();
            if (data.success) {
              (window as any).showToast(isEnabled ? 'Bagian diaktifkan di web publik.' : 'Bagian disembunyikan dari web publik.');
            } else {
              target.checked = !isEnabled; // Revert
              (window as any).showToast(data.error || 'Gagal mengubah visibilitas bagian.', true);
            }
          } catch (err) {
            target.checked = !isEnabled; // Revert
            (window as any).showToast('Gagal menghubungi server.', true);
          }
        });
      });

      // 2. Edit Modal Logic (Visual Form + Bidirectional JSON Sync)
      const editModal = document.getElementById('editModal');
      const modalBox = document.getElementById('modalBox');
      const closeModalBtn = document.getElementById('closeModalBtn');
      const cancelModalBtn = document.getElementById('cancelModalBtn');
      const saveSectionBtn = document.getElementById('saveSectionBtn');
      const saveBtnText = document.getElementById('saveBtnText');
      const jsonError = document.getElementById('jsonError');

      const editSectionId = document.getElementById('editSectionId') as HTMLInputElement;
      const editTitle = document.getElementById('editTitle') as HTMLInputElement;
      const editSortOrder = document.getElementById('editSortOrder') as HTMLInputElement;
      const editJsonContent = document.getElementById('editJsonContent') as HTMLTextAreaElement;
      const modalSubtitle = document.getElementById('modalSubtitle');

      // Visual Form Inputs
      const vfHeading = document.getElementById('vfHeading') as HTMLInputElement;
      const vfBadge = document.getElementById('vfBadge') as HTMLInputElement;
      const vfSubheading = document.getElementById('vfSubheading') as HTMLInputElement;
      const vfDesc = document.getElementById('vfDesc') as HTMLTextAreaElement;
      const vfParagraph2 = document.getElementById('vfParagraph2') as HTMLTextAreaElement;
      const vfPrimaryCtaText = document.getElementById('vfPrimaryCtaText') as HTMLInputElement;
      const vfPrimaryCtaUrl = document.getElementById('vfPrimaryCtaUrl') as HTMLInputElement;
      const vfSecondaryCtaText = document.getElementById('vfSecondaryCtaText') as HTMLInputElement;
      const vfSecondaryCtaUrl = document.getElementById('vfSecondaryCtaUrl') as HTMLInputElement;
      const vfImageUrl = document.getElementById('vfImageUrl') as HTMLInputElement;

      // Tabs
      const tabVisualBtn = document.getElementById('tabVisualBtn');
      const tabJsonBtn = document.getElementById('tabJsonBtn');
      const visualFormContainer = document.getElementById('visualFormContainer');
      const jsonFormContainer = document.getElementById('jsonFormContainer');

      let currentContentObj: any = {};

      function switchTab(toVisual: boolean) {
        if (toVisual) {
          tabVisualBtn?.classList.add('border-[#0969da]', 'text-[#0969da]', 'font-semibold');
          tabVisualBtn?.classList.remove('border-transparent', 'text-slate-500', 'font-medium');
          tabJsonBtn?.classList.remove('border-[#0969da]', 'text-[#0969da]', 'font-semibold');
          tabJsonBtn?.classList.add('border-transparent', 'text-slate-500', 'font-medium');
          visualFormContainer?.classList.remove('hidden');
          jsonFormContainer?.classList.add('hidden');
        } else {
          syncVisualToJson();
          tabJsonBtn?.classList.add('border-[#0969da]', 'text-[#0969da]', 'font-semibold');
          tabJsonBtn?.classList.remove('border-transparent', 'text-slate-500', 'font-medium');
          tabVisualBtn?.classList.remove('border-[#0969da]', 'text-[#0969da]', 'font-semibold');
          tabVisualBtn?.classList.add('border-transparent', 'text-slate-500', 'font-medium');
          jsonFormContainer?.classList.remove('hidden');
          visualFormContainer?.classList.add('hidden');
        }
      }

      tabVisualBtn?.addEventListener('click', () => switchTab(true));
      tabJsonBtn?.addEventListener('click', () => switchTab(false));

      function syncVisualToJson() {
        if (!currentContentObj || typeof currentContentObj !== 'object') currentContentObj = {};

        if (vfHeading?.value !== undefined) {
          if ('heading' in currentContentObj || !('title' in currentContentObj)) {
            currentContentObj.heading = vfHeading.value;
          } else {
            currentContentObj.title = vfHeading.value;
          }
        }
        if (vfBadge?.value !== undefined) currentContentObj.badge = vfBadge.value;
        if (vfSubheading?.value !== undefined) currentContentObj.subheading = vfSubheading.value;
        if (vfDesc?.value !== undefined) {
          if ('paragraph1' in currentContentObj) currentContentObj.paragraph1 = vfDesc.value;
          else if ('desc' in currentContentObj) currentContentObj.desc = vfDesc.value;
          else currentContentObj.description = vfDesc.value;
        }
        if (vfParagraph2?.value !== undefined && ('paragraph2' in currentContentObj || vfParagraph2.value)) {
          currentContentObj.paragraph2 = vfParagraph2.value;
        }
        if (vfPrimaryCtaText?.value !== undefined) {
          if ('ctaText' in currentContentObj) currentContentObj.ctaText = vfPrimaryCtaText.value;
          else currentContentObj.primaryCtaText = vfPrimaryCtaText.value;
        }
        if (vfPrimaryCtaUrl?.value !== undefined) {
          if ('ctaUrl' in currentContentObj) currentContentObj.ctaUrl = vfPrimaryCtaUrl.value;
          else currentContentObj.primaryCtaUrl = vfPrimaryCtaUrl.value;
        }
        if (vfSecondaryCtaText?.value !== undefined) currentContentObj.secondaryCtaText = vfSecondaryCtaText.value;
        if (vfSecondaryCtaUrl?.value !== undefined) currentContentObj.secondaryCtaUrl = vfSecondaryCtaUrl.value;
        if (vfImageUrl?.value !== undefined) {
          if ('videoUrl' in currentContentObj) currentContentObj.videoUrl = vfImageUrl.value;
          else currentContentObj.imageUrl = vfImageUrl.value;
        }

        if (editJsonContent) {
          editJsonContent.value = JSON.stringify(currentContentObj, null, 2);
        }
      }

      // Attach sync listener to all visual inputs
      [vfHeading, vfBadge, vfSubheading, vfDesc, vfParagraph2, vfPrimaryCtaText, vfPrimaryCtaUrl, vfSecondaryCtaText, vfSecondaryCtaUrl, vfImageUrl].forEach((input) => {
        input?.addEventListener('input', syncVisualToJson);
      });

      // When editing raw JSON, sync back to visual
      editJsonContent?.addEventListener('input', () => {
        try {
          currentContentObj = JSON.parse(editJsonContent.value);
          if (vfHeading) vfHeading.value = currentContentObj.heading || currentContentObj.title || '';
          if (vfBadge) vfBadge.value = currentContentObj.badge || '';
          if (vfSubheading) vfSubheading.value = currentContentObj.subheading || '';
          if (vfDesc) vfDesc.value = currentContentObj.desc || currentContentObj.paragraph1 || currentContentObj.description || '';
          if (vfParagraph2) vfParagraph2.value = currentContentObj.paragraph2 || '';
          if (vfPrimaryCtaText) vfPrimaryCtaText.value = currentContentObj.primaryCtaText || currentContentObj.ctaText || '';
          if (vfPrimaryCtaUrl) vfPrimaryCtaUrl.value = currentContentObj.primaryCtaUrl || currentContentObj.ctaUrl || '';
          if (vfSecondaryCtaText) vfSecondaryCtaText.value = currentContentObj.secondaryCtaText || '';
          if (vfSecondaryCtaUrl) vfSecondaryCtaUrl.value = currentContentObj.secondaryCtaUrl || '';
          if (vfImageUrl) vfImageUrl.value = currentContentObj.imageUrl || currentContentObj.mediaUrl || currentContentObj.videoUrl || '';
          if (jsonError) {
            jsonError.textContent = '';
            jsonError.classList.add('hidden');
          }
        } catch (err: any) {
          if (jsonError) {
            jsonError.textContent = `Peringatan format JSON: ${err.message}`;
            jsonError.classList.remove('hidden');
          }
        }
      });

      function openModal() {
        if (editModal && modalBox) {
          switchTab(true); // Always default to Visual Form!
          editModal.classList.remove('opacity-0', 'pointer-events-none');
          modalBox.classList.remove('translate-x-full');
          modalBox.classList.add('translate-x-0');
        }
      }

      function closeModal() {
        if (editModal && modalBox) {
          modalBox.classList.remove('translate-x-0');
          modalBox.classList.add('translate-x-full');
          setTimeout(() => {
            editModal.classList.add('opacity-0', 'pointer-events-none');
          }, 200);
        }
      }

      closeModalBtn?.addEventListener('click', closeModal);
      cancelModalBtn?.addEventListener('click', closeModal);
      editModal?.addEventListener('click', (e) => {
        if (e.target === editModal) closeModal();
      });

      // Close modal on Escape key press
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && editModal && !editModal.classList.contains('pointer-events-none')) {
          closeModal();
        }
      });

      // Open Edit Modal on Button Click
      const editBtns = document.querySelectorAll('.edit-section-btn');
      editBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-section-id') || '';
          const title = btn.getAttribute('data-section-title') || '';
          const key = btn.getAttribute('data-section-key') || '';
          const order = btn.getAttribute('data-section-order') || '1';
          const contentStr = btn.getAttribute('data-section-content') || '{}';

          try {
            currentContentObj = JSON.parse(contentStr);
          } catch {
            currentContentObj = {};
          }

          if (editSectionId) editSectionId.value = id;
          if (editTitle) editTitle.value = title;
          if (editSortOrder) editSortOrder.value = order;
          if (modalSubtitle) modalSubtitle.textContent = `Kunci Bagian: ${key} (ID #${id})`;

          // Populate Visual Inputs
          if (vfHeading) vfHeading.value = currentContentObj.heading || currentContentObj.title || '';
          if (vfBadge) vfBadge.value = currentContentObj.badge || '';
          if (vfSubheading) vfSubheading.value = currentContentObj.subheading || '';
          if (vfDesc) vfDesc.value = currentContentObj.desc || currentContentObj.paragraph1 || currentContentObj.description || '';
          if (vfParagraph2) vfParagraph2.value = currentContentObj.paragraph2 || '';
          if (vfPrimaryCtaText) vfPrimaryCtaText.value = currentContentObj.primaryCtaText || currentContentObj.ctaText || '';
          if (vfPrimaryCtaUrl) vfPrimaryCtaUrl.value = currentContentObj.primaryCtaUrl || currentContentObj.ctaUrl || '';
          if (vfSecondaryCtaText) vfSecondaryCtaText.value = currentContentObj.secondaryCtaText || '';
          if (vfSecondaryCtaUrl) vfSecondaryCtaUrl.value = currentContentObj.secondaryCtaUrl || '';
          if (vfImageUrl) vfImageUrl.value = currentContentObj.imageUrl || currentContentObj.mediaUrl || currentContentObj.videoUrl || '';

          // Populate JSON textarea
          if (editJsonContent) editJsonContent.value = JSON.stringify(currentContentObj, null, 2);

          if (jsonError) {
            jsonError.textContent = '';
            jsonError.classList.add('hidden');
          }

          openModal();
        });
      });

      // Save Section Content
      saveSectionBtn?.addEventListener('click', async () => {
        // Sync latest visual inputs to content object
        syncVisualToJson();

        let parsedContent: any = currentContentObj;
        try {
          parsedContent = JSON.parse(editJsonContent.value);
        } catch (e: any) {
          if (jsonError) {
            jsonError.textContent = `Format JSON tidak valid: ${e.message}`;
            jsonError.classList.remove('hidden');
          }
          switchTab(false); // Switch to JSON tab to see error
          return;
        }

        if (saveBtnText) saveBtnText.textContent = 'Menyimpan...';
        if (saveSectionBtn) (saveSectionBtn as HTMLButtonElement).disabled = true;

        const payload = {
          sectionId: Number(editSectionId.value),
          title: editTitle.value,
          sortOrder: Number(editSortOrder.value),
          content: parsedContent,
        };

        try {
          const res = await fetch('/api/admin/sections/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (data.success) {
            (window as any).showToast('Perubahan teks & konten berhasil disimpan ke PostgreSQL.');
            // Update display title on card
            const titleDisplay = document.getElementById(`title-display-${payload.sectionId}`);
            if (titleDisplay) titleDisplay.textContent = payload.title;

            // Update trigger data attributes
            const activeBtn = document.querySelector(`.edit-section-btn[data-section-id="${payload.sectionId}"]`);
            if (activeBtn) {
              activeBtn.setAttribute('data-section-title', payload.title);
              activeBtn.setAttribute('data-section-order', String(payload.sortOrder));
              activeBtn.setAttribute('data-section-content', JSON.stringify(payload.content, null, 2));
            }

            closeModal();
          } else {
            (window as any).showToast(data.error || 'Gagal menyimpan ke database.', true);
          }
        } catch (err) {
          (window as any).showToast('Terjadi kesalahan jaringan.', true);
        } finally {
          if (saveBtnText) saveBtnText.textContent = 'Simpan Perubahan';
          if (saveSectionBtn) (saveSectionBtn as HTMLButtonElement).disabled = false;
        }
      });
    }

    // Initialize on page load
    initSectionEditor();
  </script>
</AdminLayout>
