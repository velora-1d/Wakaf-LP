---
// src/pages/admin/roles/index.astro
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAllRoles, getAllAdminUsers } from '../../../lib/db';
import RoleModal from '../../../components/admin/roles/RoleModal.astro';
import UserModal from '../../../components/admin/roles/UserModal.astro';
import DeleteModal from '../../../components/admin/roles/DeleteModal.astro';

const currentAdmin = (Astro.locals as any).adminUser;
const roles = await getAllRoles();
const adminUsersList = await getAllAdminUsers();

const activeTabParam = Astro.url.searchParams.get('tab');
const isUsersTab = activeTabParam === 'users';

const formatDate = (date: Date | string | null) => {
  if (!date) return '-';
  const d = new Date(date);
  return d.toLocaleDateString('id-ID', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
};

const ALL_MENUS = [
  { key: 'overview', name: 'Ringkasan Dasbor', category: 'Modul Utama', desc: 'Melihat ringkasan metrik statistik penghimpunan' },
  { key: 'donatur', name: 'Donatur & Arus Kas', category: 'Modul Keuangan', desc: 'Kelola data donatur, verifikasi transfer, & buku kas' },
  { key: 'kabar', name: 'Kabar & Warta', category: 'Modul Publikasi', desc: 'Kelola berita kegiatan, artikel, & dokumentasi' },
  { key: 'roles', name: 'Hak Akses & Roles', category: 'Modul Sistem', desc: 'Atur wewenang dan izin menu untuk setiap staf' },
  { key: 'home', name: 'Halaman Beranda', category: 'Editor Landing Page', desc: 'Kelola section & visual halaman utama' },
  { key: 'tentang-kami', name: 'Halaman Tentang Kami', category: 'Editor Landing Page', desc: 'Kelola profil, sejarah, & legalitas GVF' },
  { key: 'kemitraan', name: 'Halaman Kemitraan', category: 'Editor Landing Page', desc: 'Kelola sinergi kemitraan CSR & korporasi' },
  { key: 'contact', name: 'Halaman Kontak', category: 'Editor Landing Page', desc: 'Kelola informasi kontak & saluran resmi' },
  { key: 'wakaf', name: 'Program Wakaf', category: 'Editor Program', desc: 'Kelola konten & live feed program Wakaf' },
  { key: 'infaq', name: 'Program Infaq', category: 'Editor Program', desc: 'Kelola konten & live feed program Infaq' },
  { key: 'sedekah', name: 'Program Sedekah', category: 'Editor Program', desc: 'Kelola konten & live feed program Sedekah' },
  { key: 'zakat', name: 'Program Zakat', category: 'Editor Program', desc: 'Kelola konten & live feed program Zakat' },
];

const roleBadges: Record<string, { bg: string; text: string; border: string }> = {
  superadmin: { bg: 'bg-blue-50', text: 'text-[#0969da]', border: 'border-blue-200' },
  bendahara: { bg: 'bg-emerald-50', text: 'text-emerald-700', border: 'border-emerald-200' },
  editor_konten: { bg: 'bg-sky-50', text: 'text-sky-700', border: 'border-sky-200' },
  staf_lapangan: { bg: 'bg-amber-50', text: 'text-amber-800', border: 'border-amber-200' },
};
---

<AdminLayout title="Manajemen Hak Akses & Roles" activeSlug="roles">
  <div class="w-full space-y-6">
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-blue-50 text-[#0969da] border border-blue-200">
            Sistem Keamanan &amp; Wewenang (RBAC)
          </span>
          <span class="text-slate-300 text-xs">&bull;</span>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            12 Menu Terdaftar
          </span>
        </div>
        <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 m-0">Hak Akses Menu &amp; Pengelolaan Role</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1 mb-0">
          Gunakan centang (checkbox) untuk mengatur menu apa saja yang boleh diakses dan tampil di bilah navigasi admin.
        </p>
      </div>
    </div>

    <!-- Main Tabs Navigation -->
    <div class="flex items-center gap-2 border-b border-slate-200">
      <button
        type="button"
        id="tabBtnRoles"
        class={`tab-btn inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-lg transition-all cursor-pointer ${
          !isUsersTab
            ? 'active border-b-2 border-[#0969da] text-[#0969da] bg-blue-50/50'
            : 'border-b-2 border-transparent text-slate-500 hover:text-slate-800 hover:bg-slate-50'
        }`}
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
        </svg>
        <span>Konfigurasi Per Role ({roles.length} Role)</span>
      </button>

      <button
        type="button"
        id="tabBtnUsers"
        class={`tab-btn inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-lg transition-all cursor-pointer ${
          isUsersTab
            ? 'active border-b-2 border-[#0969da] text-[#0969da] bg-blue-50/50'
            : 'border-b-2 border-transparent text-slate-500 hover:text-slate-800 hover:bg-slate-50'
        }`}
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        <span>Pengguna Admin ({adminUsersList.length} Akun)</span>
      </button>
    </div>

    <!-- TAB 1: ROLES CONFIGURATION WITH CHECKBOX PER MENU -->
    <div id="tabContentRoles" class={isUsersTab ? 'hidden space-y-6' : 'space-y-6'}>
      <div class="grid grid-cols-1 gap-6">
        {roles.map((r) => {
          const badge = roleBadges[r.roleKey] || { bg: 'bg-slate-50', text: 'text-slate-700', border: 'border-slate-200' };
          const perms: string[] = Array.isArray(r.permissions) ? (r.permissions as string[]) : [];
          const isSuper = r.roleKey === 'superadmin';

          return (
            <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-2xs space-y-4" data-role-card={r.roleKey}>
              <!-- Role Header -->
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-100">
                <div class="space-y-1">
                  <div class="flex items-center gap-2.5">
                    <h2 class="text-base font-bold text-slate-900 m-0">{r.roleName}</h2>
                    <span class={`inline-flex px-2 py-0.5 rounded text-[11px] font-bold font-mono border ${badge.bg} ${badge.text} ${badge.border}`}>
                      {r.roleKey}
                    </span>
                  </div>
                  <p class="text-xs text-slate-500 m-0">{r.description || 'Tidak ada deskripsi.'}</p>
                </div>

                <!-- Quick Action Buttons -->
                <div class="flex items-center gap-2 shrink-0">
                  <button
                    type="button"
                    class="btn-select-all h-7 px-2.5 rounded border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 text-xs font-medium transition-colors cursor-pointer"
                    data-target-role={r.roleKey}
                  >
                    Pilih Semua
                  </button>
                  <button
                    type="button"
                    class="btn-deselect-all h-7 px-2.5 rounded border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 text-xs font-medium transition-colors cursor-pointer"
                    data-target-role={r.roleKey}
                  >
                    Hapus Semua
                  </button>
                  <button
                    type="button"
                    class="btn-save-role h-7 px-3 rounded bg-[#0969da] hover:bg-[#0752a8] text-white text-xs font-semibold shadow-2xs transition-colors cursor-pointer flex items-center gap-1.5"
                    data-target-role={r.roleKey}
                  >
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>Simpan Peran</span>
                  </button>
                </div>
              </div>

              <!-- Menu Checkboxes Grid -->
              <div>
                <p class="text-xs font-bold text-slate-600 uppercase tracking-wider mb-3">
                  Centang Menu yang Diizinkan:
                </p>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
                  {ALL_MENUS.map((menu) => {
                    const isChecked = perms.includes(menu.key);
                    return (
                      <label class="flex items-start gap-2.5 p-3 rounded-lg border border-slate-200 bg-slate-50/50 hover:bg-blue-50/40 hover:border-blue-200 transition-colors cursor-pointer select-none">
                        <input
                          type="checkbox"
                          class="role-menu-checkbox h-4 w-4 mt-0.5 rounded border-slate-300 text-[#0969da] focus:ring-1 focus:ring-[#0969da] cursor-pointer shrink-0"
                          data-role={r.roleKey}
                          data-menu={menu.key}
                          checked={isChecked}
                        />
                        <div class="min-w-0">
                          <span class="text-xs font-bold text-slate-800 block leading-tight">{menu.name}</span>
                          <span class="text-[10px] text-[#0969da] font-mono block mt-0.5">{menu.category}</span>
                          <span class="text-[11px] text-slate-400 block mt-1 leading-tight line-clamp-2">{menu.desc}</span>
                        </div>
                      </label>
                    );
                  })}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- TAB 2: PER-USER ACCESS & ROLE ASSIGNMENT -->
    <div id="tabContentUsers" class={isUsersTab ? 'space-y-6' : 'hidden space-y-6'} data-current-user-id={currentAdmin?.id || 0}>
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-2xs space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-100">
          <div>
            <h2 class="text-base font-bold text-slate-900 m-0">Daftar Akun Pengelola Admin GVF</h2>
            <p class="text-xs text-slate-500 mt-1 mb-0">
              Kelola akun staf, username, kata sandi, serta hak akses kustom untuk setiap administrator.
            </p>
          </div>
          <button
            type="button"
            id="btnOpenCreateUser"
            class="h-8 px-3.5 rounded-md bg-[#0969da] hover:bg-[#0752a8] text-white text-xs font-semibold shadow-xs transition-colors cursor-pointer inline-flex items-center gap-1.5 self-start sm:self-auto"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Tambah Pengguna Baru</span>
          </button>
        </div>

        <div class="overflow-x-auto w-full">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 font-semibold">
                <th class="px-4 py-3">ID &amp; USERNAME</th>
                <th class="px-4 py-3">NAMA LENGKAP</th>
                <th class="px-4 py-3">ROLE SAAT INI</th>
                <th class="px-4 py-3">TOTAL MENU DIIZINKAN</th>
                <th class="px-4 py-3">TANGGAL DIBUAT</th>
                <th class="px-4 py-3 text-right">AKSI</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {adminUsersList.map((u) => {
                const uPerms: string[] = Array.isArray(u.permissions) ? (u.permissions as string[]) : [];
                const isSelf = currentAdmin && currentAdmin.id === u.id;
                const badge = roleBadges[u.role] || { bg: 'bg-slate-50', text: 'text-slate-700', border: 'border-slate-200' };

                return (
                  <tr class="hover:bg-slate-50/70 transition-colors">
                    <td class="px-4 py-3 font-mono font-bold text-slate-900">
                      <span class="text-slate-400 font-normal">#{u.id}</span> @{u.username}
                      {isSelf && (
                        <span class="ml-1.5 inline-flex px-1.5 py-0.2 rounded text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                          Anda
                        </span>
                      )}
                    </td>
                    <td class="px-4 py-3 font-semibold text-slate-800">
                      {u.name}
                    </td>
                    <td class="px-4 py-3">
                      <span class={`inline-flex px-2 py-0.5 rounded text-[11px] font-bold font-mono border ${badge.bg} ${badge.text} ${badge.border}`}>
                        {u.role}
                      </span>
                    </td>
                    <td class="px-4 py-3 text-slate-600">
                      <span class="font-bold text-slate-900">{uPerms.length}</span> / {ALL_MENUS.length} menu aktif
                    </td>
                    <td class="px-4 py-3 text-slate-500 whitespace-nowrap">
                      {formatDate(u.createdAt)}
                    </td>
                    <td class="px-4 py-3 text-right">
                      <div class="inline-flex items-center gap-1.5 justify-end">
                        <button
                          type="button"
                          class="btn-edit-user-account h-7 px-2.5 rounded border border-blue-200 bg-blue-50/70 hover:bg-[#0969da] text-[#0969da] hover:text-white text-xs font-semibold shadow-2xs transition-colors cursor-pointer inline-flex items-center gap-1"
                          data-user-id={u.id}
                          data-user-username={u.username}
                          data-user-name={u.name}
                          data-user-role={u.role}
                          title="Edit Akun, Username &amp; Password"
                        >
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                            <path d="m15 5 4 4"/>
                          </svg>
                          <span>Edit</span>
                        </button>

                        <button
                          type="button"
                          class="btn-edit-user-perms h-7 px-2.5 rounded border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold shadow-2xs transition-colors cursor-pointer inline-flex items-center gap-1"
                          data-user-id={u.id}
                          data-user-name={u.name}
                          data-user-role={u.role}
                          data-user-perms={JSON.stringify(uPerms)}
                          title="Atur Menu &amp; Hak Akses Khusus"
                        >
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
                          </svg>
                          <span>Menu</span>
                        </button>

                        {!isSelf && u.username !== 'admin' && (
                          <button
                            type="button"
                            class="btn-delete-user h-7 w-7 rounded border border-red-200 bg-red-50 hover:bg-red-600 text-red-600 hover:text-white shadow-2xs transition-colors cursor-pointer inline-flex items-center justify-center"
                            data-user-id={u.id}
                            data-user-username={u.username}
                            title="Hapus Akun Pengguna"
                          >
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M3 6h18"/>
                              <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                              <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                            </svg>
                          </button>
                        )}
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- MODALS & DRAWERS -->
  <RoleModal roles={roles} menus={ALL_MENUS} />
  <UserModal roles={roles} />
  <DeleteModal />
</AdminLayout>

<script src="../../../scripts/admin/roles.ts"></script>
