---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../lib/db';
import { pages, pageSections } from '../../lib/db/schema';
import { eq, sql } from 'drizzle-orm';

// Fetch all pages and section stats
const allPages = await db.select().from(pages).orderBy(pages.id);
const allSections = await db.select().from(pageSections).orderBy(pageSections.sortOrder);

const totalPagesCount = allPages.length;
const totalSectionsCount = allSections.length;
const activeSectionsCount = allSections.filter((s) => s.isEnabled).length;
const disabledSectionsCount = totalSectionsCount - activeSectionsCount;

// Group sections by page
const sectionsByPage = allSections.reduce((acc, sec) => {
  if (!acc[sec.pageSlug]) acc[sec.pageSlug] = [];
  acc[sec.pageSlug].push(sec);
  return acc;
}, {} as Record<string, typeof allSections>);

function getPublicUrl(slug: string) {
  if (slug === 'home') return '/';
  if (['wakaf', 'infaq', 'sedekah', 'zakat'].includes(slug)) return `/program/${slug}`;
  return `/${slug}`;
}
---

<AdminLayout title="Dashboard Overview">
  <div class="space-y-8">
    <!-- Page Header Banner -->
    <div class="bg-gradient-to-r from-[#0b1120] to-[#162238] rounded-2xl p-6 text-white border border-slate-800 shadow-sm relative overflow-hidden">
      <div class="relative z-10 max-w-2xl">
        <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-semibold tracking-wider uppercase bg-[#0969da]/30 text-blue-300 border border-[#0969da]/40 mb-3">
          SISTEM KONTEN DINAMIS GVF
        </span>
        <h2 class="text-xl md:text-2xl font-bold tracking-tight">Pusat Kendali Section & Halaman Web</h2>
        <p class="text-slate-300 text-xs md:text-sm mt-1.5 leading-relaxed">
          Kelola kemunculan (checkbox on/off), urutan, dan isi teks serta gambar seluruh section di website Global Village Fund secara realtime tanpa build ulang.
        </p>
      </div>
      <!-- Subtle Decorative SVG -->
      <div class="absolute -right-6 -bottom-8 opacity-10 pointer-events-none">
        <svg xmlns="http://www.w3.org/2000/svg" width="220" height="220" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect width="18" height="18" x="3" y="3" rx="2"/>
          <path d="M3 9h18"/>
          <path d="M9 21V9"/>
        </svg>
      </div>
    </div>

    <!-- Metric Stats Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs">
        <div class="flex items-center justify-between text-slate-500 mb-2">
          <span class="text-xs font-semibold uppercase tracking-wider">Total Halaman</span>
          <div class="w-8 h-8 rounded-lg bg-blue-50 text-[#0969da] flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
              <polyline points="14 2 14 8 20 8"/>
            </svg>
          </div>
        </div>
        <p class="text-2xl font-bold text-slate-900">{totalPagesCount}</p>
        <p class="text-xs text-slate-500 mt-1">Halaman web terdaftar</p>
      </div>

      <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs">
        <div class="flex items-center justify-between text-slate-500 mb-2">
          <span class="text-xs font-semibold uppercase tracking-wider">Total Section</span>
          <div class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="7" height="9" x="3" y="3" rx="1"/>
              <rect width="7" height="5" x="14" y="3" rx="1"/>
              <rect width="7" height="9" x="14" y="12" rx="1"/>
              <rect width="7" height="5" x="3" y="16" rx="1"/>
            </svg>
          </div>
        </div>
        <p class="text-2xl font-bold text-slate-900">{totalSectionsCount}</p>
        <p class="text-xs text-slate-500 mt-1">Komponen section modular</p>
      </div>

      <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs">
        <div class="flex items-center justify-between text-slate-500 mb-2">
          <span class="text-xs font-semibold uppercase tracking-wider">Section Aktif</span>
          <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </div>
        </div>
        <p class="text-2xl font-bold text-emerald-600">{activeSectionsCount}</p>
        <p class="text-xs text-slate-500 mt-1">Ditampilkan di publik</p>
      </div>

      <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs">
        <div class="flex items-center justify-between text-slate-500 mb-2">
          <span class="text-xs font-semibold uppercase tracking-wider">Section Nonaktif</span>
          <div class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="4.93" x2="19.07" y1="4.93" y2="19.07"/>
            </svg>
          </div>
        </div>
        <p class="text-2xl font-bold text-amber-600">{disabledSectionsCount}</p>
        <p class="text-xs text-slate-500 mt-1">Disembunyikan (Checkbox Off)</p>
      </div>
    </div>

    <!-- Pages Section List Cards -->
    <div>
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="text-base font-bold text-slate-900">Daftar Halaman & Manajemen Section</h3>
          <p class="text-xs text-slate-500">Klik halaman untuk mengatur on/off section atau mengedit konten teks & visual</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {allPages.map((page) => {
          const pageSectionsList = sectionsByPage[page.slug] || [];
          const activeCount = pageSectionsList.filter((s) => s.isEnabled).length;
          const publicUrl = getPublicUrl(page.slug);

          return (
            <div class="bg-white border border-slate-200 rounded-2xl p-5 hover:border-[#0969da]/50 hover:shadow-md transition-all duration-150 flex flex-col justify-between">
              <div>
                <div class="flex items-start justify-between gap-2 mb-2">
                  <div>
                    <h4 class="font-bold text-slate-900 text-sm">{page.title}</h4>
                    <span class="font-mono text-xs text-blue-600 font-medium">/{page.slug === 'home' ? '' : page.slug}</span>
                  </div>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-slate-100 text-slate-700">
                    {activeCount} / {pageSectionsList.length} Aktif
                  </span>
                </div>
                <p class="text-xs text-slate-500 line-clamp-2 mb-4">{page.description}</p>
              </div>

              <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-2">
                <a
                  href={`/admin/pages/${page.slug}`}
                  class="flex-1 inline-flex items-center justify-center gap-1.5 bg-[#0969da] hover:bg-[#0752a8] text-white text-xs font-semibold py-2 px-3 rounded-xl transition-colors shadow-xs"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 20h9"/>
                    <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>
                  </svg>
                  <span>Kelola Section ({pageSectionsList.length})</span>
                </a>

                <a
                  href={publicUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-2 text-slate-400 hover:text-[#0969da] hover:bg-blue-50 rounded-xl transition-colors border border-slate-200"
                  title="Lihat Halaman Publik"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                    <polyline points="15 3 21 3 21 9"/>
                    <line x1="10" x2="21" y1="14" y2="3"/>
                  </svg>
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</AdminLayout>
