---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAllPages, getAllSections } from '../../lib/db';

// Fetch all pages and section stats safely with fallback
const allPages = await getAllPages();
const allSections = await getAllSections();

const totalPagesCount = allPages.length;
const totalSectionsCount = allSections.length;
const activeSectionsCount = allSections.filter((s) => s.isEnabled).length;
const disabledSectionsCount = totalSectionsCount - activeSectionsCount;

// Group sections by page
const sectionsByPage = allSections.reduce((acc, sec) => {
  if (!acc[sec.pageSlug]) acc[sec.pageSlug] = [];
  acc[sec.pageSlug].push(sec);
  return acc;
}, {} as Record<string, typeof allSections>);

function getPublicUrl(slug: string) {
  if (slug === 'home') return '/';
  if (['wakaf', 'infaq', 'sedekah', 'zakat'].includes(slug)) return `/program/${slug}`;
  return `/${slug}`;
}
---

<AdminLayout title="Ringkasan Dasbor">
  <div class="space-y-6">
    <!-- Page Header (shadcn style) -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-6 border-b border-slate-200">
      <div class="space-y-1">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-semibold bg-blue-50 text-[#0969da] border border-blue-200">
            Sistem Konten Dinamis
          </span>
          <span class="text-xs text-slate-400">&bull;</span>
          <span class="text-xs text-slate-500 font-medium">PostgreSQL Terhubung</span>
        </div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 m-0">Pusat Kendali Section & Halaman</h2>
        <p class="text-xs text-slate-500 m-0">
          Kelola kemunculan (checkbox on/off), urutan, dan konten dinamis seluruh halaman secara realtime tanpa redeploy.
        </p>
      </div>
    </div>

    <!-- Metric Stats Grid (shadcn Cards) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-xs">
        <div class="flex items-center justify-between pb-2">
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Total Halaman</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
            <polyline points="14 2 14 8 20 8"/>
          </svg>
        </div>
        <div class="text-2xl font-bold tracking-tight text-slate-900">{totalPagesCount}</div>
        <p class="text-xs text-slate-500 mt-1 m-0">Halaman web terdaftar</p>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-xs">
        <div class="flex items-center justify-between pb-2">
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Total Section</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400">
            <rect width="7" height="9" x="3" y="3" rx="1"/>
            <rect width="7" height="5" x="14" y="3" rx="1"/>
            <rect width="7" height="9" x="14" y="12" rx="1"/>
            <rect width="7" height="5" x="3" y="16" rx="1"/>
          </svg>
        </div>
        <div class="text-2xl font-bold tracking-tight text-slate-900">{totalSectionsCount}</div>
        <p class="text-xs text-slate-500 mt-1 m-0">Komponen section modular</p>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-xs">
        <div class="flex items-center justify-between pb-2">
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Section Aktif</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-500">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
        </div>
        <div class="text-2xl font-bold tracking-tight text-emerald-600">{activeSectionsCount}</div>
        <p class="text-xs text-slate-500 mt-1 m-0">Ditampilkan di publik</p>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-xs">
        <div class="flex items-center justify-between pb-2">
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Section Nonaktif</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-500">
            <circle cx="12" cy="12" r="10"/>
            <line x1="4.93" x2="19.07" y1="4.93" y2="19.07"/>
          </svg>
        </div>
        <div class="text-2xl font-bold tracking-tight text-amber-600">{disabledSectionsCount}</div>
        <p class="text-xs text-slate-500 mt-1 m-0">Disembunyikan (Checkbox Off)</p>
      </div>
    </div>

    <!-- Pages Section List Cards (shadcn Card Grid) -->
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-base font-semibold text-slate-900 m-0">Daftar Halaman & Manajemen Section</h3>
          <p class="text-xs text-slate-500 mt-0.5 m-0">Klik halaman untuk mengatur on/off section atau mengedit konten teks & visual</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {allPages.map((page) => {
          const pageSectionsList = sectionsByPage[page.slug] || [];
          const activeCount = pageSectionsList.filter((s) => s.isEnabled).length;
          const publicUrl = getPublicUrl(page.slug);

          return (
            <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-xs hover:border-slate-300 hover:shadow-sm transition-all flex flex-col justify-between">
              <div class="space-y-2.5">
                <div class="flex items-start justify-between gap-2">
                  <div class="min-w-0">
                    <h4 class="font-semibold text-slate-900 text-sm tracking-tight truncate m-0">{page.title}</h4>
                    <span class="font-mono text-xs text-blue-600 font-medium">/{page.slug === 'home' ? '' : page.slug}</span>
                  </div>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 text-slate-600 border border-slate-200 shrink-0">
                    {activeCount} / {pageSectionsList.length} Aktif
                  </span>
                </div>
                <p class="text-xs text-slate-500 line-clamp-2 m-0">{page.description}</p>
              </div>

              <div class="pt-4 mt-4 border-t border-slate-100 flex items-center gap-2">
                <a
                  href={`/admin/pages/${page.slug}`}
                  class="flex-1 inline-flex items-center justify-center gap-1.5 bg-[#0969da] hover:bg-[#0752a8] text-white text-xs font-medium h-9 px-3 rounded-md transition-colors shadow-2xs"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 20h9"/>
                    <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>
                  </svg>
                  <span>Kelola Section ({pageSectionsList.length})</span>
                </a>

                <a
                  href={publicUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="h-9 w-9 inline-flex items-center justify-center rounded-md border border-slate-200 hover:bg-slate-50 text-slate-500 hover:text-slate-900 transition-colors shadow-2xs shrink-0"
                  title="Lihat Halaman Publik"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                    <polyline points="15 3 21 3 21 9"/>
                    <line x1="10" x2="21" y1="14" y2="3"/>
                  </svg>
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</AdminLayout>
