---
export const prerender = false;

const errorParam = Astro.url.searchParams.get('error');
const redirectParam = Astro.url.searchParams.get('redirect') || '/admin';

let errorMessage = '';
if (errorParam === 'invalid_credentials') {
  errorMessage = 'Nama pengguna atau kata sandi tidak sesuai. Silakan periksa kembali.';
} else if (errorParam === 'empty_fields') {
  errorMessage = 'Nama pengguna dan kata sandi wajib diisi lengkap.';
}
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portal Masuk Admin CMS - Global Village Fund</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      body {
        font-family: 'Golos Text', -apple-system, BlinkMacSystemFont, sans-serif;
      }
    </style>
  </head>
  <body class="bg-[#0b1120] text-slate-100 min-h-screen flex items-center justify-center p-4 selection:bg-[#0969da] selection:text-white relative overflow-hidden">
    <!-- Subtle Architectural Background Grid -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b0f_1px,transparent_1px),linear-gradient(to_bottom,#1e293b0f_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none"></div>
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-[#0969da]/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-[#0752a8]/10 rounded-full blur-3xl pointer-events-none"></div>

    <main class="w-full max-w-md relative z-10">
      <!-- Brand Header -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-[#0969da]/15 border border-[#0969da]/30 text-[#0969da] mb-4 shadow-inner">
          <!-- Lucide ShieldCheck SVG -->
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-400">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
        </div>
        <h1 class="text-2xl font-bold tracking-tight text-white">Global Village Fund</h1>
        <p class="text-sm text-slate-400 mt-1">CMS Content & Section Management Portal</p>
      </div>

      <!-- Login Card -->
      <div class="bg-[#131d33] border border-slate-800 rounded-2xl p-7 shadow-2xl shadow-black/50 backdrop-blur-sm">
        {errorMessage && (
          <div class="mb-5 p-3.5 rounded-xl bg-red-950/60 border border-red-800/60 text-red-300 text-sm flex items-start gap-3" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5 text-red-400">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" x2="12" y1="8" y2="12"/>
              <line x1="12" x2="12.01" y1="16" y2="16"/>
            </svg>
            <p>{errorMessage}</p>
          </div>
        )}

        <form action="/api/admin/login" method="POST" class="space-y-4" id="loginForm">
          <input type="hidden" name="redirect" value={redirectParam} />

          <div>
            <label for="username" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
              Nama Pengguna
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
              </div>
              <input
                type="text"
                id="username"
                name="username"
                required
                autocomplete="username"
                autofocus
                placeholder="Masukkan username admin"
                class="w-full bg-[#0b1120] border border-slate-700 focus:border-[#0969da] focus:ring-2 focus:ring-[#0969da]/30 rounded-xl pl-10 pr-4 py-2.5 text-sm text-white placeholder-slate-500 outline-none transition-all duration-150"
              />
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between mb-2">
              <label for="password" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
                Kata Sandi
              </label>
            </div>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
              </div>
              <input
                type="password"
                id="password"
                name="password"
                required
                autocomplete="current-password"
                placeholder="••••••••••••"
                class="w-full bg-[#0b1120] border border-slate-700 focus:border-[#0969da] focus:ring-2 focus:ring-[#0969da]/30 rounded-xl pl-10 pr-11 py-2.5 text-sm text-white placeholder-slate-500 outline-none transition-all duration-150"
              />
              <button
                type="button"
                id="togglePassword"
                class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-500 hover:text-slate-300 transition-colors focus:outline-none"
                aria-label="Tampilkan atau sembunyikan kata sandi"
              >
                <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/>
                  <circle cx="12" cy="12" r="3"/>
                </svg>
              </button>
            </div>
          </div>

          <div class="pt-2">
            <button
              type="submit"
              id="submitBtn"
              class="w-full bg-[#0969da] hover:bg-[#0752a8] text-white font-medium py-2.5 px-4 rounded-xl flex items-center justify-center gap-2 shadow-lg shadow-[#0969da]/25 transition-all duration-150 active:scale-[0.99] cursor-pointer"
            >
              <span>Masuk ke Dashboard</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/>
                <path d="m12 5 7 7-7 7"/>
              </svg>
            </button>
          </div>
        </form>

        <!-- Initial Credentials Helper Note for Development -->
        <div class="mt-6 pt-5 border-t border-slate-800/80 text-xs text-slate-400 flex items-start gap-2.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-400 shrink-0 mt-0.5">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 16v-4"/>
            <path d="M12 8h.01"/>
          </svg>
          <div>
            <p class="font-medium text-slate-300">Akses Kredensial Awal:</p>
            <p class="text-slate-400 mt-0.5">Username: <code class="text-blue-300 font-mono bg-blue-950/40 px-1 py-0.5 rounded">admin</code> | Sandi: <code class="text-blue-300 font-mono bg-blue-950/40 px-1 py-0.5 rounded">AdminGVF2026!</code></p>
          </div>
        </div>
      </div>

      <!-- Security Trust Bar -->
      <div class="mt-6 text-center text-xs text-slate-500">
        <p>Global Village Fund &copy; 2026 &bull; Sesi Aman HMAC SHA-256 &bull; Tata Kelola Syariah ISO 9001</p>
      </div>
    </main>

    <script>
      const toggleBtn = document.getElementById('togglePassword');
      const passwordInput = document.getElementById('password') as HTMLInputElement;
      if (toggleBtn && passwordInput) {
        toggleBtn.addEventListener('click', () => {
          const isPassword = passwordInput.type === 'password';
          passwordInput.type = isPassword ? 'text' : 'password';
        });
      }
    </script>
  </body>
</html>
