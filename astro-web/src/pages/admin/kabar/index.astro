---
// src/pages/admin/kabar/index.astro
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import ArticleModal from '../../../components/admin/kabar/ArticleModal.astro';
import DeleteArticleModal from '../../../components/admin/kabar/DeleteArticleModal.astro';
import CategoryModal from '../../../components/admin/kabar/CategoryModal.astro';
import { getAllNewsArticles } from '../../../lib/db';
import '../../../styles/admin/kabar.css';

const rawArticles = await getAllNewsArticles();

// Normalisasi data untuk tampilan
const allArticles = rawArticles.map(a => ({
  id: a.id,
  title: a.title,
  slug: a.slug,
  category: a.category,
  summary: a.summary,
  content: a.content,
  author: a.author,
  coverImage: a.coverImage,
  publishedAt: a.publishedAt ? new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  }).format(new Date(a.publishedAt)) : 'Belum Ditentukan',
  isPublished: a.isPublished,
  createdAt: a.createdAt,
}));

const totalCount = allArticles.length;
const publishedCount = allArticles.filter(a => a.isPublished).length;
const draftCount = allArticles.filter(a => !a.isPublished).length;
---

<AdminLayout title="Kelola Kabar & Warta" activeSlug="kabar">
  <div class="kabar-admin-page">
    <!-- Header Section -->
    <div class="kabar-top-header">
      <div class="header-titles">
        <div class="header-badge-row">
          <span class="badge-blue-pill">Pusat Redaksi &amp; Warta</span>
          <span class="badge-dot-sep">&bull;</span>
          <span class="badge-green-pill">MinIO S3 Terintegrasi</span>
        </div>
        <h1 class="header-main-title">Kabar &amp; Literasi Terkini GVF</h1>
        <p class="header-desc">
          Kelola publikasi artikel, warta progres kawasan, dan literasi syariah dengan integrasi penyimpanan berkas MinIO S3.
        </p>
      </div>

      <div class="header-actions">
        <button
          type="button"
          id="btnOpenCreateArticle"
          class="btn-create-article"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>Tulis Artikel Baru</span>
        </button>
      </div>
    </div>

    <!-- Metrik Statistik -->
    <div class="metrics-grid">
      <div class="metric-card">
        <div class="metric-card-top">
          <span class="metric-label">TOTAL ARTIKEL</span>
          <div class="metric-icon-wrap text-blue">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
          </div>
        </div>
        <div class="metric-value">{totalCount}</div>
        <p class="metric-hint">Koleksi berita &amp; literasi di database</p>
      </div>

      <div class="metric-card">
        <div class="metric-card-top">
          <span class="metric-label">ARTIKEL TERBIT</span>
          <div class="metric-icon-wrap text-emerald">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
        </div>
        <div class="metric-value text-emerald">{publishedCount}</div>
        <p class="metric-hint">Tampil aktif di web publik</p>
      </div>

      <div class="metric-card">
        <div class="metric-card-top">
          <span class="metric-label">ARTIKEL DRAF</span>
          <div class="metric-icon-wrap text-amber">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
            </svg>
          </div>
        </div>
        <div class="metric-value text-amber">{draftCount}</div>
        <p class="metric-hint">Disimpan aman belum terbit</p>
      </div>
    </div>

    <!-- Daftar Artikel -->
    <div class="articles-section">
      <div class="section-header-row">
        <div>
          <h2 class="section-title">Daftar Publikasi Artikel</h2>
          <p class="section-subtitle">
            Klik tombol Edit untuk mengubah narasi, atau klik ikon Kamera untuk mengganti gambar via MinIO S3 secara instan.
          </p>
        </div>
        <a href="/kabar" target="_blank" class="link-preview-public">
          <span>Lihat Tampilan Publik</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </div>

      {allArticles.length === 0 ? (
        <div class="empty-state-box">
          <p>Belum ada artikel warta yang tersimpan.</p>
        </div>
      ) : (
        <div class="articles-grid" id="articlesListContainer">
          {allArticles.map((article) => {
            const articleJson = JSON.stringify(article);
            return (
              <div
                class="admin-article-card"
                id={`article-card-${article.id}`}
                data-article-id={article.id}
              >
                <!-- Header Kartu -->
                <div class="card-top-bar">
                  <div class="card-category-date">
                    <span class="cat-pill">{article.category}</span>
                    <span class="date-text">{article.publishedAt}</span>
                  </div>

                  <span
                    id={`status-badge-${article.id}`}
                    class={`status-pill ${article.isPublished ? 'published' : 'draft'}`}
                  >
                    <span class="status-dot"></span>
                    <span id={`status-text-${article.id}`}>
                      {article.isPublished ? 'Terbit' : 'Draf'}
                    </span>
                  </span>
                </div>

                <!-- Konten Kartu: Gambar & Teks Seimbang -->
                <div class="card-main-content">
                  <!-- Thumbnail Gambar dengan Tombol Cepat Ubah Gambar -->
                  <div class="thumb-container">
                    <img
                      src={article.coverImage}
                      alt={article.title}
                      id={`card-img-${article.id}`}
                      class="thumb-image"
                      loading="lazy"
                    />
                    <button
                      type="button"
                      class="btn-quick-change-img"
                      title="Ganti Gambar via MinIO S3"
                      data-article-id={article.id}
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                        <circle cx="12" cy="13" r="4"></circle>
                      </svg>
                      <span>Ubah Gambar</span>
                    </button>
                  </div>

                  <!-- Teks Artikel -->
                  <div class="card-text-col">
                    <h3 class="card-article-title" id={`title-display-${article.id}`}>
                      {article.title}
                    </h3>
                    <p class="card-article-summary">
                      {article.summary}
                    </p>
                    <div class="card-meta-bottom">
                      <span class="meta-author">Penulis: <strong>{article.author || 'Tim GVF'}</strong></span>
                      <a href={`/kabar/${article.slug}`} target="_blank" class="meta-slug-link" title="Buka Pratinjau Halaman">
                        <span>/kabar/{article.slug}</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                          <polyline points="15 3 21 3 21 9"></polyline>
                          <line x1="10" y1="14" x2="21" y2="3"></line>
                        </svg>
                      </a>
                    </div>
                  </div>
                </div>

                <!-- Footer Aksi -->
                <div class="card-footer-actions">
                  <!-- Toggle Tayang -->
                  <div class="toggle-group">
                    <label for={`toggle-news-${article.id}`} class="toggle-label">
                      Tayang
                    </label>
                    <label class="switch-container">
                      <input
                        type="checkbox"
                        id={`toggle-news-${article.id}`}
                        class="news-toggle-checkbox"
                        data-article-id={article.id}
                        checked={article.isPublished}
                      />
                      <span class="switch-slider"></span>
                    </label>
                  </div>

                  <!-- Tombol Aksi Kanan -->
                  <div class="action-btn-group">
                    <button
                      type="button"
                      class="btn-action btn-edit edit-article-btn"
                      data-article-json={articleJson}
                    >
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                      </svg>
                      <span>Edit</span>
                    </button>

                    <button
                      type="button"
                      class="btn-action btn-delete delete-article-btn"
                      data-article-id={article.id}
                      data-article-title={article.title}
                    >
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 6h18"></path>
                        <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
                        <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                      </svg>
                      <span>Hapus</span>
                    </button>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </div>

  <!-- Hidden File Input untuk Quick Change Image pada Kartu -->
  <input
    type="file"
    id="cardQuickFileInput"
    accept="image/jpeg,image/png,image/webp,image/gif"
    style="display: none;"
  />

  <!-- Modal Formulir Tambah / Edit Artikel -->
  <ArticleModal />

  <!-- Modal Konfirmasi Hapus Artikel -->
  <DeleteArticleModal />

  <!-- Modal Referensi Kategori -->
  <CategoryModal />

  <!-- Toast Notifikasi Global -->
  <div id="kabarToast" class="admin-toast">
    <div class="toast-dot"></div>
    <span id="kabarToastMessage">Pesan sistem</span>
  </div>
</AdminLayout>

<script src="../../../scripts/admin/kabar.ts"></script>
