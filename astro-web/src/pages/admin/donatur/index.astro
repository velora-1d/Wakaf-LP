---
// src/pages/admin/donatur/index.astro
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { 
  getAllDonationsWithDonors, 
  getDonationDashboardMetrics,
  getAllCashAllocations,
  getCashAllocationMetrics
} from '../../../lib/db';

const donations = await getAllDonationsWithDonors();
const metrics = await getDonationDashboardMetrics();
const allocations = await getAllCashAllocations();
const allocMetrics = await getCashAllocationMetrics();

// Formatter Rupiah
const formatRupiah = (val: number) => {
  return new Intl.NumberFormat('id-ID', {
    style: 'currency',
    currency: 'IDR',
    maximumFractionDigits: 0,
  }).format(val);
};

// Formatter Tanggal
const formatDate = (date: Date | string | null) => {
  if (!date) return '-';
  return new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  }).format(new Date(date));
};

const leadsMap: Record<string, { label: string; bg: string; text: string; border: string }> = {
  meta_ads: { label: 'Meta Ads', bg: 'bg-blue-50', text: 'text-blue-700', border: 'border-blue-200' },
  tiktok_ads: { label: 'TikTok Ads', bg: 'bg-slate-900', text: 'text-white', border: 'border-slate-800' },
  google_seo: { label: 'Google SEO', bg: 'bg-sky-50', text: 'text-sky-700', border: 'border-sky-200' },
  safari_dakwah: { label: 'Safari Dakwah', bg: 'bg-amber-50', text: 'text-amber-800', border: 'border-amber-200' },
  brosur_event: { label: 'Brosur & Event', bg: 'bg-cyan-50', text: 'text-cyan-700', border: 'border-cyan-200' },
  relasi_langsung: { label: 'Relasi Langsung', bg: 'bg-emerald-50', text: 'text-emerald-700', border: 'border-emerald-200' },
  walk_in: { label: 'Walk-in', bg: 'bg-orange-50', text: 'text-orange-700', border: 'border-orange-200' },
};

const programMap: Record<string, string> = {
  'wakaf': 'Wakaf (Wakaf Produktif & Lahan)',
  'infaq': 'Infaq (Infaq Pembangunan Fisik)',
  'sedekah': 'Shodaqoh (Sedekah Nutrisi & Pangan)',
  'zakat': 'Zakat (Zakat Maal & Fitrah)',
};

const programBadgeMap: Record<string, { bg: string; text: string; border: string }> = {
  wakaf: { bg: 'bg-blue-50', text: 'text-blue-700', border: 'border-blue-200' },
  infaq: { bg: 'bg-emerald-50', text: 'text-emerald-700', border: 'border-emerald-200' },
  sedekah: { bg: 'bg-sky-50', text: 'text-sky-700', border: 'border-sky-200' },
  zakat: { bg: 'bg-amber-50', text: 'text-amber-800', border: 'border-amber-200' },
};
---

<AdminLayout title="Kelola Donatur & Leads" activeSlug="donatur">
  <div class="w-full space-y-5">
    <!-- Top Header (Shadcn Style) -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-blue-50 text-[#0969da] border border-blue-200">
            Pusat Pengelolaan Dana GVF
          </span>
          <span class="text-slate-300 text-xs">&bull;</span>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            MinIO S3 Terkoneksi
          </span>
        </div>
        <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 m-0">Pengelolaan Donatur &amp; Arus Kas GVF</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1 mb-0">
          Pusat terpadu kelola data muhsinin, penerimaan donasi, verifikasi status, serta buku kas realisasi belanja (Debit - Kredit - Saldo).
        </p>
      </div>

      <div class="flex items-center gap-2.5 shrink-0">
        <button
          type="button"
          id="btnOpenCreateDonation"
          class="inline-flex items-center justify-center gap-2 h-9 px-4 rounded-md text-xs font-semibold bg-[#0969da] text-white hover:bg-[#0752a8] shadow-xs transition-colors cursor-pointer"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>Catat Donasi Baru</span>
        </button>
        <button
          type="button"
          id="btnOpenCreateAlokasiHeader"
          class="inline-flex items-center justify-center gap-2 h-9 px-4 rounded-md text-xs font-semibold bg-rose-600 text-white hover:bg-rose-700 shadow-xs transition-colors cursor-pointer"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>Catat Belanja / Mutasi</span>
        </button>
      </div>
    </div>

    <!-- Main Tabs Navigation (Shadcn Style) -->
    <div class="flex items-center gap-2 border-b border-slate-200">
      <button
        type="button"
        id="tabBtnDonatur"
        class="tab-btn active inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold border-b-2 border-[#0969da] text-[#0969da] bg-blue-50/50 rounded-t-lg transition-all cursor-pointer"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
        <span>Riwayat Donatur &amp; Penerimaan</span>
        <span class="inline-flex items-center px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-blue-100 text-[#0969da]">
          {donations.length}
        </span>
      </button>

      <button
        type="button"
        id="tabBtnAlokasi"
        class="tab-btn inline-flex items-center gap-2 px-4 py-2.5 text-xs font-medium border-b-2 border-transparent text-slate-500 hover:text-slate-800 hover:bg-slate-50 rounded-t-lg transition-all cursor-pointer"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
          <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
        </svg>
        <span>Realisasi Alokasi Kas (Debit &bull; Kredit &bull; Saldo)</span>
        <span class="inline-flex items-center px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
          {allocations.length}
        </span>
      </button>
    </div>

    <!-- TAB 1: RIWAYAT DONATUR & PENERIMAAN -->
    <div id="tabContentDonatur" class="space-y-5">
      <!-- Metrik Statistik Dashboard (Shadcn Card Style) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-2xs">
        <div class="flex items-center justify-between pb-2">
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Total Penghimpunan</span>
          <div class="w-7 h-7 rounded-md bg-blue-50 text-[#0969da] flex items-center justify-center">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="1" x2="12" y2="23"></line>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
        </div>
        <div class="text-xl font-bold tracking-tight text-slate-900 font-mono">{formatRupiah(metrics.totalPenghimpunan)}</div>
        <p class="text-[11px] text-slate-400 mt-1 mb-0">Dana terverifikasi lunas di bank</p>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-2xs">
        <div class="flex items-center justify-between pb-2">
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Donasi Lunas (Verified)</span>
          <div class="w-7 h-7 rounded-md bg-emerald-50 text-emerald-600 flex items-center justify-center">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
        </div>
        <div class="text-xl font-bold tracking-tight text-slate-900">{metrics.lunasCount} <span class="text-xs font-medium text-slate-500">Transaksi</span></div>
        <p class="text-[11px] text-emerald-600 font-medium mt-1 mb-0">Telah diverifikasi oleh tim amil GVF</p>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-2xs">
        <div class="flex items-center justify-between pb-2">
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Menunggu Verifikasi</span>
          <div class="w-7 h-7 rounded-md bg-amber-50 text-amber-600 flex items-center justify-center">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
        </div>
        <div class="text-xl font-bold tracking-tight text-amber-600">{metrics.pendingCount} <span class="text-xs font-medium text-slate-500">Transaksi</span></div>
        <p class="text-[11px] text-slate-400 mt-1 mb-0">Perlu cek mutasi / bukti transfer</p>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-2xs">
        <div class="flex items-center justify-between pb-2">
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Total Donatur Unik</span>
          <div class="w-7 h-7 rounded-md bg-slate-100 text-slate-700 flex items-center justify-center">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
        </div>
        <div class="text-xl font-bold tracking-tight text-slate-900">{metrics.totalDonors} <span class="text-xs font-medium text-slate-500">Muhsinin</span></div>
        <p class="text-[11px] text-slate-400 mt-1 mb-0">Tercatat dalam basis data kontak</p>
      </div>
    </div>

    <!-- Toolbar: Search & Filters (Shadcn Style) -->
    <div class="rounded-lg border border-slate-200 bg-white p-3 shadow-2xs space-y-3">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
        <!-- Search -->
        <div class="relative flex-1 max-w-md">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="text"
            id="tableSearchInput"
            placeholder="Cari nama, nomor WA, kota, atau kode transaksi..."
            class="h-9 w-full rounded-md border border-slate-200 bg-slate-50/50 pl-9 pr-3 text-xs text-slate-800 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-1 focus:ring-slate-950 focus:border-slate-400 transition-colors"
          />
        </div>

        <!-- Filters -->
        <div class="flex items-center gap-2 flex-wrap">
          <!-- Status Filter -->
          <select id="filterStatus" class="h-9 rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 shadow-2xs focus:outline-none focus:ring-1 focus:ring-slate-950 cursor-pointer">
            <option value="all">Semua Status</option>
            <option value="lunas">Lunas (Verified)</option>
            <option value="menunggu_verifikasi">Menunggu Verifikasi</option>
            <option value="dibatalkan">Dibatalkan</option>
          </select>

          <!-- Leads Filter -->
          <select id="filterLeads" class="h-9 rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 shadow-2xs focus:outline-none focus:ring-1 focus:ring-slate-950 cursor-pointer">
            <option value="all">Semua Saluran Leads</option>
            <option value="meta_ads">Meta Ads (FB/IG)</option>
            <option value="tiktok_ads">TikTok Ads</option>
            <option value="google_seo">Google SEO</option>
            <option value="safari_dakwah">Safari Dakwah</option>
            <option value="brosur_event">Brosur &amp; Event</option>
            <option value="relasi_langsung">Relasi Langsung</option>
            <option value="walk_in">Walk-in</option>
          </select>

          <!-- Program Filter (Hanya 4 Program Resmi di Web) -->
          <select id="filterProgram" class="h-9 rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 shadow-2xs focus:outline-none focus:ring-1 focus:ring-slate-950 cursor-pointer">
            <option value="all">Semua Program (4 Program)</option>
            <option value="wakaf">Wakaf (Wakaf Produktif &amp; Lahan)</option>
            <option value="infaq">Infaq (Infaq Pembangunan Fisik)</option>
            <option value="sedekah">Shodaqoh (Sedekah Nutrisi &amp; Pangan)</option>
            <option value="zakat">Zakat (Zakat Maal &amp; Fitrah)</option>
          </select>

          <!-- Filter Rentang Nominal Dinamis (Preset + Input Min/Max) -->
          <div class="flex items-center gap-1.5 rounded-md border border-slate-200 bg-white px-2 py-1 shadow-2xs">
            <select id="filterNominal" class="h-7 rounded border-0 bg-transparent pr-1 text-xs font-medium text-slate-700 focus:outline-none focus:ring-0 cursor-pointer">
              <option value="all">Semua Nominal</option>
              <option value="custom">Kustom (Min - Max)</option>
              <option value="under_100k">&lt; Rp 100.000</option>
              <option value="100k_500k">Rp 100.000 - Rp 500.000</option>
              <option value="500k_1m">Rp 500.000 - Rp 1.000.000</option>
              <option value="1m_5m">Rp 1.000.000 - Rp 5.000.000</option>
              <option value="above_5m">&gt; Rp 5.000.000 (Besar / VIP)</option>
            </select>
            <div class="flex items-center gap-1 pl-1.5 border-l border-slate-200">
              <span class="text-[11px] font-semibold text-slate-400 select-none">Rp</span>
              <input
                type="text"
                id="inputNominalMin"
                placeholder="Min"
                class="h-7 w-20 sm:w-24 rounded border border-slate-200 bg-slate-50/60 px-2 py-0.5 text-xs text-slate-800 placeholder:text-slate-400 focus:bg-white focus:border-[#0969da] focus:outline-none focus:ring-1 focus:ring-[#0969da]"
                title="Nominal Minimum (contoh: 50.000)"
              />
              <span class="text-slate-300 font-bold select-none">-</span>
              <input
                type="text"
                id="inputNominalMax"
                placeholder="Max"
                class="h-7 w-20 sm:w-24 rounded border border-slate-200 bg-slate-50/60 px-2 py-0.5 text-xs text-slate-800 placeholder:text-slate-400 focus:bg-white focus:border-[#0969da] focus:outline-none focus:ring-1 focus:ring-[#0969da]"
                title="Nominal Maksimum (contoh: 1.000.000)"
              />
            </div>
          </div>

          <button
            type="button"
            id="btnResetFilters"
            class="h-9 px-3 rounded-md border border-slate-200 bg-white text-xs font-medium text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-colors cursor-pointer"
          >
            Reset
          </button>
        </div>
      </div>

      <!-- Bulk Action Bar (Hidden by default, shown when items checked) -->
      <div id="bulkActionBar" class="hidden items-center justify-between p-2 rounded-md bg-blue-50/70 border border-blue-200 text-xs">
        <div class="flex items-center gap-2 text-slate-800 font-medium">
          <span id="selectedCountText" class="font-bold text-[#0969da]">0</span>
          <span>transaksi dipilih</span>
        </div>
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="btnBulkVerifyLunas"
            class="h-7 px-2.5 rounded bg-emerald-600 text-white font-medium hover:bg-emerald-700 transition-colors shadow-2xs cursor-pointer flex items-center gap-1.5"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Verifikasi Lunas</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Table Container (Shadcn Data Table Style) -->
    <div class="rounded-lg border border-slate-200 bg-white overflow-hidden shadow-2xs">
      <div class="overflow-x-auto w-full">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50/75 text-slate-500 font-medium tracking-wide">
              <!-- Checkbox Kolom -->
              <th class="w-10 px-3 py-3 text-center">
                <input
                  type="checkbox"
                  id="selectAllCheckbox"
                  class="h-3.5 w-3.5 rounded border-slate-300 text-[#0969da] focus:ring-1 focus:ring-[#0969da] cursor-pointer"
                  title="Pilih Semua"
                />
              </th>
              <!-- No Kolom -->
              <th class="w-12 px-2 py-3 text-center font-semibold text-slate-600">NO</th>
              <th class="px-3 py-3 font-semibold text-slate-600 whitespace-nowrap">KODE &amp; TANGGAL</th>
              <th class="px-3 py-3 font-semibold text-slate-600">PROFIL DONATUR</th>
              <th class="px-3 py-3 font-semibold text-slate-600">PROGRAM &amp; NIAT</th>
              <th class="px-3 py-3 font-semibold text-slate-600 whitespace-nowrap">NOMINAL (RP)</th>
              <th class="px-3 py-3 font-semibold text-slate-600 whitespace-nowrap">SUMBER LEADS</th>
              <th class="px-3 py-3 font-semibold text-slate-600 whitespace-nowrap">METODE &amp; BUKTI</th>
              <th class="px-3 py-3 font-semibold text-slate-600 whitespace-nowrap">STATUS</th>
              <th class="px-3 py-3 font-semibold text-slate-600 text-right whitespace-nowrap">AKSI</th>
            </tr>
          </thead>
          <tbody id="donationsTableBody" class="divide-y divide-slate-100">
            {donations.length === 0 ? (
              <tr>
                <td colspan="10" class="py-12 text-center text-slate-400">
                  <div class="flex flex-col items-center justify-center gap-1.5">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-slate-300">
                      <circle cx="12" cy="12" r="10"></circle>
                      <line x1="12" y1="8" x2="12" y2="12"></line>
                      <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <span class="font-semibold text-slate-700 text-sm">Belum ada catatan transaksi donasi</span>
                    <span class="text-xs text-slate-400">Klik "Catat Donasi Baru" untuk menambahkan data donatur.</span>
                  </div>
                </td>
              </tr>
            ) : (
              donations.map((d, index) => {
                const leadInfo = leadsMap[d.sumberLeads] || { label: d.sumberLeads, bg: 'bg-slate-100', text: 'text-slate-700', border: 'border-slate-200' };
                const programName = programMap[d.programTujuan] || d.programTujuan;

                const waText = encodeURIComponent(
                  `Assalamu'alaikum Warahmatullahi Wabarakatuh, Bpk/Ibu ${d.donor.namaLengkap}.\n\n` +
                  `Terima kasih atas amanah donasi dan wakaf yang telah Anda salurkan melalui Global Village Fund (GVF).\n\n` +
                  `*Rincian Transaksi Donasi:*\n` +
                  `- No. Transaksi: *${d.kodeTransaksi}*\n` +
                  `- Program: *${programName}*\n` +
                  `- Atas Nama / Niat: *${d.atasNamaNiat || d.donor.namaLengkap}*\n` +
                  `- Nominal: *${formatRupiah(d.nominalTotal)}*\n` +
                  `- Status: *${d.statusPembayaran.toUpperCase()}*\n\n` +
                  `Semoga Allah SWT melipatgandakan pahala kebaikan, menjadikannya amal jariyah yang mengalir abadi, serta memberkahi keluarga Bpk/Ibu sekalian. Aamiin ya Rabbal 'Alamin.\n\n` +
                  `_Pusat Layanan Donatur Global Village Fund (GVF)_`
                );
                const waLink = `https://wa.me/${d.donor.noWhatsapp.replace(/^0/, '62').replace(/[^0-9]/g, '')}?text=${waText}`;

                return (
                  <tr
                    class="donation-row hover:bg-slate-50/70 transition-colors"
                    data-search={`${d.kodeTransaksi} ${d.donor.namaLengkap} ${d.donor.noWhatsapp} ${d.donor.kotaDomisili || ''}`.toLowerCase()}
                    data-status={d.statusPembayaran}
                    data-lead={d.sumberLeads}
                    data-program={d.programTujuan}
                    data-nominal={d.nominalTotal}
                    data-id={d.id}
                  >
                    <!-- Checkbox -->
                    <td class="w-10 px-3 py-3 text-center">
                      <input
                        type="checkbox"
                        class="row-checkbox h-3.5 w-3.5 rounded border-slate-300 text-[#0969da] focus:ring-1 focus:ring-[#0969da] cursor-pointer"
                        data-id={d.id}
                      />
                    </td>

                    <!-- No -->
                    <td class="w-12 px-2 py-3 text-center font-mono font-medium text-slate-400">
                      {index + 1}
                    </td>

                    <!-- Kode & Tanggal -->
                    <td class="px-3 py-3 whitespace-nowrap">
                      <span class="font-mono font-semibold text-slate-900 block">{d.kodeTransaksi}</span>
                      <span class="text-[11px] text-slate-400 block">{formatDate(d.createdAt)}</span>
                    </td>

                    <!-- Profil Donatur -->
                    <td class="px-3 py-3">
                      <div class="flex items-center gap-1.5">
                        <span class="font-semibold text-slate-900">{d.donor.namaLengkap}</span>
                        <span class={`inline-flex px-1.5 py-0.5 rounded text-[10px] font-semibold border ${
                          d.donor.tipeDonatur === 'korporasi'
                            ? 'bg-blue-50 text-[#0969da] border-blue-200'
                            : 'bg-slate-100 text-slate-600 border-slate-200'
                        }`}>
                          {d.donor.tipeDonatur}
                        </span>
                      </div>
                      <div class="text-[11px] text-slate-500 mt-0.5">
                        <span>{d.donor.noWhatsapp}</span>
                        {d.donor.kotaDomisili && <span> &bull; {d.donor.kotaDomisili}</span>}
                      </div>
                    </td>

                    <!-- Program & Niat -->
                    <td class="px-3 py-3">
                      <span class="font-medium text-slate-900 block">{programName}</span>
                      {d.atasNamaNiat && (
                        <span class="text-[11px] text-[#0969da] block">Niat: {d.atasNamaNiat}</span>
                      )}
                      {d.doaDonatur && (
                        <span class="text-[11px] text-slate-500 italic block truncate max-w-[200px]" title={d.doaDonatur}>
                          "{d.doaDonatur}"
                        </span>
                      )}
                    </td>

                    <!-- Nominal -->
                    <td class="px-3 py-3 whitespace-nowrap">
                      <span class="font-mono font-bold text-slate-900 text-xs block">{formatRupiah(d.nominalTotal)}</span>
                      {d.kodeUnik > 0 && (
                        <span class="font-mono text-[10px] text-slate-400 block">Kode: +{d.kodeUnik}</span>
                      )}
                    </td>

                    <!-- Sumber Leads -->
                    <td class="px-3 py-3 whitespace-nowrap">
                      <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium border ${leadInfo.bg} ${leadInfo.text} ${leadInfo.border}`}>
                        {leadInfo.label}
                      </span>
                      {d.campaignUtm && (
                        <span class="font-mono text-[10px] text-slate-400 block mt-0.5">{d.campaignUtm}</span>
                      )}
                    </td>

                    <!-- Metode & Bukti S3 -->
                    <td class="px-3 py-3 whitespace-nowrap">
                      <span class="inline-flex px-1.5 py-0.5 rounded text-[11px] font-medium bg-slate-100 text-slate-700 border border-slate-200">
                        {d.metodePembayaran}
                      </span>
                      {d.buktiTransferUrl ? (
                        <button
                          type="button"
                          class="btn-view-proof flex items-center gap-1 text-[11px] font-semibold text-[#0969da] hover:underline mt-1 cursor-pointer"
                          data-proof-url={d.buktiTransferUrl}
                          data-kode={d.kodeTransaksi}
                        >
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
                            <circle cx="9" cy="9" r="2"></circle>
                            <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
                          </svg>
                          <span>Lihat Bukti S3</span>
                        </button>
                      ) : (
                        <span class="text-[10px] text-slate-300 block mt-0.5">Tanpa bukti</span>
                      )}
                    </td>

                    <!-- Status -->
                    <td class="px-3 py-3 whitespace-nowrap">
                      {d.statusPembayaran === 'lunas' && (
                        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                          Lunas
                        </span>
                      )}
                      {d.statusPembayaran === 'menunggu_verifikasi' && (
                        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                          <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                          Pending
                        </span>
                      )}
                      {d.statusPembayaran === 'dibatalkan' && (
                        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-600 border border-slate-200">
                          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                          Batal
                        </span>
                      )}
                    </td>

                    <!-- Aksi -->
                    <td class="px-3 py-3 text-right whitespace-nowrap">
                      <div class="inline-flex items-center gap-1.5">
                        <!-- Kirim WhatsApp -->
                        <a
                          href={waLink}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="btn-action-wa h-7 px-2 rounded bg-emerald-50 border border-emerald-200 text-emerald-700 hover:bg-emerald-600 hover:text-white transition-colors inline-flex items-center gap-1 font-semibold text-[11px] shadow-2xs cursor-pointer select-none"
                          data-action="wa"
                          data-wa-url={waLink}
                          title="Kirim Kwitansi via WhatsApp"
                        >
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                          </svg>
                          <span class="pointer-events-none">WA</span>
                        </a>

                        <!-- Verifikasi Toggle -->
                        {d.statusPembayaran === 'menunggu_verifikasi' ? (
                          <button
                            type="button"
                            class="h-7 w-7 rounded bg-emerald-50 border border-emerald-200 text-emerald-700 hover:bg-emerald-600 hover:text-white transition-colors inline-flex items-center justify-center cursor-pointer shadow-2xs"
                            data-action="verify-lunas"
                            data-id={d.id}
                            title="Klik untuk Verifikasi LUNAS"
                          >
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none">
                              <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                          </button>
                        ) : (
                          <button
                            type="button"
                            class="h-7 w-7 rounded bg-amber-50 border border-amber-200 text-amber-700 hover:bg-amber-600 hover:text-white transition-colors inline-flex items-center justify-center cursor-pointer shadow-2xs"
                            data-action="verify-pending"
                            data-id={d.id}
                            title="Klik untuk Ubah ke Status PENDING"
                          >
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none">
                              <circle cx="12" cy="12" r="10"></circle>
                              <line x1="12" y1="8" x2="12" y2="12"></line>
                            </svg>
                          </button>
                        )}

                        <!-- Edit Transaksi & Profil Donatur -->
                        <button
                          type="button"
                          class="h-7 w-7 rounded bg-blue-50 border border-blue-200 text-[#0969da] hover:bg-[#0969da] hover:text-white transition-colors inline-flex items-center justify-center cursor-pointer shadow-2xs"
                          data-action="edit"
                          data-id={d.id}
                          data-json={JSON.stringify({
                            id: d.id,
                            kodeTransaksi: d.kodeTransaksi,
                            tanggalTransaksi: d.createdAt ? new Date(d.createdAt).toISOString().split('T')[0] : '',
                            namaLengkap: d.donor.namaLengkap,
                            namaTampilan: d.donor.namaTampilan || '',
                            tipeDonatur: d.donor.tipeDonatur,
                            noWhatsapp: d.donor.noWhatsapp,
                            email: d.donor.email || '',
                            kotaDomisili: d.donor.kotaDomisili || '',
                            programTujuan: d.programTujuan,
                            akadPeruntukan: d.akadPeruntukan,
                            nominal: d.nominal,
                            kodeUnik: d.kodeUnik,
                            atasNamaNiat: d.atasNamaNiat || '',
                            doaDonatur: d.doaDonatur || '',
                            sumberLeads: d.sumberLeads,
                            campaignUtm: d.campaignUtm || '',
                            metodePembayaran: d.metodePembayaran,
                            statusPembayaran: d.statusPembayaran,
                            buktiTransferUrl: d.buktiTransferUrl || '',
                            catatanTransaksi: d.catatanTransaksi || '',
                          })}
                          title="Edit Transaksi & Donatur"
                        >
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none">
                            <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                            <path d="m15 5 4 4"/>
                          </svg>
                        </button>

                        <!-- Hapus -->
                        <button
                          type="button"
                          class="h-7 w-7 rounded bg-red-50 border border-red-200 text-red-600 hover:bg-red-600 hover:text-white transition-colors inline-flex items-center justify-center cursor-pointer shadow-2xs"
                          data-action="delete"
                          data-id={d.id}
                          data-kode={d.kodeTransaksi}
                          title="Hapus Transaksi"
                        >
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                          </svg>
                        </button>
                      </div>
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
      <div class="px-4 py-3 border-t border-slate-200 bg-slate-50/75 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-600">
        <!-- Per-page selection & count -->
        <div class="flex items-center gap-2.5">
          <span class="text-slate-500">Tampilkan</span>
          <select id="donationsPerPage" class="h-8 rounded-md border border-slate-200 bg-white px-2 py-0.5 text-xs font-semibold text-slate-700 shadow-2xs focus:outline-none focus:ring-1 focus:ring-slate-950 cursor-pointer">
            <option value="10">10 data</option>
            <option value="25" selected>25 data</option>
            <option value="50">50 data</option>
            <option value="all">Semua</option>
          </select>
          <span class="text-slate-500">
            dari <strong id="donationsTotalCount" class="font-semibold text-slate-800">{donations.length}</strong> data
            <span id="donationsRangeText" class="text-slate-400 text-[11px] ml-1"></span>
          </span>
        </div>

        <!-- Pagination Controls -->
        <div class="flex items-center gap-1.5" id="donationsPaginationControls">
          <button
            type="button"
            id="btnDonationsPrevPage"
            class="h-8 px-2.5 rounded-md border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 hover:text-slate-900 disabled:opacity-40 disabled:cursor-not-allowed transition-colors shadow-2xs flex items-center gap-1 font-medium cursor-pointer"
            aria-label="Halaman Sebelumnya"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
            <span class="hidden sm:inline">Sebelumnya</span>
          </button>

          <div id="donationsPageNumbers" class="flex items-center gap-1">
            <!-- Injected by JS -->
          </div>

          <button
            type="button"
            id="btnDonationsNextPage"
            class="h-8 px-2.5 rounded-md border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 hover:text-slate-900 disabled:opacity-40 disabled:cursor-not-allowed transition-colors shadow-2xs flex items-center gap-1 font-medium cursor-pointer"
            aria-label="Halaman Berikutnya"
          >
            <span class="hidden sm:inline">Berikutnya</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
  <!-- END TAB 1: RIWAYAT DONATUR & PENERIMAAN -->

  <!-- TAB 2: REALISASI ALOKASI KAS (DEBIT • KREDIT • SALDO) -->
  <div id="tabContentAlokasi" class="hidden space-y-5">
    <!-- Metrik Arus Kas (Shadcn Card Style) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-2xs">
        <div class="flex items-center justify-between pb-2">
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Total Kas Masuk (+Debit)</span>
          <div class="w-7 h-7 rounded-md bg-blue-50 text-[#0969da] flex items-center justify-center">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 5v14M19 12l-7 7-7-7"/>
            </svg>
          </div>
        </div>
        <div class="text-xl font-bold tracking-tight text-emerald-600 font-mono">+{formatRupiah(allocMetrics.totalDebit)}</div>
        <p class="text-[11px] text-slate-400 mt-1 mb-0">Total pencairan dana masuk ke kas</p>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-2xs">
        <div class="flex items-center justify-between pb-2">
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Realisasi Belanja (-Kredit)</span>
          <div class="w-7 h-7 rounded-md bg-rose-50 text-rose-600 flex items-center justify-center">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 19V5M5 12l7-7 7 7"/>
            </svg>
          </div>
        </div>
        <div class="text-xl font-bold tracking-tight text-rose-600 font-mono">-{formatRupiah(allocMetrics.totalKredit)}</div>
        <p class="text-[11px] text-slate-400 mt-1 mb-0">Pengeluaran terdistribusi &amp; belanja program</p>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-2xs">
        <div class="flex items-center justify-between pb-2">
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Saldo Kas Berjalan</span>
          <div class="w-7 h-7 rounded-md bg-slate-100 text-slate-700 flex items-center justify-center">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="5" width="20" height="14" rx="2"/>
              <line x1="2" y1="10" x2="22" y2="10"/>
            </svg>
          </div>
        </div>
        <div class={`text-xl font-bold tracking-tight font-mono ${allocMetrics.saldoAkhir >= 0 ? 'text-[#0969da]' : 'text-rose-600'}`}>
          {formatRupiah(allocMetrics.saldoAkhir)}
        </div>
        <div class="mt-1 flex items-center gap-1.5">
          <span class={`inline-flex items-center px-1.5 py-0.2 rounded text-[10px] font-semibold ${allocMetrics.saldoAkhir >= 0 ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-rose-50 text-rose-700 border border-rose-200'}`}>
            {allocMetrics.saldoAkhir >= 0 ? 'Surplus Kas' : 'Defisit Kas'}
          </span>
          <span class="text-[11px] text-slate-400">Buku Kas GVF</span>
        </div>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-2xs">
        <div class="flex items-center justify-between pb-2">
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Total Mutasi Transaksi</span>
          <div class="w-7 h-7 rounded-md bg-slate-50 text-slate-600 flex items-center justify-center">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
        </div>
        <div class="text-xl font-bold tracking-tight text-slate-900">{allocMetrics.totalTransaksi} <span class="text-xs font-medium text-slate-500">Voucher</span></div>
        <p class="text-[11px] text-slate-400 mt-1 mb-0">Debit &amp; kredit terverifikasi</p>
      </div>
    </div>

    <!-- Filter & Action Bar Alokasi Kas -->
    <div class="rounded-xl border border-slate-200 bg-white p-3.5 shadow-2xs space-y-3">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3">
        <!-- Search & Filter Controls -->
        <div class="flex flex-wrap items-center gap-2.5 flex-1">
          <!-- Input Search Realtime -->
          <div class="relative flex-1 min-w-[240px] max-w-md">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </div>
            <input
              type="text"
              id="alokasiSearchInput"
              placeholder="Cari voucher, pos belanja, uraian, atau PIC..."
              class="w-full pl-9 pr-3 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded-md focus:bg-white focus:outline-hidden focus:ring-1 focus:ring-[#0969da] focus:border-[#0969da] transition-all placeholder:text-slate-400"
            />
          </div>

          <!-- Filter Program GVF -->
          <div class="w-44">
            <select
              id="alokasiFilterProgram"
              class="w-full px-2.5 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded-md focus:bg-white focus:outline-hidden focus:ring-1 focus:ring-[#0969da] text-slate-700 cursor-pointer"
            >
              <option value="all">Semua Program GVF</option>
              <option value="wakaf">Wakaf</option>
              <option value="infaq">Infaq</option>
              <option value="sedekah">Shodaqoh</option>
              <option value="zakat">Zakat</option>
            </select>
          </div>

          <!-- Filter Jenis Transaksi -->
          <div class="w-40">
            <select
              id="alokasiFilterJenis"
              class="w-full px-2.5 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded-md focus:bg-white focus:outline-hidden focus:ring-1 focus:ring-[#0969da] text-slate-700 cursor-pointer"
            >
              <option value="all">Semua Jenis Kas</option>
              <option value="debit">+ Debit (Penerimaan)</option>
              <option value="kredit">- Kredit (Pengeluaran)</option>
            </select>
          </div>

          <button
            type="button"
            id="alokasiBtnResetFilters"
            class="h-8 px-2.5 text-xs text-slate-600 hover:text-slate-900 border border-slate-200 rounded-md hover:bg-slate-50 transition-colors cursor-pointer"
          >
            Reset
          </button>
        </div>

        <!-- Buttons Tambah Transaksi -->
        <div class="flex items-center gap-2 shrink-0">
          <button
            type="button"
            id="btnOpenCreateDebitAlokasi"
            class="inline-flex items-center gap-1.5 h-8 px-3 rounded-md text-xs font-semibold bg-[#0969da] text-white hover:bg-[#0752a8] shadow-2xs transition-colors cursor-pointer"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>+ Catat Kas Masuk</span>
          </button>

          <button
            type="button"
            id="btnOpenCreateKreditAlokasi"
            class="inline-flex items-center gap-1.5 h-8 px-3 rounded-md text-xs font-semibold bg-rose-600 text-white hover:bg-rose-700 shadow-2xs transition-colors cursor-pointer"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>- Catat Belanja</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Tabel Buku Kas Realisasi Alokasi (Shadcn Table Style) -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-2xs overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50/75 text-slate-600 font-semibold">
              <th class="py-3 px-3 text-center w-12">No</th>
              <th class="py-3 px-3 w-32">Tanggal</th>
              <th class="py-3 px-3 w-36">No. Bukti / Voucher</th>
              <th class="py-3 px-3 w-32">Program GVF</th>
              <th class="py-3 px-3 min-w-[220px]">Pos Anggaran &amp; Uraian Belanja</th>
              <th class="py-3 px-3 text-center w-24">Jenis</th>
              <th class="py-3 px-3 text-right w-36">Nominal</th>
              <th class="py-3 px-3 text-right w-36">Saldo Berjalan</th>
              <th class="py-3 px-3 text-center w-24">Nota S3</th>
              <th class="py-3 px-3 w-32">PIC Pelaksana</th>
              <th class="py-3 px-3 text-center w-20">Aksi</th>
            </tr>
          </thead>
          <tbody id="alokasiTableBody" class="divide-y divide-slate-100">
            {allocations.length === 0 ? (
              <tr id="emptyAlokasiRow">
                <td colspan="11" class="py-12 text-center text-slate-400">
                  <div class="max-w-xs mx-auto space-y-2">
                    <div class="w-10 h-10 mx-auto rounded-full bg-slate-100 text-slate-400 flex items-center justify-center">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                      </svg>
                    </div>
                    <p class="text-xs font-medium text-slate-600 m-0">Belum ada catatan realisasi alokasi kas</p>
                    <p class="text-[11px] text-slate-400 m-0">Mulai catat belanja atau kas masuk dengan tombol di atas.</p>
                  </div>
                </td>
              </tr>
            ) : (
              allocations.map((a, idx) => {
                const isDebit = a.jenisTransaksi === 'debit';
                const pKey = a.program.toLowerCase();
                const badge = programBadgeMap[pKey] || { bg: 'bg-slate-50', text: 'text-slate-700', border: 'border-slate-200' };
                const pLabel = programMap[pKey] ? programMap[pKey].split(' ')[0] : a.program;

                return (
                  <tr
                    class="alokasi-row hover:bg-slate-50/70 transition-colors"
                    data-id={a.id}
                    data-program={pKey}
                    data-jenis={a.jenisTransaksi}
                    data-search={`${a.kodeTransaksi} ${a.posAnggaran} ${a.uraian} ${a.pic || ''}`.toLowerCase()}
                  >
                    <td class="py-3 px-3 text-center text-slate-400 font-mono text-[11px]">{idx + 1}</td>
                    <td class="py-3 px-3 text-slate-600 whitespace-nowrap text-[11px] font-mono">
                      {formatDate(a.tanggalTransaksi)}
                    </td>
                    <td class="py-3 px-3 whitespace-nowrap">
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono font-semibold bg-slate-100 text-slate-800 border border-slate-200">
                        {a.kodeTransaksi}
                      </span>
                    </td>
                    <td class="py-3 px-3 whitespace-nowrap">
                      <span class={`inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold border ${badge.bg} ${badge.text} ${badge.border}`}>
                        {pLabel}
                      </span>
                    </td>
                    <td class="py-3 px-3">
                      <div class="font-semibold text-slate-900 text-xs">{a.posAnggaran}</div>
                      <div class="text-[11px] text-slate-500 line-clamp-1 mt-0.5" title={a.uraian}>
                        {a.uraian}
                      </div>
                    </td>
                    <td class="py-3 px-3 text-center whitespace-nowrap">
                      {isDebit ? (
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                          + DEBIT
                        </span>
                      ) : (
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                          - KREDIT
                        </span>
                      )}
                    </td>
                    <td class="py-3 px-3 text-right whitespace-nowrap font-mono font-bold">
                      {isDebit ? (
                        <span class="text-emerald-700">+{formatRupiah(a.nominal)}</span>
                      ) : (
                        <span class="text-rose-700">-{formatRupiah(a.nominal)}</span>
                      )}
                    </td>
                    <td class="py-3 px-3 text-right whitespace-nowrap font-mono font-semibold text-slate-900">
                      {formatRupiah(a.saldoBerjalan)}
                    </td>
                    <td class="py-3 px-3 text-center whitespace-nowrap">
                      {a.buktiNotaUrl ? (
                        <button
                          type="button"
                          class="btn-view-alokasi-proof inline-flex items-center gap-1 px-2 py-1 rounded text-[11px] font-medium bg-blue-50 text-[#0969da] border border-blue-200 hover:bg-blue-100 transition-colors cursor-pointer"
                          data-proof-url={a.buktiNotaUrl}
                          data-kode={a.kodeTransaksi}
                          title="Lihat Nota S3"
                        >
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                          </svg>
                          <span>Nota</span>
                        </button>
                      ) : (
                        <span class="text-[11px] text-slate-300 italic">-</span>
                      )}
                    </td>
                    <td class="py-3 px-3 whitespace-nowrap text-xs text-slate-600">
                      {a.pic || '-'}
                    </td>
                    <td class="py-3 px-3 text-center whitespace-nowrap">
                      <div class="inline-flex items-center gap-1">
                        <button
                          type="button"
                          class="h-7 w-7 rounded bg-blue-50 border border-blue-200 text-[#0969da] hover:bg-[#0969da] hover:text-white transition-colors inline-flex items-center justify-center cursor-pointer shadow-2xs"
                          data-action="edit-alokasi"
                          data-id={a.id}
                          data-json={JSON.stringify({
                            id: a.id,
                            program: a.program,
                            posAnggaran: a.posAnggaran,
                            uraian: a.uraian,
                            jenisTransaksi: a.jenisTransaksi,
                            nominal: a.nominal,
                            buktiNotaUrl: a.buktiNotaUrl || '',
                            pic: a.pic || '',
                            tanggalTransaksi: a.tanggalTransaksi ? new Date(a.tanggalTransaksi).toISOString().split('T')[0] : '',
                          })}
                          title="Edit Catatan Kas"
                        >
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none">
                            <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                            <path d="m15 5 4 4"/>
                          </svg>
                        </button>
                        <button
                          type="button"
                          class="h-7 w-7 rounded bg-red-50 border border-red-200 text-red-600 hover:bg-red-600 hover:text-white transition-colors inline-flex items-center justify-center cursor-pointer shadow-2xs"
                          data-action="delete-alokasi"
                          data-id={a.id}
                          data-kode={a.kodeTransaksi}
                          title="Hapus Transaksi Kas"
                        >
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                          </svg>
                        </button>
                      </div>
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
      <div class="px-4 py-3 border-t border-slate-200 bg-slate-50/75 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-600">
        <!-- Per-page selection & count -->
        <div class="flex items-center gap-2.5">
          <span class="text-slate-500">Tampilkan</span>
          <select id="alokasiPerPage" class="h-8 rounded-md border border-slate-200 bg-white px-2 py-0.5 text-xs font-semibold text-slate-700 shadow-2xs focus:outline-none focus:ring-1 focus:ring-slate-950 cursor-pointer">
            <option value="10">10 data</option>
            <option value="25" selected>25 data</option>
            <option value="50">50 data</option>
            <option value="all">Semua</option>
          </select>
          <span class="text-slate-500">
            dari <strong id="alokasiTotalCount" class="font-semibold text-slate-800">{allocations.length}</strong> transaksi
            <span id="alokasiRangeText" class="text-slate-400 text-[11px] ml-1"></span>
          </span>
        </div>

        <!-- Pagination Controls -->
        <div class="flex items-center gap-1.5" id="alokasiPaginationControls">
          <button
            type="button"
            id="btnAlokasiPrevPage"
            class="h-8 px-2.5 rounded-md border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 hover:text-slate-900 disabled:opacity-40 disabled:cursor-not-allowed transition-colors shadow-2xs flex items-center gap-1 font-medium cursor-pointer"
            aria-label="Halaman Sebelumnya"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
            <span class="hidden sm:inline">Sebelumnya</span>
          </button>

          <div id="alokasiPageNumbers" class="flex items-center gap-1">
            <!-- Injected by JS -->
          </div>

          <button
            type="button"
            id="btnAlokasiNextPage"
            class="h-8 px-2.5 rounded-md border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 hover:text-slate-900 disabled:opacity-40 disabled:cursor-not-allowed transition-colors shadow-2xs flex items-center gap-1 font-medium cursor-pointer"
            aria-label="Halaman Berikutnya"
          >
            <span class="hidden sm:inline">Berikutnya</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
  <!-- END TAB 2: REALISASI ALOKASI KAS -->

  <!-- SLIDE-OVER DRAWER ALOKASI KAS KANAN (60% VIEWPORT WIDTH) -->
  <div id="alokasiDrawerBackdrop" class="fixed inset-0 z-50 bg-slate-950/50 backdrop-blur-xs flex justify-end opacity-0 pointer-events-none transition-opacity duration-300">
    <div id="alokasiDrawerBox" class="w-full sm:w-[60vw] sm:max-w-[650px] h-full bg-white flex flex-col shadow-2xl border-l border-slate-200 transform translate-x-full transition-transform duration-300 ease-out overflow-hidden">
      <!-- Drawer Header -->
      <div class="h-16 px-6 border-b border-slate-200 flex items-center justify-between bg-white shrink-0">
        <div>
          <div class="flex items-center gap-2 mb-0.5">
            <span class="inline-flex px-1.5 py-0.5 rounded text-[10px] font-bold bg-blue-50 text-[#0969da] border border-blue-200 uppercase">
              Buku Kas Umum GVF
            </span>
            <span class="text-xs text-slate-400 font-mono">Realisasi &amp; Alokasi</span>
          </div>
          <h2 id="alokasiDrawerTitleText" class="text-base font-bold text-slate-900 m-0">Catat Realisasi Belanja / Mutasi Kas</h2>
        </div>
        <button type="button" id="btnCloseAlokasiDrawer" class="w-8 h-8 rounded-md flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors cursor-pointer" aria-label="Tutup Drawer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Drawer Body -->
      <div class="flex-1 overflow-y-auto p-6 bg-slate-50/50 space-y-4">
        <form id="alokasiEntryForm" class="space-y-4">
          <input type="hidden" id="inputAlokasiId" value="" />

          <!-- Jenis Mutasi Transaksi -->
          <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-2xs space-y-3">
            <label class="block text-xs font-semibold text-slate-700">Jenis Transaksi Kas <span class="text-red-500">*</span></label>
            <div class="grid grid-cols-2 gap-3">
              <label class="flex items-center gap-2.5 p-3 rounded-lg border border-rose-200 bg-rose-50/40 cursor-pointer hover:bg-rose-50 transition-colors">
                <input type="radio" name="alokasiJenis" id="alokasiJenisKredit" value="kredit" checked class="text-rose-600 focus:ring-rose-500" />
                <div>
                  <div class="text-xs font-bold text-rose-700">- Kredit (Belanja / Alokasi)</div>
                  <div class="text-[10px] text-slate-500">Pengeluaran program &amp; fisik</div>
                </div>
              </label>
              <label class="flex items-center gap-2.5 p-3 rounded-lg border border-emerald-200 bg-emerald-50/40 cursor-pointer hover:bg-emerald-50 transition-colors">
                <input type="radio" name="alokasiJenis" id="alokasiJenisDebit" value="debit" class="text-emerald-600 focus:ring-emerald-500" />
                <div>
                  <div class="text-xs font-bold text-emerald-700">+ Debit (Kas Masuk)</div>
                  <div class="text-[10px] text-slate-500">Penerimaan &amp; droping dana</div>
                </div>
              </label>
            </div>
          </div>

          <!-- Rincian Transaksi -->
          <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-2xs space-y-3">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Program GVF <span class="text-red-500">*</span></label>
                <select id="inputAlokasiProgram" class="w-full px-3 py-1.5 text-xs bg-white border border-slate-200 rounded-md focus:outline-hidden focus:ring-1 focus:ring-[#0969da] text-slate-800">
                  <option value="wakaf">Wakaf</option>
                  <option value="infaq">Infaq</option>
                  <option value="sedekah">Shodaqoh</option>
                  <option value="zakat">Zakat</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Tanggal Transaksi <span class="text-red-500">*</span></label>
                <input type="date" id="inputAlokasiTanggal" class="w-full px-3 py-1.5 text-xs bg-white border border-slate-200 rounded-md focus:outline-hidden focus:ring-1 focus:ring-[#0969da] text-slate-800" />
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Pos Anggaran / Kategori Belanja <span class="text-red-500">*</span></label>
              <input type="text" id="inputAlokasiPos" list="posAnggaranSuggestions" placeholder="Misal: Operasional Dakwah, Pembangunan Fisik, Santunan Dhuafa" class="w-full px-3 py-1.5 text-xs bg-white border border-slate-200 rounded-md focus:outline-hidden focus:ring-1 focus:ring-[#0969da] text-slate-800 placeholder:text-slate-400" />
              <datalist id="posAnggaranSuggestions">
                <option value="Operasional &amp; Fasilitas Masjid" />
                <option value="Pembangunan Fisik &amp; Renovasi" />
                <option value="Nutrisi, Pangan &amp; Beras Santri" />
                <option value="Bantuan Dhuafa &amp; Fisabilillah" />
                <option value="Logistik &amp; Transportasi Dakwah" />
                <option value="Honorarium &amp; Ujrah Asatidz" />
                <option value="Media, Dakwah &amp; Syiar" />
              </datalist>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Nominal Transaksi (Rp) <span class="text-red-500">*</span></label>
              <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-xs text-slate-400 font-semibold pointer-events-none">Rp</span>
                <input type="number" id="inputAlokasiNominal" min="1" step="1000" placeholder="0" class="w-full pl-9 pr-3 py-1.5 text-xs font-mono font-bold bg-white border border-slate-200 rounded-md focus:outline-hidden focus:ring-1 focus:ring-[#0969da] text-slate-900" />
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Uraian Kebutuhan / Keterangan Realisasi <span class="text-red-500">*</span></label>
              <textarea id="inputAlokasiUraian" rows="3" placeholder="Rincikan peruntukan dana, nama vendor/toko, atau rincian item belanja..." class="w-full px-3 py-2 text-xs bg-white border border-slate-200 rounded-md focus:outline-hidden focus:ring-1 focus:ring-[#0969da] text-slate-800 placeholder:text-slate-400 resize-y"></textarea>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">PIC / Penanggung Jawab Pelaksana</label>
              <input type="text" id="inputAlokasiPic" placeholder="Misal: Ustadz Ahmad / Amil Lapangan GVF" class="w-full px-3 py-1.5 text-xs bg-white border border-slate-200 rounded-md focus:outline-hidden focus:ring-1 focus:ring-[#0969da] text-slate-800 placeholder:text-slate-400" />
            </div>
          </div>

          <!-- Upload Nota / Kwitansi S3 -->
          <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-2xs space-y-2">
            <label class="block text-xs font-semibold text-slate-700">Lampiran Nota / Bukti Pengeluaran (MinIO S3)</label>
            <input type="hidden" id="inputAlokasiNotaUrl" value="" />
            <input type="file" id="alokasiNotaFileInput" accept="image/*,.pdf" class="hidden" />

            <div id="alokasiDropzoneContainer" class="border-2 border-dashed border-slate-200 hover:border-[#0969da] rounded-lg p-4 text-center cursor-pointer transition-colors bg-slate-50/50">
              <div id="alokasiDropzoneEmpty" class="flex flex-col items-center justify-center space-y-1.5">
                <div class="w-8 h-8 rounded-full bg-blue-50 text-[#0969da] flex items-center justify-center">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="17 8 12 3 7 8"></polyline>
                    <line x1="12" y1="3" x2="12" y2="15"></line>
                  </svg>
                </div>
                <div class="text-xs font-semibold text-slate-700">Klik atau Tarik File Nota ke Sini</div>
                <div class="text-[10px] text-slate-400">PNG, JPG, JPEG atau PDF maks 10MB</div>
              </div>

              <div id="alokasiDropzoneUploading" class="hidden flex-col items-center justify-center space-y-2 py-2">
                <div class="w-5 h-5 border-2 border-[#0969da] border-t-transparent rounded-full animate-spin"></div>
                <span class="text-xs font-medium text-slate-600">Mengunggah ke MinIO S3...</span>
              </div>

              <div id="alokasiDropzonePreview" class="hidden flex-col items-center justify-center space-y-2">
                <img id="alokasiUploadedPreview" src="" alt="Pratinjau Nota" class="max-h-24 rounded border border-slate-200 object-contain shadow-2xs" />
                <div class="flex items-center gap-2">
                  <span id="alokasiUploadedFileName" class="text-xs font-mono text-slate-700 truncate max-w-[200px]"></span>
                  <button type="button" id="btnRemoveAlokasiNota" class="text-xs text-rose-600 hover:underline font-semibold cursor-pointer">Hapus</button>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>

      <!-- Drawer Footer -->
      <div class="h-14 px-6 border-t border-slate-200 flex items-center justify-end gap-2.5 bg-white shrink-0">
        <button type="button" id="btnCancelAlokasiDrawer" class="h-9 px-4 rounded-md border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors cursor-pointer">
          Batal
        </button>
        <button type="button" id="btnSubmitAlokasi" class="h-9 px-4 rounded-md bg-[#0969da] text-white text-xs font-semibold hover:bg-[#0752a8] shadow-xs transition-colors cursor-pointer inline-flex items-center gap-2">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span id="btnSubmitAlokasiText">Simpan Transaksi Kas</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Modal Konfirmasi Hapus Transaksi Kas -->
  <div id="deleteAlokasiModal" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-white rounded-lg border border-slate-200 max-w-sm w-full p-5 shadow-xl flex flex-col space-y-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-red-100 text-red-600 flex items-center justify-center shrink-0">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 6h18"></path>
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            <line x1="10" y1="11" x2="10" y2="17"></line>
            <line x1="14" y1="11" x2="14" y2="17"></line>
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-slate-900 m-0">Hapus Transaksi Kas?</h3>
          <p class="text-xs text-slate-500 mt-0.5 mb-0">Tindakan ini akan mempengaruhi saldo berjalan.</p>
        </div>
      </div>
      <p class="text-xs text-slate-600 bg-slate-50 p-2.5 rounded border border-slate-200 m-0 leading-relaxed">
        Voucher kas <strong id="deleteTargetAlokasiKode" class="font-mono text-slate-900"></strong> akan dihapus permanen dari buku besar GVF.
      </p>
      <div class="flex items-center justify-end gap-2 pt-1">
        <button type="button" id="btnCancelDeleteAlokasiModal" class="h-8 px-3 rounded-md border border-slate-200 bg-white text-xs font-medium text-slate-700 hover:bg-slate-50 transition-colors cursor-pointer">
          Batal
        </button>
        <button type="button" id="btnExecuteDeleteAlokasiModal" class="h-8 px-3 rounded-md bg-red-600 text-white text-xs font-semibold hover:bg-red-700 transition-colors cursor-pointer shadow-2xs">
          Ya, Hapus Transaksi
        </button>
      </div>
    </div>
  </div>

  <!-- Modal Pratinjau Bukti Transfer S3 -->
  <div id="proofModal" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs hidden items-center justify-center p-4">
      <div class="bg-white rounded-lg border border-slate-200 max-w-lg w-full overflow-hidden shadow-xl flex flex-col">
        <div class="h-12 px-4 border-b border-slate-200 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-slate-800">Bukti Transfer:</span>
            <span id="proofCodeBadge" class="font-mono text-xs font-bold text-[#0969da] bg-blue-50 px-2 py-0.5 rounded border border-blue-200"></span>
          </div>
          <button type="button" id="btnCloseProof" class="text-slate-400 hover:text-slate-700 p-1 rounded hover:bg-slate-100 cursor-pointer">
