---
// src/pages/admin/donatur/index.astro
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { 
  getAllDonationsWithDonors, 
  getDonationDashboardMetrics,
  getAllCashAllocations,
  getCashAllocationMetrics,
  getAllLabels
} from '../../../lib/db';

import DonationsTable from '../../../components/admin/donatur/DonationsTable.astro';
import AllocationsTab from '../../../components/admin/donatur/AllocationsTab.astro';
import AllocationModal from '../../../components/admin/donatur/AllocationModal.astro';
import DonationFormModal from '../../../components/admin/donatur/DonationFormModal.astro';
import LabelManagementModal from '../../../components/admin/donatur/LabelManagementModal.astro';
import DonorDetailDrawer from '../../../components/admin/donatur/DonorDetailDrawer.astro';

const donations = await getAllDonationsWithDonors();
const metrics = await getDonationDashboardMetrics();
const allocations = await getAllCashAllocations();
const allocMetrics = await getCashAllocationMetrics();
const allLabels = await getAllLabels();

const activeTabParam = Astro.url.searchParams.get('tab');
const isAlokasiTab = activeTabParam === 'alokasi';

const labelColorMap: Record<string, { bg: string; text: string; border: string }> = {
  blue: { bg: 'bg-blue-50', text: 'text-blue-700', border: 'border-blue-200' },
  emerald: { bg: 'bg-emerald-50', text: 'text-emerald-700', border: 'border-emerald-200' },
  amber: { bg: 'bg-amber-50', text: 'text-amber-800', border: 'border-amber-200' },
  rose: { bg: 'bg-rose-50', text: 'text-rose-700', border: 'border-rose-200' },
  cyan: { bg: 'bg-cyan-50', text: 'text-cyan-700', border: 'border-cyan-200' },
  slate: { bg: 'bg-slate-100', text: 'text-slate-700', border: 'border-slate-200' },
  indigo: { bg: 'bg-indigo-50', text: 'text-indigo-700', border: 'border-indigo-200' },
};

// Formatter Rupiah
const formatRupiah = (val: number) => {
  return new Intl.NumberFormat('id-ID', {
    style: 'currency',
    currency: 'IDR',
    maximumFractionDigits: 0,
  }).format(val);
};

// Formatter Tanggal
const formatDate = (date: Date | string | null) => {
  if (!date) return '-';
  return new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  }).format(new Date(date));
};

const leadsMap: Record<string, { label: string; bg: string; text: string; border: string }> = {
  meta_ads: { label: 'Meta Ads', bg: 'bg-blue-50', text: 'text-blue-700', border: 'border-blue-200' },
  tiktok_ads: { label: 'TikTok Ads', bg: 'bg-slate-900', text: 'text-white', border: 'border-slate-800' },
  google_seo: { label: 'Google SEO', bg: 'bg-sky-50', text: 'text-sky-700', border: 'border-sky-200' },
  safari_dakwah: { label: 'Safari Dakwah', bg: 'bg-amber-50', text: 'text-amber-800', border: 'border-amber-200' },
  brosur_event: { label: 'Brosur & Event', bg: 'bg-cyan-50', text: 'text-cyan-700', border: 'border-cyan-200' },
  relasi_langsung: { label: 'Relasi Langsung', bg: 'bg-emerald-50', text: 'text-emerald-700', border: 'border-emerald-200' },
  walk_in: { label: 'Walk-in', bg: 'bg-orange-50', text: 'text-orange-700', border: 'border-orange-200' },
};

const programMap: Record<string, string> = {
  'wakaf': 'Wakaf (Wakaf Produktif & Lahan)',
  'infaq': 'Infaq (Infaq Pembangunan Fisik)',
  'sedekah': 'Shodaqoh (Sedekah Nutrisi & Pangan)',
  'zakat': 'Zakat (Zakat Maal & Fitrah)',
};

const programBadgeMap: Record<string, { bg: string; text: string; border: string }> = {
  wakaf: { bg: 'bg-blue-50', text: 'text-blue-700', border: 'border-blue-200' },
  infaq: { bg: 'bg-emerald-50', text: 'text-emerald-700', border: 'border-emerald-200' },
  sedekah: { bg: 'bg-sky-50', text: 'text-sky-700', border: 'border-sky-200' },
  zakat: { bg: 'bg-amber-50', text: 'text-amber-800', border: 'border-amber-200' },
};
---

<AdminLayout title="Kelola Donatur & Leads" activeSlug="donatur">
  <div class="w-full space-y-5">
    <!-- Top Header (Shadcn Style) -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-blue-50 text-[#0969da] border border-blue-200">
            Pusat Pengelolaan Dana GVF
          </span>
          <span class="text-slate-300 text-xs">&bull;</span>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            MinIO S3 Terkoneksi
          </span>
        </div>
        <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 m-0">Pengelolaan Donatur &amp; Arus Kas GVF</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1 mb-0">
          Pusat terpadu kelola data muhsinin, penerimaan donasi, verifikasi status, serta buku kas realisasi belanja (Debit - Kredit - Saldo).
        </p>
      </div>

      <div class="flex items-center gap-2.5 shrink-0 flex-wrap">
        <button
          type="button"
          id="btnOpenLabelsModal"
          class="inline-flex items-center justify-center gap-2 h-9 px-3 rounded-md text-xs font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 shadow-2xs transition-colors cursor-pointer"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"></path>
            <path d="M7 7h.01"></path>
          </svg>
          <span>Kelola Label (<span id="headerLabelsCount">{allLabels.length}</span>)</span>
        </button>
        <button
          type="button"
          id="btnOpenCreateDonation"
          class="inline-flex items-center justify-center gap-2 h-9 px-4 rounded-md text-xs font-semibold bg-[#0969da] text-white hover:bg-[#0752a8] shadow-xs transition-colors cursor-pointer"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>+ Catat Donasi Baru</span>
        </button>
        <button
          type="button"
          id="btnOpenCreateAlokasiHeader"
          class="inline-flex items-center justify-center gap-2 h-9 px-4 rounded-md text-xs font-semibold bg-white border border-slate-200 text-slate-800 hover:bg-slate-50 shadow-2xs transition-colors cursor-pointer"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
          </svg>
          <span>+ Catat Kas / Belanja</span>
        </button>
      </div>
    </div>

    <!-- Tab Navigation (Shadcn Tabs List) -->
    <div class="flex items-center gap-1 border-b border-slate-200 pb-px">
      <button
        type="button"
        id="tabBtnDonatur"
        class={`tab-btn inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-lg transition-all cursor-pointer ${
          !isAlokasiTab
            ? 'border-b-2 border-[#0969da] text-[#0969da] bg-blue-50/50'
            : 'border-b-2 border-transparent text-slate-500 hover:text-slate-800 hover:bg-slate-50'
        }`}
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
        <span>Data Donatur &amp; Penerimaan</span>
        <span class="inline-flex items-center px-1.5 py-0.2 rounded text-[10px] font-bold bg-blue-100 text-[#0969da]">
          {donations.length}
        </span>
      </button>

      <button
        type="button"
        id="tabBtnAlokasi"
        class={`tab-btn inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-lg transition-all cursor-pointer ${
          isAlokasiTab
            ? 'border-b-2 border-[#0969da] text-[#0969da] bg-blue-50/50'
            : 'border-b-2 border-transparent text-slate-500 hover:text-slate-800 hover:bg-slate-50'
        }`}
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="1" x2="12" y2="23"></line>
          <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
        </svg>
        <span>Buku Kas &amp; Realisasi Alokasi</span>
        <span class="inline-flex items-center px-1.5 py-0.2 rounded text-[10px] font-bold bg-slate-100 text-slate-600">
          {allocations.length}
        </span>
      </button>
    </div>

    <!-- TAB 1: RIWAYAT DONATUR & PENERIMAAN -->
    <DonationsTable
      donations={donations}
      metrics={metrics}
      allLabels={allLabels}
      leadsMap={leadsMap}
      programMap={programMap}
      labelColorMap={labelColorMap}
      formatRupiah={formatRupiah}
      formatDate={formatDate}
      isAlokasiTab={isAlokasiTab}
    />

    <!-- TAB 2: REALISASI ALOKASI KAS (DEBIT • KREDIT • SALDO) -->
    <AllocationsTab
      allocations={allocations}
      allocMetrics={allocMetrics}
      programMap={programMap}
      programBadgeMap={programBadgeMap}
      formatRupiah={formatRupiah}
      formatDate={formatDate}
      isAlokasiTab={isAlokasiTab}
    />

    <!-- MODAL & SLIDE-OVER DRAWER SUBCOMPONENTS -->
    <AllocationModal />
    <DonationFormModal />
    <LabelManagementModal allLabels={allLabels} />
    <DonorDetailDrawer allLabels={allLabels} labelColorMap={labelColorMap} />
  </div>
</AdminLayout>

<script src="../../../scripts/admin/donatur.ts"></script>
