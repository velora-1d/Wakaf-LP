---
// src/pages/contact.astro
// Halaman Kontak & Layanan Donatur Sesuai Desain Pen.dev (Node AlCVn)
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Layanan Donatur & Kontak Kami • Global Village Fund"
  description="Konsultasi program wakaf produktif, zakat, infaq, sedekah, dan kemitraan kolaborasi bersama tim pengurus resmi Global Village Fund."
>
  <!-- 1. Header Banner & Breadcrumb ala Pen.dev -->
  <section class="pen-contact-banner">
    <div class="pen-banner-bg"></div>
    <div class="pen-banner-overlay"></div>
    <div class="pen-banner-container">
      <h1 class="pen-banner-title">Layanan Donatur & Kontak</h1>
      <div class="pen-breadcrumb-wrap">
        <a href="/" class="pen-breadcrumb-link">BERANDA</a>
        <span class="pen-breadcrumb-sep">-</span>
        <span class="pen-breadcrumb-current">KONTAK KAMI</span>
      </div>
    </div>
  </section>

  <!-- 2. Form & Info Kontak 2-Kolom Sesuai Pen.dev -->
  <section class="pen-contact-main-section">
    <div class="pen-container">
      <div class="pen-contact-header">
        <div class="pen-badge-pill">
          <span class="pen-badge-dot"></span>
          <span class="pen-badge-text">LAYANAN KONSULTASI DONATUR</span>
        </div>
        <h2 class="pen-contact-title">
          Punya Niat Kebaikan & Pertanyaan?<br />
          Konsultasikan Bersama Kami
        </h2>
        <p class="pen-contact-lead">
          Bicaralah dengan tim pengurus dan nazhir kami, tanpa kewajiban dan tanpa tekanan. Kami siap memandu Anda dari niat awal, akad donasi, hingga penerbitan akta ikrar wakaf dan laporan dampak riil.
        </p>
      </div>

      <div class="pen-contact-grid">
        <!-- Kolom Kiri: Informasi Kantor & Saluran Kontak -->
        <div class="pen-contact-info-col">
          <div class="pen-info-card">
            <!-- Item 1: Alamat -->
            <div class="pen-info-item">
              <span class="pen-info-label">Alamat Kantor & Lokasi Kawasan</span>
              <p class="pen-info-text">
                Kawasan Pesantren Integratif Holistik SMK Skill Village,<br />
                Desa Sukasirna, Kec. Jonggol, Kab. Bogor, Jawa Barat 16830
              </p>
            </div>

            <!-- Item 2: Saluran Kontak -->
            <div class="pen-info-item">
              <span class="pen-info-label">Kontak Resmi & Fast Response</span>
              <div class="pen-contact-links">
                <a href="tel:+6281226832326" class="pen-link-phone">
                  +62 812-2683-2326
                </a>
                <a
                  href="https://wa.me/6281226832326?text=Assalamualaikum%20Admin%20GVF%2C%20saya%20ingin%20konsultasi%20program%20donasi."
                  target="_blank"
                  rel="noopener noreferrer"
                  class="pen-link-wa"
                >
                  <span>💬 Chat WhatsApp Resmi</span>
                  <span class="pen-wa-badge">Online</span>
                </a>
                <a href="mailto:info@globalvillagefund.org" class="pen-link-email">
                  ✉️ info@globalvillagefund.org
                </a>
              </div>
            </div>

            <!-- Item 3: Media Sosial & Website -->
            <div class="pen-info-item">
              <span class="pen-info-label">Media Sosial & Situs Resmi</span>
              <div class="pen-social-stack">
                <a href="https://instagram.com/globalvillagefund" target="_blank" rel="noopener noreferrer" class="pen-social-link">
                  📸 Instagram: @globalvillagefund
                </a>
                <a href="https://globalvillagefund.org" target="_blank" rel="noopener noreferrer" class="pen-social-link">
                  🌐 Website: www.globalvillagefund.org
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Kolom Kanan: Form Konsultasi Interaktif Pen.dev -->
        <div class="pen-contact-form-col">
          <form id="gvfContactForm" class="pen-contact-form">
            <div class="pen-form-row">
              <div class="pen-form-group">
                <label for="contactFullName" class="pen-form-label">Nama Lengkap *</label>
                <input
                  type="text"
                  id="contactFullName"
                  name="fullname"
                  class="pen-form-input"
                  placeholder="Nama lengkap Anda"
                  required
                />
              </div>
              <div class="pen-form-group">
                <label for="contactPhone" class="pen-form-label">Nomor WhatsApp / Telepon *</label>
                <input
                  type="tel"
                  id="contactPhone"
                  name="phone"
                  class="pen-form-input"
                  placeholder="0812-xxxx-xxxx"
                  required
                />
              </div>
            </div>

            <div class="pen-form-row">
              <div class="pen-form-group">
                <label for="contactEmail" class="pen-form-label">Alamat Email *</label>
                <input
                  type="email"
                  id="contactEmail"
                  name="email"
                  class="pen-form-input"
                  placeholder="email@anda.com"
                  required
                />
              </div>
              <div class="pen-form-group">
                <label for="contactProgram" class="pen-form-label">Pilihan Program *</label>
                <select id="contactProgram" name="program" class="pen-form-select" required>
                  <option value="" disabled selected>Pilih Program Donasi / Kemitraan</option>
                  <option value="wakaf">Wakaf Pembangunan Masjid & Sarana Vokasi</option>
                  <option value="infaq">Infaq Pendidikan & Sarana Belajar Santri</option>
                  <option value="sedekah">Sedekah Pangan Santri & Makan Bergizi</option>
                  <option value="zakat">Zakat Maal & Zakat Fitrah Terpadu</option>
                  <option value="kemitraan">Kemitraan Multipihak / CSR Korporasi</option>
                </select>
              </div>
            </div>

            <div class="pen-form-group">
              <label for="contactMessage" class="pen-form-label">Pesan / Rencana Kebaikan *</label>
              <textarea
                id="contactMessage"
                name="message"
                rows="4"
                class="pen-form-textarea"
                placeholder="Ceritakan rencana donasi, pertanyaan, atau bentuk kemitraan yang ingin Anda jalankan..."
                required
              ></textarea>
            </div>

            <button type="submit" class="pen-btn-submit">
              Kirim Pesan Konsultasi
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Peta Lokasi Kawasan Pesantren Sukasirna Jonggol -->
  <section class="pen-map-section">
    <div class="pen-container">
      <div class="pen-map-wrapper">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15858.749503460775!2d107.0326401!3d-6.4341142!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69bb0d5db6efef%3A0x7d6a54625b65a587!2sSukasirna%2C%20Jonggol%2C%20Bogor%20Regency%2C%20West%20Java!5e0!3m2!1sen!2sid!4v1700000000000!5m2!1sen!2sid"
          width="100%"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Peta Lokasi Pesantren Sukasirna Jonggol"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* 1. Header Banner */
  .pen-contact-banner {
    position: relative;
    background-color: #061829;
    padding: 140px 0 90px 0;
    overflow: hidden;
    text-align: center;
  }
  .pen-banner-bg {
    position: absolute;
    inset: 0;
    background-image: url('https://wakaf-lp.vercel.app/gambar%20design/interior%20masjid.jpg');
    background-size: cover;
    background-position: center;
    opacity: 0.3;
    z-index: 0;
  }
  .pen-banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(6, 24, 41, 0.88) 0%, rgba(6, 24, 41, 0.96) 100%);
    z-index: 1;
  }
  .pen-banner-container {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .pen-banner-title {
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 800;
    color: #ffffff;
    font-family: 'Cal Sans', 'Golos Text', sans-serif;
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem 0;
  }
  .pen-breadcrumb-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .pen-breadcrumb-link {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s;
  }
  .pen-breadcrumb-link:hover {
    color: #ffffff;
  }
  .pen-breadcrumb-sep {
    color: #64748b;
  }
  .pen-breadcrumb-current {
    color: #0969da;
  }

  /* Universal Container */
  .pen-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .pen-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 6px 16px;
    border-radius: 9999px;
    background: rgba(9, 105, 218, 0.08);
    border: 1px solid rgba(9, 105, 218, 0.2);
    margin-bottom: 1.25rem;
  }
  .pen-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #0969da;
  }
  .pen-badge-text {
    font-size: 0.75rem;
    font-weight: 800;
    color: #0969da;
    letter-spacing: 0.1em;
  }

  /* 2. Contact Main Section */
  .pen-contact-main-section {
    background-color: #ffffff;
    padding: 100px 0 80px 0;
  }
  .pen-contact-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 4.5rem auto;
  }
  .pen-contact-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    color: #0f172a;
    font-family: 'Cal Sans', sans-serif;
    line-height: 1.25;
    margin: 0 0 1.25rem 0;
  }
  .pen-contact-lead {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #64748b;
    margin: 0;
  }

  .pen-contact-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 3.5rem;
    align-items: flex-start;
  }

  /* Left Column: Info Card */
  .pen-info-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .pen-info-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .pen-info-label {
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #0969da;
    text-transform: uppercase;
  }
  .pen-info-text {
    font-size: 1rem;
    line-height: 1.6;
    color: #1e293b;
    margin: 0;
  }
  .pen-contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .pen-link-phone {
    font-size: 1.25rem;
    font-weight: 800;
    color: #0f172a;
    text-decoration: none;
    font-family: 'Cal Sans', sans-serif;
  }
  .pen-link-wa {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    color: #065f46;
    font-size: 0.95rem;
    font-weight: 700;
    padding: 10px 18px;
    border-radius: 12px;
    text-decoration: none;
    width: fit-content;
    transition: background 0.2s;
  }
  .pen-link-wa:hover {
    background: #d1fae5;
  }
  .pen-wa-badge {
    background: #10b981;
    color: #ffffff;
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 9999px;
  }
  .pen-link-email {
    font-size: 0.95rem;
    color: #475569;
    text-decoration: none;
  }
  .pen-link-email:hover {
    color: #0969da;
  }
  .pen-social-stack {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .pen-social-link {
    font-size: 0.92rem;
    color: #334155;
    text-decoration: none;
    font-weight: 600;
  }
  .pen-social-link:hover {
    color: #0969da;
  }

  /* Right Column: Form */
  .pen-contact-form {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    padding: 2.5rem;
    box-shadow: 0 8px 30px rgba(0,0,0,0.04);
  }
  .pen-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }
  .pen-form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .pen-form-label {
    font-size: 0.88rem;
    font-weight: 700;
    color: #1e293b;
  }
  .pen-form-input,
  .pen-form-select,
  .pen-form-textarea {
    width: 100%;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    padding: 12px 16px;
    font-size: 0.95rem;
    color: #0f172a;
    background: #f8fafc;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    font-family: inherit;
  }
  .pen-form-input:focus,
  .pen-form-select:focus,
  .pen-form-textarea:focus {
    border-color: #0969da;
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(9, 105, 218, 0.12);
  }
  .pen-btn-submit {
    width: 100%;
    background-color: #0969da;
    color: #ffffff;
    border: none;
    border-radius: 12px;
    padding: 16px;
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(9, 105, 218, 0.25);
    transition: background-color 0.2s, transform 0.15s;
    margin-top: 0.5rem;
  }
  .pen-btn-submit:hover {
    background-color: #0349b4;
    transform: translateY(-1px);
  }

  /* 3. Map Section */
  .pen-map-section {
    padding-bottom: 100px;
    background-color: #ffffff;
  }
  .pen-map-wrapper {
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 8px 28px rgba(0,0,0,0.06);
    border: 1px solid #e2e8f0;
  }

  @media (max-width: 1024px) {
    .pen-contact-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .pen-contact-banner {
      padding: 110px 0 60px 0;
    }
    .pen-form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Handle form submission: redirect directly to WhatsApp with pre-filled message
  const form = document.getElementById('gvfContactForm');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const target = e.target as HTMLFormElement;
      const formData = new FormData(target);
      const fullname = formData.get('fullname') || '';
      const phone = formData.get('phone') || '';
      const email = formData.get('email') || '';
      const program = formData.get('program') || '';
      const message = formData.get('message') || '';

      const waText = `Assalamualaikum Admin GVF, saya ingin konsultasi:\n\n*Nama:* ${fullname}\n*No HP:* ${phone}\n*Email:* ${email}\n*Program:* ${program}\n*Pesan:* ${message}`;
      const waUrl = `https://wa.me/6281226832326?text=${encodeURIComponent(waText)}`;
      window.open(waUrl, '_blank');
    });
  }
</script>
