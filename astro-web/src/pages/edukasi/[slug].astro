---
// src/pages/edukasi/[slug].astro
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNewsArticleBySlug, getActiveNewsArticles } from '../../lib/db';
import { verifySessionToken } from '../../lib/auth';
import { getArticleSchema, getBreadcrumbSchema } from '../../lib/seo-schema';

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/edukasi');
}

const article = await getNewsArticleBySlug(slug);
const sessionCookie = Astro.cookies.get('gvf_admin_session')?.value;
const isAdmin = sessionCookie ? Boolean(verifySessionToken(sessionCookie)) : false;
const canView = article && (article.isPublished || isAdmin);

if (!canView) {
  Astro.response.status = 404;
}

const allEdu = await getActiveNewsArticles(6, 'edukasi');
const relatedArticles = allEdu.filter((a) => a.id !== article?.id).slice(0, 3);

function extractYoutubeEmbed(url: string | null | undefined): string | null {
  if (!url) return null;
  const watchMatch = url.match(/[?&]v=([a-zA-Z0-9_-]{11})/);
  if (watchMatch) return `https://www.youtube.com/embed/${watchMatch[1]}`;
  const shortMatch = url.match(/youtu\.be\/([a-zA-Z0-9_-]{11})/);
  if (shortMatch) return `https://www.youtube.com/embed/${shortMatch[1]}`;
  const embedMatch = url.match(/youtube\.com\/embed\/([a-zA-Z0-9_-]{11})/);
  if (embedMatch) return `https://www.youtube.com/embed/${embedMatch[1]}`;
  return null;
}

const embedUrl = extractYoutubeEmbed(article?.videoUrl);
const paragraphs = article?.content ? article.content.split(/\n\s*\n/).filter((p) => p.trim().length > 0) : [];

const siteUrl = (Astro.site ? Astro.site.toString() : 'https://globalvillagefund.org').replace(/\/$/, '');
const schemas = article
  ? [
      getBreadcrumbSchema(
        [
          { name: 'Beranda', url: '/' },
          { name: 'Edukasi & Kajian', url: '/edukasi' },
          { name: article.title, url: `/edukasi/${article.slug}` },
        ],
        siteUrl
      ),
      getArticleSchema(
        {
          title: article.title,
          summary: article.summary,
          slug: article.slug,
          coverImage: article.coverImage,
          createdAt: article.publishedAt || article.createdAt,
          updatedAt: article.updatedAt,
          author: article.author || 'Tim GVF',
        },
        siteUrl
      ),
    ]
  : null;
---

<BaseLayout
  title={article ? `${article.title} • Edukasi & Kajian GVF` : 'Materi Tidak Ditemukan • Global Village Fund'}
  description={article?.summary || 'Edukasi dan kajian syariah Global Village Fund.'}
  ogImage={article?.coverImage || '/logo-gvf.png'}
  ogType="article"
  schema={schemas}
  noindex={!canView || !article?.isPublished}
>
  {!canView ? (
    <section style="min-height: 70vh; display: flex; align-items: center; justify-content: center; padding: 140px 24px 80px; background: #f7f7f8;">
      <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 20px; padding: 40px; text-align: center; max-width: 480px;">
        <h1 style="margin: 0 0 10px; font-size: 24px; font-weight: 700; color: #0f172a;">Materi Tidak Ditemukan</h1>
        <p style="margin: 0 0 24px; font-size: 14px; color: #64748b;">Materi kajian yang Anda cari belum tersedia atau telah dihapus.</p>
        <a href="/edukasi" style="display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 24px; border-radius: 9999px; background: #0969da; color: #ffffff; font-size: 14px; font-weight: 700; text-decoration: none;">
          Kembali ke Direktori Edukasi
        </a>
      </div>
    </section>
  ) : (
    <article style="background: #f7f7f8; padding-bottom: 96px;">
      <section style="background: #061829; padding: 136px 24px 64px; color: #ffffff;">
        <div style="max-width: 920px; margin: 0 auto;">
          <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 14px; font-size: 12px; font-weight: 700;">
            <a href="/edukasi" style="color: #7dd3fc; text-decoration: none;">EDUKASI &amp; KAJIAN</a>
            <span style="color: #64748b;">/</span>
            <span style="color: #bfdbfe;">{article!.category}</span>
          </div>
          <h1 style="margin: 0 0 16px; font-size: clamp(28px, 4vw, 44px); font-weight: 700; line-height: 1.2; color: #ffffff;">
            {article!.title}
          </h1>
          <div style="display: flex; flex-wrap: wrap; gap: 12px; font-size: 14px; color: #cbd5e1;">
            <span>Pemateri: <strong style="color: #ffffff;">{article!.author || 'Tim GVF'}</strong></span>
            <span>&bull;</span>
            <span>{article!.publishedAt}</span>
          </div>
        </div>
      </section>

      <div style="max-width: 920px; margin: -24px auto 0; padding: 0 24px;">
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 24px; overflow: hidden; box-shadow: 0 10px 30px rgba(15,23,42,0.06);">
          <div style="aspect-ratio: 16 / 9; background: #0f172a; overflow: hidden;">
            <img src={article!.coverImage} alt={article!.title} style="width: 100%; height: 100%; object-fit: cover;" />
          </div>

          <div style="padding: 36px; display: flex; flex-direction: column; gap: 20px;">
            <p style="margin: 0; font-size: 18px; line-height: 1.65; font-weight: 600; color: #0f172a; border-left: 4px solid #0969da; padding-left: 16px;">
              {article!.summary}
            </p>

            {embedUrl && (
              <div style="border-radius: 16px; overflow: hidden; border: 1px solid #e2e8f0; aspect-ratio: 16 / 9; background: #0f172a;">
                <iframe
                  src={embedUrl}
                  title={`Video Kajian: ${article!.title}`}
                  style="width: 100%; height: 100%; border: 0;"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
            )}

            {article!.attachmentUrl && (
              <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 16px; padding: 16px 20px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px;">
                <div>
                  <span style="display: block; font-size: 11px; font-weight: 700; color: #0969da; text-transform: uppercase;">Lampiran Materi Kajian</span>
                  <strong style="font-size: 14px; color: #0f172a;">Dokumen Modul PDF Siap Diunduh</strong>
                </div>
                <a
                  href={article!.attachmentUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  style="display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 20px; border-radius: 9999px; background: #0969da; color: #ffffff; font-size: 13px; font-weight: 700; text-decoration: none;"
                >
                  Unduh Materi PDF
                </a>
              </div>
            )}

            <div style="display: flex; flex-direction: column; gap: 16px; font-size: 16px; line-height: 1.8; color: #334155;">
              {paragraphs.map((p) => (
                <p style="margin: 0;">{p}</p>
              ))}
            </div>

            <!-- CTA Kontribusi -->
            <div style="margin-top: 16px; padding: 24px; border-radius: 18px; background: #0f172a; color: #ffffff; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px;">
              <div>
                <h3 style="margin: 0 0 4px; font-size: 18px; font-weight: 700; color: #ffffff;">Wujudkan Ilmu Menjadi Amal Nyata</h3>
                <p style="margin: 0; font-size: 14px; color: #cbd5e1;">Salurkan Infak Material Masjid, Sedekah GOTA SSM, Wakaf, atau Zakat melalui GVF.</p>
              </div>
              <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                <a href="/kontribusi/wakaf" style="display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 18px; border-radius: 9999px; background: #0969da; color: #ffffff; font-size: 13px; font-weight: 700; text-decoration: none;">
                  Salurkan Wakaf
                </a>
                <a href="/kontribusi/infaq" style="display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 18px; border-radius: 9999px; border: 1px solid rgba(255,255,255,0.3); color: #ffffff; font-size: 13px; font-weight: 600; text-decoration: none;">
                  Infak Material
                </a>
              </div>
            </div>
          </div>
        </div>

        {relatedArticles.length > 0 && (
          <div style="margin-top: 48px;">
            <h2 style="margin: 0 0 20px; font-size: 22px; font-weight: 700; color: #0f172a;">Kajian &amp; Edukasi Lainnya</h2>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px;">
              {relatedArticles.map((rel) => (
                <a href={`/edukasi/${rel.slug}`} style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 18px; padding: 18px; text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: 8px;">
                  <span style="font-size: 11px; font-weight: 700; color: #0969da;">{rel.category}</span>
                  <h3 style="margin: 0; font-size: 16px; font-weight: 700; color: #0f172a;">{rel.title}</h3>
                  <span style="font-size: 12px; color: #64748b;">{rel.publishedAt}</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </article>
  )}
</BaseLayout>
