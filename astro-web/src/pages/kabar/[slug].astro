---
// src/pages/kabar/[slug].astro
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/kabar-detail.css';
import { getNewsArticleBySlug, getActiveNewsArticles } from '../../lib/db';
import { verifySessionToken } from '../../lib/auth';
import { getArticleSchema, getBreadcrumbSchema } from '../../lib/seo-schema';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/kabar');
}

const article = await getNewsArticleBySlug(slug);

// Cek apakah pengunjung adalah admin (untuk pratinjau draf)
const sessionCookie = Astro.cookies.get('gvf_admin_session')?.value;
const isAdmin = sessionCookie ? Boolean(verifySessionToken(sessionCookie)) : false;

const canView = article && (article.isPublished || isAdmin);

if (!canView) {
  Astro.response.status = 404;
}

// Ambil artikel berita aktif untuk sidebar terpopuler & warta terkait
const allActive = await getActiveNewsArticles(10);
const otherArticles = allActive.filter(a => a.id !== article?.id);
const popularArticles = otherArticles.slice(0, 4);
const relatedArticles = otherArticles.slice(0, 3);

// Format tanggal standar editorial Indonesia
const formatDate = (dateInput: Date | string | null) => {
  if (!dateInput) return 'Terkini';
  const date = typeof dateInput === 'string' ? new Date(dateInput) : dateInput;
  return new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  }).format(date);
};

// Estimasi waktu baca
const getReadTime = (content: string) => {
  const words = content.trim().split(/\s+/).length;
  const minutes = Math.max(1, Math.ceil(words / 180));
  return `${minutes} menit baca`;
};

// Pemisahan paragraf isi berita
const paragraphs = article?.content ? article.content.split(/\n\s*\n/).filter(p => p.trim().length > 0) : [];

// Skema SEO Artikel & Breadcrumb
const siteUrl = (Astro.site ? Astro.site.toString() : 'https://globalvillagefund.org').replace(/\/$/, '');
const articleBreadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Kabar GVF', url: '/kabar' },
  ...(article ? [{ name: article.title, url: `/kabar/${article.slug}` }] : []),
];

const articleSchemas = article
  ? [
      getBreadcrumbSchema(articleBreadcrumbs, siteUrl),
      getArticleSchema(
        {
          title: article.title,
          summary: article.summary,
          slug: article.slug,
          coverImage: article.coverImage,
          createdAt: article.publishedAt || article.createdAt,
          updatedAt: article.updatedAt,
          author: article.author || 'Global Village Fund',
        },
        siteUrl
      ),
    ]
  : null;
---

<BaseLayout
  title={article ? `${article.title} • Kabar Global Village Fund` : 'Artikel Tidak Ditemukan • Global Village Fund'}
  description={article ? (article.summary || article.title) : 'Kabar dan warta terkini program filantropi Global Village Fund.'}
  ogImage={article?.coverImage || '/logo-gvf.png'}
  ogType="article"
  schema={articleSchemas}
  noindex={!canView || !article?.isPublished}
>
  {!canView ? (
    <div class="kabar-not-found">
      <div class="not-found-card">
        <div class="not-found-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#0969da" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
        </div>
        <h1 class="not-found-title">Warta Tidak Ditemukan</h1>
        <p class="not-found-desc">Artikel yang Anda tuju mungkin sedang disunting, telah diarsipkan, atau tautan tidak valid.</p>
        <div class="not-found-actions">
          <a href="/kabar" class="btn-royal-primary">Lihat Warta Terkini</a>
          <a href="/" class="btn-royal-secondary">Kembali ke Beranda</a>
        </div>
      </div>
    </div>
  ) : (
    <article class="kabar-detail-page">
      {!article!.isPublished && (
        <div class="admin-draft-banner">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <span><strong>Mode Pratinjau Admin:</strong> Artikel ini berstatus Draf dan belum dipublikasikan untuk publik.</span>
          <a href="/admin/kabar" class="btn-banner-admin">Ke Panel Admin</a>
        </div>
      )}

      <!-- Newsroom Top Scrim for Navbar Contrast -->
      <section class="newsroom-header-scrim">
        <div class="scrim-bg-texture"></div>
        <div class="scrim-gradient"></div>
        <div class="kabar-container scrim-inner">
          <div class="scrim-sub-row">
            <a href="/kabar" class="scrim-back-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 5 12 12 5"></polyline>
              </svg>
              <span>Kembali ke Indeks Warta</span>
            </a>
            <div class="scrim-breadcrumbs">
              <a href="/" class="scrim-bc-item">Beranda</a>
              <span class="scrim-bc-sep">/</span>
              <a href="/kabar" class="scrim-bc-item">Kabar GVF</a>
              <span class="scrim-bc-sep">/</span>
              <span class="scrim-bc-current">{article.category}</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Main News Content Canvas -->
      <div class="news-main-canvas">
        <div class="kabar-container">
          <!-- Article Editorial Header -->
          <header class="news-editorial-header">
            <div class="header-cat-pill">
              <span class="cat-badge">{article.category}</span>
              <span class="header-readtime">{getReadTime(article.content)}</span>
            </div>

            <h1 class="news-main-headline">{article.title}</h1>

            {article.summary && (
              <p class="news-lead-dek">{article.summary}</p>
            )}

            <!-- Byline & Social Share Bar -->
            <div class="news-byline-bar">
              <div class="byline-left">
                <div class="byline-avatar">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0969da" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                  </svg>
                </div>
                <div class="byline-meta-group">
                  <div class="byline-author-line">
                    <span class="byline-name">{article.author || 'Tim Redaksi GVF'}</span>
                    <span class="byline-role">Jurnalis Redaksi</span>
                  </div>
                  <div class="byline-date-line">
                    <time datetime={article.publishedAt ? new Date(article.publishedAt).toISOString() : ''}>
                      {formatDate(article.publishedAt)}
                    </time>
                    <span class="byline-dot">&bull;</span>
                    <span>Diterbitkan di Sukamakmur Jonggol</span>
                  </div>
                </div>
              </div>

              <div class="byline-right-share">
                <span class="share-mini-label">Bagikan:</span>
                <a
                  href={`https://api.whatsapp.com/send?text=${encodeURIComponent(article.title + ' - ' + Astro.url.href)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="share-pill-btn share-pill-wa"
                  title="Bagikan ke WhatsApp"
                  aria-label="Bagikan ke WhatsApp"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20.52 3.48A11.93 11.93 0 0 0 12.06 0C5.46 0 .09 5.37.09 11.97c0 2.11.55 4.17 1.6 5.99L0 24l6.23-1.63a11.9 11.9 0 0 0 5.83 1.51h.01c6.6 0 11.97-5.37 11.97-11.97 0-3.2-1.25-6.21-3.52-8.43zM12.06 21.88h-.01a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.75.98 1-3.65-.23-.38a9.92 9.92 0 0 1-1.52-5.27c0-5.49 4.47-9.96 9.97-9.96 2.66 0 5.16 1.04 7.04 2.92a9.9 9.9 0 0 1 2.92 7.04c0 5.5-4.47 9.96-9.97 9.96zm5.46-7.46c-.3-.15-1.77-.87-2.04-.97-.28-.1-.48-.15-.68.15-.2.3-.78.97-.95 1.17-.18.2-.35.22-.65.08-.3-.15-1.26-.47-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.52-.07-.15-.68-1.64-.93-2.24-.24-.6-.49-.51-.68-.52l-.58-.01c-.2 0-.52.07-.8.38-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.21 3.07.15.2 2.1 3.2 5.09 4.49.71.31 1.27.49 1.7.63.72.23 1.37.2 1.88.12.58-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.18-1.42-.08-.12-.28-.2-.58-.35z"></path>
                  </svg>
                  <span>WhatsApp</span>
                </a>
                <button
                  type="button"
                  id="btn-copy-kabar-link"
                  class="share-pill-btn share-pill-copy"
                  title="Salin Tautan Artikel"
                  aria-label="Salin Tautan Artikel"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span>Salin Tautan</span>
                </button>
                <div id="copy-toast" class="copy-toast" aria-hidden="true">Tautan artikel tersalin</div>
              </div>
            </div>
          </header>

          <!-- Featured News Image with Standard Editorial Caption -->
          <figure class="news-featured-media">
            <div class="media-frame">
              <img
                src={article.coverImage || 'https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/fasilitas-dan-infrastruktur/progres-konstruksi-gedung-dan-wudhu.webp'}
                alt={article.title}
                class="featured-photo"
                loading="eager"
              />
            </div>
            <figcaption class="media-caption">
              Dokumentasi lapangan pembangunan fasilitas dan program vokasi santri di kawasan Sukamakmur Jonggol. <span class="caption-credit">(Foto: Tim Humas &amp; Media GVF)</span>
            </figcaption>
          </figure>

          <!-- Standard 2-Column News Layout: Article Body + Sticky Sidebar -->
          <div class="news-content-grid">
            <!-- Left Main Column: Reading Prose -->
            <main class="news-prose-column">
              <div class="article-body-prose">
                {paragraphs.map((para, idx) => (
                  <p class={idx === 0 ? 'prose-paragraph prose-first-lead' : 'prose-paragraph'}>
                    {para}
                  </p>
                ))}
              </div>

              <!-- In-Article Highlight: Amanah & Transparansi Wakaf -->
              <div class="news-callout-card">
                <div class="callout-icon-box">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0969da" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  </svg>
                </div>
                <div class="callout-content-wrap">
                  <h4 class="callout-title">Amanah &amp; Transparansi Filantropi</h4>
                  <p class="callout-desc">
                    Seluruh program pendayagunaan wakaf dan infaq di bawah naungan Yayasan Permata Cendekia Indonesia (GVF) diaudit secara berkala untuk memastikan setiap rupiah tepat sasaran bagi pembangunan peradaban santri.
                  </p>
                </div>
              </div>

              <!-- Article Tags Row -->
              <div class="news-tags-section">
                <span class="tags-lead-label">Topik Berita:</span>
                <div class="tags-flex-wrap">
                  <a href={`/kabar?kategori=${encodeURIComponent(article.category)}`} class="topic-tag-pill">
                    #{article.category}
                  </a>
                  <a href="/kabar" class="topic-tag-pill">#GlobalVillageFund</a>
                  <a href="/program/wakaf" class="topic-tag-pill">#WakafProduktif</a>
                  <a href="/program/wakaf" class="topic-tag-pill">#PesantrenJonggol</a>
                </div>
              </div>

              <!-- Redaksi Editorial Disclaimer Box -->
              <div class="editorial-signature-box">
                <div class="sig-badge">REDAKSI GVF</div>
                <p class="sig-text">
                  Laporan warta ini diterbitkan oleh Divisi Publikasi &amp; Komunikasi Global Village Fund. Untuk klarifikasi, peliputan kemitraan, atau informasi program lebih lanjut, hubungi redaksi di <a href="mailto:info@globalvillagefund.org">info@globalvillagefund.org</a>.
                </p>
              </div>

              <!-- Bottom Social Share Prompt -->
              <div class="bottom-share-banner">
                <span class="bottom-share-title">Suka dengan kabar ini? Bagikan ke jejaring Anda:</span>
                <div class="bottom-share-actions">
                  <a
                    href={`https://api.whatsapp.com/send?text=${encodeURIComponent(article.title + ' - ' + Astro.url.href)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-bottom-wa"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M20.52 3.48A11.93 11.93 0 0 0 12.06 0C5.46 0 .09 5.37.09 11.97c0 2.11.55 4.17 1.6 5.99L0 24l6.23-1.63a11.9 11.9 0 0 0 5.83 1.51h.01c6.6 0 11.97-5.37 11.97-11.97 0-3.2-1.25-6.21-3.52-8.43zM12.06 21.88h-.01a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.75.98 1-3.65-.23-.38a9.92 9.92 0 0 1-1.52-5.27c0-5.49 4.47-9.96 9.97-9.96 2.66 0 5.16 1.04 7.04 2.92a9.9 9.9 0 0 1 2.92 7.04c0 5.5-4.47 9.96-9.97 9.96zm5.46-7.46c-.3-.15-1.77-.87-2.04-.97-.28-.1-.48-.15-.68.15-.2.3-.78.97-.95 1.17-.18.2-.35.22-.65.08-.3-.15-1.26-.47-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.52-.07-.15-.68-1.64-.93-2.24-.24-.6-.49-.51-.68-.52l-.58-.01c-.2 0-.52.07-.8.38-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.21 3.07.15.2 2.1 3.2 5.09 4.49.71.31 1.27.49 1.7.63.72.23 1.37.2 1.88.12.58-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.18-1.42-.08-.12-.28-.2-.58-.35z"></path>
                    </svg>
                    <span>Bagikan ke WhatsApp</span>
                  </a>
                  <a href="/kabar" class="btn-bottom-archive">
                    <span>Indeks Berita</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </a>
                </div>
              </div>
            </main>

            <!-- Right Sidebar: Sticky News Widgets -->
            <aside class="news-sidebar-column">
              <div class="sidebar-sticky-wrapper">
                <!-- Widget 1: Warta Terpopuler -->
                {popularArticles.length > 0 && (
                  <div class="sidebar-widget popular-widget">
                    <div class="widget-header">
                      <span class="widget-accent-dot"></span>
                      <h3 class="widget-title">Warta Terpopuler</h3>
                    </div>
                    <div class="popular-list">
                      {popularArticles.map((pop, idx) => (
                        <a href={`/kabar/${pop.slug}`} class="popular-item-card">
                          <span class="popular-rank-num">0{idx + 1}</span>
                          <div class="popular-item-content">
                            <span class="popular-item-cat">{pop.category}</span>
                            <h4 class="popular-item-title">{pop.title}</h4>
                            <span class="popular-item-date">{formatDate(pop.publishedAt)}</span>
                          </div>
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                <!-- Widget 2: Donasi & Wakaf Quick CTA -->
                <div class="sidebar-widget cta-card-widget">
                  <div class="cta-widget-badge">PROGRAM PRIORITAS</div>
                  <h4 class="cta-widget-title">Bantu Pembangunan Fasilitas Vokasi Santri</h4>
                  <p class="cta-widget-desc">
                    Setiap infaq dan wakaf yang Anda salurkan menjadi jariyah berkelanjutan bagi kemandirian generasi santri penghafal Al-Qur'an.
                  </p>
                  <div class="cta-widget-buttons">
                    <a href="/program/wakaf" class="btn-sidebar-donate">
                      <span>Salurkan Wakaf</span>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                      </svg>
                    </a>
                    <a
                      href="https://wa.me/6281226832326?text=Assalamualaikum%20Admin%20GVF%2C%20saya%20ingin%20konsultasi%20program%20wakaf."
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-sidebar-wa"
                    >
                      Konsultasi Program WA
                    </a>
                  </div>
                </div>

                <!-- Widget 3: Rekening Resmi BSI -->
                <div class="sidebar-widget bank-info-widget">
                  <div class="bank-widget-header">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0969da" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                      <line x1="2" y1="10" x2="22" y2="10"></line>
                    </svg>
                    <span class="bank-widget-label">REKENING RESMI WAKAF</span>
                  </div>
                  <div class="bank-badge-line">
                    <strong>Bank Syariah Indonesia (BSI)</strong>
                  </div>
                  <div class="bank-acc-number">789-012-3456</div>
                  <div class="bank-acc-holder">a.n. Yayasan Permata Cendekia Indonesia</div>
                  <p class="bank-safe-note">Terkonfirmasi resmi &amp; berizin Kementerian Agama / BWI.</p>
                </div>
              </div>
            </aside>
          </div>
        </div>
      </div>

      <!-- Bottom Related News Section -->
      {relatedArticles.length > 0 && (
        <section class="kabar-related-section">
          <div class="kabar-container">
            <div class="related-header-bar">
              <div>
                <span class="related-section-subtitle">LITERASI BERKELANJUTAN</span>
                <h3 class="related-section-title">Warta &amp; Catatan Terkait Lainnya</h3>
              </div>
              <a href="/kabar" class="related-see-all-link">
                <span>Lihat Seluruh Arsip</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>

            <div class="related-news-grid">
              {relatedArticles.map((rel) => (
                <article class="related-news-card">
                  <a href={`/kabar/${rel.slug}`} class="related-thumb-link">
                    <img
                      src={rel.coverImage || 'https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/fasilitas-dan-infrastruktur/pelataran-depan-masjid.webp'}
                      alt={rel.title}
                      class="related-thumb-image"
                      loading="lazy"
                    />
                    <span class="related-pill-badge">{rel.category}</span>
                  </a>
                  <div class="related-body-wrap">
                    <span class="related-pub-date">{formatDate(rel.publishedAt)}</span>
                    <h4 class="related-headline">
                      <a href={`/kabar/${rel.slug}`} class="related-headline-link">
                        {rel.title}
                      </a>
                    </h4>
                    <p class="related-excerpt-text">{rel.summary}</p>
                    <a href={`/kabar/${rel.slug}`} class="related-read-more">
                      <span>Baca Selengkapnya</span>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                      </svg>
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- Bottom Consultation Call To Action -->
      <section class="kabar-cta-section">
        <div class="kabar-container">
          <div class="cta-banner-card">
            <div class="cta-content">
              <h3 class="cta-banner-title">Ikut Serta Berkontribusi Nyata Bagi Umat</h3>
              <p class="cta-banner-desc">
                Konsultasikan partisipasi Anda dalam program wakaf produktif, wakaf pembangunan sarana masjid, dan beasiswa vokasi santri bersama Global Village Fund.
              </p>
            </div>
            <div class="cta-actions">
              <a
                href="https://wa.me/6281226832326?text=Assalamualaikum%20Admin%20Global%20Village%20Fund%2C%20saya%20ingin%20konsultasi%20program%20wakaf."
                target="_blank"
                rel="noopener noreferrer"
                class="btn-cta-white"
              >
                <span>Konsultasi via WhatsApp</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
              <a href="/program/wakaf" class="btn-cta-ghost">
                Pelajari Program Wakaf
              </a>
            </div>
          </div>
        </div>
      </section>
    </article>
  )}
</BaseLayout>

<script>
  function setupKabarDetail() {
    const copyBtn = document.getElementById('btn-copy-kabar-link');
    const toast = document.getElementById('copy-toast');

    if (copyBtn && toast) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          toast.classList.add('visible');
          setTimeout(() => {
            toast.classList.remove('visible');
          }, 2500);
        } catch (e) {
          console.error('Gagal menyalin tautan:', e);
        }
      });
    }
  }

  document.addEventListener('astro:page-load', setupKabarDetail);
  if (document.readyState !== 'loading') {
    setupKabarDetail();
  }
</script>
