---
// src/pages/kabar/[slug].astro
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNewsArticleBySlug, getActiveNewsArticles } from '../../lib/db';
import { verifySessionToken } from '../../lib/auth';
import { getArticleSchema, getBreadcrumbSchema } from '../../lib/seo-schema';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/kabar');
}

const article = await getNewsArticleBySlug(slug);

// Cek apakah pengunjung adalah admin (untuk pratinjau draf)
const sessionCookie = Astro.cookies.get('gvf_admin_session')?.value;
const isAdmin = sessionCookie ? Boolean(verifySessionToken(sessionCookie)) : false;

const canView = article && (article.isPublished || isAdmin);

if (!canView) {
  Astro.response.status = 404;
}

// Ambil artikel rekomendasi terkini (kecuali artikel aktif ini)
const allActive = await getActiveNewsArticles(4);
const relatedArticles = allActive.filter(a => a.id !== article?.id).slice(0, 3);

// Format tanggal Bahasa Indonesia
const formatDate = (dateInput: Date | string | null) => {
  if (!dateInput) return 'Terkini';
  const date = typeof dateInput === 'string' ? new Date(dateInput) : dateInput;
  return new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  }).format(date);
};

// Estimasi waktu baca
const getReadTime = (content: string) => {
  const words = content.trim().split(/\s+/).length;
  const minutes = Math.max(1, Math.ceil(words / 180));
  return `${minutes} menit baca`;
};

// Pemisahan paragraf isi berita
const paragraphs = article?.content ? article.content.split(/\n\s*\n/).filter(p => p.trim().length > 0) : [];

// Skema SEO Artikel & Breadcrumb
const siteUrl = (Astro.site ? Astro.site.toString() : 'https://globalvillagefund.org').replace(/\/$/, '');
const articleBreadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Kabar GVF', url: '/kabar' },
  ...(article ? [{ name: article.title, url: `/kabar/${article.slug}` }] : []),
];

const articleSchemas = article
  ? [
      getBreadcrumbSchema(articleBreadcrumbs, siteUrl),
      getArticleSchema(
        {
          title: article.title,
          summary: article.summary,
          slug: article.slug,
          coverImage: article.coverImage,
          createdAt: article.publishedAt || article.createdAt,
          updatedAt: article.updatedAt,
          author: article.author || 'Global Village Fund',
        },
        siteUrl
      ),
    ]
  : null;
---

<BaseLayout
  title={article ? `${article.title} • Kabar Global Village Fund` : 'Artikel Tidak Ditemukan • Global Village Fund'}
  description={article ? (article.summary || article.title) : 'Kabar dan warta terkini program filantropi Global Village Fund.'}
  ogImage={article?.coverImage || '/logo-gvf.png'}
  ogType="article"
  schema={articleSchemas}
  noindex={!canView || !article?.isPublished}
>
  {!canView ? (
    <div class="kabar-not-found">
      <div class="not-found-card">
        <div class="not-found-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#0969da" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
        </div>
        <h1 class="not-found-title">Warta Tidak Ditemukan</h1>
        <p class="not-found-desc">Artikel yang Anda tuju mungkin sedang disunting, telah diarsipkan, atau tautan tidak valid.</p>
        <div class="not-found-actions">
          <a href="/kabar" class="btn-royal-primary">Lihat Warta Terkini</a>
          <a href="/" class="btn-royal-secondary">Kembali ke Beranda</a>
        </div>
      </div>
    </div>
  ) : (
    <article class="kabar-detail-page">
      {!article!.isPublished && (
        <div class="admin-draft-banner">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <span><strong>Mode Pratinjau Admin:</strong> Artikel ini berstatus Draf dan belum dipublikasikan untuk publik.</span>
          <a href="/admin/kabar" class="btn-banner-admin">Ke Panel Admin</a>
        </div>
      )}

      <!-- Unified Architectural Article Hero Header (Standar ISAVO GVF) -->
      <header class="kabar-article-hero">
        <div class="hero-bg-texture"></div>
        <div class="hero-gradient-overlay"></div>
        <div class="kabar-container hero-inner">
          <nav class="article-breadcrumb-nav" aria-label="Breadcrumb">
            <a href="/" class="breadcrumb-item">BERANDA</a>
            <span class="breadcrumb-sep">/</span>
            <a href="/kabar" class="breadcrumb-item">KABAR GVF</a>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-current">{article.category.toUpperCase()}</span>
          </nav>

          <div class="hero-category-wrap">
            <span class="category-badge">{article.category}</span>
          </div>

          <h1 class="article-hero-title">{article.title}</h1>

          <div class="article-byline-bar">
            <div class="byline-avatar">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0969da" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </div>
            <span class="byline-author">{article.author || 'Tim Redaksi GVF'}</span>
            <span class="byline-dot">&bull;</span>
            <time class="byline-time" datetime={article.publishedAt ? new Date(article.publishedAt).toISOString() : ''}>
              {formatDate(article.publishedAt)}
            </time>
            <span class="byline-dot">&bull;</span>
            <span class="byline-readtime">{getReadTime(article.content)}</span>
          </div>
        </div>
      </header>

      <!-- Main Article Reading Canvas -->
      <main class="kabar-article-body">
        <div class="kabar-reading-container">
          <!-- Featured Image Card -->
          <div class="article-media-wrap">
            <img
              src={article.coverImage || 'https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/fasilitas-dan-infrastruktur/progres-konstruksi-gedung-dan-wudhu.webp'}
              alt={article.title}
              class="article-featured-img"
              loading="eager"
            />
            <p class="article-media-caption">
              Dokumentasi Program • Global Village Fund Sukamakmur Jonggol
            </p>
          </div>

          <!-- Lead Summary (Editorial Dek) -->
          {article.summary && (
            <p class="article-lead-editorial">{article.summary}</p>
          )}

          <!-- Article Prose Content -->
          <div class="article-prose-content">
            {paragraphs.map((para) => (
              <p class="prose-paragraph">{para}</p>
            ))}

            <!-- Info Box Filantropi -->
            <div class="prose-callout-clean">
              <div class="callout-icon-wrap">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0969da" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
              </div>
              <div class="callout-body">
                <h4 class="callout-heading">Amanah Wakaf &amp; Akuntabilitas</h4>
                <p class="callout-text">
                  Setiap dana wakaf dan infaq yang disalurkan melalui Global Village Fund dikelola secara transparan, akuntabel, dan berfokus pada kemandirian santri serta fasilitas ibadah yang berkelanjutan.
                </p>
              </div>
            </div>

            <!-- Meta Footer: Tags & Share Row -->
            <div class="article-meta-footer">
              <div class="article-tags-wrap">
                <span class="tags-prefix">Topik:</span>
                <a href={`/kabar?kategori=${encodeURIComponent(article.category)}`} class="tag-pill">
                  #{article.category}
                </a>
                <a href="/kabar" class="tag-pill">#GlobalVillageFund</a>
                <a href="/program/wakaf" class="tag-pill">#WakafProduktif</a>
              </div>

              <div class="article-share-row">
                <span class="share-label">Bagikan:</span>
                <a
                  href={`https://api.whatsapp.com/send?text=${encodeURIComponent(article.title + ' - ' + Astro.url.href)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="share-action-btn share-wa"
                  title="Bagikan ke WhatsApp"
                  aria-label="Bagikan ke WhatsApp"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20.52 3.48A11.93 11.93 0 0 0 12.06 0C5.46 0 .09 5.37.09 11.97c0 2.11.55 4.17 1.6 5.99L0 24l6.23-1.63a11.9 11.9 0 0 0 5.83 1.51h.01c6.6 0 11.97-5.37 11.97-11.97 0-3.2-1.25-6.21-3.52-8.43zM12.06 21.88h-.01a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.75.98 1-3.65-.23-.38a9.92 9.92 0 0 1-1.52-5.27c0-5.49 4.47-9.96 9.97-9.96 2.66 0 5.16 1.04 7.04 2.92a9.9 9.9 0 0 1 2.92 7.04c0 5.5-4.47 9.96-9.97 9.96zm5.46-7.46c-.3-.15-1.77-.87-2.04-.97-.28-.1-.48-.15-.68.15-.2.3-.78.97-.95 1.17-.18.2-.35.22-.65.08-.3-.15-1.26-.47-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.52-.07-.15-.68-1.64-.93-2.24-.24-.6-.49-.51-.68-.52l-.58-.01c-.2 0-.52.07-.8.38-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.21 3.07.15.2 2.1 3.2 5.09 4.49.71.31 1.27.49 1.7.63.72.23 1.37.2 1.88.12.58-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.18-1.42-.08-.12-.28-.2-.58-.35z"></path>
                  </svg>
                  <span>WhatsApp</span>
                </a>
                <button
                  type="button"
                  id="btn-copy-kabar-link"
                  class="share-action-btn share-copy"
                  title="Salin Tautan Artikel"
                  aria-label="Salin Tautan Artikel"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span>Salin Tautan</span>
                </button>
                <div id="copy-toast" class="copy-toast" aria-hidden="true">Tautan tersalin</div>
              </div>
            </div>
          </div>
        </div>
      </main>

      <!-- Related News Section -->
      {relatedArticles.length > 0 && (
        <section class="kabar-related-section">
          <div class="kabar-container">
            <div class="related-header">
              <h3 class="related-title">Warta &amp; Catatan Terkait Lainnya</h3>
              <a href="/kabar" class="related-all-link">
                <span>Lihat Seluruh Arsip</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>

            <div class="related-grid">
              {relatedArticles.map((rel) => (
                <article class="related-card">
                  <a href={`/kabar/${rel.slug}`} class="related-thumb-wrap">
                    <img
                      src={rel.coverImage || 'https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/fasilitas-dan-infrastruktur/pelataran-depan-masjid.webp'}
                      alt={rel.title}
                      class="related-thumb-img"
                      loading="lazy"
                    />
                    <span class="related-cat-badge">{rel.category}</span>
                  </a>
                  <div class="related-card-body">
                    <span class="related-date">{formatDate(rel.publishedAt)}</span>
                    <h4 class="related-card-title">
                      <a href={`/kabar/${rel.slug}`} class="related-title-link">
                        {rel.title}
                      </a>
                    </h4>
                    <p class="related-card-desc">{rel.summary}</p>
                    <a href={`/kabar/${rel.slug}`} class="related-action-link">
                      <span>Baca Selengkapnya</span>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                      </svg>
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- Bottom Consultation Call To Action -->
      <section class="kabar-cta-section">
        <div class="kabar-container">
          <div class="cta-banner-card">
            <div class="cta-content">
              <h3 class="cta-banner-title">Ikut Serta Berkontribusi Nyata Bagi Umat</h3>
              <p class="cta-banner-desc">
                Konsultasikan partisipasi Anda dalam program wakaf produktif, wakaf pembangunan sarana masjid, dan beasiswa vokasi santri.
              </p>
            </div>
            <div class="cta-actions">
              <a
                href="https://wa.me/6281226832326?text=Assalamualaikum%20Admin%20Global%20Village%20Fund%2C%20saya%20ingin%20konsultasi%20program%20wakaf."
                target="_blank"
                rel="noopener noreferrer"
                class="btn-cta-white"
              >
                <span>Konsultasi via WhatsApp</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
              <a href="/program/wakaf" class="btn-cta-ghost">
                Pelajari Program Wakaf
              </a>
            </div>
          </div>
        </div>
      </section>
    </article>
  )}
</BaseLayout>

<script>
  function setupKabarDetail() {
    const copyBtn = document.getElementById('btn-copy-kabar-link');
    const toast = document.getElementById('copy-toast');

    if (copyBtn && toast) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          toast.classList.add('visible');
          setTimeout(() => {
            toast.classList.remove('visible');
          }, 2500);
        } catch (e) {
          console.error('Gagal menyalin tautan:', e);
        }
      });
    }
  }

  document.addEventListener('astro:page-load', setupKabarDetail);
  if (document.readyState !== 'loading') {
    setupKabarDetail();
  }
</script>

<style>
  .kabar-detail-page {
    background-color: #fbfbf9;
    min-height: 100vh;
    font-family: 'Golos Text', system-ui, sans-serif;
    color: #1e293b;
  }

  .kabar-container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* 404 View */
  .kabar-not-found {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 160px 1.5rem 60px 1.5rem;
    background-color: #fbfbf9;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  .not-found-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 48px 32px;
    text-align: center;
    max-width: 520px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.04);
  }

  .not-found-icon {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: rgba(9, 105, 218, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px auto;
  }

  .not-found-title {
    font-size: 24px;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 12px 0;
  }

  .not-found-desc {
    font-size: 14px;
    color: #64748b;
    line-height: 1.6;
    margin: 0 0 28px 0;
  }

  .not-found-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Admin Draft Preview Banner */
  .admin-draft-banner {
    background: #fffbeb;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: #92400e;
    font-size: 13px;
    flex-wrap: wrap;
  }

  .btn-banner-admin {
    background: #f59e0b;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 6px;
    text-decoration: none;
    transition: background 150ms ease;
  }

  .btn-banner-admin:hover {
    background: #d97706;
  }

  /* Architectural Unified Hero Header (Standar ISAVO GVF) */
  .kabar-article-hero {
    position: relative;
    background-color: #061829;
    padding: 140px 0 60px 0;
    overflow: hidden;
  }

  .hero-bg-texture {
    position: absolute;
    inset: 0;
    background-image: url('https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/drone-lapangan-dan-lahan-tani.webp');
    background-size: cover;
    background-position: center;
    opacity: 0.22;
    z-index: 0;
  }

  .hero-gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(6, 24, 41, 0.82) 0%, rgba(6, 24, 41, 0.96) 100%);
    z-index: 1;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 860px;
  }

  .article-breadcrumb-nav {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    margin-bottom: 1.25rem;
  }

  .breadcrumb-item {
    color: #94a3b8;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .breadcrumb-item:hover {
    color: #ffffff;
  }

  .breadcrumb-sep {
    color: #475569;
  }

  .breadcrumb-current {
    color: #38bdf8;
  }

  .hero-category-wrap {
    margin-bottom: 14px;
  }

  .category-badge {
    background-color: #0969da;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 4px 14px;
    border-radius: 9999px;
    text-transform: uppercase;
    display: inline-block;
  }

  .article-hero-title {
    font-size: clamp(2rem, 3.8vw, 3rem);
    line-height: 1.24;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.025em;
    margin: 0 0 24px 0;
    font-family: 'Golos Text', system-ui, sans-serif;
  }

  .article-byline-bar {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #94a3b8;
    font-size: 13.5px;
    font-weight: 500;
    flex-wrap: wrap;
  }

  .byline-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .byline-avatar svg {
    stroke: #38bdf8;
  }

  .byline-author {
    color: #f1f5f9;
    font-weight: 600;
  }

  .byline-dot {
    color: #475569;
  }

  .byline-time, .byline-readtime {
    color: #94a3b8;
  }

  /* Reading Body Area */
  .kabar-article-body {
    padding: 44px 0 72px 0;
  }

  .kabar-reading-container {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Featured Image */
  .article-media-wrap {
    margin-bottom: 36px;
  }

  .article-featured-img {
    width: 100%;
    max-height: 500px;
    object-fit: cover;
    border-radius: 20px;
    display: block;
    box-shadow: 0 16px 36px -10px rgba(0, 0, 0, 0.08);
  }

  .article-media-caption {
    font-size: 13px;
    color: #64748b;
    margin: 12px 0 0 0;
    text-align: center;
    line-height: 1.5;
  }

  /* Lead Summary (Editorial Subtitle) - STRICTLY NO BORDER LINES */
  .article-lead-editorial {
    font-size: 1.25rem;
    line-height: 1.7;
    color: #334155;
    font-weight: 500;
    margin: 0 0 32px 0;
    letter-spacing: -0.01em;
  }

  /* Prose Content */
  .article-prose-content {
    font-size: 1.125rem;
    line-height: 1.85;
    color: #1e293b;
  }

  .prose-paragraph {
    margin: 0 0 24px 0;
    text-align: left;
  }

  /* Callout Clean (Soft Surface, Zero Harsh Borders) */
  .prose-callout-clean {
    margin: 40px 0;
    padding: 26px 30px;
    background: #f0f7ff;
    border-radius: 20px;
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .callout-icon-wrap {
    flex-shrink: 0;
    padding-top: 2px;
  }

  .callout-heading {
    margin: 0 0 6px 0;
    font-size: 16px;
    font-weight: 700;
    color: #0752a8;
  }

  .callout-text {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.65;
    color: #1e3a8a;
  }

  /* Meta Footer (Tags & Share) */
  .article-meta-footer {
    margin-top: 48px;
    padding-top: 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
