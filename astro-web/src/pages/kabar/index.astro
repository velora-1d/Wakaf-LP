---
// src/pages/kabar/index.astro
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import BlossomCarousel from '../../components/ui/BlossomCarousel.astro';
import {
  getActiveNewsArticles,
  getActiveTransparencyReports,
  getAllVerifiedDonations,
  getCashAllocationMetrics,
  getDonationDashboardMetrics,
  getVerifiedDonationSum,
} from '../../lib/db';
import { getBreadcrumbSchema } from '../../lib/seo-schema';
import '../../styles/program/program-pages.css';

const [articles, reports, cashMetrics, donationMetrics, recentDonations, donationSummary] = await Promise.all([
  getActiveNewsArticles(50, 'kabar'),
  getActiveTransparencyReports(50),
  getCashAllocationMetrics(),
  getDonationDashboardMetrics(),
  getAllVerifiedDonations(24),
  getVerifiedDonationSum(),
]);

const activeTabParam = (Astro.url.searchParams.get('tab') || 'kabar').toLowerCase();
const activeTab = activeTabParam === 'laporan' || activeTabParam === 'donatur' ? activeTabParam : 'kabar';

// Daftar kategori unik untuk filter
const categories = ['Semua', ...new Set(articles.map(a => a.category))];

const formatCatLabel = (cat: string) =>
  cat
    .toLowerCase()
    .split(/\s+/)
    .map((w) => (w ? w.charAt(0).toUpperCase() + w.slice(1) : ''))
    .join(' ');

const formatDate = (dateInput: Date | string | null) => {
  if (!dateInput) return 'Terkini';
  if (typeof dateInput === 'string') {
    const parsed = new Date(dateInput);
    if (isNaN(parsed.getTime())) return dateInput;
    return new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(parsed);
  }
  return new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  }).format(dateInput);
};

const formatRupiah = (val: number) =>
  new Intl.NumberFormat('id-ID', {
    style: 'currency',
    currency: 'IDR',
    maximumFractionDigits: 0,
  }).format(val || 0);

const scopeLabels: Record<string, string> = {
  all: 'Seluruh Program GVF',
  pembangunan_masjid: 'Pembangunan Masjid',
  gota_ssm: 'Program GOTA SSM',
  infaq: 'Infak (Material Masjid)',
  sedekah: 'Sedekah (Dukungan GOTA SSM)',
  wakaf: 'Wakaf (Objek & Peruntukan)',
  zakat: 'Zakat (Ramadan & Idulfitri)',
};

const siteUrl = (Astro.site ? Astro.site.toString() : 'https://globalvillagefund.org').replace(/\/$/, '');
const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Kabar & Laporan', url: '/kabar' },
];
const pageSchema = getBreadcrumbSchema(breadcrumbs, siteUrl);
---

<BaseLayout
  title="Kabar & Laporan Transparansi • Global Village Fund"
  description="Warta terkini pembangunan kawasan, aktivitas santri GOTA SSM, laporan realisasi dana real-time, dan dokumen laporan berkala Global Village Fund."
  schema={pageSchema}
>
  <div class="kabar-archive-page">
    <!-- Split Hero Selaras /program -->
    <section class="prog-v2-hero">
      <div class="prog-container">
        <div class="prog-v2-hero-grid">
          <div class="prog-v2-hero-copy">
            <h1 class="prog-v2-title">
              Kabar &amp; Laporan <span class="prog-v2-accent">Global Village Fund</span>
            </h1>
            <p class="prog-v2-lead">
              Dokumentasi berkala perkembangan pembangunan kawasan, aktivitas santri Pesantren Skill Village Islamic School, laporan realisasi dana, serta daftar muhsinin terverifikasi.
            </p>
            <!-- 3-Tab Switcher -->
            <div class="kabar-tab-bar" role="tablist" aria-label="Kategori Kabar dan Transparansi">
              <button
                type="button"
                role="tab"
                id="pubTabBtnKabar"
                aria-selected={activeTab === 'kabar' ? 'true' : 'false'}
                class={`kabar-tab-btn ${activeTab === 'kabar' ? 'is-active' : ''}`}
              >
                Kabar &amp; Progres ({articles.length})
              </button>
              <button
                type="button"
                role="tab"
                id="pubTabBtnLaporan"
                aria-selected={activeTab === 'laporan' ? 'true' : 'false'}
                class={`kabar-tab-btn ${activeTab === 'laporan' ? 'is-active' : ''}`}
              >
                Laporan ({reports.length})
              </button>
              <button
                type="button"
                role="tab"
                id="pubTabBtnDonatur"
                aria-selected={activeTab === 'donatur' ? 'true' : 'false'}
                class={`kabar-tab-btn ${activeTab === 'donatur' ? 'is-active' : ''}`}
              >
                Daftar Donatur ({donationSummary.totalTransaksi})
              </button>
            </div>
          </div>

          <div class="prog-v2-hero-media">
            <img
              src="/assets/kegiatan-dan-prestasi-santri/foto-ustadz-bersama-duta-santri.webp"
              alt="Dokumentasi Kegiatan dan Transparansi Global Village Fund"
              class="prog-v2-hero-img"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- TAB 1: KABAR & PROGRES -->
    <div id="pubTabContentKabar" style={activeTab === 'kabar' ? '' : 'display: none;'}>
      <!-- Filter & Subheader Section -->
      <header class="archive-header-hero">
        <div class="prog-container">
          <h2 class="archive-sub-heading">
            Warta Pembangunan Kawasan &amp; Aktivitas Santri
          </h2>
          <p class="archive-subtitle">
            Dokumentasi berkala perkembangan fisik Masjid Taman Khairu Ummah Sughro, program GOTA SSM, dan penyaluran amanah donatur di Sukasirna, Jonggol.
          </p>

          <!-- Category Filter Tabs -->
          <div class="archive-filter-row" id="kabar-filter-bar">
            {categories.map((cat, idx) => (
              <button
                type="button"
                class={`filter-pill ${idx === 0 ? 'active' : ''}`}
                data-cat={cat}
              >
                {formatCatLabel(cat)}
              </button>
            ))}
          </div>
        </div>
      </header>

      <!-- Articles Grid Section -->
      <section class="archive-grid-section">
        <div class="prog-container">
          {articles.length === 0 ? (
            <div class="empty-state-box">
              <div class="empty-icon">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
              </div>
              <h3 class="empty-title">Belum Ada Warta yang Dipublikasikan</h3>
              <p class="empty-desc">Warta dan laporan progres baru akan segera hadir.</p>
            </div>
          ) : (
            <div id="kabar-grid">
              <BlossomCarousel id="kabar-archive-carousel" columns="380px" showControls={true} showDots={true}>
                {articles.map((article) => (
                  <article class="archive-card" data-category={article.category} data-blossom-slide>
                    <div class="card-thumb-wrap">
                      <img
                        src={article.coverImage || '/media-lp/masjid-tampak-dalam-konstruksi.webp'}
                        alt={article.title}
                        class="card-thumb-img"
                        loading="lazy"
                      />
                    </div>
                    <div class="card-body">
                      <div class="card-meta">
                        <span class="meta-date">{formatDate(article.publishedAt)}</span>
                        <span class="meta-author">Oleh <strong class="author-bold">{article.author || 'Tim GVF'}</strong></span>
                      </div>
                      <h2 class="card-title">
                        <a href={`/kabar/${article.slug}`} class="card-title-link">
                          {article.title}
                        </a>
                      </h2>
                      <p class="card-summary">{article.summary}</p>
                      <a href={`/kabar/${article.slug}`} class="card-action-link">
                        <span>Baca Selengkapnya</span>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </a>
                    </div>
                  </article>
                ))}
              </BlossomCarousel>
            </div>
          )}
        </div>
      </section>
    </div>

    <!-- TAB 2: LAPORAN & TRANSPARANSI -->
    <div id="pubTabContentLaporan" style={activeTab === 'laporan' ? 'padding: 56px 0 80px;' : 'display: none; padding: 56px 0 80px;'}>
      <div class="prog-container">
        <div class="kabar-report-summary">
          <div class="kabar-report-head">
            <div>
              <h2 class="prog-section-title" style="margin-bottom: 6px;">Rekap Penghimpunan &amp; Alokasi Dana</h2>
              <p class="prog-section-desc">Data sinkron langsung dengan basis data donasi terverifikasi &amp; buku kas penyaluran GVF.</p>
            </div>
            <a href="/donatur" class="prog-btn-primary">
              Lihat Daftar Donatur Lengkap
            </a>
          </div>

          <div class="kabar-metrics-grid">
            <div class="kabar-metric-box">
              <span class="kabar-metric-label">Total Donasi Terverifikasi</span>
              <div class="kabar-metric-val is-brand">{formatRupiah(donationMetrics.totalPenghimpunan)}</div>
              <span class="kabar-metric-sub">{donationMetrics.lunasCount} transaksi lunas ({donationMetrics.totalDonors} muhsinin)</span>
            </div>
            <div class="kabar-metric-box">
              <span class="kabar-metric-label">Penerimaan Tercatat di Buku Kas</span>
              <div class="kabar-metric-val">{formatRupiah(cashMetrics.totalDebit)}</div>
              <span class="kabar-metric-sub">Total debit operasional &amp; program</span>
            </div>
            <div class="kabar-metric-box">
              <span class="kabar-metric-label">Realisasi Penyaluran &amp; Belanja</span>
              <div class="kabar-metric-val">{formatRupiah(cashMetrics.totalKredit)}</div>
              <span class="kabar-metric-sub">{cashMetrics.totalTransaksi} mutasi tercatat</span>
            </div>
            <div class="kabar-metric-box">
              <span class="kabar-metric-label">Saldo Berjalan Kas Program</span>
              <div class="kabar-metric-val is-emerald">{formatRupiah(cashMetrics.saldoAkhir)}</div>
              <span class="kabar-metric-sub">Siap disalurkan sesuai amanah</span>
            </div>
          </div>
        </div>

        <!-- Daftar Dokumen Laporan Berkala -->
        <div style="margin-bottom: 24px;">
          <h2 class="prog-section-title" style="margin-bottom: 6px;">Dokumen Laporan Berkala</h2>
          <p class="prog-section-desc">Unduh dokumen laporan realisasi keuangan dan progres kawasan per periode.</p>
        </div>

        {reports.length === 0 ? (
          <div class="empty-state-box">
            <h3 class="empty-title">Belum Ada Dokumen Laporan Berkala</h3>
            <p class="empty-desc">Dokumen laporan PDF berkala akan tersedia segera.</p>
          </div>
        ) : (
          <div class="kabar-reports-grid">
            {reports.map((rep) => (
              <div class="kabar-report-card">
                <div style="display: flex; flex-direction: column; gap: 10px;">
                  <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 13px; color: #475569;">
                    <span style="color: #0969da; font-weight: 700;">{rep.periodLabel}</span>
                    <span>/</span>
                    <span style="font-weight: 600;">{scopeLabels[rep.programScope] || rep.programScope}</span>
                  </div>
                  <h3 style="margin: 0; font-size: 18px; font-weight: 700; color: #0f172a;">{rep.title}</h3>
                  <p class="kabar-report-summary-text">{rep.summary}</p>
                </div>

                <div style="display: flex; align-items: center; justify-content: space-between; padding-top: 14px; border-top: 1px solid #f1f5f9;">
                  <span style="font-size: 12px; color: #64748b;">Terbit: {rep.publishedAt}</span>
                  <a
                    href={rep.fileUrl}
                    target={rep.fileUrl.startsWith('http') ? '_blank' : undefined}
                    rel={rep.fileUrl.startsWith('http') ? 'noopener noreferrer' : undefined}
                    class="prog-btn-primary"
                    style="min-height: 44px; padding: 0 18px; font-size: 13px;"
                  >
                    Buka / Unduh Laporan
                  </a>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>

    <!-- TAB 3: DAFTAR DONATUR TERVERIFIKASI -->
    <div id="pubTabContentDonatur" style={activeTab === 'donatur' ? 'padding: 56px 0 80px;' : 'display: none; padding: 56px 0 80px;'}>
      <div class="prog-container">
        <div class="kabar-report-head" style="margin-bottom: 28px;">
          <div>
            <h2 class="prog-section-title" style="margin-bottom: 6px;">Daftar Muhsinin &amp; Donatur Terverifikasi</h2>
            <p class="prog-section-desc">Menampilkan 24 kontribusi terverifikasi terbaru secara real-time.</p>
          </div>
          <a href="/donatur" class="prog-btn-primary">
            Lihat Semua ({donationSummary.totalTransaksi})
          </a>
        </div>

        <div class="kabar-metrics-grid" style="margin-bottom: 32px;">
          <div class="kabar-metric-box">
            <span class="kabar-metric-label">Total Dana Terhimpun</span>
            <div class="kabar-metric-val is-brand">{formatRupiah(donationSummary.totalNominal)}</div>
          </div>
          <div class="kabar-metric-box">
            <span class="kabar-metric-label">Transaksi Lunas</span>
            <div class="kabar-metric-val">{donationSummary.totalTransaksi} Transaksi</div>
          </div>
          <div class="kabar-metric-box">
            <span class="kabar-metric-label">Jumlah Muhsinin</span>
            <div class="kabar-metric-val is-emerald">{donationSummary.totalDonors} Donatur</div>
          </div>
        </div>

        {recentDonations.length === 0 ? (
          <div class="empty-state-box">
            <h3 class="empty-title">Belum Ada Data Donatur</h3>
            <p class="empty-desc">Data kontribusi terverifikasi akan tampil secara otomatis di sini.</p>
          </div>
        ) : (
          <div class="kabar-donor-table-wrap">
            <table class="kabar-donor-table">
              <thead>
                <tr>
                  <th>No</th>
                  <th>Nama Donatur</th>
                  <th>Program</th>
                  <th>Nominal</th>
                  <th>Tanggal</th>
                  <th>Doa &amp; Catatan</th>
                </tr>
              </thead>
              <tbody>
                {recentDonations.map((d, idx) => (
                  <tr>
                    <td class="is-num">{idx + 1}</td>
                    <td class="is-bold">{d.namaDonatur || 'Hamba Allah'}</td>
                    <td><span class="kabar-donor-prog">{d.programTujuan || 'Program GVF'}</span></td>
                    <td class="is-num is-brand">{formatRupiah(Number(d.nominalTotal || 0))}</td>
                    <td class="is-muted">{formatDate(d.createdAt)}</td>
                    <td class="is-muted">{d.doaDonatur || '-'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>

    <!-- Banner CTA Penutup Selaras /program -->
    <section class="prog-v2-cta-band">
      <svg class="prog-v2-cta-silhouette" viewBox="0 0 1200 180" preserveAspectRatio="none" fill="currentColor" aria-hidden="true">
        <path d="M0 180V140h120v-40h40V75c0-22 18-40 40-40s40 18 40 40v25h40v40h140V95c0-38 42-68 80-68s80 30 80 68v45h140v-40h40V75c0-22 18-40 40-40s40 18 40 40v25h40v40h280v40H0z" />
      </svg>
      <div class="prog-container">
        <div class="prog-v2-cta-inner">
          <h2 class="prog-section-title">
            Mari Mengambil Bagian dalam <span class="prog-v2-accent-warm">Kebaikan</span>
          </h2>
          <p class="prog-section-desc">
            Setiap kontribusi dicatat secara transparan dan disalurkan langsung untuk pembangunan Masjid Taman Khairu Ummah Sughro serta pendidikan santri.
          </p>
          <div class="prog-v2-cta-actions">
            <a href="/kontribusi/wakaf" class="prog-btn-primary">Salurkan Kontribusi</a>
            <a href="/program" class="prog-btn-outline-light">Lihat Program GVF</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  function setupKabarFiltersAndTabs() {
    const tabMap: Record<string, { btn: HTMLElement | null; content: HTMLElement | null }> = {
      kabar: {
        btn: document.getElementById('pubTabBtnKabar'),
        content: document.getElementById('pubTabContentKabar'),
      },
      laporan: {
        btn: document.getElementById('pubTabBtnLaporan'),
        content: document.getElementById('pubTabContentLaporan'),
      },
      donatur: {
        btn: document.getElementById('pubTabBtnDonatur'),
        content: document.getElementById('pubTabContentDonatur'),
      },
    };

    const switchPublicTab = (targetKey: 'kabar' | 'laporan' | 'donatur') => {
      (Object.keys(tabMap) as Array<'kabar' | 'laporan' | 'donatur'>).forEach((key) => {
        const entry = tabMap[key];
        const isActive = key === targetKey;
        if (entry.btn) {
          entry.btn.classList.toggle('is-active', isActive);
          entry.btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        }
        if (entry.content) {
          entry.content.style.display = isActive ? 'block' : 'none';
        }
      });
    };

    tabMap.kabar.btn?.addEventListener('click', () => switchPublicTab('kabar'));
    tabMap.laporan.btn?.addEventListener('click', () => switchPublicTab('laporan'));
    tabMap.donatur.btn?.addEventListener('click', () => switchPublicTab('donatur'));

    const filterButtons = document.querySelectorAll<HTMLButtonElement>('#kabar-filter-bar .filter-pill');
    const cards = document.querySelectorAll<HTMLElement>('#kabar-grid .archive-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const selectedCat = btn.getAttribute('data-cat') || 'Semua';

        cards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (selectedCat === 'Semua' || cardCat === selectedCat) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  document.addEventListener('astro:page-load', setupKabarFiltersAndTabs);
  if (document.readyState !== 'loading') {
    setupKabarFiltersAndTabs();
  }
</script>

<style>
  .kabar-archive-page {
    background-color: #ffffff;
    min-height: 100vh;
    font-family: var(--font-sans);
  }

  .kabar-tab-bar {
    display: inline-flex;
    flex-wrap: nowrap;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    gap: 6px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 5px;
    border-radius: 9999px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
  }

  .kabar-tab-bar::-webkit-scrollbar {
    display: none;
  }

  .kabar-tab-btn {
    min-height: 44px;
    padding: 0 18px;
    border-radius: 9999px;
    border: 0;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
    flex-shrink: 0;
    cursor: pointer;
    background: transparent;
    color: #475569;
    transition: background-color 180ms cubic-bezier(0.2, 0.8, 0.2, 1), color 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @media (max-width: 640px) {
    .kabar-tab-bar {
      width: 100%;
      justify-content: space-between;
    }

    .kabar-tab-btn {
      padding: 0 12px;
      font-size: 12.5px;
    }
  }

  .kabar-tab-btn:hover {
    color: #0969da;
  }

  .kabar-tab-btn.is-active {
    background: #0969da;
    color: #ffffff;
  }

  .kabar-report-summary {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    padding: 32px;
    margin-bottom: 36px;
  }

  .kabar-report-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }

  .kabar-metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }

  .kabar-metric-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 20px;
  }

  .kabar-metric-label {
    font-size: 13px;
    font-weight: 600;
    color: #64748b;
  }

  .kabar-metric-val {
    font-size: 22px;
    font-weight: 800;
    color: #0f172a;
    margin-top: 6px;
    font-variant-numeric: tabular-nums;
  }

  .kabar-metric-val.is-brand {
    color: #0969da;
  }

  .kabar-metric-val.is-emerald {
    color: #059669;
  }

  .kabar-metric-sub {
    display: block;
    margin-top: 4px;
    font-size: 12px;
    color: #475569;
  }

  .kabar-reports-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }

  .kabar-report-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
  }

  .kabar-report-summary-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
    color: #475569;
    text-align: justify;
  }

  .kabar-donor-table-wrap {
    overflow-x: auto;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    background: #ffffff;
  }

  .kabar-donor-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    text-align: left;
  }

  .kabar-donor-table th {
    padding: 14px 18px;
    background: #f8fafc;
    color: #475569;
    font-weight: 600;
    border-bottom: 1px solid #e2e8f0;
    white-space: nowrap;
  }

  .kabar-donor-table td {
    padding: 14px 18px;
    border-bottom: 1px solid #f1f5f9;
    color: #0f172a;
    vertical-align: top;
  }

  .kabar-donor-table tbody tr:last-child td {
    border-bottom: none;
  }

  .kabar-donor-table td.is-num {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .kabar-donor-table td.is-bold {
