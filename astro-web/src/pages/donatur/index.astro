</style>

<script>
  function setupDonaturPage() {
    const tableBody = document.getElementById('donaturTableBody');
    const searchInput = document.getElementById('donorSearchInput') as HTMLInputElement | null;
    const tabsContainer = document.getElementById('programTabs');
    const displayCount = document.getElementById('displayCount');
    const emptyState = document.getElementById('tableEmptyState');
    const paginationFooter = document.getElementById('tablePaginationFooter');
    const pageNumbersWrap = document.getElementById('pageNumbers');
    const btnPrev = document.getElementById('btnPrevPage') as HTMLButtonElement | null;
    const btnNext = document.getElementById('btnNextPage') as HTMLButtonElement | null;
    const pageStart = document.getElementById('pageStart');
    const pageEnd = document.getElementById('pageEnd');
    const pageTotal = document.getElementById('pageTotal');

    if (!tableBody) return;

    const allRows = Array.from(tableBody.querySelectorAll<HTMLTableRowElement>('.donor-data-row'));
    const pageSize = 15;
    let currentPage = 1;
    let activeProgram = '';

    // Ambil initial active tab
    const initialActiveTab = tabsContainer?.querySelector<HTMLButtonElement>('.tab-pill.active');
    if (initialActiveTab) {
      activeProgram = initialActiveTab.getAttribute('data-prog') || '';
    }

    function getFilteredRows(): HTMLTableRowElement[] {
      const query = (searchInput?.value || '').trim().toLowerCase();

      return allRows.filter((row) => {
        const rowProg = row.getAttribute('data-prog') || '';
        const searchData = row.getAttribute('data-search') || '';

        const matchProg = !activeProgram || rowProg.includes(activeProgram);
        const matchSearch = !query || searchData.includes(query);

        return matchProg && matchSearch;
      });
    }

    function renderTable() {
      const filtered = getFilteredRows();
      const totalFiltered = filtered.length;
      const totalPages = Math.ceil(totalFiltered / pageSize) || 1;

      if (currentPage > totalPages) {
        currentPage = totalPages;
      }
      if (currentPage < 1) {
        currentPage = 1;
      }

      // Sembunyikan semua baris terlebih dahulu
      allRows.forEach((r) => {
        r.style.display = 'none';
      });

      // Tampilkan baris pada halaman aktif
      const startIndex = (currentPage - 1) * pageSize;
      const endIndex = Math.min(startIndex + pageSize, totalFiltered);

      for (let i = startIndex; i < endIndex; i++) {
        filtered[i].style.display = '';
      }

      // Update counters
      if (displayCount) displayCount.textContent = String(totalFiltered);
      if (pageStart) pageStart.textContent = totalFiltered === 0 ? '0' : String(startIndex + 1);
      if (pageEnd) pageEnd.textContent = String(endIndex);
      if (pageTotal) pageTotal.textContent = String(totalFiltered);

      // Toggle empty state & pagination footer
      if (emptyState) {
        emptyState.style.display = totalFiltered === 0 ? 'flex' : 'none';
      }
      if (paginationFooter) {
        paginationFooter.style.display = totalFiltered === 0 ? 'none' : 'flex';
      }

      // Update prev / next buttons
      if (btnPrev) btnPrev.disabled = currentPage <= 1;
      if (btnNext) btnNext.disabled = currentPage >= totalPages;

      // Render nomor halaman
      if (pageNumbersWrap) {
        pageNumbersWrap.innerHTML = '';
        for (let p = 1; p <= totalPages; p++) {
          if (
            p === 1 ||
            p === totalPages ||
            (p >= currentPage - 1 && p <= currentPage + 1)
          ) {
            const numBtn = document.createElement('button');
            numBtn.type = 'button';
            numBtn.className = `page-num-btn ${p === currentPage ? 'active' : ''}`;
            numBtn.textContent = String(p);
            numBtn.addEventListener('click', () => {
              currentPage = p;
              renderTable();
            });
            pageNumbersWrap.appendChild(numBtn);
          } else if (
            (p === currentPage - 2 && p > 2) ||
            (p === currentPage + 2 && p < totalPages - 1)
          ) {
            const ellipsis = document.createElement('span');
            ellipsis.textContent = '...';
            ellipsis.style.padding = '0 4px';
            ellipsis.style.color = '#94a3b8';
            pageNumbersWrap.appendChild(ellipsis);
          }
        }
      }
    }

    // Tab buttons event
    if (tabsContainer) {
      const tabButtons = tabsContainer.querySelectorAll<HTMLButtonElement>('.tab-pill');
      tabButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          tabButtons.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          activeProgram = btn.getAttribute('data-prog') || '';
          currentPage = 1;
          renderTable();
        });
      });
    }

    // Search input event
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        currentPage = 1;
        renderTable();
      });
    }

    // Prev / Next button events
    if (btnPrev) {
      btnPrev.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          renderTable();
        }
      });
    }

    if (btnNext) {
      btnNext.addEventListener('click', () => {
        currentPage++;
        renderTable();
      });
    }

    // Initial render
    renderTable();
  }

  setupDonaturPage();
  document.addEventListener('astro:page-load', setupDonaturPage);
</script>
