---
// src/pages/kemitraan.astro
// Halaman Khusus Kemitraan & Kolaborasi Multipihak Sesuai Pen.dev (Node EHsHA)
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import CollaborateSection from '../components/home/CollaborateSection.astro';
import MasonryGrid from '../components/ui/MasonryGrid.astro';
import { getActivePageSections } from '../lib/db';
import { getBreadcrumbSchema } from '../lib/seo-schema';

const activeSections = await getActivePageSections('kemitraan');
const sectionMap = new Map(activeSections.map((s) => [s.sectionKey, s]));
const isEnabled = (key: string) => {
  if (activeSections.length === 0) return true;
  return sectionMap.has(key);
};

const siteUrl = (Astro.site ? Astro.site.toString() : 'https://globalvillagefund.org').replace(/\/$/, '');
const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Kemitraan', url: '/kemitraan' },
];
const pageSchema = getBreadcrumbSchema(breadcrumbs, siteUrl);

const kemitraanGalleryItems = [
  {
    id: "01",
    title: "Kemitraan Vokasi & Keterampilan Santri",
    category: "Vokasi Mandiri",
    statusBadge: "Kemitraan Aktif",
    src: "https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/kegiatan-dan-prestasi-santri/santriwati-pose-ceria-di-paten-jonggol-3.webp",
    alt: "Kemitraan Pembinaan Keterampilan Santriwati di Jonggol",
    link: "/contact",
    description: "Kolaborasi pengembangan keterampilan hidup dan pembinaan adab santri bersama mitra.",
  },
  {
    id: "02",
    title: "Pemberdayaan Santriwati Berkarakter",
    category: "Pendidikan Holistik",
    statusBadge: "Kolaborasi CSR",
    src: "https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/kegiatan-dan-prestasi-santri/tiga-santriwati-pose-banner-paten-jonggol-2.webp",
    alt: "Tiga Santriwati Menunjukkan Karakter Mandiri Kolaborasi Mitra",
    link: "/contact",
    description: "Sinergi berkelanjutan untuk mendukung sarana belajar dan asrama santriwati berprestasi.",
  },
  {
    id: "03",
    title: "Syiar Musabaqah Al-Quran Pesantren",
    category: "Syiar Dakwah",
    statusBadge: "Panggung Syiar",
    src: "https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/kegiatan-dan-prestasi-santri/panggung-musabaqah-tilawatil-quran-jonggol.webp",
    alt: "Panggung Syiar Musabaqah Tilawatil Quran",
    link: "/program/zakat",
    description: "Dukungan kemitraan pada kegiatan syiar dakwah dan kompetisi keagamaan santri di wilayah Jonggol.",
  },
  {
    id: "04",
    title: "Prestasi Gemilang Santri Binaan",
    category: "Beasiswa Mitra",
    statusBadge: "Juara Musabaqah",
    src: "https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/kegiatan-dan-prestasi-santri/muhammad-syamil-ghazwan-juara-1-mtq-malam.webp",
    alt: "Muhammad Syamil Ghazwan Juara 1 MTQ Malam Hari",
    link: "/program/zakat",
    description: "Apresiasi beasiswa kemitraan bagi santri penghafal Al-Quran yang berprestasi mengharumkan lembaga.",
  },
  {
    id: "05",
    title: "Orientasi Generasi Pembelajar",
    category: "Pendidikan Masa Depan",
    statusBadge: "Regenerasi Santri",
    src: "https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/kegiatan-dan-prestasi-santri/santriwati-pose-di-depan-banner-mpls.webp",
    alt: "Santriwati Baru Memulai Pembinaan Karakter Pesantren",
    link: "/program/infaq",
    description: "Penerimaan santri baru dari kalangan dhuafa untuk memperoleh akses pendidikan berkualitas.",
  },
];

// Resolusi Konten Dinamis Halaman Kemitraan
const partnerHeroContent = sectionMap.get('partner_hero')?.content;
const partnerHeroTitle = partnerHeroContent?.heading || partnerHeroContent?.title || "Berkolaborasi untuk Menguatkan Ekosistem";
const partnerHeroSubtitle = partnerHeroContent?.subheading || partnerHeroContent?.subtitle || partnerHeroContent?.desc || "GVF membuka ruang kolaborasi dengan individu, komunitas, lembaga filantropi, dunia usaha, dan institusi pendidikan untuk mendukung pengembangan ekosistem Skill Village di Jonggol.";
const partnerHeroBgImage = partnerHeroContent?.imageUrl || "";
---

<BaseLayout
  title="Kemitraan Multipihak & Kolaborasi Strategis • Global Village Fund"
  description="Ruang sinergi korporasi (CSR), perguruan tinggi, dunia industri, dan lembaga filantropi untuk mengembangkan ekosistem pesantren mandiri berkelanjutan."
  schema={pageSchema}
>
  {isEnabled('partner_hero') && (
  <section class="pen-partner-banner">
    <div class="pen-banner-bg" style={partnerHeroBgImage ? `background-image: url('${partnerHeroBgImage}')` : undefined}></div>
    <div class="pen-banner-overlay"></div>
    <div class="pen-banner-container">
      <h1 class="pen-banner-title">{partnerHeroTitle}</h1>
      <p class="pen-banner-lead">
        {partnerHeroSubtitle}
      </p>
    </div>
  </section>
  )}

  {isEnabled('partner_benefits') && (
  <section class="pen-gallery-section">
    <div class="pen-container">
      <div class="pen-gallery-header">
        <h2 class="pen-gallery-title">
          Dokumentasi Kerja Sama &amp; Sinergi Lapangan
        </h2>
        <p class="pen-gallery-sub">
          Dokumentasi riil kunjungan mitra, pembangunan fasilitas belajar vokasi, dan sarana ibadah santri yang terwujud melalui gotong royong multipihak di Sukasirna, Jonggol.
        </p>
      </div>

      <div class="w-full mt-6">
        <MasonryGrid items={kemitraanGalleryItems} columns="columns-1 sm:columns-2 lg:columns-3" />
      </div>
    </div>
  </section>
  )}

  {isEnabled('partner_form') && (
    <>
      <CollaborateSection />

      <!-- Formulir Minat Kemitraan Multipihak -->
      <section class="pen-partner-form-section" id="form-kemitraan">
        <div class="pen-container">
          <div class="pen-form-header text-center">
            <h2 class="pen-form-title">
              Sampaikan Gagasan Kemitraan Anda
            </h2>
            <p class="pen-form-sub">
              Mari diskusikan bagaimana lembaga, perusahaan, atau keahlian Anda dapat berkolaborasi bersama Global Village Fund dalam memajukan peradaban dan kemandirian umat.
            </p>
          </div>

          <div class="pen-form-card">
            <form id="partnerForm" class="pen-actual-form">
              <div class="pen-form-grid">
                <div class="pen-field">
                  <label for="pName" class="pen-label">Nama Lengkap / PIC *</label>
                  <input type="text" id="pName" name="name" required class="pen-input" placeholder="Nama Anda" />
                </div>
                <div class="pen-field">
                  <label for="pOrg" class="pen-label">Lembaga / Perusahaan / Komunitas *</label>
                  <input type="text" id="pOrg" name="organization" required class="pen-input" placeholder="Nama instansi atau inisiatif" />
                </div>
                <div class="pen-field">
                  <label for="pPhone" class="pen-label">Nomor WhatsApp *</label>
                  <input type="tel" id="pPhone" name="phone" required class="pen-input" placeholder="0812-xxxx-xxxx" />
                </div>
                <div class="pen-field">
                  <label for="pCategory" class="pen-label">Kategori Minat Kolaborasi *</label>
                  <select id="pCategory" name="category" required class="pen-select">
                    <option value="" disabled selected>Pilih Kategori Kolaborasi</option>
                    <option value="Kolaborasi Program">Kolaborasi Program (Pendidikan, Beasiswa, & Fasilitas)</option>
                    <option value="Kolaborasi Keahlian">Kolaborasi Keahlian (Akademisi, Riset, & Vokasi)</option>
                    <option value="Kolaborasi Usaha">Kolaborasi Usaha (Offtaker Hasil Tani & Unit Produktif)</option>
                    <option value="Kolaborasi Filantropi">Kolaborasi Filantropi (Pendanaan Bersama & ZISWAF)</option>
                  </select>
                </div>
              </div>

              <div class="pen-field pen-field-full">
                <label for="pNotes" class="pen-label">Ringkasan Bentuk Kerja Sama *</label>
                <textarea id="pNotes" name="notes" rows="4" required class="pen-textarea" placeholder="Ceritakan ide kolaborasi, dukungan yang dapat diberikan, atau rencana sinergi yang ingin dibahas bersama..."></textarea>
              </div>

              <div class="pen-form-submit-wrap">
                <button type="submit" class="pen-btn-submit">
                  Kirimkan Minat Kolaborasi via WhatsApp
                </button>
              </div>
            </form>
          </div>
        </div>
      </section>

      <section class="pen-final-cta-section">
        <div class="pen-container">
          <div class="pen-cta-box">
            <h2 class="pen-cta-title">
              Mulai Perjalanan Kolaborasi Anda Bersama Kami
            </h2>
            <p class="pen-cta-desc">
              Bicaralah dengan tim kemitraan kami — tanpa beban dan tanpa tekanan. Kami siap menyusun skema kemitraan terbuka, program link &amp; match vokasi santri, serta wakaf produktif yang berdampak nyata.
            </p>
            <div class="pen-cta-btn-wrap">
              <a href="/contact" class="pen-btn-primary">
                Hubungi Tim Kemitraan
              </a>
            </div>
          </div>
        </div>
      </section>
    </>
  )}
</BaseLayout>

<script>
  const partnerForm = document.getElementById('partnerForm') as HTMLFormElement | null;
  if (partnerForm) {
    partnerForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(partnerForm);
      const name = fd.get('name') || '';
      const org = fd.get('organization') || '';
      const phone = fd.get('phone') || '';
      const category = fd.get('category') || '';
      const notes = fd.get('notes') || '';

      const text = `Assalamu'alaikum Admin GVF,\n\nSaya ingin menyampaikan minat kemitraan strategis:\n- Nama: ${name}\n- Lembaga: ${org}\n- Kontak/WA: ${phone}\n- Bidang Kolaborasi: ${category}\n- Rencana Kerja Sama: ${notes}\n\nMohon informasi tindak lanjut. Terima kasih.`;
      const waUrl = `https://wa.me/6281226832326?text=${encodeURIComponent(text)}`;
      window.open(waUrl, '_blank');
    });
  }
</script>

<style>
  .pen-partner-banner {
    position: relative;
    background-color: #061829;
    padding: 140px 0 90px 0;
    overflow: hidden;
    text-align: center;
  }
  .pen-banner-bg {
    position: absolute;
    inset: 0;
    background-image: url('https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/fasilitas-dan-infrastruktur/progres-konstruksi-gedung-dan-wudhu.webp');
    background-size: cover;
    background-position: center;
    opacity: 0.3;
    z-index: 0;
  }
  .pen-banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(6, 24, 41, 0.88) 0%, rgba(6, 24, 41, 0.96) 100%);
    z-index: 1;
  }
  .pen-banner-container {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .pen-banner-title {
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 700;
    color: #ffffff;
    font-family: 'Golos Text', system-ui, sans-serif;
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem 0;
  }
  .pen-breadcrumb-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .pen-breadcrumb-link {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s;
  }
  .pen-breadcrumb-link:hover {
    color: #ffffff;
  }
  .pen-breadcrumb-sep {
    color: #64748b;
  }
  .pen-breadcrumb-current {
    color: #0969da;
  }

  /* Universal Container */
  .pen-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .pen-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 6px 16px;
    border-radius: 9999px;
    background: rgba(9, 105, 218, 0.08);
    border: 1px solid rgba(9, 105, 218, 0.2);
    margin-bottom: 1.25rem;
  }
  .pen-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #0969da;
  }
  .pen-badge-text {
    font-size: 0.75rem;
    font-weight: 800;
    color: #0969da;
    letter-spacing: 0.1em;
  }

  /* 2. Gallery Section */
  .pen-gallery-section {
    background-color: #ffffff;
    padding: 100px 0 110px 0;
  }
  .pen-gallery-header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 4rem auto;
  }
  .pen-gallery-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 700;
    color: #0f172a;
    font-family: 'Golos Text', system-ui, sans-serif;
    line-height: 1.2;
    margin: 0 0 1rem 0;
  }
  .pen-gallery-sub {
    font-size: 1.05rem;
    line-height: 1.65;
    color: #64748b;
    margin: 0;
  }

  /* 3. Partner Form Section */
  .pen-partner-form-section {
    background-color: #f8fafc;
    padding: 90px 0 100px 0;
  }
  .pen-form-header {
    max-width: 720px;
    margin: 0 auto 3rem auto;
  }
  .pen-form-title {
    font-size: clamp(2rem, 3.5vw, 2.5rem);
    font-weight: 700;
    color: #0f172a;
    font-family: 'Golos Text', system-ui, sans-serif;
    margin: 0 0 1rem 0;
  }
  .pen-form-sub {
    font-size: 1.05rem;
    line-height: 1.6;
    color: #64748b;
  }
  .pen-form-card {
    max-width: 820px;
    margin: 0 auto;
    background: #ffffff;
    border-radius: 24px;
    padding: 2.5rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    border: 1px solid #e2e8f0;
  }
  .pen-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }
  @media (max-width: 640px) {
    .pen-form-grid {
      grid-template-columns: 1fr;
    }
  }
  .pen-field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .pen-field-full {
    margin-bottom: 2rem;
  }
  .pen-label {
    font-size: 0.875rem;
    font-weight: 700;
    color: #1e293b;
  }
  .pen-input, .pen-select, .pen-textarea {
    width: 100%;
    padding: 0.85rem 1.1rem;
    border-radius: 12px;
    border: 1px solid #cbd5e1;
    font-size: 0.95rem;
    font-family: inherit;
    color: #0f172a;
    background: #f8fafc;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .pen-input:focus, .pen-select:focus, .pen-textarea:focus {
    outline: none;
    border-color: #0969da;
    box-shadow: 0 0 0 3px rgba(9, 105, 218, 0.15);
    background: #ffffff;
  }
  .pen-form-submit-wrap {
    text-align: center;
  }
  .pen-btn-submit {
    display: inline-block;
    background-color: #0969da;
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 700;
    padding: 14px 32px;
    border-radius: 9999px;
    border: none;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(9, 105, 218, 0.25);
    transition: background-color 0.2s, transform 0.15s;
  }
  .pen-btn-submit:hover {
    background-color: #0752a8;
    transform: translateY(-2px);
  }

  /* 4. Final CTA */
  .pen-final-cta-section {
    background-color: #f8fafc;
    padding: 100px 0;
  }
  .pen-cta-box {
    background: linear-gradient(135deg, #0969da 0%, #0349b4 100%);
    border-radius: 28px;
    padding: 4.5rem 2rem;
    text-align: center;
    color: #ffffff;
    box-shadow: 0 16px 40px rgba(9, 105, 218, 0.2);
  }
  .pen-cta-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    font-family: 'Golos Text', system-ui, sans-serif;
    line-height: 1.25;
    margin: 0 0 1.25rem 0;
  }
  .pen-cta-desc {
    font-size: 1.12rem;
    line-height: 1.7;
    max-width: 680px;
    margin: 0 auto 2.5rem auto;
    color: rgba(255, 255, 255, 0.9);
  }
  .pen-btn-primary {
    display: inline-block;
    background-color: #ffffff;
    color: #0969da;
    font-size: 1.05rem;
    font-weight: 700;
    padding: 16px 36px;
    border-radius: 9999px;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    transition: transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .pen-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.22);
  }
  .pen-btn-primary:active {
    transform: scale(0.97);
  }

  @media (max-width: 640px) {
    .pen-partner-banner {
      padding: 110px 0 60px 0;
    }
  }
</style>
