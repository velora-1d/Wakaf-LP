  }

  .modal-title {
    font-size: 1.65rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem 0;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
  }

  .modal-location {
    display: flex;
    align-items: center;
