    transition: all 0.25s ease;
    box-shadow: 0 4px 16px rgba(9, 105, 218, 0.4);
  }

  .modal-btn-primary:hover {
    background-color: #0854ad;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(9, 105, 218, 0.55);
  }

  .modal-btn-secondary {
    display: inline-flex;
    align-items: center;
    background-color: transparent;
    color: #cbd5e1;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 10px 22px;
    border-radius: 30px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .modal-btn-secondary:hover {
    border-color: #0969da;
    color: #ffffff;
    background: rgba(9, 105, 218, 0.1);
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. FILTERING LOGIC
    const filterButtons = document.querySelectorAll('.isavo-filter-btn');
    const projectCards = document.querySelectorAll('.isavo-project-card-wrap');
    const emptyState = document.getElementById('empty-state');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filterVal = btn.getAttribute('data-filter');

        // Update active class
        filterButtons.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        let visibleCount = 0;

        projectCards.forEach((card) => {
          const category = card.getAttribute('data-category');
          if (filterVal === 'all' || category === filterVal) {
            visibleCount++;
            card.classList.remove('hide-card');
            // Smooth reveal
            setTimeout(() => {
              card.classList.add('fade-in');
              card.classList.remove('fade-out');
            }, 50);
          } else {
            card.classList.remove('fade-in');
            card.classList.add('fade-out');
            setTimeout(() => {
              card.classList.add('hide-card');
            }, 300);
          }
        });

        if (emptyState) {
          emptyState.style.display = visibleCount === 0 ? 'flex' : 'none';
        }
      });
    });

    // 2. LIGHTBOX MODAL LOGIC
    const modal = document.getElementById('portfolio-modal');
    const backdrop = document.getElementById('modal-backdrop');
    const closeBtn = document.getElementById('modal-close');
    const modalImg = document.getElementById('modal-img');
    const modalCategory = document.getElementById('modal-category');
    const modalStatus = document.getElementById('modal-status');
    const modalYear = document.getElementById('modal-year');
    const modalTitle = document.getElementById('modal-title');
    const modalLoc = document.getElementById('modal-loc-text');
    const modalSpecs = document.getElementById('modal-specs');
    const modalDesc = document.getElementById('modal-description');
    const modalWa = document.getElementById('modal-wa-cta');

    function openModal(data) {
      if (!modal) return;
      modalImg.src = data.image;
      modalImg.alt = data.title;
      modalCategory.textContent = data.category;
      modalStatus.textContent = data.status;
      modalYear.textContent = data.year;
      modalTitle.textContent = data.title;
      modalLoc.textContent = data.location;
      modalSpecs.textContent = data.specs;
      modalDesc.textContent = data.description;

      const waMsg = encodeURIComponent(
        `Assalamualaikum Admin Global Village Fund, saya tertarik untuk berwakaf / mendukung proyek "${data.title}" (${data.category}). Mohon info detailnya.`
      );
      modalWa.href = `https://wa.me/6281226832326?text=${waMsg}`;

      modal.classList.add('modal-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('modal-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    // Trigger modal from any card link
    document.querySelectorAll('.project-img-link').forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const data = {
          id: link.getAttribute('data-id'),
          title: link.getAttribute('data-title'),
          category: link.getAttribute('data-category'),
          image: link.getAttribute('data-image'),
          year: link.getAttribute('data-year'),
          status: link.getAttribute('data-status'),
          location: link.getAttribute('data-location'),
          specs: link.getAttribute('data-specs'),
          description: link.getAttribute('data-description')
        };
        openModal(data);
      });
    });

    document.querySelectorAll('.project-title-link').forEach((titleLink) => {
      titleLink.addEventListener('click', (e) => {
        e.preventDefault();
        const parentCard = titleLink.closest('.project-item');
        const imgLink = parentCard ? parentCard.querySelector('.project-img-link') : null;
        if (imgLink) {
          imgLink.click();
        }
      });
    });

    if (backdrop) backdrop.addEventListener('click', closeModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && modal.classList.contains('modal-open')) {
        closeModal();
      }
    });

    // 3. SCROLL REVEAL (IntersectionObserver)
    const observerOptions = {
      root: null,
      rootMargin: '0px 0px -50px 0px',
      threshold: 0.15
    };

    const cardObserver = new IntersectionObserver((entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('fade-in');
          obs.unobserve(entry.target);
        }
      });
    }, observerOptions);

    projectCards.forEach((card, idx) => {
      card.style.transitionDelay = `${(idx % 3) * 0.1}s`;
      cardObserver.observe(card);
    });
  });
</script>
