---

<BaseLayout
  title="Portofolio Proyek • Global Village Fund"
  description="Jelajahi portofolio pembangunan fasilitas ibadah, kawasan pendidikan holistik SMK Skill Village, dan pengembangan wakaf produktif Agro-Technopark di Jonggol, Jawa Barat."
>
  <!-- Page Header ala ISAVO -->
  <section class="isavo-portfolio-hero">
    <div class="isavo-hero-overlay"></div>
    <div class="isavo-hero-container">
      <div class="isavo-hero-content">
        <h1 class="isavo-hero-title">Portofolio Kami</h1>
        <div class="isavo-hero-breadcrumb">
          <span><a class="home-link" href="/">Home</a></span>
          <span class="icon-sep">-</span>
          <span class="current-link">Portofolio</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Project Section Inner ala ISAVO -->
  <section class="isavo-project-section">
    <div class="isavo-content-container">
      
      <!-- Filter Toolbar Buttons ala ISAVO -->
      <div class="isavo-filter-wrapper">
        <div class="isavo-filter-buttons" role="tablist" aria-label="Filter Kategori Portofolio">
          <button
            type="button"
            class="isavo-filter-btn active"
            data-filter="all"
            role="tab"
            aria-selected="true"
          >
            All
          </button>
          <button
            type="button"
            class="isavo-filter-btn"
            data-filter="ibadah"
            role="tab"
            aria-selected="false"
          >
            Fasilitas Ibadah
          </button>
          <button
            type="button"
            class="isavo-filter-btn"
            data-filter="pendidikan"
            role="tab"
            aria-selected="false"
          >
            Pendidikan & Studio
          </button>
          <button
            type="button"
            class="isavo-filter-btn"
            data-filter="agro"
            role="tab"
            aria-selected="false"
          >
            Agro-Technopark
          </button>
        </div>
      </div>

      <!-- Project Cards Grid (3 Columns ala ISAVO) -->
      <div class="isavo-project-grid" id="project-grid">
        {projects.map((item, index) => (
          <div
            class="isavo-project-card-wrap"
            data-category={item.filterKey}
            data-index={index}
          >
            <div class="project-item isavo-hover-view">
              <!-- Thumbnail Container with 4:3 Ratio -->
              <div class="project-img">
                <a
                  href={`#preview-${item.id}`}
                  class="project-img-link"
                  data-id={item.id}
                  data-title={item.title}
                  data-category={item.category}
                  data-image={item.image}
                  data-year={item.year}
                  data-status={item.status}
                  data-location={item.location}
                  data-specs={item.specs}
                  data-description={item.description}
                  aria-label={`Buka pratinjau ${item.title}`}
                >
                  <img
                    src={item.image}
                    alt={item.title}
                    loading={index < 6 ? "eager" : "lazy"}
                    decoding="async"
                    class="project-thumbnail"
                  />
                  <!-- Category Overlay Badge ala ISAVO -->
                  <div class="project-badge-pill">
                    <span>{item.category}</span>
                  </div>
                  <!-- Hover Zoom Overlay Icon -->
                  <div class="project-hover-overlay">
                    <span class="project-zoom-icon">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        <line x1="11" y1="8" x2="11" y2="14"></line>
                        <line x1="8" y1="11" x2="14" y2="11"></line>
                      </svg>
                    </span>
                  </div>
                </a>
              </div>

              <!-- Card Content ala ISAVO -->
              <div class="project-content">
                <h3 class="title">
                  <a
                    href={`#preview-${item.id}`}
                    class="project-title-link"
                    data-id={item.id}
                  >
                    {item.title}
                  </a>
                </h3>
                <div class="project-meta">
                  <span class="category-name">{item.category}</span>
                  <span class="meta-sep">•</span>
                  <span class="year-name">{item.year}</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Empty State (Fallback if filtered count is 0) -->
      <div class="isavo-empty-state" id="empty-state" style="display: none;">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <p>Tidak ada proyek dalam kategori yang dipilih.</p>
      </div>

    </div>
  </section>

  <!-- Interactive Project Lightbox Modal ala ISAVO High-End Design -->
  <div class="isavo-lightbox-modal" id="portfolio-modal" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="modal-backdrop" id="modal-backdrop"></div>
    <div class="modal-dialog">
      <button type="button" class="modal-close-btn" id="modal-close" aria-label="Tutup Pratinjau">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="modal-content">
        <!-- Big Preview Image -->
        <div class="modal-media-wrap">
          <img id="modal-img" src="" alt="Pratinjau Proyek" class="modal-image" />
          <div class="modal-badge" id="modal-category">Fasilitas Ibadah</div>
        </div>

        <!-- Detail Information -->
        <div class="modal-info-wrap">
          <div class="modal-header-info">
            <span class="modal-status-pill" id="modal-status">Tahap Konstruksi</span>
            <span class="modal-year" id="modal-year">2026</span>
          </div>

          <h2 class="modal-title" id="modal-title">Nama Proyek</h2>
          <p class="modal-location" id="modal-location">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span id="modal-loc-text">Jonggol, Bogor</span>
          </p>

          <div class="modal-specs-box">
            <h4 class="specs-heading">Spesifikasi & Keunggulan</h4>
            <p id="modal-specs">Spesifikasi proyek</p>
          </div>

          <div class="modal-desc-box">
            <p id="modal-description">Deskripsi lengkap proyek...</p>
          </div>

          <div class="modal-cta-row">
            <a
              id="modal-wa-cta"
              href="https://wa.me/6281226832326"
              target="_blank"
              rel="noopener noreferrer"
              class="modal-btn-primary"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
              <span>Wakaf untuk Proyek Ini</span>
            </a>
            <a href="/#simulasi" class="modal-btn-secondary">
              Simulasi Wakaf
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* ==========================================================================
     ISAVO PORTFOLIO PAGE STYLES (Match isavo.co.id/portofolio)
     Theme Accent: Royal Blue #0969da (Strictly NO Purple)
     ========================================================================== */

  /* --- 1. Hero Page Header --- */
  .isavo-portfolio-hero {
    position: relative;
    padding: 160px 0 90px 0;
    background-color: #0b1120;
    background-image: 
      radial-gradient(ellipse at 50% 0%, rgba(9, 105, 218, 0.18) 0%, transparent 70%),
      linear-gradient(180deg, #090d16 0%, #0f172a 100%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .isavo-hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 80% 20%, rgba(9, 105, 218, 0.12) 0%, transparent 50%);
    pointer-events: none;
  }

  .isavo-hero-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 2;
  }

  .isavo-hero-content {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .isavo-hero-title {
    font-size: clamp(2.5rem, 5.5vw, 4.2rem);
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.03em;
    font-family: 'Golos Text', 'Plus Jakarta Sans', sans-serif;
    margin: 0 0 1rem 0;
    line-height: 1.15;
  }

  .isavo-hero-breadcrumb {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.45rem 1.25rem;
    border-radius: 50px;
    backdrop-filter: blur(8px);
  }

  .isavo-hero-breadcrumb .home-link {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .isavo-hero-breadcrumb .home-link:hover {
    color: #ffffff;
  }

  .isavo-hero-breadcrumb .icon-sep {
    color: #64748b;
  }

  .isavo-hero-breadcrumb .current-link {
    color: #0969da;
    font-weight: 700;
  }

  /* --- 2. Project Section Inner --- */
  .isavo-project-section {
    padding: 90px 0 130px 0;
    background-color: #0a0e17;
    position: relative;
  }

  .isavo-content-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* --- 3. Filter Toolbar (Exact ISAVO Pill Buttons) --- */
  .isavo-filter-wrapper {
    display: flex;
    justify-content: center;
    margin-bottom: 4.5rem;
  }

  .isavo-filter-buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
  }

  .isavo-filter-btn {
    padding: 9px 26px;
    border-radius: 30px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background-color: transparent;
    color: #cbd5e1;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    font-family: inherit;
    outline: none;
    user-select: none;
  }

  .isavo-filter-btn:hover {
    border-color: #0969da;
    color: #ffffff;
    background-color: rgba(9, 105, 218, 0.12);
    transform: translateY(-2px);
  }

  .isavo-filter-btn.active {
    border-color: #0969da;
    background-color: #0969da;
    color: #ffffff;
    box-shadow: 0 8px 24px -4px rgba(9, 105, 218, 0.45);
    transform: translateY(-2px);
  }

  /* --- 4. 3-Column Responsive Grid --- */
  .isavo-project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem 2rem;
    transition: opacity 0.3s ease;
  }

  @media (max-width: 1024px) {
    .isavo-project-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .isavo-project-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* Card Item Animation Wrapper */
  .isavo-project-card-wrap {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
    will-change: transform, opacity;
  }

  .isavo-project-card-wrap.hide-card {
    display: none !important;
  }

  .isavo-project-card-wrap.fade-out {
    opacity: 0;
    transform: scale(0.95);
  }

  .isavo-project-card-wrap.fade-in {
    opacity: 1;
    transform: scale(1);
  }

  /* --- 5. Project Card Styles (Matching ISAVO) --- */
  .project-item.isavo-hover-view {
    display: flex;
    flex-direction: column;
    height: 100%;
    cursor: pointer;
  }

  .project-img {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 10px;
    background-color: #1e293b;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
  }

  .project-img-link {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    text-decoration: none;
  }

  .project-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.65s cubic-bezier(0.25, 1, 0.5, 1);
    display: block;
  }

  /* Hover Zoom Effect ala ISAVO */
  .project-item:hover .project-thumbnail {
    transform: scale(1.08);
  }

  /* Category Badge Pill on Image */
  .project-badge-pill {
    position: absolute;
    bottom: 14px;
    left: 14px;
    z-index: 3;
    background: rgba(9, 105, 218, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: 20px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.2);
    pointer-events: none;
    transition: all 0.3s ease;
  }

  .project-item:hover .project-badge-pill {
    background-color: #0969da;
    transform: translateY(-2px);
  }

  /* Hover Dark Gradient Overlay + Zoom Icon */
  .project-hover-overlay {
    position: absolute;
    inset: 0;
