---
// src/pages/tentang-kami.astro
// Halaman Profil & Tentang Kami Sesuai Desain Pen.dev (Node BtC15)
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import MasonryGrid from '../components/ui/MasonryGrid.astro';
import LeadershipSection from '../components/home/LeadershipSection.astro';
import { getActivePageSections } from '../lib/db';
import { getBreadcrumbSchema } from '../lib/seo-schema';

const activeSections = await getActivePageSections('tentang-kami');
const sectionMap = new Map(activeSections.map((s) => [s.sectionKey, s]));
const isEnabled = (key: string) => {
  if (activeSections.length === 0) return true;
  return sectionMap.has(key);
};

const siteUrl = (Astro.site ? Astro.site.toString() : 'https://globalvillagefund.org').replace(/\/$/, '');
const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Tentang Kami', url: '/tentang-kami' },
];
const pageSchema = getBreadcrumbSchema(breadcrumbs, siteUrl);

const tentangGalleryItems = [
  {
    id: "01",
    title: "Lorong Gedung Asrama Santri",
    category: "Fasilitas Kawasan",
    statusBadge: "Asrama Santri",
    src: "https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/media-lp/lorong-asrama-bata-merah.webp",
    alt: "Lorong Gedung Asrama Bata Merah Kawasan Pesantren Sukasirna",
    link: "/program/wakaf",
    description: "Karakter arsitektur bata merah ekspos pada lorong asrama santri yang asri dan sejuk di perbukitan Sukasirna.",
  },
  {
    id: "02",
    title: "Greenhouse Pertanian Modern",
    category: "Agroteknologi Santri",
    statusBadge: "Ketahanan Pangan",
    src: "https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/fasilitas-dan-infrastruktur/greenhouse-pertanian.webp",
    alt: "Greenhouse Pertanian Modern Skill Village Sukasirna",
    link: "/program/infaq",
    description: "Fasilitas budidaya pertanian modern dan hidroponik sebagai sarana praktik vokasi agroteknologi santri.",
  },
  {
    id: "03",
    title: "Prestasi Musabaqah Santri",
    category: "Syiar Dakwah",
    statusBadge: "Juara MTQ",
    src: "https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/kegiatan-dan-prestasi-santri/dua-santri-juara-2-mtq-jonggol-piala.webp",
    alt: "Santri Berprestasi Meraih Juara Musabaqah MTQ",
    link: "/program/zakat",
    description: "Capaian prestasi santri dhuafa binaan beasiswa zakat dalam ajang musabaqah tilawah Al-Quran.",
  },
  {
    id: "04",
    title: "Pembelajaran Adab & Syariah",
    category: "Kurikulum Holistik",
    statusBadge: "KBM Interaktif",
    src: "https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/kegiatan-dan-prestasi-santri/ustadz-menulis-materi-di-whiteboard.webp",
    alt: "Asatidz Menulis Materi dan Membimbing Santri di Kelas",
    link: "/program/sedekah",
    description: "Interaksi bimbingan intensif asatidz membekali santri pemahaman fiqih, tafsir, dan adab keseharian.",
  },
  {
    id: "05",
    title: "Kreativitas & Kriya Santriwati",
    category: "Keterampilan Hidup",
    statusBadge: "Karya Mandiri",
    src: "https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/santriwati-pose-karya-seni.webp",
    alt: "Santriwati Menunjukkan Hasil Karya Seni dan Kaligrafi",
    link: "/program/sedekah",
    description: "Karya seni, kaligrafi, dan kerajinan tangan santriwati sebagai bekal kreativitas dan kemandirian berkarya.",
  },
  {
    id: "06",
    title: "Ruang Ibadah Masjid Khairu Ummah",
    category: "Fasilitas Ibadah",
    statusBadge: "Pusat Ibadah",
    src: "https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/masjid-dan-kelas/masjid-tampak-dalam-2.jpeg",
    alt: "Suasana Ruang Sholat Utama Masjid Khairu Ummah Sugro",
    link: "/program/wakaf",
    description: "Ruang sholat utama masjid sebagai episentrum ibadah berjamaah, kajian subuh, dan majelis dzikir santri.",
  },
];
---

<BaseLayout
  title="Tentang Global Village Fund • Yayasan Permata Cendekia Indonesia"
  description="Membangun ekosistem pesantren integratif holistik di Sukasirna, Jonggol, Kabupaten Bogor menuju kemandirian dan kebermanfaatan abadi."
  schema={pageSchema}
>
  {isEnabled('about_hero') && (
  <section class="pen-about-banner">
    <div class="pen-banner-bg"></div>
    <div class="pen-banner-overlay"></div>
    <div class="pen-banner-container">
      <h1 class="pen-banner-title">Tentang Kami</h1>
      <p class="pen-banner-lead">
        Mengenal Global Village Fund dan ikhtiar filantropi yang menghubungkan kepedulian dengan pengembangan ekosistem Skill Village.
      </p>
    </div>
  </section>
  )}

  {isEnabled('about_stats') && (
  <section class="pen-about-intro">
    <div class="pen-container">
      <div class="pen-intro-grid">
        <div class="pen-intro-left">
          <h2 class="pen-intro-title">
            Mengenal Global Village Fund
          </h2>
          <p class="pen-intro-quote">
            Menghubungkan potensi filantropi dengan pengembangan ekosistem pendidikan, pemberdayaan, dan kemandirian untuk menghadirkan manfaat yang berkelanjutan.
          </p>
          <p class="pen-intro-lead">
            Global Village Fund (GVF) merupakan inisiatif filantropi Islam di bawah <strong>Yayasan Permata Cendekia Indonesia (YPCI)</strong> yang mengintegrasikan pengelolaan zakat, infak, sedekah, dan wakaf untuk mendukung pengembangan ekosistem pesantren. Melalui penghimpunan dan pengelolaan dana filantropi secara amanah, GVF menghubungkan kepedulian para donatur dengan berbagai kebutuhan dan program, meliputi pendidikan, pembinaan karakter, pengembangan kompetensi vokasi, pertanian produktif, fasilitas ibadah, serta penguatan sarana penunjang lainnya. Melalui kolaborasi dan pengelolaan yang bertanggung jawab, GVF berupaya menghadirkan manfaat nyata sekaligus memperkuat fondasi kemandirian ekosistem secara berkelanjutan.
          </p>
        </div>

        <div class="pen-intro-right">
          <div class="pen-intro-main-img">
            <img
              src="https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/masjid-dan-kelas/tampak-depan-asrama-putra.jpeg"
              alt="Gedung Pesantren Jonggol Tampak Luar"
              class="pen-img-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="pen-ecosystem-section">
    <div class="pen-container">
      <div class="pen-ecosystem-header">
        <div class="pen-ecosystem-badge">
          Satu Kepedulian
        </div>
        <h2 class="pen-ecosystem-title">
          Menghidupkan Banyak Kebermanfaatan
        </h2>
        <p class="pen-ecosystem-subtitle">
          Melalui filantropi, kami menghubungkan berbagai bentuk kebaikan untuk membangun ekosistem pesantren yang mandiri dan berkelanjutan.
        </p>
      </div>

      <div class="pen-ecosystem-grid">
        <!-- 1. Pendidikan -->
        <div class="pen-ecosystem-card">
          <div class="pen-eco-img-wrap">
            <img
              src="https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/ekosistem/pendidikan.webp"
              alt="Pendidikan - Membuka akses pendidikan berkualitas bagi generasi masa depan"
              class="pen-eco-img"
              loading="lazy"
            />
          </div>
          <div class="pen-eco-icon-badge" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
            </svg>
          </div>
          <div class="pen-eco-body">
            <h3 class="pen-eco-title">Pendidikan</h3>
            <p class="pen-eco-desc">
              Membuka akses pendidikan berkualitas bagi generasi masa depan.
            </p>
          </div>
        </div>

        <!-- 2. Keagamaan -->
        <div class="pen-ecosystem-card">
          <div class="pen-eco-img-wrap">
            <img
              src="https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/ekosistem/keagamaan.webp"
              alt="Keagamaan - Menghadirkan ruang ibadah dan pembinaan spiritual"
              class="pen-eco-img"
              loading="lazy"
            />
          </div>
          <div class="pen-eco-icon-badge" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v2" />
              <path d="M12 4c-3 1.5-4 4-4 7h8c0-3-1-5.5-4-7z" />
              <path d="M4 11h16v10H4z" />
              <path d="M10 21v-4a2 2 0 0 1 4 0v4" />
              <path d="M4 9h1v2H4z" />
              <path d="M19 9h1v2h-1z" />
            </svg>
          </div>
          <div class="pen-eco-body">
            <h3 class="pen-eco-title">Keagamaan</h3>
            <p class="pen-eco-desc">
              Menghadirkan ruang ibadah dan pembinaan spiritual.
            </p>
          </div>
        </div>

        <!-- 3. Hunian -->
        <div class="pen-ecosystem-card">
          <div class="pen-eco-img-wrap">
            <img
              src="https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/ekosistem/hunian.webp"
              alt="Hunian - Mendukung lingkungan tinggal yang layak bagi santri"
              class="pen-eco-img"
              loading="lazy"
            />
          </div>
          <div class="pen-eco-icon-badge" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
              <polyline points="9 22 9 12 15 12 15 22" />
            </svg>
          </div>
          <div class="pen-eco-body">
            <h3 class="pen-eco-title">Hunian</h3>
            <p class="pen-eco-desc">
              Mendukung lingkungan tinggal yang layak bagi santri.
            </p>
          </div>
        </div>

        <!-- 4. Ketahanan Pangan -->
        <div class="pen-ecosystem-card">
          <div class="pen-eco-img-wrap">
            <img
              src="https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/ekosistem/ketahanan-pangan.webp"
              alt="Ketahanan Pangan - Mengembangkan pertanian terpadu untuk kemandirian pangan"
              class="pen-eco-img"
              loading="lazy"
            />
          </div>
          <div class="pen-eco-icon-badge" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22v-9" />
              <path d="M12 13a5 5 0 0 0-5-5c0 4 2 6 5 6Z" />
              <path d="M12 13a5 5 0 0 1 5-5c0 4-2 6-5 6Z" />
            </svg>
          </div>
          <div class="pen-eco-body">
            <h3 class="pen-eco-title">Ketahanan Pangan</h3>
            <p class="pen-eco-desc">
              Mengembangkan pertanian terpadu untuk kemandirian pangan.
            </p>
          </div>
        </div>

        <!-- 5. Kemandirian Ekonomi -->
        <div class="pen-ecosystem-card">
          <div class="pen-eco-img-wrap">
            <img
              src="https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/ekosistem/kemandirian-ekonomi.webp"
              alt="Kemandirian Ekonomi - Menguatkan unit usaha produktif pesantren"
              class="pen-eco-img"
              loading="lazy"
            />
          </div>
          <div class="pen-eco-icon-badge" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="20" x2="18" y2="10" />
              <line x1="12" y1="20" x2="12" y2="4" />
              <line x1="6" y1="20" x2="6" y2="14" />
              <polyline points="3 8 9 2 13 6 21 2" />
              <polyline points="17 2 21 2 21 6" />
            </svg>
          </div>
          <div class="pen-eco-body">
            <h3 class="pen-eco-title">Kemandirian Ekonomi</h3>
            <p class="pen-eco-desc">
              Menguatkan unit usaha produktif pesantren.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="pen-workflow-section">
    <div class="pen-container">
      <div class="pen-workflow-header">
        <div class="pen-workflow-header-left">
          <h2 class="pen-section-title">
            Bagaimana Kebaikan Bergerak<br />
            Membangun Ekosistem
          </h2>
        </div>
        <div class="pen-workflow-header-right">
          <p class="pen-workflow-lead">
            Alur tata kelola dan penyaluran amanah yang terarah, transparan, dan berkesinambungan demi kemandirian santri dan kebermanfaatan jangka panjang.
          </p>
        </div>
      </div>

      <div class="pen-workflow-grid">
        <div class="pen-workflow-card">
          <div class="pen-wf-img-box">
            <img
              src="https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/kegiatan-dan-prestasi-santri/santriwati-menyimak-pengajian.webp"
              alt="Memahami Kebutuhan"
              class="pen-img-cover"
              loading="lazy"
            />
          </div>
          <div class="pen-wf-body">
            <h3 class="pen-wf-title">01. Memahami Kebutuhan</h3>
            <p class="pen-wf-desc">
              Mengenali kebutuhan riil santri dan peluang pengembangan kawasan terpadu secara langsung di lapangan Sukasirna, Jonggol.
            </p>
          </div>
        </div>

        <div class="pen-workflow-card">
          <div class="pen-wf-img-box">
            <img
              src="https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/kegiatan-dan-prestasi-santri/ustadz-menerangkan-di-depan-santri-ikhwan.webp"
              alt="Menghubungkan Kepedulian"
              class="pen-img-cover"
              loading="lazy"
            />
          </div>
          <div class="pen-wf-body">
            <h3 class="pen-wf-title">02. Menghubungkan Kepedulian</h3>
            <p class="pen-wf-desc">
              Mempertemukan niat baik donatur dan mitra melalui akad filantropi Islam (zakat, infak, sedekah, wakaf) serta ruang sinergi yang tepat sasaran.
            </p>
          </div>
        </div>

        <div class="pen-workflow-card">
          <div class="pen-wf-img-box">
            <img
              src="https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/masjid-dan-kelas/pondasi-kelas-lt2.jpeg"
              alt="Mewujudkan Pengembangan"
              class="pen-img-cover"
              loading="lazy"
            />
          </div>
          <div class="pen-wf-body">
            <h3 class="pen-wf-title">03. Mewujudkan Pengembangan</h3>
            <p class="pen-wf-desc">
              Mendukung pembangunan fisik sarana ibadah, pengadaan sarana belajar, beasiswa santri, dan rintisan unit produktif sesuai amanah peruntukan dana.
            </p>
          </div>
        </div>

        <div class="pen-workflow-card">
          <div class="pen-wf-img-box">
            <img
              src="https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/kegiatan-dan-prestasi-santri/sholat-berjamaah-imam-santri-belakang.webp"
              alt="Menumbuhkan Keberlanjutan"
              class="pen-img-cover"
              loading="lazy"
            />
          </div>
          <div class="pen-wf-body">
            <h3 class="pen-wf-title">04. Menumbuhkan Keberlanjutan</h3>
            <p class="pen-wf-desc">
              Mengembangkan manfaat jangka panjang agar menjadi bagian dari ekosistem Skill Village yang mandiri, produktif, dan saling menguatkan.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
  )}

  {isEnabled('about_gallery') && (
  <section class="pen-facility-section">
    <div class="pen-container">
      <div class="pen-facility-header">
        <div>
          <h2 class="pen-section-title">
            Dokumentasi Kawasan &amp;<br />
            Fasilitas Skill Village
          </h2>
          <p class="pen-facility-sub">
            Skill Village mengintegrasikan pendidikan dan pembinaan karakter, pengembangan bahasa, budaya kerja profesional, kepemimpinan, keterampilan vokasi, kewirausahaan, pertanian produktif, serta lingkungan kehidupan pesantren.
          </p>
        </div>
        <div class="pen-facility-tag">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block; vertical-align: -2px; margin-right: 4px;">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>Sukasirna, Jonggol, Bogor</span>
        </div>
      </div>

      <div class="w-full mt-6">
        <MasonryGrid items={tentangGalleryItems} columns="columns-1 sm:columns-2 lg:columns-3" />
      </div>
    </div>
  </section>
  )}

  {isEnabled('about_team') && (
    <>
      <LeadershipSection />

      <section class="pen-final-cta-section">
        <div class="pen-container">
          <div class="pen-cta-box">
            <h2 class="pen-cta-title">
              Mari Berkolaborasi Bersama Kami<br />
              Membangun Kemandirian Umat
            </h2>
            <p class="pen-cta-desc">
              Buka ruang kemitraan filantropi, zakat, infak, sedekah, dan wakaf produktif bersama Global Village Fund. Bersama-sama kita hadirkan dampak nyata dan berkelanjutan.
            </p>
            <div class="pen-cta-btn-wrap">
              <a href="/contact" class="pen-btn-primary">
                Konsultasi Program Kemitraan
              </a>
            </div>
          </div>
        </div>
      </section>
    </>
  )}
</BaseLayout>

<style>
  /* 1. Header Banner */
  .pen-about-banner {
    position: relative;
    background-color: #061829;
    padding: 140px 0 90px 0;
    overflow: hidden;
    text-align: center;
  }
  .pen-banner-bg {
    position: absolute;
    inset: 0;
    background-image: url('https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/fasilitas-dan-infrastruktur/konstruksi-atap-aula-paranet.webp');
    background-size: cover;
    background-position: center;
    opacity: 0.35;
    z-index: 0;
  }
  .pen-banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(6, 24, 41, 0.85) 0%, rgba(6, 24, 41, 0.95) 100%);
    z-index: 1;
  }
  .pen-banner-container {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .pen-banner-title {
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 700;
    color: #ffffff;
    font-family: 'Golos Text', system-ui, sans-serif;
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem 0;
  }
  .pen-banner-lead {
    font-size: 1.125rem;
    line-height: 1.6;
    color: #cbd5e1;
    max-width: 680px;
    margin: 0 auto;
  }
  .pen-breadcrumb-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .pen-breadcrumb-link {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s;
  }
  .pen-breadcrumb-link:hover {
    color: #ffffff;
  }
  .pen-breadcrumb-sep {
    color: #64748b;
  }
  .pen-breadcrumb-current {
    color: #0969da;
  }

  /* Universal Container & Elements */
  .pen-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .pen-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 6px 16px;
    border-radius: 9999px;
    background: rgba(9, 105, 218, 0.08);
    border: 1px solid rgba(9, 105, 218, 0.2);
