---
// src/pages/tentang-kami.astro
// Halaman Profil & Tentang Kami Sesuai Desain Pen.dev (Node BtC15)
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ElasticGallery from '../components/ui/ElasticGallery.astro';
import LeadershipSection from '../components/home/LeadershipSection.astro';
import { getActivePageSections } from '../lib/db';
import { getBreadcrumbSchema } from '../lib/seo-schema';

const activeSections = await getActivePageSections('tentang-kami');
const sectionMap = new Map(activeSections.map((s) => [s.sectionKey, s]));
const isEnabled = (key: string) => {
  if (activeSections.length === 0) return true;
  return sectionMap.has(key);
};

const siteUrl = (Astro.site ? Astro.site.toString() : 'https://globalvillagefund.org').replace(/\/$/, '');
const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Tentang Kami', url: '/tentang-kami' },
];
const pageSchema = getBreadcrumbSchema(breadcrumbs, siteUrl);

const tentangGalleryItems = [
  {
    id: "01",
    title: "Kemandirian Santriwati di Jonggol",
    category: "Pemberdayaan Santri",
    statusBadge: "Santri Berdaya",
    src: "https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/kegiatan-dan-prestasi-santri/santriwati-pose-ceria-di-paten-jonggol-1.webp",
    alt: "Kemandirian Santriwati di Jonggol",
    link: "/program/sedekah",
    description: "Santriwati aktif dalam pembinaan adab, sains, dan keterampilan hidup mandiri di Jonggol.",
  },
  {
    id: "02",
    title: "Majelis Bimbingan Asatidz",
    category: "Bimbingan Adab",
    statusBadge: "Kajian Rutin",
    src: "https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/kegiatan-dan-prestasi-santri/ustadz-ceramah-dengan-mikrofon.webp",
    alt: "Bimbingan Asatidz Mengisi Tausiyah Adab Santri",
    link: "/program/infaq",
    description: "Penyampaian ilmu syariah dan tausiyah akhlaq secara langsung dan berkala oleh asatidz pembina.",
  },
  {
    id: "03",
    title: "Prestasi Musabaqah Santri",
    category: "Syiar Dakwah",
    statusBadge: "Juara MTQ",
    src: "https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/kegiatan-dan-prestasi-santri/dua-santri-juara-2-mtq-jonggol-piala.webp",
    alt: "Santri Berprestasi Meraih Juara Musabaqah MTQ",
    link: "/program/zakat",
    description: "Capaian prestasi santri dhuafa binaan beasiswa zakat dalam ajang musabaqah tilawah.",
  },
  {
    id: "04",
    title: "Pendidikan Adab & Karakter FAST",
    category: "Kurikulum Holistik",
    statusBadge: "KBM Interaktif",
    src: "https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/kegiatan-dan-prestasi-santri/ustadz-mengajar-santri-aula.webp",
    alt: "Asatidz Mengajar Santri di Aula Terbuka",
    link: "/program/infaq",
    description: "Interaksi bimbingan asatidz membekali santri adab islami dan etika pergaulan yang luhur.",
  },
  {
    id: "05",
    title: "Kreativitas & Kebersamaan Santriwati",
    category: "Kemandirian Santri",
    statusBadge: "Santriwati FAST",
    src: "https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/kegiatan-dan-prestasi-santri/tiga-santriwati-pose-banner-paten-jonggol-1.webp",
    alt: "Tiga Santriwati Menunjukkan Karakter Mandiri",
    link: "/program/wakaf",
    description: "Semangat gotong royong dan kekompakan santriwati dalam keseharian asrama Jonggol.",
  },
];
---

<BaseLayout
  title="Tentang Global Village Fund • Yayasan Permata Cendekia Indonesia"
  description="Membangun ekosistem pesantren integratif holistik di Sukasirna, Jonggol, Kabupaten Bogor menuju kemandirian dan kebermanfaatan abadi."
  schema={pageSchema}
>
  {isEnabled('about_hero') && (
  <section class="pen-about-banner">
    <div class="pen-banner-bg"></div>
    <div class="pen-banner-overlay"></div>
    <div class="pen-banner-container">
      <h1 class="pen-banner-title">Tentang Kami</h1>
      <p class="pen-banner-lead">
        Mengenal Global Village Fund dan ikhtiar filantropi yang menghubungkan kepedulian dengan pengembangan ekosistem Skill Village.
      </p>
    </div>
  </section>
  )}

  {isEnabled('about_stats') && (
  <section class="pen-about-intro">
    <div class="pen-container">
      <div class="pen-intro-grid">
        <div class="pen-intro-left">
          <h2 class="pen-intro-title">
            Mengenal Global Village Fund
          </h2>
          <p class="pen-intro-quote">
            Menghubungkan potensi filantropi dengan pengembangan ekosistem pendidikan, pemberdayaan, dan kemandirian untuk menghadirkan manfaat yang berkelanjutan.
          </p>

          <div class="pen-intro-stat-row">
            <div class="pen-stat-card">
              <span class="pen-stat-num">3</span>
              <div class="pen-stat-label">
                Hektare<br />
                Kawasan Terpadu
              </div>
            </div>
            <div class="pen-intro-sub-img">
              <img
                src="https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/kegiatan-dan-prestasi-santri/santriwati-fokus-mencatat-pelajaran.webp"
                alt="Santri Tekun Mencatat Materi Pelajaran"
                class="pen-img-cover"
                loading="lazy"
              />
            </div>
          </div>
        </div>

        <div class="pen-intro-right">
          <div class="pen-intro-main-img">
            <img
              src="https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/masjid-dan-kelas/tampak-depan-asrama-putra.jpeg"
              alt="Gedung Pesantren Jonggol Tampak Luar"
              class="pen-img-cover"
              loading="lazy"
            />
          </div>
          <p class="pen-intro-lead">
            Global Village Fund (GVF) merupakan inisiatif filantropi Islam di bawah <strong>Yayasan Permata Cendekia Indonesia (YPCI)</strong> yang mengintegrasikan pengelolaan zakat, infak, sedekah, dan wakaf untuk mendukung pengembangan ekosistem pesantren. Melalui penghimpunan dan pengelolaan dana filantropi secara amanah, GVF menghubungkan kepedulian para donatur dengan berbagai kebutuhan dan program, meliputi pendidikan, pembinaan karakter, pengembangan kompetensi vokasi, pertanian produktif, fasilitas ibadah, serta penguatan sarana penunjang lainnya. Melalui kolaborasi dan pengelolaan yang bertanggung jawab, GVF berupaya menghadirkan manfaat nyata sekaligus memperkuat fondasi kemandirian ekosistem secara berkelanjutan.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="pen-timeline-section">
    <div class="pen-container">
      <div class="pen-section-header-center">
        <div class="pen-badge-pill pen-badge-center">
          <span class="pen-badge-dot"></span>
          <span class="pen-badge-text">PERJALANAN &amp; PENGEMBANGAN EKOSISTEM</span>
        </div>
        <h2 class="pen-section-title-center">
          Perjalanan dan Pengembangan Ekosistem
        </h2>
        <p class="pen-section-subtitle-center">
          Dari sebuah gagasan, tumbuh menjadi ikhtiar membangun ekosistem yang saling terhubung dan berkelanjutan.
        </p>
      </div>

      <div class="pen-timeline-wrap">
        <div class="pen-timeline-line"></div>
        <div class="pen-timeline-grid">
          <div class="pen-timeline-item">
            <div class="pen-timeline-img-box">
              <img
                src="https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/masjid-dan-kelas/bagian-atas-masjid.jpeg"
                alt="Inisiasi Gagasan 2021"
                class="pen-img-cover"
                loading="lazy"
              />
            </div>
            <div class="pen-timeline-dot"></div>
            <h3 class="pen-timeline-year">2021</h3>
            <p class="pen-timeline-desc">
              Inisiasi gagasan ekosistem pesantren integratif holistik di bawah Yayasan Permata Cendekia Indonesia (YPCI) untuk menjawab tantangan kemandirian umat.
            </p>
          </div>

          <div class="pen-timeline-item">
            <div class="pen-timeline-img-box">
              <img
                src="https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/masjid-dan-kelas/asrama-putri-yang-belum-jadi.jpeg"
                alt="Pembebasan Lahan dan Konstruksi Aula 2023"
                class="pen-img-cover"
                loading="lazy"
              />
            </div>
            <div class="pen-timeline-dot"></div>
            <h3 class="pen-timeline-year">2023</h3>
            <p class="pen-timeline-desc">
              Pembebasan lahan abadi 3 hektare di Desa Sukasirna, Jonggol dan peresmian SMK Skill Village Islamic School berbasis kurikulum karakter FAST.
            </p>
          </div>

          <div class="pen-timeline-item">
            <div class="pen-timeline-img-box">
              <img
                src="https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/masjid-dan-kelas/green-house-yang-belum-jadi.jpeg"
                alt="Pembangunan Gedung Asrama dan Sarana Ibadah 2025"
                class="pen-img-cover"
                loading="lazy"
              />
            </div>
            <div class="pen-timeline-dot"></div>
            <h3 class="pen-timeline-year">2025</h3>
            <p class="pen-timeline-desc">
              Groundbreaking pembangunan Masjid Khairu Ummah Sugro dua lantai ramah lingkungan dan sarana halaqah serta wudhu terpadu santri.
            </p>
          </div>

          <div class="pen-timeline-item">
            <div class="pen-timeline-img-box">
              <img
                src="https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/fasilitas-dan-infrastruktur/dinding-hebel-ventilasi-roster-1.webp"
                alt="Pengembangan Pertanian Terpadu 2026"
                class="pen-img-cover"
                loading="lazy"
              />
            </div>
            <div class="pen-timeline-dot"></div>
            <h3 class="pen-timeline-year">2026 – Sekarang</h3>
            <p class="pen-timeline-desc">
              Pengembangan unit kebun produktif dan pertanian terpadu untuk menopang ketahanan pangan mandiri asrama santri.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="pen-workflow-section">
    <div class="pen-container">
      <div class="pen-workflow-header">
        <div class="pen-workflow-header-left">
          <div class="pen-badge-pill">
            <span class="pen-badge-dot"></span>
            <span class="pen-badge-text">TATA KELOLA AMANAH</span>
          </div>
          <h2 class="pen-section-title">
            Bagaimana Kebaikan Bergerak<br />
            Membangun Ekosistem
          </h2>
        </div>
        <div class="pen-workflow-header-right">
          <p class="pen-workflow-lead">
            Alur tata kelola dan penyaluran amanah yang terarah, transparan, dan berkesinambungan demi kemandirian santri dan kebermanfaatan jangka panjang.
          </p>
        </div>
      </div>

      <div class="pen-workflow-grid">
        <div class="pen-workflow-card">
          <div class="pen-wf-img-box">
            <img
              src="https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/kegiatan-dan-prestasi-santri/santriwati-menyimak-pengajian.webp"
              alt="Memahami Kebutuhan"
              class="pen-img-cover"
              loading="lazy"
            />
          </div>
          <div class="pen-wf-body">
            <h3 class="pen-wf-title">01. Memahami Kebutuhan</h3>
            <p class="pen-wf-desc">
              Mengenali kebutuhan riil santri dan peluang pengembangan kawasan terpadu secara langsung di lapangan Sukasirna, Jonggol.
            </p>
          </div>
        </div>

        <div class="pen-workflow-card">
          <div class="pen-wf-img-box">
            <img
              src="https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/kegiatan-dan-prestasi-santri/ustadz-menerangkan-di-depan-santri-ikhwan.webp"
              alt="Menghubungkan Kepedulian"
              class="pen-img-cover"
              loading="lazy"
            />
          </div>
          <div class="pen-wf-body">
            <h3 class="pen-wf-title">02. Menghubungkan Kepedulian</h3>
            <p class="pen-wf-desc">
              Mempertemukan niat baik donatur dan mitra melalui akad filantropi Islam (zakat, infak, sedekah, wakaf) serta ruang sinergi yang tepat sasaran.
            </p>
          </div>
        </div>

        <div class="pen-workflow-card">
          <div class="pen-wf-img-box">
            <img
              src="https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/masjid-dan-kelas/pondasi-kelas-lt2.jpeg"
              alt="Mewujudkan Pengembangan"
              class="pen-img-cover"
              loading="lazy"
            />
          </div>
          <div class="pen-wf-body">
            <h3 class="pen-wf-title">03. Mewujudkan Pengembangan</h3>
            <p class="pen-wf-desc">
              Mendukung pembangunan fisik sarana ibadah, pengadaan sarana belajar, beasiswa santri, dan rintisan unit produktif sesuai amanah peruntukan dana.
            </p>
          </div>
        </div>

        <div class="pen-workflow-card">
          <div class="pen-wf-img-box">
            <img
              src="https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/kegiatan-dan-prestasi-santri/sholat-berjamaah-imam-santri-belakang.webp"
              alt="Menumbuhkan Keberlanjutan"
              class="pen-img-cover"
              loading="lazy"
            />
          </div>
          <div class="pen-wf-body">
            <h3 class="pen-wf-title">04. Menumbuhkan Keberlanjutan</h3>
            <p class="pen-wf-desc">
              Mengembangkan manfaat jangka panjang agar menjadi bagian dari ekosistem Skill Village yang mandiri, produktif, dan saling menguatkan.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
  )}

  {isEnabled('about_gallery') && (
  <section class="pen-facility-section">
    <div class="pen-container">
      <div class="pen-facility-header">
        <div>
          <div class="pen-badge-pill">
            <span class="pen-badge-dot"></span>
            <span class="pen-badge-text">EKOSISTEM &amp; FASILITAS</span>
          </div>
          <h2 class="pen-section-title">
            Dokumentasi Kawasan &amp;<br />
            Fasilitas Skill Village
          </h2>
          <p class="pen-facility-sub">
            Skill Village mengintegrasikan pendidikan dan pembinaan karakter, pengembangan bahasa, budaya kerja profesional, kepemimpinan, keterampilan vokasi, kewirausahaan, pertanian produktif, serta lingkungan kehidupan pesantren.
          </p>
        </div>
        <div class="pen-facility-tag">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block; vertical-align: -2px; margin-right: 4px;">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>Sukasirna, Jonggol, Bogor</span>
        </div>
      </div>

      <div class="w-full">
        <ElasticGallery defaultActiveId="01" items={tentangGalleryItems} />
      </div>
    </div>
  </section>
  )}

  {isEnabled('about_team') && (
    <>
      <LeadershipSection />

      <section class="pen-final-cta-section">
        <div class="pen-container">
          <div class="pen-cta-box">
            <h2 class="pen-cta-title">
              Mari Berkolaborasi Bersama Kami<br />
              Membangun Kemandirian Umat
            </h2>
            <p class="pen-cta-desc">
              Buka ruang kemitraan filantropi, zakat, infak, sedekah, dan wakaf produktif bersama Global Village Fund. Bersama-sama kita hadirkan dampak nyata dan berkelanjutan.
            </p>
            <div class="pen-cta-btn-wrap">
              <a href="/contact" class="pen-btn-primary">
                Konsultasi Program Kemitraan
              </a>
            </div>
          </div>
        </div>
      </section>
    </>
  )}
</BaseLayout>

<style>
  /* 1. Header Banner */
  .pen-about-banner {
    position: relative;
    background-color: #061829;
    padding: 140px 0 90px 0;
    overflow: hidden;
    text-align: center;
  }
  .pen-banner-bg {
    position: absolute;
    inset: 0;
    background-image: url('https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/fasilitas-dan-infrastruktur/konstruksi-atap-aula-paranet.webp');
    background-size: cover;
    background-position: center;
    opacity: 0.35;
    z-index: 0;
  }
  .pen-banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(6, 24, 41, 0.85) 0%, rgba(6, 24, 41, 0.95) 100%);
    z-index: 1;
  }
  .pen-banner-container {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .pen-banner-title {
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 700;
    color: #ffffff;
    font-family: 'Golos Text', system-ui, sans-serif;
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem 0;
  }
  .pen-banner-lead {
    font-size: 1.125rem;
    line-height: 1.6;
    color: #cbd5e1;
    max-width: 680px;
    margin: 0 auto;
  }
  .pen-breadcrumb-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .pen-breadcrumb-link {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s;
  }
  .pen-breadcrumb-link:hover {
    color: #ffffff;
  }
  .pen-breadcrumb-sep {
    color: #64748b;
  }
  .pen-breadcrumb-current {
    color: #0969da;
  }

  /* Universal Container & Elements */
  .pen-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .pen-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 6px 16px;
    border-radius: 9999px;
    background: rgba(9, 105, 218, 0.08);
    border: 1px solid rgba(9, 105, 218, 0.2);
    margin-bottom: 1.25rem;
  }
  .pen-badge-center {
    margin-left: auto;
    margin-right: auto;
  }
  .pen-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #0969da;
  }
  .pen-badge-text {
    font-size: 0.75rem;
    font-weight: 800;
    color: #0969da;
    letter-spacing: 0.1em;
  }
  .pen-img-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* 2. Section Intro */
  .pen-about-intro {
    background-color: #f8fafc;
    padding: 100px 0;
  }
  .pen-intro-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3.5rem;
    align-items: center;
  }
  .pen-intro-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 700;
    color: #0f172a;
    font-family: 'Golos Text', system-ui, sans-serif;
    line-height: 1.2;
    margin: 0 0 1rem 0;
  }
  .pen-intro-quote {
    font-size: 1.05rem;
    line-height: 1.65;
    color: #475569;
    margin: 0 0 2rem 0;
    font-weight: 500;
  }
  .pen-intro-stat-row {
    display: flex;
    gap: 2rem;
    align-items: center;
  }
  .pen-stat-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 160px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.03);
  }
  .pen-stat-num {
    font-size: 3.8rem;
    font-weight: 800;
    color: #0969da;
    line-height: 1;
    font-family: 'Golos Text', system-ui, sans-serif;
  }
  .pen-stat-label {
    font-size: 0.95rem;
    font-weight: 700;
    color: #1e293b;
    margin-top: 0.5rem;
    line-height: 1.3;
  }
  .pen-intro-sub-img {
    flex: 1;
    height: 200px;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0,0,0,0.06);
  }
