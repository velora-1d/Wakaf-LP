---
// src/pages/index.astro
// Halaman Utama GVF Presisi Mengadopsi Blueprint Narasi Filantropi & Clean UI
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import WhyWeExistSection from '../components/home/WhyWeExistSection.astro';
import AboutSplitSection from '../components/home/AboutSplitSection.astro';
import OurApproachSection from '../components/home/OurApproachSection.astro';
import OurProgramsSection from '../components/home/OurProgramsSection.astro';
import DonationChannelsSection from '../components/home/DonationChannelsSection.astro';
import FeaturedCampaignSection from '../components/home/FeaturedCampaignSection.astro';
import TransparencySection from '../components/home/TransparencySection.astro';
import CollaborateSection from '../components/home/CollaborateSection.astro';
import ShowcaseSection from '../components/home/ShowcaseSection.astro';
import LeadershipSection from '../components/home/LeadershipSection.astro';
import SimulasiSection from '../components/home/SimulasiSection.astro';
import ContactSection from '../components/home/ContactSection.astro';
import FinalCtaSection from '../components/home/FinalCtaSection.astro';
---

<BaseLayout
  title="Global Village Fund • Wakaf Produktif & Pendidikan Berkelanjutan"
  description="Kawasan Wakaf Terpadu seluas ±3 hektare di Jonggol Bogor. Memadukan Garden Mosque Khairu Ummah, SMK Skill Village Islamic School, dan Agro-Technopark."
>
  <!-- 01. Hero Section (First Screen 4 Slide) -->
  <HeroSection />

  <!-- 02. Kenapa Global Village Fund? (Section Pendek & 4 Kotak) -->
  <WhyWeExistSection />

  <!-- 03. About Global Village Fund (Wadah Kebaikan & Lokasi Riil) -->
  <AboutSplitSection />

  <!-- 04. Our Approach (6 Rantai Transformasi Kebaikan ke Kebermanfaatan) -->
  <OurApproachSection />

  <!-- 05. Our Programs (4 Kartu Program Kebaikan Ekosistem) -->
  <OurProgramsSection />

  <!-- 06. Donation Channels (Saluran Kebaikan Donatur) -->
  <DonationChannelsSection />

  <!-- 07. Featured Campaign (Pembangunan Masjid Khairu Ummah Sugro) -->
  <FeaturedCampaignSection />

  <!-- 08. Transparency & Governance (Kepercayaan Dibangun dengan Keterbukaan) -->
  <TransparencySection />

  <!-- 09. Collaborate & Partnership (Matriks Kemitraan) -->
  <CollaborateSection />

  <!-- Galeri & Dokumentasi Proyek Terpadu (Dual-Row Scroll Parallax) -->
  <ShowcaseSection />

  <!-- Temui Dewan & Pengurus GVF (Exact ISAVO Team Switcher) -->
  <LeadershipSection />

  <!-- Simulasi & Kalkulator Wakaf ala ISAVO Simulasi Biaya -->
  <SimulasiSection />

  <!-- Section Kontak & Konsultasi Langsung -->
  <ContactSection />

  <!-- 13. Final CTA & Brand Closing (Satu Kebaikan Bisa Menjadi Awal Banyak Kebaikan) -->
  <FinalCtaSection />
</BaseLayout>
