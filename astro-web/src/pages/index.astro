---
// src/pages/index.astro
// Halaman Utama Global Village Fund — 100% Selaras Standar Desain ISAVO (isavo.co.id)
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import OurProgramsSection from '../components/home/OurProgramsSection.astro';
import AboutSplitSection from '../components/home/AboutSplitSection.astro';
import InteractiveServicesSection from '../components/home/InteractiveServicesSection.astro';
import WorkflowSection from '../components/home/WorkflowSection.astro';
import ShowcaseSection from '../components/home/ShowcaseSection.astro';
import LeadershipSection from '../components/home/LeadershipSection.astro';
import VideoSection from '../components/home/VideoSection.astro';
import NewsSection from '../components/home/NewsSection.astro';
import FinalCtaSection from '../components/home/FinalCtaSection.astro';
import { getActivePageSections } from '../lib/db';

// Fetch active sections from PostgreSQL with safe fallback
const activeSections = await getActivePageSections('home');
const sectionMap = new Map(activeSections.map((s) => [s.sectionKey, s]));

// Safe helper: If DB returns records, check if sectionKey is in active sections.
// If DB is offline / empty, default to true so public site never breaks!
const isEnabled = (key: string) => {
  if (activeSections.length === 0) return true;
  return sectionMap.has(key);
};
---

<BaseLayout
  title="Global Village Fund • Wakaf Produktif & Pendidikan Berkelanjutan"
  description="Kawasan Wakaf Terpadu seluas ±3 hektare di Jonggol Bogor. Memadukan Garden Mosque Khairu Ummah, SMK Skill Village Islamic School, dan Agro-Technopark."
>
  {isEnabled('hero') && <HeroSection />}
  {isEnabled('programs_preview') && <OurProgramsSection />}
  {isEnabled('about_split') && <AboutSplitSection />}
  {isEnabled('interactive_services') && <InteractiveServicesSection />}
  {isEnabled('workflow') && <WorkflowSection />}
  {isEnabled('showcase_gallery') && <ShowcaseSection />}
  {isEnabled('leadership') && <LeadershipSection />}
  {isEnabled('video_documentary') && <VideoSection />}
  {isEnabled('news_section') && <NewsSection />}
  {isEnabled('final_cta') && <FinalCtaSection />}
</BaseLayout>
