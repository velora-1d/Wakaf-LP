---
// src/pages/index.astro
// Halaman Utama GVF Presisi 100% Mengadopsi Desain UI/UX ISAVO (isavo.co.id)
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import QuickActionBar from '../components/home/QuickActionBar.astro';
import AboutSplitSection from '../components/home/AboutSplitSection.astro';
import WhyWeExistSection from '../components/home/WhyWeExistSection.astro';
import OurApproachSection from '../components/home/OurApproachSection.astro';
import WhereSupportGoesSection from '../components/home/WhereSupportGoesSection.astro';
import PillarsSection from '../components/home/PillarsSection.astro';
import InteractiveServicesSection from '../components/home/InteractiveServicesSection.astro';
import WaterfallWorkflowSection from '../components/home/WaterfallWorkflowSection.astro';
import ShowcaseSection from '../components/home/ShowcaseSection.astro';
import LeadershipSection from '../components/home/LeadershipSection.astro';
import SimulasiSection from '../components/home/SimulasiSection.astro';
import ContactSection from '../components/home/ContactSection.astro';
---

<BaseLayout
  title="Global Village Fund • Wakaf Produktif & Pendidikan Berkelanjutan"
  description="Kawasan Wakaf Terpadu seluas ±3 hektare di Jonggol Bogor. Memadukan Garden Mosque Khairu Ummah, SMK Skill Village Islamic School, dan Agro-Technopark."
>
  <!-- 01. Hero Section & Quick Actions -->
  <HeroSection />
  <QuickActionBar />

  <!-- 02. Who We Are (Satu Wadah Kebaikan) -->
  <AboutSplitSection />

  <!-- 03. Why We Exist (Data Kemenag & Rantai Transformasi) -->
  <WhyWeExistSection />

  <!-- 04. Our Approach (Model Ekosistem ABCFG Berpusat pada Masjid) -->
  <OurApproachSection />

  <!-- 05. Where Your Support Goes (6 Pilar Alokasi Kebaikan) -->
  <WhereSupportGoesSection />

  <!-- 05.5 Tiga Pilar Fasilitas Utama (Garden Mosque, Skill Village, Agro-Technopark) -->
  <PillarsSection />

  <!-- 4. Screenshot 2: "Jelajahi Layanan Desain Interior" Interactive Tabbed Showcase + 4-Column Stats -->
  <InteractiveServicesSection />

  <!-- 5. Screenshot 3: "Cara Kami Bekerja" Descending 4-Card Waterfall Process -->
  <WaterfallWorkflowSection />

  <!-- 6. Galeri & Dokumentasi Proyek (Dual-Row Scroll Parallax) -->
  <ShowcaseSection />

  <!-- 7. Temui Dewan & Pengurus GVF (Exact ISAVO Team Switcher) -->
  <LeadershipSection />

  <!-- 8. Simulasi & Kalkulator Wakaf ala "Simulasi Biaya" -->
  <SimulasiSection />

  <!-- 9. Section Kontak & Konsultasi (Exact ISAVO Contact UI/UX) -->
  <ContactSection />
</BaseLayout>
