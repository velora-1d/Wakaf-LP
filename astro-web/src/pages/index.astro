---
// src/pages/index.astro
// Halaman Utama Global Village Fund — 100% Selaras Standar Desain ISAVO (isavo.co.id)
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import OurProgramsSection from '../components/home/OurProgramsSection.astro';
import AboutSplitSection from '../components/home/AboutSplitSection.astro';
import InteractiveServicesSection from '../components/home/InteractiveServicesSection.astro';
import WorkflowSection from '../components/home/WorkflowSection.astro';
import ShowcaseSection from '../components/home/ShowcaseSection.astro';
import LeadershipSection from '../components/home/LeadershipSection.astro';
import SimulasiSection from '../components/home/SimulasiSection.astro';
import ContactSection from '../components/home/ContactSection.astro';
import FinalCtaSection from '../components/home/FinalCtaSection.astro';
---

<BaseLayout
  title="Global Village Fund • Wakaf Produktif & Pendidikan Berkelanjutan"
  description="Kawasan Wakaf Terpadu seluas ±3 hektare di Jonggol Bogor. Memadukan Garden Mosque Khairu Ummah, SMK Skill Village Islamic School, dan Agro-Technopark."
>
  <!-- 01. Hero Slider Cinematic (First Screen 4 Slide) -->
  <HeroSection />

  <!-- 02. Layanan / Program Utama: 4 Kartu Putih Radius 24px ala ISAVO Screenshot 2 -->
  <OurProgramsSection />

  <!-- 03. Tentang Kami: Split Dark Section, Checklist, Foto & GVF Watermark ala ISAVO Screenshot 1 -->
  <AboutSplitSection />

  <!-- 04. Pilar Vokasi & Counter Capaian: Foto Preview + List 01-04 + 4 Kolom Angka ala ISAVO Screenshot 2 & 4 -->
  <InteractiveServicesSection />

  <!-- 05. Cara Kami Bekerja: 4 Langkah Kartu dengan Foto Riil & Angka Watermark ala ISAVO Screenshot 3 -->
  <WorkflowSection />

  <!-- 06. Portofolio & Dokumentasi Fisik Kawasan: Dual-Row Scroll Parallax -->
  <ShowcaseSection />

  <!-- 07. Temui Dewan & Pengurus GVF: Exact ISAVO Team Switcher -->
  <LeadershipSection />

  <!-- 08. Simulasi Partisipasi & Kalkulator Wakaf ala ISAVO Simulasi Biaya -->
  <SimulasiSection />

  <!-- 09. Kontak & Konsultasi Langsung -->
  <ContactSection />

  <!-- 10. Final CTA & Brand Closing -->
  <FinalCtaSection />
</BaseLayout>
