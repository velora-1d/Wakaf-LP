---
interface Props {
  title: string;
  activeSlug?: string;
}

const { title, activeSlug } = Astro.props;
const adminUser = (Astro.locals as any).adminUser || { name: 'Administrator GVF', role: 'superadmin' };

const navPages = [
  { slug: 'home', name: 'Beranda Utama', icon: 'home' },
  { slug: 'tentang-kami', name: 'Tentang Kami', icon: 'info' },
  { slug: 'kemitraan', name: 'Kemitraan', icon: 'handshake' },
  { slug: 'contact', name: 'Kontak', icon: 'phone' },
  { slug: 'wakaf', name: 'Program Wakaf', icon: 'layers' },
  { slug: 'infaq', name: 'Program Infaq', icon: 'gift' },
  { slug: 'sedekah', name: 'Program Sedekah', icon: 'heart' },
  { slug: 'zakat', name: 'Program Zakat', icon: 'shield' },
];
---

<!doctype html>
<html lang="id" class="h-full bg-slate-50">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - GVF CMS Admin Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      body {
        font-family: 'Golos Text', -apple-system, BlinkMacSystemFont, sans-serif;
      }
    </style>
  </head>
  <body class="h-full antialiased text-slate-800 bg-[#f8fafc] flex flex-col md:flex-row">
    <!-- Sidebar Navigation -->
    <aside class="w-full md:w-64 bg-[#0b1120] text-slate-300 flex flex-col shrink-0 border-r border-slate-800 min-h-screen">
      <!-- Sidebar Header -->
      <div class="h-16 flex items-center px-6 border-b border-slate-800/80 gap-3">
        <div class="w-8 h-8 rounded-lg bg-[#0969da] flex items-center justify-center text-white font-bold text-sm shadow-md shadow-[#0969da]/30">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
          </svg>
        </div>
        <div>
          <span class="font-bold text-white tracking-tight text-sm block">Global Village Fund</span>
          <span class="text-[11px] text-blue-400 block font-medium">Dynamic Section CMS</span>
        </div>
      </div>

      <!-- Navigation Links -->
      <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
        <a
          href="/admin"
          class={`flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors ${
            !activeSlug ? 'bg-[#0969da] text-white shadow-sm' : 'text-slate-400 hover:text-white hover:bg-slate-800/60'
          }`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="7" height="9" x="3" y="3" rx="1"/>
            <rect width="7" height="5" x="14" y="3" rx="1"/>
            <rect width="7" height="9" x="14" y="12" rx="1"/>
            <rect width="7" height="5" x="3" y="16" rx="1"/>
          </svg>
          <span>Dashboard Overview</span>
        </a>

        <div class="pt-4 pb-1 px-3">
          <span class="text-[10px] uppercase font-bold tracking-wider text-slate-500">Halaman & Section</span>
        </div>

        {navPages.map((page) => {
          const isActive = activeSlug === page.slug;
          return (
            <a
              href={`/admin/pages/${page.slug}`}
              class={`flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium transition-colors ${
                isActive ? 'bg-[#0969da] text-white shadow-sm font-semibold' : 'text-slate-400 hover:text-white hover:bg-slate-800/50'
              }`}
            >
              <div class="flex items-center gap-2.5">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={isActive ? 'text-white' : 'text-slate-500'}>
                  <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
                  <polyline points="14 2 14 8 20 8"/>
                </svg>
                <span>{page.name}</span>
              </div>
              <span class={`text-[10px] px-1.5 py-0.5 rounded font-mono ${isActive ? 'bg-white/20 text-white' : 'bg-slate-800 text-slate-400'}`}>
                /{page.slug === 'home' ? '' : page.slug}
              </span>
            </a>
          );
        })}
      </nav>

      <!-- User Profile & Logout -->
      <div class="p-3 border-t border-slate-800/80 bg-[#080d19]">
        <div class="flex items-center justify-between p-2 rounded-xl bg-slate-900/80 border border-slate-800/60">
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="w-8 h-8 rounded-lg bg-blue-900/60 border border-blue-700/50 flex items-center justify-center text-blue-300 font-bold text-xs shrink-0">
              {adminUser.username.substring(0, 2).toUpperCase()}
            </div>
            <div class="min-w-0">
              <p class="text-xs font-semibold text-white truncate">{adminUser.name}</p>
              <p class="text-[10px] text-slate-400 truncate capitalize">{adminUser.role}</p>
            </div>
          </div>
          <a
            href="/api/admin/logout"
            class="text-slate-400 hover:text-red-400 p-1.5 rounded-lg hover:bg-slate-800 transition-colors"
            title="Keluar dari Admin"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
              <polyline points="16 17 21 12 16 7"/>
              <line x1="21" x2="9" y1="12" y2="12"/>
            </svg>
          </a>
        </div>
      </div>
    </aside>

    <!-- Main Content Container -->
    <div class="flex-1 flex flex-col min-w-0 overflow-y-auto min-h-screen">
      <!-- Top Header Bar -->
      <header class="h-16 bg-white border-b border-slate-200 px-6 flex items-center justify-between sticky top-0 z-30 shadow-xs">
        <div class="flex items-center gap-3">
          <h1 class="text-base font-bold text-slate-900">{title}</h1>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            PostgreSQL GVF Online
          </span>
        </div>

        <div class="flex items-center gap-3">
          <a
            href={activeSlug ? (activeSlug === 'home' ? '/' : (['wakaf','infaq','sedekah','zakat'].includes(activeSlug) ? `/program/${activeSlug}` : `/${activeSlug}`)) : '/'}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#0969da] hover:text-[#0752a8] bg-blue-50 hover:bg-blue-100/70 border border-blue-200 px-3 py-1.5 rounded-lg transition-colors"
          >
            <span>Buka Website Publik</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" x2="21" y1="14" y2="3"/>
            </svg>
          </a>
        </div>
      </header>

      <!-- Main Body -->
      <main class="flex-1 p-6 max-w-7xl w-full mx-auto">
        <slot />
      </main>

      <!-- Footer Bar -->
      <footer class="py-4 px-6 border-t border-slate-200 text-xs text-slate-500 bg-white flex flex-col sm:flex-row items-center justify-between gap-2">
        <p>&copy; 2026 Global Village Fund &bull; Dynamic Section Engine v1.0 (SSR Node Mode)</p>
        <p class="font-mono text-[11px] text-slate-400">PostgreSQL Tailscale: 100.77.202.57:5433</p>
      </footer>
    </div>

    <!-- Global Toast Container -->
    <div id="toastContainer" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <script>
      (window as any).showToast = function (message: string, isError = false) {
        const container = document.getElementById('toastContainer');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = `pointer-events-auto px-4 py-3 rounded-xl shadow-xl border text-xs font-medium flex items-center gap-2.5 transition-all duration-300 transform translate-y-2 opacity-0 ${
          isError
            ? 'bg-red-900 border-red-700 text-white'
            : 'bg-slate-900 border-slate-700 text-white'
        }`;
        toast.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${isError ? 'text-red-400' : 'text-blue-400'}">
            ${isError 
              ? '<circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/>' 
              : '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>'}
          </svg>
          <span>${message}</span>
        `;
        container.appendChild(toast);

        requestAnimationFrame(() => {
          toast.classList.remove('translate-y-2', 'opacity-0');
        });

        setTimeout(() => {
          toast.classList.add('opacity-0', 'translate-y-2');
          setTimeout(() => toast.remove(), 300);
        }, 3000);
      };
    </script>
  </body>
</html>
