---
// src/layouts/BaseLayout.astro
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import 'lenis/dist/lenis.css';
import '../styles/tailwind.css';
import '../styles/design-tokens.css';


interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Global Village Fund • Wakaf Produktif & Pendidikan Berkelanjutan",
  description = "Wadah filantropi dan wakaf produktif untuk pembangunan Masjid Khairu Ummah Sugro dan Pesantren Integratif Holistik SMK Skill Village Islamic School.",
  ogImage = "/logo-gvf.png"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />

  <!-- Open Graph / Meta -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Global Village Fund" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />

  <!-- Favicon -->
  <link rel="icon" type="image/webp" href="/favicon.webp" />
  <link rel="apple-touch-icon" href="/favicon.webp" />

  <!-- Fonts Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
</head>
<body>
  <Navbar />
  <main id="main-content">
    <slot />
  </main>
  <Footer />

  <!-- Floating Scroll Percentage Badge ala ISAVO (Bottom Right) -->
  <div class="isavo-scroll-badge" id="scroll-percentage" aria-hidden="true">
    <span id="scroll-pct-text">0%</span>
  </div>

  <!-- Floating WhatsApp Action Badge ala ISAVO (Bottom Right with Pulse Ring) -->
  <a
    href="https://wa.me/6281226832326?text=Assalamualaikum%20Admin%20Global%20Village%20Fund%2C%20saya%20ingin%20konsultasi%20program%20wakaf."
    target="_blank"
    rel="noopener noreferrer"
    class="isavo-floating-wa"
    aria-label="Chat WhatsApp Admin"
  >
    <span class="isavo-wa-pulse-ring"></span>
    <svg viewBox="0 0 24 24" fill="currentColor" class="isavo-wa-icon">
      <path d="M20.52 3.48A11.93 11.93 0 0 0 12.06 0C5.46 0 .09 5.37.09 11.97c0 2.11.55 4.17 1.6 5.99L0 24l6.23-1.63a11.9 11.9 0 0 0 5.83 1.51h.01c6.6 0 11.97-5.37 11.97-11.97 0-3.2-1.25-6.21-3.52-8.43zM12.06 21.88h-.01a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.75.98 1-3.65-.23-.38a9.92 9.92 0 0 1-1.52-5.27c0-5.49 4.47-9.96 9.97-9.96 2.66 0 5.16 1.04 7.04 2.92a9.9 9.9 0 0 1 2.92 7.04c0 5.5-4.47 9.96-9.97 9.96zm5.46-7.46c-.3-.15-1.77-.87-2.04-.97-.28-.1-.48-.15-.68.15-.2.3-.78.97-.95 1.17-.18.2-.35.22-.65.08-.3-.15-1.26-.47-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.52-.07-.15-.68-1.64-.93-2.24-.24-.6-.49-.51-.68-.52l-.58-.01c-.2 0-.52.07-.8.38-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.21 3.07.15.2 2.1 3.2 5.09 4.49.71.31 1.27.49 1.7.63.72.23 1.37.2 1.88.12.58-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.18-1.42-.08-.12-.28-.2-.58-.35z"/>
    </svg>
  </a>

  <!-- Lenis + GSAP ScrollTrigger Professional Animation Engine -->
  <script>
    import Lenis from 'lenis';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    if (typeof window !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);

      // ── 1. Lenis Smooth Scroll Engine ──────────────────────────────────
      const lenis = new Lenis({
        smoothWheel: true,
        wheelMultiplier: 1.6,
        touchMultiplier: 1.3,
        lerp: 0.12,
      });

      (window as any).lenis = lenis;
      (window as any).__isavoLenis = lenis;

      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => { lenis.raf(time * 1000); });
      gsap.ticker.lagSmoothing(0);

      window.dispatchEvent(new CustomEvent('lenis:ready', { detail: lenis }));

      // ── 2. Scroll Percentage Indicator ────────────────────────────────
      const pctBadge = document.getElementById('scroll-pct-text');
      lenis.on('scroll', (e: any) => {
        if (pctBadge) {
          const pct = Math.min(100, Math.max(0, Math.round(e.progress * 100)));
          pctBadge.textContent = `${pct}%`;
        }
      });

      // ── 3. Smooth hash scroll ─────────────────────────────────────────
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          const href = anchor.getAttribute('href');
          if (href && href.length > 1) {
            const target = document.querySelector(href);
            if (target) {
              e.preventDefault();
              lenis.scrollTo(target as HTMLElement, { offset: -85, immediate: false });
            }
          }
        });
      });

      // ── 4. GSAP ScrollTrigger Reveal System ───────────────────────────
      // A. Simple reveal-up: paragraphs, leads, descriptions
      gsap.utils.toArray<HTMLElement>('.reveal-on-scroll').forEach((el) => {
        const delay = parseFloat(el.dataset.delay || '0');
        gsap.fromTo(el,
          { opacity: 0, y: 36 },
          {
            opacity: 1, y: 0,
            duration: 0.9,
            delay,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: el,
              start: 'top 88%',
              toggleActions: 'play none none none',
            }
          }
        );
      });

      // B. Scale reveal: badges, images, cards with reveal-scale class
      gsap.utils.toArray<HTMLElement>('.reveal-scale').forEach((el) => {
        const delay = parseFloat(el.dataset.delay || '0');
        gsap.fromTo(el,
          { opacity: 0, scale: 0.94 },
          {
            opacity: 1, scale: 1,
            duration: 0.8,
            delay,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: el,
              start: 'top 88%',
              toggleActions: 'play none none none',
            }
          }
        );
      });

      // C. Stagger grid: children of .reveal-stagger get cascading reveal
      gsap.utils.toArray<HTMLElement>('.reveal-stagger').forEach((parent) => {
        const children = parent.children;
        gsap.fromTo(children,
          { opacity: 0, y: 40 },
          {
            opacity: 1, y: 0,
            duration: 0.75,
            stagger: 0.12,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: parent,
              start: 'top 85%',
              toggleActions: 'play none none none',
            }
          }
        );
      });

      // D. Line reveal: headings with .reveal-heading get word-by-word stagger
      gsap.utils.toArray<HTMLElement>('.reveal-heading').forEach((el) => {
        // Split text by words (no SplitText plugin — vanilla approach)
        const original = el.innerHTML;
        const words = el.textContent?.split(' ') || [];
        if (words.length < 2) {
          // Single word: just reveal up
          gsap.fromTo(el,
            { opacity: 0, y: 30 },
            {
              opacity: 1, y: 0, duration: 0.8, ease: 'power3.out',
              scrollTrigger: { trigger: el, start: 'top 88%', toggleActions: 'play none none none' }
            }
          );
          return;
        }
        el.innerHTML = words.map(w =>
          `<span class="word-wrap" style="display:inline-block;overflow:hidden;vertical-align:bottom"><span class="word-inner" style="display:inline-block">${w}&nbsp;</span></span>`
        ).join('');
        const inners = el.querySelectorAll('.word-inner');
        gsap.fromTo(inners,
          { y: '100%', opacity: 0 },
          {
            y: '0%', opacity: 1,
            duration: 0.65,
            stagger: 0.055,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: el,
              start: 'top 88%',
              toggleActions: 'play none none none',
            }
          }
        );
      });

      // E. Counter animation for stat numbers with .count-up
      gsap.utils.toArray<HTMLElement>('.count-up').forEach((el) => {
        const endVal = parseFloat(el.dataset.target || el.textContent || '0');
        const suffix = el.dataset.suffix || '';
        const prefix = el.dataset.prefix || '';
        const isDecimal = endVal % 1 !== 0;
        gsap.fromTo({ val: 0 }, { val: endVal },
          {
            duration: 2,
            ease: 'power2.out',
            onUpdate: function() {
              const v = this.targets()[0].val;
              el.textContent = prefix + (isDecimal ? v.toFixed(1) : Math.round(v).toString()) + suffix;
            },
            scrollTrigger: {
              trigger: el,
              start: 'top 85%',
              toggleActions: 'play none none none',
            }
          }
        );
      });

      // F. Image parallax: images with .parallax-img move slower than scroll
      gsap.utils.toArray<HTMLElement>('.parallax-img').forEach((img) => {
        const speed = parseFloat((img as HTMLElement).dataset.speed || '20');
        gsap.fromTo(img,
          { yPercent: -speed },
          {
            yPercent: speed,
            ease: 'none',
            scrollTrigger: {
              trigger: img.closest('.parallax-wrap') || img.parentElement,
              start: 'top bottom',
              end: 'bottom top',
              scrub: true,
            }
          }
        );
      });
    }
  </script>
</body>
</html>

<style is:global>
  /* ==========================================================================
     GVF Professional Animation System
     GSAP ScrollTrigger handles all reveal animations.
     CSS hanya set initial state agar tidak terjadi flash-of-content.
     ========================================================================== */

  /* Initial hidden state — GSAP akan animasikan ke visible */
  .reveal-on-scroll,
  .reveal-scale,
  .reveal-heading {
    opacity: 0;
  }

  /* Stagger parent: children akan di-set oleh GSAP, tapi set invisible dulu */
  .reveal-stagger > * {
    opacity: 0;
  }

  /* Reduced motion: langsung tampilkan semua */
  @media (prefers-reduced-motion: reduce) {
    .reveal-on-scroll,
    .reveal-scale,
    .reveal-heading,
    .reveal-stagger > * {
      opacity: 1 !important;
      transform: none !important;
    }
  }

  /* Word split helper */
  .word-wrap { display: inline-block; overflow: hidden; vertical-align: bottom; }
  .word-inner { display: inline-block; }

  /* ── Button active state global ─────────────────────────────────── */
  .gvf-btn:active,
  .isavo-btn-primary-pill:active,
  .isavo-btn-outline-pill:active {
    transform: translateY(0) !important;
  }

  /* ── Focus visible: keyboard accessibility ──────────────────────── */
  :focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
    border-radius: 4px;
  }
</style>

<style>
  #main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow-x: clip;
  }

  /* Floating Scroll Percentage Badge ala ISAVO (Right Bottom) */
  .isavo-scroll-badge {
    position: fixed;
    bottom: 96px;
    right: 28px;
    z-index: 998;
    width: 44px;
    height: 44px;
    background-color: #ffffff;
    border: 2px solid #0969da;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 800;
    color: #0969da;
    font-family: monospace;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    pointer-events: none;
    transition: transform 0.2s ease;
  }

  /* Floating WhatsApp circular badge ala ISAVO */
  .isavo-floating-wa {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 999;
    width: 54px;
    height: 54px;
    background-color: #25d366;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    box-shadow: 0 8px 25px rgba(37, 211, 102, 0.45);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    text-decoration: none;
  }

  .isavo-floating-wa:hover {
    transform: scale(1.1);
    box-shadow: 0 12px 30px rgba(37, 211, 102, 0.65);
  }

  .isavo-wa-icon {
    width: 30px;
    height: 30px;
    position: relative;
    z-index: 2;
  }

  /* Continuous Subtle Pulse Ring Animation */
  .isavo-wa-pulse-ring {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 2px solid rgba(37, 211, 102, 0.6);
    animation: isavoPulse 2.2s infinite cubic-bezier(0.24, 0, 0.38, 1);
    pointer-events: none;
  }

  @keyframes isavoPulse {
    0% {
      transform: scale(0.9);
      opacity: 0.9;
    }
    60% {
      transform: scale(1.35);
      opacity: 0;
    }
    100% {
      transform: scale(1.35);
      opacity: 0;
    }
  }

  @media (max-width: 768px) {
    .isavo-scroll-badge {
      display: none;
    }
    .isavo-floating-wa {
      bottom: 18px;
      right: 18px;
      width: 48px;
      height: 48px;
    }
    .isavo-wa-icon {
      width: 26px;
      height: 26px;
    }
  }
</style>
