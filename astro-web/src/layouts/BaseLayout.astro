---
// src/layouts/BaseLayout.astro
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import 'lenis/dist/lenis.css';
import '../styles/tailwind.css';
import '../styles/design-tokens.css';
import { getOrganizationSchema, getWebSiteSchema } from '../lib/seo-schema';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  canonicalUrl?: string;
  noindex?: boolean;
  schema?: Record<string, any> | Record<string, any>[] | null;
}

const {
  title = "Global Village Fund • Wakaf Produktif & Pendidikan Berkelanjutan",
  description = "Wadah filantropi dan wakaf produktif untuk pembangunan Masjid Khairu Ummah Sugro dan Pesantren Integratif Holistik SMK Skill Village Islamic School.",
  ogImage = "/logo-gvf.png",
  ogType = "website",
  canonicalUrl,
  noindex = false,
  schema = null,
} = Astro.props;

const siteUrl = (Astro.site ? Astro.site.toString() : 'https://globalvillagefund.org').replace(/\/$/, '');
const currentPath = Astro.url.pathname;
const canonicalHref = canonicalUrl || `${siteUrl}${currentPath === '/' ? '' : currentPath}`;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;
const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

// Base schemas (Organization & WebSite)
const baseSchemas = [
  getOrganizationSchema(siteUrl),
  getWebSiteSchema(siteUrl),
];

const customSchemas = Array.isArray(schema)
  ? schema.filter(Boolean)
  : schema
    ? [schema]
    : [];

const allSchemas = [...baseSchemas, ...customSchemas];
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalHref} />

  <!-- Robots & Indexing -->
  <meta name="robots" content={robotsContent} />
  <meta name="googlebot" content={robotsContent} />

  <!-- Open Graph / Meta -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Global Village Fund" />
  <meta property="og:url" content={canonicalHref} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={fullOgImage} />
  <meta property="og:locale" content="id_ID" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@globalvillagefund" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullOgImage} />

  <!-- Structured Data JSON-LD -->
  {allSchemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}

  <!-- Favicon -->
  <link rel="icon" type="image/webp" href="/favicon.webp" />
  <link rel="apple-touch-icon" href="/favicon.webp" />

  <!-- Fonts Preconnect & Official Golos Text -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
</head>
<body>
  <Navbar />
  <main id="main-content">
    <slot />
  </main>
  <Footer />

  <div class="gvf-scroll-badge" id="scroll-percentage" aria-hidden="true">
    <span id="scroll-pct-text">0%</span>
  </div>

  <a
    href="https://wa.me/6281226832326?text=Assalamualaikum%20Admin%20Global%20Village%20Fund%2C%20saya%20ingin%20konsultasi%20program%20wakaf."
    target="_blank"
    rel="noopener noreferrer"
    class="gvf-floating-wa"
    aria-label="Chat WhatsApp Admin"
  >
    <span class="gvf-wa-pulse-ring"></span>
    <svg viewBox="0 0 24 24" fill="currentColor" class="gvf-wa-icon">
      <path d="M20.52 3.48A11.93 11.93 0 0 0 12.06 0C5.46 0 .09 5.37.09 11.97c0 2.11.55 4.17 1.6 5.99L0 24l6.23-1.63a11.9 11.9 0 0 0 5.83 1.51h.01c6.6 0 11.97-5.37 11.97-11.97 0-3.2-1.25-6.21-3.52-8.43zM12.06 21.88h-.01a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.75.98 1-3.65-.23-.38a9.92 9.92 0 0 1-1.52-5.27c0-5.49 4.47-9.96 9.97-9.96 2.66 0 5.16 1.04 7.04 2.92a9.9 9.9 0 0 1 2.92 7.04c0 5.5-4.47 9.96-9.97 9.96zm5.46-7.46c-.3-.15-1.77-.87-2.04-.97-.28-.1-.48-.15-.68.15-.2.3-.78.97-.95 1.17-.18.2-.35.22-.65.08-.3-.15-1.26-.47-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.52-.07-.15-.68-1.64-.93-2.24-.24-.6-.49-.51-.68-.52l-.58-.01c-.2 0-.52.07-.8.38-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.21 3.07.15.2 2.1 3.2 5.09 4.49.71.31 1.27.49 1.7.63.72.23 1.37.2 1.88.12.58-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.18-1.42-.08-.12-.28-.2-.58-.35z"/>
    </svg>
  </a>

  <script>
    import Lenis from 'lenis';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    if (typeof window !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);

      // Lenis smooth scroll
      const lenis = new Lenis({
        smoothWheel: true,
        wheelMultiplier: 1.6,
        touchMultiplier: 1.3,
        lerp: 0.12,
      });

      (window as any).lenis = lenis;
      (window as any).__gvfLenis = lenis;

      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => { lenis.raf(time * 1000); });
      gsap.ticker.lagSmoothing(0);

      window.dispatchEvent(new CustomEvent('lenis:ready', { detail: lenis }));

      // Scroll percentage indicator
      const pctBadge = document.getElementById('scroll-pct-text');
      lenis.on('scroll', (e: any) => {
        if (pctBadge) {
          const pct = Math.min(100, Math.max(0, Math.round(e.progress * 100)));
          pctBadge.textContent = `${pct}%`;
        }
      });

      // Smooth hash anchor scroll
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          const href = anchor.getAttribute('href');
          if (href && href.length > 1) {
            const target = document.querySelector(href);
            if (target) {
              e.preventDefault();
              lenis.scrollTo(target as HTMLElement, { offset: -85, immediate: false });
            }
          }
        });
      });

      // GSAP ScrollTrigger reveals
      gsap.utils.toArray<HTMLElement>('.reveal-on-scroll').forEach((el) => {
        const delay = parseFloat(el.dataset.delay || '0');
        gsap.fromTo(el,
          { opacity: 0, y: 36 },
          {
            opacity: 1, y: 0,
            duration: 0.9,
            delay,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: el,
              start: 'top 88%',
              toggleActions: 'play none none none',
            }
          }
        );
      });

      gsap.utils.toArray<HTMLElement>('.reveal-scale').forEach((el) => {
        const delay = parseFloat(el.dataset.delay || '0');
        gsap.fromTo(el,
          { opacity: 0, scale: 0.94 },
          {
            opacity: 1, scale: 1,
            duration: 0.8,
            delay,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: el,
              start: 'top 88%',
              toggleActions: 'play none none none',
            }
          }
        );
      });

      gsap.utils.toArray<HTMLElement>('.reveal-stagger').forEach((parent) => {
        const children = parent.children;
        gsap.fromTo(children,
          { opacity: 0, y: 40 },
          {
            opacity: 1, y: 0,
            duration: 0.75,
            stagger: 0.12,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: parent,
              start: 'top 85%',
              toggleActions: 'play none none none',
            }
          }
        );
      });

      gsap.utils.toArray<HTMLElement>('.reveal-heading').forEach((el) => {
        const original = el.innerHTML;
        const words = el.textContent?.split(' ') || [];
        if (words.length < 2) {
          gsap.fromTo(el,
            { opacity: 0, y: 30 },
            {
              opacity: 1, y: 0, duration: 0.8, ease: 'power3.out',
              scrollTrigger: { trigger: el, start: 'top 88%', toggleActions: 'play none none none' }
            }
          );
          return;
        }
        el.innerHTML = words.map(w =>
          `<span class="word-wrap" style="display:inline-block;overflow:hidden;vertical-align:bottom"><span class="word-inner" style="display:inline-block">${w}&nbsp;</span></span>`
        ).join('');
        const inners = el.querySelectorAll('.word-inner');
        gsap.fromTo(inners,
          { y: '100%', opacity: 0 },
          {
            y: '0%', opacity: 1,
            duration: 0.65,
            stagger: 0.055,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: el,
              start: 'top 88%',
              toggleActions: 'play none none none',
            }
          }
        );
      });

      // E. Counter animation for stat numbers with .count-up
      gsap.utils.toArray<HTMLElement>('.count-up').forEach((el) => {
        const endVal = parseFloat(el.dataset.target || el.textContent || '0');
        const suffix = el.dataset.suffix || '';
        const prefix = el.dataset.prefix || '';
        const isDecimal = endVal % 1 !== 0;
        gsap.fromTo({ val: 0 }, { val: endVal },
          {
            duration: 2,
            ease: 'power2.out',
            onUpdate: function() {
              const v = this.targets()[0].val;
              el.textContent = prefix + (isDecimal ? v.toFixed(1) : Math.round(v).toString()) + suffix;
            },
            scrollTrigger: {
              trigger: el,
              start: 'top 85%',
              toggleActions: 'play none none none',
            }
          }
        );
      });

      // F. Image parallax: images with .parallax-img move slower than scroll
      gsap.utils.toArray<HTMLElement>('.parallax-img').forEach((img) => {
        const speed = parseFloat((img as HTMLElement).dataset.speed || '20');
        gsap.fromTo(img,
          { yPercent: -speed },
          {
            yPercent: speed,
            ease: 'none',
            scrollTrigger: {
              trigger: img.closest('.parallax-wrap') || img.parentElement,
              start: 'top bottom',
              end: 'bottom top',
              scrub: true,
            }
          }
        );
      });
    }
  </script>
</body>
</html>

<style is:global>
  /* Official Typography: Golos Text across all pages & body text */
  @font-face {
    font-family: 'Golos Text';
    font-style: normal;
    font-weight: 400 900;
    font-display: swap;
    src: url('/fonts/golos-text.woff2') format('woff2');
  }

  html, body {
    font-family: 'Golos Text', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    overflow-x: hidden;
    max-width: 100vw;
    -webkit-text-size-adjust: 100%;
  }

  /* ==========================================================================
     GVF Aesthetic Custom UI Scrollbar (Cross-Browser Standard & WebKit)
     Slim floating pill, clean transparent track, and GVF Royal Blue hover accent.
     ========================================================================== */

  /* Modern Standard (Firefox) */
  * {
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 transparent;
  }

  /* WebKit (Chrome, Edge, Safari, Opera, Brave, Vivaldi) */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  ::-webkit-scrollbar-track {
    background: transparent;
  }

  ::-webkit-scrollbar-thumb {
    background-color: #cbd5e1;
    border-radius: 9999px;
    border: 2px solid transparent;
    background-clip: content-box;
    transition: background-color 0.2s ease;
  }

  ::-webkit-scrollbar-thumb:hover {
    background-color: #0969da;
    border: 2px solid transparent;
    background-clip: content-box;
  }

  ::-webkit-scrollbar-corner {
    background: transparent;
  }

  /* Hilangkan tombol panah kaku default browser */
  ::-webkit-scrollbar-button {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
  }

  /* ==========================================================================
     GVF Professional Animation System
     GSAP ScrollTrigger handles all reveal animations.
     CSS hanya set initial state agar tidak terjadi flash-of-content.
     ========================================================================== */

  /* Initial hidden state — GSAP akan animasikan ke visible */
  .reveal-on-scroll,
  .reveal-scale,
  .reveal-heading {
    opacity: 0;
  }

  /* Stagger parent: children akan di-set oleh GSAP, tapi set invisible dulu */
  .reveal-stagger > * {
    opacity: 0;
  }

  /* Reduced motion: langsung tampilkan semua */
  @media (prefers-reduced-motion: reduce) {
    .reveal-on-scroll,
    .reveal-scale,
    .reveal-heading,
    .reveal-stagger > * {
      opacity: 1 !important;
      transform: none !important;
    }
  }

  /* Word split helper */
  .word-wrap { display: inline-block; overflow: hidden; vertical-align: bottom; }
  .word-inner { display: inline-block; }

  /* ── Button active state global ─────────────────────────────────── */
  .gvf-btn:active,
  .gvf-btn-primary-pill:active,
  .gvf-btn-outline-pill:active {
    transform: translateY(0) !important;
  }

  /* ── Focus visible: keyboard accessibility ──────────────────────── */
  :focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* ── Global text-align: justify untuk body text, deskripsi & lead paragraf ──
     Berlaku pada teks narasi/deskriptif multi-baris di seluruh seksi website.
     Menghadirkan kerapian ritme visual editorial arsitektural standar GVF.
  ─────────────────────────────────────────────────────────────────── */
  p.gvf-lead-intro,
  p.gvf-about-desc,
  p.gvf-lead-desc,
  p.pen-section-desc,
  p.pen-pillar-desc,
  p.goods-lead-desc,
  p.goods-card-summary,
  p.news-card-desc,
  p.gvf-interactive-sub,
  p.pen-timeline-desc,
  p.pen-workflow-lead,
  p.pen-wf-desc,
  p.pen-partner-lead,
  p.pen-partner-desc,
  p.pen-benefit-desc,
  p.pen-contact-lead,
  p.pen-intro-quote,
  p.pen-intro-lead,
  p.pen-banner-lead,
  p.pen-gallery-sub,
  p.pen-facility-sub,
  p.pen-form-sub,
  p.donor-prayer-quote,
  p.donor-prayer-empty,
  p.cta-banner-desc,
  p.cta-widget-desc,
  p.callout-desc,
  p.related-excerpt-text,
  p.card-summary,
  p.news-lead-dek,
  p.archive-subtitle,
  p.banner-subtitle,
  p.opt-desc,
  p.land-desc,
  p.program-lead-p,
  p.article-p,
  p.value-box-desc,
  p.process-step-desc,
  p.faq-answer-p,
  p.sidebar-summary,
  p.prose-paragraph,
  .gvf-hero-sub p,
  .card-desc,
  .card-body p,
  .deliverable-text,
  .deliverable-item,
  .strip-content p,
  .arch-pricing-card .plan-features li,
  .goods-spec-items,
  .article-content p,
  .program-deep-dive p,
  .prose p {
    text-align: justify;
    text-justify: inter-word;
    text-align-last: left;
    hyphens: auto;
  }

  /* ── Subtitle / Intro tengah multi-baris yang rapi rata kanan-kiri dengan baris akhir tengah ── */
  p.pricing-sub-heading,
  .pricing-sub-heading,
  p.sedekah-desc,
  .sedekah-desc,
  p.wakaf-desc,
  .wakaf-desc,
  p.calc-desc,
  .calc-desc,
  p.donatur-section-subtitle,
  .donatur-section-subtitle,
  p.pen-section-subtitle-center,
  .pen-section-subtitle-center,
  p.pen-banner-lead,
  .pen-banner-lead,
  p.archive-subtitle,
  .archive-subtitle,
  p.banner-subtitle,
  .banner-subtitle {
    text-align: justify !important;
    text-justify: inter-word !important;
    text-align-last: center !important;
    hyphens: auto;
  }

  /* Proteksi & prioritas elemen yang berorientasi tengah/judul/badge/tombol */
  .text-center,
  .text-center p,
  .gallery-header,
  .gallery-subtitle,
  .video-content-container,
  .video-title,
  .video-subtitle,
  .pen-final-cta-content,
  .pen-cta-desc,
  .pricing-header-wrap,
  .footer-slogan,
  .footer-address-text,
  .badge-text,
  .hero-badge-pill,
  button,
  .btn,
  .gvf-btn-primary-pill,
  .gvf-btn-outline-pill,
  .pen-cta-btn {
    text-align: center !important;
    text-align-last: center !important;
  }

  /* Responsif: matikan justify pada layar sempit/mobile agar tidak renggang */
  @media (max-width: 640px) {
    p.gvf-lead-intro,
    p.gvf-about-desc,
    p.gvf-lead-desc,
    p.pen-section-desc,
    p.pen-pillar-desc,
    p.goods-lead-desc,
    p.goods-card-summary,
    p.news-card-desc,
    p.gvf-interactive-sub,
    p.pen-timeline-desc,
    p.pen-workflow-lead,
    p.pen-wf-desc,
    p.pen-partner-lead,
    p.pen-partner-desc,
    p.pen-benefit-desc,
    p.pen-contact-lead,
    p.pen-intro-quote,
    p.pen-intro-lead,
    p.program-lead-p,
    p.article-p,
    p.value-box-desc,
    p.process-step-desc,
    p.faq-answer-p,
    p.sidebar-summary,
    p.prose-paragraph,
    .gvf-hero-sub p,
    .card-desc,
    .card-body p,
    .deliverable-text,
    .goods-spec-items,
    .article-content p,
    .program-deep-dive p,
    .prose p {
      text-align: left !important;
      text-align-last: left !important;
      hyphens: none;
    }
  }
</style>

<style>
  #main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow-x: clip;
  }

  /* Floating Scroll Percentage Badge (Right Bottom) */
  .gvf-scroll-badge {
    position: fixed;
    bottom: 96px;
    right: 28px;
    z-index: 998;
    width: 44px;
    height: 44px;
    background-color: #ffffff;
    border: 2px solid #0969da;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 800;
    color: #0969da;
    font-family: monospace;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    pointer-events: none;
    transition: transform 0.2s ease;
  }

  /* Floating WhatsApp circular badge */
  .gvf-floating-wa {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 999;
    width: 54px;
    height: 54px;
    background-color: #25d366;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    box-shadow: 0 8px 25px rgba(37, 211, 102, 0.45);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    text-decoration: none;
  }

  .gvf-floating-wa:hover {
    transform: scale(1.1);
    box-shadow: 0 12px 30px rgba(37, 211, 102, 0.65);
  }

  .gvf-wa-icon {
    width: 30px;
    height: 30px;
    position: relative;
    z-index: 2;
  }

  /* Continuous Subtle Pulse Ring Animation */
  .gvf-wa-pulse-ring {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 2px solid rgba(37, 211, 102, 0.6);
    animation: gvfPulse 2.2s infinite cubic-bezier(0.24, 0, 0.38, 1);
    pointer-events: none;
  }

  @keyframes gvfPulse {
    0% {
      transform: scale(0.9);
      opacity: 0.9;
    }
    60% {
      transform: scale(1.35);
      opacity: 0;
    }
    100% {
      transform: scale(1.35);
      opacity: 0;
    }
  }

  @media (max-width: 768px) {
    .gvf-scroll-badge {
      display: none;
    }
    .gvf-floating-wa {
      bottom: 18px;
      right: 18px;
      width: 48px;
      height: 48px;
    }
    .gvf-wa-icon {
      width: 26px;
      height: 26px;
    }
  }
</style>
