---
// src/layouts/BaseLayout.astro
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import 'lenis/dist/lenis.css';
import '../styles/design-tokens.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Global Village Fund • Wakaf Produktif & Pendidikan Berkelanjutan",
  description = "Wadah filantropi dan wakaf produktif untuk pembangunan Masjid Khairu Ummah Sugro dan Pesantren Integratif Holistik SMK Skill Village Islamic School.",
  ogImage = "/logo-gvf.png"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />

  <!-- Open Graph / Meta -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Global Village Fund" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />

  <!-- Favicon -->
  <link rel="icon" type="image/webp" href="/favicon.webp" />
  <link rel="apple-touch-icon" href="/favicon.webp" />

  <!-- Fonts Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
</head>
<body>
  <Navbar />
  <main id="main-content">
    <slot />
  </main>
  <Footer />

  <!-- Floating Scroll Percentage Badge ala ISAVO (Bottom Right) -->
  <div class="isavo-scroll-badge" id="scroll-percentage" aria-hidden="true">
    <span id="scroll-pct-text">0%</span>
  </div>

  <!-- Floating WhatsApp Action Badge ala ISAVO (Bottom Right with Pulse Ring) -->
  <a
    href="https://wa.me/6281226832326?text=Assalamualaikum%20Admin%20Global%20Village%20Fund%2C%20saya%20ingin%20konsultasi%20program%20wakaf."
    target="_blank"
    rel="noopener noreferrer"
    class="isavo-floating-wa"
    aria-label="Chat WhatsApp Admin"
  >
    <span class="isavo-wa-pulse-ring"></span>
    <svg viewBox="0 0 24 24" fill="currentColor" class="isavo-wa-icon">
      <path d="M20.52 3.48A11.93 11.93 0 0 0 12.06 0C5.46 0 .09 5.37.09 11.97c0 2.11.55 4.17 1.6 5.99L0 24l6.23-1.63a11.9 11.9 0 0 0 5.83 1.51h.01c6.6 0 11.97-5.37 11.97-11.97 0-3.2-1.25-6.21-3.52-8.43zM12.06 21.88h-.01a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.75.98 1-3.65-.23-.38a9.92 9.92 0 0 1-1.52-5.27c0-5.49 4.47-9.96 9.97-9.96 2.66 0 5.16 1.04 7.04 2.92a9.9 9.9 0 0 1 2.92 7.04c0 5.5-4.47 9.96-9.97 9.96zm5.46-7.46c-.3-.15-1.77-.87-2.04-.97-.28-.1-.48-.15-.68.15-.2.3-.78.97-.95 1.17-.18.2-.35.22-.65.08-.3-.15-1.26-.47-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.52-.07-.15-.68-1.64-.93-2.24-.24-.6-.49-.51-.68-.52l-.58-.01c-.2 0-.52.07-.8.38-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.21 3.07.15.2 2.1 3.2 5.09 4.49.71.31 1.27.49 1.7.63.72.23 1.37.2 1.88.12.58-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.18-1.42-.08-.12-.28-.2-.58-.35z"/>
    </svg>
  </a>

  <!-- Lenis Momentum Smooth Scrolling & GSAP Ticker Synchronizer ala ISAVO -->
  <script>
    import Lenis from 'lenis';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    if (typeof window !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);

      // 1. Initialize Lenis with EXACT isavo.co.id parameters (lerp: 0.12, wheelMultiplier: 1.6)
      const lenis = new Lenis({
        smoothWheel: true,
        wheelMultiplier: 1.6,
        touchMultiplier: 1.3,
        lerp: 0.12,
      });

      (window as any).lenis = lenis;
      (window as any).__isavoLenis = lenis;

      // Hubungkan Lenis langsung ke ScrollTrigger updater
      lenis.on('scroll', ScrollTrigger.update);

      // Jalankan Lenis di frame clock GSAP Ticker (identik ISAVO bundle 3pa13xr4vco2o.js)
      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });
      gsap.ticker.lagSmoothing(0);

      window.dispatchEvent(new CustomEvent('lenis:ready', { detail: lenis }));

      // 2. Coordinated Scroll Percentage Indicator (0% - 100%)
      const pctBadge = document.getElementById('scroll-pct-text');
      lenis.on('scroll', (e: any) => {
        if (pctBadge) {
          const pct = Math.min(100, Math.max(0, Math.round(e.progress * 100)));
          pctBadge.textContent = `${pct}%`;
        }
      });

      // 3. Smoothly intercept internal hash anchors (#pilar, #tentang-kami, etc.)
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          const href = anchor.getAttribute('href');
          if (href && href.length > 1) {
            const target = document.querySelector(href);
            if (target) {
              e.preventDefault();
              lenis.scrollTo(target as HTMLElement, {
                offset: -85,
                immediate: false,
              });
            }
          }
        });
      });

      // 4. Scroll-triggered reveal animations via IntersectionObserver
      const revealElements = document.querySelectorAll('.reveal-on-scroll, .reveal-scale');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              obs.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.05,
          rootMargin: '0px 0px -40px 0px'
        });

        revealElements.forEach(el => {
          // Jika elemen sudah berada di viewport pada saat load, langsung tampilkan
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight + 100) {
            el.classList.add('is-visible');
          } else {
            observer.observe(el);
          }
        });
      } else {
        revealElements.forEach(el => el.classList.add('is-visible'));
      }
    }
  </script>
</body>
</html>

<style is:global>
  /* ==========================================================================
     ISAVO Scroll-Reveal Animation Utilities & Keyframes
     ========================================================================== */
  /* Reveal memakai @keyframes (bukan transition) + properti `translate`/`scale`
     yang terpisah dari `transform`, sehingga:
     - tidak tertimpa `transition` milik style komponen (scoped, specificity lebih tinggi)
     - tidak bentrok dengan efek hover kartu yang memakai `transform` */
  .reveal-on-scroll,
  .reveal-scale {
    opacity: 0;
  }

  .reveal-on-scroll.is-visible {
    animation: gvfRevealUp 1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .reveal-scale.is-visible {
    animation: gvfRevealScale 1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes gvfRevealUp {
    from { opacity: 0; translate: 0 32px; }
    to   { opacity: 1; translate: 0 0; }
  }

  @keyframes gvfRevealScale {
    from { opacity: 0; scale: 0.95; }
    to   { opacity: 1; scale: 1; }
  }

  /* Stagger — hanya menunda animasi reveal, tidak memperlambat hover.
     Spesifisitas disamakan dengan `.is-visible` agar shorthand animation tidak mereset delay. */
  .is-visible.delay-100 { animation-delay: 0.1s; }
  .is-visible.delay-200 { animation-delay: 0.2s; }
  .is-visible.delay-300 { animation-delay: 0.3s; }
  .is-visible.delay-400 { animation-delay: 0.4s; }
  .is-visible.delay-500 { animation-delay: 0.5s; }

  @media (prefers-reduced-motion: reduce) {
    .reveal-on-scroll,
    .reveal-scale {
      opacity: 1;
      animation: none !important;
    }
  }
</style>

<style>
  #main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow-x: clip;
  }

  /* Floating Scroll Percentage Badge ala ISAVO (Right Bottom) */
  .isavo-scroll-badge {
    position: fixed;
    bottom: 96px;
    right: 28px;
    z-index: 998;
    width: 44px;
    height: 44px;
    background-color: #ffffff;
    border: 2px solid #0969da;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 800;
    color: #0969da;
    font-family: monospace;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    pointer-events: none;
    transition: transform 0.2s ease;
  }

  /* Floating WhatsApp circular badge ala ISAVO */
  .isavo-floating-wa {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 999;
    width: 54px;
    height: 54px;
    background-color: #25d366;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    box-shadow: 0 8px 25px rgba(37, 211, 102, 0.45);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    text-decoration: none;
  }

  .isavo-floating-wa:hover {
    transform: scale(1.1);
    box-shadow: 0 12px 30px rgba(37, 211, 102, 0.65);
  }

  .isavo-wa-icon {
    width: 30px;
    height: 30px;
    position: relative;
    z-index: 2;
  }

  /* Continuous Subtle Pulse Ring Animation */
  .isavo-wa-pulse-ring {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 2px solid rgba(37, 211, 102, 0.6);
    animation: isavoPulse 2.2s infinite cubic-bezier(0.24, 0, 0.38, 1);
    pointer-events: none;
  }

  @keyframes isavoPulse {
    0% {
      transform: scale(0.9);
      opacity: 0.9;
    }
    60% {
      transform: scale(1.35);
      opacity: 0;
    }
    100% {
      transform: scale(1.35);
      opacity: 0;
    }
  }

  @media (max-width: 768px) {
    .isavo-scroll-badge {
      display: none;
    }
    .isavo-floating-wa {
      bottom: 18px;
      right: 18px;
      width: 48px;
      height: 48px;
    }
    .isavo-wa-icon {
      width: 26px;
      height: 26px;
    }
  }
</style>
