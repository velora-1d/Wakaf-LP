    max-width: 900px;
    width: 90%;
    max-height: 90vh;
    box-shadow: none;
    display: flex;
    flex-direction: column;
  }

  .lightbox-close-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 10;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6);
    color: #ffffff;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
