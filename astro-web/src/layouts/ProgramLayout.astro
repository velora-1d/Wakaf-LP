---
// src/layouts/ProgramLayout.astro
// Master Template Program ZISWAF Presisi 100% Desain Pen.dev (global village fund.pen)
import BaseLayout from './BaseLayout.astro';
import type { ProgramData } from '../data/programs';
import PricingPackagesSection from '../components/program/PricingPackagesSection.astro';
import { getActivePageSections } from '../lib/db';

interface Props {
  program: ProgramData;
}

const { program } = Astro.props;

// Fetch active sections from PostgreSQL with safe fallback
const activeSections = await getActivePageSections(program.slug);
const sectionMap = new Map(activeSections.map((s) => [s.sectionKey, s]));
const isEnabled = (key: string) => {
  if (activeSections.length === 0) return true;
  return sectionMap.has(key);
};

// Daftar link program untuk sticky sidebar
const programNavLinks = [
  { slug: 'infaq', name: 'Infaq Fisik' },
  { slug: 'sedekah', name: 'Sedekah Nutrisi' },
  { slug: 'wakaf', name: 'Wakaf Produktif' },
  { slug: 'zakat', name: 'Zakat Maal & Fitrah' },
];

// Value box vector SVG icons (Pahala Abadi, BWI, Akta AIW, Laporan Transparan)
const valueBoxIcons = [
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>`
];
---

<BaseLayout
  title={`${program.title} • Global Village Fund`}
  description={program.heroSubtitle}
  ogImage={program.heroBgImage}
>
  {isEnabled('prog_hero') && (
  <section
    class="pen-prog-header relative overflow-hidden bg-cover bg-center flex flex-col justify-center items-center"
    style={`background-image: url('${program.heroBgImage}'); background-color: #191919; min-height: 385px; padding-top: 140px; padding-bottom: 100px;`}
  >
    <div class="absolute inset-0 bg-[#061829] opacity-75 z-0"></div>
    <div class="relative z-10 max-w-[1795px] mx-auto px-4 w-full flex flex-col items-center justify-center text-center">
      <h1
        class="pen-hero-title"
        style="color: #ffffff !important; font-family: 'Golos Text', system-ui, sans-serif !important; font-size: clamp(32px, 4.5vw, 64px) !important; font-weight: 500 !important; line-height: 1.2 !important; margin: 0 0 16px 0 !important; text-align: center !important;"
      >
        {program.title}
      </h1>
      <div
        class="pen-hero-breadcrumb flex items-center justify-center"
        style="font-family: 'Golos Text', system-ui, sans-serif; font-size: 13px; line-height: 16px; font-weight: 500; text-transform: uppercase;"
      >
        <a href="/" style="color: #ffffff; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#38bdf8'" onmouseout="this.style.color='#ffffff'">BERANDA</a>
        <span style="color: #ffffff; padding: 0 8px;">-</span>
        <span style="color: #0969da; font-weight: 600; filter: drop-shadow(0 1px 2px rgba(0,0,0,0.5));">{program.categoryBadge}</span>
      </div>
    </div>
  </section>
  )}

  {isEnabled('prog_pricing') && <PricingPackagesSection program={program} />}

  {isEnabled('prog_details') && (
  <section class="pen-deepdive-section" id="tentang-program">
    <div class="pen-deepdive-container">
      <aside class="pen-deepdive-sidebar">
        <div style="background: #ffffff; border-radius: 24px; padding: 32px; border: 1px solid #e3e3e8; box-shadow: 0 4px 16px rgba(0,0,0,0.02);">
          <h3 style="font-family: 'Golos Text', system-ui, sans-serif; font-size: 22px; color: #191919; margin: 0 0 20px 0; font-weight: 600;">Program Lainnya</h3>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px;">
            {programNavLinks.map(link => (
              <li>
                <a
                  href={`/program/${link.slug}`}
                  style={`display: flex; align-items: center; gap: 12px; padding: 12px 18px; border-radius: 12px; text-decoration: none; font-family: 'Golos Text', system-ui, sans-serif; font-size: 15px; transition: all 0.2s; ${
                    link.slug === program.slug
                      ? 'background-color: #0969da; color: #ffffff !important;'
                      : 'color: #191919; background-color: #f8fafc; border: 1px solid #e2e8f0;'
                  }`}
                >
                  <span style={`width: 7px; height: 7px; border-radius: 50%; shrink: 0; ${link.slug === program.slug ? 'background-color: #ffffff;' : 'background-color: #0969da;'}`}></span>
                  <span>{link.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div style="position: relative; border-radius: 24px; overflow: hidden; padding: 48px 24px; text-align: center; color: #ffffff; min-height: 440px; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 8px 24px rgba(0,0,0,0.12); background-image: url('/gambar design/belakang masjid.jpg'); background-size: cover; background-position: center;">
          <div style="position: absolute; inset: 0; background: rgba(6, 24, 41, 0.82); z-index: 0;"></div>
          <div style="position: relative; z-index: 10; display: flex; flex-direction: column; align-items: center; width: 100%;">
            <img src="/logo-gwav-white.png" alt="GVF Logo" style="height: 44px; width: auto; object-fit: contain; margin-bottom: 16px; filter: drop-shadow(0 2px 8px rgba(0,0,0,0.3));" />
            <span style="font-family: 'Golos Text', system-ui, sans-serif; font-size: 11px; letter-spacing: 1.5px; color: #38bdf8; text-transform: uppercase; font-weight: 700; margin-bottom: 8px;">
              LAYANAN KONSULTASI
            </span>
            <h4 style="font-family: 'Golos Text', system-ui, sans-serif; font-size: 22px; color: #ffffff; margin: 0 0 12px 0; font-weight: 600;">
              {program.slug === 'zakat' ? 'Konsultasi Perhitungan Zakat' : program.slug === 'infaq' ? 'Konsultasi Penyaluran Infaq' : program.slug === 'sedekah' ? 'Konsultasi Sedekah Santri' : 'Konsultasi Ikrar Wakaf'}
            </h4>
            <div style="font-family: 'Golos Text', system-ui, sans-serif; font-size: 32px; color: #ffffff; margin: 8px 0; letter-spacing: 1px; font-weight: 700; text-shadow: 0 2px 10px rgba(0,0,0,0.5);">
              0878-6599-4786
            </div>
            <div style="font-family: 'Golos Text', sans-serif; font-size: 13px; color: rgba(255, 255, 255, 0.8); margin-bottom: 24px;">
              www.globalvillagefund.org
            </div>
            <a
              href="https://wa.me/6287865994786?text=Assalamualaikum%20Layanan%20Donatur%20GVF%2C%20saya%20ingin%20konsultasi%20program%20ZISWAF."
              target="_blank"
              rel="noopener noreferrer"
              class="uiverse-ripple-btn uiverse-ripple-btn-dark pen-sidebar-cta"
            >
              <span>Layanan Donatur</span>
            </a>
          </div>
        </div>
      </aside>

      <!-- Kolom Kanan: Konten Narasi Utama (Flex 1) -->
      <div class="pen-deepdive-content">
        <div class="pen-deepdive-card">
          <!-- Main Hero Image -->
          <div class="pen-deepdive-hero-img-wrap">
            <img
              src="/gambar design/interior masjid.jpg"
              alt={program.deepDiveTitle}
              class="pen-deepdive-hero-img"
              loading="lazy"
            />
          </div>

          <!-- Deep Dive Lead Text -->
          <div class="pen-deepdive-lead-block">
            <h2 class="pen-deepdive-lead-title">
              {program.deepDiveTitle}
            </h2>
            <p class="pen-deepdive-para">
              {program.deepDiveLead}
            </p>
            <p class="pen-deepdive-para">
              {program.deepDiveStory1}
            </p>
            <p class="pen-deepdive-para">
              {program.deepDiveStory2}
            </p>
          </div>

          <!-- 4 Value Box Icon Grid ala Pen.dev -->
          <div class="pen-value-grid">
            {program.valueBoxes.map((vb, idx) => (
              <div class="pen-value-item">
                <div class="pen-value-icon">
                  <Fragment set:html={valueBoxIcons[idx % valueBoxIcons.length]} />
                </div>
                <div>
                  <h4 class="pen-value-title">{vb.title}</h4>
                  <p class="pen-value-desc">{vb.description}</p>
                </div>
              </div>
            ))}
          </div>

          <!-- 2 Side-by-side Images (Pen.dev) -->
          <div class="pen-twins-img-grid">
            <img
              src={program.deepDiveTwinImages ? program.deepDiveTwinImages[0] : "/gambar design/skywalk learning room.jpg"}
              alt="Dokumentasi Fasilitas Jonggol 1"
              class="pen-twin-img"
              loading="lazy"
            />
            <img
              src={program.deepDiveTwinImages ? program.deepDiveTwinImages[1] : "/gambar design/belakang masjid.jpg"}
              alt="Dokumentasi Fasilitas Jonggol 2"
              class="pen-twin-img"
              loading="lazy"
            />
          </div>

          <!-- Deep-dive Sub-block 1 (Pen.dev Exact) -->
          <div class="pen-deepdive-subblock">
            <h3 class="pen-subblock-title">
              {program.deepDiveSubblock1Title || (program.slug === 'infaq' ? 'Konsep Green Building Ramah Lingkungan' : 'Integrasi Pesantren & Agro-Technopark')}
            </h3>
            <p class="pen-deepdive-para">
              {program.deepDiveSubblock1Desc1 || 'Masjid Khairu Ummah Sugro dirancang dengan arsitektur tropis ramah lingkungan yang memanfaatkan pencahayaan alami dan ventilasi silang, mengurangi konsumsi listrik dan menghadirkan suasana khusyuk bagi para jamaah.'}
            </p>
            <p class="pen-deepdive-para">
              {program.deepDiveSubblock1Desc2 || 'Dilengkapi area mezzanine dua lantai untuk menampung kegiatan ibadah berjamaah, halaqah Quran, serta ruang belajar santri yang terintegrasi dengan keasrian alam sekitar Sukasirna Jonggol.'}
            </p>
          </div>

          <!-- Deep-dive Sub-block 2 (Pen.dev Exact) -->
          <div class="pen-deepdive-subblock">
            <h3 class="pen-subblock-title">
              {program.deepDiveSubblock2Title || (program.slug === 'infaq' ? 'Dokumentasi Fisik Lapangan' : 'Dokumentasi Kawasan Wakaf Jonggol')}
            </h3>
            <p class="pen-deepdive-para">
              {program.deepDiveSubblock2Desc1 || 'Dokumentasi progres pembangunan riil Masjid Khairu Ummah Sugro di Sukasirna Jonggol — dari pemancangan tiang, pengecoran lantai, pemasangan dinding bata ringan, hingga instalasi sanitasi.'}
            </p>
            <p class="pen-deepdive-para">
              {program.deepDiveSubblock2Desc2 || 'Setiap kemajuan di lapangan adalah buah dari gotong royong dan ketulusan para muhsinin yang menyalurkan donasi dan infaq terbaiknya.'}
            </p>

            <!-- 4 Portfolio Showcase Cards Grid (Pen.dev Exact) -->
            <div class="pen-portfolio-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin: 30px 0;">
              {(program.portfolioShowcaseItems || [
                { tag: 'ARSITEKTUR', name: 'Ruang Utama Shalat', category: 'Arsitektur', image: '/gambar design/interior masjid.jpg' },
                { tag: 'ARSITEKTUR', name: 'Mezanin Lantai 2', category: 'Arsitektur', image: '/gambar design/skywalk learning room.jpg' },
                { tag: 'ARSITEKTUR', name: 'Area Tempat Wudhu', category: 'Arsitektur', image: '/gambar design/tempat wudu.jpg' },
                { tag: 'ARSITEKTUR', name: 'Pembangkit Listrik Surya', category: 'Arsitektur', image: '/gambar design/panel surya.jpg' },
              ]).map((item) => (
                <div class="pen-showcase-card">
                  <div class="pen-showcase-img-box">
                    <img src={item.image} alt={item.name} class="pen-showcase-img" loading="lazy" />
                    <span class="pen-badge-arsitektur">{item.tag}</span>
                  </div>
                  <div class="pen-showcase-meta">
                    <h4 class="pen-showcase-name">{item.name}</h4>
                    <p class="pen-showcase-category">{item.category}</p>
                  </div>
                </div>
              ))}
            </div>

            <!-- Button: Lihat Lebih Banyak (Pen.dev Exact) -->
            <div style="display: flex; justify-content: center; margin: 30px 0 50px 0;">
              <a href="/portofolio" class="pen-btn-portfolio-more uiverse-ripple-btn">
                <span>Lihat Lebih Banyak</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>

            <!-- 8 Guarantees & Transparansi Badges Grid (Pen.dev Style) -->
            <div class="pen-guarantees-grid">
              {(program.guarantees || [
                'Material bersertifikasi standar SNI',
                'Kwitansi & tanda terima resmi GVF',
                'Laporan progres fisik berkala',
                'Dokumentasi foto penyaluran di lokasi',
                'Pengawasan kualitas & mutu bangunan',
                'RAB terperinci dan terbuka',
                'Akad ZISWAF transparan & terpercaya',
                'Kunjungan langsung ke lokasi Jonggol'
              ]).map((g) => (
                <div class="pen-guarantee-item">
                  <span class="pen-guarantee-check">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  </span>
                  <span>{g}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
  </section>
  )}

  {isEnabled('prog_faq') && (
  <section class="pen-faq-section" id="faq" style="background-color: #f8f8f8; padding: 100px 24px 130px; width: 100%; box-sizing: border-box;">
    <div style="max-width: 1425px; margin: 0 auto; width: 100%;">
      <div style="text-align: center; margin-bottom: 50px;">
        <div style="display: inline-flex; align-items: center; gap: 8px; border: 1px solid #72727240; border-radius: 9999px; padding: 6px 18px; background: #ffffff; margin-bottom: 16px;">
          <span style="width: 6px; height: 6px; border-radius: 50%; background-color: #0969da;"></span>
          <span style="font-family: 'Golos Text', system-ui, sans-serif; font-size: 12px; letter-spacing: 1px; text-transform: uppercase; font-weight: 600; color: #191919;">FAQ</span>
        </div>
        <h2 style="font-family: 'Golos Text', system-ui, sans-serif; font-size: clamp(28px, 4vw, 48px); color: #0f172a; margin: 0; font-weight: 500; line-height: 1.2;">
          {program.faqTitle}
        </h2>
      </div>

      <div style="max-width: 100%; margin: 0 auto; display: flex; flex-direction: column;">
        {program.faqs.map((faq, idx) => (
          <details style="border-top: 1px solid rgba(159, 159, 164, 0.24); padding: 0;" open={idx === 0}>
            <summary style="list-style: none; display: flex; justify-content: space-between; align-items: center; padding: 22px 0; cursor: pointer; font-family: 'Golos Text', system-ui, sans-serif; font-size: 22px; color: #191919; transition: color 180ms cubic-bezier(0.2, 0.8, 0.2, 1);" onmouseover="this.style.color='#0969da'" onmouseout="this.style.color='#191919'">
              <span style="padding-right: 20px;">{faq.question}</span>
              <span style="font-size: 20px; font-weight: bold; color: #0969da; flex-shrink: 0; width: 24px; text-align: center;">+</span>
            </summary>
            <div style="padding: 0 0 32px 0; font-family: 'Golos Text', system-ui, sans-serif; font-size: 16px; line-height: 27px; color: #4d4d52; max-width: 1100px;">
              <p style="margin: 0;">{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- SCRIPT INTERAKTIF: GSAP SCROLLTRIGGER ENGINE ALA ISAVO, SALIN REKENING & LIGHTBOX -->
  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    if (typeof window !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);

      const initAnimations = () => {
        // 1. ISAVO .slide-anim (Pricing cards & element slides)
        gsap.utils.toArray<HTMLElement>('.slide-anim').forEach((t) => {
          const s = t.dataset.direction || 'bottom';
          const o = parseInt(t.dataset.offset || '60', 10);
          const r = parseFloat(t.dataset.delay || '0') || 0;
          const n: gsap.TweenVars = { opacity: 0 };
          
          if (s === 'left') n.x = -o;
          else if (s === 'right') n.x = o;
          else if (s === 'bottom') n.y = o;
          else if (s === 'top') n.y = -o;
          
          gsap.set(t, n);
          gsap.fromTo(
            t,
            n,
            {
              opacity: 1,
              x: 0,
              y: 0,
              duration: 0.8,
              delay: r,
              ease: 'power2.out',
              scrollTrigger: {
                trigger: t,
                start: 'top 95%',
                toggleActions: 'play none none none',
                once: true,
              },
            }
          );
        });

        // 2. ISAVO .fade-top (Heading & titles)
        gsap.utils.toArray<HTMLElement>('.fade-top').forEach((t) => {
          gsap.set(t, { opacity: 0, y: -30 });
          gsap.fromTo(
            t,
            { opacity: 0, y: -30 },
            {
              opacity: 1,
              y: 0,
              duration: 0.8,
              ease: 'power2.out',
              scrollTrigger: {
                trigger: t,
                start: 'top 85%',
                toggleActions: 'play none none none',
                once: true,
              },
            }
          );
        });

        // 3. ISAVO .fade-wrapper (Staggered items)
        gsap.utils.toArray<HTMLElement>('.fade-wrapper').forEach((t) => {
          const s = t.querySelectorAll(':scope > *');
          gsap.set(s, { opacity: 0, y: 30 });
          gsap.fromTo(
            s,
            { opacity: 0, y: 30 },
            {
              opacity: 1,
              y: 0,
              duration: 0.6,
              stagger: 0.1,
              ease: 'power2.out',
              scrollTrigger: {
                trigger: t,
                start: 'top 85%',
                toggleActions: 'play none none none',
                once: true,
              },
            }
          );
        });

        // 4. GSAP Handler for general reveal elements (.reveal-on-scroll)
        gsap.utils.toArray<HTMLElement>('.reveal-on-scroll').forEach((el) => {
          gsap.set(el, { opacity: 0, y: 30 });
          gsap.to(el, {
            opacity: 1,
            y: 0,
            duration: 0.8,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: el,
              start: 'top 88%',
              toggleActions: 'play none none none',
              once: true,
            },
          });
        });

        ScrollTrigger.refresh();
      };

      // Double requestAnimationFrame persis seperti ISAVO bundle agar layout stabil
      requestAnimationFrame(() => {
        requestAnimationFrame(initAnimations);
      });
    }

    // 5. Copy Account Number with Toast Feedback
    document.querySelectorAll('.btn-copy-acc').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetNumber = btn.getAttribute('data-copy-target');
        if (targetNumber) {
          navigator.clipboard.writeText(targetNumber).then(() => {
            const originalHTML = btn.innerHTML;
            btn.classList.add('copied');
            btn.innerHTML = `
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Tersalin!</span>
            `;
            setTimeout(() => {
              btn.innerHTML = originalHTML;
              btn.classList.remove('copied');
            }, 2500);
          });
        }
      });
    });

    // 6. Interactive Lightbox Modal for Gallery Cards
    const lightbox = document.getElementById('programLightbox');
    const lightboxImg = document.getElementById('lightboxImg') as HTMLImageElement;
    const lightboxTitle = document.getElementById('lightboxTitle');
    const lightboxCaption = document.getElementById('lightboxCaption');
    const closeBtn = document.getElementById('lightboxCloseBtn');
    const closeArea = document.getElementById('lightboxCloseArea');

    function openLightbox(src: string, title: string, caption: string) {
      if (lightbox && lightboxImg && lightboxTitle && lightboxCaption) {
        lightboxImg.src = src;
        lightboxImg.alt = title;
        lightboxTitle.textContent = title;
        lightboxCaption.textContent = caption;
        lightbox.classList.add('is-open');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeLightbox() {
      if (lightbox) {
        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
    }

    document.querySelectorAll('.gallery-card').forEach(card => {
      card.addEventListener('click', () => {
        const src = card.getAttribute('data-img-src') || '';
        const title = card.getAttribute('data-img-title') || '';
        const caption = card.getAttribute('data-img-caption') || '';
        openLightbox(src, title, caption);
      });
    });

    closeBtn?.addEventListener('click', closeLightbox);
    closeArea?.addEventListener('click', closeLightbox);
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });
  </script>
</BaseLayout>

<style>
  /* =========================================================================
     DESIGN TOKENS — HARD COPY DARI ISAVO (isavo.co.id) + ADAPTASI GVF
     Font: Golos Text — SAMA PERSIS ISAVO
     ========================================================================= */
  @import url('https://fonts.googleapis.com/css2?family=Golos+Text:wght@400..900&display=swap');

  :root {
    /* Font System — ISAVO asli */
    --tl-ff-heading: 'Golos Text', system-ui, sans-serif;
    --tl-ff-body: 'Golos Text', system-ui, sans-serif;

    /* Color System — adaptasi GVF (merah ISAVO → biru/emerald GVF) */
    --tl-color-heading-primary: #191919;   /* ISAVO: #191919 */
    --tl-color-text-body: #4d4d52;         /* ISAVO: #4d4d52 */
    --tl-color-theme-primary: #0969da;     /* Royal Blue GVF */
    --tl-color-theme-secondary: #0752a8;   /* Biru GVF Dark */
    --tl-color-bg-1: #1c1c1d;             /* ISAVO: #1c1c1d */
    --tl-color-border-1: #e3e3e8;         /* ISAVO: #e3e3e8 */
    --tl-color-grey-1: #59585d;           /* ISAVO: #59585d */
    --tl-color-grey-2: #9f9fa4;           /* ISAVO: #9f9fa4 */

    /* Legacy aliases (dipertahankan untuk bagian yang belum di-refactor) */
    --isavo-navy: #0a2540;
    --isavo-dark: #191919;
    --isavo-blue: #0369a1;
    --isavo-blue-hover: #025e8d;
    --isavo-blue-soft: #f0f7ff;
    --isavo-blue-border: #bae6fd;
    --isavo-emerald: #059669;
    --isavo-emerald-soft: #ecfdf5;
    --isavo-border: #e3e3e8;
    --isavo-bg-light: #f4f4f4;  /* ISAVO: #f8f8f8 / warm grey */
    --isavo-text-muted: #9f9fa4;
  }

  .accent-blue {
    color: var(--tl-color-theme-secondary);
  }

  .bg-light {
    background-color: var(--isavo-bg-light); /* #f4f4f4 warm grey ISAVO */
  }

  .pt-100 { padding-top: 100px; }
  .pb-100 { padding-bottom: 100px; }
  .mt-30 { margin-top: 30px; }
  .mt-40 { margin-top: 40px; }
  .mt-50 { margin-top: 50px; }
  .mt-80 { margin-top: 80px; }
  .max-w-800 { max-width: 800px; }
  .mx-auto { margin-left: auto; margin-right: auto; }

  .isavo-container {
    width: 100%;
    max-width: 1425px; /* container-2 ISAVO */
    margin-left: auto;
    margin-right: auto;
    padding-left: 24px;
    padding-right: 24px;
  }

  /* =========================================================================
     SECTION HEADING PATTERN — HARD COPY ISAVO
     Struktur: .section-heading-wrap (row) → kiri: sub-heading | kanan: section-title
     ========================================================================= */
  .isavo-section-heading {
    width: 100%;
    max-width: 1192px;
    margin: 0 auto 60px;
    display: flex;
    align-items: flex-end;
    gap: 40px;
    flex-wrap: wrap;
  }

  .isavo-section-heading.centered {
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
  }

  .isavo-section-heading .sub-heading-col {
    flex: 0 0 auto;
    min-width: 180px;
  }

  .isavo-section-heading .title-col {
    flex: 1;
    min-width: 260px;
  }

  /* Sub-heading pill — ISAVO style */
  .isavo-sub-heading {
    font-family: var(--tl-ff-heading);
    color: var(--tl-color-heading-primary);
    text-transform: uppercase;
    letter-spacing: 1px;
    border: 1px solid rgba(114, 114, 114, 0.18);
    border-radius: 100px;
    margin-bottom: 20px;
    padding: 7px 19px 7px 28px;
    font-size: 12px;
    font-weight: 400;
    display: inline-block;
    position: relative;
    overflow: hidden;
  }

  .isavo-sub-heading::before {
    content: '';
    background-color: var(--tl-color-theme-primary);
    border-radius: 50%;
    width: 5px;
    height: 5px;
    position: absolute;
    top: 50%;
    left: 15px;
    transform: translateY(-50%);
  }

  /* Main section title — ISAVO Cal Sans big */
  .isavo-section-title {
    font-family: var(--tl-ff-heading);
    font-size: clamp(2.2rem, 4vw, 3.75rem);
    font-weight: 400;
    color: var(--tl-color-heading-primary);
    line-height: 1.1;
    margin-bottom: 0;
    letter-spacing: 0;
    text-transform: capitalize;
    overflow: hidden;
  }

  .isavo-section-title span {
    color: var(--tl-color-theme-primary);
  }

  .isavo-section-desc {
    font-family: var(--tl-ff-body);
    font-size: 1rem;
    color: var(--tl-color-text-body);
    max-width: 720px;
    line-height: 1.75;
    margin-top: 20px;
    margin-bottom: 0;
  }

  /* Pill tag legacy (tetap ada untuk bagian yang pakai) */
  .isavo-pill-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 19px 7px 28px;
    background-color: transparent;
    border: 1px solid rgba(114, 114, 114, 0.18);
    border-radius: 9999px;
    font-size: 12px;
    font-weight: 400;
    font-family: var(--tl-ff-heading);
    letter-spacing: 1px;
    color: var(--tl-color-heading-primary);
    text-transform: uppercase;
    margin-bottom: 16px;
    position: relative;
    overflow: hidden;
  }

  .isavo-pill-tag::before {
    content: '';
    background-color: var(--tl-color-theme-primary);
    border-radius: 50%;
    width: 5px;
    height: 5px;
    position: absolute;
    top: 50%;
    left: 15px;
    transform: translateY(-50%);
  }

  .isavo-pill-dot { display: none; } /* Diganti ::before pseudo-element */

  /* =========================================================================
     1. HERO HEADER & BREADCRUMB
     ========================================================================= */
  .isavo-prog-header {
    position: relative;
    padding: 160px 0 100px;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    color: #ffffff;
    overflow: hidden;
  }

  .isavo-header-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8, 15, 26, 0.78) 0%, rgba(8, 15, 26, 0.65) 50%, rgba(8, 15, 26, 0.88) 100%);
  }

  .isavo-header-container {
    position: relative;
    z-index: 2;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .isavo-header-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(2, 132, 199, 0.35);
    border: 1px solid rgba(186, 230, 253, 0.6);
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #e0f2fe;
    margin-bottom: 20px;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background-color: #38bdf8;
    border-radius: 50%;
  }

  .isavo-header-title {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 18px;
    max-width: 850px;
    color: #ffffff !important;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.6);
  }

  .isavo-header-subtitle {
    font-size: 1.15rem;
    line-height: 1.7;
    color: #f8fafc !important;
    max-width: 750px;
    margin-bottom: 28px;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
  }

  .isavo-header-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    color: #cbd5e1;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(8px);
    padding: 6px 18px;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .isavo-header-breadcrumb a {
    color: #e2e8f0 !important;
    text-decoration: none;
    transition: color 0.2s;
    font-weight: 500;
  }

  .isavo-header-breadcrumb a:hover {
    color: #ffffff !important;
  }

  .isavo-header-breadcrumb .sep {
    color: #94a3b8;
  }

  .isavo-header-breadcrumb .current {
    color: #38bdf8 !important;
    font-weight: 700;
  }

  /* =========================================================================
     2. EXACT ISAVO 3-COLUMN PRICING GRID & CARD DESIGN (DARI ISAVO.CO.ID)
     ========================================================================= */
  .isavo-pricing-section {
    background-color: #f8f8f8; /* Warm grey ISAVO asli */
  }

  .isavo-pricing-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    align-items: stretch;
  }

  @media (max-width: 991px) {
    .isavo-pricing-grid-3 {
      grid-template-columns: 1fr;
      max-width: 540px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  /* Pricing Card — HARD COPY ISAVO flat surface */
  .arch-pricing-card {
    background-color: #ffffff;
    border: 1px solid #e3e3e8; /* ISAVO: --tl-color-border-1 */
    border-radius: 20px;
    flex-direction: column;
    height: 100%;
    padding: 38px 28px;
    transition: box-shadow 0.3s ease-in-out, transform 0.3s ease-in-out;
    display: flex;
    position: relative;
    box-shadow: none; /* ISAVO: flat! box-shadow none di default */
  }

  .arch-pricing-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08); /* ISAVO hover shadow */
  }

  .arch-pricing-card.popular {
    border: 2px solid var(--tl-color-theme-primary);
  }

  .arch-pricing-card .pricing-badge {
    background: var(--tl-color-theme-primary);
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-radius: 9999px;
    padding: 4px 16px;
    font-size: 11px;
    font-weight: 700;
    font-family: var(--tl-ff-heading);
    position: absolute;
    top: -13px;
    right: 50%;
    transform: translateX(50%);
    white-space: nowrap;
  }

  .arch-pricing-card .plan-title {
    font-family: var(--tl-ff-heading);
    text-align: center;
    margin-bottom: 4px;
    font-size: 26px;
    font-weight: 400; /* Cal Sans natural weight ISAVO */
    color: var(--tl-color-heading-primary);
    letter-spacing: 0;
  }

  .arch-pricing-card .plan-subtitle {
    font-family: var(--tl-ff-body);
    color: var(--tl-color-grey-1);
    text-align: center;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .arch-pricing-card .plan-price {
    font-family: var(--tl-ff-body);
    color: var(--tl-color-heading-primary);
    text-align: center;
    margin-bottom: 4px;
    font-size: 36px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .arch-pricing-card .plan-price .currency {
    font-size: 20px;
    font-weight: 400;
  }

  .arch-pricing-card .plan-price .period {
    color: var(--isavo-text-muted);
    font-size: 16px;
    font-weight: 400;
  }

  .arch-pricing-card .plan-price-desc {
    color: var(--isavo-text-muted);
    text-align: center;
    margin-bottom: 4px;
    font-size: 12px;
    font-style: italic;
  }

  .arch-pricing-card .plan-duration {
    color: var(--tl-color-theme-primary);
    text-align: center;
    margin-bottom: 20px;
    font-size: 13px;
    font-weight: 600;
  }

  .arch-pricing-card .plan-deliverables-heading {
    font-family: var(--tl-ff-heading);
    color: var(--tl-color-heading-primary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-top: 1px solid var(--tl-color-border-1);
    margin-top: 16px;
    margin-bottom: 12px;
    padding-top: 16px;
    font-size: 11px;
    font-weight: 400;
    display: block;
    text-align: left;
  }

  .arch-pricing-card .plan-features {
    flex: 1;
    margin: 0 0 24px;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .arch-pricing-card .plan-features li {
    border-bottom: 1px solid #f4f4f4;
    color: var(--tl-color-text-body);
    align-items: flex-start;
    gap: 10px;
    padding: 10px 0;
    font-size: 13.5px;
    font-family: var(--tl-ff-body);
    line-height: 1.5;
    display: flex;
  }

  .arch-pricing-card .plan-features li:last-child {
    border-bottom: none;
  }

  /* Checkmark circle — ISAVO solid red → GVF solid emerald */
  .arch-pricing-card .plan-features li .check-icon-circle {
    color: #ffffff;
    background: var(--tl-color-theme-primary);
    border-radius: 50%;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .arch-pricing-card .plan-features li strong {
    color: var(--tl-color-heading-primary);
    font-weight: 700;
  }

  .arch-pricing-card .plan-btn-wrap {
    text-align: center;
    margin-top: auto;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  /* =========================================================================
     BUTTON — HARD COPY ISAVO .tl-primary-btn
     Pill transparan, icon lingkaran solid, arrow rotate -45deg→0
     ========================================================================= */
  .tl-primary-btn {
    font-family: var(--tl-ff-heading); /* Cal Sans — sama persis ISAVO */
    color: var(--tl-color-heading-primary);
    text-transform: capitalize;
    z-index: 1;
    background-color: transparent;
    border: 1px solid #9f9fa4a3; /* ISAVO border color */
    border-radius: 100px;
    align-items: center;
    padding: 10px 15px 10px 25px; /* ISAVO padding asli */
    font-size: 16px;
    font-weight: 400; /* Cal Sans normal weight */
    line-height: 1;
    transition: all .3s ease-in-out;
    display: inline-flex;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
    text-decoration: none;
    width: 100%;
    max-width: 300px;
  }

  .tl-primary-btn:before {
    content: '';
    background: var(--tl-color-theme-primary); /* GVF Emerald (ISAVO: merah) */
    transform-origin: 100%;
    transition: transform .4s cubic-bezier(.4, 0, .2, 1);
    z-index: -1;
    position: absolute;
    inset: 0;
    transform: scaleX(0);
  }

  .tl-primary-btn:hover {
    color: #ffffff;
    border: 1px solid var(--tl-color-theme-primary);
  }

  .tl-primary-btn:hover:before {
    transform-origin: 0;
    transform: scaleX(1);
  }

  /* Icon lingkaran solid — ISAVO: merah solid, GVF: emerald solid */
  .tl-primary-btn .icon {
    background-color: var(--tl-color-theme-primary);
    color: #ffffff;
    border-radius: 50%;
    justify-content: center;
    align-items: center;
    width: 40px;  /* ISAVO: 40px */
    height: 40px;
    margin-left: 10px;
    transition: all .3s ease-in-out;
    display: flex;
    flex-shrink: 0;
  }

  /* Arrow icon — ISAVO: rotate(-45deg) saat rest, rotate(0) saat hover */
  .tl-primary-btn .btn-arrow-icon {
    width: 16px;
    height: 16px;
    transition: all .3s ease-in-out;
    transform: rotate(-45deg); /* Rest: diagonal ↗ */
  }

  .tl-primary-btn:hover .btn-arrow-icon {
    transform: rotate(0deg); /* Hover: lurus → */
  }

  .tl-primary-btn:hover .icon {
    background-color: var(--tl-color-theme-primary);
    color: #ffffff;
  }

  /* =========================================================================
     3. DEEP DIVE (2 KOLOM STICKY SIDEBAR)
     ========================================================================= */
  .isavo-split-layout {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 48px;
    align-items: start;
  }

  .isavo-sticky-card {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .sidebar-widget {
    background: #ffffff;
    border: 1px solid var(--tl-color-border-1);
    border-radius: 16px;
    padding: 28px;
    box-shadow: none; /* ISAVO flat */
  }

  .sidebar-widget:hover {
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08); /* Hover saja */
  }

  .widget-title {
    font-family: var(--tl-ff-heading);
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--tl-color-heading-primary);
    margin-bottom: 20px;
    border-bottom: 1px solid var(--tl-color-border-1);
    padding-bottom: 12px;
  }

  .program-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .prog-nav-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-radius: 10px;
    color: #334155;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    background: var(--isavo-bg-light);
    border: 1px solid transparent;
    transition: all 0.2s ease;
  }

  .prog-nav-item:hover {
    background: var(--isavo-blue-soft);
    border-color: var(--isavo-blue-border);
    color: var(--isavo-blue);
    transform: translateX(4px);
  }

  .prog-nav-item.active {
    background: var(--tl-color-heading-primary); /* #191919 */
    color: #ffffff;
    font-weight: 700;
    box-shadow: none;
  }

  .prog-nav-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 6px;
    background: #e2e8f0;
    color: #0369a1 !important;
  }

  .prog-nav-item.active .prog-nav-badge {
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
  }

  /* CTA Widget in Sidebar */
  .cta-widget {
    position: relative;
    background: linear-gradient(135deg, #0a2540 0%, #0f172a 100%);
    color: #ffffff;
    overflow: hidden;
  }

  .cta-tag {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #38bdf8 !important;
  }

  .cta-title {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 8px 0 12px;
    line-height: 1.35;
    color: #ffffff !important;
  }

  .cta-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: #cbd5e1 !important;
    margin-bottom: 20px;
  }

  .cta-phone {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.15rem;
    font-weight: 800;
    color: #ffffff !important;
    margin-bottom: 20px;
  }

  .cta-phone svg {
    width: 20px;
    height: 20px;
    color: #38bdf8;
  }

  .isavo-btn-wa-widget {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 12px 18px;
    background: #25d366;
    color: #ffffff;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: none;
    transition: transform 0.2s, background-color 0.2s;
  }

  .isavo-btn-wa-widget:hover {
    transform: translateY(-2px);
    background-color: #1eb954;
    box-shadow: none;
  }

  .isavo-btn-wa-widget svg {
    width: 16px;
    height: 16px;
  }

  /* Kolom Kanan Konten */
  .article-banner-wrap {
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 36px;
    border: 1px solid #e2e8f0;
    box-shadow: none;
  }

  .article-banner-img {
    width: 100%;
    height: 380px;
    object-fit: cover;
    display: block;
  }

  .article-title {
    font-family: var(--tl-ff-heading);
    font-size: clamp(1.8rem, 3vw, 2.3rem);
    font-weight: 400;
    color: var(--tl-color-heading-primary);
    line-height: 1.2;
    margin-bottom: 18px;
  }

  .article-lead {
    font-size: 1.12rem;
    line-height: 1.75;
    color: #1e293b;
    font-weight: 500;
    margin-bottom: 16px;
    text-align: justify;
  }

  .article-p {
    font-size: 0.98rem;
    line-height: 1.8;
    color: #475569;
    margin-bottom: 18px;
    text-align: justify;
  }

  /* Value Box Grid */
  .value-boxes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }

  .value-box-item {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 24px;
    box-shadow: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .value-box-item:hover {
    transform: translateY(-3px);
    border-color: #0969da;
    box-shadow: none;
  }

  .value-box-icon {
    width: 38px;
    height: 38px;
    min-width: 38px;
    min-height: 38px;
    max-width: 38px;
    max-height: 38px;
    border-radius: 10px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    color: #0284c7;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    transition: all 0.25s ease;
    overflow: hidden;
    flex-shrink: 0;
  }

  .value-box-item:hover .value-box-icon {
    background: #0284c7;
    color: #ffffff;
    border-color: #0284c7;
  }

  .value-box-icon :global(svg),
  .value-box-icon svg {
    width: 18px !important;
    height: 18px !important;
    max-width: 18px !important;
    max-height: 18px !important;
    display: block;
  }

  .value-box-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--isavo-navy);
    margin-bottom: 8px;
  }

  .value-box-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: #475569 !important;
    text-align: justify;
  }

  /* =========================================================================
     4. GALERI DOKUMENTASI & PROGRES LAPANGAN
     ========================================================================= */
  .isavo-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 28px;
  }

  .gallery-card {
    background: #ffffff;
    border: 1px solid var(--isavo-border);
    border-radius: 20px;
    overflow: hidden;
    cursor: pointer;
    box-shadow: none;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
  }

  .gallery-card:hover {
    transform: translateY(-6px);
    border-color: #0969da;
    box-shadow: none;
  }

  .gallery-thumb-wrap {
    position: relative;
    width: 100%;
    height: 240px;
    overflow: hidden;
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery-card:hover .gallery-img {
    transform: scale(1.08);
  }

  .gallery-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 37, 64, 0.2) 0%, rgba(10, 37, 64, 0.75) 100%);
