---
// src/layouts/ProgramLayout.astro
// Master Template 8 Section Program ZISWAF ala ISAVO (isavo.co.id/architecture)
import BaseLayout from './BaseLayout.astro';
import type { ProgramData } from '../data/programs';

interface Props {
  program: ProgramData;
}

const { program } = Astro.props;

// Daftar link program untuk sticky sidebar
const programNavLinks = [
  { slug: 'wakaf', name: 'Wakaf Produktif & Lahan', badge: 'Abadi' },
  { slug: 'zakat', name: 'Zakat Maal & Profesi', badge: 'Wajib 2.5%' },
  { slug: 'infaq', name: 'Infaq Pembangunan', badge: 'Fleksibel' },
  { slug: 'sedekah', name: 'Sedekah Subuh & Pangan', badge: 'Harian' },
];
---

<BaseLayout
  title={`${program.title} • Global Village Fund`}
  description={program.heroSubtitle}
  ogImage={program.heroBgImage}
>
  <!-- =========================================================================
       SECTION 1: PAGE HEADER & BREADCRUMB ALA ISAVO
       ========================================================================= -->
  <section class="isavo-prog-header" style={`background-image: url('${program.heroBgImage}');`}>
    <div class="isavo-header-overlay"></div>
    <div class="isavo-header-container">
      <div class="isavo-header-content reveal-on-scroll">
        <div class="isavo-header-badge">
          <span class="badge-dot"></span>
          <span>{program.categoryBadge}</span>
        </div>
        <h1 class="isavo-header-title">{program.title}</h1>
        <p class="isavo-header-subtitle">{program.heroSubtitle}</p>
        <div class="isavo-header-breadcrumb">
          <a href="/">Home</a>
          <span class="sep">/</span>
          <a href="/program">Program</a>
          <span class="sep">/</span>
          <span class="current">{program.title}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 2: PILIHAN PAKET AKAD & DONASI (EXACT ISAVO 3-COLUMN PRICING)
       ========================================================================= -->
  <section class="isavo-pricing-section pt-100 pb-100" id="paket-donasi">
    <div class="isavo-container">
      <div class="isavo-section-heading text-center reveal-on-scroll">
        <div class="isavo-pill-tag">
          <span class="isavo-pill-dot"></span>
          <span>DESIGN PACKAGE PRICING</span>
        </div>
        <h2 class="isavo-section-title">
          {program.pricingHeading.split(' ').slice(0, 2).join(' ')} <span class="accent-blue">{program.pricingHeading.split(' ').slice(2).join(' ')}</span>
        </h2>
        <p class="isavo-section-desc">{program.pricingSubheading}</p>
      </div>

      <!-- Exact 3 Columns Grid ala ISAVO -->
      <div class="isavo-pricing-grid-3 mt-50">
        {program.packages.map((pkg, index) => (
          <div
            class={`arch-pricing-card slide-anim ${pkg.isPopular ? 'popular' : ''}`}
            data-direction="bottom"
            data-offset="60"
            data-delay={(index * 0.12).toFixed(2)}
            id={`pkg-${pkg.id}`}
          >
            {pkg.isPopular && <span class="pricing-badge">Paling Populer</span>}
            
            <h3 class="plan-title">{pkg.title}</h3>
            <p class="plan-subtitle">{pkg.subtitle}</p>

            <div class="plan-price">
              <span class="currency">{pkg.pricePrefix || 'Rp '}</span>
              <span class="amount">{pkg.priceAmount}</span>
              <span class="period">{pkg.priceUnit}</span>
            </div>
            <p class="plan-price-desc">{pkg.priceDesc}</p>
            <p class="plan-duration">{pkg.estimation}</p>

            <div class="plan-deliverables-heading">What Do You Get:</div>
            
            <ul class="plan-features">
              {pkg.deliverables.map(item => (
                <li>
                  <span class="check-icon-circle">
                    <svg viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                  </span>
                  <span>
                    <strong>{item.bold}</strong> — {item.text}
                  </span>
                </li>
              ))}
            </ul>

            <div class="plan-btn-wrap">
              <a href="#rekening" class="tl-primary-btn">
                <span>{pkg.ctaText}</span>
                <span class="icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="btn-arrow-icon">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 3: DEEP-DIVE PROGRAM (2 KOLOM STICKY SIDEBAR ALA ISAVO)
       ========================================================================= -->
  <section class="isavo-deepdive-section pt-100 pb-100 bg-light" id="tentang-program">
    <div class="isavo-container">
      <div class="isavo-split-layout">
        <!-- Kolom Kiri: Sticky Sidebar -->
        <aside class="isavo-sidebar-col">
          <div class="isavo-sticky-card">
            <!-- Navigasi Program Lain -->
            <div class="sidebar-widget nav-widget reveal-on-scroll">
              <h3 class="widget-title">Pilar Program ZISWAF</h3>
              <ul class="program-nav-list">
                {programNavLinks.map(link => (
                  <li>
                    <a
                      href={`/program/${link.slug}`}
                      class={`prog-nav-item ${link.slug === program.slug ? 'active' : ''}`}
                    >
                      <span class="prog-nav-name">{link.name}</span>
                      <span class="prog-nav-badge">{link.badge}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Bantuan / Konsultasi Cepat Widget ala ISAVO -->
            <div class="sidebar-widget cta-widget reveal-on-scroll delay-100">
              <div class="cta-widget-bg"></div>
              <div class="cta-widget-content">
                <span class="cta-tag">KONSULTASI AKAD</span>
                <h4 class="cta-title">Butuh Panduan Fiqih atau Hitung ZISWAF?</h4>
                <p class="cta-desc">Tim sekretariat dewan syariah GVF siap melayani konsultasi akad, simulasi luas tanah, atau wakaf keluarga.</p>
                <div class="cta-phone">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                  </svg>
                  <span>0812-2683-2326</span>
                </div>
                <a
                  href="https://wa.me/6281226832326?text=Assalamualaikum%20Dewan%20Syariah%20GVF%2C%20saya%20ingin%20konsultasi%20program%20wakaf."
                  target="_blank"
                  rel="noopener noreferrer"
                  class="isavo-btn-wa-widget"
                >
                  <span>Chat WhatsApp Sekarang</span>
                  <svg viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </aside>

        <!-- Kolom Kanan: Konten Narasi Utama -->
        <main class="isavo-main-col">
          <div class="isavo-article-wrap">
            <div class="article-banner-wrap reveal-on-scroll">
              <img
                src={program.deepDiveBannerImage}
                alt={program.deepDiveTitle}
                class="article-banner-img"
                loading="lazy"
              />
            </div>

            <div class="article-body reveal-on-scroll">
              <div class="isavo-pill-tag">
                <span class="isavo-pill-dot"></span>
                <span>{program.deepDiveBadge}</span>
              </div>
              <h2 class="article-title">{program.deepDiveTitle}</h2>
              <p class="article-lead">{program.deepDiveLead}</p>
              <p class="article-p">{program.deepDiveStory1}</p>
              <p class="article-p">{program.deepDiveStory2}</p>
            </div>

            <!-- 4 Value Box Icon Grid ala ISAVO -->
            <div class="value-boxes-grid mt-40">
              {program.valueBoxes.map((vb, idx) => (
                <div class={`value-box-item reveal-on-scroll delay-${(idx + 1) * 100}`}>
                  <div class="value-box-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 14 14"></polyline>
                    </svg>
                  </div>
                  <h4 class="value-box-title">{vb.title}</h4>
                  <p class="value-box-desc">{vb.description}</p>
                </div>
              ))}
            </div>
          </div>
        </main>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 4: GALERI DOKUMENTASI & PROGRES LAPANGAN (INTERACTIVE SHOWCASE)
       ========================================================================= -->
  <section class="isavo-gallery-section pt-100 pb-100" id="galeri-lapangan">
    <div class="isavo-container">
      <div class="isavo-section-heading text-center reveal-on-scroll">
        <div class="isavo-pill-tag">
          <span class="isavo-pill-dot"></span>
          <span>{program.galleryBadge}</span>
        </div>
        <h2 class="isavo-section-title">
          {program.galleryTitle.split(' ')[0]} <span class="accent-blue">{program.galleryTitle.split(' ').slice(1).join(' ')}</span>
        </h2>
        <p class="isavo-section-desc">{program.gallerySubtitle}</p>
      </div>

      <!-- Grid Foto Portofolio Interaktif ala ISAVO (isavo-hover-view) -->
      <div class="isavo-gallery-grid mt-50">
        {program.galleryItems.map((item, idx) => (
          <div
            class={`gallery-card isavo-hover-view reveal-on-scroll delay-${(idx + 1) * 100}`}
            data-img-src={item.image}
            data-img-title={item.title}
            data-img-caption={item.caption}
          >
            <div class="gallery-thumb-wrap">
              <img src={item.image} alt={item.title} class="gallery-img" loading="lazy" />
              <div class="gallery-overlay">
                <span class="gallery-zoom-btn" title="Perbesar Foto">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    <line x1="11" y1="8" x2="11" y2="14"></line>
                    <line x1="8" y1="11" x2="14" y2="11"></line>
                  </svg>
                </span>
                <span class="gallery-category-badge">{item.category}</span>
              </div>
            </div>
            <div class="gallery-info">
              <span class="gallery-status">{item.status}</span>
              <h3 class="gallery-title">{item.title}</h3>
              <p class="gallery-caption">{item.caption}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 5: ALUR 4 LANGKAH PENYALURAN & AKAD TRANSPARAN (PROCESS ALA ISAVO)
       ========================================================================= -->
  <section class="isavo-process-section pt-100 pb-100 bg-light" id="alur-penyaluran">
    <div class="isavo-container">
      <div class="isavo-section-heading text-center reveal-on-scroll">
        <div class="isavo-pill-tag">
          <span class="isavo-pill-dot"></span>
          <span>TRANSPARANSI PROSES</span>
        </div>
        <h2 class="isavo-section-title">
          {program.workflowHeading.split(' ')[0]} <span class="accent-blue">{program.workflowHeading.split(' ').slice(1).join(' ')}</span>
        </h2>
        <p class="isavo-section-desc">Alur penunaian dirancang sederhana, berkekuatan hukum syar'i, dan termonitor secara terbuka.</p>
      </div>

      <div class="isavo-process-grid mt-50">
        {program.workflowSteps.map((step, idx) => (
          <div class={`process-card reveal-on-scroll delay-${(idx + 1) * 100}`}>
            <div class="process-num-badge">{step.number}</div>
            <h3 class="process-step-title">{step.title}</h3>
            <p class="process-step-desc">{step.description}</p>
            <div class="process-corner-number">{step.number}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 6: DEWAN PENGAWAS SYARIAH & KEPENGURUSAN
       ========================================================================= -->
  <section class="isavo-leadership-section pt-100 pb-100" id="kepengurusan">
    <div class="isavo-container">
      <div class="isavo-section-heading text-center reveal-on-scroll">
        <div class="isavo-pill-tag">
          <span class="isavo-pill-dot"></span>
          <span>{program.leadershipBadge}</span>
        </div>
        <h2 class="isavo-section-title">
          {program.leadershipTitle.split(' ')[0]} <span class="accent-blue">{program.leadershipTitle.split(' ').slice(1).join(' ')}</span>
        </h2>
        <blockquote class="leadership-quote-lead">
          {program.leadershipQuote}
        </blockquote>
      </div>

      <div class="isavo-leaders-grid mt-50">
        {program.leaders.map((leader, idx) => (
          <div class={`leader-card reveal-on-scroll delay-${(idx + 1) * 100}`}>
            <div class="leader-photo-wrap">
              <img src={leader.image} alt={leader.name} class="leader-photo" loading="lazy" />
              <div class="leader-role-tag">{leader.role}</div>
            </div>
            <div class="leader-content">
              <h3 class="leader-name">{leader.name}</h3>
              <p class="leader-cred">{leader.credentials}</p>
              <p class="leader-quote">"{leader.quote}"</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 7: LEGALITAS RESMI, SK BWI & REKENING YAYASAN
       ========================================================================= -->
  <section class="isavo-legalitas-section pt-100 pb-100 bg-light" id="rekening">
    <div class="isavo-container">
      <div class="isavo-section-heading text-center reveal-on-scroll">
        <div class="isavo-pill-tag">
          <span class="isavo-pill-dot"></span>
          <span>{program.legalitasBadge}</span>
        </div>
        <h2 class="isavo-section-title">
          {program.legalitasTitle.split(' ')[0]} <span class="accent-blue">{program.legalitasTitle.split(' ').slice(1).join(' ')}</span>
        </h2>
        <p class="isavo-section-desc">Seluruh dana dihimpun dan dikelola atas nama rekening lembaga resmi yang diawasi regulator terkait.</p>
      </div>

      <div class="legalitas-split-wrap mt-50">
        <!-- Kolom Dokumen Legalitas -->
        <div class="legal-docs-col reveal-on-scroll">
          <h3 class="col-heading">Landasan Legalitas & Perizinan</h3>
          <div class="legal-cards-list">
            {program.legalities.map(leg => (
              <div class="legal-badge-card">
                <div class="legal-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  </svg>
                </div>
                <div class="legal-info">
                  <h4 class="inst-name">{leg.institution}</h4>
                  <div class="reg-badge">{leg.regNumber}</div>
                  <p class="leg-auth">{leg.authority}</p>
                  <p class="leg-desc">{leg.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Kolom Rekening Bank Resmi Yayasan -->
        <div class="bank-accounts-col reveal-on-scroll delay-100">
          <h3 class="col-heading">Rekening Resmi Penampungan Dana</h3>
          <div class="bank-cards-list">
            {program.bankAccounts.map(acc => (
              <div class="bank-card">
                <div class="bank-card-top">
                  <span class="bank-name">{acc.bankName}</span>
                  <span class="bank-code">Kode Bank: {acc.code}</span>
                </div>
                <div class="account-num-row">
                  <span class="acc-num" id={`acc-${acc.accountNumber}`}>{acc.accountNumber}</span>
                  <button
                    type="button"
                    class="btn-copy-acc"
                    data-copy-target={acc.accountNumber}
                    title="Salin Nomor Rekening"
                  >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                    </svg>
                    <span>Salin</span>
                  </button>
                </div>
                <div class="bank-holder">Atas Nama: <strong>{acc.accountHolder}</strong></div>
              </div>
            ))}
          </div>

          <div class="qris-box-mini mt-30">
            <div class="qris-tag">PEMBAYARAN INSTAN (QRIS)</div>
            <p>Menerima seluruh aplikasi pembayaran mobile banking (BSI, Mandiri, BCA, BRI, BNI) serta e-wallet (GoPay, OVO, Dana, LinkAja, ShopeePay).</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 8: FAQ SYARIAH & FORM KONFIRMASI AKAD (BOTTOM BANNER ALA ISAVO)
       ========================================================================= -->
  <section class="isavo-faq-section pt-100 pb-100" id="faq">
    <div class="isavo-container">
      <div class="isavo-section-heading text-center reveal-on-scroll">
        <div class="isavo-pill-tag">
          <span class="isavo-pill-dot"></span>
          <span>{program.faqBadge}</span>
        </div>
        <h2 class="isavo-section-title">
          {program.faqTitle.split(' ')[0]} <span class="accent-blue">{program.faqTitle.split(' ').slice(1).join(' ')}</span>
        </h2>
        <p class="isavo-section-desc">Panduan fiqih dan kejelasan syarat akad demi kemantapan hati donatur.</p>
      </div>

      <!-- Accordion FAQ Interaktif -->
      <div class="faq-accordion-wrap mt-50 max-w-800 mx-auto">
        {program.faqs.map((faq, idx) => (
          <details class={`isavo-faq-item reveal-on-scroll delay-${(idx + 1) * 100}`} open={idx === 0}>
            <summary class="faq-summary">
              <span class="faq-question">{faq.question}</span>
              <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="faq-content">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>

      <!-- Bottom Action Banner ala ISAVO Newsletter / Consultation Banner -->
      <div class="isavo-bottom-banner mt-80 reveal-on-scroll">
        <div class="banner-inner">
          <div class="banner-text">
            <h3 class="banner-title">{program.ctaBannerHeading}</h3>
            <p class="banner-desc">{program.ctaBannerText}</p>
          </div>
          <div class="banner-btn-wrap">
            <a
              href="https://wa.me/6281226832326?text=Assalamualaikum%20Admin%2C%20saya%20ingin%20konfirmasi%20akad%20donasi."
              target="_blank"
              rel="noopener noreferrer"
              class="isavo-banner-btn"
            >
              <span>Hubungi Konsultan ZISWAF</span>
              <svg viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       MODAL LIGHTBOX POPUP UNTUK GALERI
       ========================================================================= -->
  <div class="isavo-lightbox-modal" id="programLightbox" aria-hidden="true" role="dialog">
    <div class="lightbox-backdrop" id="lightboxCloseArea"></div>
    <div class="lightbox-dialog">
      <button type="button" class="lightbox-close-btn" id="lightboxCloseBtn" aria-label="Tutup Galeri">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <div class="lightbox-media-wrap">
        <img src="" alt="" id="lightboxImg" class="lightbox-img" />
      </div>
      <div class="lightbox-caption-wrap">
        <h3 id="lightboxTitle" class="lightbox-title"></h3>
        <p id="lightboxCaption" class="lightbox-caption"></p>
      </div>
    </div>
  </div>

  <!-- SCRIPT INTERAKTIF: GSAP SCROLLTRIGGER ENGINE ALA ISAVO, SALIN REKENING & LIGHTBOX -->
  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    if (typeof window !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);

      const initAnimations = () => {
        // 1. ISAVO .slide-anim (Pricing cards & element slides)
        gsap.utils.toArray<HTMLElement>('.slide-anim').forEach((t) => {
          const s = t.dataset.direction || 'bottom';
          const o = parseInt(t.dataset.offset || '60', 10);
          const r = parseFloat(t.dataset.delay || '0') || 0;
          const n: gsap.TweenVars = { opacity: 0 };
          
          if (s === 'left') n.x = -o;
          else if (s === 'right') n.x = o;
          else if (s === 'bottom') n.y = o;
          else if (s === 'top') n.y = -o;
          
          gsap.set(t, n);
          gsap.fromTo(
            t,
            n,
            {
              opacity: 1,
              x: 0,
              y: 0,
              duration: 0.8,
              delay: r,
              ease: 'power2.out',
              scrollTrigger: {
                trigger: t,
                start: 'top 95%',
                toggleActions: 'play none none none',
                once: true,
              },
            }
          );
        });

        // 2. ISAVO .fade-top (Heading & titles)
        gsap.utils.toArray<HTMLElement>('.fade-top').forEach((t) => {
          gsap.set(t, { opacity: 0, y: -30 });
          gsap.fromTo(
            t,
            { opacity: 0, y: -30 },
            {
              opacity: 1,
              y: 0,
              duration: 0.8,
              ease: 'power2.out',
              scrollTrigger: {
                trigger: t,
                start: 'top 85%',
                toggleActions: 'play none none none',
                once: true,
              },
            }
          );
        });

        // 3. ISAVO .fade-wrapper (Staggered items)
        gsap.utils.toArray<HTMLElement>('.fade-wrapper').forEach((t) => {
          const s = t.querySelectorAll(':scope > *');
          gsap.set(s, { opacity: 0, y: 30 });
          gsap.fromTo(
            s,
            { opacity: 0, y: 30 },
            {
              opacity: 1,
              y: 0,
              duration: 0.6,
              stagger: 0.1,
              ease: 'power2.out',
              scrollTrigger: {
                trigger: t,
                start: 'top 85%',
                toggleActions: 'play none none none',
                once: true,
              },
            }
          );
        });

        // 4. GSAP Handler for general reveal elements (.reveal-on-scroll)
        gsap.utils.toArray<HTMLElement>('.reveal-on-scroll').forEach((el) => {
          gsap.set(el, { opacity: 0, y: 30 });
          gsap.to(el, {
            opacity: 1,
            y: 0,
            duration: 0.8,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: el,
              start: 'top 88%',
              toggleActions: 'play none none none',
              once: true,
            },
          });
        });

        ScrollTrigger.refresh();
      };

      // Double requestAnimationFrame persis seperti ISAVO bundle agar layout stabil
      requestAnimationFrame(() => {
        requestAnimationFrame(initAnimations);
      });
    }

    // 5. Copy Account Number with Toast Feedback
    document.querySelectorAll('.btn-copy-acc').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetNumber = btn.getAttribute('data-copy-target');
        if (targetNumber) {
          navigator.clipboard.writeText(targetNumber).then(() => {
            const originalHTML = btn.innerHTML;
            btn.classList.add('copied');
            btn.innerHTML = `
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Tersalin!</span>
            `;
            setTimeout(() => {
              btn.innerHTML = originalHTML;
              btn.classList.remove('copied');
            }, 2500);
          });
        }
      });
    });

    // 6. Interactive Lightbox Modal for Gallery Cards
    const lightbox = document.getElementById('programLightbox');
    const lightboxImg = document.getElementById('lightboxImg') as HTMLImageElement;
    const lightboxTitle = document.getElementById('lightboxTitle');
    const lightboxCaption = document.getElementById('lightboxCaption');
    const closeBtn = document.getElementById('lightboxCloseBtn');
    const closeArea = document.getElementById('lightboxCloseArea');

    function openLightbox(src: string, title: string, caption: string) {
      if (lightbox && lightboxImg && lightboxTitle && lightboxCaption) {
        lightboxImg.src = src;
        lightboxImg.alt = title;
        lightboxTitle.textContent = title;
        lightboxCaption.textContent = caption;
        lightbox.classList.add('is-open');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeLightbox() {
      if (lightbox) {
        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
    }

    document.querySelectorAll('.gallery-card').forEach(card => {
      card.addEventListener('click', () => {
        const src = card.getAttribute('data-img-src') || '';
        const title = card.getAttribute('data-img-title') || '';
        const caption = card.getAttribute('data-img-caption') || '';
        openLightbox(src, title, caption);
      });
    });

    closeBtn?.addEventListener('click', closeLightbox);
    closeArea?.addEventListener('click', closeLightbox);
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });
  </script>
</BaseLayout>

