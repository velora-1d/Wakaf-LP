---
// src/layouts/ProgramLayout.astro
// Master Template Program GVF Presisi 100% Desain Pen.dev (global village fund.pen)
import BaseLayout from './BaseLayout.astro';
import '../styles/program-layout.css';
import type { ProgramData } from '../data/programs';
import PricingPackagesSection from '../components/program/PricingPackagesSection.astro';
import { getActivePageSections } from '../lib/db';
import { getBreadcrumbSchema, getFaqSchema, getProgramSchema } from '../lib/seo-schema';

interface Props {
  program: ProgramData;
}

const { program } = Astro.props;

// Fetch active sections from PostgreSQL with safe fallback
const activeSections = await getActivePageSections(program.slug);
const sectionMap = new Map(activeSections.map((s) => [s.sectionKey, s]));
const isEnabled = (key: string) => {
  if (activeSections.length === 0) return true;
  return sectionMap.has(key);
};

// Site URL & SEO Schema Definitions
const siteUrl = (Astro.site ? Astro.site.toString() : 'https://globalvillagefund.org').replace(/\/$/, '');
const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Program GVF', url: '/#programs' },
  { name: program.title, url: `/program/${program.slug}` },
];

const programSchemas = [
  getBreadcrumbSchema(breadcrumbs, siteUrl),
  getProgramSchema(
    {
      title: program.title,
      slug: program.slug,
      heroSubtitle: program.heroSubtitle,
      heroBgImage: program.heroBgImage,
    },
    siteUrl
  ),
  program.faqs ? getFaqSchema(program.faqs) : null,
].filter(Boolean);

// Daftar link program untuk sticky sidebar
const programNavLinks = [
  { slug: 'infaq', name: '01. Infak' },
  { slug: 'sedekah', name: '02. Sedekah' },
  { slug: 'zakat', name: '03. Zakat' },
  { slug: 'wakaf', name: '04. Wakaf' },
];

// Value box vector SVG icons (Pahala Abadi, BWI, Akta AIW, Laporan Transparan)
const valueBoxIcons = [
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>`
];

// Resolusi Konten Dinamis Halaman Program dari Database Neon
const progHeroContent = sectionMap.get('prog_hero')?.content;
const progHeroBgImage = progHeroContent?.imageUrl || program.heroBgImage;
const progHeroTitle = progHeroContent?.heading || progHeroContent?.title || program.title;

const progDetailsContent = sectionMap.get('prog_details')?.content;
const progDetailsImage = progDetailsContent?.imageUrl || program.heroImage || program.deepDiveBannerImage || "https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/fasilitas-dan-infrastruktur/progres-konstruksi-gedung-dan-wudhu.webp";
const progDetailsTitle = progDetailsContent?.heading || progDetailsContent?.title || program.deepDiveTitle;
const progDetailsLead = progDetailsContent?.storyLead || progDetailsContent?.desc || progDetailsContent?.paragraph1 || program.deepDiveLead;
const progDetailsStory1 = progDetailsContent?.story1 || progDetailsContent?.paragraph2 || program.deepDiveStory1;
const progDetailsStory2 = progDetailsContent?.story2 || program.deepDiveStory2;
const progValueBoxes = (Array.isArray(progDetailsContent?.valueBoxes) && progDetailsContent.valueBoxes.length > 0) ? progDetailsContent.valueBoxes : program.valueBoxes;
const progTwinImages = (Array.isArray(progDetailsContent?.twinImages) && progDetailsContent.twinImages.length >= 2) ? progDetailsContent.twinImages : program.deepDiveTwinImages;
const progSubblock1Title = progDetailsContent?.subblock1Title || program.deepDiveSubblock1Title || (program.slug === 'infaq' ? 'Konsep Green Building Ramah Lingkungan' : 'Integrasi Pesantren & Agro-Technopark');
const progSubblock1Desc1 = progDetailsContent?.subblock1Desc1 || program.deepDiveSubblock1Desc1;
const progSubblock1Desc2 = progDetailsContent?.subblock1Desc2 || program.deepDiveSubblock1Desc2;
const progSubblock2Title = progDetailsContent?.subblock2Title || program.deepDiveSubblock2Title || (program.slug === 'infaq' ? 'Dokumentasi Fisik Lapangan' : 'Dokumentasi Kawasan Wakaf Jonggol');
const progSubblock2Desc1 = progDetailsContent?.subblock2Desc1 || program.deepDiveSubblock2Desc1;
const progSubblock2Desc2 = progDetailsContent?.subblock2Desc2 || program.deepDiveSubblock2Desc2;
const progShowcaseItems = (Array.isArray(progDetailsContent?.portfolioShowcaseItems) && progDetailsContent.portfolioShowcaseItems.length > 0) ? progDetailsContent.portfolioShowcaseItems : program.portfolioShowcaseItems;
const progGuarantees = (Array.isArray(progDetailsContent?.guarantees) && progDetailsContent.guarantees.length > 0) ? progDetailsContent.guarantees : program.guarantees;

const progFaqContent = sectionMap.get('prog_faq')?.content;
const progFaqTitle = progFaqContent?.heading || progFaqContent?.title || program.faqTitle;
const progFaqs = (Array.isArray(progFaqContent?.faqs) && progFaqContent.faqs.length > 0) ? progFaqContent.faqs : program.faqs;
---

<BaseLayout
  title={`${program.title} • Global Village Fund`}
  description={program.heroSubtitle}
  ogImage={progHeroBgImage}
  schema={programSchemas}
>
  {isEnabled('prog_hero') && (
  <section
    class="pen-prog-header relative overflow-hidden bg-cover bg-center flex flex-col justify-center items-center"
    style={`background-image: url('${progHeroBgImage}'); background-color: #191919; min-height: 385px; padding-top: 140px; padding-bottom: 100px;`}
  >
    <div class="absolute inset-0 bg-[#061829] opacity-75 z-0"></div>
    <div class="relative z-10 max-w-[1795px] mx-auto px-4 w-full flex flex-col items-center justify-center text-center">
      <h1
        class="pen-hero-title"
        style="color: #ffffff !important; font-family: 'Golos Text', system-ui, sans-serif !important; font-size: clamp(32px, 4.5vw, 64px) !important; font-weight: 500 !important; line-height: 1.2 !important; margin: 0 0 16px 0 !important; text-align: center !important;"
      >
        {progHeroTitle}
      </h1>
      <div
        class="pen-hero-breadcrumb flex items-center justify-center"
        style="font-family: 'Golos Text', system-ui, sans-serif; font-size: 13px; line-height: 16px; font-weight: 500; text-transform: uppercase;"
      >
        <a href="/" style="color: #ffffff; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#38bdf8'" onmouseout="this.style.color='#ffffff'">BERANDA</a>
        <span style="color: #ffffff; padding: 0 8px;">-</span>
        <span style="color: #0969da; font-weight: 600; filter: drop-shadow(0 1px 2px rgba(0,0,0,0.5));">{program.categoryBadge}</span>
      </div>
    </div>
  </section>
  )}

  {isEnabled('prog_pricing') && <PricingPackagesSection program={program} />}

  {isEnabled('prog_details') && (
  <section class="pen-deepdive-section" id="tentang-program">
    <div class="pen-deepdive-container">
      <aside class="pen-deepdive-sidebar">
        <div style="background: #ffffff; border-radius: 24px; padding: 32px; border: 1px solid #e3e3e8; box-shadow: 0 4px 16px rgba(0,0,0,0.02);">
          <h3 style="font-family: 'Golos Text', system-ui, sans-serif; font-size: 22px; color: #191919; margin: 0 0 20px 0; font-weight: 600;">Program Lainnya</h3>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px;">
            {programNavLinks.map(link => (
              <li>
                <a
                  href={`/program/${link.slug}`}
                  style={`display: flex; align-items: center; gap: 12px; padding: 12px 18px; border-radius: 12px; text-decoration: none; font-family: 'Golos Text', system-ui, sans-serif; font-size: 15px; transition: all 0.2s; ${
                    link.slug === program.slug
                      ? 'background-color: #0969da; color: #ffffff !important;'
                      : 'color: #191919; background-color: #f8fafc; border: 1px solid #e2e8f0;'
                  }`}
                >
                  <span style={`width: 7px; height: 7px; border-radius: 50%; shrink: 0; ${link.slug === program.slug ? 'background-color: #ffffff;' : 'background-color: #0969da;'}`}></span>
                  <span>{link.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div style="position: relative; border-radius: 24px; overflow: hidden; padding: 48px 24px; text-align: center; color: #ffffff; min-height: 440px; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 8px 24px rgba(0,0,0,0.12); background-image: url('https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/fasilitas-dan-infrastruktur/dinding-hebel-ventilasi-roster-1.webp'); background-size: cover; background-position: center;">
          <div style="position: absolute; inset: 0; background: rgba(6, 24, 41, 0.82); z-index: 0;"></div>
          <div style="position: relative; z-index: 10; display: flex; flex-direction: column; align-items: center; width: 100%;">
            <img src="/logo-gvf-3d.png" alt="Global Village Fund Logo" style="height: 54px; width: auto; object-fit: contain; margin-bottom: 16px; filter: drop-shadow(0 4px 12px rgba(0,0,0,0.4));" />
            <span style="font-family: 'Golos Text', system-ui, sans-serif; font-size: 11px; letter-spacing: 1.5px; color: #38bdf8; text-transform: uppercase; font-weight: 700; margin-bottom: 8px;">
              LAYANAN KONSULTASI
            </span>
            <h4 style="font-family: 'Golos Text', system-ui, sans-serif; font-size: 22px; color: #ffffff; margin: 0 0 12px 0; font-weight: 600;">
              {program.slug === 'zakat' ? 'Konsultasi Perhitungan Zakat' : program.slug === 'infaq' ? 'Konsultasi Penyaluran Infaq' : program.slug === 'sedekah' ? 'Konsultasi Sedekah Santri' : 'Konsultasi Ikrar Wakaf'}
            </h4>
            <div style="font-family: 'Golos Text', system-ui, sans-serif; font-size: 32px; color: #ffffff; margin: 8px 0; letter-spacing: 1px; font-weight: 700; text-shadow: 0 2px 10px rgba(0,0,0,0.5);">
              0878-6599-4786
            </div>
            <div style="font-family: 'Golos Text', sans-serif; font-size: 13px; color: rgba(255, 255, 255, 0.8); margin-bottom: 24px;">
              www.globalvillagefund.org
            </div>
            <a
              href="https://wa.me/6287865994786?text=Assalamualaikum%20Layanan%20Donatur%20GVF%2C%20saya%20ingin%20konsultasi%20program%20GVF."
              target="_blank"
              rel="noopener noreferrer"
              class="uiverse-ripple-btn uiverse-ripple-btn-dark pen-sidebar-cta"
            >
              <span>Layanan Donatur</span>
            </a>
          </div>
        </div>
      </aside>

      <!-- Kolom Kanan: Konten Narasi Utama (Flex 1) -->
      <div class="pen-deepdive-content">
        <div class="pen-deepdive-card">
          <!-- Main Hero Image -->
          <div class="pen-deepdive-hero-img-wrap">
            <img
              src={progDetailsImage}
              alt={progDetailsTitle}
              class="pen-deepdive-hero-img"
              loading="lazy"
            />
          </div>

          <!-- Deep Dive Lead Text -->
          <div class="pen-deepdive-lead-block">
            <h2 class="pen-deepdive-lead-title">
              {progDetailsTitle}
            </h2>
            <p class="pen-deepdive-para">
              {progDetailsLead}
            </p>
            <p class="pen-deepdive-para">
              {progDetailsStory1}
            </p>
            <p class="pen-deepdive-para">
              {progDetailsStory2}
            </p>
          </div>

          <!-- 4 Value Box Icon Grid ala Pen.dev -->
          <div class="pen-value-grid">
            {progValueBoxes.map((vb: any, idx: number) => (
              <div class="pen-value-item">
                <div class="pen-value-icon">
                  <Fragment set:html={valueBoxIcons[idx % valueBoxIcons.length]} />
                </div>
                <div>
                  <h4 class="pen-value-title">{vb.title}</h4>
                  <p class="pen-value-desc">{vb.description}</p>
                </div>
              </div>
            ))}
          </div>

          <!-- 2 Side-by-side Images (Pen.dev) -->
          <div class="pen-twins-img-grid">
            <img
              src={progTwinImages ? progTwinImages[0] : "https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/kegiatan-dan-prestasi-santri/halaqah-santri-melingkar.webp"}
              alt="Dokumentasi Fasilitas Jonggol 1"
              class="pen-twin-img"
              loading="lazy"
            />
            <img
              src={progTwinImages ? progTwinImages[1] : "https://br-billowing-mountain-aomqpcdy.storage.c-2.ap-southeast-1.aws.neon.tech/gvf-website/gvf/assets/bahan-konten/drone-lahan-dan-pemukiman.webp"}
              alt="Dokumentasi Fasilitas Jonggol 2"
              class="pen-twin-img"
              loading="lazy"
            />
          </div>

          <!-- Deep-dive Sub-block 1 (Pen.dev Exact) -->
          <div class="pen-deepdive-subblock">
            <h3 class="pen-subblock-title">
              {progSubblock1Title}
            </h3>
            <p class="pen-deepdive-para">
              {progSubblock1Desc1 || 'Masjid Khairu Ummah Sugro dirancang dengan arsitektur tropis ramah lingkungan yang memanfaatkan pencahayaan alami dan ventilasi silang, mengurangi konsumsi listrik dan menghadirkan suasana khusyuk bagi para jamaah.'}
            </p>
            <p class="pen-deepdive-para">
              {progSubblock1Desc2 || 'Dilengkapi area mezzanine dua lantai untuk menampung kegiatan ibadah berjamaah, halaqah Quran, serta ruang belajar santri yang terintegrasi dengan keasrian alam sekitar Sukasirna Jonggol.'}
            </p>
          </div>

          <!-- Deep-dive Sub-block 2 (Pen.dev Exact) -->
          <div class="pen-deepdive-subblock">
            <h3 class="pen-subblock-title">
              {progSubblock2Title}
            </h3>
            <p class="pen-deepdive-para">
              {progSubblock2Desc1 || 'Dokumentasi progres pembangunan riil di Sukasirna Jonggol — dari pemancangan tiang, pengecoran lantai, pemasangan dinding bata ringan, hingga instalasi sanitasi.'}
            </p>
            <p class="pen-deepdive-para">
              {progSubblock2Desc2 || 'Setiap kemajuan di lapangan adalah buah dari gotong royong dan ketulusan para muhsinin yang menyalurkan donasi terbaiknya.'}
            </p>

            <!-- 4 Portfolio Showcase Cards Grid (Pen.dev Exact) -->
            <div class="pen-portfolio-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin: 30px 0;">
              {progShowcaseItems.map((item: any) => (
                <div class="pen-showcase-card">
                  <div class="pen-showcase-img-box">
                    <img src={item.image} alt={item.name} class="pen-showcase-img" loading="lazy" />
                    <span class="pen-badge-arsitektur">{item.tag}</span>
                  </div>
                  <div class="pen-showcase-meta">
                    <h4 class="pen-showcase-name">{item.name}</h4>
                    <p class="pen-showcase-category">{item.category}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

            <!-- 8 Guarantees & Transparansi Badges Grid (Pen.dev Style) -->
            <div class="pen-guarantees-grid">
              {progGuarantees.map((g: string) => (
                <div class="pen-guarantee-item">
                  <span class="pen-guarantee-check">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  </span>
                  <span>{g}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
  </section>
  )}

  {isEnabled('prog_faq') && (
  <section class="pen-faq-section" id="faq" style="background-color: #f8f8f8; padding: 100px 24px 130px; width: 100%; box-sizing: border-box;">
    <div style="max-width: 1425px; margin: 0 auto; width: 100%;">
      <div style="text-align: center; margin-bottom: 50px;">
        <div style="display: inline-flex; align-items: center; gap: 8px; border: 1px solid #72727240; border-radius: 9999px; padding: 6px 18px; background: #ffffff; margin-bottom: 16px;">
          <span style="width: 6px; height: 6px; border-radius: 50%; background-color: #0969da;"></span>
          <span style="font-family: 'Golos Text', system-ui, sans-serif; font-size: 12px; letter-spacing: 1px; text-transform: uppercase; font-weight: 600; color: #191919;">FAQ</span>
        </div>
        <h2 style="font-family: 'Golos Text', system-ui, sans-serif; font-size: clamp(28px, 4vw, 48px); color: #0f172a; margin: 0; font-weight: 500; line-height: 1.2;">
          {progFaqTitle}
        </h2>
      </div>

      <div style="max-width: 100%; margin: 0 auto; display: flex; flex-direction: column;">
        {progFaqs.map((faq: any, idx: number) => (
          <details style="border-top: none; padding: 0;" open={idx === 0}>
            <summary style="list-style: none; display: flex; justify-content: space-between; align-items: center; padding: 22px 0; cursor: pointer; font-family: 'Golos Text', system-ui, sans-serif; font-size: 22px; color: #191919; transition: color 180ms cubic-bezier(0.2, 0.8, 0.2, 1);" onmouseover="this.style.color='#0969da'" onmouseout="this.style.color='#191919'">
              <span style="padding-right: 20px;">{faq.question}</span>
              <span style="font-size: 20px; font-weight: bold; color: #0969da; flex-shrink: 0; width: 24px; text-align: center;">+</span>
            </summary>
            <div style="padding: 0 0 32px 0; font-family: 'Golos Text', system-ui, sans-serif; font-size: 16px; line-height: 27px; color: #4d4d52; max-width: 1100px;">
              <p style="margin: 0;">{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- SCRIPT INTERAKTIF: GSAP SCROLLTRIGGER ENGINE, SALIN REKENING & LIGHTBOX -->
  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    if (typeof window !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);

      const initAnimations = () => {
        // 1. GVF .slide-anim (Pricing cards & element slides)
        gsap.utils.toArray<HTMLElement>('.slide-anim').forEach((t) => {
          const s = t.dataset.direction || 'bottom';
          const o = parseInt(t.dataset.offset || '60', 10);
          const r = parseFloat(t.dataset.delay || '0') || 0;
          const n: gsap.TweenVars = { opacity: 0 };
          
          if (s === 'left') n.x = -o;
          else if (s === 'right') n.x = o;
          else if (s === 'bottom') n.y = o;
          else if (s === 'top') n.y = -o;
          
          gsap.set(t, n);
          gsap.fromTo(
            t,
            n,
            {
              opacity: 1,
              x: 0,
              y: 0,
              duration: 0.8,
              delay: r,
              ease: 'power2.out',
              scrollTrigger: {
                trigger: t,
                start: 'top 95%',
                toggleActions: 'play none none none',
                once: true,
              },
            }
          );
        });

        // 2. GVF .fade-top (Heading & titles)
        gsap.utils.toArray<HTMLElement>('.fade-top').forEach((t) => {
          gsap.set(t, { opacity: 0, y: -30 });
          gsap.fromTo(
            t,
            { opacity: 0, y: -30 },
            {
              opacity: 1,
              y: 0,
              duration: 0.8,
              ease: 'power2.out',
              scrollTrigger: {
                trigger: t,
                start: 'top 85%',
                toggleActions: 'play none none none',
                once: true,
              },
            }
          );
        });

        // 3. GVF .fade-wrapper (Staggered items)
        gsap.utils.toArray<HTMLElement>('.fade-wrapper').forEach((t) => {
          const s = t.querySelectorAll(':scope > *');
          gsap.set(s, { opacity: 0, y: 30 });
          gsap.fromTo(
            s,
            { opacity: 0, y: 30 },
            {
              opacity: 1,
              y: 0,
              duration: 0.6,
              stagger: 0.1,
              ease: 'power2.out',
              scrollTrigger: {
                trigger: t,
                start: 'top 85%',
                toggleActions: 'play none none none',
                once: true,
              },
            }
          );
        });

        // 4. GSAP Handler for general reveal elements (.reveal-on-scroll)
        gsap.utils.toArray<HTMLElement>('.reveal-on-scroll').forEach((el) => {
          gsap.set(el, { opacity: 0, y: 30 });
          gsap.to(el, {
            opacity: 1,
            y: 0,
            duration: 0.8,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: el,
              start: 'top 88%',
              toggleActions: 'play none none none',
              once: true,
            },
          });
        });

        ScrollTrigger.refresh();
      };

      // Double requestAnimationFrame agar layout stabil
      requestAnimationFrame(() => {
        requestAnimationFrame(initAnimations);
      });
    }

    // 5. Copy Account Number with Toast Feedback
    document.querySelectorAll('.btn-copy-acc').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetNumber = btn.getAttribute('data-copy-target');
        if (targetNumber) {
          navigator.clipboard.writeText(targetNumber).then(() => {
            const originalHTML = btn.innerHTML;
            btn.classList.add('copied');
            btn.innerHTML = `
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Tersalin!</span>
            `;
            setTimeout(() => {
              btn.innerHTML = originalHTML;
              btn.classList.remove('copied');
            }, 2500);
          });
        }
      });
    });

    // 6. Interactive Lightbox Modal for Gallery Cards
    const lightbox = document.getElementById('programLightbox');
    const lightboxImg = document.getElementById('lightboxImg') as HTMLImageElement;
    const lightboxTitle = document.getElementById('lightboxTitle');
    const lightboxCaption = document.getElementById('lightboxCaption');
    const closeBtn = document.getElementById('lightboxCloseBtn');
    const closeArea = document.getElementById('lightboxCloseArea');

    function openLightbox(src: string, title: string, caption: string) {
      if (lightbox && lightboxImg && lightboxTitle && lightboxCaption) {
        lightboxImg.src = src;
        lightboxImg.alt = title;
        lightboxTitle.textContent = title;
        lightboxCaption.textContent = caption;
        lightbox.classList.add('is-open');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeLightbox() {
      if (lightbox) {
        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
    }

    document.querySelectorAll('.gallery-card').forEach(card => {
      card.addEventListener('click', () => {
        const src = card.getAttribute('data-img-src') || '';
        const title = card.getAttribute('data-img-title') || '';
        const caption = card.getAttribute('data-img-caption') || '';
        openLightbox(src, title, caption);
      });
    });

    closeBtn?.addEventListener('click', closeLightbox);
    closeArea?.addEventListener('click', closeLightbox);
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });
  </script>
</BaseLayout>
