  .lightbox-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--isavo-navy);
    margin-bottom: 6px;
  }

  .lightbox-caption {
    font-size: 0.9rem;
    color: var(--isavo-text-muted);
    margin: 0;
  }

